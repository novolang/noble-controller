// tests/ll_aes_tests.nv — the unit tests of src/ll_aes.nv.
//
//   novo test tests/ll_aes_tests.nv

use std.test
use ll_aes.{ aes_encrypt, aes_key_new, aes_set_key, word }

fn t_block(a: [Int]) -> Vec[u8; 16]
    var b: Vec[u8; 16] = Vec.new()
    for x in a
        let _p = b.push(x as u8)
    b

@tier(app)
fn t_same(var got: Vec[u8; 16], want: [Int])
    for i in 0..16
        test.assert_eq(got[i] as Int, want[i])

@test
fn test_fips_197_appendix_b()
    var k = aes_key_new()
    var key = t_block([0x2B, 0x7E, 0x15, 0x16, 0x28, 0xAE, 0xD2, 0xA6, 0xAB, 0xF7, 0x15, 0x88, 0x09, 0xCF, 0x4F, 0x3C])
    aes_set_key(var k, var key)
    var b = t_block([0x32, 0x43, 0xF6, 0xA8, 0x88, 0x5A, 0x30, 0x8D, 0x31, 0x31, 0x98, 0xA2, 0xE0, 0x37, 0x07, 0x34])
    aes_encrypt(var k, var b)
    t_same(var b,
        [0x39, 0x25, 0x84, 0x1D, 0x02, 0xDC, 0x09, 0xFB, 0xDC, 0x11, 0x85, 0x97, 0x19, 0x6A, 0x0B, 0x32])

@test
fn test_fips_197_appendix_c1()
    var k = aes_key_new()
    var key = t_block([0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0A, 0x0B, 0x0C, 0x0D, 0x0E, 0x0F])
    aes_set_key(var k, var key)
    var b = t_block([0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88, 0x99, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF])
    aes_encrypt(var k, var b)
    t_same(var b,
        [0x69, 0xC4, 0xE0, 0xD8, 0x6A, 0x7B, 0x04, 0x30, 0xD8, 0xCD, 0xB7, 0x80, 0x70, 0xB4, 0xC5, 0x5A])

@test
fn test_the_le_encrypt_sample_of_the_core_specification()
    // Vol 6 Part C, Section 1.1: the key and plaintext of HCI_LE_Encrypt.
    var k = aes_key_new()
    var key = t_block([0x4C, 0x68, 0x38, 0x41, 0x39, 0xF5, 0x74, 0xD8, 0x36, 0xBC, 0xF3, 0x4E, 0x9D, 0xFB, 0x01, 0xBF])
    aes_set_key(var k, var key)
    var b = t_block([0x02, 0x13, 0x24, 0x35, 0x46, 0x57, 0x68, 0x79, 0xAC, 0xBD, 0xCE, 0xDF, 0xE0, 0xF1, 0x02, 0x13])
    aes_encrypt(var k, var b)
    t_same(var b,
        [0x99, 0xAD, 0x1B, 0x52, 0x26, 0xA3, 0x7E, 0x3E, 0x05, 0x8E, 0x3B, 0x8E, 0x27, 0xC2, 0xC6, 0x66])

@test
fn test_the_last_round_key_of_the_fips_197_expansion()
    var k = aes_key_new()
    var key = t_block([0x2B, 0x7E, 0x15, 0x16, 0x28, 0xAE, 0xD2, 0xA6, 0xAB, 0xF7, 0x15, 0x88, 0x09, 0xCF, 0x4F, 0x3C])
    aes_set_key(var k, var key)
    // Appendix A.1: w[40] is d014f9a8 and w[43] is b6630ca6.
    test.assert_eq(k.w[40], word(0xD0, 0x14, 0xF9, 0xA8))
    test.assert_eq(k.w[43], word(0xB6, 0x63, 0x0C, 0xA6))
