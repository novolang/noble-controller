fn test_mode_3_with_a_sounding_sequence_on_le_2m_gives_the_phase_the_round_trip_and_the_two_phase_correction_terms()
    if not ctl_limits.cs_mode3_on() or not ctl_limits.cs_rtt_seq_on()
