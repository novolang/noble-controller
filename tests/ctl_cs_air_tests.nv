@when(noble_controller_config.CTL_PERIPHERAL > 0)
@when(noble_controller_config.CTL_CS > 0)
@test
fn test_mode_3_as_the_sub_mode_of_mode_2_with_a_random_sequence_gives_both_estimates()
    if not ctl_limits.cs_mode3_on() or not ctl_limits.cs_rtt_seq_on()
        return
    for phy in [1, 2]
        let e = option_case_phy(phy == 1, 2, 3, 6, phy, 0, 1, 5100)
        test.assert(e.n_rtt >= 10)
        test.assert(e.n_pbr >= 40)

@when(noble_controller_config.CTL_PERIPHERAL > 0)
@when(noble_controller_config.CTL_CS > 0)
@test
fn test_two_antenna_paths_give_three_tone_slots_and_the_extension_slot_repeats_the_last_path()
    if noble_controller_config.CTL_CS_ANT < 2
        return
    for who in 0..2
        var ra = sim_cs_new()
        world_figures(var ra, 3900, 6.0, -8.0)
        for p in 0..4
            ra.med.ap_phase[p] = 0.3
        var w = air_from(var ra)
        var s = setup_new()
        s.init_central = who == 0
        s.aci = 1
        open_series(var w, s)
        let table = fae_event(ini_log(w, s))
        let r = run_round(var w, 100, 12)
        check_round(r, s, 100, 0, 2)
        let ini = ini_subs(r, s)
        let rfl = rfl_subs(r, s)
        var dup = 0
        for j in 0..list.len(ini)
            for k in 0..list.len(ini[j].steps)
                for st in [ini[j].steps[k], rfl[j].steps[k]]
                    if st.mode == 2 and (h_tone_tq(st, false, 2) >>> 4) == 2
                        // The tone of the extension slot is the tone of the last path again.
                        test.assert_eq(h_tone_i(st, false, 2), h_tone_i(st, false, 1))
                        test.assert_eq(h_tone_q(st, false, 2), h_tone_q(st, false, 1))
                        dup = dup + 1
        test.assert(dup > 0)
        // The estimate over the two paths of each step alone, and over the two paths and the extension slot as a third path: the second counts the last path twice, which
        // the same phase on every path hides, so what the estimator must not do is not shown by the distance; it is shown by the number of products.
        let hc = hcfg_of(s, 2, false)
        let e = h_estimate(ini, rfl, hc, table)
        test.assert(err_m(e.d_pbr, 3900) < PBR_TOL_M)
        test.assert_eq(e.n_pbr, 72)
        let hc3 = hcfg_of(s, 3, false)
        let p3 = h_products(ini[0], rfl[0], hc3)
        let p2 = h_products(ini[0], rfl[0], hc)
        test.assert_eq(list.len(p3.f), list.len(p2.f))
        var bigger = 0
        for k in 0..list.len(p2.f)
            if p3.re[k] != p2.re[k] or p3.im[k] != p2.im[k]
                bigger = bigger + 1
        test.assert(bigger > 0)

// ── The probe copy and the lock step, without a Controller ──────────

// The head of a plan of one step, for the role `role`, and the step: mode 0 on channel 20.
fn one_step_head(var h: CsPlan, role: Int)
    h.n_steps = 1
    h.n_mode0 = 1
    h.role = role as u8

fn one_step(var st: CsStep)
    st.ch = 20
    st.aa_i = 0x12345678
    st.aa_r = 0x6B8A3D91
    st.start_ns = 150_000
    st.len_ns = 600_000

@test
fn test_a_probe_radio_arms_the_medium_without_running_and_the_radio_that_comes_second_finds_its_side_resolved_by_the_first()
    // One mode 0 step on channel 20: the initiator sends CS_SYNC, the reflector answers with its own and a tone.
    var pa = ll_cs_radio.cs_plan_new()
    one_step_head(var pa, 0)
    var pb = ll_cs_radio.cs_plan_new()
    one_step_head(var pb, 1)
    var st = ll_cs_radio.cs_step_new()
    one_step(var st)
    var a = sim_cs_new()
    var b = sim_cs_other(var a)
    sim_cs_dist(var a, 2000)
    // The copy of the second radio: a new object over the same medium.
    var probe = PairRadio { s: SimCs { med: b.med, side: b.side, caps: b.caps, timing: b.timing, now_us: b.now_us, arms: 0, runs: 0, aborts: 0 }, probe: true, tw: 0 }
    test.assert_eq(probe.cs_arm(var pb, 1000), ll_cs_radio.CS_OK)
    test.assert_eq(probe.cs_load(0, var st), ll_cs_radio.CS_OK)
    var raw_p = ll_cs_radio.cs_raw_new()
    test.assert_eq(probe.cs_run(var raw_p), ll_cs_radio.CS_ABORTED)
    test.assert_eq(raw_p.n_done as Int, 0)
    // The medium holds the plan of the second radio, armed, and the probe's own clock and counters are its own.
    test.assert(b.med.armed[1])
    test.assert(not b.med.ready[1])
    test.assert_eq(b.runs, 0)
    test.assert_eq(b.arms, 0)
    test.assert_eq(probe.s.arms, 1)
    // The first radio runs: it finds the second armed and resolves the pair.
    var ra = PairRadio { s: a, probe: false, tw: 0 }
    test.assert_eq(ra.cs_arm(var pa, 1000), ll_cs_radio.CS_OK)
    test.assert_eq(ra.cs_load(0, var st), ll_cs_radio.CS_OK)
    var raw_a = ll_cs_radio.cs_raw_new()
    test.assert_eq(ra.cs_run(var raw_a), ll_cs_radio.CS_OK)
    test.assert_eq(raw_a.n_done as Int, 1)
    test.assert(b.med.ready[1])
    // The second arms again, as its Controller does: its own side is kept, and it is run and read without a new resolution.
    var rb = PairRadio { s: b, probe: false, tw: 0 }
    test.assert_eq(rb.cs_arm(var pb, 1000), ll_cs_radio.CS_OK)
    test.assert(b.med.ready[1])
    test.assert_eq(rb.cs_load(0, var st), ll_cs_radio.CS_OK)
    var raw_b = ll_cs_radio.cs_raw_new()
    test.assert_eq(rb.cs_run(var raw_b), ll_cs_radio.CS_OK)
    test.assert_eq(raw_b.n_done as Int, 1)
    var s_b = ll_cs_radio.cs_step_raw_none()
    test.assert(rb.cs_step_raw(0, var s_b))
    test.assert_eq(s_b.aa_q as Int, 0)
    // A radio that arms and finds nothing resolved runs alone: it hears nobody.
    var c = sim_cs_new()
    var d = sim_cs_other(var c)
    var rd = PairRadio { s: d, probe: false, tw: 0 }
    test.assert_eq(rd.cs_arm(var pb, 1000), ll_cs_radio.CS_OK)
    test.assert_eq(rd.cs_load(0, var st), ll_cs_radio.CS_OK)
    var raw_d = ll_cs_radio.cs_raw_new()
    test.assert_eq(rd.cs_run(var raw_d), ll_cs_radio.CS_ABORTED)
    test.assert_eq(raw_d.abort as Int, ABORT_NO_SYNC)
    // The tweaks: a radio that is told to hide its tones, and the rest of the radio's surface through the wrapper.
    var re = PairRadio { s: sim_cs_new(), probe: false, tw: TW_NO_TONES }
    test.assert(re.supports_cs())
    test.assert_eq(re.cs_caps().roles, 3)
    test.assert_eq(re.cs_timing().max_steps, 160)
    test.assert_eq(re.cs_cal().tx_1m_ps, 0)
    test.assert_eq(re.cs_fae(20), 0)
    re.cs_abort()
    test.assert_eq(re.s.aborts, 1)
    var nope = ll_cs_radio.cs_step_raw_none()
    test.assert(not re.cs_step_raw(0, var nope))

