// tests/ctl_pool_tests.nv — the unit tests of src/ctl_pool.nv.
//
//   novo test tests/ctl_pool_tests.nv

use std.test
use ctl_pool.{ NO_SLOT, SLOTS, SLOT_OCTETS, acl_begin, acl_send, evt_begin, evt_send, iso_begin, iso_send, pool_flush, pool_free, pool_get, pool_give, pool_len, pool_new, pool_put, pool_put_u16, pool_queue, pool_take, pool_tx_next, pool_tx_pending }

@test
fn test_iso_packet_is_framed_with_handle_flags_and_length()
    var p = pool_new()
    let s = iso_begin(var p, 0x0101, 2, true)
    test.assert_eq(s, 0)
    for i in 0..3
        test.assert(pool_put(var p, s, 0x40 + i))
    test.assert(iso_send(var p, s))
    var out: [Int] = []
    while pool_tx_pending(var p)
        list.push(out, pool_tx_next(var p))
    test.assert_eq(out, [0x05, 0x01, 0x61, 0x03, 0x00, 0x40, 0x41, 0x42])

@test
fn test_acl_packet_is_framed_with_handle_flags_and_length()
    var p = pool_new()
    let s = acl_begin(var p, 0x0041, 2)
    test.assert_eq(s, 0)
    for i in 0..5
        test.assert(pool_put(var p, s, 0x30 + i))
    test.assert(acl_send(var p, s))
    var out: [Int] = []
    while pool_tx_pending(var p)
        list.push(out, pool_tx_next(var p))
    test.assert_eq(out, [0x02, 0x41, 0x20, 0x05, 0x00, 0x30, 0x31, 0x32, 0x33, 0x34])

@test
fn test_acl_packet_refuses_an_empty_header_or_an_exhausted_pool()
    var p = pool_new()
    for _ in 0..SLOTS
        test.assert(acl_begin(var p, 1, 1) != NO_SLOT)
    test.assert_eq(acl_begin(var p, 1, 1), NO_SLOT)
    var q = pool_new()
    let s = pool_take(var q)
    test.assert(pool_put(var q, s, 0x02))
    test.assert(not acl_send(var q, s))

@test
fn test_capacities_match_the_constants()
    let p = pool_new()
    test.assert_eq(p.bytes.capacity(), SLOTS * SLOT_OCTETS)
    test.assert_eq(p.len.capacity(), SLOTS)
    test.assert_eq(p.busy.capacity(), SLOTS)
    test.assert_eq(p.queue.capacity(), SLOTS)
    test.assert_eq(p.bytes.len(), SLOTS * SLOT_OCTETS)

@test
fn test_slots_are_taken_in_order_and_given_back()
    var p = pool_new()
    test.assert_eq(pool_free(var p), SLOTS)
    for want in 0..SLOTS
        test.assert_eq(pool_take(var p), want)
    test.assert_eq(pool_take(var p), NO_SLOT)
    test.assert_eq(pool_free(var p), 0)
    pool_give(var p, 2)
    test.assert_eq(pool_free(var p), 1)
    test.assert_eq(pool_take(var p), 2)

@test
fn test_put_stops_at_the_slot_size()
    var p = pool_new()
    let s = pool_take(var p)
    for i in 0..SLOT_OCTETS
        test.assert(pool_put(var p, s, i))
    test.assert(not pool_put(var p, s, 1))
    test.assert_eq(pool_len(var p, s), SLOT_OCTETS)
    test.assert_eq(pool_get(var p, s, 5), 5)
    test.assert_eq(pool_get(var p, s, SLOT_OCTETS), -1)
    // The neighbouring slot is untouched.
    let t = pool_take(var p)
    test.assert_eq(pool_len(var p, t), 0)
    test.assert(pool_put(var p, t, 0xAB))
    test.assert_eq(pool_get(var p, s, SLOT_OCTETS - 1), (SLOT_OCTETS - 1) & 0xFF)

@test
fn test_put_refuses_a_slot_that_is_not_taken()
    var p = pool_new()
    test.assert(not pool_put(var p, 1, 7))
    test.assert(not pool_put(var p, -1, 7))
    test.assert(not pool_put(var p, SLOTS, 7))

@test
fn test_queue_sends_packets_in_order_and_frees_their_slots()
    var p = pool_new()
    let a = pool_take(var p)
    let b = pool_take(var p)
    let _x = pool_put(var p, a, 0x11)
    let _y = pool_put(var p, a, 0x12)
    let _z = pool_put(var p, b, 0x21)
    test.assert(pool_queue(var p, a))
    test.assert(pool_queue(var p, b))
    test.assert(not pool_queue(var p, a))
    test.assert(pool_tx_pending(var p))
    test.assert_eq(pool_tx_next(var p), 0x11)
    test.assert_eq(pool_tx_next(var p), 0x12)
    test.assert_eq(pool_free(var p), SLOTS - 1)
    test.assert_eq(pool_tx_next(var p), 0x21)
    test.assert(not pool_tx_pending(var p))
    test.assert_eq(pool_tx_next(var p), -1)
    test.assert_eq(pool_free(var p), SLOTS)

@test
fn test_queue_wraps_round_the_slots()
    var p = pool_new()
    for round in 0..10
        let s = pool_take(var p)
        test.assert(s >= 0)
        let _a = pool_put(var p, s, round)
        test.assert(pool_queue(var p, s))
        test.assert_eq(pool_tx_next(var p), round)
    test.assert_eq(pool_free(var p), SLOTS)

@test
fn test_queue_refuses_an_empty_slot()
    var p = pool_new()
    let s = pool_take(var p)
    test.assert(not pool_queue(var p, s))

@test
fn test_a_queued_slot_is_not_given_back_early()
    var p = pool_new()
    let s = pool_take(var p)
    let _a = pool_put(var p, s, 1)
    test.assert(pool_queue(var p, s))
    pool_give(var p, s)
    test.assert_eq(pool_free(var p), SLOTS - 1)

@test
fn test_flush_keeps_the_packet_under_way()
    var p = pool_new()
    let a = pool_take(var p)
    let b = pool_take(var p)
    let _w = pool_put(var p, a, 1)
    let _x = pool_put(var p, a, 2)
    let _y = pool_put(var p, b, 3)
    let _z = pool_queue(var p, a)
    let _v = pool_queue(var p, b)
    test.assert_eq(pool_tx_next(var p), 1)
    pool_flush(var p)
    test.assert_eq(pool_tx_next(var p), 2)
    test.assert_eq(pool_tx_next(var p), -1)
    test.assert_eq(pool_free(var p), SLOTS)

@test
fn test_flush_drops_packets_not_begun()
    var p = pool_new()
    let a = pool_take(var p)
    let _w = pool_put(var p, a, 1)
    let _v = pool_queue(var p, a)
    pool_flush(var p)
    test.assert(not pool_tx_pending(var p))
    test.assert_eq(pool_free(var p), SLOTS)

@test
fn test_event_is_framed_with_its_length()
    var p = pool_new()
    let s = evt_begin(var p, 0x10)
    test.assert(s >= 0)
    let _a = pool_put(var p, s, 0x01)
    test.assert(evt_send(var p, s))
    test.assert_eq(pool_tx_next(var p), 0x04)
    test.assert_eq(pool_tx_next(var p), 0x10)
    test.assert_eq(pool_tx_next(var p), 0x01)
    test.assert_eq(pool_tx_next(var p), 0x01)
    test.assert_eq(pool_tx_next(var p), -1)

@test
fn test_event_begin_reports_an_exhausted_pool()
    var p = pool_new()
    for _ in 0..SLOTS
        test.assert(evt_begin(var p, 0x0E) >= 0)
    test.assert_eq(evt_begin(var p, 0x0E), NO_SLOT)

@test
fn test_u16_is_written_least_significant_octet_first()
    var p = pool_new()
    let s = pool_take(var p)
    test.assert(pool_put_u16(var p, s, 0x0C03))
    test.assert_eq(pool_get(var p, s, 0), 0x03)
    test.assert_eq(pool_get(var p, s, 1), 0x0C)
