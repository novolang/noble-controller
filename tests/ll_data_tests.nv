// tests/ll_data_tests.nv — the unit tests of src/ll_data.nv.
//
//   novo test tests/ll_data_tests.nv

use std.test
use ll_pdu
use ll_data.{ DATA_PAYLOAD_MAX, DATA_PDU_EXT_OCTETS, DATA_PDU_OCTETS, LLID_CONTINUE, LLID_CONTROL, LLID_START, MD_BIT, NESN_BIT, OP_CHANNEL_MAP_IND, OP_CONNECTION_PARAM_REQ, OP_CONNECTION_PARAM_RSP, OP_CONNECTION_UPDATE_IND, OP_ENC_REQ, OP_ENC_RSP, OP_FEATURE_EXT_REQ, OP_FEATURE_EXT_RSP, OP_FEATURE_REQ, OP_FEATURE_RSP, OP_LENGTH_REQ, OP_LENGTH_RSP, OP_MIN_USED_CHANNELS_IND, OP_PAUSE_ENC_REQ, OP_PAUSE_ENC_RSP, OP_PERIODIC_SYNC_IND, OP_PERIODIC_SYNC_WR_IND, OP_PERIPHERAL_FEATURE_REQ, OP_PHY_REQ, OP_PHY_RSP, OP_PHY_UPDATE_IND, OP_PING_REQ, OP_PING_RSP, OP_REJECT_EXT_IND, OP_REJECT_IND, OP_START_ENC_REQ, OP_START_ENC_RSP, OP_TERMINATE_IND, OP_UNKNOWN_RSP, OP_VERSION_IND, PAYLOAD_EXT_MAX, SN_BIT, ctrl_channel_map, ctrl_connection_update, ctrl_features, ctrl_length, ctrl_min_used, ctrl_param, ctrl_payload_len, ctrl_phy, ctrl_phy_update, ctrl_ping_req, ctrl_ping_rsp, ctrl_reject, ctrl_reject_ext, ctrl_terminate, ctrl_unknown_rsp, ctrl_version, dpdu_begin, dpdu_byte, dpdu_empty, dpdu_finish, dpdu_len, dpdu_llid, dpdu_opcode, dpdu_put, dpdu_u16 }

fn t_features() -> Vec[u8; 8]
    var f: Vec[u8; 8] = Vec.new()
    for i in 0..8
        let _a = f.push((0x10 + i) as u8)
    f

@test
fn test_empty_pdu_is_llid_one_with_no_payload()
    var p = ll_pdu.pdu_new()
    dpdu_empty(var p)
    test.assert_eq(p.n, 2)
    test.assert_eq(dpdu_llid(var p), LLID_CONTINUE)
    test.assert_eq(dpdu_len(var p), 0)
    test.assert_eq(dpdu_opcode(var p), -1)

@test
fn test_payload_stops_at_the_data_pdu_size()
    // The PDU holds the header, 251 octets of payload and the MIC of 4.
    var p = ll_pdu.pdu_new()
    dpdu_begin(var p, LLID_START)
    for i in 0..PAYLOAD_EXT_MAX + 4
        test.assert(dpdu_put(var p, i))
    test.assert(not dpdu_put(var p, 1))
    dpdu_finish(var p)
    test.assert_eq(p.n, DATA_PDU_EXT_OCTETS)
    test.assert_eq(dpdu_len(var p), PAYLOAD_EXT_MAX + 4)
    test.assert_eq(dpdu_llid(var p), LLID_START)
    test.assert_eq(dpdu_byte(var p, 26), 26)
    test.assert_eq(dpdu_byte(var p, 250), 250)
    test.assert_eq(DATA_PAYLOAD_MAX + 2, DATA_PDU_OCTETS)
    test.assert_eq(PAYLOAD_EXT_MAX + 6, DATA_PDU_EXT_OCTETS)

@test
fn test_length_pdus_carry_the_four_values()
    var p = ll_pdu.pdu_new()
    ctrl_length(var p, OP_LENGTH_REQ, 251, 2120, 27, 328)
    test.assert_eq(dpdu_llid(var p), LLID_CONTROL)
    test.assert_eq(dpdu_len(var p), 9)
    test.assert_eq(dpdu_opcode(var p), OP_LENGTH_REQ)
    test.assert_eq(dpdu_u16(var p, 1), 251)
    test.assert_eq(dpdu_u16(var p, 3), 2120)
    test.assert_eq(dpdu_u16(var p, 5), 27)
    test.assert_eq(dpdu_u16(var p, 7), 328)
    ctrl_length(var p, OP_LENGTH_RSP, 27, 328, 251, 17040)
    test.assert_eq(dpdu_opcode(var p), OP_LENGTH_RSP)
    test.assert_eq(dpdu_u16(var p, 7), 17040)

@test
fn test_phy_pdus_carry_masks_and_the_instant()
    var p = ll_pdu.pdu_new()
    ctrl_phy(var p, OP_PHY_REQ, 3, 7)
    test.assert_eq(dpdu_len(var p), 3)
    test.assert_eq(dpdu_opcode(var p), OP_PHY_REQ)
    test.assert_eq(dpdu_byte(var p, 1), 3)
    test.assert_eq(dpdu_byte(var p, 2), 7)
    ctrl_phy(var p, OP_PHY_RSP, 2, 2)
    test.assert_eq(dpdu_opcode(var p), OP_PHY_RSP)
    ctrl_phy_update(var p, 2, 4, 0x1234)
    test.assert_eq(dpdu_len(var p), 5)
    test.assert_eq(dpdu_opcode(var p), OP_PHY_UPDATE_IND)
    test.assert_eq(dpdu_byte(var p, 1), 2)
    test.assert_eq(dpdu_byte(var p, 2), 4)
    test.assert_eq(dpdu_u16(var p, 3), 0x1234)

@test
fn test_header_bits_do_not_overlap()
    test.assert_eq(NESN_BIT | SN_BIT | MD_BIT | LLID_CONTROL, 0x1F)
    test.assert_eq(NESN_BIT & SN_BIT, 0)
    test.assert_eq(SN_BIT & MD_BIT, 0)

@test
fn test_terminate_carries_the_reason()
    var p = ll_pdu.pdu_new()
    ctrl_terminate(var p, 0x13)
    test.assert_eq(dpdu_llid(var p), LLID_CONTROL)
    test.assert_eq(dpdu_len(var p), 2)
    test.assert_eq(dpdu_opcode(var p), OP_TERMINATE_IND)
    test.assert_eq(dpdu_byte(var p, 1), 0x13)

@test
fn test_unknown_response_names_the_opcode()
    var p = ll_pdu.pdu_new()
    ctrl_unknown_rsp(var p, 0x1A)
    test.assert_eq(dpdu_opcode(var p), OP_UNKNOWN_RSP)
    test.assert_eq(dpdu_byte(var p, 1), 0x1A)
    test.assert_eq(dpdu_len(var p), 2)

@test
fn test_feature_pdus_carry_eight_octets()
    var p = ll_pdu.pdu_new()
    var f = t_features()
    ctrl_features(var p, OP_FEATURE_RSP, var f)
    test.assert_eq(dpdu_opcode(var p), OP_FEATURE_RSP)
    test.assert_eq(dpdu_len(var p), 9)
    test.assert_eq(dpdu_byte(var p, 1), 0x10)
    test.assert_eq(dpdu_byte(var p, 8), 0x17)
    ctrl_features(var p, OP_PERIPHERAL_FEATURE_REQ, var f)
    test.assert_eq(dpdu_opcode(var p), OP_PERIPHERAL_FEATURE_REQ)

@test
fn test_version_pdu_is_little_endian()
    var p = ll_pdu.pdu_new()
    ctrl_version(var p, 0x11, 0x1234, 0x5678)
    test.assert_eq(dpdu_opcode(var p), OP_VERSION_IND)
    test.assert_eq(dpdu_len(var p), 6)
    test.assert_eq(dpdu_byte(var p, 1), 0x11)
    test.assert_eq(dpdu_u16(var p, 2), 0x1234)
    test.assert_eq(dpdu_u16(var p, 4), 0x5678)

@test
fn test_ping_response_is_one_octet()
    var p = ll_pdu.pdu_new()
    ctrl_ping_rsp(var p)
    test.assert_eq(dpdu_len(var p), 1)
    test.assert_eq(dpdu_opcode(var p), OP_PING_RSP)

@test
fn test_control_lengths_name_the_opcodes_that_are_read()
    test.assert_eq(ctrl_payload_len(OP_CONNECTION_UPDATE_IND), 12)
    test.assert_eq(ctrl_payload_len(OP_CHANNEL_MAP_IND), 8)
    test.assert_eq(ctrl_payload_len(OP_TERMINATE_IND), 2)
    test.assert_eq(ctrl_payload_len(OP_UNKNOWN_RSP), 2)
    test.assert_eq(ctrl_payload_len(OP_FEATURE_REQ), 9)
    test.assert_eq(ctrl_payload_len(OP_FEATURE_RSP), 9)
    test.assert_eq(ctrl_payload_len(OP_VERSION_IND), 6)
    test.assert_eq(ctrl_payload_len(OP_PERIPHERAL_FEATURE_REQ), 9)
    test.assert_eq(ctrl_payload_len(OP_PING_REQ), 1)
    test.assert_eq(ctrl_payload_len(OP_PERIODIC_SYNC_IND), 35)
    test.assert_eq(ctrl_payload_len(OP_PERIODIC_SYNC_WR_IND), 43)
    test.assert_eq(ctrl_payload_len(OP_FEATURE_EXT_REQ), 27)
    test.assert_eq(ctrl_payload_len(OP_FEATURE_EXT_RSP), 27)
    test.assert_eq(ctrl_payload_len(OP_PING_RSP), 1)
    test.assert_eq(ctrl_payload_len(OP_REJECT_IND), 2)
    test.assert_eq(ctrl_payload_len(OP_CONNECTION_PARAM_REQ), 24)
    test.assert_eq(ctrl_payload_len(OP_CONNECTION_PARAM_RSP), 24)
    test.assert_eq(ctrl_payload_len(OP_REJECT_EXT_IND), 3)
    test.assert_eq(ctrl_payload_len(OP_MIN_USED_CHANNELS_IND), 3)
    test.assert_eq(ctrl_payload_len(OP_ENC_REQ), 23)
    test.assert_eq(ctrl_payload_len(OP_ENC_RSP), 13)
    test.assert_eq(ctrl_payload_len(OP_START_ENC_REQ), 1)
    test.assert_eq(ctrl_payload_len(OP_START_ENC_RSP), 1)
    test.assert_eq(ctrl_payload_len(OP_PAUSE_ENC_REQ), 1)
    test.assert_eq(ctrl_payload_len(OP_PAUSE_ENC_RSP), 1)
    test.assert_eq(ctrl_payload_len(OP_LENGTH_REQ), 9)
    test.assert_eq(ctrl_payload_len(OP_LENGTH_RSP), 9)
    test.assert_eq(ctrl_payload_len(OP_PHY_REQ), 3)
    test.assert_eq(ctrl_payload_len(OP_PHY_RSP), 3)
    test.assert_eq(ctrl_payload_len(OP_PHY_UPDATE_IND), 5)
    test.assert_eq(ctrl_payload_len(0x1A), -1)
    test.assert_eq(ctrl_payload_len(0x7F), -1)

@test
fn test_ping_request_is_one_octet()
    var p = ll_pdu.pdu_new()
    ctrl_ping_req(var p)
    test.assert_eq(dpdu_len(var p), 1)
    test.assert_eq(dpdu_opcode(var p), OP_PING_REQ)

@test
fn test_connection_update_carries_the_window_the_parameters_and_the_instant()
    var p = ll_pdu.pdu_new()
    ctrl_connection_update(var p, 2, 3, 0x30, 4, 0x200, 0x1234)
    test.assert_eq(dpdu_len(var p), 12)
    test.assert_eq(dpdu_opcode(var p), OP_CONNECTION_UPDATE_IND)
    test.assert_eq(dpdu_byte(var p, 1), 2)
    test.assert_eq(dpdu_u16(var p, 2), 3)
    test.assert_eq(dpdu_u16(var p, 4), 0x30)
    test.assert_eq(dpdu_u16(var p, 6), 4)
    test.assert_eq(dpdu_u16(var p, 8), 0x200)
    test.assert_eq(dpdu_u16(var p, 10), 0x1234)

@test
fn test_channel_map_carries_five_octets_and_the_instant()
    var p = ll_pdu.pdu_new()
    ctrl_channel_map(var p, 0x1FFFFFF7FF, 100)
    test.assert_eq(dpdu_len(var p), 8)
    test.assert_eq(dpdu_opcode(var p), OP_CHANNEL_MAP_IND)
    test.assert_eq(dpdu_byte(var p, 1), 0xFF)
    test.assert_eq(dpdu_byte(var p, 2), 0xF7)
    test.assert_eq(dpdu_byte(var p, 5), 0x1F)
    test.assert_eq(dpdu_u16(var p, 6), 100)

@test
fn test_parameter_pdus_carry_the_range_and_no_offset_preference()
    var p = ll_pdu.pdu_new()
    ctrl_param(var p, OP_CONNECTION_PARAM_REQ, 6, 0x20, 2, 300, 4, 0x55)
    test.assert_eq(dpdu_len(var p), 24)
    test.assert_eq(dpdu_opcode(var p), OP_CONNECTION_PARAM_REQ)
    test.assert_eq(dpdu_u16(var p, 1), 6)
    test.assert_eq(dpdu_u16(var p, 3), 0x20)
    test.assert_eq(dpdu_u16(var p, 5), 2)
    test.assert_eq(dpdu_u16(var p, 7), 300)
    test.assert_eq(dpdu_byte(var p, 9), 4)
    test.assert_eq(dpdu_u16(var p, 10), 0x55)
    for k in 0..6
        test.assert_eq(dpdu_u16(var p, 12 + 2 * k), 0xFFFF)
    ctrl_param(var p, OP_CONNECTION_PARAM_RSP, 6, 6, 0, 100, 0, 0)
    test.assert_eq(dpdu_opcode(var p), OP_CONNECTION_PARAM_RSP)

@test
fn test_rejects_name_the_code_and_the_rejected_opcode()
    var p = ll_pdu.pdu_new()
    ctrl_reject_ext(var p, OP_CONNECTION_PARAM_REQ, 0x23)
    test.assert_eq(dpdu_len(var p), 3)
    test.assert_eq(dpdu_opcode(var p), OP_REJECT_EXT_IND)
    test.assert_eq(dpdu_byte(var p, 1), OP_CONNECTION_PARAM_REQ)
    test.assert_eq(dpdu_byte(var p, 2), 0x23)
    ctrl_reject(var p, 0x1A)
    test.assert_eq(dpdu_len(var p), 2)
    test.assert_eq(dpdu_opcode(var p), OP_REJECT_IND)
    test.assert_eq(dpdu_byte(var p, 1), 0x1A)

@test
fn test_min_used_channels_names_the_phys_and_the_count()
    var p = ll_pdu.pdu_new()
    ctrl_min_used(var p, 1, 20)
    test.assert_eq(dpdu_len(var p), 3)
    test.assert_eq(dpdu_opcode(var p), OP_MIN_USED_CHANNELS_IND)
    test.assert_eq(dpdu_byte(var p, 1), 1)
    test.assert_eq(dpdu_byte(var p, 2), 20)
