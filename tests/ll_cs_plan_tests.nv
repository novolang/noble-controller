@test
fn test_a_subevent_closes_at_the_number_of_steps_it_may_hold()
    var cc = ll_ccm.soft_cipher_new()
    var g = ll_cs_plan.gen_new()
    t_begin(var cc, var g)
    var c = ll_cs_plan.cfg_new()
    ll_cs_plan.gen_begin_subevent(var g, var c, 3, 0)
    var step = ll_cs_radio.cs_step_new()
    for _ in 0..3
        test.assert_eq(ll_cs_plan.plan_next(var cc, var g, var c, var step), ll_cs_plan.PLAN_STEP)
    test.assert_eq(ll_cs_plan.plan_next(var cc, var g, var c, var step), ll_cs_plan.PLAN_SUBEVENT_END)
    test.assert(not g.done)
    test.assert(not g.in_sub)
    // With no subevent open `plan_next` makes no step either.
    test.assert_eq(ll_cs_plan.plan_next(var cc, var g, var c, var step), ll_cs_plan.PLAN_SUBEVENT_END)

@test
fn test_a_subevent_that_cannot_hold_its_first_step_answers_no_fit()
    var cc = ll_ccm.soft_cipher_new()
    var g = ll_cs_plan.gen_new()
    t_begin(var cc, var g)
