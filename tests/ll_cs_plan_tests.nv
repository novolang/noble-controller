    test.assert(g.done)
    test.assert_eq(r.last, ll_cs_plan.PLAN_PROCEDURE_END)
    test.assert_eq(g.step, 256)

@test
fn test_a_procedure_ends_after_32_subevents_and_the_last_subevent_says_so()
    var cc = ll_ccm.soft_cipher_new()
    var g = ll_cs_plan.gen_new()
    t_begin(var cc, var g)
    var c = ll_cs_plan.cfg_new()
    t_reps(var c, 10, 1)
    t_time(var c, 1500, 40_000_000)
    var r = t_run(var cc, var g, var c, 160, 0)
    // 483 microseconds for the mode 0 step and two of 465 in 1,500: three steps in each of 32 subevents.
    test.assert_eq(r.subs.len(), 32)
    test.assert_eq(r.steps.len(), 96)
    test.assert(g.done)
    test.assert_eq(r.last, ll_cs_plan.PLAN_SUBEVENT_END)
    test.assert_eq(g.subs, 32)

@test
fn test_a_subevent_begun_after_the_32nd_holds_nothing()
    var g = ll_cs_plan.gen_new()
    var c = ll_cs_plan.cfg_new()
    var cc = ll_ccm.soft_cipher_new()
    t_begin(var cc, var g)
    for _ in 0..33
        ll_cs_plan.gen_begin_subevent(var g, var c, 1, 0)
    test.assert(g.done)
    test.assert(not g.in_sub)
    test.assert_eq(g.subs, 32)

