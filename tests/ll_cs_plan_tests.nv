    test.assert_eq(ll_cs_plan.plan_next(var cc, var g, var c, var step), ll_cs_plan.PLAN_NO_FIT)
    test.assert(not g.in_sub)
    test.assert(not g.done)

@test
fn test_a_step_that_would_end_after_the_longest_procedure_ends_the_procedure()
    var cc = ll_ccm.soft_cipher_new()
    var g = ll_cs_plan.gen_new()
    t_begin(var cc, var g)
    var c = ll_cs_plan.cfg_new()
    // The mode 0 step ends at 1,983 microseconds after a subevent that begins at 1,500; a mode 2 step of 465 would end at 2,448.
    t_time(var c, 5000, 2000)
    ll_cs_plan.gen_begin_subevent(var g, var c, 10, 1_500_000)
    var step = ll_cs_radio.cs_step_new()
    test.assert_eq(ll_cs_plan.plan_next(var cc, var g, var c, var step), ll_cs_plan.PLAN_STEP)
    test.assert_eq(ll_cs_plan.plan_next(var cc, var g, var c, var step), ll_cs_plan.PLAN_PROCEDURE_END)
    test.assert(g.done)
    test.assert_eq(ll_cs_plan.plan_next(var cc, var g, var c, var step), ll_cs_plan.PLAN_PROCEDURE_END)
    // A subevent begun after the end holds nothing.
    ll_cs_plan.gen_begin_subevent(var g, var c, 10, 0)
    test.assert(not g.in_sub)

@test
fn test_a_procedure_ends_after_256_steps()
    var cc = ll_ccm.soft_cipher_new()
    var g = ll_cs_plan.gen_new()
    t_begin(var cc, var g)
    var c = ll_cs_plan.cfg_new()
