@test
fn test_a_table_of_an_absent_feature_keeps_one_record_and_one_of_a_present_one_keeps_its_count()
    test.assert_eq(ll_cs_plan.max1(0), 1)
    test.assert_eq(ll_cs_plan.max1(1), 1)
    test.assert_eq(ll_cs_plan.max1(2), 2)
    test.assert_eq(ll_cs_plan.max1(160), 160)

@test
fn test_a_new_plan_holds_no_step_and_as_many_as_ctl_cs_steps_allow()
    let p = ll_cs_plan.plan_new()
    test.assert_eq(p.n, 0)
    test.assert_eq(p.steps.len(), 0)
    test.assert_eq(p.steps.capacity(), ll_cs_plan.max1(noble_controller_config.CTL_CS_STEPS))
    test.assert_eq(p.head.n_steps as Int, 0)

@test
fn test_the_plan_of_a_subevent_holds_the_steps_of_the_subevent_up_to_its_capacity_and_names_them_in_its_head()
    var cc = ll_ccm.soft_cipher_new()
    var g = ll_cs_plan.gen_new()
    t_begin(var cc, var g)
    var c = ll_cs_plan.cfg_new()
    t_rtt(var c, 2, 1)
    t_timing(var c, 145, 150, 40, 10, 3)
    var p = ll_cs_plan.plan_new()
    let code = ll_cs_plan.plan_subevent(var cc, var g, var c, var p, 1, 0)
    let cap = p.steps.capacity()
    test.assert_eq(code, ll_cs_plan.PLAN_SUBEVENT_END)
    // 447 microseconds for the mode 0 step and 805 for each step of mode 2 with four paths and a 10 microsecond switch (150 + 2 * 50 * 5 + 10
    // + 145): in 5,000 the subevent holds the mode 0 step and five more.
    var want = 6
    if cap < want
        want = cap
    test.assert_eq(p.n, want)
    test.assert_eq(p.steps.len(), want)
    test.assert_eq(p.head.n_steps as Int, want)
    test.assert_eq(p.head.n_mode0 as Int, 1)
    test.assert_eq(p.head.role as Int, 1)
    test.assert_eq(p.head.phy as Int, 2)
    test.assert_eq(p.head.rtt as Int, 1)
    test.assert_eq(p.head.t_ip1_us as Int, 145)
    test.assert_eq(p.head.t_ip2_us as Int, 145)
    test.assert_eq(p.head.t_fcs_us as Int, 150)
    test.assert_eq(p.head.t_pm_us as Int, 40)
    test.assert_eq(p.head.t_sw_us as Int, 10)
    test.assert_eq(p.head.n_ap as Int, 4)
    test.assert_eq(p.head.aci as Int, 3)
    test.assert(not p.head.ipt)
    test.assert_eq(p.steps[0].mode as Int, 0)
    test.assert_eq(p.steps[0].start_ns as Int, 150_000)

@test
fn test_the_plans_of_a_procedure_use_each_channel_once_whatever_the_capacity()
    var cc = ll_ccm.soft_cipher_new()
    var g = ll_cs_plan.gen_new()
    t_begin(var cc, var g)
    var c = ll_cs_plan.cfg_new()
    var p = ll_cs_plan.plan_new()
    var seen: Vec[Bool; 80] = Vec.new()
    for _ in 0..80
        let _a = seen.push(false)
    var steps = 0
    var subs = 0
    for _ in 0..40
        let _code = ll_cs_plan.plan_subevent(var cc, var g, var c, var p, 0, subs * 5_000_000)
        subs = subs + 1
        steps = steps + p.n
        for i in 0..p.n
            if (p.steps[i].mode as Int) == 2
                test.assert(not seen[p.steps[i].ch as Int])
                seen[p.steps[i].ch as Int] = true
        if g.done
            break
    test.assert(g.done)
    test.assert(steps <= 256)
    if p.steps.capacity() == 1
        // A plan of one step holds the mode 0 step alone, so the procedure ends with its 32 subevents.
        test.assert_eq(subs, 32)
        test.assert_eq(steps, 32)

// A radio that takes a plan of up to 40 steps and refuses the step with the index `bad`.
struct LimitedCs
    var armed: Bool
    var loaded: Int
    var modes: Int
    var bad: Int

impl CsRadio[] for LimitedCs
    fn supports_cs(var self) -> Bool
        true

    fn cs_arm(var self, var plan: CsPlan, t0_us: Int) -> Int
        if t0_us < 100
            return ll_cs_radio.CS_LATE
        if (plan.n_steps as Int) > 40
            return ll_cs_radio.CS_RESOURCES
        self.armed = true
        self.loaded = 0
        self.modes = 0
        ll_cs_radio.CS_OK

    fn cs_load(var self, i: Int, var step: CsStep) -> Int
        if not self.armed or i != self.loaded
            return ll_cs_radio.CS_UNSUPPORTED
        if i == self.bad
            return ll_cs_radio.CS_UNSUPPORTED
        self.loaded = self.loaded + 1
        self.modes = self.modes + step.mode as Int
        ll_cs_radio.CS_OK

@test
fn test_a_plan_is_handed_to_a_radio_as_a_head_and_a_step_at_a_time()
    var cc = ll_ccm.soft_cipher_new()
    var g = ll_cs_plan.gen_new()
    t_begin(var cc, var g)
    var c = ll_cs_plan.cfg_new()
    var p = ll_cs_plan.plan_new()
    let _code = ll_cs_plan.plan_subevent(var cc, var g, var c, var p, 0, 0)
    var air = LimitedCs { armed: false, loaded: 0, modes: 0, bad: -1 }
    test.assert_eq(ll_cs_plan.plan_arm(var air, var p, 1_000), ll_cs_radio.CS_OK)
    test.assert_eq(air.loaded, p.n)
    // The mode 0 step and the mode 2 steps of the subevent: 2 for each of the others.
    test.assert_eq(air.modes, 2 * (p.n - 1))

@test
fn test_a_radio_that_refuses_the_head_or_a_step_stops_the_hand_over_with_its_answer()
    var cc = ll_ccm.soft_cipher_new()
    var g = ll_cs_plan.gen_new()
    t_begin(var cc, var g)
    var c = ll_cs_plan.cfg_new()
    var p = ll_cs_plan.plan_new()
    let _code = ll_cs_plan.plan_subevent(var cc, var g, var c, var p, 0, 0)
    var air = LimitedCs { armed: false, loaded: 0, modes: 0, bad: -1 }
    test.assert_eq(ll_cs_plan.plan_arm(var air, var p, 50), ll_cs_radio.CS_LATE)
    test.assert_eq(air.loaded, 0)
    // A step the radio does not run stops the hand-over at that step.
    air.bad = 0
    test.assert_eq(ll_cs_plan.plan_arm(var air, var p, 1_000), ll_cs_radio.CS_UNSUPPORTED)
    test.assert_eq(air.loaded, 0)

@test
fn test_a_radio_without_the_feature_refuses_the_plan_at_the_head()
    var cc = ll_ccm.soft_cipher_new()
    var g = ll_cs_plan.gen_new()
    t_begin(var cc, var g)
    var c = ll_cs_plan.cfg_new()
    var p = ll_cs_plan.plan_new()
    let _code = ll_cs_plan.plan_subevent(var cc, var g, var c, var p, 0, 0)
    var air = NoCs { unused: 0 }
    test.assert_eq(ll_cs_plan.plan_arm(var air, var p, 1_000_000), ll_cs_radio.CS_UNSUPPORTED)

struct NoCs
    var unused: Int

impl CsRadio[] for NoCs

// ── The storage of the planning ────────────────────────────────────

@test
fn test_the_storage_of_the_planning_holds_a_generator_for_each_connection_that_runs_the_feature_and_one_plan()
    let s = ll_cs_plan.state_new(noble_controller_config.CTL_CS)
    test.assert_eq(s.gens.capacity(), ll_cs_plan.max1(noble_controller_config.CTL_CS))
    test.assert_eq(s.gens.len(), noble_controller_config.CTL_CS)
    test.assert_eq(s.plan.steps.capacity(), ll_cs_plan.max1(noble_controller_config.CTL_CS_STEPS))
    test.assert_eq(s.plan.n, 0)
    for i in 0..s.gens.len()
        test.assert(s.gens[i].done)
        test.assert(not s.gens[i].started)

@test
fn test_the_storage_of_the_planning_makes_the_generators_it_is_asked_for()
    let s = ll_cs_plan.state_new(1)
    test.assert_eq(s.gens.len(), 1)
    test.assert(s.gens[0].done)

@test
fn test_the_storage_of_the_planning_is_the_figure_the_keys_state()
    let gens = noble_controller_config.CTL_CS
    let steps = noble_controller_config.CTL_CS_STEPS
    // Eight octets of length and 712 for each generator, 128 for the plan's head (112), count and code (8 each), and eight octets of length and 56 for each step; the
    // records of the procedures (`ll_cs_proc`) are the other part of the figure, with what the Controller keeps for all its connections (40 words and 160
    // octets) and 40 octets for each step of the result that waits.  A build without the feature makes only the two tables of the procedures, at one element each.
    let procs = ctl_budget.vec_bytes(noble_controller_config.CTL_CS, ctl_budget.CTL_CS_WORDS) + ctl_budget.CTL_CS_GLOBAL_WORDS + ctl_budget.vec_bytes(noble_controller_config.CTL_CS, ctl_budget.CTL_CS_STORE + ctl_budget.CTL_CS_CONFIG * noble_controller_config.CTL_CS_CONFIGS) + ctl_budget.CTL_CS_GLOBAL_OCTETS + ctl_budget.CTL_CS_RESULT_STEP * steps
    if gens > 0
        test.assert_eq(ctl_budget.controller_cs_bytes(), 8 + 712 * gens + 128 + (8 + 56 * steps) + procs)
    else
        test.assert_eq(ctl_budget.controller_cs_bytes(), ctl_budget.vec_bytes(1, 8) + ctl_budget.vec_bytes(1, 1))
