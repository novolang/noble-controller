@test
fn test_the_framing_mode_flag_is_bit_15_of_the_peripheral_sdu_size()
    var x = t_cis(true)
    t_set(var x, "framed", 1)
    t_set(var x, "unseg", 1)
    var p = ll_pdu.pdu_new()
    put_cis_req(var p, var x)
    test.assert_eq(ll_data.dpdu_byte(var p, 6) & 0x80, 0x80)
    test.assert_eq(ll_data.dpdu_byte(var p, 8) & 0x80, 0x80)
    var y = cis_new()
