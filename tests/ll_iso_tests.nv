// A @value struct is changed through a `var` parameter, so the tests set fields through this
// function, by name.
fn t_set(var x: Cis, f: Str, v: Int)
    if f == "central"
        x.central = v != 0
    else if f == "defer"
        x.defer = v != 0
    else if f == "state"
        x.state = v
    else if f == "phy"
        x.phy = v
    else if f == "phy_p"
        x.phy_p = v
    else if f == "framed"
        x.framed = v != 0
    else if f == "unseg"
        x.unseg = v != 0
    else if f == "max_sdu_c"
        x.max_sdu_c = v
    else if f == "max_sdu_p"
        x.max_sdu_p = v
    else if f == "sdu_int_c"
        x.sdu_int_c = v
    else if f == "sdu_int_p"
        x.sdu_int_p = v
    else if f == "max_pdu_c"
        x.max_pdu_c = v
    else if f == "max_pdu_p"
        x.max_pdu_p = v
    else if f == "nse"
        x.nse = v
    else if f == "sub_int"
        x.sub_int = v
    else if f == "bn_c"
        x.bn_c = v
    else if f == "bn_p"
        x.bn_p = v
    else if f == "ft_c"
        x.ft_c = v
    else if f == "ft_p"
        x.ft_p = v
    else if f == "iso_int"
        x.iso_int = v
    else if f == "aa"
        x.aa = v
    else if f == "cis_sync"
        x.cis_sync = v
    else if f == "cig_sync"
        x.cig_sync = v
    else if f == "cis_offset"
        x.cis_offset = v
    else if f == "sup_us"
        x.sup_us = v
    else if f == "cig_id"
        x.cig_id = v
    else if f == "cis_id"
        x.cis_id = v
    else if f == "off_min"
        x.off_min = v
    else if f == "off_max"
        x.off_max = v
    else if f == "off_ev"
        x.off_ev = v
    else if f == "ind_ev"
        x.ind_ev = v
    else if f == "anchor"
        x.anchor = v
    else if f == "ev"
        x.ev = v
    else if f == "synced"
        x.synced = v != 0
    else if f == "last_rx"
        x.last_rx = v
    else if f == "first_us"
        x.first_us = v
    else if f == "rx_num"
        x.rx_num = v
    else if f == "sent_num"
        x.sent_num = v
    else if f == "tx_num"
        x.tx_num = v
    else if f == "f_new"
        x.f_new = v != 0
    else if f == "enc"
        x.enc = v != 0

// A stream with the parameters of a typical unicast: an ISO interval of 8 units (10 ms), two
// subevents 1.5 ms apart, BN 1, FT 1, SDUs of 100 octets on the 2M PHY.
fn t_cis(central: Bool) -> Cis
    var x = cis_new()
    var c = 0
    if central
        c = 1
    t_set(var x, "central", c)
    t_set(var x, "state", S_UP)
    t_set(var x, "phy", 2)
    t_set(var x, "max_sdu_c", 100)
    t_set(var x, "max_sdu_p", 100)
    t_set(var x, "sdu_int_c", 10000)
    t_set(var x, "sdu_int_p", 10000)
    t_set(var x, "max_pdu_c", 100)
    t_set(var x, "max_pdu_p", 100)
    t_set(var x, "nse", 2)
    t_set(var x, "sub_int", 1500)
    t_set(var x, "bn_c", 1)
    t_set(var x, "bn_p", 1)
    t_set(var x, "ft_c", 1)
    t_set(var x, "ft_p", 1)
    t_set(var x, "iso_int", 8)
    t_set(var x, "aa", 0x8E89BED6)
    t_set(var x, "cis_sync", 4000)
    t_set(var x, "cig_sync", 4000)
    t_set(var x, "sup_us", 1000000)
    x

fn t_sdu(fill: Int) -> Vec[u8; 260]
    var d: Vec[u8; 260] = Vec.new()
    for i in 0..260
        let _a = d.push(((fill + i) & 0xFF) as u8)
    d

@test
fn test_slots_hold_what_the_tables_say()
    let x = cis_new()
    test.assert_eq(x.txl.capacity(), PAYLOAD_SLOTS)
    test.assert_eq(x.txf.capacity(), PAYLOAD_SLOTS)
    test.assert_eq(x.outl.capacity(), OUT_SLOTS)
    test.assert(ISO_LOAD <= 250)
    test.assert_eq(SDU_FRAGS, (SDU_MAX + ISO_LOAD - 9) / (ISO_LOAD - 8))
    test.assert(OUT_OCTETS >= SDU_MAX)
    // The three buffers are the size of the build: the full rings of a build with isochronous channels, 8 octets without.
    if ctl_limits.iso_on()
        test.assert_eq(x.txd.capacity(), PAYLOAD_SLOTS * SLOT_OCTETS)
        test.assert_eq(x.hbuf.capacity(), SDU_MAX)
        test.assert_eq(x.outd.capacity(), OUT_SLOTS * OUT_OCTETS)
    else
        test.assert_eq(x.txd.capacity(), 8)
        test.assert_eq(x.hbuf.capacity(), 8)
        test.assert_eq(x.outd.capacity(), 8)

@test
fn test_the_request_round_trips_through_its_pdu()
    var x = t_cis(true)
    t_set(var x, "cig_id", 5)
    t_set(var x, "cis_id", 2)
    t_set(var x, "max_sdu_c", 0x0ABC)
    t_set(var x, "max_sdu_p", 0x0123)
    t_set(var x, "sdu_int_c", 0xFFFFF)
    t_set(var x, "sdu_int_p", 7500)
    t_set(var x, "max_pdu_c", 251)
    t_set(var x, "max_pdu_p", 0)
    t_set(var x, "bn_c", 3)
    t_set(var x, "bn_p", 0)
    t_set(var x, "nse", 6)
    t_set(var x, "sub_int", 1234)
    t_set(var x, "ft_c", 4)
    t_set(var x, "ft_p", 9)
    t_set(var x, "iso_int", 3200)
    t_set(var x, "off_min", 0x123456)
    t_set(var x, "off_max", 0x234567)
    t_set(var x, "off_ev", 0xBEEF)
    var p = ll_pdu.pdu_new()
    put_cis_req(var p, var x)
    test.assert_eq(ll_data.dpdu_len(var p), 36)
    test.assert_eq(ll_data.dpdu_opcode(var p), ll_data.OP_CIS_REQ)
    test.assert_eq(ll_data.ctrl_payload_len(ll_data.OP_CIS_REQ), 36)
    var y = cis_new()
    get_cis_req(var p, var y)
    test.assert_eq(y.cig_id, 5)
    test.assert_eq(y.cis_id, 2)
    test.assert_eq(y.phy, 2)
    test.assert_eq(y.max_sdu_c, 0x0ABC)
    test.assert_eq(y.max_sdu_p, 0x0123)
    test.assert_eq(y.sdu_int_c, 0xFFFFF)
    test.assert_eq(y.sdu_int_p, 7500)
    test.assert_eq(y.max_pdu_c, 251)
    test.assert_eq(y.max_pdu_p, 0)
    test.assert_eq(y.bn_c, 3)
    test.assert_eq(y.bn_p, 0)
    test.assert_eq(y.nse, 6)
    test.assert_eq(y.sub_int, 1234)
    test.assert_eq(y.ft_c, 4)
    test.assert_eq(y.ft_p, 9)
    test.assert_eq(y.iso_int, 3200)
    test.assert_eq(y.off_min, 0x123456)
    test.assert_eq(y.off_max, 0x234567)
    test.assert_eq(y.off_ev, 0xBEEF)
    test.assert(not y.framed)

@test
fn test_the_framed_flag_is_bit_15_of_the_central_sdu_size()
    var x = t_cis(true)
    t_set(var x, "framed", 1)
    var p = ll_pdu.pdu_new()
    put_cis_req(var p, var x)
    test.assert_eq(ll_data.dpdu_byte(var p, 6) & 0x80, 0x80)
    var y = cis_new()
    get_cis_req(var p, var y)
    test.assert(y.framed)
    test.assert_eq(y.max_sdu_c, 100)

@test
fn test_response_indication_and_terminate_round_trip()
    var x = t_cis(true)
    t_set(var x, "off_min", 600)
    t_set(var x, "off_max", 4000)
    t_set(var x, "off_ev", 77)
    var p = ll_pdu.pdu_new()
    put_cis_rsp(var p, var x)
    test.assert_eq(ll_data.dpdu_len(var p), 9)
    test.assert_eq(ll_data.ctrl_payload_len(ll_data.OP_CIS_RSP), 9)
    var y = cis_new()
    get_cis_rsp(var p, var y)
    test.assert_eq(y.off_min, 600)
    test.assert_eq(y.off_max, 4000)
    test.assert_eq(y.off_ev, 77)
    t_set(var x, "aa", 0xA5A5C3C3)
    t_set(var x, "cis_offset", 3500)
    t_set(var x, "cig_sync", 0x7FFFFF)
    t_set(var x, "cis_sync", 2222)
    t_set(var x, "ind_ev", 0xFFFE)
    put_cis_ind(var p, var x)
    test.assert_eq(ll_data.dpdu_len(var p), 16)
    test.assert_eq(ll_data.ctrl_payload_len(ll_data.OP_CIS_IND), 16)
    get_cis_ind(var p, var y)
    test.assert_eq(y.aa, 0xA5A5C3C3)
    test.assert_eq(y.cis_offset, 3500)
    test.assert_eq(y.cig_sync, 0x7FFFFF)
    test.assert_eq(y.cis_sync, 2222)
    test.assert_eq(y.ind_ev, 0xFFFE)
    put_cis_terminate(var p, 3, 4, 0x13)
    test.assert_eq(ll_data.dpdu_len(var p), 4)
    test.assert_eq(ll_data.ctrl_payload_len(ll_data.OP_CIS_TERMINATE_IND), 4)
    test.assert_eq(ll_data.dpdu_byte(var p, 1), 3)
    test.assert_eq(ll_data.dpdu_byte(var p, 2), 4)
    test.assert_eq(ll_data.dpdu_byte(var p, 3), 0x13)

@test
fn test_a_request_is_checked_against_the_mandatory_ranges_and_this_controllers_limits()
    var x = t_cis(false)
    t_set(var x, "off_min", 600)
    t_set(var x, "off_max", 3000)
    test.assert_eq(cis_req_check(var x, 30000), 0)
    t_set(var x, "off_max", 30000)
    test.assert_eq(cis_req_check(var x, 30000), STATUS_PARAMETER_OUT_OF_RANGE)
    t_set(var x, "off_max", 3000)
    t_set(var x, "off_min", 100)
    test.assert_eq(cis_req_check(var x, 30000), STATUS_PARAMETER_OUT_OF_RANGE)
    t_set(var x, "off_min", 600)
    // Framed PDUs are taken in both modes; in Unsegmented mode a PDU holds a whole SDU with its 5 octets.
    t_set(var x, "framed", 1)
    test.assert_eq(cis_req_check(var x, 30000), 0)
    t_set(var x, "unseg", 1)
    t_set(var x, "max_sdu_c", 95)
    t_set(var x, "max_sdu_p", 95)
    test.assert_eq(cis_req_check(var x, 30000), 0)
    t_set(var x, "max_sdu_c", 96)
    test.assert_eq(cis_req_check(var x, 30000), STATUS_PARAMETER_OUT_OF_RANGE)
    t_set(var x, "max_sdu_c", 100)
    t_set(var x, "max_sdu_p", 100)
    t_set(var x, "unseg", 0)
    // A framed direction needs a PDU that can start an SDU.
    t_set(var x, "max_pdu_c", 5)
    test.assert_eq(cis_req_check(var x, 30000), STATUS_PARAMETER_OUT_OF_RANGE)
    t_set(var x, "max_pdu_c", 100)
    t_set(var x, "framed", 0)
    t_set(var x, "phy", 0)
    test.assert_eq(cis_req_check(var x, 30000), STATUS_UNSUPPORTED_LL_PARAMETER)
    t_set(var x, "phy", 2)
    t_set(var x, "nse", 6)
    // The direction this end sends needs BN x (FT + 1) slots of the ring (Parameter Out of Mandatory Range, the code of Section 5.1.15 for
    // a BN, FT or NSE not supported); the direction it receives needs none.
    t_set(var x, "bn_p", 4)
    t_set(var x, "ft_p", 3)
    test.assert_eq(cis_req_check(var x, 30000), STATUS_PARAMETER_OUT_OF_RANGE)
    test.assert_eq(cis_req_why(var x, 30000) >> 8, WHY_RING)
    t_set(var x, "bn_p", 1)
    t_set(var x, "ft_p", 1)
    t_set(var x, "bn_c", 4)
    t_set(var x, "ft_c", 9)
    test.assert_eq(cis_req_check(var x, 30000), 0)
    t_set(var x, "bn_c", 1)
    t_set(var x, "ft_c", 1)
    t_set(var x, "nse", 40)
    test.assert_eq(cis_req_check(var x, 30000), STATUS_PARAMETER_OUT_OF_RANGE)
    t_set(var x, "nse", 2)
    t_set(var x, "max_pdu_p", 0)
    test.assert_eq(cis_req_check(var x, 30000), STATUS_PARAMETER_OUT_OF_RANGE)

// The sample data of [Vol 6] Part C, Section 3: the channels of the first subevents for 37, 9 and 3 used
// channels.
@test
fn test_subevent_channels_follow_the_sample_data_of_the_specification()
    let aa = 0x8E89BED6
    let full = 0x1FFFFFFFFF
    test.assert_eq(sub_channel(aa, 0, 1, full, 37), 25)
    test.assert_eq(sub_channel(aa, 0, 2, full, 37), 1)
    test.assert_eq(sub_channel(aa, 0, 3, full, 37), 16)
    test.assert_eq(sub_channel(aa, 0, 4, full, 37), 36)
    test.assert_eq(sub_channel(aa, 1, 1, full, 37), 20)
    test.assert_eq(sub_channel(aa, 1, 2, full, 37), 36)
    test.assert_eq(sub_channel(aa, 1, 3, full, 37), 12)
    test.assert_eq(sub_channel(aa, 1, 4, full, 37), 34)
    test.assert_eq(sub_channel(aa, 2, 4, full, 37), 21)
    test.assert_eq(sub_channel(aa, 3, 2, full, 37), 4)
    let m9 = 0x1E00E00600
    test.assert_eq(sub_channel(aa, 6, 1, m9, 9), 23)
    test.assert_eq(sub_channel(aa, 6, 2, m9, 9), 35)
    test.assert_eq(sub_channel(aa, 6, 3, m9, 9), 21)
    test.assert_eq(sub_channel(aa, 6, 4, m9, 9), 36)
    test.assert_eq(sub_channel(aa, 7, 1, m9, 9), 9)
    test.assert_eq(sub_channel(aa, 7, 2, m9, 9), 22)
    test.assert_eq(sub_channel(aa, 7, 3, m9, 9), 36)
    test.assert_eq(sub_channel(aa, 7, 4, m9, 9), 33)
    test.assert_eq(sub_channel(aa, 8, 1, m9, 9), 34)
    test.assert_eq(sub_channel(aa, 8, 4, m9, 9), 10)
    let m3 = 0x106
    test.assert_eq(sub_channel(aa, 11, 1, m3, 3), 1)
    test.assert_eq(sub_channel(aa, 11, 2, m3, 3), 2)
    test.assert_eq(sub_channel(aa, 11, 3, m3, 3), 1)
    test.assert_eq(sub_channel(aa, 11, 4, m3, 3), 8)
    test.assert_eq(sub_channel(aa, 13, 4, m3, 3), 1)

@test
fn test_the_minimum_channel_distance_follows_the_number_of_used_channels()
    test.assert_eq(sub_distance(37), 11)
    test.assert_eq(sub_distance(9), 3)
    test.assert_eq(sub_distance(3), 1)
    test.assert_eq(sub_distance(2), 1)

@test
fn test_flush_points_follow_the_figures_of_the_specification()
    // BN 2, FT 1, NSE 4 (Figure 4.64): payload 0 is flushed after 2 subevents, payload 1 after 4, of event 0.
    test.assert_eq(flush_event(0, 2, 1), 0)
    test.assert_eq(flush_subs(0, 2, 4), 2)
    test.assert_eq(flush_subs(1, 2, 4), 4)
    test.assert(not flushed(0, 2, 1, 4, 0, 2))
    test.assert(flushed(0, 2, 1, 4, 0, 3))
    test.assert(not flushed(1, 2, 1, 4, 0, 4))
    test.assert(flushed(1, 2, 1, 4, 1, 1))
    // BN 1, FT 2, NSE 4 (Figure 4.65): payload 0 is flushed after the 4 subevents of event 1.
    test.assert_eq(flush_event(0, 1, 2), 1)
    test.assert_eq(flush_subs(0, 1, 4), 4)
    test.assert(not flushed(0, 1, 2, 4, 1, 4))
    test.assert(flushed(0, 1, 2, 4, 2, 1))
    test.assert(flushed(3, 1, 2, 4, 5, 1))

@test
fn test_an_sdu_is_cut_into_upps_payloads_and_padded()
    if not ctl_limits.iso_on()
        return
    var x = t_cis(true)
    t_set(var x, "max_sdu_c", 250)
    t_set(var x, "max_pdu_c", 100)
    t_set(var x, "bn_c", 3)
    t_set(var x, "ft_c", 1)
    test.assert_eq(tx_upps(var x), 3)
    var d = t_sdu(1)
    // 250 octets: fragments of 100, 100 and 50.
    test.assert(sdu_put(var x, var d, 0, 250))
    test.assert_eq(x.tx_wr, 3)
    test.assert_eq(x.txl[0], 100)
    test.assert_eq(x.txf[0] & 3, 1)
    test.assert_eq(x.txl[1], 100)
    test.assert_eq(x.txf[1] & 3, 1)
    test.assert_eq(x.txl[2], 50)
    test.assert_eq(x.txf[2] & 3, 0)
    test.assert_eq(x.txf[2] & 4, 4)
    // 120 octets: two fragments and a padding payload.
    test.assert(sdu_put(var x, var d, 0, 120))
    test.assert_eq(x.txl[3], 100)
    test.assert_eq(x.txf[3] & 3, 1)
    test.assert_eq(x.txl[4], 20)
    test.assert_eq(x.txf[4] & 3, 0)
    test.assert_eq(x.txl[5], 0)
    test.assert_eq(x.txf[5] & 3, 1)
    test.assert_eq(x.txf[5] & 8, 8)
    test.assert_eq(x.txf[5] & 4, 4)
    // The first SDU is acknowledged, which frees its three slots.  A zero-length SDU: one empty payload
    // of LLID 0 and two of padding.
    t_set(var x, "tx_num", 3)
    test.assert(sdu_put(var x, var d, 0, 0))
    test.assert_eq(x.txl[6], 0)
    test.assert_eq(x.txf[6] & 3, 0)
    test.assert_eq(x.txf[7] & 8, 8)
    // The ring is full: no room for the next, and an SDU over the maximum is refused.
    test.assert(not sdu_put(var x, var d, 0, 10))
    var y = t_cis(true)
    test.assert(not sdu_put(var y, var d, 0, 101))

@test
fn test_a_payload_the_radio_program_places_later_is_queued_now_and_its_octets_follow()
    if not ctl_limits.iso_on()
        return
    var x = t_cis(false)
    var p = ll_pdu.pdu_new()
    ll_data.dpdu_begin(var p, 0)
    for i in 0..40
        let _a = ll_pdu.pdu_put_data(var p, 0x30 + i)
    ll_data.dpdu_finish(var p)
    // With `defer` set the SDU is queued with its length and status, and the slot holds nothing yet: the octets wait in the PDU.
    t_set(var x, "defer", 1)
    rx_note(var x, 0, true, var p)
    t_set(var x, "defer", 0)
    test.assert_eq(x.out_n, 1)
    test.assert_eq(x.outl[0], 40)
    test.assert_eq(x.outs[0], SDU_VALID)
    test.assert_eq(x.cp_n, 40)
    test.assert_eq(x.outd[0] as Int, 0)
    test.assert(rx_copy(var x, var p))
    test.assert_eq(x.cp_n, 0)
    test.assert_eq(x.outd[0] as Int, 0x30)
    test.assert_eq(x.outd[39] as Int, 0x30 + 39)
    test.assert(not rx_copy(var x, var p))
    // The slot of the next SDU is the next one, so the first is not overwritten.
    t_set(var x, "defer", 1)
    rx_note(var x, 1, true, var p)
    t_set(var x, "defer", 0)
    test.assert_eq(x.out_n, 2)
    test.assert_eq(x.cp_at, OUT_OCTETS)
    test.assert(rx_copy(var x, var p))
    test.assert_eq(x.outd[OUT_OCTETS] as Int, 0x30)
    test.assert_eq(x.outd[0] as Int, 0x30)
    // A second payload while one waits is not placed: the SDU it belongs to is possibly invalid.
    out_take(var x)
    out_take(var x)
    t_set(var x, "defer", 1)
    rx_note(var x, 2, true, var p)
    var q = ll_pdu.pdu_new()
    ll_data.dpdu_begin(var q, 0)
    for i in 0..5
        let _b = ll_pdu.pdu_put_data(var q, 0x50 + i)
    ll_data.dpdu_finish(var q)
    rx_note(var x, 3, true, var q)
    t_set(var x, "defer", 0)
    test.assert_eq(x.out_n, 2)
    test.assert_eq(x.outs[(x.out_head + 1) % OUT_SLOTS], SDU_INVALID)
    test.assert_eq(x.cp_n, 40)

@test
fn test_a_burst_is_filled_with_padding_to_bn_payloads_an_event()
    if not ctl_limits.iso_on()
        return
    var x = t_cis(true)
    t_set(var x, "bn_c", 2)
    t_set(var x, "max_sdu_c", 100)
    t_set(var x, "max_pdu_c", 100)
    t_set(var x, "sdu_int_c", 5000)
    // BN 2 = UPPS 1 x USPI 2.
    test.assert_eq(tx_upps(var x), 1)
    var d = t_sdu(7)
    test.assert(sdu_put(var x, var d, 0, 60))
    tx_fill(var x, 0)
    test.assert_eq(x.tx_wr, 2)
    test.assert_eq(x.txf[1] & 8, 8)
    tx_fill(var x, 1)
    test.assert_eq(x.tx_wr, 4)
    // Eligible only for the events the burst belongs to.
    test.assert(tx_eligible(var x, 0, 0))
    test.assert(tx_eligible(var x, 1, 0))
    test.assert(not tx_eligible(var x, 2, 0))
    test.assert(tx_eligible(var x, 2, 1))

@test
fn test_header_octets_carry_the_llid_nesn_sn_and_npi()
    if not ctl_limits.iso_on()
        return
    var x = t_cis(true)
    var d = t_sdu(7)
    test.assert(sdu_put(var x, var d, 0, 60))
    // Payload 0: LLID 0, SN 0, NESN 0.
    test.assert_eq(tx_header(var x, 0), 0)
    t_set(var x, "rx_num", 1)
    test.assert_eq(tx_header(var x, 0), 4)
    // The Null PDU: LLID 1, NPI 1.
    test.assert_eq(tx_header(var x, -1), 1 | 4 | 0x40)
    var p = ll_pdu.pdu_new()
    tx_build(var x, 0, var p)
    test.assert_eq(p.n, 62)
    test.assert_eq(ll_data.dpdu_len(var p), 60)
    test.assert_eq(p.b[2] as Int, 7)
    test.assert_eq(p.b[61] as Int, 66)
    tx_build(var x, -1, var p)
    test.assert_eq(p.n, 2)
    test.assert_eq(p.b[1] as Int, 0)

// One subevent `s` of CIS event `e` between the two ends, as the Controller drives them: the flush
// rules run, the Central sends, the Peripheral decides its answer from the header, applies the packet
// and answers, and the Central applies the answer.  `lose_c` drops the Central's packet, `lose_p` the
// Peripheral's answer.
fn pair_sub(var c: Cis, var p: Cis, e: Int, s: Int, lose_c: Bool, lose_p: Bool)
    var pc = ll_pdu.pdu_new()
    var pp = ll_pdu.pdu_new()
    var scr = ll_pdu.pdu_new()
    tx_flush(var c, e, s)
    rx_flush(var c, e, s, var scr)
    tx_flush(var p, e, s)
    rx_flush(var p, e, s, var scr)
    let cn = tx_pick(var c, e)
    tx_build(var c, cn, var pc)
    t_set(var c, "sent_num", cn)
    if lose_c
        return
    // The Peripheral hears the Central.
    let pcur = tx_pick(var p, e)
    let pnxt = tx_pick_next(var p, e, s)
    let hdr = rx_fast(var p, pc.b[0] as Int, pcur, pnxt)
    var num = pcur
    if p.use_nxt
        num = pnxt
    tx_build(var p, num, var pp)
    pp.b[0] = hdr as u8
    t_set(var p, "sent_num", num)
    rx_apply(var p, e, s, var pc, true, 0)
    if lose_p
        return
    // The Central hears the answer.
    let _h = rx_fast(var c, pp.b[0] as Int, -1, -1)
    rx_apply(var c, e, s, var pp, true, 0)

// One CIS event: `lose` is 0 for none lost, 1 for every Central packet, 2 for every answer, 3 for
// the Central's first packet only.
fn pair_event(var c: Cis, var p: Cis, e: Int, lose: Int)
    t_set(var c, "ev", e)
    event_begin(var c)
    t_set(var p, "ev", e)
    event_begin(var p)
    for s in 1..c.nse + 1
        var lc = false
        var lp = false
        if lose == 1 or lose == 3 and s == 1
            lc = true
        if lose == 2
            lp = true
        pair_sub(var c, var p, e, s, lc, lp)

fn pair_drain(var x: Cis) -> Int
    var n = 0
    for _ in 0..4
        if out_ready(var x)
            out_take(var x)
            n = n + 1
    n

@test
fn test_every_sdu_reaches_the_peer_on_a_clean_link_and_is_acknowledged()
    if not ctl_limits.iso_on()
        return
    var c = t_cis(true)
    var p = t_cis(false)
    var d = t_sdu(0)
    var got = 0
    var done = 0
    for e in 0..30
        d[0] = (e & 0xFF) as u8
        test.assert(sdu_put(var c, var d, 0, 60))
        pair_event(var c, var p, e, 0)
        if out_ready(var p)
            test.assert_eq(p.outl[p.out_head], 60)
            test.assert_eq(p.outs[p.out_head], SDU_VALID)
            test.assert_eq(p.outd[p.out_head * OUT_OCTETS] as Int, got)
            test.assert_eq(p.outq[p.out_head], got)
            got = got + 1
            out_take(var p)
        done = done + comp_take(var c)
    test.assert_eq(got, 30)
    test.assert_eq(done, 30)
    test.assert_eq(c.n_flush_tx, 0)
    test.assert_eq(p.n_dup, 0)

@test
fn test_a_lost_packet_is_sent_again_in_the_next_subevent_when_nse_allows()
    if not ctl_limits.iso_on()
        return
    var c = t_cis(true)
    var p = t_cis(false)
    var d = t_sdu(0)
    test.assert(sdu_put(var c, var d, 0, 60))
    // The first subevent of event 0 is lost; the second carries the payload again.
    pair_event(var c, var p, 0, 3)
    test.assert_eq(p.n_rx, 1)
    test.assert_eq(p.rx_num, 1)
    test.assert_eq(c.tx_num, 1)
    test.assert_eq(c.comp, 1)
    test.assert_eq(p.out_n, 1)
    test.assert_eq(p.outs[0], SDU_VALID)

@test
fn test_a_lost_answer_makes_the_central_send_again_and_the_peripheral_drop_the_duplicate()
    if not ctl_limits.iso_on()
        return
    var c = t_cis(true)
    var p = t_cis(false)
    var d = t_sdu(0)
    test.assert(sdu_put(var c, var d, 0, 60))
    pair_event(var c, var p, 0, 2)
    // Every answer was lost: the Central never saw an acknowledgement, its payload is flushed after FT 1.
    test.assert_eq(p.rx_num, 1)
    test.assert_eq(p.n_dup, 1)
    test.assert_eq(p.out_n, 1)
    test.assert_eq(c.tx_num, 0)
    pair_event(var c, var p, 1, 0)
    test.assert_eq(c.n_flush_tx, 1)
    test.assert_eq(c.comp, 1)

@test
fn test_a_payload_that_is_never_heard_is_flushed_and_its_sdu_reported_lost()
    if not ctl_limits.iso_on()
        return
    var c = t_cis(true)
    var p = t_cis(false)
    var d = t_sdu(0)
    var statuses: [Int] = []
    var lens: [Int] = []
    // Three SDUs; the second one's event is lost entirely.
    test.assert(sdu_put(var c, var d, 0, 40))
    pair_event(var c, var p, 0, 0)
    for _ in 0..2
        if out_ready(var p)
            list.push(statuses, p.outs[p.out_head])
            list.push(lens, p.outl[p.out_head])
            out_take(var p)
    test.assert(sdu_put(var c, var d, 0, 41))
    pair_event(var c, var p, 1, 1)
    test.assert(sdu_put(var c, var d, 0, 42))
    pair_event(var c, var p, 2, 0)
    pair_event(var c, var p, 3, 0)
    for _ in 0..3
        if out_ready(var p)
            list.push(statuses, p.outs[p.out_head])
            list.push(lens, p.outl[p.out_head])
            out_take(var p)
    // The peripheral got payload 0, missed 1 (flushed at the start of event 2), took payload 2.
    test.assert_eq(list.len(statuses), 3)
    test.assert_eq(statuses[0], SDU_VALID)
    test.assert_eq(lens[0], 40)
    test.assert_eq(statuses[1], SDU_LOST)
    test.assert_eq(lens[1], 0)
    test.assert_eq(statuses[2], SDU_VALID)
    test.assert_eq(lens[2], 42)
    test.assert_eq(p.n_flush_rx, 1)
    test.assert_eq(c.n_flush_tx, 1)

@test
fn test_both_directions_carry_data_at_once()
    if not ctl_limits.iso_on()
        return
    var c = t_cis(true)
    var p = t_cis(false)
    var d = t_sdu(0)
    var a = 0
    var b = 0
    for e in 0..20
        test.assert(sdu_put(var c, var d, 0, 30))
        test.assert(sdu_put(var p, var d, 0, 50))
        pair_event(var c, var p, e, 0)
        a = a + pair_drain(var p)
        b = b + pair_drain(var c)
    test.assert_eq(a, 20)
    test.assert_eq(b, 20)
    test.assert_eq(c.n_sdu_bad, 0)
    test.assert_eq(p.n_sdu_bad, 0)

@test
fn test_a_cis_event_closed_by_the_peer_ends()
    var x = t_cis(false)
    var p = ll_pdu.pdu_new()
    event_begin(var x)
    // A Null PDU from the Central with CIE set.
    let hdr = 1 | 0x40 | 0x10
    let _h = rx_fast(var x, hdr, -1, -1)
    rx_apply(var x, 0, 1, var p, true, 1000)
    test.assert(event_over(var x))
    test.assert_eq(x.n_null_rx, 1)

@test
fn test_a_peripheral_takes_the_anchor_from_the_first_packet_of_an_event()
    var x = t_cis(false)
    t_set(var x, "anchor", 100000)
    t_set(var x, "synced", 1)
    t_set(var x, "last_rx", 100000)
    event_begin(var x)
    sync_anchor(var x, 2, 101500 + 12)
    test.assert_eq(x.anchor, 100012)
    sync_anchor(var x, 2, 105000)
    test.assert_eq(x.anchor, 100012)
    test.assert_eq(sub_start(var x, 2), 100012 + 1500)
    test.assert_eq(event_end(var x, 106000), 0)
    test.assert_eq(x.anchor, 100012 + 10000)
    test.assert_eq(x.ev, 1)

@test
fn test_a_stream_that_hears_nothing_fails_to_establish_after_six_intervals()
    var x = t_cis(false)
    t_set(var x, "synced", 0)
    t_set(var x, "first_us", 1000)
    t_set(var x, "anchor", 1000)
    event_begin(var x)
    var r = 0
    for _ in 0..8
        r = event_end(var x, x.anchor + 5000)
        if r != 0
            break
    test.assert_eq(r, STATUS_FAILED_TO_ESTABLISH)

@test
fn test_an_established_stream_is_lost_at_the_supervision_timeout()
    var x = t_cis(false)
    t_set(var x, "synced", 1)
    t_set(var x, "sup_us", 100000)
    t_set(var x, "last_rx", 0)
    t_set(var x, "anchor", 0)
    event_begin(var x)
    test.assert_eq(event_end(var x, 50000), 0)
    test.assert_eq(event_end(var x, 100001), REASON_TIMEOUT)

@test
fn test_late_subevents_are_skipped_whole()
    var x = t_cis(false)
    t_set(var x, "anchor", 10000)
    t_set(var x, "synced", 1)
    t_set(var x, "last_rx", 10000)
    event_begin(var x)
    // The program woke 25 ms later: subevents of three events passed.
    let n = skip_late(var x, 10000 + 25000, 150)
    test.assert(n >= 6)
    test.assert_eq(x.ev, 3)
    test.assert(sub_start(var x, x.sub) + se_len_us(var x) > 35000)

@test
fn test_widening_grows_with_the_time_since_the_last_anchor()
    test.assert_eq(widening_us(50, 10000, 4000), 1 + 32)
    test.assert(widening_us(500, 1000000, 100000) > widening_us(50, 1000000, 100000))
    test.assert_eq(widening_us(500, 100000000, 3000), 3000)

@test
fn test_slots_match_the_profile()
    test.assert(ctl_limits.cis_slots() >= 1)
    test.assert(ctl_limits.cig_slots() >= 1)
    test.assert(not ctl_limits.iso_on() or ctl_limits.iso_on())

// ── The derivation of a group ───────────────────────────────────────

fn t_plan_set(var p: Vec[CisPlan; 8], i: Int, sdu_c: Int, sdu_p: Int, rtn_c: Int, rtn_p: Int,
              masks: Int)
    p[i].cis_id = i
    p[i].max_sdu_c = sdu_c
    p[i].max_sdu_p = sdu_p
    p[i].phy_c = masks
    p[i].phy_p = masks
    p[i].rtn_c = rtn_c
    p[i].rtn_p = rtn_p

fn t_plan_framed(var g: GroupPlan)
    g.framing = 1

fn t_plan_mode(var g: GroupPlan, mode: Int)
    g.framing = mode

fn t_pdu_n(var p: Pdu, n: Int)
    p.n = n

fn t_plans() -> Vec[CisPlan; 8]
    var p: Vec[CisPlan; 8] = Vec.new()
    for _ in 0..8
        let _a = p.push(plan_new())
    p

@test
fn test_the_iso_interval_is_a_multiple_of_the_sdu_intervals_and_of_1250_microseconds()
    test.assert_eq(iso_interval_for(10000, 10000), 10000)
    test.assert_eq(iso_interval_for(7500, 0), 7500)
    test.assert_eq(iso_interval_for(0, 7500), 7500)
    test.assert_eq(iso_interval_for(7500, 10000), 30000)
    test.assert_eq(iso_interval_for(5000, 0), 5000)
    test.assert_eq(iso_interval_for(2500, 0), 5000)
    test.assert_eq(iso_interval_for(20000, 10000), 20000)
    // An SDU interval no multiple of 1.25 ms has no interval under 4 s: framed PDUs are needed.
    test.assert_eq(iso_interval_for(8163, 0), 0)

@test
fn test_one_stream_gets_the_subevents_its_retransmission_number_needs()
    var p = t_plans()
    t_plan_set(var p, 0, 100, 100, 2, 2, 3)
    var g = group_plan_new()
    test.assert_eq(plan_cig(var p, 1, 10000, 10000, 20, 20, 0, ll_radio.profile_assumed(), var g), 0)
    test.assert_eq(g.iso_us, 10000)
    // LE 2M (the shortest packets), one payload an event each way, three subevents for three opportunities at FT 1.
    test.assert_eq(p[0].phy, 2)
    test.assert_eq(p[0].pdu_c, 100)
    test.assert_eq(p[0].bn_c, 1)
    test.assert_eq(p[0].bn_p, 1)
    test.assert_eq(p[0].nse, 3)
    test.assert_eq(g.ft_c, 1)
    test.assert_eq(g.ft_p, 1)
    // SE_Length of two packets of 100 octets at 2M: 460 + 150 + 460 + 150.
    test.assert_eq(p[0].sub_int, 1220)
    test.assert_eq(p[0].off, 0)
    // The event: two sub-intervals and one exchange.
    test.assert_eq(g.sync, 2 * 1220 + 460 + 150 + 460)
    test.assert_eq(p[0].cis_sync, g.sync)

@test
fn test_two_streams_in_sequence_follow_one_another()
    var p = t_plans()
    t_plan_set(var p, 0, 100, 100, 2, 2, 3)
    t_plan_set(var p, 1, 100, 100, 2, 2, 3)
    var g = group_plan_new()
    test.assert_eq(plan_cig(var p, 2, 7500, 7500, 20, 20, 0, ll_radio.profile_assumed(), var g), 0)
    test.assert_eq(g.iso_us, 7500)
    test.assert_eq(p[0].nse, 3)
    test.assert_eq(p[1].nse, 3)
    // The second starts after the first's slot: NSE x Sub_Interval.
    test.assert_eq(p[0].off, 0)
    test.assert_eq(p[1].off, 3 * 1220)
    test.assert_eq(g.sync, 3 * 1220 + 2 * 1220 + 1070)
    test.assert_eq(p[0].cis_sync, g.sync)
    test.assert_eq(p[1].cis_sync, g.sync - 3 * 1220)

@test
fn test_two_streams_interleaved_share_the_sub_interval()
    var p = t_plans()
    t_plan_set(var p, 0, 100, 100, 2, 2, 3)
    t_plan_set(var p, 1, 100, 100, 2, 2, 3)
    var g = group_plan_new()
    test.assert_eq(plan_cig(var p, 2, 10000, 10000, 30, 30, 1, ll_radio.profile_assumed(), var g), 0)
    // Sub_Interval is the sum of the two SE_Length, the streams start one SE_Length apart.
    test.assert_eq(p[0].sub_int, 2 * 1220)
    test.assert_eq(p[1].sub_int, 2 * 1220)
    test.assert_eq(p[0].off, 0)
    test.assert_eq(p[1].off, 1220)
    test.assert_eq(g.sync, 1220 + 2 * 2440 + 1070)
    test.assert_eq(p[1].cis_sync, g.sync - 1220)

@test
fn test_a_radio_with_a_fast_ramp_up_takes_the_shortest_subevent_spacing()
    // The gap between two subevents is T_MSS_CIS (150) when Sub_Interval is SE_Length; a fast ramp-up of 45 with its margin
    // of 25 leaves 80 for the program's work, which is what `ll_radio.SUBEVENT_WORK_US` asks.
    let prof = ll_radio.profile_new(true, 145, 45)
    var p = t_plans()
    t_plan_set(var p, 0, 100, 100, 2, 2, 3)
    var g = group_plan_new()
    test.assert_eq(plan_cig(var p, 1, 10000, 10000, 20, 20, 0, prof, var g), 0)
    var q = t_plans()
    t_plan_set(var q, 0, 100, 100, 2, 2, 3)
    t_plan_set(var q, 1, 100, 100, 2, 2, 3)
    var h = group_plan_new()
    test.assert_eq(plan_cig(var q, 2, 10000, 10000, 30, 30, 1, prof, var h), 0)
    var r = t_plans()
    t_plan_set(var r, 0, 100, 100, 2, 2, 3)
    t_plan_set(var r, 1, 100, 100, 2, 2, 3)
    var k = group_plan_new()
    test.assert_eq(plan_cig(var r, 2, 7500, 7500, 20, 20, 0, prof, var k), 0)

@test
fn test_a_radio_without_a_fast_ramp_up_refuses_subevents_that_follow_too_close()
    // The legacy ramp-up of 145 with its margin and the program's work need a gap of 250, and the spacing of payloads of 10 octets
    // is 150 and the 20 microseconds the program takes for them (long payloads buy the gap, see the test after the next): a
    // stream of several subevents, and two streams one after the other or interleaved, are Unsupported Feature or Parameter
    // Value (0x11).  A single stream of one subevent has no next one and is taken.
    let prof = ll_radio.profile_new(false, 145, 0)
    var p = t_plans()
    t_plan_set(var p, 0, 10, 10, 2, 2, 3)
    var g = group_plan_new()
    test.assert_eq(plan_cig(var p, 1, 10000, 10000, 20, 20, 0, prof, var g), STATUS_UNSUPPORTED_FEATURE)
    var q = t_plans()
    t_plan_set(var q, 0, 10, 10, 2, 2, 3)
    t_plan_set(var q, 1, 10, 10, 2, 2, 3)
    var h = group_plan_new()
    test.assert_eq(plan_cig(var q, 2, 10000, 10000, 30, 30, 1, prof, var h), STATUS_UNSUPPORTED_FEATURE)
    var r = t_plans()
    t_plan_set(var r, 0, 10, 10, 0, 0, 3)
    var k = group_plan_new()
    test.assert_eq(plan_cig(var r, 1, 10000, 10000, 20, 20, 0, prof, var k), 0)
    test.assert_eq(r[0].nse, 1)
    var s2 = t_plans()
    t_plan_set(var s2, 0, 10, 10, 0, 0, 3)
    t_plan_set(var s2, 1, 10, 10, 0, 0, 3)
    var m = group_plan_new()
    test.assert_eq(plan_cig(var s2, 2, 10000, 10000, 20, 20, 0, prof, var m), STATUS_UNSUPPORTED_FEATURE)

@test
fn test_long_payloads_give_a_radio_without_a_fast_ramp_up_the_gap_it_needs()
    // The same radio with payloads of 100 octets each way: the spacing grows by the program's work on 200 octets (200 microseconds),
    // 350 against the 250 the radio needs, so the streams are taken.
    let prof = ll_radio.profile_new(false, 145, 0)
    var p = t_plans()
    t_plan_set(var p, 0, 100, 100, 2, 2, 3)
    var g = group_plan_new()
    test.assert_eq(plan_cig(var p, 1, 10000, 10000, 20, 20, 0, prof, var g), 0)
    var q = t_plans()
    t_plan_set(var q, 0, 100, 100, 2, 2, 3)
    t_plan_set(var q, 1, 100, 100, 2, 2, 3)
    var h = group_plan_new()
    test.assert_eq(plan_cig(var q, 2, 10000, 10000, 30, 30, 1, prof, var h), 0)

@test
fn test_the_gap_of_a_stream_is_checked_against_its_own_phy()
    let prof = ll_radio.RadioProfile { known: true, fast: true, octet_ns: 1000, slow_1m: 145, slow_2m: 145, slow_cod: 145,
                                      fast_1m: 45, fast_2m: 90, fast_cod: 45 }
    test.assert_eq(sub_gap_status(prof, ll_phy.PHY_2M, 3, 1220, 100, 100, 0x11), 0x11)
    test.assert_eq(sub_gap_status(prof, ll_phy.PHY_1M, 3, plan_se_len(ll_phy.PHY_1M, 100, 100), 100, 100, 0x11),
        0)
    // Sub_Interval beyond SE_Length is slack: 150 + 100 = 250 is enough for the 2M ramp-up of 90.
    test.assert_eq(sub_gap_status(prof, ll_phy.PHY_2M, 3, 1320, 100, 100, 0x11), 0)
    test.assert_eq(sub_gap_status(prof, ll_phy.PHY_2M, 1, 0, 100, 100, 0x11), 0)
    test.assert_eq(sub_gap_status(ll_radio.profile_assumed(), ll_phy.PHY_2M, 3, 1220, 100, 100, 0x11), 0)

@test
fn test_a_request_with_subevents_too_close_is_refused_with_unsupported_ll_parameter_by_a_slow_radio()
    var x = cis_new()
    t_set(var x, "phy", 2)
    t_set(var x, "nse", 3)
    t_set(var x, "max_pdu_c", 100)
    t_set(var x, "max_pdu_p", 100)
    t_set(var x, "sub_int", plan_se_len(ll_phy.PHY_2M, 100, 100))
    test.assert_eq(cis_req_gap(var x, ll_radio.profile_new(false, 145, 0)), STATUS_UNSUPPORTED_LL_PARAMETER)
    test.assert_eq(cis_req_gap(var x, ll_radio.profile_new(true, 145, 45)), 0)
    test.assert_eq(cis_req_gap(var x, ll_radio.profile_assumed()), 0)
    t_set(var x, "sub_int", plan_se_len(ll_phy.PHY_2M, 100, 100) + 100)
    test.assert_eq(cis_req_gap(var x, ll_radio.profile_new(false, 145, 0)), 0)

@test
fn test_a_unidirectional_stream_has_no_pdu_and_no_burst_the_other_way()
    var p = t_plans()
    t_plan_set(var p, 0, 120, 0, 3, 0, 2)
    var g = group_plan_new()
    test.assert_eq(plan_cig(var p, 1, 10000, 10000, 20, 20, 0, ll_radio.profile_assumed(), var g), 0)
    test.assert_eq(p[0].phy, 2)
    test.assert_eq(p[0].pdu_p, 0)
    test.assert_eq(p[0].bn_p, 0)
    test.assert_eq(p[0].bn_c, 1)
    test.assert_eq(p[0].nse, 4)
    // SE_Length: the packet of 120 octets, an empty packet back, the spaces.
    test.assert_eq(p[0].sub_int, 540 + 150 + 60 + 150)

@test
fn test_an_sdu_over_251_octets_is_cut_into_several_payloads_and_a_burst_per_event()
    var p = t_plans()
    t_plan_set(var p, 0, 240, 0, 0, 0, 2)
    var g = group_plan_new()
    test.assert_eq(plan_cig(var p, 1, 10000, 10000, 20, 20, 0, ll_radio.profile_assumed(), var g), 0)
    test.assert_eq(p[0].pdu_c, 240)
    test.assert_eq(p[0].bn_c, 1)
    // 310 octets (two channels of an LC3 stream at 48 kHz) are two payloads of the longest PDU: BN 2, and the subevent
    // holds the 251 octets.
    var w = t_plans()
    t_plan_set(var w, 0, 310, 0, 0, 0, 2)
    var gw = group_plan_new()
    test.assert_eq(plan_cig(var w, 1, 10000, 10000, 20, 20, 0, ll_radio.profile_assumed(), var gw), 0)
    test.assert_eq(w[0].pdu_c, 251)
    test.assert_eq(w[0].bn_c, 2)
    test.assert(w[0].nse >= 2)
    // 503 octets are three payloads: BN 3.
    var v = t_plans()
    t_plan_set(var v, 0, 503, 0, 0, 0, 2)
    var gv = group_plan_new()
    test.assert_eq(plan_cig(var v, 1, 10000, 10000, 20, 20, 0, ll_radio.profile_assumed(), var gv), 0)
    test.assert_eq(v[0].bn_c, 3)
    // Two SDUs an interval make BN 2.
    var q = t_plans()
    t_plan_set(var q, 0, 100, 0, 0, 0, 2)
    var h = group_plan_new()
    test.assert_eq(plan_cig(var q, 1, 5000, 5000, 20, 20, 0, ll_radio.profile_assumed(), var h), 0)
    test.assert_eq(q[0].bn_c, 1)
    var r = t_plans()
    t_plan_set(var r, 0, 100, 0, 0, 0, 2)
    var k = group_plan_new()
    // 10 ms intervals of 5 ms SDUs: BN 2.
    test.assert_eq(plan_cig(var r, 1, 5000, 10000, 20, 20, 0, ll_radio.profile_assumed(), var k), 0)
    test.assert_eq(k.iso_us, 5000)

@test
fn test_a_radio_that_reports_its_work_on_octets_gets_the_spacing_the_payloads_need()
    // 251 octets each way: the program's work on 502 octets at 1 microsecond is 502, and the subevents of the stream are that
    // much further apart than SE_Length.
    let prof = ll_radio.profile_new(true, 145, 45)
    var p = t_plans()
    t_plan_set(var p, 0, 310, 310, 2, 2, 3)
    var g = group_plan_new()
    test.assert_eq(plan_cig(var p, 1, 10000, 10000, 40, 40, 0, prof, var g), 0)
    test.assert_eq(p[0].pdu_c, 251)
    test.assert_eq(p[0].sub_int, plan_se_len(2, 251, 251) + 502)
    // A radio not asked adds nothing, so the specification's SE_Length stays the spacing.
    var q = t_plans()
    t_plan_set(var q, 0, 310, 310, 2, 2, 3)
    var h = group_plan_new()
    test.assert_eq(plan_cig(var q, 1, 10000, 10000, 40, 40, 0, ll_radio.profile_assumed(), var h), 0)
    test.assert_eq(q[0].sub_int, plan_se_len(2, 251, 251))
    // A slower CPU, 2 microseconds an octet, doubles the extra.
    let slow = ll_radio.profile_for(true, 145, 45, 2000)
    var r = t_plans()
    t_plan_set(var r, 0, 310, 310, 2, 2, 3)
    var k = group_plan_new()
    test.assert_eq(plan_cig(var r, 1, 10000, 10000, 40, 40, 0, slow, var k), 0)
    test.assert_eq(r[0].sub_int, plan_se_len(2, 251, 251) + 1004)
    // Streams in sequence start one slot apart, the slot being the spacing of the stream and not SE_Length.
    var two = t_plans()
    t_plan_set(var two, 0, 100, 100, 1, 1, 3)
    t_plan_set(var two, 1, 100, 100, 1, 1, 3)
    var gt = group_plan_new()
    test.assert_eq(plan_cig(var two, 2, 10000, 10000, 40, 40, 0, prof, var gt), 0)
    test.assert_eq(two[1].off - two[0].off, two[0].nse * two[0].sub_int)
    test.assert_eq(two[0].sub_int, plan_se_len(2, 100, 100) + 200)

@test
fn test_a_retransmission_number_the_interval_cannot_hold_raises_the_flush_timeout()
    var p = t_plans()
    t_plan_set(var p, 0, 100, 100, 10, 10, 3)
    var g = group_plan_new()
    test.assert_eq(plan_cig(var p, 1, 10000, 10000, 40, 40, 0, ll_radio.profile_assumed(), var g), 0)
    // 8 subevents fit the interval, and 8 x FT opportunities with FT 2 are 16: 11 are asked for.
    test.assert_eq(p[0].nse, 8)
    test.assert_eq(g.ft_c, 2)
    test.assert_eq(g.ft_p, 2)

@test
fn test_a_request_the_controller_cannot_plan_is_refused_with_the_status_of_its_reason()
    var p = t_plans()
    t_plan_set(var p, 0, 100, 100, 2, 2, 3)
    var g = group_plan_new()
    // The latency allowed is shorter than the event.
    test.assert_eq(plan_cig(var p, 1, 10000, 10000, 3, 3, 0, ll_radio.profile_assumed(), var g),
        STATUS_INVALID_PARAMETERS)
    // An SDU interval that needs framed PDUs.
    var q = t_plans()
    t_plan_set(var q, 0, 100, 100, 2, 2, 3)
    test.assert_eq(plan_cig(var q, 1, 8163, 8163, 40, 40, 0, ll_radio.profile_assumed(), var g),
        STATUS_UNSUPPORTED_FEATURE)
    // No PHY in common.
    var r = t_plans()
    t_plan_set(var r, 0, 100, 100, 2, 2, 1)
    r[0].phy_p = 2
    test.assert_eq(plan_cig(var r, 1, 10000, 10000, 40, 40, 0, ll_radio.profile_assumed(), var g),
        STATUS_UNSUPPORTED_FEATURE)
    // An SDU over the Controller's maximum.
    var s2 = t_plans()
    t_plan_set(var s2, 0, SDU_MAX + 1, 0, 0, 0, 3)
    test.assert_eq(plan_cig(var s2, 1, 10000, 10000, 40, 40, 0, ll_radio.profile_assumed(), var g),
        STATUS_MEMORY_CAPACITY)
    // No data either way.
    var t = t_plans()
    t_plan_set(var t, 0, 0, 0, 0, 0, 3)
    test.assert_eq(plan_cig(var t, 1, 10000, 10000, 40, 40, 0, ll_radio.profile_assumed(), var g),
        STATUS_INVALID_PARAMETERS)
    // Streams that cannot all fit the interval: eight of 100 octets in 5 ms.
    var u = t_plans()
    for i in 0..8
        t_plan_set(var u, i, 100, 100, 0, 0, 3)
    test.assert_eq(plan_cig(var u, 8, 5000, 5000, 40, 40, 0, ll_radio.profile_assumed(), var g),
        STATUS_INVALID_PARAMETERS)

// ── Framed PDUs ──────────────────────────────────────────────────────

// A framed stream: ISO interval `iso` units of 1.25 ms, SDUs of `len` octets every `sdu_int` microseconds in both directions,
// PDUs of `pdu` octets and `bn` payloads an event, two subevents.  The group's reference point and the stream's anchor are
// the same (no offset in the group).
fn t_framed(central: Bool, iso: Int, sdu_int: Int, len: Int, pdu: Int, bn: Int) -> Cis
    var x = t_cis(central)
    t_set(var x, "framed", 1)
    t_set(var x, "iso_int", iso)
    t_set(var x, "sdu_int_c", sdu_int)
    t_set(var x, "sdu_int_p", sdu_int)
    t_set(var x, "max_sdu_c", len)
    t_set(var x, "max_sdu_p", len)
    t_set(var x, "max_pdu_c", pdu)
    t_set(var x, "max_pdu_p", pdu)
    t_set(var x, "bn_c", bn)
    t_set(var x, "bn_p", bn)
    x

// The SDU `k` of `len` octets: its number in the first two, then octets that follow from it.
fn t_fr_sdu(var d: Vec[u8; 260], k: Int, len: Int)
    d[0] = (k & 0xFF) as u8
    d[1] = ((k >>> 8) & 0xFF) as u8
    for i in 2..len
        d[i] = ((k * 7 + i) & 0xFF) as u8

// The SDUs of `x` that arrive by `now`: SDU `n` arrives at `phase` + n x `sdu_int`.  `n` is the number of the next one.
@tier(app)
fn t_fr_arrive(var x: Cis, n: Int, now: Int, len: Int, sdu_int: Int, phase: Int) -> Int
    var d = t_sdu(0)
    var k = n
    for _ in 0..8
        let at = phase + k * sdu_int
        if at > now
            break
        t_fr_sdu(var d, k, len)
        test.assert(fsdu_put(var x, var d, 0, len, at))
        k = k + 1
    k

// Take the SDUs `x` has for the Host and check them against what was sent: `st` holds the index the next SDU must have (0),
// the valid ones (1), the lost ones (2) and those with wrong data, a wrong index or a wrong time stamp (3).  The
// time stamp of SDU `k` is `phase` + k x `sdu_int` + `lat`.
fn t_fr_check(var x: Cis, var st: Vec[Int; 4], len: Int, sdu_int: Int, phase: Int, lat: Int)
    for _ in 0..4
        if not out_ready(var x)
            break
        let at = x.out_head
        let k = x.outq[at]
        if x.outs[at] == SDU_VALID
            st[1] = st[1] + 1
            var good = x.outl[at] == len and k == st[0]
            if good
                good = (x.outd[at * OUT_OCTETS] as Int) == (k & 0xFF) and (x.outd[at * OUT_OCTETS + 1] as Int) == ((k >>> 8) & 0xFF)
            if good
                for i in 2..len
                    if (x.outd[at * OUT_OCTETS + i] as Int) != ((k * 7 + i) & 0xFF)
                        good = false
            if good and x.outt[at] != ((phase + k * sdu_int + lat) & 0xFFFFFFFF)
                good = false
            if not good
                st[3] = st[3] + 1
        else
            st[2] = st[2] + 1
            if x.outs[at] != SDU_LOST or k != st[0]
                st[3] = st[3] + 1
        st[0] = k + 1
        out_take(var x)

fn t_fr_stats() -> Vec[Int; 4]
    var st: Vec[Int; 4] = Vec.new()
    for _ in 0..4
        let _a = st.push(0)
    st

// `events` CIS events of a framed pair whose first anchor is `first`.  The Central's SDUs arrive from `phase_c` and the
// Peripheral's from `phase_p`, each `sdu_int` apart.  Events `lose_from` to `lose_from + lose_n - 1` are lost to
// both ends.  `sc` and `sp` are the checks of the Central's and the Peripheral's received SDUs; the answer is the credits the
// Central got back for the SDUs it sent.
@tier(app)
fn t_fr_run(var c: Cis, var p: Cis, events: Int, first: Int, len: Int, sdu_int: Int, phase_c: Int,
            phase_p: Int, lose_from: Int, lose_n: Int, var sc: Vec[Int; 4],
            var sp: Vec[Int; 4]) -> Int
    var nc = 0
    var np = 0
    var credits = 0
    // What a receiver stamps: the origin on the Central's side, the origin plus the delays on the Peripheral's.
    var lat_p = c.cig_sync + c.sdu_int_c + c.ft_c * iso_us(var c)
    if c.unseg
        lat_p = c.cig_sync + c.ft_c * iso_us(var c)
    for e in 0..events
        let anchor = first + e * iso_us(var c)
        t_set(var c, "anchor", anchor)
        t_set(var p, "anchor", anchor)
        t_set(var c, "ev", e)
        t_set(var p, "ev", e)
        nc = t_fr_arrive(var c, nc, anchor - 50, len, sdu_int, phase_c)
        np = t_fr_arrive(var p, np, anchor - 50, len, sdu_int, phase_p)
        var lose = 0
        if e >= lose_from and e < lose_from + lose_n
            lose = 1
        pair_event(var c, var p, e, lose)
        t_fr_check(var p, var sp, len, sdu_int, phase_c, lat_p)
        t_fr_check(var c, var sc, len, sdu_int, phase_p, 0)
        credits = credits + comp_take(var c)
    credits

@test
fn test_a_framed_sdu_is_one_segment_with_a_header_and_a_time_offset()
    if not ctl_limits.iso_on()
        return
    var x = t_framed(true, 8, 10000, 12, 37, 1)
    t_set(var x, "anchor", 10000)
    var d = t_sdu(3)
    // The SDU was due 3 ms before the anchor of event 0.
    test.assert(fsdu_put(var x, var d, 0, 12, 7000))
    test.assert_eq(x.tx_wr, 1)
    test.assert_eq(x.txl[0], 17)
    test.assert_eq(x.txf[0] & 3, 2)
    test.assert_eq(x.txf[0] >>> 8, 1)
    // SC 0 and CMPLT 1; the length counts the Time_Offset; 3000 microseconds, least significant octet first.
    test.assert_eq(x.txd[0] as Int, 2)
    test.assert_eq(x.txd[1] as Int, 15)
    test.assert_eq(x.txd[2] as Int, 3000 & 0xFF)
    test.assert_eq(x.txd[3] as Int, 3000 >>> 8)
    test.assert_eq(x.txd[4] as Int, 0)
    test.assert_eq(x.txd[5] as Int, 3)
    test.assert_eq(x.txd[16] as Int, 14)
    test.assert_eq(x.fo_num, 0)
    test.assert_eq(x.fo_off, 3000)
    test.assert_eq(x.sdu_in, 1)
    var p = ll_pdu.pdu_new()
    tx_build(var x, 0, var p)
    test.assert_eq(ll_data.dpdu_llid(var p), 2)
    test.assert_eq(ll_data.dpdu_len(var p), 17)

@test
fn test_small_sdus_share_a_pdu_until_it_cannot_start_another()
    if not ctl_limits.iso_on()
        return
    var x = t_framed(true, 8, 5000, 12, 37, 1)
    t_set(var x, "anchor", 10000)
    var d = t_sdu(3)
    test.assert(fsdu_put(var x, var d, 0, 12, 6000))
    test.assert(fsdu_put(var x, var d, 0, 12, 8000))
    // Two segments of 17 octets in one PDU, with their own Time_Offsets.
    test.assert_eq(x.tx_wr, 1)
    test.assert_eq(x.txl[0], 34)
    test.assert_eq(x.txf[0] >>> 8, 2)
    test.assert_eq(x.txd[17] as Int, 2)
    test.assert_eq(x.txd[18] as Int, 15)
    test.assert_eq(x.txd[19] as Int, 2000 & 0xFF)
    test.assert_eq(x.txd[20] as Int, 2000 >>> 8)
    // 3 octets are left, and the SDU is due after the anchor of event 0: it starts payload 1, which belongs to event 1.
    test.assert(fsdu_put(var x, var d, 0, 12, 12000))
    test.assert_eq(x.tx_wr, 2)
    test.assert_eq(x.txl[1], 17)
    test.assert_eq(x.fo_num, 1)
    test.assert_eq(x.fo_off, 20000 - 12000)

@test
fn test_an_sdu_over_a_pdu_continues_in_the_next_one_without_a_time_offset()
    if not ctl_limits.iso_on()
        return
    var x = t_framed(true, 8, 10000, 100, 40, 3)
    t_set(var x, "anchor", 10000)
    var d = t_sdu(5)
    test.assert(fsdu_put(var x, var d, 0, 100, 9000))
    // 35 octets in the first segment, 38 and 27 in the next two; only the last has CMPLT.
    test.assert_eq(x.tx_wr, 3)
    test.assert_eq(x.txl[0], 40)
    test.assert_eq(x.txl[1], 40)
    test.assert_eq(x.txl[2], 29)
    test.assert_eq(x.txd[0] as Int, 0)
    test.assert_eq(x.txd[1] as Int, 38)
    test.assert_eq(x.txd[256] as Int, 1)
    test.assert_eq(x.txd[257] as Int, 38)
    test.assert_eq(x.txd[512] as Int, 3)
    test.assert_eq(x.txd[513] as Int, 27)
    // The credit comes back with the last payload alone.
    test.assert_eq(x.txf[0] >>> 8, 0)
    test.assert_eq(x.txf[1] >>> 8, 0)
    test.assert_eq(x.txf[2] >>> 8, 1)
    // The first payload carries the first octets of the SDU, the second the next.
    test.assert_eq(x.txd[5] as Int, 5)
    test.assert_eq(x.txd[256 + 2] as Int, (5 + 35) & 0xFF)

@test
fn test_an_empty_framed_sdu_is_a_header_and_a_time_offset_alone()
    if not ctl_limits.iso_on()
        return
    var x = t_framed(true, 8, 10000, 12, 37, 1)
    t_set(var x, "anchor", 10000)
    var d = t_sdu(0)
    test.assert(fsdu_put(var x, var d, 0, 0, 9500))
    test.assert_eq(x.txl[0], 5)
    test.assert_eq(x.txd[0] as Int, 2)
    test.assert_eq(x.txd[1] as Int, 3)
    test.assert_eq(x.txd[2] as Int, 500 & 0xFF)
    test.assert_eq(x.txd[3] as Int, 500 >>> 8)

@test
fn test_an_sdu_due_after_the_anchor_waits_for_the_next_event_behind_padding()
    if not ctl_limits.iso_on()
        return
    var x = t_framed(true, 8, 10000, 12, 37, 1)
    t_set(var x, "anchor", 10000)
    var d = t_sdu(0)
    // Due 500 microseconds after the anchor of event 0: payload 0 is padding (a framed PDU of no octets) and the SDU goes in
    // payload 1, whose reference point is a whole ISO interval after the first, 9500 microseconds after the SDU.
    test.assert(fsdu_put(var x, var d, 0, 12, 10500))
    test.assert_eq(x.tx_wr, 2)
    test.assert_eq(x.txl[0], 0)
    test.assert_eq(x.txf[0] & 3, 2)
    test.assert_eq(x.txf[0] & 8, 8)
    test.assert_eq(x.txl[1], 17)
    test.assert_eq(x.fo_off, 9500)
    var p = ll_pdu.pdu_new()
    tx_build(var x, 0, var p)
    test.assert_eq(ll_data.dpdu_llid(var p), 2)
    test.assert_eq(ll_data.dpdu_len(var p), 0)

@test
fn test_an_sdu_without_room_in_the_ring_changes_nothing()
    if not ctl_limits.iso_on()
        return
    var x = t_framed(true, 8, 10000, 100, 40, 3)
    t_set(var x, "anchor", 10000)
    var d = t_sdu(5)
    test.assert(fsdu_put(var x, var d, 0, 100, 9000))
    test.assert(fsdu_put(var x, var d, 0, 100, 9000))
    // The second SDU began in the room the first left in its last payload, so 6 are in use; a third needs a seventh and an eighth,
    // and a ninth.
    let wr = x.tx_wr
    let n = x.sdu_in
    let last = x.txl[wr - 1]
    test.assert(not fsdu_put(var x, var d, 0, 100, 9000))
    test.assert_eq(x.tx_wr, wr)
    test.assert_eq(x.sdu_in, n)
    test.assert_eq(x.txl[wr - 1], last)
    // An SDU over Max_SDU is refused too.
    test.assert(not fsdu_put(var x, var d, 0, 101, 9000))

@test
fn test_a_burst_closes_the_open_pdu_and_pads_what_is_left()
    if not ctl_limits.iso_on()
        return
    var x = t_framed(true, 8, 10000, 12, 37, 2)
    t_set(var x, "anchor", 10000)
    var d = t_sdu(0)
    test.assert(fsdu_put(var x, var d, 0, 12, 9000))
    test.assert(x.fo_open)
    // The burst of event 0 is payloads 0 and 1: the PDU is closed with what it has, the second is padding.
    tx_fill(var x, 0)
    test.assert(not x.fo_open)
    test.assert_eq(x.tx_wr, 2)
    test.assert_eq(x.txl[0], 17)
    test.assert_eq(x.txf[1] & 8, 8)
    // An SDU due in the interval after goes in event 1's burst.
    test.assert(fsdu_put(var x, var d, 0, 12, 17000))
    test.assert_eq(x.tx_wr, 3)
    test.assert_eq(x.fo_off, 20000 - 17000)

@test
fn test_credits_return_for_each_sdu_that_ends_in_a_payload()
    if not ctl_limits.iso_on()
        return
    var x = t_framed(true, 8, 5000, 12, 37, 1)
    t_set(var x, "anchor", 10000)
    var d = t_sdu(0)
    test.assert(fsdu_put(var x, var d, 0, 12, 6000))
    test.assert(fsdu_put(var x, var d, 0, 12, 8000))
    t_set(var x, "tx_num", 0)
    tx_retire(var x, false)
    test.assert_eq(comp_take(var x), 2)

@test
fn test_framed_sdus_at_an_interval_that_is_no_multiple_of_the_iso_interval_arrive_whole_and_in_order()
    if not ctl_limits.iso_on()
        return
    // SDUs of 30 octets every 10 ms on a 7.5 ms ISO interval with PDUs of 29: each SDU is cut over two payloads, and an
    // event with no SDU due carries padding.
    var c = t_framed(true, 6, 10000, 30, 29, 1)
    var p = t_framed(false, 6, 10000, 30, 29, 1)
    var sc = t_fr_stats()
    var sp = t_fr_stats()
    let credits = t_fr_run(var c, var p, 40, 100000, 30, 10000, 95000, 92000, 99, 0, var sc, var sp)
    test.assert(sp[1] >= 28)
    test.assert(sc[1] >= 28)
    test.assert_eq(sp[2], 0)
    test.assert_eq(sc[2], 0)
    test.assert_eq(sp[3], 0)
    test.assert_eq(sc[3], 0)
    test.assert(credits >= sp[1] - 1)
    test.assert_eq(c.n_flush_tx, 0)

@test
fn test_small_framed_sdus_on_a_longer_iso_interval_arrive_together_from_one_payload()
    if not ctl_limits.iso_on()
        return
    // 12-octet SDUs every 5 ms on a 10 ms ISO interval: two SDUs are in each payload.
    var c = t_framed(true, 8, 5000, 12, 37, 1)
    var p = t_framed(false, 8, 5000, 12, 37, 1)
    var sc = t_fr_stats()
    var sp = t_fr_stats()
    let credits = t_fr_run(var c, var p, 30, 100000, 12, 5000, 96000, 94000, 99, 0, var sc, var sp)
    test.assert(sp[1] >= 50)
    test.assert(sc[1] >= 50)
    test.assert_eq(sp[2] + sp[3] + sc[2] + sc[3], 0)
    test.assert(credits >= sp[1] - 2)

@test
fn test_large_framed_sdus_run_over_several_payloads_and_events()
    if not ctl_limits.iso_on()
        return
    // 200-octet SDUs every 10 ms on a 15 ms ISO interval, PDUs of 160 octets, two payloads an event: 2 x 158 octets an event
    // are over the F x 205 = 307.5 octets that 1.5 SDUs an event and their headers need.
    var c = t_framed(true, 12, 10000, 200, 160, 2)
    var p = t_framed(false, 12, 10000, 200, 160, 2)
    var sc = t_fr_stats()
    var sp = t_fr_stats()
    let credits = t_fr_run(var c, var p, 30, 100000, 200, 10000, 90000, 85000, 99, 0, var sc, var sp)
    test.assert(sp[1] >= 25)
    test.assert(sc[1] >= 25)
    test.assert_eq(sp[2] + sp[3] + sc[2] + sc[3], 0)
    test.assert(credits >= sp[1] - 2)

@test
fn test_a_lost_event_makes_lost_sdus_and_the_sequence_goes_on_without_a_gap()
    if not ctl_limits.iso_on()
        return
    var c = t_framed(true, 6, 10000, 30, 29, 1)
    var p = t_framed(false, 6, 10000, 30, 29, 1)
    var sc = t_fr_stats()
    var sp = t_fr_stats()
    // Events 10 and 11 are lost to both ends.  Every SDU that arrives is valid and has its own index, or is reported lost
    // with the index it would have had: a valid SDU after the gap has the index of the SDU sent, not one less.
    let credits = t_fr_run(var c, var p, 40, 100000, 30, 10000, 95000, 92000, 10, 2, var sc, var sp)
    test.assert(sp[2] >= 1)
    test.assert(sc[2] >= 1)
    test.assert_eq(sp[3], 0)
    test.assert_eq(sc[3], 0)
    test.assert(sp[1] + sp[2] >= 28)
    test.assert(sc[1] + sc[2] >= 28)
    test.assert(credits >= sp[1] + sp[2] - 3)

@test
fn test_a_framed_payload_that_cannot_be_read_loses_the_sdu_under_way()
    if not ctl_limits.iso_on()
        return
    var x = t_framed(false, 8, 10000, 30, 40, 1)
    t_set(var x, "anchor", 10000)
    t_set(var x, "rx_num", 0)
    var p = ll_pdu.pdu_new()
    // A start segment of 20 octets that does not end (SC 0, CMPLT 0, 23 octets with the Time_Offset), then a segment whose
    // length overruns the payload.
    p.b[0] = 2
    p.b[1] = 27
    p.b[2] = 0
    p.b[3] = 23
    p.b[4] = 0
    p.b[5] = 0
    p.b[6] = 0
    for i in 0..20
        p.b[7 + i] = i as u8
    p.b[27] = 1
    p.b[28] = 50
    t_pdu_n(var p, 29)
    rx_note(var x, 0, true, var p)
    // The first segment is read, then the second is found to overrun: the SDU under way is lost at once.
    test.assert_eq(x.out_n, 1)
    test.assert_eq(x.outs[x.out_head], SDU_LOST)
    test.assert(x.fa_gap)
    test.assert(not x.fa_open)

@test
fn test_a_continuation_without_its_start_is_dropped()
    if not ctl_limits.iso_on()
        return
    var x = t_framed(false, 8, 10000, 30, 40, 1)
    var p = ll_pdu.pdu_new()
    p.b[0] = 2
    p.b[1] = 6
    p.b[2] = 3
    p.b[3] = 4
    for i in 0..4
        p.b[4 + i] = 9
    t_pdu_n(var p, 8)
    rx_note(var x, 0, true, var p)
    test.assert_eq(x.out_n, 0)
    test.assert(not x.fa_open)

@test
fn test_framed_parameters_follow_the_bandwidth_rule_and_the_interval_need_not_divide()
    // The ISO interval is the SDU interval up to a multiple of 1.25 ms, never under 5 ms.
    test.assert_eq(framed_interval_for(10000, 10000), 10000)
    test.assert_eq(framed_interval_for(8000, 0), 8750)
    test.assert_eq(framed_interval_for(0, 8000), 8750)
    test.assert_eq(framed_interval_for(10000, 7500), 7500)
    test.assert_eq(framed_interval_for(2500, 0), 5000)
    // 30 octets every 10 ms in 10 ms: 36 octets with the 100 ppm allowance, 44 with the quarter more, in one PDU of 46.
    test.assert_eq(framed_octets(30, 10000, 10000), 44)
    test.assert_eq(framed_pdu(30, 10000, 10000), 46)
    test.assert_eq(framed_bn(30, 10000, 10000, 46), 1)
    // 240 octets every 8 ms in 8.75 ms: 335 octets, two PDUs of 251.
    test.assert_eq(framed_octets(240, 8000, 8750), 335)
    test.assert_eq(framed_pdu(240, 8000, 8750), 251)
    test.assert_eq(framed_bn(240, 8000, 8750, 251), 2)
    // Nothing flows in a direction without SDUs.
    test.assert_eq(framed_pdu(0, 10000, 10000), 0)
    test.assert_eq(framed_bn(0, 10000, 10000, 0), 0)

@test
fn test_a_framed_group_is_derived_with_an_interval_that_is_no_multiple_of_the_sdu_interval()
    var p = t_plans()
    t_plan_set(var p, 0, 100, 60, 2, 2, 3)
    var g = group_plan_new()
    t_plan_framed(var g)
    test.assert_eq(plan_cig(var p, 1, 8000, 8000, 40, 40, 0, ll_radio.profile_assumed(), var g), 0)
    test.assert_eq(g.iso_us, 8750)
    test.assert_eq(p[0].pdu_c, framed_pdu(100, 8000, 8750))
    test.assert_eq(p[0].pdu_p, framed_pdu(60, 8000, 8750))
    test.assert_eq(p[0].bn_c, 1)
    test.assert_eq(p[0].bn_p, 1)
    test.assert(p[0].nse >= 3)
    // Unframed, the interval would have to be a multiple of both 1.25 ms and 8 ms: 40 ms, with five SDUs in it.
    test.assert_eq(iso_interval_for(8000, 8000), 40000)

@test
fn test_a_framed_group_counts_the_framing_delay_in_the_transport_latency()
    var p = t_plans()
    t_plan_set(var p, 0, 30, 30, 2, 2, 3)
    var g = group_plan_new()
    t_plan_framed(var g)
    // CIG_Sync_Delay + FT x ISO_Interval + one SDU interval is over 20 ms; unframed it is not.
    test.assert_eq(plan_cig(var p, 1, 10000, 10000, 20, 20, 0, ll_radio.profile_assumed(), var g),
        STATUS_INVALID_PARAMETERS)
    var q = t_plans()
    t_plan_set(var q, 0, 30, 30, 2, 2, 3)
    var h = group_plan_new()
    test.assert_eq(plan_cig(var q, 1, 10000, 10000, 20, 20, 0, ll_radio.profile_assumed(), var h), 0)
    var r = t_plans()
    t_plan_set(var r, 0, 30, 30, 2, 2, 3)
    var k = group_plan_new()
    t_plan_framed(var k)
    test.assert_eq(plan_cig(var r, 1, 10000, 10000, 40, 40, 0, ll_radio.profile_assumed(), var k), 0)

// ── Unsegmented mode ─────────────────────────────────────────────────

// A stream in Unsegmented mode: as `t_framed`, with the flag.
fn t_unseg(central: Bool, iso: Int, sdu_int: Int, len: Int, pdu: Int, bn: Int) -> Cis
    var x = t_framed(central, iso, sdu_int, len, pdu, bn)
    t_set(var x, "unseg", 1)
    x

@test
fn test_unsegmented_parameters_hold_whole_sdus_with_their_headers()
    // 30 octets every 10 ms in 10 ms: F = 1.0001, so two SDUs an interval for the 100 ppm allowance, in one PDU of 70.
    test.assert_eq(unseg_sdus(30, 10000, 10000), 2)
    test.assert_eq(unseg_per_pdu(30), 7)
    test.assert_eq(unseg_bn(30, 10000, 10000), 1)
    test.assert_eq(unseg_pdu(30, 10000, 10000), 70)
    // 100 octets every 10 ms in 20 ms: 2.0002 SDUs, so three of 105 octets, two in a PDU and two PDUs.
    test.assert_eq(unseg_sdus(100, 10000, 20000), 3)
    test.assert_eq(unseg_per_pdu(100), 2)
    test.assert_eq(unseg_bn(100, 10000, 20000), 2)
    // 200 octets every 10 ms in 20 ms: three SDUs, one a PDU.
    test.assert_eq(unseg_per_pdu(200), 1)
    test.assert_eq(unseg_bn(200, 10000, 20000), 3)
    test.assert_eq(unseg_pdu(200, 10000, 20000), 205)
    // An SDU that does not fit a PDU with its 5 octets, and a direction without data.
    test.assert_eq(unseg_per_pdu(247), 0)
    test.assert_eq(unseg_bn(247, 10000, 10000), 0)
    test.assert_eq(unseg_pdu(0, 10000, 10000), 0)
    test.assert_eq(unseg_bn(0, 10000, 10000), 0)

@test
fn test_an_unsegmented_group_is_derived_without_a_framing_delay()
    var p = t_plans()
    t_plan_set(var p, 0, 30, 30, 2, 2, 3)
    var g = group_plan_new()
    t_plan_mode(var g, 2)
    test.assert_eq(plan_cig(var p, 1, 10000, 10000, 20, 20, 0, ll_radio.profile_assumed(), var g), 0)
    test.assert_eq(g.iso_us, 10000)
    test.assert_eq(p[0].bn_c, unseg_bn(30, 10000, 10000))
    test.assert_eq(p[0].pdu_c, unseg_pdu(30, 10000, 10000))
    // The same bound fails with the framing delay of Segmentable mode.
    var q = t_plans()
    t_plan_set(var q, 0, 30, 30, 2, 2, 3)
    var h = group_plan_new()
    t_plan_mode(var h, 1)
    test.assert_eq(plan_cig(var q, 1, 10000, 10000, 20, 20, 0, ll_radio.profile_assumed(), var h),
        STATUS_INVALID_PARAMETERS)
    // An SDU over the 246 octets a PDU holds with its header.
    var r = t_plans()
    t_plan_set(var r, 0, 247, 247, 2, 2, 3)
    var k = group_plan_new()
    t_plan_mode(var k, 2)
    test.assert_eq(plan_cig(var r, 1, 10000, 10000, 40, 40, 0, ll_radio.profile_assumed(), var k),
        STATUS_UNSUPPORTED_FEATURE)

@test
fn test_an_unsegmented_sdu_is_one_whole_segment_and_several_share_a_pdu()
    if not ctl_limits.iso_on()
        return
    var x = t_unseg(true, 8, 5000, 12, 37, 1)
    t_set(var x, "anchor", 10000)
    var d = t_sdu(3)
    test.assert(fsdu_put(var x, var d, 0, 12, 7000))
    test.assert(fsdu_put(var x, var d, 0, 12, 8000))
    test.assert_eq(x.tx_wr, 1)
    test.assert_eq(x.txl[0], 34)
    test.assert_eq(x.txf[0] >>> 8, 2)
    test.assert_eq(x.txd[0] as Int, 2)
    test.assert_eq(x.txd[1] as Int, 15)
    test.assert_eq(x.txd[17] as Int, 2)
    test.assert_eq(x.txd[19] as Int, 2000 & 0xFF)
    // 3 octets are left: a third SDU never starts there, it goes in the next payload whole.
    test.assert(fsdu_put(var x, var d, 0, 12, 9000))
    test.assert_eq(x.txl[0], 34)
    test.assert_eq(x.tx_wr, 2)
    test.assert_eq(x.txl[1], 17)
    // An SDU that does not fit a PDU is refused and changes nothing.
    var big = t_sdu(3)
    test.assert(not fsdu_put(var x, var big, 0, 33, 9000))
    test.assert_eq(x.tx_wr, 2)

