@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@when(noble_controller.CONFIG.CTL_CS > 0)
@test
fn test_default_settings_are_kept_and_checked_against_the_roles_and_the_antennas_of_the_build()
    if not ctl_limits.cs_on()
        return
    var c = ready()
    test.assert_eq(status_of(run(var c, 0x208D, [1, 0, 3, 1, 0]), 0x208D), 0)
    let rec = ctl_hci.cs_find(var c, 0)
    test.assert(rec >= 0)
    test.assert_eq(snap(var c).def_roles, 3)
    test.assert_eq(snap(var c).def_ant, 1)
    test.assert_eq(snap(var c).def_txp, 0)
    // Codes 0xFD, 0xFE and 0xFF are antenna selections too; 0 and an element the build lacks are not.
    for ant in [0xFD, 0xFE, 0xFF]
        test.assert_eq(status_of(run(var c, 0x208D, [1, 0, 1, ant, 0xE0]), 0x208D), 0)
    test.assert_eq(snap(var c).def_txp, 0xE0)
    test.assert_eq(status_of(run(var c, 0x208D, [1, 0, 1, 0, 0]), 0x208D), 0x11)
    test.assert_eq(status_of(run(var c, 0x208D, [1, 0, 1, noble_controller.CONFIG.CTL_CS_ANT + 1, 0]), 0x208D), 0x11)
    // A role the build lacks, a reserved bit, a power beyond +20 dBm.
    test.assert_eq(status_of(run(var c, 0x208D, [1, 0, 4, 1, 0]), 0x208D), 0x11)
    test.assert_eq(status_of(run(var c, 0x208D, [1, 0, 1, 1, 21]), 0x208D), 0x12)
    test.assert_eq(status_of(run(var c, 0x208D, [1, 0, 1, 1, 0x80]), 0x208D), 0x12)
    test.assert_eq(status_of(run(var c, 0x208D, [1, 0, 1, 1, 20]), 0x208D), 0)
    var d = fresh()
    test.assert_eq(status_of(run(var d, 0x208D, [1, 0, 1, 1, 0]), 0x208D), 0x02)

