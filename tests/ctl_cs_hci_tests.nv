    test.assert_eq(status_of(run(var c, 0x20A6, v2), 0x20A6), 0)
    let ev = meta(run(var c, 0x208A, [1, 0]), 0x38)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][7 + 31], 7)
    test.assert_eq(ev[0][7 + 33], 9)
    var d = ready()
    test.assert_eq(status_of(run(var d, 0x208B, cat([1, 0], rec)), 0x208B), 0)
    let ev1 = meta(run(var d, 0x208A, [1, 0]), 0x38)
    test.assert_eq(ev1[0][7 + 31], 255)
    test.assert_eq(ev1[0][7 + 32], 0)

