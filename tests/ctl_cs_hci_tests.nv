@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@when(noble_controller.CONFIG.CTL_CS > 0)
@test
fn test_the_masked_events_are_not_sent_and_the_v2_event_is_chosen_when_the_build_and_the_mask_allow_it()
    if not ctl_limits.cs_on()
        return
    var c = ready()
    // The mask of the LE events without the bit of the [v1] event (43).
    let _m = run(var c, 0x2001, [0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xF7, 0xFF, 0xFF])
    exchange_caps(var c)
    test.assert_eq(list.len(meta(flush(var c), 0x2C)), 0)
    test.assert_eq(snap(var c).owed & ll_cs_proc.OWED_CAPS, 0)
    if ctl_limits.cs_ipt_on()
        // Both unmasked: the [v2] event, 34 octets of record.
        var d = ready()
        exchange_caps(var d)
        let ev = meta(flush(var d), 0x38)
        test.assert_eq(list.len(ev), 1)
        test.assert_eq(list.len(ev[0]), 3 + 1 + 1 + 2 + 34)
        test.assert_eq(list.len(meta(flush(var d), 0x2C)), 0)
        // The [v2] event masked, the [v1] event it is.
        var e = ready()
        let _n = run(var e, 0x2001, [0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x7F, 0xFF])
        exchange_caps(var e)
        test.assert_eq(list.len(meta(flush(var e), 0x2C)), 1)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@when(noble_controller.CONFIG.CTL_CS > 0)
@test
fn test_write_cached_capabilities_keeps_the_record_and_is_refused_after_the_peer_sent_its_own()
    if not ctl_limits.cs_on()
        return
    var c = ready()
    let cached = cat([1, 0], peer_caps_record())
    test.assert_eq(status_of(run(var c, 0x208B, cached), 0x208B), 0)
    let ev = meta(run(var c, 0x208A, [1, 0]), caps_sub())
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][7 + 5], 3)
    test.assert_eq(queued_op(var c), -1)
    // Written again before anything came from the peer: replaced.
    test.assert_eq(status_of(run(var c, 0x208B, cached), 0x208B), 0)
    exchange_caps(var c)
    test.assert_eq(status_of(run(var c, 0x208B, cached), 0x208B), 0x0C)
    // A record outside the specification.
    var d = ready()
    var bad = cat([1, 0], peer_caps_record())
    bad[2] = 0
    test.assert_eq(status_of(run(var d, 0x208B, bad), 0x208B), 0x12)
    var reserved = cat([1, 0], peer_caps_record())
    reserved[2 + 6] = 2
    test.assert_eq(status_of(run(var d, 0x208B, reserved), 0x208B), 0x12)
    // The Host Support bit clear.
    var e = fresh()
    test.assert_eq(cmd_status(run(var e, 0x208A, [1, 0]), 0x208A), 0x02)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
