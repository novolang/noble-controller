// tests/ll_sub_tests.nv — the unit tests of src/ll_sub.nv.
//
//   novo test tests/ll_sub_tests.nv

use std.test
use ll_pdu
use ll_data
use ll_sub.{ allow, get16, on_grid, pick_cont, pick_factor, pick_latency, pick_timeout, put_ind, put_req, req_ok, residue, wrap }

@test
fn test_pdu_layouts()
    var p = ll_pdu.pdu_new()
    put_req(var p, 2, 8, 1, 3, 0x0100)
    test.assert_eq(ll_data.dpdu_len(var p), 11)
    test.assert_eq(ll_data.dpdu_opcode(var p), 0x26)
    test.assert_eq(get16(var p, 1), 2)
    test.assert_eq(get16(var p, 3), 8)
    test.assert_eq(get16(var p, 5), 1)
    test.assert_eq(get16(var p, 7), 3)
    test.assert_eq(get16(var p, 9), 0x0100)
    put_ind(var p, 4, 0x4001, 0, 3, 0x0C80)
    test.assert_eq(ll_data.dpdu_len(var p), 11)
    test.assert_eq(ll_data.dpdu_opcode(var p), 0x27)
    test.assert_eq(get16(var p, 1), 4)
    test.assert_eq(get16(var p, 3), 0x4001)
    test.assert_eq(get16(var p, 9), 0x0C80)

@test
fn test_grid_and_wrap()
    test.assert(on_grid(10, 0, 5))
    test.assert(not on_grid(11, 0, 5))
    test.assert(on_grid(11, 1, 5))
    test.assert(on_grid(7, 3, 1))
    test.assert_eq(residue(12, 5, 100), 2)
    // 65536 mod 5 = 1: after the wrap the residue moves down by one.
    test.assert_eq(wrap(2, 5), 1)
    test.assert_eq(wrap(0, 5), 4)
    test.assert_eq(wrap(3, 4), 3)
    // A base from before the wrap seen after it.
    test.assert_eq(residue(0xFFF0, 5, 3), wrap(0xFFF0 % 5, 5))
    test.assert_eq(residue(0xFFF0, 5, 0xFFF1), 0xFFF0 % 5)

@test
fn test_acceptance_rules()
    var s = allow(2, 8, 2, 1, 400)
    test.assert(req_ok(var s, 24, 3, 6, 1, 300))
    test.assert(not req_ok(var s, 24, 3, 6, 3, 300))
    test.assert(not req_ok(var s, 24, 3, 6, 1, 500))
    test.assert(not req_ok(var s, 24, 9, 12, 1, 300))
    test.assert(not req_ok(var s, 24, 1, 1, 1, 300))
    test.assert(not req_ok(var s, 24, 8, 8, 2, 100))
    test.assert_eq(pick_factor(var s, 1), 2)
    test.assert_eq(pick_factor(var s, 5), 5)
    test.assert_eq(pick_latency(var s, 24, 5, 9, 300), 2)
    test.assert_eq(pick_latency(var s, 24, 60, 2, 400), 0)
    test.assert_eq(pick_latency(var s, 100, 60, 2, 400), -1)
    test.assert_eq(pick_timeout(var s, 300), 300)
    test.assert_eq(pick_timeout(var s, 900), 400)
    test.assert_eq(pick_cont(var s, 5, 0), 1)
    test.assert_eq(pick_cont(var s, 5, 9), 4)
    test.assert_eq(pick_cont(var s, 1, 9), 0)
