@test
fn test_every_configuration_slot_is_independent()
    if skip()
        return
    if ll_cs_proc.cfg_slots() < 2
        return
    var cen = fresh()
    var per = fresh()
    exchange(var cen, var per)
    configure(var cen, var per, 0, 0)
    configure(var cen, var per, 1, 1)
    test.assert_eq(stored(var cen, 0).role, 0)
    test.assert_eq(stored(var cen, 1).role, 1)
    test.assert_eq(ll_cs_proc.cfg_role(var cen, 1), 1)
    test.assert_eq(ll_cs_proc.cfg_role(var per, 1), 0)
    var caps = caps_full()
    var ec = env(true, 10)
    var ep = env(false, 10)
    var a = ll_pdu.pdu_new()
    var b = ll_pdu.pdu_new()
    var rm = cfg_set2(C_ID, 0, C_ACTION, 0)
    test.assert_eq(ll_cs_proc.begin_config(var cen, var ec, var caps, var rm, false, var a), 0)
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var a, var b), ll_cs_proc.R_SEND)
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var caps, var b, var a), ll_cs_proc.R_NONE)
    test.assert(not ll_cs_proc.cfg_used(var cen, 0))
    test.assert(ll_cs_proc.cfg_used(var cen, 1))
    test.assert(ll_cs_proc.cfg_used(var per, 1))
    test.assert(ll_cs_proc.any_config(var per))

@test
fn test_a_configuration_beyond_the_slots_of_this_build_is_refused_as_unsupported()
    if skip()
        return
    let slots = ll_cs_proc.cfg_slots()
    if slots >= 4
        return
    var cen = fresh()
    var per = fresh()
    exchange(var cen, var per)
    var caps = caps_set(15, 4)
    var ec = env(true, 10)
    var a = ll_pdu.pdu_new()
    var c = cfg_set(C_ID, slots)
    test.assert_eq(ll_cs_proc.begin_config(var cen, var ec, var caps, var c, false, var a), ll_cs_proc.E_UNSUPPORTED_FEATURE)
    var ep = env(false, 10)
    var req = cfg_pdu(var c)
    var out = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var req, var out), ll_cs_proc.R_SEND)
    test.assert(rejects(var out, ll_cs.OP_CS_CONFIG_REQ, ll_cs_proc.E_UNSUPPORTED_LL))

@test
fn test_a_configuration_with_a_field_the_specification_forbids_is_malformed()
    if skip()
        return
    // The channel map: the channels 0, 1, 23, 24, 25, 77 and 78 may not be set, nor the bit above them.
    for ch in [0, 1, 23, 24, 25, 77, 78, 79]
        var lo = ll_cs_pdu.CHM_LO_ALLOWED
        var hi = ll_cs_pdu.CHM_HI_ALLOWED
        if ch < 40
            lo = lo | (1 << ch)
        else
            hi = hi | (1 << (ch - 40))
        var c = cfg_set2(C_LO, lo, C_HI, hi)
        test.assert_eq(check_full(var c), 1)
    // Fewer than 15 channels.
    var few = cfg_set2(C_LO, 0x3FFC, C_HI, 0)
    var edge14 = cfg_set2(C_LO, 0xFFFC, C_HI, 0)
    var edge15 = cfg_set2(C_LO, 0x1FFFC, C_HI, 0)
    test.assert_eq(check_full(var few), 1)
    test.assert_eq(check_full(var edge14), 1)
    test.assert_eq(check_full(var edge15), 0)
    // The identifiers and the action.
    var id4 = cfg_set(C_ID, 4)
    var id63 = cfg_set(C_ID, 63)
    var act2 = cfg_set(C_ACTION, 2)
    test.assert_eq(check_full(var id4), 1)
    test.assert_eq(check_full(var id63), 1)
    test.assert_eq(check_full(var act2), 1)
    // The numbers of the configuration.
    var rep0 = cfg_set(C_REP, 0)
    var m0 = cfg_set(C_MAIN, 0)
    var m4 = cfg_set(C_MAIN, 4)
    var mff = cfg_set(C_MAIN, 0xFF)
    var s0 = cfg_set(C_SUB, 0)
    var s4 = cfg_set(C_SUB, 4)
    var rp4 = cfg_set(C_MREP, 4)
    var z0 = cfg_set(C_M0, 0)
    var z4 = cfg_set(C_M0, 4)
    var r7 = cfg_set(C_RTT, 7)
    var role2 = cfg_set(C_ROLE, 2)
    var ipt2 = cfg_set(C_IPT, 2)
    var sel2 = cfg_set(C_CHSEL, 2)
    test.assert_eq(check_full(var rep0), 1)
    test.assert_eq(check_full(var m0), 1)
    test.assert_eq(check_full(var m4), 1)
    test.assert_eq(check_full(var mff), 1)
    test.assert_eq(check_full(var s0), 1)
    test.assert_eq(check_full(var s4), 1)
    test.assert_eq(check_full(var rp4), 1)
    test.assert_eq(check_full(var z0), 1)
    test.assert_eq(check_full(var z4), 1)
    test.assert_eq(check_full(var r7), 1)
    test.assert_eq(check_full(var role2), 1)
    test.assert_eq(check_full(var ipt2), 1)
    test.assert_eq(check_full(var sel2), 1)
    // The PHY is one bit of 1, 2, 4 and 8.
    for phy in [0, 3, 5, 6, 7, 9, 16, 255]
        var c = cfg_set(C_PHY, phy)
        test.assert_eq(check_full(var c), 1)
    // The step timings are indices of their tables.
    var ip1 = cfg_set(C_IP1, 8)
    var ip2 = cfg_set(C_IP2, 8)
    var fcs = cfg_set(C_FCS, 10)
    var pm = cfg_set(C_PM, 3)
    test.assert_eq(check_full(var ip1), 1)
    test.assert_eq(check_full(var ip2), 1)
    test.assert_eq(check_full(var fcs), 1)
    test.assert_eq(check_full(var pm), 1)

@test
fn test_the_main_and_sub_mode_pairs_are_those_of_table_4_11()
    if skip()
        return
    let valid = [[1, 0xFF], [2, 0xFF], [3, 0xFF], [2, 1], [2, 3], [3, 2]]
    for main in [0, 1, 2, 3, 4, 0xFF]
        for sub in [0, 1, 2, 3, 4, 0xFF]
            var want = false
            for v in valid
                if v[0] == main and v[1] == sub
                    want = true
            test.assert_eq(ll_cs_proc.modes_ok(main, sub), want)
            var c = cfg_set2(C_MAIN, main, C_SUB, sub)
            if sub != 0xFF
                cfg_put(var c, C_MIN, 1)
                cfg_put(var c, C_MAX, 2)
            if want
                test.assert_eq(check_full(var c), 0)
            else
                test.assert_eq(check_full(var c), 1)

@test
fn test_the_main_mode_step_range_is_held_only_when_there_is_a_sub_mode()
    if skip()
        return
    var none_lo = cfg_set2(C_MIN, 0, C_MAX, 0)
    test.assert_eq(check_full(var none_lo), 0)
    var junk = cfg_set2(C_MIN, 200, C_MAX, 7)
    test.assert_eq(check_full(var junk), 0)
    for r in [[0, 1], [1, 0], [5, 4], [0, 0]]
        var c = cfg_set2(C_SUB, 1, C_MIN, r[0])
        cfg_put(var c, C_MAX, r[1])
        test.assert_eq(check_full(var c), 1)
    for r in [[1, 1], [1, 255], [255, 255], [3, 9]]
        var c = cfg_set2(C_SUB, 1, C_MIN, r[0])
        cfg_put(var c, C_MAX, r[1])
        test.assert_eq(check_full(var c), 0)

@test
fn test_the_channel_selection_shape_and_jump_are_held_only_with_algorithm_3c()
    if skip()
        return
    var c3b = cfg_set2(C_SHAPE, 9, C_JUMP, 0)
    test.assert_eq(check_full(var c3b), 0)
    for shape in [0, 1]
        for jump in [2, 3, 4, 5, 6, 7, 8]
            var c = cfg_set2(C_CHSEL, 1, C_SHAPE, shape)
            cfg_put(var c, C_JUMP, jump)
            test.assert_eq(check_full(var c), 0)
    for jump in [0, 1, 9, 255]
        var c = cfg_set2(C_CHSEL, 1, C_JUMP, jump)
        test.assert_eq(check_full(var c), 1)
    var s2 = cfg_set2(C_CHSEL, 1, C_SHAPE, 2)
    cfg_put(var s2, C_JUMP, 2)
    test.assert_eq(check_full(var s2), 1)

@test
fn test_every_value_of_each_option_that_the_capabilities_allow_is_accepted()
    if skip()
        return
    for rtt in [0, 1, 2, 3, 4, 5, 6]
        var c = cfg_set(C_RTT, rtt)
        test.assert_eq(check_full(var c), 0)
    for phy in [1, 2, 8]
        var c = cfg_set(C_PHY, phy)
        test.assert_eq(check_full(var c), 0)
    for role in [0, 1]
        var c = cfg_set(C_ROLE, role)
        test.assert_eq(check_full(var c), 0)
    for rep in [0, 1, 2, 3]
        var c = cfg_set(C_MREP, rep)
        test.assert_eq(check_full(var c), 0)
    for steps in [1, 2, 3]
        var c = cfg_set(C_M0, steps)
        test.assert_eq(check_full(var c), 0)
    for i in 0..8
        var c = cfg_set2(C_IP1, i, C_IP2, 7 - i)
        test.assert_eq(check_full(var c), 0)
    for i in 0..10
        var c = cfg_set(C_FCS, i)
        test.assert_eq(check_full(var c), 0)
    for i in 0..3
        var c = cfg_set(C_PM, i)
        test.assert_eq(check_full(var c), 0)
    var ipt = cfg_set2(C_IPT, 1, C_ROLE, 1)
    test.assert_eq(check_full(var ipt), 0)
    var m3 = cfg_set(C_MAIN, 3)
    test.assert_eq(check_full(var m3), 0)

@test
fn test_what_a_device_lacks_makes_a_configuration_unsupported_and_not_malformed()
    if skip()
        return
    var full = caps_full()
    var min = caps_min()
    // Mode 3 as main or sub mode needs the capability of both devices.
    var m3 = cfg_set(C_MAIN, 3)
    var s3 = cfg_set2(C_MAIN, 2, C_SUB, 3)
    cfg_put(var s3, C_MIN, 1)
    cfg_put(var s3, C_MAX, 4)
    test.assert_eq(check(var m3, var min, var full), 2)
    test.assert_eq(check(var m3, var full, var min), 2)
    test.assert_eq(check(var s3, var min, var full), 2)
    test.assert_eq(check(var s3, var full, var min), 2)
    // The sounding sequence of the RTT types 1 and 2, the random sequence of 3 to 6.
    for rtt in [1, 2, 3, 4, 5, 6]
        var c = cfg_set(C_RTT, rtt)
        test.assert_eq(check(var c, var min, var full), 2)
        test.assert_eq(check(var c, var full, var min), 2)
    var aa = cfg_set(C_RTT, 0)
    test.assert_eq(check(var aa, var min, var min), 0)
    // LE 2M and LE 2M 2BT by their bits, LE Coded never.
    var p2 = cfg_set(C_PHY, 2)
    var p8 = cfg_set(C_PHY, 8)
    var p4 = cfg_set(C_PHY, 4)
    test.assert_eq(check(var p2, var min, var full), 2)
    test.assert_eq(check(var p2, var full, var min), 2)
    test.assert_eq(check(var p8, var min, var full), 2)
    test.assert_eq(check(var p8, var full, var min), 2)
    test.assert_eq(check_full(var p4), 2)
    var only2m = caps_set(7, 2)
    var only2bt = caps_set(7, 4)
    test.assert_eq(check(var p2, var only2m, var only2m), 0)
    test.assert_eq(check(var p8, var only2m, var only2m), 2)
    test.assert_eq(check(var p8, var only2bt, var only2bt), 0)
    test.assert_eq(check(var p2, var only2bt, var only2bt), 2)
    // The initiator phase tone needs the reflector to have it.
    var ipt_r = cfg_set2(C_IPT, 1, C_ROLE, 1)
    var ipt_i = cfg_set2(C_IPT, 1, C_ROLE, 0)
    test.assert_eq(check(var ipt_r, var min, var full), 2)
    test.assert_eq(check(var ipt_r, var full, var min), 0)
    test.assert_eq(check(var ipt_i, var full, var min), 2)
    test.assert_eq(check(var ipt_i, var min, var full), 0)
    // Channel Selection Algorithm #3c.
    var c3c = cfg_set2(C_CHSEL, 1, C_JUMP, 2)
    test.assert_eq(check(var c3c, var min, var full), 2)
    test.assert_eq(check(var c3c, var full, var min), 2)
    // The timings: the mandatory one always, an optional one by its bit in both devices.
    for i in 0..7
        var ip1 = cfg_set(C_IP1, i)
        var no = caps_set(18, 0)
        var yes = caps_set(18, 1 << i)
        test.assert_eq(check(var ip1, var no, var yes), 2)
        test.assert_eq(check(var ip1, var yes, var no), 2)
        test.assert_eq(check(var ip1, var yes, var yes), 0)
        var ip2 = cfg_set(C_IP2, i)
        var no2 = caps_set(19, 0)
        var yes2 = caps_set(19, 1 << i)
        test.assert_eq(check(var ip2, var no2, var yes2), 2)
        test.assert_eq(check(var ip2, var yes2, var yes2), 0)
    for i in 0..9
        var fcs = cfg_set(C_FCS, i)
        var no = caps_set(20, 0)
        var yes = caps_set(20, 1 << i)
        test.assert_eq(check(var fcs, var no, var yes), 2)
        test.assert_eq(check(var fcs, var yes, var yes), 0)
    for i in 0..2
        var pm = cfg_set(C_PM, i)
        var no = caps_set(21, 0)
        var yes = caps_set(21, 1 << i)
        test.assert_eq(check(var pm, var no, var yes), 2)
        test.assert_eq(check(var pm, var yes, var yes), 0)
    var mandatory = cfg_set(C_IP1, 7)
    test.assert_eq(check(var mandatory, var min, var min), 0)

@test
fn test_each_end_needs_the_role_the_configuration_gives_it()
    if skip()
        return
    var init_only = caps_set(10, 1)
    var refl_only = caps_set(10, 2)
    var full = caps_full()
    // The requester that sends role 0 takes the initiator role and leaves the reflector to the other end.
    var c0 = cfg_set(C_ROLE, 0)
    var c1 = cfg_set(C_ROLE, 1)
    test.assert_eq(ll_cs_proc.config_check(var c0, var init_only, var refl_only, true, true), 0)
    test.assert_eq(ll_cs_proc.config_check(var c0, var refl_only, var init_only, true, true), 2)
    test.assert_eq(ll_cs_proc.config_check(var c1, var refl_only, var init_only, true, true), 0)
    test.assert_eq(ll_cs_proc.config_check(var c1, var init_only, var refl_only, true, true), 2)
    // The receiver takes the other role: the local end of a request that says role 0 is the reflector.
    test.assert_eq(ll_cs_proc.config_check(var c0, var refl_only, var init_only, true, false), 0)
    test.assert_eq(ll_cs_proc.config_check(var c0, var init_only, var refl_only, true, false), 2)
    test.assert_eq(ll_cs_proc.config_check(var c0, var refl_only, var full, false, false), 0)
    test.assert_eq(ll_cs_proc.config_check(var c0, var init_only, var full, false, false), 2)

@test
fn test_a_removal_checks_only_the_identifier()
    if skip()
        return
    var full = caps_full()
    var rm = cfg_set2(C_ACTION, 0, C_CHSEL, 7)
    test.assert_eq(check(var rm, var full, var full), 0)
    var bad_id = cfg_set2(C_ACTION, 0, C_ID, 5)
    test.assert_eq(check(var bad_id, var full, var full), 1)
    var one = caps_set(15, 1)
    var other = cfg_set2(C_ACTION, 0, C_ID, 1)
    test.assert_eq(check(var other, var one, var full), 2)
    test.assert_eq(ll_cs_proc.config_check(var other, var full, var one, true, true), 2)
    // Without the peer's record only this end's limits count.
    var alone = ll_cs_proc.config_check(var other, var full, var one, false, true)
    if ll_cs_proc.cfg_slots() >= 2
        test.assert_eq(alone, 0)
    else
        test.assert_eq(alone, 2)

// What the Host's request for a configuration is answered with.
fn config_status(var cs: Cs, var e: ll_cs_proc.Env, var c: CfgPdu, local_only: Bool) -> Int
    var caps = caps_full()
    var out = ll_pdu.pdu_new()
    ll_cs_proc.begin_config(var cs, var e, var caps, var c, local_only, var out)

@test
fn test_the_hosts_request_for_a_configuration_meets_the_checks_of_every_procedure()
    if skip()
        return
    var good = cfg_ok(0, 0)
    var none = fresh_no_host()
    var e = env(true, 10)
    test.assert_eq(config_status(var none, var e, var good, false), ll_cs_proc.E_DISALLOWED)
    var cs = fresh()
    var e1 = envf(true, E_NOPEER, 10)
    test.assert_eq(config_status(var cs, var e1, var good, false), ll_cs_proc.E_UNSUPPORTED_REMOTE)
    var e2 = envf(true, E_PLAIN, 10)
    test.assert_eq(config_status(var cs, var e2, var good, false), ll_cs_proc.E_INSUFFICIENT_SECURITY)
    // The peer's capabilities must be known, unless the configuration stays with this end.
    test.assert_eq(config_status(var cs, var e, var good, false), ll_cs_proc.E_DISALLOWED)
    var local = cfg_ok(1, 0)
    if ll_cs_proc.cfg_slots() >= 2
        test.assert_eq(config_status(var cs, var e, var local, true), 0)
    var cen = fresh()
    var per = fresh()
    exchange(var cen, var per)
    var e3 = env(true, 10)
    test.assert_eq(config_status(var cen, var e3, var good, false), 0)
    // One procedure at a time.
    test.assert_eq(config_status(var cen, var e3, var good, false), ll_cs_proc.E_DISALLOWED)

@test
fn test_the_hosts_request_for_a_configuration_is_refused_for_its_fields_with_the_hci_codes()
    if skip()
