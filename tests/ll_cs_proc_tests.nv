@test
fn test_a_termination_that_crosses_the_other_ends_is_rejected_by_the_central_and_taken_by_the_peripheral()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    running(var cen, var per, 0)
    var caps = caps_full()
    var ec = env(true, 30)
    var ep = env(false, 30)
    var a = ll_pdu.pdu_new()
    var b = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.begin_terminate(var cen, var ec, 0, 0x13, var a), 0)
    test.assert_eq(ll_cs_proc.begin_terminate(var per, var ep, 0, 0x16, var b), 0)
    var rej = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var caps, var b, var rej), ll_cs_proc.R_SEND)
    test.assert(rejects(var rej, ll_cs.OP_CS_TERMINATE_REQ, ll_cs_proc.E_COLLISION))
    test.assert_eq(cen.wait, ll_cs_proc.W_TERM)
    var rsp = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var a, var rsp), ll_cs_proc.R_SEND)
    test.assert_eq(op_of(var rsp), ll_cs.OP_CS_TERMINATE_RSP)
    test.assert(not per.run_open)
    test.assert_eq(per.wait, ll_cs_proc.W_TERM)
    // The Peripheral's own request ends with the rejection of the Central, and the Central's completes.
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var rej, var b), ll_cs_proc.R_NONE)
    test.assert_eq(per.wait, ll_cs_proc.W_NONE)
    test.assert_eq(per.st_term, ll_cs_proc.E_COLLISION)
    test.assert(ll_cs_proc.take_owed(var per, ll_cs_proc.OWED_TERM))
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var caps, var rsp, var a), ll_cs_proc.R_NONE)
    test.assert(not cen.run_open)

