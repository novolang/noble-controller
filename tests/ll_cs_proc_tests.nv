    for i in 0..72
        test.assert_eq(ll_cs_proc.peer_fae(var cen, i), i * 3 - 100)
    test.assert(cen.fae_known)

@test
fn test_the_ends_of_the_signed_range_of_a_fae_value_are_kept()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    exchange(var cen, var per)
    var caps = caps_full()
    var ec = env(true, 10)
    var a = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.begin_fae(var cen, var ec, var a), 0)
    var rsp = ll_pdu.pdu_new()
    ll_cs_pdu.put_fae_begin(var rsp)
    for i in 0..72
        if i % 2 == 0
            ll_cs_pdu.put_fae_value(var rsp, -128)
        else
            ll_cs_pdu.put_fae_value(var rsp, 127)
    ll_cs_pdu.put_fae_end(var rsp)
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var caps, var rsp, var a), ll_cs_proc.R_NONE)
    test.assert_eq(ll_cs_proc.peer_fae(var cen, 0), -128)
    test.assert_eq(ll_cs_proc.peer_fae(var cen, 1), 127)
    test.assert_eq(ll_cs_proc.peer_fae(var cen, 70), -128)
    test.assert_eq(ll_cs_proc.peer_fae(var cen, 71), 127)

@test
fn test_the_host_cannot_ask_for_a_fae_table_the_peer_does_not_have_or_without_the_basics()
    if skip()
        return
    var a = ll_pdu.pdu_new()
    var e = env(true, 10)
    // The capabilities of the peer are not known.
    var cs0 = fresh()
    test.assert_eq(ll_cs_proc.begin_fae(var cs0, var e, var a), ll_cs_proc.E_UNSUPPORTED_FEATURE)
    // The peer has No_FAE.
    var cen = fresh()
    var per = fresh()
    var ep = env(false, 10)
    var nofae = caps_set(12, 1)
    var full = caps_full()
    var b = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.begin_capabilities(var cen, var e, var full, var a), 0)
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var nofae, var a, var b), ll_cs_proc.R_SEND)
    test.assert_eq(ll_cs_proc.receive(var cen, var e, var full, var b, var a), ll_cs_proc.R_NONE)
    test.assert_eq(ll_cs_proc.begin_fae(var cen, var e, var a), ll_cs_proc.E_UNSUPPORTED_FEATURE)
    test.assert_eq(cen.wait, ll_cs_proc.W_NONE)
    // The checks of every procedure.
    var none = fresh_no_host()
    test.assert_eq(ll_cs_proc.begin_fae(var none, var e, var a), ll_cs_proc.E_DISALLOWED)
    var e1 = envf(true, E_NOPEER, 10)
    var e2 = envf(true, E_PLAIN, 10)
    var cen2 = fresh()
    var per2 = fresh()
    exchange(var cen2, var per2)
    test.assert_eq(ll_cs_proc.begin_fae(var cen2, var e1, var a), ll_cs_proc.E_UNSUPPORTED_REMOTE)
    test.assert_eq(ll_cs_proc.begin_fae(var cen2, var e2, var a), ll_cs_proc.E_INSUFFICIENT_SECURITY)
    test.assert_eq(ll_cs_proc.begin_fae(var cen2, var e, var a), 0)
    test.assert_eq(ll_cs_proc.begin_fae(var cen2, var e, var a), ll_cs_proc.E_DISALLOWED)

@test
