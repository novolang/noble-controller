@test
fn test_either_role_of_the_configuration_may_start_from_either_end()
    if skip()
        return
    for role in [0, 1]
        for central_starts in [true, false]
            var cen = fresh()
            var per = fresh()
            ready(var cen, var per, role)
            var s = start_ok(0)
            if central_starts
                run_start(var cen, var per, true, var s)
            else
                run_start(var per, var cen, false, var s)
            test.assert_eq(run_of(var cen).subevent_len, 2500)
            test.assert_eq(run_of(var per).subevent_len, 2500)

@test
fn test_the_indication_names_a_connection_event_no_sooner_than_six_events_ahead()
    if skip()
        return
    test.assert_eq(ll_cs_proc.pick_event(110, 100), 110)
    test.assert_eq(ll_cs_proc.pick_event(106, 100), 106)
    test.assert_eq(ll_cs_proc.pick_event(105, 100), 106)
    test.assert_eq(ll_cs_proc.pick_event(100, 100), 106)
    test.assert_eq(ll_cs_proc.pick_event(99, 100), 106)
    test.assert_eq(ll_cs_proc.pick_event(3, 0xFFFE), 4)
    test.assert_eq(ll_cs_proc.pick_event(10, 0xFFFE), 10)
    test.assert_eq(ll_cs_proc.pick_event(0xFFF0, 0xFFFE), 4)
    // One far ahead stays.
    test.assert_eq(ll_cs_proc.pick_event(30000, 100), 30000)

@test
fn test_an_indication_in_the_past_is_moved_to_the_next_events_the_central_can_use()
    if skip()
