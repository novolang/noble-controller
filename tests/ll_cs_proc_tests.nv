    test.assert(ll_cs_proc.take_owed(var per, ll_cs_proc.OWED_CFG))
    test.assert_eq(cen.ev_cfg, 0)
    test.assert_eq(per.ev_cfg, 0)
    test.assert_eq(cen.ev_act, 1)
    test.assert_eq(per.ev_act, 1)
    test.assert_eq(cen.st_cfg, 0)
    test.assert_eq(per.st_cfg, 0)

@test
fn test_either_end_may_remove_a_configuration_whoever_created_it()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    exchange(var cen, var per)
    configure(var cen, var per, 0, 0)
    var caps = caps_full()
    var ec = env(true, 10)
    var ep = env(false, 10)
    var a = ll_pdu.pdu_new()
    var b = ll_pdu.pdu_new()
    var rm = cfg_set(C_ACTION, 0)
    test.assert_eq(ll_cs_proc.begin_config(var per, var ep, var caps, var rm, false, var a), 0)
    test.assert_eq(ll_data.dpdu_len(var a), 28)
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var caps, var a, var b), ll_cs_proc.R_SEND)
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var b, var a), ll_cs_proc.R_NONE)
    test.assert(not ll_cs_proc.cfg_used(var cen, 0))
    test.assert(not ll_cs_proc.cfg_used(var per, 0))
