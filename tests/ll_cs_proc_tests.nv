@test
fn test_a_peer_that_refuses_the_configuration_leaves_nothing_in_force()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    exchange(var cen, var per)
    take_all(var cen)
    var caps = caps_full()
    var ec = env(true, 10)
    var a = ll_pdu.pdu_new()
    var c = cfg_ok(0, 0)
    test.assert_eq(ll_cs_proc.begin_config(var cen, var ec, var caps, var c, false, var a), 0)
    var r = script_reject(ll_cs.OP_CS_CONFIG_REQ, ll_cs_proc.E_UNSUPPORTED_LL)
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var caps, var r, var a), ll_cs_proc.R_NONE)
    test.assert_eq(cen.wait, ll_cs_proc.W_NONE)
    test.assert(not ll_cs_proc.cfg_used(var cen, 0))
    test.assert(ll_cs_proc.take_owed(var cen, ll_cs_proc.OWED_CFG))
    test.assert_eq(cen.st_cfg, ll_cs_proc.E_UNSUPPORTED_LL)
    test.assert_eq(cen.ev_cfg, 0)
    // A response that comes after the refusal changes nothing.
    var rsp = ll_pdu.pdu_new()
    ll_cs_pdu.put_config_rsp(var rsp, 0)
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var caps, var rsp, var a), ll_cs_proc.R_NONE)
    test.assert(not ll_cs_proc.cfg_used(var cen, 0))

