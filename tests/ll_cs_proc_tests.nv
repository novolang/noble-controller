@test
fn test_the_peer_refusing_the_fae_request_ends_it_with_its_code()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    exchange(var cen, var per)
    take_all(var cen)
    var caps = caps_full()
    var ec = env(true, 10)
