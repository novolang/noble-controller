@test
fn test_an_instance_with_fewer_than_15_filtered_channels_does_not_start_and_ends_the_series()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    secure(var cen, var per)
    exchange(var cen, var per)
    // The configuration has the channels 2 to 16, 15 of them.
    var cfg = cfg_set2(C_LO, 0x1FFFC, C_HI, 0)
    configure_cfg(var cen, var per, var cfg)
    fae_table(var cen, var per, true)
    var s = start_ok(0)
    run_start(var cen, var per, true, var s)
    test.assert_eq(ll_cs_proc.filtered_count(var cen, 0, 110), 15)
    // The peer's update takes away one of them while no procedure runs: the map applies at once.
    var caps = caps_full()
    var ep = env(false, 20)
    var out = ll_pdu.pdu_new()
    var m = ll_cs_pdu.chm_new(0x0FFFC, ll_cs_pdu.CHM_HI_ALLOWED, 0)
    var upd = ll_pdu.pdu_new()
    ll_cs_pdu.put_channel_map(var upd, var m)
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var upd, var out), ll_cs_proc.R_NONE)
    test.assert(per.pend_chm)
    test.assert_eq(ll_cs_proc.filtered_count(var per, 0, 5), 15)
    test.assert_eq(ll_cs_proc.filtered_count(var per, 0, 100), 14)
    test.assert_eq(ll_cs_proc.instance_begin(var per, 110), ll_cs_proc.E_INSUFFICIENT_CHANNELS)
    test.assert(not per.run_open)
    test.assert_eq(per.chm_lo, 0x0FFFC)

@test
fn test_a_map_that_the_instant_has_reached_replaces_the_one_in_force_for_the_instances_from_the_instant_on()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    running(var cen, var per, 0)
    var caps = caps_full()
    var ep = env(false, 20)
    var out = ll_pdu.pdu_new()
    var m = ll_cs_pdu.chm_new(0xFFFFFFFFFC, 0x1FF, 150)
    var upd = ll_pdu.pdu_new()
    ll_cs_pdu.put_channel_map(var upd, var m)
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var upd, var out), ll_cs_proc.R_NONE)
    test.assert(per.pend_chm)
    test.assert_eq(per.pend_instant, 150)
    // The channels of the map: those of the allowed set.
    let full = ll_cs_pdu.chm_count(ll_cs_pdu.CHM_LO_ALLOWED, ll_cs_pdu.CHM_HI_ALLOWED)
    test.assert_eq(ll_cs_proc.filtered_count(var per, 0, 149), full)
    test.assert_eq(ll_cs_proc.filtered_count(var per, 0, 150), ll_cs_pdu.chm_count(0xFFFFFFFFFC & ll_cs_pdu.CHM_LO_ALLOWED, 0x1FF))
    test.assert_eq(ll_cs_proc.filtered_lo(var per, 0, 150), 0xFFFFFFFFFC & ll_cs_pdu.CHM_LO_ALLOWED)
    test.assert_eq(ll_cs_proc.filtered_hi(var per, 0, 149), ll_cs_pdu.CHM_HI_ALLOWED)
    test.assert_eq(ll_cs_proc.filtered_hi(var per, 0, 200), 0x1FF)
    test.assert_eq(ll_cs_proc.instance_begin(var per, 149), 0)
    test.assert(per.pend_chm)
    test.assert_eq(per.chm_hi, ll_cs_pdu.CHM_HI_ALLOWED)
    test.assert_eq(ll_cs_proc.instance_begin(var per, 150), 0)
    test.assert(not per.pend_chm)
    test.assert_eq(per.chm_hi, 0x1FF)

// ── Procedure Repeat Termination ────────────────────────────────────

@test
fn test_the_higher_of_two_counters_is_the_one_the_modulo_difference_says()
    if skip()
        return
    test.assert_eq(ll_cs_proc.higher_count(5, 7), 7)
    test.assert_eq(ll_cs_proc.higher_count(7, 5), 7)
    test.assert_eq(ll_cs_proc.higher_count(9, 9), 9)
    test.assert_eq(ll_cs_proc.higher_count(0xFFFF, 1), 1)
    test.assert_eq(ll_cs_proc.higher_count(1, 0xFFFF), 1)
    test.assert_eq(ll_cs_proc.higher_count(0, 32766), 32766)
    test.assert_eq(ll_cs_proc.higher_count(0, 32767), 0)
    test.assert_eq(ll_cs_proc.higher_count(32767, 0), 32767)

@test
fn test_the_termination_stops_the_repeats_at_both_ends_and_they_agree_on_the_counter()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    running(var cen, var per, 0)
    var caps = caps_full()
    var ec = env(true, 30)
    var ep = env(false, 30)
    var a = ll_pdu.pdu_new()
    var b = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.instance_begin(var cen, 110), 0)
    test.assert_eq(ll_cs_proc.instance_begin(var per, 110), 0)
    test.assert_eq(ll_cs_proc.instance_begin(var cen, 140), 0)
    // The Peripheral has begun an instance more than the Central knows of.
    test.assert_eq(ll_cs_proc.instance_begin(var per, 140), 0)
    test.assert_eq(ll_cs_proc.instance_begin(var per, 170), 0)
    test.assert_eq(cen.proc_count, 1)
    test.assert_eq(per.proc_count, 2)
    test.assert_eq(ll_cs_proc.begin_terminate(var cen, var ec, 0, 0x13, var a), 0)
    test.assert_eq(op_of(var a), ll_cs.OP_CS_TERMINATE_REQ)
    test.assert_eq(ll_data.dpdu_len(var a), 5)
    var t = ll_cs_pdu.term_new(0, 0, 0)
    test.assert(ll_cs_pdu.get_terminate(var a, var t))
    test.assert_eq(t.config_id, 0)
    test.assert_eq(t.proc_count, 1)
    test.assert_eq(t.error, 0x13)
    test.assert_eq(cen.wait, ll_cs_proc.W_TERM)
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var a, var b), ll_cs_proc.R_SEND)
    test.assert_eq(op_of(var b), ll_cs.OP_CS_TERMINATE_RSP)
    var r = ll_cs_pdu.term_new(0, 0, 0)
    test.assert(ll_cs_pdu.get_terminate(var b, var r))
    test.assert_eq(r.proc_count, 2)
    test.assert_eq(r.error, 0x13)
    test.assert(not per.run_open)
    test.assert_eq(per.term_error, 0x13)
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var caps, var b, var a), ll_cs_proc.R_NONE)
    test.assert(not cen.run_open)
    test.assert_eq(cen.wait, ll_cs_proc.W_NONE)
    // Both keep the higher counter, which keeps the two generators in step.
    test.assert_eq(cen.proc_count, 2)
    test.assert_eq(per.proc_count, 2)
    test.assert(ll_cs_proc.take_owed(var cen, ll_cs_proc.OWED_TERM))
    test.assert_eq(cen.st_term, 0)

@test
fn test_the_peripheral_may_terminate_too_and_a_series_that_ends_by_itself_needs_no_termination()
