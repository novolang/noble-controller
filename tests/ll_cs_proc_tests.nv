        return
    var cen = fresh()
    var per = fresh()
    running(var cen, var per, 5)
    test.assert(cen.fresh)
    test.assert_eq(ll_cs_proc.instance_begin(var cen, 110), 0)
    test.assert_eq(cen.proc_count, 0)
    test.assert(not cen.fresh)
    test.assert_eq(ll_cs_proc.instance_begin(var cen, 140), 0)
    test.assert_eq(cen.proc_count, 1)
    test.assert_eq(ll_cs_proc.instance_begin(var cen, 170), 0)
    test.assert_eq(cen.proc_count, 2)
    set_count(var cen, 0xFFFF)
    test.assert_eq(ll_cs_proc.instance_begin(var cen, 200), 0)
    test.assert_eq(cen.proc_count, 0)

