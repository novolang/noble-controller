@test
fn test_a_capabilities_record_out_of_range_is_refused_with_invalid_ll_parameters()
    if skip()
        return
    var cc = caps_full()
    var ep = env(false, 10)
    for f in [15, 8, 9, 10]
        for v in [0, 4, 5, 9]
            var bad = caps_set(f, v)
            // The fields that the check holds to a range: configurations 1 to 4, antennas 1 to 4, paths from the antennas to 4, a role.
            var ok = true
            if f == 15 and (v < 1 or v > 4)
                ok = false
            if f == 8 and (v < 1 or v > 4)
                ok = false
            if f == 9 and (v < bad.num_ant or v > 4)
                ok = false
            // The role has two bits on the air: 4 reads 0 and 5 and 9 read 1.
            if f == 10 and ((v & 3) < 1)
                ok = false
            var req = ll_pdu.pdu_new()
            var ec = env(true, 10)
            caps_req(var bad, var req)
            var per = fresh()
            var out = ll_pdu.pdu_new()
            test.assert_eq(ll_cs_proc.receive(var per, var ep, var cc, var req, var out), ll_cs_proc.R_SEND)
            if ok
                test.assert_eq(op_of(var out), ll_cs.OP_CS_CAPABILITIES_RSP)
            else
                test.assert(rejects(var out, ll_cs.OP_CS_CAPABILITIES_REQ, ll_cs_proc.E_INVALID_LL))
                test.assert(not ll_cs_proc.caps_known(var per))

