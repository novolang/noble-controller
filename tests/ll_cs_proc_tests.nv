    test.assert_eq(ll_cs_proc.begin_config(var cen, var ec, var caps, var want, false, var a), 0)
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var a, var b), ll_cs_proc.R_SEND)
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var caps, var b, var a), ll_cs_proc.R_NONE)
