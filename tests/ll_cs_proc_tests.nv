@test
fn test_the_capabilities_exchange_gives_each_end_the_record_of_the_other()
    if skip()
        return
    var cc = caps_full()
    var cp = caps_set(8, 1)
    var cen = fresh()
    var per = fresh()
    var ec = env(true, 10)
    var ep = env(false, 10)
    var a = ll_pdu.pdu_new()
    var b = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.begin_capabilities(var cen, var ec, var cc, var a), 0)
    test.assert_eq(cen.wait, ll_cs_proc.W_CAP)
    test.assert_eq(op_of(var a), ll_cs.OP_CS_CAPABILITIES_REQ)
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var cp, var a, var b), ll_cs_proc.R_SEND)
    test.assert_eq(op_of(var b), ll_cs.OP_CS_CAPABILITIES_RSP)
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var cc, var b, var a), ll_cs_proc.R_NONE)
    test.assert_eq(cen.wait, ll_cs_proc.W_NONE)
    test.assert(ll_cs_proc.caps_known(var cen))
    test.assert(ll_cs_proc.caps_known(var per))
    var got = ll_cs_pdu.cap_new()
    var scratch = ll_pdu.pdu_new()
    test.assert(ll_cs_proc.load_caps(var cen, var got, var scratch))
    test.assert_eq(got.num_ant, 1)
    test.assert_eq(got.num_configs, cp.num_configs)
    test.assert_eq(got.t_ip1, 0x7F)
    test.assert(got.v2)
    var got2 = ll_cs_pdu.cap_new()
    test.assert(ll_cs_proc.load_caps(var per, var got2, var scratch))
    test.assert_eq(got2.num_ant, 2)
    test.assert_eq(got2.tx_snr, 0x7F)
    test.assert(ll_cs_proc.take_owed(var cen, ll_cs_proc.OWED_CAPS))
    test.assert_eq(cen.st_caps, 0)
    test.assert(cen.caps_air)
    test.assert(per.caps_air)

