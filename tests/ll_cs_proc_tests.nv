@test
fn test_the_configuration_request_unanswered_for_40_seconds_ends_the_connection()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    exchange(var cen, var per)
    var caps = caps_full()
    var ec = env(true, 7000)
    var a = ll_pdu.pdu_new()
    var c = cfg_ok(0, 0)
    test.assert_eq(ll_cs_proc.begin_config(var cen, var ec, var caps, var c, false, var a), 0)
    var e1 = env(true, 7000 + 40000000)
    test.assert_eq(ll_cs_proc.poll(var cen, var e1), 0)
    var e2 = env(true, 7000 + 40000001)
    test.assert_eq(ll_cs_proc.poll(var cen, var e2), ll_cs_proc.E_RESPONSE_TIMEOUT)
    test.assert_eq(cen.st_cfg, ll_cs_proc.E_RESPONSE_TIMEOUT)
    test.assert(ll_cs_proc.take_owed(var cen, ll_cs_proc.OWED_CFG))
    test.assert(not ll_cs_proc.cfg_used(var cen, 0))

@test
fn test_a_configuration_request_that_crosses_the_centrals_is_rejected_and_the_central_goes_on()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    exchange(var cen, var per)
    take_all(var cen)
    take_all(var per)
    var caps = caps_full()
    var ec = env(true, 10)
    var ep = env(false, 10)
    var cfg_c = cfg_set(C_REP, 5)
    var cfg_p = cfg_set2(C_REP, 7, C_ROLE, 1)
    var a = ll_pdu.pdu_new()
    var b = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.begin_config(var cen, var ec, var caps, var cfg_c, false, var a), 0)
    test.assert_eq(ll_cs_proc.begin_config(var per, var ep, var caps, var cfg_p, false, var b), 0)
    // The Central receives the Peripheral's request while its own is out: LL Procedure Collision, and its own goes on.
    var rej = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var caps, var b, var rej), ll_cs_proc.R_SEND)
    test.assert(rejects(var rej, ll_cs.OP_CS_CONFIG_REQ, ll_cs_proc.E_COLLISION))
    test.assert_eq(cen.wait, ll_cs_proc.W_CFG)
    test.assert_eq(cen.owed, 0)
    // The Peripheral receives the Central's request: it is answered, and the Peripheral's own request is left to the Central's rejection.
    var rsp = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var a, var rsp), ll_cs_proc.R_SEND)
    test.assert_eq(op_of(var rsp), ll_cs.OP_CS_CONFIG_RSP)
    test.assert_eq(per.wait, ll_cs_proc.W_CFG)
    test.assert_eq(per.owed, ll_cs_proc.OWED_CFG)
    test.assert_eq(per.st_cfg, 0)
    test.assert_eq(stored(var per, 0).chm_rep, 5)
    take_all(var per)
    // The rejection ends the Peripheral's request with the collision error.
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var rej, var b), ll_cs_proc.R_NONE)
    test.assert_eq(per.wait, ll_cs_proc.W_NONE)
    test.assert_eq(per.st_cfg, ll_cs_proc.E_COLLISION)
    test.assert_eq(per.owed, ll_cs_proc.OWED_CFG)
    test.assert_eq(per.yield_op, 0)
    // The Central's request completes as if nothing had crossed it.
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var caps, var rsp, var a), ll_cs_proc.R_NONE)
    test.assert_eq(stored(var cen, 0).chm_rep, 5)
    test.assert_eq(stored(var per, 0).chm_rep, 5)

@test
fn test_a_removal_is_a_configuration_procedure_for_the_collision_rule_too()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    exchange(var cen, var per)
    configure(var cen, var per, 0, 0)
    take_all(var cen)
    take_all(var per)
    var caps = caps_full()
    var ec = env(true, 10)
    var ep = env(false, 10)
    var rm = cfg_set(C_ACTION, 0)
    var a = ll_pdu.pdu_new()
    var b = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.begin_config(var cen, var ec, var caps, var rm, false, var a), 0)
    test.assert_eq(ll_cs_proc.begin_config(var per, var ep, var caps, var rm, false, var b), 0)
    var rej = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var caps, var b, var rej), ll_cs_proc.R_SEND)
    test.assert(rejects(var rej, ll_cs.OP_CS_CONFIG_REQ, ll_cs_proc.E_COLLISION))
    test.assert(ll_cs_proc.cfg_used(var cen, 0))

// ── The state a test sets ───────────────────────────────────────────

fn take_all(var cs: Cs)
    cs.owed = 0

fn set_count(var cs: Cs, v: Int)
    cs.proc_count = v

// The series the Start left open: the configuration, N_PROCEDURE_COUNT and the CSProcCount of the first instance.
fn set_series(var cs: Cs, cfg: Int, n: Int, start: Int)
    cs.run_open = true
    cs.series_cfg = cfg
    cs.series_n = n
    cs.series_start = start

// Run a Start with `starter` beginning, as the Central or not, and `other` taking part: the PDUs of the three-way exchange cross, and both ends have the
// procedures started.
fn run_start(var starter: Cs, var other: Cs, starter_central: Bool, var s: StartPdu)
    var caps = caps_full()
    var es = env(starter_central, 20)
    var eo = env(not starter_central, 20)
    var a = ll_pdu.pdu_new()
    var b = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.begin_start(var starter, var es, var caps, var s, var a), 0)
    if starter_central
        test.assert_eq(ll_cs_proc.receive(var other, var eo, var caps, var a, var b), ll_cs_proc.R_SEND)
        test.assert_eq(ll_cs_proc.receive(var starter, var es, var caps, var b, var a), ll_cs_proc.R_SEND)
        test.assert_eq(ll_cs_proc.receive(var other, var eo, var caps, var a, var b), ll_cs_proc.R_NONE)
    else
        test.assert_eq(ll_cs_proc.receive(var other, var eo, var caps, var a, var b), ll_cs_proc.R_SEND)
        test.assert_eq(ll_cs_proc.receive(var starter, var es, var caps, var b, var a), ll_cs_proc.R_NONE)
    test.assert(starter.run_open)
    test.assert(other.run_open)

// A series of `count` procedures (0 for no end) started by the Central, whose procedure interval is 3 connection intervals when it repeats.
fn running(var cen: Cs, var per: Cs, count: Int)
    ready(var cen, var per, 0)
    var s = start_set(S_PCNT, count)
    if count != 1
        start_put(var s, S_PINT, 3)
    run_start(var cen, var per, true, var s)
    take_all(var cen)
    take_all(var per)

fn run_of(var cs: Cs) -> StartPdu
    var s = ll_cs_pdu.start_new()
    var scratch = ll_pdu.pdu_new()
    test.assert(ll_cs_proc.load_run(var cs, var s, var scratch))
    s

fn start_status(var cs: Cs, var e: ll_cs_proc.Env, var s: StartPdu) -> Int
    var caps = caps_full()
    var out = ll_pdu.pdu_new()
    ll_cs_proc.begin_start(var cs, var e, var caps, var s, var out)

fn start_pdu(var s: StartPdu) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_cs_pdu.put_req(var p, var s)
    p

// ── Mode-0 FAE Table Request ────────────────────────────────────────

@test
fn test_the_fae_table_of_the_reflector_reaches_the_initiator()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    exchange(var cen, var per)
    take_all(var cen)
    var caps = caps_full()
    var ec = env(true, 10)
    var ep = env(false, 10)
    var a = ll_pdu.pdu_new()
    var b = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.begin_fae(var cen, var ec, var a), 0)
    test.assert_eq(op_of(var a), ll_cs.OP_CS_FAE_REQ)
    test.assert_eq(ll_data.dpdu_len(var a), 1)
    test.assert_eq(cen.wait, ll_cs_proc.W_FAE)
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var a, var b), ll_cs_proc.R_FAE)
    var table = fae_tbl()
    test.assert_eq(ll_cs_proc.fae_rsp(var ep, var table, var b), ll_cs_proc.R_SEND)
    test.assert_eq(op_of(var b), ll_cs.OP_CS_FAE_RSP)
    test.assert_eq(ll_data.dpdu_len(var b), 73)
    test.assert_eq(b.n, 75)
    // The values of the table of the answering end, signed, in the order of the allowed channels.
    for i in 0..72
        test.assert_eq(ll_cs_pdu.fae_value(var b, i), i * 3 - 100)
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var caps, var b, var a), ll_cs_proc.R_NONE)
    test.assert(cen.fae_known)
    test.assert(cen.fae_air)
    test.assert(ll_cs_proc.take_owed(var cen, ll_cs_proc.OWED_FAE))
    test.assert_eq(cen.st_fae, 0)
    test.assert_eq(cen.wait, ll_cs_proc.W_NONE)
    test.assert(not per.fae_known)

@test
fn test_the_72_values_of_the_table_are_kept_in_the_order_of_the_allowed_channels()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
