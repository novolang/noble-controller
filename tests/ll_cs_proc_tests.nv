@test
fn test_the_host_cannot_terminate_what_is_not_a_repeating_series_or_another_configuration()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    var a = ll_pdu.pdu_new()
    var ec = env(true, 30)
    // No series.
    test.assert_eq(ll_cs_proc.begin_terminate(var cen, var ec, 0, 0x13, var a), ll_cs_proc.E_DISALLOWED)
    var single = fresh()
    var other = fresh()
    running(var single, var other, 1)
    // One procedure only: there is nothing to repeat.
    test.assert_eq(ll_cs_proc.begin_terminate(var single, var ec, 0, 0x13, var a), ll_cs_proc.E_DISALLOWED)
    var cen2 = fresh()
    var per2 = fresh()
    running(var cen2, var per2, 0)
    // The configuration is not the series'.
    test.assert_eq(ll_cs_proc.begin_terminate(var cen2, var ec, 1, 0x13, var a), ll_cs_proc.E_DISALLOWED)
    var none = fresh_no_host()
    test.assert_eq(ll_cs_proc.begin_terminate(var none, var ec, 0, 0x13, var a), ll_cs_proc.E_DISALLOWED)
    var e1 = envf(true, E_NOPEER, 30)
    var e2 = envf(true, E_PLAIN, 30)
    var e3 = envf(true, E_SMALL, 30)
    test.assert_eq(ll_cs_proc.begin_terminate(var cen2, var e1, 0, 0x13, var a), ll_cs_proc.E_UNSUPPORTED_REMOTE)
    test.assert_eq(ll_cs_proc.begin_terminate(var cen2, var e2, 0, 0x13, var a), ll_cs_proc.E_INSUFFICIENT_SECURITY)
    test.assert_eq(ll_cs_proc.begin_terminate(var cen2, var e3, 0, 0x13, var a), 0)
    // The PDU fits a packet of 27 octets, and another procedure of this end is waiting now.
    test.assert_eq(ll_cs_proc.begin_terminate(var cen2, var ec, 0, 0x13, var a), ll_cs_proc.E_DISALLOWED)

@test
fn test_a_termination_request_names_a_counter_and_a_configuration_of_the_series_or_is_refused()
    if skip()
        return
    var caps = caps_full()
    var out = ll_pdu.pdu_new()
    var ep = env(false, 30)
    // A series of 3 procedures whose first counter is 10: the counters 10, 11 and 12 belong to it, and so does 9 by the condition of Section 5.1.27, which
    // is true of a counter one below the first: (9 - 10 + 1) mod 65536 is 0.
    for pair in [[10, 1], [11, 1], [12, 1], [9, 1], [13, 0], [14, 0], [8, 0], [0, 0], [0xFFFF, 0]]
        var cen = fresh()
        var per = fresh()
        running(var cen, var per, 3)
        set_series(var per, 0, 3, 10)
        var t = ll_cs_pdu.term_new(0, pair[0], 0x13)
        var req = ll_pdu.pdu_new()
        ll_cs_pdu.put_terminate(var req, ll_cs.OP_CS_TERMINATE_REQ, var t)
        test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var req, var out), ll_cs_proc.R_SEND)
        if pair[1] == 1
            test.assert_eq(op_of(var out), ll_cs.OP_CS_TERMINATE_RSP)
            test.assert(not per.run_open)
        else
            test.assert(rejects(var out, ll_cs.OP_CS_TERMINATE_REQ, ll_cs_proc.E_DISALLOWED))
            test.assert(per.run_open)
    // The counter wraps: a series of 5 that began at 65534 has the counters 65534, 65535, 0, 1 and 2.
    for pair in [[65534, 1], [65535, 1], [0, 1], [2, 1], [3, 0], [65532, 0]]
        var cen = fresh()
        var per = fresh()
        running(var cen, var per, 5)
        set_series(var per, 0, 5, 65534)
        var t = ll_cs_pdu.term_new(0, pair[0], 0x13)
        var req = ll_pdu.pdu_new()
        ll_cs_pdu.put_terminate(var req, ll_cs.OP_CS_TERMINATE_REQ, var t)
        test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var req, var out), ll_cs_proc.R_SEND)
        if pair[1] == 1
            test.assert_eq(op_of(var out), ll_cs.OP_CS_TERMINATE_RSP)
        else
            test.assert(rejects(var out, ll_cs.OP_CS_TERMINATE_REQ, ll_cs_proc.E_DISALLOWED))
    // A series with no end takes any counter.
    var cen = fresh()
    var per = fresh()
    running(var cen, var per, 0)
    var t = ll_cs_pdu.term_new(0, 40000, 0x13)
    var req = ll_pdu.pdu_new()
    ll_cs_pdu.put_terminate(var req, ll_cs.OP_CS_TERMINATE_REQ, var t)
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var req, var out), ll_cs_proc.R_SEND)
    test.assert_eq(op_of(var out), ll_cs.OP_CS_TERMINATE_RSP)
    // Another configuration, a single procedure and no series at all.
    var cen3 = fresh()
    var per3 = fresh()
    running(var cen3, var per3, 3)
    var t1 = ll_cs_pdu.term_new(1, 0, 0x13)
    var req1 = ll_pdu.pdu_new()
    ll_cs_pdu.put_terminate(var req1, ll_cs.OP_CS_TERMINATE_REQ, var t1)
    test.assert_eq(ll_cs_proc.receive(var per3, var ep, var caps, var req1, var out), ll_cs_proc.R_SEND)
    test.assert(rejects(var out, ll_cs.OP_CS_TERMINATE_REQ, ll_cs_proc.E_DISALLOWED))
    var cen4 = fresh()
    var per4 = fresh()
    running(var cen4, var per4, 1)
    var t0 = ll_cs_pdu.term_new(0, 0, 0x13)
    var req0 = ll_pdu.pdu_new()
    ll_cs_pdu.put_terminate(var req0, ll_cs.OP_CS_TERMINATE_REQ, var t0)
    test.assert_eq(ll_cs_proc.receive(var per4, var ep, var caps, var req0, var out), ll_cs_proc.R_SEND)
    test.assert(rejects(var out, ll_cs.OP_CS_TERMINATE_REQ, ll_cs_proc.E_DISALLOWED))
    var per5 = fresh()
    test.assert_eq(ll_cs_proc.receive(var per5, var ep, var caps, var req0, var out), ll_cs_proc.R_SEND)
    test.assert(rejects(var out, ll_cs.OP_CS_TERMINATE_REQ, ll_cs_proc.E_DISALLOWED))

