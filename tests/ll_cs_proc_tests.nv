    var ep = env(false, 10)
    var a = ll_pdu.pdu_new()
    var b = ll_pdu.pdu_new()
    var ra = ll_pdu.pdu_new()
    var rb = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.begin_capabilities(var cen, var ec, var cc, var a), 0)
    test.assert_eq(ll_cs_proc.begin_capabilities(var per, var ep, var cc, var b), 0)
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var cc, var a, var ra), ll_cs_proc.R_SEND)
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var cc, var b, var rb), ll_cs_proc.R_SEND)
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var cc, var ra, var a), ll_cs_proc.R_NONE)
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var cc, var rb, var b), ll_cs_proc.R_NONE)
    test.assert_eq(cen.wait, ll_cs_proc.W_NONE)
    test.assert_eq(per.wait, ll_cs_proc.W_NONE)
    test.assert_eq(cen.owed, ll_cs_proc.OWED_CAPS)
    test.assert_eq(per.owed, ll_cs_proc.OWED_CAPS)

@test
fn test_the_capabilities_request_unanswered_for_40_seconds_ends_the_connection()
    if skip()
        return
    var cc = caps_full()
    var cen = fresh()
    var ec = env(true, 500)
    var a = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.begin_capabilities(var cen, var ec, var cc, var a), 0)
    var e1 = env(true, 500 + 40000000)
    test.assert_eq(ll_cs_proc.poll(var cen, var e1), 0)
    var e2 = env(true, 500 + 40000001)
    test.assert_eq(ll_cs_proc.poll(var cen, var e2), ll_cs_proc.E_RESPONSE_TIMEOUT)
    test.assert_eq(cen.st_caps, ll_cs_proc.E_RESPONSE_TIMEOUT)
    test.assert(ll_cs_proc.take_owed(var cen, ll_cs_proc.OWED_CAPS))

@test
fn test_capabilities_the_host_knows_are_kept_until_the_peer_or_a_configuration_replaces_them()
    if skip()
        return
    var cs = fresh()
    var scratch = ll_pdu.pdu_new()
    var c = caps_full()
    test.assert_eq(ll_cs_proc.cache_caps(var cs, var c, var scratch), 0)
    test.assert(ll_cs_proc.caps_known(var cs))
    test.assert(not cs.caps_air)
    // The Host may write them again, while nothing came from the peer.
    var c2 = caps_set(8, 1)
    test.assert_eq(ll_cs_proc.cache_caps(var cs, var c2, var scratch), 0)
    var got = ll_cs_pdu.cap_new()
    test.assert(ll_cs_proc.load_caps(var cs, var got, var scratch))
    test.assert_eq(got.num_ant, 1)
    // A record that came from the peer cannot be overwritten.
    var cen = fresh()
    var per = fresh()
    exchange(var cen, var per)
    test.assert_eq(ll_cs_proc.cache_caps(var cen, var c, var scratch), ll_cs_proc.E_DISALLOWED)
    test.assert_eq(ll_cs_proc.cache_caps(var per, var c, var scratch), ll_cs_proc.E_DISALLOWED)

@test
fn test_capabilities_cannot_be_written_once_a_configuration_exists()
    if skip()
        return
    var cs = fresh()
    var scratch = ll_pdu.pdu_new()
    var c = caps_full()
    var cc = caps_full()
    test.assert_eq(ll_cs_proc.cache_caps(var cs, var c, var scratch), 0)
    var ec = env(true, 10)
    var out = ll_pdu.pdu_new()
    var cfg = cfg_ok(0, 0)
    test.assert_eq(ll_cs_proc.begin_config(var cs, var ec, var cc, var cfg, true, var out), 0)
    test.assert_eq(ll_cs_proc.cache_caps(var cs, var c, var scratch), ll_cs_proc.E_DISALLOWED)

// ── Configuration ───────────────────────────────────────────────────

fn stored(var cs: Cs, id: Int) -> CfgPdu
    var c = ll_cs_pdu.cfg_new()
    var scratch = ll_pdu.pdu_new()
    test.assert(ll_cs_proc.load_config(var cs, id, var c, var scratch))
    c

fn same_config(a: CfgPdu, b: CfgPdu) -> Bool
    a.config_id == b.config_id and a.action == b.action and a.chm_lo == b.chm_lo and a.chm_hi == b.chm_hi and a.chm_rep == b.chm_rep and a.main_mode == b.main_mode
        and a.sub_mode == b.sub_mode and a.main_min == b.main_min and a.main_max == b.main_max and a.main_rep == b.main_rep and a.mode0_steps == b.mode0_steps
        and a.sync_phy == b.sync_phy and a.rtt_type == b.rtt_type and a.role == b.role and a.ipt == b.ipt and a.chsel == b.chsel and a.c3_shape == b.c3_shape
        and a.c3_jump == b.c3_jump and a.t_ip1 == b.t_ip1 and a.t_ip2 == b.t_ip2 and a.t_fcs == b.t_fcs and a.t_pm == b.t_pm

fn cfg_pdu(var c: CfgPdu) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_cs_pdu.put_config_req(var p, var c)
    p

// The verdict of the check on `c` with the capabilities `l` of this end and `p` of the peer, the request this end's.
fn check(var c: CfgPdu, var l: CapPdu, var p: CapPdu) -> Int
    ll_cs_proc.config_check(var c, var l, var p, true, true)

fn check_full(var c: CfgPdu) -> Int
    var l = caps_full()
    var p = caps_full()
    check(var c, var l, var p)

@test
fn test_a_configuration_the_central_creates_is_kept_by_both_ends_with_opposite_roles()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    exchange(var cen, var per)
    var want = cfg_set2(C_MAIN, 3, C_RTT, 4)
    var caps = caps_full()
    var ec = env(true, 10)
    var ep = env(false, 10)
    var a = ll_pdu.pdu_new()
    var b = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.begin_config(var cen, var ec, var caps, var want, false, var a), 0)
    test.assert_eq(cen.wait, ll_cs_proc.W_CFG)
    test.assert_eq(op_of(var a), ll_cs.OP_CS_CONFIG_REQ)
    test.assert_eq(ll_data.dpdu_len(var a), 28)
    // Nothing is in force until the peer accepts.
    test.assert(not ll_cs_proc.cfg_used(var cen, 0))
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var a, var b), ll_cs_proc.R_SEND)
    test.assert_eq(op_of(var b), ll_cs.OP_CS_CONFIG_RSP)
    test.assert_eq(ll_cs_pdu.get_config_rsp(var b), 0)
    test.assert(ll_cs_proc.cfg_used(var per, 0))
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var caps, var b, var a), ll_cs_proc.R_NONE)
    test.assert(ll_cs_proc.cfg_used(var cen, 0))
    test.assert(same_config(stored(var cen, 0), want))
    test.assert(same_config(stored(var per, 0), want))
    test.assert(ll_cs_proc.cfg_mine(var cen, 0))
    test.assert(not ll_cs_proc.cfg_mine(var per, 0))
    test.assert_eq(ll_cs_proc.cfg_role(var cen, 0), 0)
    test.assert_eq(ll_cs_proc.cfg_role(var per, 0), 1)
    test.assert_eq(cen.wait, ll_cs_proc.W_NONE)

@test
fn test_a_configuration_the_peripheral_creates_in_the_reflector_role_makes_the_central_the_initiator()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    exchange(var cen, var per)
    var want = cfg_ok(0, 1)
    var caps = caps_full()
    var ec = env(true, 10)
    var ep = env(false, 10)
    var a = ll_pdu.pdu_new()
    var b = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.begin_config(var per, var ep, var caps, var want, false, var a), 0)
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var caps, var a, var b), ll_cs_proc.R_SEND)
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var b, var a), ll_cs_proc.R_NONE)
    test.assert_eq(ll_cs_proc.cfg_role(var per, 0), 1)
    test.assert_eq(ll_cs_proc.cfg_role(var cen, 0), 0)
    test.assert(same_config(stored(var cen, 0), want))

@test
fn test_both_ends_owe_the_host_the_config_event_with_the_id_and_the_action()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    exchange(var cen, var per)
    take_all(var cen)
