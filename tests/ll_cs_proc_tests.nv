    test.assert(rejects(var out, ll_cs.OP_CS_CONFIG_REQ, ll_cs_proc.E_DISALLOWED))
    test.assert_eq(stored(var per, 0).chm_rep, 3)

@test
fn test_a_configuration_request_with_parameters_this_end_does_not_take_is_refused_with_unsupported_ll_parameter_value()
    if skip()
        return
    var caps = caps_min()
    var cen = fresh()
    var per = fresh()
    exchange(var cen, var per)
    var ep = env(false, 10)
    var out = ll_pdu.pdu_new()
    for f in [C_REP, C_MAIN, C_PHY, C_RTT, C_ROLE, C_IP1]
        var c = cfg_ok(0, 0)
        if f == C_REP
            cfg_put(var c, f, 0)
        else if f == C_MAIN
            cfg_put(var c, f, 3)
        else if f == C_PHY
            cfg_put(var c, f, 2)
        else if f == C_RTT
            cfg_put(var c, f, 3)
        else if f == C_ROLE
            cfg_put(var c, f, 2)
        else
            cfg_put(var c, f, 9)
        var req = cfg_pdu(var c)
        test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var req, var out), ll_cs_proc.R_SEND)
        test.assert(rejects(var out, ll_cs.OP_CS_CONFIG_REQ, ll_cs_proc.E_UNSUPPORTED_LL))
        test.assert(not ll_cs_proc.cfg_used(var per, 0))
        test.assert_eq(per.owed & ll_cs_proc.OWED_CFG, 0)

