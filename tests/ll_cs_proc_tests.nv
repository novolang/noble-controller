@test
fn test_a_map_with_an_instant_in_the_past_ends_the_series_with_instant_passed_and_applies_to_the_procedures_after_it()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    running(var cen, var per, 0)
    var caps = caps_full()
    var ep = env(false, 30)
    var out = ll_pdu.pdu_new()
    // The current event is 100: the instant 90 is in the past, 110 is not.
    var m = ll_cs_pdu.chm_new(0x7FFFFC, 0x1, 90)
    var upd = ll_pdu.pdu_new()
    ll_cs_pdu.put_channel_map(var upd, var m)
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var upd, var out), ll_cs_proc.R_SEND)
    test.assert_eq(op_of(var out), ll_cs.OP_CS_TERMINATE_REQ)
    var t = ll_cs_pdu.term_new(0, 0, 0)
    test.assert(ll_cs_pdu.get_terminate(var out, var t))
    test.assert_eq(t.config_id, 0)
    test.assert_eq(t.error, ll_cs_proc.E_INSTANT_PASSED)
    test.assert_eq(per.wait, ll_cs_proc.W_TERM)
    // The map applies from the next instance.
    test.assert(per.pend_chm)
    test.assert_eq(ll_cs_proc.filtered_hi(var per, 0, 100), 0x1)
    var cen2 = fresh()
    var per2 = fresh()
    running(var cen2, var per2, 0)
    var m2 = ll_cs_pdu.chm_new(0x7FFFFC, 0x1, 110)
    var upd2 = ll_pdu.pdu_new()
    ll_cs_pdu.put_channel_map(var upd2, var m2)
    test.assert_eq(ll_cs_proc.receive(var per2, var ep, var caps, var upd2, var out), ll_cs_proc.R_NONE)
    test.assert_eq(per2.wait, ll_cs_proc.W_NONE)

