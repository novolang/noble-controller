// ── Channel Map Update ──────────────────────────────────────────────

@test
fn test_a_map_the_host_sets_with_no_procedure_running_takes_effect_at_once_and_goes_to_the_peer()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    var caps = caps_full()
    var ec = env(true, 30)
    var ep = env(false, 30)
    var a = ll_pdu.pdu_new()
    var out = ll_pdu.pdu_new()
    var lo = 0x7FFFFC
    var hi = 0
    test.assert_eq(ll_cs_proc.begin_channel_map(var cen, var ec, lo, hi, 200, var a), 0)
    test.assert_eq(op_of(var a), ll_cs.OP_CS_CHANNEL_MAP_IND)
    test.assert_eq(ll_data.dpdu_len(var a), 13)
    var m = ll_cs_pdu.chm_new(0, 0, 0)
    test.assert(ll_cs_pdu.get_channel_map(var a, var m))
    test.assert_eq(m.lo, 0x7FFFFC)
    test.assert_eq(m.hi, 0)
    test.assert_eq(m.instant, 200)
    // The channels not allowed are cut, the rest is in force now at the end that sent it.
    test.assert_eq(cen.chm_lo, 0x7FFFFC & ll_cs_pdu.CHM_LO_ALLOWED)
    test.assert_eq(cen.chm_hi, 0)
    test.assert(not cen.pend_chm)
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var a, var out), ll_cs_proc.R_NONE)
    test.assert_eq(per.chm_lo, cen.chm_lo)
    test.assert_eq(per.chm_hi, 0)
    test.assert(not per.pend_chm)

