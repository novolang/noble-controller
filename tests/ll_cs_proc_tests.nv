// tests/ll_cs_proc_tests.nv — the unit tests of src/ll_cs_proc.nv: the seven Link Layer procedures of Channel Sounding, run between two records, one in the
// Central role and one in the Peripheral role, and against a scripted peer that sends the PDUs the specification allows and the ones it forbids.
//
// A test runs a procedure by handing the PDU one end wrote (`begin_`, `receive`) to the other and the answer back.  Nothing in these tests reads a radio, a
// link or a clock: the environment of the procedures (`ll_cs_proc.Env`) is a value the test builds, and the time in it is the test's.  The cases that need the
// feature return at once in a build without it (`ctl_cs` 0), whose record has no store; the cases that need more than one configuration return when
// `ctl_cs_configs` is 1.
//
//   novo test tests/ll_cs_proc_tests.nv

use std.test
use ctl_limits
use noble_controller_config
use ll_pdu
use ll_data
use ll_cs
use ll_cs_pdu
use ll_cs_proc
use ctl_budget

// ── Fixtures ────────────────────────────────────────────────────────

fn skip() -> Bool
    not ctl_limits.cs_on()

fn fresh() -> Cs
    var cs = ll_cs_proc.cs_new()
    ll_cs_proc.set_host(var cs, true)
    cs

fn fresh_no_host() -> Cs
    ll_cs_proc.cs_new()

// The flags of an environment.
const E_PLAIN = 1
const E_NOPEER = 2
const E_BUSY = 4
const E_NOSEC = 8
const E_SMALL = 16
const E_V1 = 32

// The environment of an end at `now`: encrypted, the peer with the feature and Enhancement #1, event 100, an interval of 30 ms, the ACL on LE 1M, every PHY's
// power managed, no procedure out and room for any PDU; `flags` take one of these away or add one.
fn envf(central: Bool, flags: Int, now: Int) -> ll_cs_proc.Env
    var max_tx = 251
    if (flags & E_SMALL) != 0
        max_tx = 27
    ll_cs_proc.Env { central: central, encrypted: (flags & E_PLAIN) == 0, peer_cs: (flags & E_NOPEER) == 0, peer_v2: (flags & E_V1) == 0, ev_count: 100,
                     interval_us: 30000, now: now, busy: (flags & E_BUSY) != 0, phy: 1, managed: 0xF, sec_ok: (flags & E_NOSEC) == 0, max_tx: max_tx }

fn env(central: Bool, now: Int) -> ll_cs_proc.Env
    envf(central, 0, now)

// The same with the ACL on `phy` and the PHYs in `managed` managed.
fn env_phy(central: Bool, phy: Int, managed: Int) -> ll_cs_proc.Env
    ll_cs_proc.Env { central: central, encrypted: true, peer_cs: true, peer_v2: true, ev_count: 100, interval_us: 30000, now: 10, busy: false, phy: phy,
                     managed: managed, sec_ok: true, max_tx: 251 }

fn rnd12(seed: Int) -> Vec[u8; 12]
    var v: Vec[u8; 12] = Vec.new()
    for i in 0..12
        let _a = v.push(((seed + i) & 0xFF) as u8)
    v

// Capabilities that do everything the configuration check looks at: mode 3, all three RTT types, LE 2M and LE 2M 2BT, two antennas and four paths, both
// roles, the initiator phase tone, a FAE table, Channel Selection Algorithm #3c, every optional timing and every SNR level.
fn caps_full() -> CapPdu
    ll_cs_pdu.CapPdu { v2: true, mode_types: 1, rtt_cap: 0, n_aa: 255, n_sound: 255, n_rand: 255, nadm_sound: 0, nadm_rand: 0, sync_phy: 6, num_ant: 2,
                       max_path: 4, role: 3, ipt: 1, no_fae: 0, ch3c: 1, sounding_pct: 1, num_configs: ll_cs_proc.cfg_slots(), max_procs: 0, t_sw: 0, t_ip1: 0x7F,
                       t_ip2: 0x7F, t_fcs: 0x1FF, t_pm: 3, rtt_phy: 0, tx_snr: 0x7F, t_ip2_ipt: 0, t_sw_ipt: 0, n2_aa: 0, n2_sound: 0, n2_rand: 0 }

// The least a device may report: no option, one antenna, both roles, no FAE table, the mandatory timings.
fn caps_min() -> CapPdu
    ll_cs_pdu.CapPdu { v2: false, mode_types: 0, rtt_cap: 0, n_aa: 255, n_sound: 0, n_rand: 0, nadm_sound: 0, nadm_rand: 0, sync_phy: 0, num_ant: 1,
                       max_path: 1, role: 3, ipt: 0, no_fae: 1, ch3c: 0, sounding_pct: 0, num_configs: ll_cs_proc.cfg_slots(), max_procs: 0, t_sw: 0, t_ip1: 0,
                       t_ip2: 0, t_fcs: 0, t_pm: 0, rtt_phy: 0, tx_snr: 0, t_ip2_ipt: 0, t_sw_ipt: 0, n2_aa: 0, n2_sound: 0, n2_rand: 0 }

// The same as `caps_full` with field `f` of the PDU order (see `cap_put`) set to `v`.
fn caps_set(f: Int, v: Int) -> CapPdu
    var c = caps_full()
    cap_put(var c, f, v)
    c

fn cap_put(var c: CapPdu, f: Int, v: Int)
    match f
        0  => c.mode_types = v
        1  => c.rtt_cap = v
        2  => c.n_aa = v
        3  => c.n_sound = v
        4  => c.n_rand = v
        7  => c.sync_phy = v
        8  => c.num_ant = v
        9  => c.max_path = v
        10 => c.role = v
        11 => c.ipt = v
        12 => c.no_fae = v
        13 => c.ch3c = v
        15 => c.num_configs = v
        18 => c.t_ip1 = v
        19 => c.t_ip2 = v
        20 => c.t_fcs = v
        21 => c.t_pm = v
        23 => c.tx_snr = v
        _  => c.v2 = v == 1

// The fields of a configuration that `cfg_put` sets, by number.
const C_ID = 0
const C_ACTION = 1
const C_LO = 2
const C_HI = 3
const C_REP = 4
const C_MAIN = 5
const C_SUB = 6
const C_MIN = 7
const C_MAX = 8
const C_MREP = 9
const C_M0 = 10
const C_PHY = 11
const C_RTT = 12
const C_ROLE = 13
const C_IPT = 14
const C_CHSEL = 15
const C_SHAPE = 16
const C_JUMP = 17
const C_IP1 = 18
const C_IP2 = 19
const C_FCS = 20
const C_PM = 21

fn cfg_put(var c: CfgPdu, f: Int, v: Int)
    match f
        0  => c.config_id = v
        1  => c.action = v
        2  => c.chm_lo = v
        3  => c.chm_hi = v
        4  => c.chm_rep = v
        5  => c.main_mode = v
        6  => c.sub_mode = v
        7  => c.main_min = v
        8  => c.main_max = v
        9  => c.main_rep = v
        10 => c.mode0_steps = v
        11 => c.sync_phy = v
        12 => c.rtt_type = v
        13 => c.role = v
        14 => c.ipt = v
        15 => c.chsel = v
        16 => c.c3_shape = v
        17 => c.c3_jump = v
        18 => c.t_ip1 = v
        19 => c.t_ip2 = v
        20 => c.t_fcs = v
        _  => c.t_pm = v

// A configuration every check accepts: Main_Mode 2 alone, every allowed channel, LE 1M, RTT of the access address, the mandatory timings; `role` is the
// role of the device that sends it.
fn cfg_ok(id: Int, role: Int) -> CfgPdu
    ll_cs_pdu.CfgPdu { config_id: id, action: 1, chm_lo: ll_cs_pdu.CHM_LO_ALLOWED, chm_hi: ll_cs_pdu.CHM_HI_ALLOWED, chm_rep: 3, main_mode: 2, sub_mode: 0xFF,
                       main_min: 0, main_max: 0, main_rep: 1, mode0_steps: 1, sync_phy: 1, rtt_type: 0, role: role, ipt: 0, chsel: 0, c3_shape: 0, c3_jump: 0,
                       t_ip1: 7, t_ip2: 7, t_fcs: 9, t_pm: 2 }

// The same with the field `f` set to `v`.
fn cfg_set(f: Int, v: Int) -> CfgPdu
    var c = cfg_ok(0, 0)
    cfg_put(var c, f, v)
    c

fn cfg_set2(f: Int, v: Int, g: Int, w: Int) -> CfgPdu
    var c = cfg_ok(0, 0)
    cfg_put(var c, f, v)
    cfg_put(var c, g, w)
    c

// The start fields by number, in the order of LL_CS_REQ.
const S_ID = 0
const S_EVENT = 1
const S_OMIN = 2
const S_OMAX = 3
const S_LEN = 4
const S_EINT = 5
const S_SUBS = 6
const S_SINT = 7
const S_SLEN = 8
const S_PINT = 9
const S_PCNT = 10
const S_ACI = 11
const S_PREF = 12
const S_PHY = 13
const S_DELTA = 14
const S_SNRI = 15
const S_SNRR = 16

fn start_put(var s: StartPdu, f: Int, v: Int)
    match f
        0  => s.config_id = v
        1  => s.conn_event = v
        2  => s.offset_min = v
        3  => s.offset_max = v
        4  => s.max_proc_len = v
        5  => s.event_interval = v
        6  => s.subevents = v
        7  => s.subevent_interval = v
        8  => s.subevent_len = v
        9  => s.proc_interval = v
        10 => s.proc_count = v
        11 => s.aci = v
        12 => s.pref_ant = v
        13 => s.phy = v
        14 => s.pwr_delta = v
        15 => s.snr_i = v
        _  => s.snr_r = v

// A Start every check accepts, in the event 110 of an interval of 30 ms: one procedure of one subevent of 2.5 ms, 1 to 2 ms after the anchor, one antenna each, on LE 1M.
fn start_ok(id: Int) -> StartPdu
    ll_cs_pdu.StartPdu { config_id: id, conn_event: 110, offset_min: 1000, offset_max: 2000, max_proc_len: 100, event_interval: 1, subevents: 1, subevent_interval: 0,
                         subevent_len: 2500, proc_interval: 0, proc_count: 1, aci: 0, pref_ant: 1, phy: 1, pwr_delta: 0, snr_i: 0xF, snr_r: 0xF }

fn start_set(f: Int, v: Int) -> StartPdu
    var s = start_ok(0)
    start_put(var s, f, v)
    s

fn start_set2(f: Int, v: Int, g: Int, w: Int) -> StartPdu
    var s = start_ok(0)
    start_put(var s, f, v)
    start_put(var s, g, w)
    s

// The PDU `p` as the Link Layer queues it: its opcode, and the rejection it carries.
fn op_of(var p: Pdu) -> Int
    ll_data.dpdu_opcode(var p)

fn rejects(var p: Pdu, rejected: Int, code: Int) -> Bool
    ll_data.dpdu_opcode(var p) == ll_data.OP_REJECT_EXT_IND and ll_data.dpdu_byte(var p, 1) == rejected and ll_data.dpdu_byte(var p, 2) == code

// A PDU of opcode `op` and the CtrData `ct` as the peer sends it, the scripted peer's.
fn script(op: Int, ct: [Int]) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_data.ctrl_begin(var p, op)
    for v in ct
        ll_cs_pdu.put8(var p, v)
    ll_data.dpdu_finish(var p)
    p

fn script_reject(op: Int, code: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_data.ctrl_reject_ext(var p, op, code)
    p

fn script_unknown(op: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_data.ctrl_unknown_rsp(var p, op)
    p

// The LL_CS_CAPABILITIES_REQ of a new Central with the record `c`, in `out`.
fn caps_req(var c: CapPdu, var out: Pdu)
    var cen = fresh()
    var e = env(true, 10)
    test.assert_eq(ll_cs_proc.begin_capabilities(var cen, var e, var c, var out), 0)

// Run Security Start between the two ends: the Central begins, the random octets of both come, the PDUs cross.
fn secure(var cen: Cs, var per: Cs)
    var caps = caps_full()
    var ec = env(true, 10)
    var ep = env(false, 10)
    test.assert_eq(ll_cs_proc.begin_security(var cen, var ec), 0)
    var a = ll_pdu.pdu_new()
    var b = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.feed_random(var cen, var ec, rnd12(1), var a), ll_cs_proc.R_NONE)
    test.assert_eq(ll_cs_proc.feed_random(var cen, var ec, rnd12(2), var a), ll_cs_proc.R_SEND)
    test.assert_eq(op_of(var a), ll_cs.OP_CS_SEC_REQ)
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var a, var b), ll_cs_proc.R_NONE)
    test.assert_eq(ll_cs_proc.feed_random(var per, var ep, rnd12(3), var b), ll_cs_proc.R_NONE)
    test.assert_eq(ll_cs_proc.feed_random(var per, var ep, rnd12(4), var b), ll_cs_proc.R_SEND)
    test.assert_eq(op_of(var b), ll_cs.OP_CS_SEC_RSP)
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var caps, var b, var a), ll_cs_proc.R_NONE)

// Run the Capabilities Exchange with the Central asking: both ends hold the other's record.
fn exchange(var cen: Cs, var per: Cs)
    var caps = caps_full()
    var ec = env(true, 10)
    var ep = env(false, 10)
    var a = ll_pdu.pdu_new()
    var b = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.begin_capabilities(var cen, var ec, var caps, var a), 0)
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var a, var b), ll_cs_proc.R_SEND)
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var caps, var b, var a), ll_cs_proc.R_NONE)

// Run the Configuration with the Central sending the request for the configuration `id` in `role`.
fn configure(var cen: Cs, var per: Cs, id: Int, role: Int)
    var caps = caps_full()
    var ec = env(true, 10)
    var ep = env(false, 10)
    var a = ll_pdu.pdu_new()
    var b = ll_pdu.pdu_new()
    var c = cfg_ok(id, role)
    test.assert_eq(ll_cs_proc.begin_config(var cen, var ec, var caps, var c, false, var a), 0)
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var a, var b), ll_cs_proc.R_SEND)
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var caps, var b, var a), ll_cs_proc.R_NONE)

// A table of the radio of the answering end: value `i` is `3 i - 100` in units of 1/32 ppm.
fn fae_tbl() -> Vec[u8; 72]
    var t: Vec[u8; 72] = Vec.new()
    for i in 0..72
        let _p = t.push(((i * 3 - 100) & 0xFF) as u8)
    t

// Run the FAE Table Request: the end `asker` asks the other.
fn fae_table(var asker: Cs, var other: Cs, asker_central: Bool)
    var caps = caps_full()
    var ea = env(asker_central, 10)
    var eo = env(not asker_central, 10)
    var a = ll_pdu.pdu_new()
    var b = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.begin_fae(var asker, var ea, var a), 0)
    test.assert_eq(ll_cs_proc.receive(var other, var eo, var caps, var a, var b), ll_cs_proc.R_FAE)
    var table = fae_tbl()
    test.assert_eq(ll_cs_proc.fae_rsp(var eo, var table, var b), ll_cs_proc.R_SEND)
    test.assert_eq(ll_cs_proc.receive(var asker, var ea, var caps, var b, var a), ll_cs_proc.R_NONE)

// Two ends that have done everything a Start needs: secured, capabilities exchanged, the configuration 0 created by the Central in `role` (0 the initiator), and
// the FAE table of the reflector known to the initiator.  The events owed to the Hosts are taken.
fn ready(var cen: Cs, var per: Cs, role: Int)
    secure(var cen, var per)
    exchange(var cen, var per)
    configure(var cen, var per, 0, role)
    if role == 0
        fae_table(var cen, var per, true)
    else
        fae_table(var per, var cen, false)
    cen.owed = 0
    per.owed = 0

// The environment of each end for the Start.
fn envs_central() -> ll_cs_proc.Env
    env(true, 20)

fn envs_peripheral() -> ll_cs_proc.Env
    env(false, 20)

// ── Security Start ──────────────────────────────────────────────────

@test
fn test_security_start_joins_the_parts_of_both_ends_and_starts_the_counter_at_zero()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    secure(var cen, var per)
    test.assert(cen.secured)
    test.assert(per.secured)
    test.assert(cen.fresh)
    test.assert(per.fresh)
    test.assert_eq(cen.proc_count, 0)
    test.assert_eq(per.proc_count, 0)
    // CS_IV is 16 octets, the Peripheral's 8 above the Central's 8; the Central's random octets 0 to 7 are 1 to 8, the Peripheral's are 3 to 10.
    for k in 0..8
        test.assert_eq(ll_cs_proc.cs_iv(var cen, k), 1 + k)
        test.assert_eq(ll_cs_proc.cs_iv(var per, k), 1 + k)
        test.assert_eq(ll_cs_proc.cs_iv(var cen, 8 + k), 3 + k)
        test.assert_eq(ll_cs_proc.cs_iv(var per, 8 + k), 3 + k)
    // CS_IN is 8 octets: random octets 8 to 11 of each end.
    for k in 0..4
        test.assert_eq(ll_cs_proc.cs_in(var cen, k), 9 + k)
        test.assert_eq(ll_cs_proc.cs_in(var per, k), 9 + k)
        test.assert_eq(ll_cs_proc.cs_in(var cen, 4 + k), 11 + k)
        test.assert_eq(ll_cs_proc.cs_in(var per, 4 + k), 11 + k)
    // CS_PV is 16 octets from the random octets 12 to 19, which the second 12 octets of each end give: the Central's start at 2, the Peripheral's at 4.
    for k in 0..8
        test.assert_eq(ll_cs_proc.cs_pv(var cen, k), 2 + k)
        test.assert_eq(ll_cs_proc.cs_pv(var per, k), 2 + k)
        test.assert_eq(ll_cs_proc.cs_pv(var cen, 8 + k), 4 + k)
        test.assert_eq(ll_cs_proc.cs_pv(var per, 8 + k), 4 + k)

@test
fn test_both_ends_owe_the_host_the_security_event_when_the_procedure_completes()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    secure(var cen, var per)
    test.assert(ll_cs_proc.take_owed(var cen, ll_cs_proc.OWED_SEC))
    test.assert(ll_cs_proc.take_owed(var per, ll_cs_proc.OWED_SEC))
    test.assert_eq(cen.st_sec, 0)
    test.assert_eq(per.st_sec, 0)
    test.assert(not ll_cs_proc.take_owed(var cen, ll_cs_proc.OWED_SEC))
    test.assert_eq(cen.wait, ll_cs_proc.W_NONE)
    test.assert_eq(per.wait, ll_cs_proc.W_NONE)

@test
fn test_the_central_sends_the_pdu_with_its_20_octets_after_the_last_random_octets()
    if skip()
        return
    var cen = fresh()
    var e = env(true, 10)
    var a = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.begin_security(var cen, var e), 0)
    test.assert(ll_cs_proc.wants_random(var cen))
    test.assert_eq(cen.wait, ll_cs_proc.W_RND_C)
    test.assert_eq(ll_cs_proc.feed_random(var cen, var e, rnd12(0x40), var a), ll_cs_proc.R_NONE)
    test.assert(ll_cs_proc.wants_random(var cen))
    test.assert_eq(ll_cs_proc.feed_random(var cen, var e, rnd12(0x80), var a), ll_cs_proc.R_SEND)
    test.assert(not ll_cs_proc.wants_random(var cen))
    test.assert_eq(cen.wait, ll_cs_proc.W_SEC)
    test.assert_eq(cen.t0, 10)
    test.assert_eq(ll_data.dpdu_len(var a), 21)
    for k in 0..12
        test.assert_eq(ll_cs_pdu.ct(var a, k), 0x40 + k)
    for k in 0..8
        test.assert_eq(ll_cs_pdu.ct(var a, 12 + k), 0x80 + k)

@test
fn test_random_octets_are_taken_only_while_a_procedure_waits_for_them()
    if skip()
        return
    var cen = fresh()
    var e = env(true, 10)
    var a = ll_pdu.pdu_new()
    test.assert(not ll_cs_proc.wants_random(var cen))
    test.assert_eq(ll_cs_proc.feed_random(var cen, var e, rnd12(1), var a), ll_cs_proc.R_NONE)
    test.assert_eq(cen.rnd_n, 0)

@test
fn test_the_host_cannot_start_security_without_the_feature_set_or_the_peer_or_the_encryption()
    if skip()
        return
    var cen = fresh()
    var e = env(true, 10)
    var none = fresh_no_host()
    test.assert_eq(ll_cs_proc.begin_security(var none, var e), ll_cs_proc.E_DISALLOWED)
    var e1 = envf(true, E_NOPEER, 10)
    test.assert_eq(ll_cs_proc.begin_security(var cen, var e1), ll_cs_proc.E_UNSUPPORTED_REMOTE)
    var e2 = envf(true, E_PLAIN, 10)
    test.assert_eq(ll_cs_proc.begin_security(var cen, var e2), ll_cs_proc.E_INSUFFICIENT_SECURITY)
    test.assert_eq(cen.wait, ll_cs_proc.W_NONE)

@test
fn test_a_peripheral_cannot_start_security_and_a_central_cannot_start_it_twice()
    if skip()
        return
    var per = fresh()
    var ep = env(false, 10)
    test.assert_eq(ll_cs_proc.begin_security(var per, var ep), ll_cs_proc.E_DISALLOWED)
    var cen = fresh()
    var ec = env(true, 10)
    test.assert_eq(ll_cs_proc.begin_security(var cen, var ec), 0)
    test.assert_eq(ll_cs_proc.begin_security(var cen, var ec), ll_cs_proc.E_DISALLOWED)

@test
fn test_security_cannot_start_while_cs_procedures_are_outstanding()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    ready(var cen, var per, 0)
    var ec = env(true, 20)
    var a = ll_pdu.pdu_new()
    var s = start_ok(0)
    var caps = caps_full()
    test.assert_eq(ll_cs_proc.begin_start(var cen, var ec, var caps, var s, var a), 0)
    var ep = env(false, 20)
    var b = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var a, var b), ll_cs_proc.R_SEND)
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var caps, var b, var a), ll_cs_proc.R_SEND)
    test.assert(cen.run_open)
    test.assert_eq(ll_cs_proc.begin_security(var cen, var ec), ll_cs_proc.E_DISALLOWED)

@test
fn test_a_peripheral_refuses_a_security_request_without_the_feature_set_or_the_encryption()
    if skip()
        return
    var caps = caps_full()
    var per = fresh_no_host()
    var cen = fresh()
    var ec = env(true, 10)
    var a = ll_pdu.pdu_new()
    var b = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.begin_security(var cen, var ec), 0)
    let _x = ll_cs_proc.feed_random(var cen, var ec, rnd12(1), var a)
    test.assert_eq(ll_cs_proc.feed_random(var cen, var ec, rnd12(2), var a), ll_cs_proc.R_SEND)
    var ep = env(false, 10)
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var a, var b), ll_cs_proc.R_SEND)
