@test
fn test_a_start_the_peer_sends_while_this_ends_own_is_out_is_rejected_by_the_central_and_taken_by_the_peripheral()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    ready(var cen, var per, 0)
    var caps = caps_full()
    var ec = env(true, 20)
    var ep = env(false, 20)
    var sc = start_ok(0)
    var sp = start_set(S_SLEN, 2000)
    var a = ll_pdu.pdu_new()
    var b = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.begin_start(var cen, var ec, var caps, var sc, var a), 0)
    test.assert_eq(ll_cs_proc.begin_start(var per, var ep, var caps, var sp, var b), 0)
    // The Central rejects the Peripheral's request and goes on.
    var rej = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var caps, var b, var rej), ll_cs_proc.R_SEND)
    test.assert(rejects(var rej, ll_cs.OP_CS_REQ, ll_cs_proc.E_COLLISION))
    test.assert_eq(cen.wait, ll_cs_proc.W_START)
    test.assert(cen.start_host)
    // The Peripheral's own request ends with the collision error, which its Host is owed, and the Central's is answered.
    var rsp = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var a, var rsp), ll_cs_proc.R_SEND)
    test.assert_eq(op_of(var rsp), ll_cs.OP_CS_RSP)
    test.assert_eq(per.st_proc, ll_cs_proc.E_COLLISION)
    test.assert(ll_cs_proc.take_owed(var per, ll_cs_proc.OWED_PROC))
    test.assert_eq(per.yield_op, ll_cs.OP_CS_REQ)
    test.assert_eq(per.wait, ll_cs_proc.W_START)
    // The Central's rejection of the Peripheral's request is not an answer to the Central's own.
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var rej, var b), ll_cs_proc.R_NONE)
    test.assert_eq(per.yield_op, 0)
    test.assert_eq(per.wait, ll_cs_proc.W_START)
    test.assert_eq(per.owed, 0)
    // The Central's procedure completes.
    var ind = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var caps, var rsp, var ind), ll_cs_proc.R_SEND)
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var ind, var b), ll_cs_proc.R_NONE)
    test.assert(cen.run_open)
    test.assert(per.run_open)
    test.assert_eq(run_of(var per).subevent_len, 2500)

@test
fn test_a_request_to_a_peripheral_that_waits_for_the_indication_after_its_own_answer_is_a_collision_too()
