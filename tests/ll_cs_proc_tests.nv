    test.assert_eq(ll_cs_proc.cache_caps(var cs, var caps, var scratch), 0)
    var cfg = cfg_ok(0, 0)
    test.assert_eq(ll_cs_proc.begin_config(var cs, var e, var caps, var cfg, true, var out), 0)
    test.assert_eq(ll_cs_proc.cache_fae(var cs, 0, 1, false), ll_cs_proc.E_DISALLOWED)

// ── Start ───────────────────────────────────────────────────────────

@test
fn test_a_start_the_central_begins_runs_request_response_indication_and_both_ends_hold_the_same_parameters()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    ready(var cen, var per, 0)
    var s = start_set2(S_DELTA, -5, S_PCNT, 7)
    start_put(var s, S_PINT, 3)
    var caps = caps_full()
    var ec = env(true, 20)
    var ep = env(false, 20)
    var a = ll_pdu.pdu_new()
    var b = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.begin_start(var cen, var ec, var caps, var s, var a), 0)
    test.assert_eq(op_of(var a), ll_cs.OP_CS_REQ)
    test.assert_eq(ll_data.dpdu_len(var a), 29)
    test.assert_eq(cen.wait, ll_cs_proc.W_START)
    test.assert(cen.start_host)
    test.assert_eq(cen.t0, 20)
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var a, var b), ll_cs_proc.R_SEND)
    test.assert_eq(op_of(var b), ll_cs.OP_CS_RSP)
    test.assert_eq(ll_data.dpdu_len(var b), 22)
    test.assert_eq(per.wait, ll_cs_proc.W_START)
    test.assert(not per.start_host)
    var rsp = ll_cs_pdu.start_new()
    test.assert(ll_cs_pdu.get_rsp(var b, var rsp))
    test.assert_eq(rsp.config_id, 0)
    // The request's window is 1000 to 2000: the Peripheral answers with the end of it nearest to 3 ms.
    test.assert_eq(rsp.offset_min, 2000)
    test.assert_eq(rsp.offset_max, 2000)
    test.assert_eq(rsp.subevent_len, 2500)
    test.assert_eq(rsp.pwr_delta, 0)
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var caps, var b, var a), ll_cs_proc.R_SEND)
    test.assert_eq(op_of(var a), ll_cs.OP_CS_IND)
    test.assert_eq(ll_data.dpdu_len(var a), 19)
    var ind = ll_cs_pdu.start_new()
    test.assert(ll_cs_pdu.get_ind(var a, var ind))
    test.assert_eq(ind.conn_event, 110)
    // The window of the request is 1000 to 2000 microseconds: the Central picks the end of it nearest to 3 milliseconds.
    test.assert_eq(ind.offset_min, 2000)
    test.assert_eq(ind.pwr_delta, -5)
    test.assert_eq(ind.phy, 1)
    test.assert(cen.run_open)
    test.assert_eq(cen.wait, ll_cs_proc.W_NONE)
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var a, var b), ll_cs_proc.R_NONE)
    test.assert(per.run_open)
    test.assert_eq(per.wait, ll_cs_proc.W_NONE)
    // Both ends read the same parameters: the request's, with the indication's over them.
    var rc = run_of(var cen)
    var rp = run_of(var per)
    for pair in [[rc.config_id, rp.config_id], [rc.conn_event, rp.conn_event], [rc.offset_min, rp.offset_min], [rc.event_interval, rp.event_interval],
                 [rc.subevents, rp.subevents], [rc.subevent_interval, rp.subevent_interval], [rc.subevent_len, rp.subevent_len], [rc.max_proc_len, rp.max_proc_len],
                 [rc.proc_interval, rp.proc_interval], [rc.proc_count, rp.proc_count], [rc.aci, rp.aci], [rc.pref_ant, rp.pref_ant], [rc.phy, rp.phy],
                 [rc.pwr_delta, rp.pwr_delta]]
        test.assert_eq(pair[0], pair[1])
    test.assert_eq(rc.offset_min, 2000)
    test.assert_eq(rc.offset_max, 2000)
    test.assert_eq(rc.proc_count, 7)
    test.assert_eq(rc.proc_interval, 3)
    test.assert_eq(rc.pwr_delta, -5)
    // The series is described to the instances that follow.
    test.assert_eq(cen.series_cfg, 0)
    test.assert_eq(cen.series_n, 7)
    test.assert_eq(cen.series_start, 0)
    test.assert_eq(per.series_n, 7)
    // Both Hosts are owed the answer: the one that asked and the one that was asked.
    test.assert(ll_cs_proc.take_owed(var cen, ll_cs_proc.OWED_PROC))
    test.assert(ll_cs_proc.take_owed(var per, ll_cs_proc.OWED_PROC))
    test.assert_eq(cen.st_proc, 0)
    test.assert_eq(per.st_proc, 0)

@test
fn test_the_central_picks_the_offset_of_the_indication_3_milliseconds_after_the_anchor_when_the_window_allows()
    // A window that holds 3 milliseconds: 3 milliseconds.  One wholly under it: its end.  One wholly over it: its start.
    test.assert_eq(ll_cs_proc.pick_offset(1000, 5000), 3000)
    test.assert_eq(ll_cs_proc.pick_offset(3000, 3000), 3000)
    test.assert_eq(ll_cs_proc.pick_offset(500, 3000), 3000)
    test.assert_eq(ll_cs_proc.pick_offset(1000, 2999), 2999)
    test.assert_eq(ll_cs_proc.pick_offset(500, 500), 500)
    test.assert_eq(ll_cs_proc.pick_offset(3001, 9000), 3001)
    test.assert_eq(ll_cs_proc.pick_offset(8000, 8000), 8000)

@test
fn test_a_start_the_peripheral_begins_is_answered_by_the_central_with_the_indication_alone()
