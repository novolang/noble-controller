    test.assert_eq(config_status(var cen, var e, var bad, false), ll_cs_proc.E_INVALID_PARAMS)
    var lacks = cfg_set(C_PHY, 4)
    test.assert_eq(config_status(var cen, var e, var lacks, false), ll_cs_proc.E_UNSUPPORTED_FEATURE)
    var unknown = cfg_set(C_ACTION, 0)
    test.assert_eq(config_status(var cen, var e, var unknown, false), ll_cs_proc.E_INVALID_PARAMS)
    test.assert_eq(cen.wait, ll_cs_proc.W_NONE)
    test.assert(not ll_cs_proc.cfg_used(var cen, 0))

@test
fn test_a_configuration_the_start_is_using_cannot_be_changed_or_removed()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    ready(var cen, var per, 0)
    var s0 = start_ok(0)
    run_start(var cen, var per, true, var s0)
    var e = env(true, 30)
