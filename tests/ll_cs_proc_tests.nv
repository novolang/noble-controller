@test
fn test_an_indication_the_response_does_not_allow_ends_the_start_without_an_answer()
    if skip()
        return
    var caps = caps_full()
    var out = ll_pdu.pdu_new()
    for pair in [[S_OMIN, 999], [S_OMIN, 2001], [S_SLEN, 2501], [S_EVENT, 109], [S_ID, 1], [S_ACI, 8], [S_EINT, 0], [S_SUBS, 0]]
        for host in [true, false]
            var cen = fresh()
            var per = fresh()
            ready(var cen, var per, 1)
            var ec = env(true, 20)
            var ep = env(false, 20)
            var s = start_ok(0)
            var a = ll_pdu.pdu_new()
            if host
                test.assert_eq(ll_cs_proc.begin_start(var per, var ep, var caps, var s, var a), 0)
            else
                test.assert_eq(ll_cs_proc.begin_start(var cen, var ec, var caps, var s, var a), 0)
                var b = ll_pdu.pdu_new()
                test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var a, var b), ll_cs_proc.R_SEND)
            var answer = start_set(pair[0], pair[1])
            var ind = ll_pdu.pdu_new()
            ll_cs_pdu.put_ind(var ind, var answer)
            test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var ind, var out), ll_cs_proc.R_NONE)
            test.assert_eq(per.wait, ll_cs_proc.W_NONE)
            test.assert(not per.run_open)
            // Only a Start the Host asked for is reported when it fails.
            if host
                test.assert(ll_cs_proc.take_owed(var per, ll_cs_proc.OWED_PROC))
                test.assert_eq(per.st_proc, ll_cs_proc.E_UNSUPPORTED_LL)
            else
                test.assert_eq(per.owed, 0)

@test
fn test_a_start_the_peer_refuses_ends_with_its_code_and_tells_only_the_host_that_asked()
    if skip()
        return
    var caps = caps_full()
    var out = ll_pdu.pdu_new()
    var cen = fresh()
    var per = fresh()
    ready(var cen, var per, 0)
    var ec = env(true, 20)
    var ep = env(false, 20)
    var s = start_ok(0)
    var a = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.begin_start(var cen, var ec, var caps, var s, var a), 0)
    var r = script_reject(ll_cs.OP_CS_REQ, ll_cs_proc.E_DISALLOWED)
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var caps, var r, var out), ll_cs_proc.R_NONE)
    test.assert_eq(cen.wait, ll_cs_proc.W_NONE)
    test.assert(ll_cs_proc.take_owed(var cen, ll_cs_proc.OWED_PROC))
    test.assert_eq(cen.st_proc, ll_cs_proc.E_DISALLOWED)
    test.assert(not cen.run_open)
    test.assert_eq(ll_cs_proc.begin_start(var cen, var ec, var caps, var s, var a), 0)
    var u = script_unknown(ll_cs.OP_CS_REQ)
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var caps, var u, var out), ll_cs_proc.R_NONE)
    test.assert_eq(cen.st_proc, ll_cs_proc.E_UNSUPPORTED_REMOTE)
    // The Peripheral that answered and waits for the indication takes the Central's refusal of its answer, and its Host was not told of the Start.
    var cen2 = fresh()
    var per2 = fresh()
    ready(var cen2, var per2, 0)
    var b = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.begin_start(var cen2, var ec, var caps, var s, var a), 0)
    test.assert_eq(ll_cs_proc.receive(var per2, var ep, var caps, var a, var b), ll_cs_proc.R_SEND)
    var r2 = script_reject(ll_cs.OP_CS_RSP, ll_cs_proc.E_UNSUPPORTED_LL)
    test.assert_eq(ll_cs_proc.receive(var per2, var ep, var caps, var r2, var out), ll_cs_proc.R_NONE)
    test.assert_eq(per2.wait, ll_cs_proc.W_NONE)
    test.assert_eq(per2.owed, 0)
    test.assert(not per2.run_open)

@test
fn test_the_start_unanswered_for_40_seconds_ends_the_connection_at_either_end()
    if skip()
        return
    var caps = caps_full()
    var cen = fresh()
    var per = fresh()
    ready(var cen, var per, 0)
    var ec = env(true, 5000)
    var ep = env(false, 5000)
    var s = start_ok(0)
    var a = ll_pdu.pdu_new()
    var b = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.begin_start(var cen, var ec, var caps, var s, var a), 0)
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var a, var b), ll_cs_proc.R_SEND)
    var e1 = env(true, 5000 + 40000000)
    var e2 = env(true, 5000 + 40000001)
    test.assert_eq(ll_cs_proc.poll(var cen, var e1), 0)
    test.assert_eq(ll_cs_proc.poll(var per, var e1), 0)
    test.assert_eq(ll_cs_proc.poll(var cen, var e2), ll_cs_proc.E_RESPONSE_TIMEOUT)
    test.assert_eq(ll_cs_proc.poll(var per, var e2), ll_cs_proc.E_RESPONSE_TIMEOUT)
    test.assert_eq(cen.st_proc, ll_cs_proc.E_RESPONSE_TIMEOUT)
    test.assert(ll_cs_proc.take_owed(var cen, ll_cs_proc.OWED_PROC))
    test.assert_eq(per.owed, 0)

