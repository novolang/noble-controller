@test
fn test_a_map_the_host_gives_is_refused_when_it_names_a_channel_that_is_not_allowed_or_too_few()
    if skip()
        return
    var cen = fresh()
    var ec = env(true, 30)
    var a = ll_pdu.pdu_new()
    // 15 allowed channels are enough, 14 are not, and each of the reserved channels fails.
    test.assert_eq(ll_cs_proc.begin_channel_map(var cen, var ec, 0x1FFFC, 0, 200, var a), 0)
    test.assert_eq(ll_cs_proc.begin_channel_map(var cen, var ec, 0xFFFC, 0, 200, var a), ll_cs_proc.E_INVALID_PARAMS)
    for ch in [0, 1, 23, 24, 25]
        test.assert_eq(ll_cs_proc.begin_channel_map(var cen, var ec, ll_cs_pdu.CHM_LO_ALLOWED | (1 << ch), ll_cs_pdu.CHM_HI_ALLOWED, 200, var a), ll_cs_proc.E_INVALID_PARAMS)
    for ch in [77, 78, 79]
        test.assert_eq(ll_cs_proc.begin_channel_map(var cen, var ec, ll_cs_pdu.CHM_LO_ALLOWED, ll_cs_pdu.CHM_HI_ALLOWED | (1 << (ch - 40)), 200, var a), ll_cs_proc.E_INVALID_PARAMS)
    test.assert_eq(ll_cs_proc.begin_channel_map(var cen, var ec, 0, 0, 200, var a), ll_cs_proc.E_INVALID_PARAMS)

@test
fn test_a_map_the_host_gives_waits_for_the_basics_and_for_the_acl_procedures_with_an_instant()
    if skip()
        return
    var a = ll_pdu.pdu_new()
    var none = fresh_no_host()
    var e = env(true, 30)
    test.assert_eq(ll_cs_proc.begin_channel_map(var none, var e, 0x7FFFFC, 0, 200, var a), ll_cs_proc.E_DISALLOWED)
    var cen = fresh()
    var e1 = envf(true, E_NOPEER, 30)
    var e2 = envf(true, E_PLAIN, 30)
    var e3 = envf(true, E_BUSY, 30)
    test.assert_eq(ll_cs_proc.begin_channel_map(var cen, var e1, 0x7FFFFC, 0, 200, var a), ll_cs_proc.E_UNSUPPORTED_REMOTE)
    test.assert_eq(ll_cs_proc.begin_channel_map(var cen, var e2, 0x7FFFFC, 0, 200, var a), ll_cs_proc.E_INSUFFICIENT_SECURITY)
    test.assert_eq(ll_cs_proc.begin_channel_map(var cen, var e3, 0x7FFFFC, 0, 200, var a), ll_cs_proc.E_DISALLOWED)
    test.assert(not cen.pend_chm)
    test.assert_eq(cen.chm_lo, ll_cs_pdu.CHM_LO_ALLOWED)

@test
fn test_a_map_that_arrives_on_a_link_that_is_not_encrypted_or_of_the_wrong_length_changes_nothing()
    if skip()
        return
    var per = fresh()
    var caps = caps_full()
    var out = ll_pdu.pdu_new()
    var m = ll_cs_pdu.chm_new(0x7FFFFC, 0, 200)
    var upd = ll_pdu.pdu_new()
    ll_cs_pdu.put_channel_map(var upd, var m)
    var plain = envf(false, E_PLAIN, 30)
    test.assert_eq(ll_cs_proc.receive(var per, var plain, var caps, var upd, var out), ll_cs_proc.R_NONE)
    test.assert_eq(per.chm_lo, ll_cs_pdu.CHM_LO_ALLOWED)
    var ep = env(false, 30)
    upd.b[1] = 12
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var upd, var out), ll_cs_proc.R_NONE)
    test.assert_eq(per.chm_lo, ll_cs_pdu.CHM_LO_ALLOWED)

@test
fn test_the_filtered_map_is_the_configurations_and_the_updates_and_a_new_connection_starts_with_every_allowed_channel()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    secure(var cen, var per)
    exchange(var cen, var per)
    var cfg = cfg_set2(C_LO, 0x7FFFFC, C_HI, 0xFF)
    configure_cfg(var cen, var per, var cfg)
    test.assert_eq(ll_cs_proc.cfg_map_lo(var cen, 0), 0x7FFFFC)
    test.assert_eq(ll_cs_proc.cfg_map_hi(var cen, 0), 0xFF)
    test.assert_eq(ll_cs_proc.cfg_map_lo(var per, 0), 0x7FFFFC)
    test.assert_eq(cen.chm_lo, ll_cs_pdu.CHM_LO_ALLOWED)
    test.assert_eq(ll_cs_proc.filtered_lo(var cen, 0, 100), 0x7FFFFC)
    test.assert_eq(ll_cs_proc.filtered_hi(var cen, 0, 100), 0xFF)
    var a = ll_pdu.pdu_new()
    var ec = env(true, 30)
    test.assert_eq(ll_cs_proc.begin_channel_map(var cen, var ec, 0xFFFC, 0xF0, 200, var a), 0)
    test.assert_eq(ll_cs_proc.filtered_lo(var cen, 0, 100), 0xFFFC)
    test.assert_eq(ll_cs_proc.filtered_hi(var cen, 0, 100), 0xF0)
    ll_cs_proc.cs_reset(var cen)
    test.assert_eq(cen.chm_lo, ll_cs_pdu.CHM_LO_ALLOWED)
    test.assert_eq(cen.chm_hi, ll_cs_pdu.CHM_HI_ALLOWED)

// ── Packets too short for the answer ────────────────────────────────

// The environment of an end whose packets carry 3 octets of payload at most, so that no PDU of Channel Sounding but a rejection fits.
fn env_tiny(central: Bool) -> ll_cs_proc.Env
    ll_cs_proc.Env { central: central, encrypted: true, peer_cs: true, peer_v2: true, ev_count: 100, interval_us: 30000, now: 20, busy: false, phy: 1, managed: 0xF,
                     sec_ok: true, max_tx: 3 }

@test
fn test_an_indication_that_does_not_fit_a_packet_is_refused_as_limited_resources_and_starts_nothing()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    ready(var cen, var per, 1)
    var caps = caps_full()
    var ep = env(false, 20)
    var s = start_ok(0)
    var a = ll_pdu.pdu_new()
    var out = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.begin_start(var per, var ep, var caps, var s, var a), 0)
    var tiny = env_tiny(true)
    test.assert_eq(ll_cs_proc.receive(var cen, var tiny, var caps, var a, var out), ll_cs_proc.R_SEND)
    test.assert(rejects(var out, ll_cs.OP_CS_REQ, ll_cs_proc.E_LIMITED))
    test.assert(not cen.run_open)

@test
fn test_a_response_that_does_not_fit_a_packet_is_refused_as_limited_resources_and_the_peripheral_waits_for_nothing()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    ready(var cen, var per, 0)
    var caps = caps_full()
    var ec = env(true, 20)
    var s = start_ok(0)
    var a = ll_pdu.pdu_new()
    var out = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.begin_start(var cen, var ec, var caps, var s, var a), 0)
    var tiny = env_tiny(false)
    test.assert_eq(ll_cs_proc.receive(var per, var tiny, var caps, var a, var out), ll_cs_proc.R_SEND)
    test.assert(rejects(var out, ll_cs.OP_CS_REQ, ll_cs_proc.E_LIMITED))
    test.assert_eq(per.wait, ll_cs_proc.W_NONE)

@test
fn test_the_central_whose_indication_does_not_fit_gives_the_start_up_and_tells_its_host()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    ready(var cen, var per, 0)
    var caps = caps_full()
    var ec = env(true, 20)
    var ep = env(false, 20)
    var s = start_ok(0)
    var a = ll_pdu.pdu_new()
    var b = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.begin_start(var cen, var ec, var caps, var s, var a), 0)
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var a, var b), ll_cs_proc.R_SEND)
    var tiny = env_tiny(true)
    test.assert_eq(ll_cs_proc.receive(var cen, var tiny, var caps, var b, var a), ll_cs_proc.R_SEND)
    test.assert(rejects(var a, ll_cs.OP_CS_RSP, ll_cs_proc.E_LIMITED))
    test.assert_eq(cen.wait, ll_cs_proc.W_NONE)
    test.assert(not cen.run_open)
    test.assert(ll_cs_proc.take_owed(var cen, ll_cs_proc.OWED_PROC))
    test.assert_eq(cen.st_proc, ll_cs_proc.E_LIMITED)

@test
fn test_a_termination_and_a_map_that_do_not_fit_a_packet_are_not_sent()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    running(var cen, var per, 0)
    var tiny = env_tiny(true)
    var a = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.begin_terminate(var cen, var tiny, 0, 0x13, var a), ll_cs_proc.E_DISALLOWED)
    test.assert_eq(cen.wait, ll_cs_proc.W_NONE)
    test.assert_eq(ll_cs_proc.begin_channel_map(var cen, var tiny, 0x7FFFFC, 0, 200, var a), ll_cs_proc.E_DISALLOWED)
    test.assert(not cen.pend_chm)
    // The termination a past instant asks for is not sent either, and the map applies.
    var caps = caps_full()
    var tp = env_tiny(false)
    var out = ll_pdu.pdu_new()
    var m = ll_cs_pdu.chm_new(0x7FFFFC, 0x1, 90)
    var upd = ll_pdu.pdu_new()
    ll_cs_pdu.put_channel_map(var upd, var m)
    test.assert_eq(ll_cs_proc.receive(var per, var tp, var caps, var upd, var out), ll_cs_proc.R_NONE)
    test.assert_eq(per.wait, ll_cs_proc.W_NONE)
    test.assert(per.pend_chm)

@test
fn test_a_configuration_that_does_not_fit_a_packet_is_not_asked_for()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    exchange(var cen, var per)
    var e = envf(true, E_SMALL, 10)
    var good = cfg_ok(0, 0)
    test.assert_eq(config_status(var cen, var e, var good, false), ll_cs_proc.E_DISALLOWED)
    test.assert_eq(cen.wait, ll_cs_proc.W_NONE)

// ── A configuration the Host keeps to itself ────────────────────────

@test
fn test_a_configuration_without_the_peer_is_kept_and_removed_at_this_end_alone()
    if skip()
        return
    var cs = fresh()
    var e = env(true, 10)
    var caps = caps_full()
    var out = ll_pdu.pdu_new()
    var c = cfg_ok(0, 1)
    test.assert_eq(ll_cs_proc.begin_config(var cs, var e, var caps, var c, true, var out), 0)
    test.assert(ll_cs_proc.cfg_used(var cs, 0))
    test.assert(ll_cs_proc.cfg_mine(var cs, 0))
    test.assert_eq(ll_cs_proc.cfg_role(var cs, 0), 1)
    test.assert_eq(cs.wait, ll_cs_proc.W_NONE)
    test.assert(ll_cs_proc.take_owed(var cs, ll_cs_proc.OWED_CFG))
    test.assert_eq(cs.ev_cfg, 0)
    test.assert_eq(cs.ev_act, 1)
    var rm = cfg_set(C_ACTION, 0)
    test.assert_eq(ll_cs_proc.begin_config(var cs, var e, var caps, var rm, true, var out), 0)
    test.assert(not ll_cs_proc.cfg_used(var cs, 0))
    test.assert_eq(cs.ev_act, 0)
    test.assert(ll_cs_proc.take_owed(var cs, ll_cs_proc.OWED_CFG))
    // A removal of one that is not there is refused here as it is with the peer.
    test.assert_eq(ll_cs_proc.begin_config(var cs, var e, var caps, var rm, true, var out), ll_cs_proc.E_INVALID_PARAMS)

// ── What a handler does with a PDU of the wrong length ──────────────

@test
fn test_each_handler_ignores_a_pdu_of_the_wrong_length_when_it_is_called_directly()
    if skip()
        return
    var caps = caps_full()
    var out = ll_pdu.pdu_new()
    var short = script(ll_cs.OP_CS_REQ, [1, 2])
    var cen = fresh()
    var per = fresh()
    var ec = env(true, 10)
    var ep = env(false, 10)
    test.assert_eq(ll_cs_proc.rx_sec_req(var per, var ep, var short, var out), ll_cs_proc.R_NONE)
    test.assert_eq(ll_cs_proc.rx_sec_rsp(var cen, var ec, var short), ll_cs_proc.R_NONE)
    test.assert_eq(ll_cs_proc.rx_caps_req(var per, var ep, var caps, var short, var out), ll_cs_proc.R_NONE)
    test.assert_eq(ll_cs_proc.rx_config_req(var per, var ep, var caps, var short, var out), ll_cs_proc.R_NONE)
    test.assert_eq(ll_cs_proc.rx_req(var per, var ep, var caps, var short, var out), ll_cs_proc.R_NONE)
    test.assert_eq(ll_cs_proc.rx_terminate_req(var per, var ep, var short, var out), ll_cs_proc.R_NONE)
    test.assert_eq(ll_cs_proc.rx_channel_map(var per, var ep, var short, var out), ll_cs_proc.R_NONE)
    // The responses are taken only by an end that waits for them.
    var asker = fresh()
    var e = env(true, 10)
    var a = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.begin_capabilities(var asker, var e, var caps, var a), 0)
    test.assert_eq(ll_cs_proc.rx_caps_rsp(var asker, var short), ll_cs_proc.R_NONE)
    test.assert_eq(asker.wait, ll_cs_proc.W_CAP)
    var cen2 = fresh()
    var per2 = fresh()
    exchange(var cen2, var per2)
    test.assert_eq(ll_cs_proc.begin_fae(var cen2, var e, var a), 0)
    test.assert_eq(ll_cs_proc.rx_fae_rsp(var cen2, var short), ll_cs_proc.R_NONE)

// ── Helpers and tables ──────────────────────────────────────────────

@test
fn test_the_peers_record_is_read_back_as_the_version_it_came_in()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    var caps = caps_full()
    var ec = envf(true, E_V1, 10)
    var ep = env(false, 10)
    var a = ll_pdu.pdu_new()
    var b = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.begin_capabilities(var cen, var ec, var caps, var a), 0)
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var a, var b), ll_cs_proc.R_SEND)
    var got = ll_cs_pdu.cap_new()
    var scratch = ll_pdu.pdu_new()
    test.assert(ll_cs_proc.load_caps(var per, var got, var scratch))
    test.assert(not got.v2)
    test.assert_eq(got.t_ip2_ipt, 0)
    test.assert_eq(got.num_ant, 2)
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var caps, var b, var a), ll_cs_proc.R_NONE)
    var got2 = ll_cs_pdu.cap_new()
    test.assert(ll_cs_proc.load_caps(var cen, var got2, var scratch))
    test.assert(not got2.v2)
    var none = fresh()
    test.assert(not ll_cs_proc.load_caps(var none, var got, var scratch))

@test
fn test_a_configuration_or_a_run_that_does_not_exist_is_not_read()
    if skip()
        return
    var cs = fresh()
    var c = ll_cs_pdu.cfg_new()
    var s = ll_cs_pdu.start_new()
    var scratch = ll_pdu.pdu_new()
    test.assert(not ll_cs_proc.load_config(var cs, 0, var c, var scratch))
    test.assert(not ll_cs_proc.load_config(var cs, 9, var c, var scratch))
    test.assert(not ll_cs_proc.load_config(var cs, -1, var c, var scratch))
    test.assert(not ll_cs_proc.load_run(var cs, var s, var scratch))
    test.assert(not ll_cs_proc.cfg_used(var cs, 9))
    test.assert(not ll_cs_proc.cfg_used(var cs, -1))

@test
fn test_the_step_timings_are_held_to_their_tables_and_their_capability_masks()
    if skip()
        return
    // The T_IP table has 8 entries, the T_FCS table 10 and the T_PM table 3; the last of each is the mandatory timing and needs no bit.
    test.assert(ll_cs_proc.timing_ok(0, 7, 0))
    test.assert(not ll_cs_proc.timing_ok(0, 6, 0))
    test.assert(ll_cs_proc.timing_ok(0, 6, 0x40))
    test.assert(not ll_cs_proc.timing_ok(0, 8, 0xFFFF))
    test.assert(not ll_cs_proc.timing_ok(0, -1, 0xFFFF))
    test.assert(ll_cs_proc.timing_ok(1, 9, 0))
    test.assert(ll_cs_proc.timing_ok(1, 8, 0x100))
    test.assert(not ll_cs_proc.timing_ok(1, 8, 0xFF))
    test.assert(not ll_cs_proc.timing_ok(1, 10, 0xFFFF))
    test.assert(ll_cs_proc.timing_ok(2, 2, 0))
    test.assert(ll_cs_proc.timing_ok(2, 1, 0x2))
    test.assert(not ll_cs_proc.timing_ok(2, 0, 0x2))
    test.assert(not ll_cs_proc.timing_ok(2, 3, 0xF))

@test
fn test_bits_counts_the_set_bits_of_a_16_bit_value()
    if skip()
        return
    test.assert_eq(ll_cs_proc.bits(0), 0)
    test.assert_eq(ll_cs_proc.bits(0xFFFF), 16)
    test.assert_eq(ll_cs_proc.bits(0x8001), 2)
    test.assert_eq(ll_cs_proc.bits(0x10000), 0)

@test
fn test_the_connection_event_comparisons_are_taken_modulo_65536()
    if skip()
        return
    test.assert(ll_cs_proc.event_near(100, 100))
    test.assert(ll_cs_proc.event_near(100 + 16383, 100))
    test.assert(not ll_cs_proc.event_near(100 + 16384, 100))
    test.assert(ll_cs_proc.event_near(3, 0xFFFE))
    test.assert(ll_cs_proc.event_near(0xFFFE, 3))
    test.assert(ll_cs_proc.event_not_before(100, 100))
    test.assert(ll_cs_proc.event_not_before(5, 0xFFF0))
    test.assert(not ll_cs_proc.event_not_before(0xFFF0, 5))
    test.assert(ll_cs_proc.event_not_before(100 + 32767, 100))
    test.assert(not ll_cs_proc.event_not_before(100 + 32768, 100))
    test.assert(not ll_cs_proc.event_past(100, 100))
    test.assert(not ll_cs_proc.event_past(101, 100))
    test.assert(ll_cs_proc.event_past(99, 100))
    test.assert(ll_cs_proc.event_past(100 - 32766, 100))
    test.assert(not ll_cs_proc.event_past(100 + 32765, 100))
    test.assert(ll_cs_proc.event_past(0xFFFF, 0))

@test
fn test_the_requests_the_peer_may_refuse_are_the_opcodes_this_end_sends_as_requests()
    if skip()
        return
    var n = 0
    for op in 0..256
        if ll_cs.refusable(op)
            n = n + 1
    test.assert_eq(n, 7)
    for op in [0x39, 0x2E, 0x30, 0x32, 0x33, 0x35, 0x36]
        test.assert(ll_cs.refusable(op))
    for op in [0x2D, 0x2F, 0x31, 0x34, 0x37, 0x38, 0x3A]
        test.assert(not ll_cs.refusable(op))

@test
fn test_the_scheduling_hook_agrees_to_every_start_until_the_arbiter_joins_it()
    if skip()
        return
    var s = start_ok(0)
    var e = env(true, 10)
    test.assert(ll_cs_proc.schedule_ok(var s, var e))

// ── The record and its storage ──────────────────────────────────────

@test
fn test_the_environments_start_with_a_peripheral_of_30_ms_on_an_encrypted_link()
    if skip()
        return
    let e = ll_cs_proc.env_new()
    test.assert(not e.central)
    test.assert(e.encrypted)
    test.assert(e.peer_cs)
    test.assert_eq(e.interval_us, 30000)
    test.assert_eq(e.max_tx, 251)
    test.assert_eq(e.phy, 1)
    test.assert(e.sec_ok)
    test.assert(not e.busy)
    let t = ll_cs_proc.env_at(12345)
    test.assert_eq(t.now, 12345)
    test.assert(t.encrypted)
    test.assert_eq(t.max_tx, 251)

@test
fn test_the_capabilities_a_build_reports_follow_its_keys_and_are_valid()
    if skip()
        return
    var c = ll_cs_pdu.cap_new()
    ll_cs_proc.local_caps(var c)
    test.assert(ll_cs_proc.caps_valid(var c))
    test.assert_eq(c.v2, ctl_limits.cs_ipt_on())
    test.assert_eq(c.num_ant, noble_controller_config.CTL_CS_ANT)
    test.assert_eq(c.max_path, noble_controller_config.CTL_CS_ANT)
    test.assert_eq(c.role, noble_controller_config.CTL_CS_ROLES)
    test.assert_eq(c.num_configs, noble_controller_config.CTL_CS_CONFIGS)
    test.assert_eq((c.mode_types & 1) == 1, ctl_limits.cs_mode3_on())
    test.assert_eq(c.ch3c == 1, ctl_limits.cs_3c_on())
    test.assert_eq(c.ipt == 1, ctl_limits.cs_ipt_on())
    test.assert_eq(c.n_sound != 0, ctl_limits.cs_rtt_seq_on())
    test.assert_eq(c.n_rand != 0, ctl_limits.cs_rtt_seq_on())
    test.assert_eq(c.sounding_pct == 1, ctl_limits.cs_rtt_seq_on())
    // The access address round trip is mandatory, the table of frequency errors is absent, the optional timings are not offered.
    test.assert(c.n_aa != 0)
    test.assert_eq(c.no_fae, 1)
    test.assert_eq(c.t_ip1, 0)
    test.assert_eq(c.t_fcs, 0)
    test.assert_eq(c.sync_phy, 0)
    // The capabilities of a device with every option are those of its flags.
    var all = ll_cs_pdu.cap_new()
    ll_cs_proc.caps_with(var all, 2, 4, 3, true, true, true, true)
    test.assert(ll_cs_proc.caps_valid(var all))
    test.assert(all.v2)
    test.assert_eq(all.mode_types, 1)
    test.assert_eq(all.n_sound, 255)
    test.assert_eq(all.n_rand, 255)
    test.assert_eq(all.sounding_pct, 1)
    test.assert_eq(all.ipt, 1)
    test.assert_eq(all.ch3c, 1)
    test.assert_eq(all.role, 2)
    test.assert_eq(all.num_ant, 4)
    test.assert_eq(all.max_path, 4)
    test.assert_eq(all.num_configs, 3)
    var none = ll_cs_pdu.cap_new()
    ll_cs_proc.caps_with(var none, 1, 1, 1, false, false, false, false)
    test.assert(ll_cs_proc.caps_valid(var none))
    test.assert(not none.v2)
    test.assert_eq(none.mode_types, 0)
    test.assert_eq(none.n_sound, 0)
    test.assert_eq(none.n_rand, 0)
    test.assert_eq(none.sounding_pct, 0)
    test.assert_eq(none.ipt, 0)
    test.assert_eq(none.ch3c, 0)
    // The capabilities of the build go out in a PDU and come back.
    var p = ll_pdu.pdu_new()
    ll_cs_pdu.put_caps(var p, ll_cs.OP_CS_CAPABILITIES_REQ, var c)
    var d = ll_cs_pdu.cap_new()
    test.assert(ll_cs_pdu.get_caps(var p, var d))
    test.assert_eq(d.num_ant, c.num_ant)
    test.assert_eq(d.role, c.role)

@test
fn test_a_new_record_is_empty_and_a_reset_one_forgets_the_connection()
    if skip()
        return
    var cs = fresh()
    test.assert_eq(cs.owner, -1)
    test.assert(cs.host)
    test.assert(not cs.secured)
    test.assert(not ll_cs_proc.caps_known(var cs))
    test.assert_eq(cs.wait, ll_cs_proc.W_NONE)
    test.assert_eq(cs.chm_lo, ll_cs_pdu.CHM_LO_ALLOWED)
    test.assert_eq(cs.chm_hi, ll_cs_pdu.CHM_HI_ALLOWED)
    var per = fresh()
    ready(var cs, var per, 0)
    var s = start_ok(0)
    run_start(var cs, var per, true, var s)
    test.assert(cs.secured)
    test.assert(ll_cs_proc.caps_known(var cs))
    test.assert(ll_cs_proc.any_config(var cs))
    test.assert(cs.fae_known)
    test.assert(cs.run_open)
    ll_cs_proc.cs_reset(var cs)
    test.assert(not cs.secured)
    test.assert(not cs.fresh)
    test.assert(not ll_cs_proc.caps_known(var cs))
    test.assert(not ll_cs_proc.any_config(var cs))
    test.assert(not cs.fae_known)
    test.assert(not cs.run_open)
    test.assert_eq(cs.owed, 0)
    test.assert_eq(cs.proc_count, 0)
    test.assert_eq(cs.series_n, 0)
    test.assert_eq(ll_cs_proc.cs_iv(var cs, 0), 0)
    test.assert_eq(ll_cs_proc.peer_fae(var cs, 5), 0)
    // The Host Support bit is the Host's and not the connection's.
    test.assert(cs.host)

@test
fn test_the_store_holds_the_fixed_part_and_one_slot_for_each_configuration_of_the_build()
    if skip()
        return
    let cs = ll_cs_proc.cs_new()
    test.assert_eq(ll_cs_proc.bulk_octets(), 224 + 56 * noble_controller_config.CTL_CS_CONFIGS)
    test.assert_eq(cs.bulk.len(), ll_cs_proc.bulk_octets())
    test.assert_eq(ll_cs_proc.cfg_slots(), noble_controller_config.CTL_CS_CONFIGS)
    // The areas of the store follow one another without overlap.
    test.assert(ll_cs_proc.OFF_FAE >= ll_cs_proc.OFF_CAPS + 32)
    test.assert(ll_cs_proc.OFF_SEC >= ll_cs_proc.OFF_FAE + 72)
    test.assert(ll_cs_proc.OFF_REQ >= ll_cs_proc.OFF_SEC + 40)
    test.assert(ll_cs_proc.OFF_IND >= ll_cs_proc.OFF_REQ + 28)
    test.assert(ll_cs_proc.OFF_PCFG >= ll_cs_proc.OFF_IND + 18)
    test.assert(ll_cs_proc.OFF_CFG >= ll_cs_proc.OFF_PCFG + 28)
    test.assert_eq(ll_cs_proc.cfg_base(0), ll_cs_proc.OFF_CFG)
    test.assert_eq(ll_cs_proc.cfg_base(1), ll_cs_proc.OFF_CFG + ll_cs_proc.CFG_OCT)

@test
fn test_the_storage_of_a_connection_is_its_words_and_its_store_in_the_budget_of_the_schema()
    if skip()
        return
    // The figures of the schema: 34 words of 8 octets, a store of 224 octets and 32 for each configuration, and the rounding of a `Vec` to 8 octets.
    test.assert_eq(ctl_budget.CTL_CS_WORDS, ll_cs_proc.CS_WORDS * 8)
    test.assert_eq(ctl_budget.CTL_CS_GLOBAL_WORDS, ll_cs_proc.GLOBAL_WORDS * 8)
    test.assert_eq(ctl_budget.CTL_CS_GLOBAL_OCTETS, ll_cs_proc.GLOBAL_OCTETS)
    test.assert_eq(ctl_budget.CTL_CS_RESULT_STEP, ll_cs_proc.RES_STEP_OCT)
    test.assert_eq(ctl_budget.CTL_CS_STORE, ll_cs_proc.OFF_CFG)
    test.assert_eq(ctl_budget.CTL_CS_CONFIG, ll_cs_proc.CFG_OCT)
    let store = ctl_budget.CTL_CS_STORE + ctl_budget.CTL_CS_CONFIG * noble_controller_config.CTL_CS_CONFIGS
    // The planning (`ll_cs_plan`) is the other part of the figure: a generator for each connection, the plan's head and its steps.
    let planning = ctl_budget.vec_bytes(noble_controller_config.CTL_CS, ctl_budget.CTL_CS_GEN_RECORD) + ctl_budget.CTL_CS_PLAN_FIXED + ctl_budget.vec_bytes(noble_controller_config.CTL_CS_STEPS, ctl_budget.CTL_CS_STEP_RECORD)
    test.assert_eq(ctl_budget.controller_cs_bytes(), planning + ctl_budget.vec_bytes(noble_controller_config.CTL_CS, ctl_budget.CTL_CS_WORDS) + ctl_budget.CTL_CS_GLOBAL_WORDS + ctl_budget.vec_bytes(noble_controller_config.CTL_CS, store) + ctl_budget.CTL_CS_GLOBAL_OCTETS + ctl_budget.CTL_CS_RESULT_STEP * noble_controller_config.CTL_CS_STEPS)
    test.assert_eq(ctl_limits.cs_slots(), noble_controller_config.CTL_CS)
    test.assert_eq(ll_cs_proc.bulk_octets(), store)
    test.assert_eq(store % 8, 0)

@test
fn test_a_build_without_the_feature_keeps_the_two_tables_at_one_element_each_in_the_budget()
    if ctl_limits.cs_on()
        return
    test.assert_eq(ctl_budget.controller_cs_bytes(), ctl_budget.vec_bytes(1, 8) + ctl_budget.vec_bytes(1, 1))
    test.assert_eq(ctl_limits.cs_slots(), 1)

// ── The records in the Controller's tables ──────────────────────────

// The tables of a Controller with `ctl_cs` records.
fn tables() -> Vec[Int; if noble_controller_config.CTL_CS > 0 then noble_controller_config.CTL_CS * 38 + 40 else 1]
    var w: Vec[Int; if noble_controller_config.CTL_CS > 0 then noble_controller_config.CTL_CS * 38 + 40 else 1] = Vec.new()
    w

fn store_tables() -> Vec[u8; if noble_controller_config.CTL_CS > 0 then noble_controller_config.CTL_CS * (224 + 56 * noble_controller_config.CTL_CS_CONFIGS) + 232 + noble_controller_config.CTL_CS_STEPS * 40 else 1]
    var b: Vec[u8; if noble_controller_config.CTL_CS > 0 then noble_controller_config.CTL_CS * (224 + 56 * noble_controller_config.CTL_CS_CONFIGS) + 232 + noble_controller_config.CTL_CS_STEPS * 40 else 1] = Vec.new()
    b

@test
fn test_the_tables_start_with_every_record_free()
    if skip()
        return
    var w = tables()
    var b = store_tables()
    ll_cs_proc.tables_fill(var w, var b)
    test.assert_eq(w.len(), noble_controller_config.CTL_CS * ll_cs_proc.CS_WORDS + ll_cs_proc.GLOBAL_WORDS)
    test.assert_eq(b.len(), noble_controller_config.CTL_CS * ll_cs_proc.bulk_octets() + ll_cs_proc.GLOBAL_OCTETS + noble_controller_config.CTL_CS_STEPS * ll_cs_proc.RES_STEP_OCT)
    for slot in 0..noble_controller_config.CTL_CS
        test.assert_eq(w[slot * ll_cs_proc.CS_WORDS + ll_cs_proc.WD_OWNER], -1)
        test.assert_eq(w[slot * ll_cs_proc.CS_WORDS + ll_cs_proc.WD_WAIT], ll_cs_proc.W_NONE)
        test.assert_eq(w[slot * ll_cs_proc.CS_WORDS + ll_cs_proc.WD_CHM_LO], ll_cs_pdu.CHM_LO_ALLOWED)
        test.assert_eq(w[slot * ll_cs_proc.CS_WORDS + ll_cs_proc.WD_CHM_HI], ll_cs_pdu.CHM_HI_ALLOWED)

@test
fn test_a_record_stored_and_loaded_comes_back_whole_in_every_slot()
    if skip()
        return
    var w = tables()
    var b = store_tables()
    ll_cs_proc.tables_fill(var w, var b)
    for slot in 0..noble_controller_config.CTL_CS
        var cen = fresh()
        var per = fresh()
        ready(var cen, var per, 0)
        var s = start_set(S_PCNT, 4)
        start_put(var s, S_PINT, 3)
        run_start(var cen, var per, true, var s)
        ll_cs_proc.store(var w, var b, slot, var cen)
        var back = ll_cs_proc.cs_new()
        ll_cs_proc.load(var w, var b, slot, var back)
        test.assert_eq(back.secured, cen.secured)
        test.assert_eq(back.run_open, cen.run_open)
        test.assert_eq(back.series_n, 4)
        test.assert_eq(back.series_cfg, cen.series_cfg)
        test.assert_eq(back.proc_count, cen.proc_count)
        test.assert_eq(back.owed, cen.owed)
        test.assert_eq(back.chm_lo, cen.chm_lo)
        test.assert(ll_cs_proc.caps_known(var back))
        test.assert(ll_cs_proc.cfg_used(var back, 0))
        test.assert_eq(ll_cs_proc.cfg_role(var back, 0), 0)
        test.assert_eq(ll_cs_proc.cs_iv(var back, 0), ll_cs_proc.cs_iv(var cen, 0))
        test.assert_eq(ll_cs_proc.peer_fae(var back, 3), ll_cs_proc.peer_fae(var cen, 3))
        test.assert_eq(run_of(var back).subevent_len, 2500)

fn fill_numbers(var cs: Cs)
    cs.owner = 3
    cs.secured = true
    cs.fresh = true
    cs.caps_air = true
    cs.fae_known = true
    cs.fae_air = true
    cs.run_open = true
    cs.start_host = true
    cs.pend_chm = true
    cs.wait = 4
    cs.wait_cfg = 5
    cs.t0 = 6
    cs.rnd_n = 7
    cs.yield_op = 8
    cs.owed = 9
    cs.st_caps = 10
    cs.st_fae = 11
    cs.st_sec = 12
    cs.st_cfg = 13
    cs.st_proc = 14
    cs.st_term = 15
    cs.ev_cfg = 16
    cs.ev_act = 17
    cs.proc_count = 18
    cs.series_cfg = 19
    cs.series_n = 20
    cs.series_start = 21
    cs.term_error = 22
    cs.chm_lo = 23
    cs.chm_hi = 24
    cs.pend_lo = 25
    cs.pend_hi = 26
    cs.pend_instant = 27

@test
fn test_every_number_of_a_record_has_its_own_word_and_comes_back_through_the_tables()
    if skip()
        return
    var w = tables()
    var b = store_tables()
    ll_cs_proc.tables_fill(var w, var b)
    var cs = fresh()
    fill_numbers(var cs)
    ll_cs_proc.store(var w, var b, 0, var cs)
    var back = ll_cs_proc.cs_new()
    ll_cs_proc.load(var w, var b, 0, var back)
    test.assert_eq(back.owner, 3)
    test.assert(back.host)
    test.assert(back.secured)
    test.assert(back.fresh)
    test.assert(back.caps_air)
    test.assert(back.fae_known)
    test.assert(back.fae_air)
    test.assert(back.run_open)
    test.assert(back.start_host)
    test.assert(back.pend_chm)
    test.assert_eq(back.wait, 4)
    test.assert_eq(back.wait_cfg, 5)
    test.assert_eq(back.t0, 6)
    test.assert_eq(back.rnd_n, 7)
    test.assert_eq(back.yield_op, 8)
    test.assert_eq(back.owed, 9)
    test.assert_eq(back.st_caps, 10)
    test.assert_eq(back.st_fae, 11)
    test.assert_eq(back.st_sec, 12)
    test.assert_eq(back.st_cfg, 13)
    test.assert_eq(back.st_proc, 14)
    test.assert_eq(back.st_term, 15)
    test.assert_eq(back.ev_cfg, 16)
    test.assert_eq(back.ev_act, 17)
    test.assert_eq(back.proc_count, 18)
    test.assert_eq(back.series_cfg, 19)
    test.assert_eq(back.series_n, 20)
    test.assert_eq(back.series_start, 21)
    test.assert_eq(back.term_error, 22)
    test.assert_eq(back.chm_lo, 23)
    test.assert_eq(back.chm_hi, 24)
    test.assert_eq(back.pend_lo, 25)
    test.assert_eq(back.pend_hi, 26)
    test.assert_eq(back.pend_instant, 27)
    // The word of each field is where the index says.
    test.assert_eq(w[ll_cs_proc.WD_PEND_INSTANT], 27)
    test.assert_eq(w[ll_cs_proc.WD_OWNER], 3)
    test.assert_eq(ll_cs_proc.CS_WORDS, 38)

@test
fn test_a_claimed_record_is_new_and_a_freed_one_belongs_to_nobody()
    if skip()
        return
    var cs = fresh()
    var per = fresh()
    ready(var cs, var per, 0)
    ll_cs_proc.claim(var cs, 2, true)
    test.assert_eq(cs.owner, 2)
    test.assert(cs.host)
    test.assert(not cs.secured)
    test.assert(not ll_cs_proc.caps_known(var cs))
    ll_cs_proc.claim(var cs, 5, false)
    test.assert(not cs.host)
    ll_cs_proc.free(var cs)
    test.assert_eq(cs.owner, -1)
    test.assert_eq(ll_cs_proc.b2i(true), 1)
    test.assert_eq(ll_cs_proc.b2i(false), 0)

// ── The exchanges the Controller starts for itself ──────────────────

fn set_wait(var cs: Cs, w: Int)
    cs.wait = w

@test
fn test_the_controller_starts_the_feature_exchange_for_a_host_that_asked_before_the_features_were_known()
    if skip()
        return
    var cs = fresh()
    var e = env(false, 77)
    test.assert_eq(ll_cs_proc.begin_features(var cs, var e), 0)
    test.assert_eq(cs.wait, ll_cs_proc.W_FEAT)
    test.assert_eq(cs.t0, 77)
    // One procedure at a time.
    test.assert_eq(ll_cs_proc.begin_features(var cs, var e), ll_cs_proc.E_DISALLOWED)
    // The link would not take the request: the record stops waiting.
    ll_cs_proc.end_features(var cs)
    test.assert_eq(cs.wait, ll_cs_proc.W_NONE)
    // The Host Support bit clear, and a link that is not encrypted.
    var none = fresh_no_host()
    test.assert_eq(ll_cs_proc.begin_features(var none, var e), ll_cs_proc.E_DISALLOWED)
    var plain = envf(false, E_PLAIN, 77)
    test.assert_eq(ll_cs_proc.begin_features(var cs, var plain), ll_cs_proc.E_INSUFFICIENT_SECURITY)
    test.assert_eq(cs.wait, ll_cs_proc.W_NONE)
    // The peer's feature set is not part of the guard: the Controller does not know it yet.
    var nopeer = envf(false, E_NOPEER, 77)
    test.assert_eq(ll_cs_proc.begin_features(var cs, var nopeer), 0)

@test
fn test_a_feature_exchange_or_a_capabilities_exchange_that_fails_tells_the_host_through_the_event_of_the_command_that_waited()
    if skip()
        return
    // The Host asked for the capabilities: the Read Remote Supported Capabilities Complete event carries the code, for the features and for the capabilities.
    var a = fresh()
    var e = env(false, 10)
    test.assert_eq(ll_cs_proc.begin_features(var a, var e), 0)
    ll_cs_proc.fail_wait(var a, ll_cs_proc.E_UNSUPPORTED_REMOTE)
    test.assert_eq(a.wait, ll_cs_proc.W_NONE)
    test.assert_eq(a.st_caps, ll_cs_proc.E_UNSUPPORTED_REMOTE)
    test.assert(ll_cs_proc.take_owed(var a, ll_cs_proc.OWED_CAPS))
    var b = fresh()
    set_wait(var b, ll_cs_proc.W_CAP)
    ll_cs_proc.fail_wait(var b, ll_cs_proc.E_INVALID_LL)
    test.assert_eq(b.st_caps, ll_cs_proc.E_INVALID_LL)
    test.assert(ll_cs_proc.take_owed(var b, ll_cs_proc.OWED_CAPS))
    // The Host asked for a configuration: the Config Complete event carries it, with the configuration and the action, and the Host is not told of capabilities it did
    // not ask for.
    var caps = caps_full()
    var out = ll_pdu.pdu_new()
    var c = fresh()
    var cfg = cfg_ok(0, 0)
    test.assert_eq(ll_cs_proc.stage_config(var c, var e, var caps, var cfg, var out), 0)
    test.assert(ll_cs_proc.staged(var c))
    var en = env(false, 20)
    set_wait(var c, ll_cs_proc.W_FEAT)
    ll_cs_proc.fail_wait(var c, ll_cs_proc.E_RESPONSE_TIMEOUT)
    test.assert(not ll_cs_proc.staged(var c))
    test.assert_eq(c.st_cfg, ll_cs_proc.E_RESPONSE_TIMEOUT)
    test.assert_eq(c.ev_cfg, 0)
    test.assert_eq(c.ev_act, 1)
    test.assert(ll_cs_proc.take_owed(var c, ll_cs_proc.OWED_CFG))
    test.assert(not ll_cs_proc.take_owed(var c, ll_cs_proc.OWED_CAPS))
    // The wait for the features times out after 40 seconds like the others.
    var d = fresh()
    test.assert_eq(ll_cs_proc.begin_features(var d, var e), 0)
    test.assert_eq(ll_cs_proc.poll(var d, var en), 0)
    var late = env(false, 10 + ll_cs_proc.WAIT_US + 1)
    test.assert_eq(ll_cs_proc.poll(var d, var late), ll_cs_proc.E_RESPONSE_TIMEOUT)
    test.assert_eq(d.st_caps, ll_cs_proc.E_RESPONSE_TIMEOUT)

@test
fn test_a_configuration_is_staged_after_the_checks_that_need_no_peer_and_refused_by_the_others()
    if skip()
        return
    var caps = caps_full()
    var e = env(false, 10)
    var out = ll_pdu.pdu_new()
    // The checks of the command that need no capabilities of the peer.
    var none = fresh_no_host()
    var c1 = cfg_ok(0, 0)
    test.assert_eq(ll_cs_proc.stage_config(var none, var e, var caps, var c1, var out), ll_cs_proc.E_DISALLOWED)
    var plain = envf(false, E_PLAIN, 10)
    var a = fresh()
    test.assert_eq(ll_cs_proc.stage_config(var a, var plain, var caps, var c1, var out), ll_cs_proc.E_INSUFFICIENT_SECURITY)
    set_wait(var a, ll_cs_proc.W_CAP)
    test.assert_eq(ll_cs_proc.stage_config(var a, var e, var caps, var c1, var out), ll_cs_proc.E_DISALLOWED)
    set_wait(var a, ll_cs_proc.W_NONE)
    var remove = cfg_set(C_ACTION, 0)
    test.assert_eq(ll_cs_proc.stage_config(var a, var e, var caps, var remove, var out), ll_cs_proc.E_DISALLOWED)
    var bad = cfg_set(C_RTT, 7)
    test.assert_eq(ll_cs_proc.stage_config(var a, var e, var caps, var bad, var out), ll_cs_proc.E_INVALID_PARAMS)
    var lacking = cfg_set(C_PHY, 4)
    test.assert_eq(ll_cs_proc.stage_config(var a, var e, var caps, var lacking, var out), ll_cs_proc.E_UNSUPPORTED_FEATURE)
    test.assert(not ll_cs_proc.staged(var a))
    // A configuration the specification allows waits, with the Config_ID the event will name, and the store holds its PDU.
    var ok = cfg_ok(3, 1)
    if ll_cs_proc.cfg_slots() > 3
        test.assert_eq(ll_cs_proc.stage_config(var a, var e, var caps, var ok, var out), 0)
        test.assert(ll_cs_proc.staged(var a))
        test.assert_eq(a.wait_cfg, 3)
        ll_cs_proc.unstage(var a)
        test.assert(not ll_cs_proc.staged(var a))

@test
fn test_a_staged_configuration_goes_to_the_peer_when_its_capabilities_are_known_and_fails_when_they_rule_it_out()
    if skip()
        return
    var caps = caps_full()
    var e = env(false, 10)
    var out = ll_pdu.pdu_new()
    var cen = fresh()
    var per = fresh()
    var ec = env(true, 10)
    var c = cfg_ok(0, 1)
    test.assert_eq(ll_cs_proc.stage_config(var cen, var ec, var caps, var c, var out), 0)
    // The Capabilities Exchange: the Central asks, the Peripheral answers, and the Central goes on with the configuration it kept.
    test.assert_eq(ll_cs_proc.begin_capabilities(var cen, var ec, var caps, var out), 0)
    var b = ll_pdu.pdu_new()
    var ep = env(false, 10)
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var out, var b), ll_cs_proc.R_SEND)
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var caps, var b, var out), ll_cs_proc.R_NONE)
    test.assert(ll_cs_proc.staged(var cen))
    test.assert_eq(ll_cs_proc.config_resume(var cen, var ec, var caps, var out), ll_cs_proc.R_SEND)
    test.assert(not ll_cs_proc.staged(var cen))
    test.assert_eq(op_of(var out), ll_cs.OP_CS_CONFIG_REQ)
    test.assert_eq(cen.wait, ll_cs_proc.W_CFG)
    // The Peripheral accepts it as it would a request of the Host.
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var out, var b), ll_cs_proc.R_SEND)
    test.assert_eq(op_of(var b), ll_cs.OP_CS_CONFIG_RSP)
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var caps, var b, var out), ll_cs_proc.R_NONE)
    test.assert(ll_cs_proc.cfg_used(var cen, 0))
    // A peer whose capabilities the configuration is beyond: the Host is told with the Config Complete event, and nothing goes out.
    var cen2 = fresh()
    var c2 = cfg_ok(0, 0)
    test.assert_eq(ll_cs_proc.stage_config(var cen2, var ec, var caps, var c2, var out), 0)
    test.assert_eq(ll_cs_proc.begin_capabilities(var cen2, var ec, var caps, var out), 0)
    var peer_caps = caps_set(10, 1)
    var rsp = ll_pdu.pdu_new()
    ll_cs_pdu.put_caps(var rsp, ll_cs.OP_CS_CAPABILITIES_RSP, var peer_caps)
    test.assert_eq(ll_cs_proc.receive(var cen2, var ec, var caps, var rsp, var out), ll_cs_proc.R_NONE)
    test.assert_eq(ll_cs_proc.config_resume(var cen2, var ec, var caps, var out), ll_cs_proc.R_NONE)
    test.assert(not ll_cs_proc.staged(var cen2))
    test.assert_eq(cen2.st_cfg, ll_cs_proc.E_UNSUPPORTED_FEATURE)
    test.assert_eq(cen2.ev_cfg, 0)
    test.assert_eq(cen2.ev_act, 1)
    test.assert(ll_cs_proc.take_owed(var cen2, ll_cs_proc.OWED_CFG))
    test.assert(not ll_cs_proc.cfg_used(var cen2, 0))

@test
fn test_the_peripheral_answers_a_wide_window_with_the_part_from_3_milliseconds_on_and_the_central_picks_its_start()
    if skip()
        return
    var cen = fresh()
    var per = fresh()
    ready(var cen, var per, 0)
    var s = start_set2(S_OMIN, 1000, S_OMAX, 5000)
    var caps = caps_full()
    var ec = env(true, 20)
    var ep = env(false, 20)
    var a = ll_pdu.pdu_new()
    var b = ll_pdu.pdu_new()
    test.assert_eq(ll_cs_proc.begin_start(var cen, var ec, var caps, var s, var a), 0)
    test.assert_eq(ll_cs_proc.receive(var per, var ep, var caps, var a, var b), ll_cs_proc.R_SEND)
    var rsp = ll_cs_pdu.start_new()
    test.assert(ll_cs_pdu.get_rsp(var b, var rsp))
    test.assert_eq(rsp.offset_min, 3000)
    test.assert_eq(rsp.offset_max, 5000)
    test.assert_eq(ll_cs_proc.receive(var cen, var ec, var caps, var b, var a), ll_cs_proc.R_SEND)
    var ind = ll_cs_pdu.start_new()
    test.assert(ll_cs_pdu.get_ind(var a, var ind))
    test.assert_eq(ind.offset_min, 3000)
    // The answer is inside the request's window, as the Central checks.
    test.assert(cen.run_open)
