@test
fn test_a_fae_table_the_host_knows_is_kept_until_the_peer_sends_one_or_a_configuration_exists()
    if skip()
        return
    var cs = fresh()
    for i in 0..72
        test.assert_eq(ll_cs_proc.cache_fae(var cs, i, i - 30, i == 71), 0)
    test.assert(cs.fae_known)
    test.assert(not cs.fae_air)
    for i in 0..72
        test.assert_eq(ll_cs_proc.peer_fae(var cs, i), i - 30)
    // The Host may write it again, while nothing came from the peer.
    test.assert_eq(ll_cs_proc.cache_fae(var cs, 0, 9, false), 0)
    // One that came from the peer cannot be replaced.
    var cen = fresh()
    var per = fresh()
    exchange(var cen, var per)
    fae_table(var cen, var per, true)
    test.assert_eq(ll_cs_proc.cache_fae(var cen, 0, 1, false), ll_cs_proc.E_DISALLOWED)

