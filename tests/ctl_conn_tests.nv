@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_a_connection_lost_while_the_program_was_away_is_ended_by_the_catch_up()
    var c = connected(24, 200)
    let skipped = ctl_hci.ctl_conn_catch_up(var c, 0, 2000000)
    test.assert_eq(skipped, 1)
    test.assert(not ll_link.link_live(var c.links[0]))
