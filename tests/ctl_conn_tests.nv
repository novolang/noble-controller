@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_read_remote_version_runs_the_exchange_and_reports_the_central()
    var c = connected(24, 200)
    var cen = first_central(24)
    var host: [Int] = []
    conn_run(var c, var cen, 5000, 100000, var host)
    test.assert_eq(cmd_status(var c, 0x041D, [1, 0]), 0)
    cen_send(var cen, ctrl_pdu(ll_data.OP_VERSION_IND, [0x0E, 0x59, 0x00, 0x56, 0x12]))
    conn_run(var c, var cen, 100000, 300000, var host)
    let vs = events_coded(host, 0x0C)
    test.assert_eq(list.len(vs), 1)
    test.assert_eq(vs[0][2], 8)
    test.assert_eq(vs[0][3], 0)
    test.assert_eq(vs[0][4] | (vs[0][5] << 8), 1)
    test.assert_eq(vs[0][6], 0x0E)
    test.assert_eq(vs[0][7] | (vs[0][8] << 8), 0x59)
    test.assert_eq(vs[0][9] | (vs[0][10] << 8), 0x1256)
    // The Central saw this Controller's version once.
    var n = 0
    for p in cen.got
        if t_op(p) == ll_data.OP_VERSION_IND
            n = n + 1
            test.assert_eq(t_byte(p, 1), 0x11)
    test.assert_eq(n, 1)
    // A second read answers at once from what is known.
    test.assert_eq(cmd_status(var c, 0x041D, [1, 0]), 0)
    let again = run(var c, 0x1001, [])
    test.assert_eq(list.len(events_coded(again, 0x0C)), 1)
    test.assert_eq(cmd_status(var c, 0x041D, [3, 0]), 0x02)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_the_central_asking_for_the_version_is_answered_and_the_host_reads_it_at_once()
    var c = connected(24, 200)
    var cen = first_central(24)
    var host: [Int] = []
    cen_send(var cen, ctrl_pdu(ll_data.OP_VERSION_IND, [0x0E, 0x59, 0x00, 0x56, 0x12]))
    conn_run(var c, var cen, 5000, 200000, var host)
    var n = 0
    for p in cen.got
        if t_op(p) == ll_data.OP_VERSION_IND
            n = n + 1
    test.assert_eq(n, 1)
    test.assert_eq(list.len(events_coded(host, 0x0C)), 0)
    test.assert_eq(cmd_status(var c, 0x041D, [1, 0]), 0)
    test.assert_eq(list.len(events_coded(run(var c, 0x1001, []), 0x0C)), 1)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_le_read_remote_features_runs_the_peripheral_initiated_procedure()
    var c = connected(24, 200)
    var cen = first_central(24)
    var host: [Int] = []
    conn_run(var c, var cen, 5000, 100000, var host)
    test.assert_eq(cmd_status(var c, 0x2016, [1, 0]), 0)
    cen_send(var cen, ctrl_pdu(ll_data.OP_FEATURE_RSP, [0x1F, 0x22, 0, 0, 0, 0, 0, 0]))
    conn_run(var c, var cen, 100000, 300000, var host)
    var asked = false
    for p in cen.got
        if t_op(p) == ll_data.OP_PERIPHERAL_FEATURE_REQ
            asked = true
            test.assert_eq(t_byte(p, 1), 0x7F)
    test.assert(asked)
    let found = meta_events(host, 0x04)
    test.assert_eq(list.len(found), 1)
    test.assert_eq(found[0][2], 12)
    test.assert_eq(found[0][4], 0)
    test.assert_eq(found[0][5] | (found[0][6] << 8), 1)
    test.assert_eq(found[0][7], 0x1F)
    test.assert_eq(found[0][8], 0x22)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_a_central_that_does_not_know_the_features_request_is_reported_unsupported()
