// tests/ctl_conn_tests.nv — the Link Layer's connection as Peripheral inside the
// Controller: the Host's commands and ACL Data as its UART carries them, the
// connection events run against a simulated Central, and the events and data the
// Host gets back.
//
// The simulated Central follows the contract the radio program follows
// (ll_air.nv): ask `ctl_ll_pick`, run a connection event with
// `ctl_conn_begin`, `link_note_rx`, `link_rx_fast` or `link_rx_bad`,
// `ctl_conn_rx_slow` and `ctl_conn_done`, and give the time.  The Central keeps
// its own SN and NESN and its own queue, so the acknowledgement of both ends is
// checked against an independent implementation of the same rules.  T_IFS is 150
// microseconds, the PHY is LE 1M, and a PDU takes `airtime_us` microseconds.

use ctl_limits
use std.test
use noble_controller.CONFIG
use ctl_hci
use ctl_pool
use ll_pdu
use ll_adv
use ll_arb
use ll_data
use ll_link
use ll_policy

// ── The Host's side ─────────────────────────────────────────────────

// Reads of a PDU held in a list or passed by value.
fn t_op(p: Pdu) -> Int
    var w = p
    ll_data.dpdu_opcode(var w)

fn t_byte(p: Pdu, i: Int) -> Int
    var w = p
    ll_data.dpdu_byte(var w, i)

fn t_llid(p: Pdu) -> Int
    var w = p
    ll_data.dpdu_llid(var w)

fn t_len(p: Pdu) -> Int
    var w = p
    ll_data.dpdu_len(var w)

fn send(var c: ctl_hci.Controller, opcode: Int, params: [Int])
    ctl_hci.ctl_rx(var c, 0x01)
    ctl_hci.ctl_rx(var c, opcode & 0xFF)
    ctl_hci.ctl_rx(var c, (opcode >>> 8) & 0xFF)
    ctl_hci.ctl_rx(var c, list.len(params))
    for p in params
        ctl_hci.ctl_rx(var c, p)

fn drain(var c: ctl_hci.Controller) -> [Int]
    var out: [Int] = []
    while ctl_hci.ctl_tx_pending(var c)
        list.push(out, ctl_hci.ctl_tx_next(var c))
    out

fn run(var c: ctl_hci.Controller, opcode: Int, params: [Int]) -> [Int]
    send(var c, opcode, params)
    let _ran = ctl_hci.ctl_step(var c)
    drain(var c)

fn status_of(var c: ctl_hci.Controller, opcode: Int, params: [Int]) -> Int
    let r = run(var c, opcode, params)
    let done = events_coded(r, 0x0E)
    test.assert_eq(list.len(done), 1)
    test.assert_eq(done[0][4] | (done[0][5] << 8), opcode)
    done[0][6]

// The Status of the Command Status event a command is answered with.
fn cmd_status(var c: ctl_hci.Controller, opcode: Int, params: [Int]) -> Int
    let r = run(var c, opcode, params)
    let st = events_coded(r, 0x0F)
    test.assert_eq(list.len(st), 1)
    test.assert_eq(st[0][2], 4)
    test.assert_eq(st[0][5] | (st[0][6] << 8), opcode)
    st[0][3]

fn fresh() -> ctl_hci.Controller
    var c = ctl_hci.controller_new(ctl_hci.CAP_LL)
    for i in 0..6
        ctl_hci.ctl_set_public(var c, i, 0x10 + i)
    // The Host enables every event, the LE Meta event among them, and the LE
    // events its bring-up enables, with the Connection Update Complete and Read
    // Remote Features Complete among them.
    test.assert_eq(status_of(var c, 0x0C01, [0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x3F]), 0)
    test.assert_eq(status_of(var c, 0x2001, [0x1F, 0, 0, 0, 0, 0, 0, 0]), 0)
    c

fn zeros(n: Int) -> [Int]
    var v: [Int] = []
    for _ in 0..n
        list.push(v, 0)
    v

fn le16(v: Int) -> [Int]
    [v & 0xFF, (v >>> 8) & 0xFF]

fn adv_params(ty: Int) -> [Int]
    var p = le16(0x20)
    list.push(p, 0x20)
    list.push(p, 0)
    list.push(p, ty)
    list.push(p, 0)
    list.push(p, 0)
    for i in 0..6
        list.push(p, 0x70 + i)
    list.push(p, 7)
    list.push(p, 0)
    p

fn advertise(var c: ctl_hci.Controller, ty: Int)
    test.assert_eq(status_of(var c, 0x2006, adv_params(ty)), 0)
    test.assert_eq(status_of(var c, 0x200A, [1]), 0)

fn data31(data: [Int]) -> [Int]
    var p: [Int] = [list.len(data)]
    for d in data
        list.push(p, d)
    for _ in list.len(data)..31
        list.push(p, 0)
    p

// Split the octets the Controller sent into packets: events (0x04) and ACL
// Data (0x02).  Each packet is its octets from the indicator.
fn packets_of(bytes: [Int]) -> [[Int]]
    var out: [[Int]] = []
    var i = 0
    while i < list.len(bytes)
        var n = 0
        if bytes[i] == 0x04
            n = 3 + bytes[i + 2]
        else
            n = 5 + bytes[i + 3] + (bytes[i + 4] << 8)
        list.push(out, bytes[i:i + n])
        i = i + n
    out

// The events with the code `code`, and for LE Meta events the subevent.
fn events_coded(bytes: [Int], code: Int) -> [[Int]]
    var out: [[Int]] = []
    for e in packets_of(bytes)
        if e[0] == 0x04 and e[1] == code
            list.push(out, e[:])
    out

fn meta_events(bytes: [Int], sub: Int) -> [[Int]]
    var out: [[Int]] = []
    for e in events_coded(bytes, 0x3E)
        if e[3] == sub
            list.push(out, e[:])
    out

fn acl_packets(bytes: [Int]) -> [[Int]]
    var out: [[Int]] = []
    for e in packets_of(bytes)
        if e[0] == 0x02
            list.push(out, e[:])
    out

// An HCI ACL Data packet from the Host for the handle, with the flags and the data.
fn host_acl(handle: Int, pb: Int, data: [Int]) -> [Int]
    var p: [Int] = [0x02, handle & 0xFF, ((handle >>> 8) & 0x0F) | (pb << 4), list.len(data), 0]
    for d in data
        list.push(p, d)
    p

fn feed(var c: ctl_hci.Controller, bytes: [Int])
    for b in bytes
        ctl_hci.ctl_rx(var c, b)

// ── The Central ─────────────────────────────────────────────────────

// A CONNECT_IND from the random address 0x40..0x45 to the advertiser 0x10..0x15,
// with the access address 0x50655A12, an interval of `interval` units, a timeout
// of `timeout`, a transmit window of 2 units at `offset`, all 37 channels, hop 7
// and the SCA class 0.
fn connect_ind(interval: Int, timeout: Int, offset: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_pdu.pdu_begin(var p, ll_pdu.CONNECT_IND, 1, 0)
    for i in 0..6
        let _a = ll_pdu.pdu_put(var p, 0x40 + i)
    for i in 0..6
        let _b = ll_pdu.pdu_put(var p, 0x10 + i)
    for b in [0x12, 0x5A, 0x65, 0x50, 0x11, 0x22, 0x33, 2]
        let _c = ll_pdu.pdu_put(var p, b)
    for v in [offset, interval, 0, timeout]
        let _d = ll_pdu.pdu_put(var p, v & 0xFF)
        let _e = ll_pdu.pdu_put(var p, (v >>> 8) & 0xFF)
    for b in [0xFF, 0xFF, 0xFF, 0xFF, 0x1F, 7]
        let _f = ll_pdu.pdu_put(var p, b)
    ll_pdu.pdu_finish(var p)
    p

// The simulated Central: its sequence numbers, the PDU in flight and the data
// waiting, what it received from the Peripheral, and its timing.  `drift` is
// parts per million its clock runs fast, `silent` events it does not transmit
// in, `bad` the number of its next packets sent with a CRC error, `mute` makes
// it stop transmitting for good.  `log_*` record what the Peripheral sent.
struct Cen
    var sn: Int
    var nesn: Int
    var cur: Pdu
    var queue: [Pdu]
    var got: [Pdu]
    var anchor: Int
    var interval_us: Int
    var drift: Int
    var silent: Int
    var bad: Int
    var mute: Bool
    var events: Int
    var heard: Int
    var log_t: [Int]
    var log_hdr: [Int]
    var log_ch: [Int]
    var window_miss: Int
    var max_exchanges: Int
    var ev: Int
    var upd_instant: Int
    var upd_interval: Int
    var upd_offset: Int
    var dle: Bool
    var dle_rx: Int
    var lens: [Pdu]
    var phys: [Pdu]

fn cen_new(anchor: Int, interval_us: Int) -> Cen
    var empty = ll_pdu.pdu_new()
    ll_data.dpdu_empty(var empty)
    Cen { sn: 0, nesn: 0, cur: empty, queue: [], got: [], anchor: anchor, interval_us: interval_us,
          drift: 0, silent: 0, bad: 0, mute: false, events: 0, heard: 0, log_t: [], log_hdr: [],
          log_ch: [], window_miss: 0, max_exchanges: 8, ev: 0,
          upd_instant: -1, upd_interval: 0, upd_offset: 0, dle: false, dle_rx: 251, lens: [], phys: [] }

// A data PDU for the Central to send: LLID `llid`, `n` octets starting at `first`.
fn data_pdu(llid: Int, n: Int, first: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_data.dpdu_begin(var p, llid)
    for i in 0..n
        let _a = ll_pdu.pdu_put(var p, first + i)
    ll_data.dpdu_finish(var p)
    p

fn ctrl_pdu(op: Int, rest: [Int]) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_data.ctrl_begin(var p, op)
    for b in rest
        let _a = ll_pdu.pdu_put(var p, b)
    ll_data.dpdu_finish(var p)
    p

// The Central sends `p` in a coming event.
fn cen_send(var cen: Cen, p: Pdu)
    list.push(cen.queue, p)

// Run the Peripheral's side of the exchange the Central's packet starts: the
// calls the radio program makes.  The reply is the PDU the Peripheral sends, in
// `reply`, with the header octet the answer is.  `false` when the Peripheral
// does not answer (two bad packets).
fn exchange(var c: ctl_hci.Controller, var cen: Cen, var pdu: Pdu, md: Int, t: Int, good: Bool,
            var reply: Pdu) -> Int
    ll_link.link_note_rx(var c.links[0], t, good)
    var hdr = 0
    if good
        hdr = ll_link.link_rx_fast(var c.links[0], pdu.b[0] as Int | (cen.nesn << 2) | (cen.sn << 3) | (md << 4))
    else
        if not ll_link.link_answers_bad(var c.links[0])
            return -1
        hdr = ll_link.link_rx_bad(var c.links[0])
    // The PDU the radio sends: the one the verdict names.
    if c.links[0].use_nxt
        reply.n = c.links[0].nxt.n
        for i in 0..c.links[0].nxt.n
            reply.b[i] = c.links[0].nxt.b[i]
    else
        reply.n = c.links[0].cur.n
        for i in 0..c.links[0].cur.n
            reply.b[i] = c.links[0].cur.b[i]
    if good
        ctl_hci.ctl_conn_rx_slow(var c, 0, var pdu)
    hdr

// The Central takes the Peripheral's answer: its NESN acknowledges, and its
// SN says whether the PDU is new.
fn cen_take(var cen: Cen, hdr: Int, var reply: Pdu)
    let sn_p = (hdr >>> 3) & 1
    let nesn_p = (hdr >>> 2) & 1
    if nesn_p != cen.sn
        // Acknowledged: the next PDU, or an empty one.
        cen.sn = cen.sn ^ 1
        if list.len(cen.queue) > 0
            cen.cur = cen.queue[0]
            var rest: [Pdu] = []
            for i in 1..list.len(cen.queue)
                list.push(rest, cen.queue[i])
            cen.queue = rest
        else
            var empty = ll_pdu.pdu_new()
            ll_data.dpdu_empty(var empty)
            cen.cur = empty
    if sn_p == cen.nesn
        cen.nesn = cen.nesn ^ 1
        if t_llid(reply) == ll_data.LLID_CONTROL and t_op(reply) == ll_data.OP_LENGTH_REQ
            list.push(cen.lens, reply)
            var answer = ll_pdu.pdu_new()
            if cen.dle
                // A Controller with the Data Length Extension answers with the octets it can take
                // and send, at the times they need on LE 1M.
                ll_data.ctrl_length(var answer,
                    ll_data.OP_LENGTH_RSP,
                    cen.dle_rx,
                    328 + 8 * (cen.dle_rx - 27),
                    251,
                    2120)
            else
                // A Controller without it does not know the request the Peripheral makes of every new connection.
                ll_data.ctrl_unknown_rsp(var answer, ll_data.OP_LENGTH_REQ)
            list.push(cen.queue, answer)
        else if t_llid(reply) == ll_data.LLID_CONTROL and (t_op(reply) == ll_data.OP_PHY_REQ or t_op(reply) == ll_data.OP_PHY_RSP)
            list.push(cen.phys, reply)
        else if t_len(reply) > 0 or t_llid(reply) == ll_data.LLID_CONTROL
            list.push(cen.got, reply)

// One connection event of the Central, at its anchor point, against the
// Peripheral.  The event is skipped when the Central is silent or muted.
fn cen_event(var c: ctl_hci.Controller, var cen: Cen) -> Int
    cen.events = cen.events + 1
    if cen.mute or cen.silent > 0
        if cen.silent > 0
            cen.silent = cen.silent - 1
        let ch0 = ctl_hci.ctl_conn_begin(var c, 0)
        ctl_hci.ctl_conn_done(var c, 0, cen.anchor + 300)
        return cen.anchor + 300
    // The Peripheral must be listening when the Central starts.
    let win_start = ll_link.link_listen_start(var c.links[0])
    let we = ll_link.link_listen_end(var c.links[0])
    if cen.anchor < win_start or cen.anchor > we
        cen.window_miss = cen.window_miss + 1
    let ch = ctl_hci.ctl_conn_begin(var c, 0)
    list.push(cen.log_ch, ch)
    var t = cen.anchor
    var n = 0
    var reply = ll_pdu.pdu_new()
    var open = true
    while open and n < cen.max_exchanges
        var pdu = cen.cur
        var md = 0
        if list.len(cen.queue) > 0
            md = 1
        var good = true
        if cen.bad > 0
            good = false
            cen.bad = cen.bad - 1
        let hdr = exchange(var c, var cen, var pdu, md, t, good, var reply)
        if hdr < 0
            open = false
        else
            list.push(cen.log_t, t)
            list.push(cen.log_hdr, hdr)
            cen.heard = cen.heard + 1
            cen_take(var cen, hdr, var reply)
            t = t + ll_pdu.airtime_us(pdu.n) + 150 + ll_pdu.airtime_us(reply.n) + 150
            n = n + 1
            open = c.links[0].cont and good and not c.links[0].closing
    ctl_hci.ctl_conn_done(var c, 0, t)
    t

// The Central's next anchor, the interval after this one, its clock drift
// applied.
fn cen_next(var cen: Cen)
    cen.ev = cen.ev + 1
    var step = cen.interval_us
    if cen.upd_instant == cen.ev
        // The first event of the new parameters starts in the transmit window.
        step = cen.interval_us + cen.upd_offset * 1250 + 400
        cen.interval_us = cen.upd_interval * 1250
        cen.upd_instant = -1
    cen.anchor = cen.anchor + step + step * cen.drift / 1000000

fn host_read(var c: ctl_hci.Controller, var out: [Int])
    let _ran = ctl_hci.ctl_step(var c)
    while ctl_hci.ctl_tx_pending(var c)
        list.push(out, ctl_hci.ctl_tx_next(var c))

// The time the next booked activity wants the radio.
fn wake_time(var c: ctl_hci.Controller) -> Int
    var best = -1
    ctl_hci.ctl_ll_book(var c)
    for cls in 0..ll_arb.classes()
        if c.arb.on[cls]
            let t = c.arb.start[cls] - ll_arb.lead_of(var c.arb, cls)
            if best < 0 or t < best
                best = t
    best

// Run the Link Layer until `until`: the Central's events when the arbiter
// grants the radio to the connection, the Host reading every event.  `now`
// is the clock; the answer is every octet the Host read.
fn conn_run(var c: ctl_hci.Controller, var cen: Cen, start: Int, until: Int, var host: [Int])
    var now = start
    var guard = 0
    while now < until and guard < 200000
        guard = guard + 1
        host_read(var c, var host)
        ctl_hci.ctl_set_time(var c, now)
        let cls = ctl_hci.ctl_ll_pick(var c, false)
        if cls == ll_arb.class_acl()
            if ctl_hci.ctl_conn_active(var c, 0)
                if now < cen.anchor
                    now = cen.anchor
                ctl_hci.ctl_set_time(var c, now)
                now = cen_event(var c, var cen)
                ctl_hci.ctl_set_time(var c, now)
                cen_next(var cen)
            else
                now = now + 1
        else
            let t = wake_time(var c)
            if t < 0 or t > until
                now = until
            else if t > now
                now = t
            else
                now = now + 1
    test.assert(guard < 200000)
    host_read(var c, var host)

// A Controller advertising connectably, a CONNECT_IND taken at `end_us`, and the
// Central expecting its first anchor in the transmit window.
fn connected(interval: Int, timeout: Int) -> ctl_hci.Controller
    var c = fresh()
    advertise(var c, 0)
    ctl_hci.ctl_set_time(var c, 1000)
    var pol = ll_policy.default_link_policy()
    var p = connect_ind(interval, timeout, 0)
    test.assert(ctl_hci.ctl_connect_ind(var c, var pol, var p, 5000))
    c

// The Central for `connected`: its first packet 1.25 ms and 300 microseconds into
// the transmit window.
fn first_central(interval: Int) -> Cen
    cen_new(5000 + 1250 + 300, interval * 1250)

// ── Taking the connection ───────────────────────────────────────────

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_connect_ind_opens_the_connection_and_stops_advertising()
    var c = connected(24, 200)
    test.assert(ll_link.link_live(var c.links[0]))
    test.assert(not c.adv.enabled)
    test.assert(not ll_arb.arb_booked(var c.arb, ll_arb.class_adv()))
    test.assert_eq(c.links[0].interval, 24)
    // LE Connection Complete is queued at the next step, the Host's mask letting it through.
    let r = run(var c, 0x1001, [])
    let events = meta_events(r, 0x01)
    test.assert_eq(list.len(events), 1)
    let e = events[0]
    // Status, handle, role Peripheral, the Central's random address, the interval,
    // latency, timeout and SCA of 500 ppm.
    test.assert_eq(e[2], 19)
    test.assert_eq(e[4], 0)
    test.assert_eq(e[5] | (e[6] << 8), 1)
    test.assert_eq(e[7], 1)
    test.assert_eq(e[8], 1)
    test.assert_eq(e[9], 0x40)
    test.assert_eq(e[14], 0x45)
    test.assert_eq(e[15] | (e[16] << 8), 24)
    test.assert_eq(e[17] | (e[18] << 8), 0)
    test.assert_eq(e[19] | (e[20] << 8), 200)
    test.assert_eq(e[21], 0)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_connection_complete_is_not_sent_when_the_host_masked_it_and_enhanced_replaces_it()
    var c = fresh()
    test.assert_eq(status_of(var c, 0x2001, zeros(8)), 0)
    advertise(var c, 0)
    var pol = ll_policy.default_link_policy()
    var p = connect_ind(24, 200, 0)
    test.assert(ctl_hci.ctl_connect_ind(var c, var pol, var p, 5000))
    let r = run(var c, 0x1001, [])
    test.assert_eq(list.len(events_coded(r, 0x3E)), 0)
    test.assert(not ll_link.link_owes(var c.links[0], ll_link.EV_CONNECTED))
    // The Enhanced event replaces the plain one when the Host enabled it.
    var d = fresh()
    test.assert_eq(status_of(var d, 0x2001, [0x00, 0x02, 0, 0, 0, 0, 0, 0]), 0)
    advertise(var d, 0)
    var q = connect_ind(24, 200, 0)
    test.assert(ctl_hci.ctl_connect_ind(var d, var pol, var q, 5000))
    let s = run(var d, 0x1001, [])
    test.assert_eq(list.len(meta_events(s, 0x01)), 0)
    let enhanced = meta_events(s, 0x0A)
    test.assert_eq(list.len(enhanced), 1)
    test.assert_eq(enhanced[0][2], 31)
    test.assert_eq(enhanced[0][9], 0x40)
    // The two private addresses are zeros.
    test.assert_eq(enhanced[0][15], 0)
    test.assert_eq(enhanced[0][26], 0)
    test.assert_eq(enhanced[0][27] | (enhanced[0][28] << 8), 24)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_connect_ind_that_fails_the_checks_or_the_policy_leaves_the_advertiser_on()
    var c = fresh()
    advertise(var c, 0)
    var pol = ll_policy.default_link_policy()
    // An interval of 5 units is not one.
    var bad = connect_ind(5, 200, 0)
    test.assert(not ctl_hci.ctl_connect_ind(var c, var pol, var bad, 5000))
    test.assert(c.adv.enabled)
    test.assert(not ll_link.link_live(var c.links[0]))
    var rejecting = RefusingPolicy { min_interval: 40, asked: 0 }
    var p = connect_ind(24, 200, 0)
    test.assert(not ctl_hci.ctl_connect_ind(var c, var rejecting, var p, 5000))
    test.assert_eq(rejecting.asked, 1)
    test.assert(c.adv.enabled)
    var q = connect_ind(48, 400, 0)
    test.assert(ctl_hci.ctl_connect_ind(var c, var rejecting, var q, 5000))
    test.assert_eq(rejecting.asked, 2)
    test.assert(not c.adv.enabled)

// A product policy: no connection with an interval under `min_interval`.
struct RefusingPolicy
    var min_interval: Int
    var asked: Int

impl LinkPolicy for RefusingPolicy
    fn accept_connection(var self, req: ConnRequest) -> Bool
        self.asked = self.asked + 1
        req.interval >= self.min_interval

@test
fn test_a_second_connect_ind_is_not_taken_while_a_connection_is_on()
    // These cases are the limits of the default profile: one Peripheral link and one Central
    // link in two slots.  A profile with other limits (configs/ctl3.toml) has its own tests.
    if not ctl_hci.default_caps()
        return
    var c = connected(24, 200)
    var pol = ll_policy.default_link_policy()
    var p = connect_ind(24, 200, 0)
    test.assert(not ctl_hci.ctl_connect_ind(var c, var pol, var p, 9000))

@test
fn test_connectable_advertising_is_refused_while_connected_and_the_others_are_not()
    // These cases are the limits of the default profile: one Peripheral link and one Central
    // link in two slots.  A profile with other limits (configs/ctl3.toml) has its own tests.
    if not ctl_hci.default_caps()
        return
    var c = connected(24, 200)
    test.assert_eq(status_of(var c, 0x2006, adv_params(0)), 0)
    test.assert_eq(status_of(var c, 0x200A, [1]), ctl_hci.STATUS_CONNECTION_LIMIT)
    test.assert_eq(status_of(var c, 0x2006, adv_params(1)), 0)
    test.assert_eq(status_of(var c, 0x200A, [1]), ctl_hci.STATUS_CONNECTION_LIMIT)
    test.assert_eq(status_of(var c, 0x2006, adv_params(3)), 0)
    test.assert_eq(status_of(var c, 0x200A, [1]), 0)
    test.assert(c.adv.enabled)

@test
fn test_the_link_layer_features_and_states_name_the_connection()
    var c = fresh()
    let f = run(var c, 0x2003, [])
    test.assert_eq(f[7], 0x7F)
    test.assert_eq(f[8], ctl_limits.features_octet1())
    test.assert_eq(f[9], 0x01)
    test.assert_eq(f[10], ctl_limits.features_octet3())
    let b = run(var c, 0x2002, [])
    test.assert_eq(b[7] | (b[8] << 8), 251)
    test.assert_eq(b[9], ctl_hci.ACL_BUFFERS)
    var bare = ctl_hci.controller_new(0)
    let g = run(var bare, 0x2003, [])
    test.assert_eq(g[7], 0)

// ── The events of a connection ──────────────────────────────────────

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_an_idle_connection_runs_its_events_on_time_on_the_right_channels()
    var c = connected(24, 200)
    var cen = first_central(24)
    var host: [Int] = []
    conn_run(var c, var cen, 5000, 1000000, var host)
    test.assert(ll_link.link_live(var c.links[0]))
    test.assert_eq(cen.window_miss, 0)
    test.assert(cen.events >= 30)
    // Every packet of the Peripheral was heard: no gap in the log.  The event of its LL_LENGTH_REQ
    // has a second exchange.
    test.assert(cen.heard >= cen.events)
    test.assert(cen.heard <= cen.events + 2)
    // Channel selection #1 with hop 7: 7, 14, 21, 28, 35, 5.
    test.assert_eq(cen.log_ch[0], 7)
    test.assert_eq(cen.log_ch[1], 14)
    test.assert_eq(cen.log_ch[2], 21)
    test.assert_eq(cen.log_ch[5], 5)
    // The Peripheral's empty packets: LLID 1, NESN toggling, SN toggling.
    test.assert_eq(cen.log_hdr[0] & 3, 1)
    let n = list.len(cen.log_hdr)
    test.assert(n > 10)
    // The events spaced by the interval.
    test.assert_eq(cen.log_t[1] - cen.log_t[0], 30000)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_the_windows_follow_a_central_clock_that_runs_fast()
    var c = connected(24, 400)
    var cen = first_central(24)
    // 500 ppm is the class the CONNECT_IND names and the widest the
    // Peripheral allows for with its own 50.
    cen.drift = 450
    var host: [Int] = []
    conn_run(var c, var cen, 5000, 6000000, var host)
    test.assert(ll_link.link_live(var c.links[0]))
    test.assert_eq(cen.window_miss, 0)
    test.assert(cen.events > 150)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_a_central_that_misses_events_is_waited_for_with_a_wider_window()
    var c = connected(24, 400)
    var cen = first_central(24)
    var host: [Int] = []
    conn_run(var c, var cen, 5000, 500000, var host)
    cen.silent = 5
    cen.drift = 400
    conn_run(var c, var cen, 500000, 3000000, var host)
    test.assert(ll_link.link_live(var c.links[0]))
    // After the silence the Central is heard again, within the window.
    test.assert_eq(cen.window_miss, 0)
    test.assert(cen.heard > 40)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_a_central_that_never_shows_fails_the_connection_to_establish()
    var c = connected(24, 200)
    var cen = first_central(24)
    cen.mute = true
    var host: [Int] = []
    conn_run(var c, var cen, 5000, 1000000, var host)
    test.assert(not ll_link.link_live(var c.links[0]))
    let ds = events_coded(host, 0x05)
    test.assert_eq(list.len(ds), 1)
    test.assert_eq(ds[0][3], 0)
    test.assert_eq(ds[0][4] | (ds[0][5] << 8), 1)
    test.assert_eq(ds[0][6], 0x3E)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_a_central_that_goes_quiet_ends_the_connection_with_a_supervision_timeout()
    var c = connected(24, 100)
    var cen = first_central(24)
    var host: [Int] = []
    conn_run(var c, var cen, 5000, 400000, var host)
    test.assert(ll_link.link_live(var c.links[0]))
    cen.mute = true
    conn_run(var c, var cen, 400000, 2000000, var host)
    test.assert(not ll_link.link_live(var c.links[0]))
    let ds = events_coded(host, 0x05)
    test.assert_eq(list.len(ds), 1)
    test.assert_eq(ds[0][6], 0x08)
    // The link is off the arbiter: nothing else is booked.
    test.assert(not ll_arb.arb_booked(var c.arb, ll_arb.class_acl()))

// ── Data ────────────────────────────────────────────────────────────

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_acl_data_from_the_host_reaches_the_central_and_its_buffer_is_returned()
    var c = connected(24, 200)
    var cen = first_central(24)
    var host: [Int] = []
    conn_run(var c, var cen, 5000, 100000, var host)
    feed(var c, host_acl(1, 0, [0x03, 0x00, 0x04, 0x00, 0xAA, 0xBB, 0xCC]))
    feed(var c, host_acl(1, 1, [0x11, 0x22]))
    conn_run(var c, var cen, 100000, 400000, var host)
    test.assert_eq(list.len(cen.got), 2)
    test.assert_eq(t_llid(cen.got[0]), ll_data.LLID_START)
    test.assert_eq(t_len(cen.got[0]), 7)
    test.assert_eq(t_byte(cen.got[0], 4), 0xAA)
    test.assert_eq(t_llid(cen.got[1]), ll_data.LLID_CONTINUE)
    test.assert_eq(t_byte(cen.got[1], 1), 0x22)
    // Two buffers freed: Number Of Completed Packets, one handle, count 2 in all.
    var total = 0
    for e in events_coded(host, 0x13)
        test.assert_eq(e[3], 1)
        test.assert_eq(e[4] | (e[5] << 8), 1)
        total = total + (e[6] | (e[7] << 8))
    test.assert_eq(total, 2)
    test.assert_eq(c.dropped_acl, 0)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_data_from_the_central_reaches_the_host_as_acl_packets()
    var c = connected(24, 200)
    var cen = first_central(24)
    cen_send(var cen, data_pdu(ll_data.LLID_START, 10, 0x30))
    cen_send(var cen, data_pdu(ll_data.LLID_CONTINUE, 27, 0x50))
    var host: [Int] = []
    conn_run(var c, var cen, 5000, 300000, var host)
    let acl = acl_packets(host)
    test.assert_eq(list.len(acl), 2)
    // Handle 1, first fragment (flags 2), then a continuation (flags 1).
    test.assert_eq(acl[0][1], 0x01)
    test.assert_eq(acl[0][2], 0x20)
    test.assert_eq(acl[0][3], 10)
    test.assert_eq(acl[0][5], 0x30)
    test.assert_eq(acl[0][14], 0x39)
    test.assert_eq(acl[1][2], 0x10)
    test.assert_eq(acl[1][3], 27)
    test.assert_eq(acl[1][5], 0x50)
    test.assert_eq(acl[1][31], 0x50 + 26)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_data_both_ways_over_many_events_loses_nothing_and_keeps_order()
    var c = connected(6, 200)
    var cen = first_central(6)
    var host: [Int] = []
    var now = 5000
    var sent_up = 0
    var sent_down = 0
    var round = 0
    while round < 60
        // The Central sends two fragments, the Host one packet, each round.
        cen_send(var cen, data_pdu(ll_data.LLID_START, 5, 0x10 + round))
        cen_send(var cen, data_pdu(ll_data.LLID_CONTINUE, 3, 0x80 + round))
        sent_up = sent_up + 2
        feed(var c, host_acl(1, 0, [round, round + 1, round + 2, round + 3, 0x42]))
        sent_down = sent_down + 1
        now = now + 400000
        conn_run(var c, var cen, now - 400000, now, var host)
        round = round + 1
    test.assert(ll_link.link_live(var c.links[0]))
    test.assert_eq(cen.window_miss, 0)
    let acl = acl_packets(host)
    test.assert_eq(list.len(acl), sent_up)
    for i in 0..list.len(acl)
        let round_of = i / 2
        if i % 2 == 0
            test.assert_eq(acl[i][5], 0x10 + round_of)
            test.assert_eq(acl[i][3], 5)
        else
            test.assert_eq(acl[i][5], 0x80 + round_of)
    test.assert_eq(list.len(cen.got), sent_down)
    for i in 0..sent_down
        test.assert_eq(t_byte(cen.got[i], 0), i)
    test.assert_eq(c.dropped_acl, 0)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_the_host_cannot_send_more_than_the_buffers_it_was_told()
    var c = connected(24, 200)
    // No events run, so nothing is acknowledged: the fourth packet is the Host's
    // error, and the fifth, the queue holding the three buffers and one in `nxt`.
    for k in 0..6
        feed(var c, host_acl(1, 0, [k, 0, 0, 0]))
    test.assert_eq(c.dropped_acl, 2)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_acl_data_for_another_handle_is_dropped_and_one_over_the_buffer_loses_the_stream()
    var c = connected(24, 200)
    feed(var c, host_acl(2, 0, [1, 2]))
    test.assert_eq(c.dropped_acl, 1)
    // A packet of 251 octets is the longest data PDU the buffers hold, and goes on.
    var edge: [Int] = []
    for i in 0..251
        list.push(edge, i)
    feed(var c, host_acl(1, 0, edge))
    test.assert_eq(c.dropped_acl, 1)
    test.assert_eq(c.rx.lost, 0)
    var big: [Int] = []
    for i in 0..252
        list.push(big, i)
    feed(var c, host_acl(1, 0, big))
    test.assert_eq(c.rx.lost, 1)
    test.assert_eq(c.dropped_acl, 1)
    // A link that is not on takes none.
    var d = fresh()
    feed(var d, host_acl(1, 0, [1, 2]))
    test.assert_eq(d.dropped_acl, 1)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_a_packet_for_a_full_pool_is_held_back_until_the_host_reads()
    var c = connected(24, 200)
    var cen = first_central(24)
    cen_send(var cen, data_pdu(ll_data.LLID_START, 4, 0x60))
    var host: [Int] = []
    // Three slots the Host has not freed: one is left, and a packet needs two.
    for _ in 0..3
        test.assert(ctl_pool.pool_take(var c.pool) >= 0)
    conn_run(var c, var cen, 5000, 200000, var host)
    test.assert(ll_link.link_live(var c.links[0]))
    test.assert_eq(list.len(acl_packets(host)), 0)
    test.assert(not c.links[0].room)
    // The Host reads: the Central's packet, sent again, is taken once.
    for s in 0..3
        ctl_pool.pool_give(var c.pool, s)
    conn_run(var c, var cen, 200000, 400000, var host)
    test.assert_eq(list.len(acl_packets(host)), 1)
    test.assert_eq(c.dropped_acl, 0)

// ── Procedures ──────────────────────────────────────────────────────

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_disconnect_terminates_the_link_and_reports_local_host()
    var c = connected(24, 200)
    var cen = first_central(24)
    var host: [Int] = []
    conn_run(var c, var cen, 5000, 100000, var host)
    test.assert_eq(cmd_status(var c, 0x0406, [1, 0, 0x13]), 0)
    conn_run(var c, var cen, 100000, 400000, var host)
    // The Central received LL_TERMINATE_IND with the Host's reason.
    var seen = false
    for p in cen.got
        if t_op(p) == ll_data.OP_TERMINATE_IND
            test.assert_eq(t_byte(p, 1), 0x13)
            seen = true
    test.assert(seen)
    let ds = events_coded(host, 0x05)
    test.assert_eq(list.len(ds), 1)
    test.assert_eq(ds[0][3], 0)
    test.assert_eq(ds[0][4] | (ds[0][5] << 8), 1)
    test.assert_eq(ds[0][6], 0x16)
    test.assert(not ll_link.link_live(var c.links[0]))

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_disconnect_checks_its_handle_and_its_reason()
    var c = connected(24, 200)
    test.assert_eq(cmd_status(var c, 0x0406, [2, 0, 0x13]), 0x02)
    test.assert_eq(cmd_status(var c, 0x0406, [1, 0, 0x08]), 0x12)
    test.assert_eq(cmd_status(var c, 0x0406, [1, 0, 0x13]), 0)
    test.assert_eq(cmd_status(var c, 0x0406, [1, 0, 0x13]), 0x0C)
    // The accepted reasons.
    var d = connected(24, 200)
    test.assert_eq(cmd_status(var d, 0x0406, [1, 0, 0x15]), 0)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_the_central_terminating_reports_its_reason()
