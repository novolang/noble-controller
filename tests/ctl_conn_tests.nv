    let found = meta_events(host, 0x04)
    test.assert_eq(list.len(found), 1)
    test.assert_eq(found[0][4], 0x1A)
    test.assert_eq(found[0][7], 0)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_the_central_reading_the_features_gets_the_common_set()
    var c = connected(24, 200)
    var cen = first_central(24)
    var host: [Int] = []
    cen_send(var cen, ctrl_pdu(ll_data.OP_FEATURE_REQ, [0xFF, 0, 0, 0, 0, 0, 0, 0]))
    conn_run(var c, var cen, 5000, 200000, var host)
    var seen = false
    for p in cen.got
        if t_op(p) == ll_data.OP_FEATURE_RSP
            seen = true
            test.assert_eq(t_byte(p, 1), 0x7F)
    test.assert(seen)
    // The set is known: the Host's read is answered at once.
    test.assert_eq(cmd_status(var c, 0x2016, [1, 0]), 0)
    test.assert_eq(list.len(meta_events(run(var c, 0x1001, []), 0x04)), 1)
    test.assert_eq(cmd_status(var c, 0x2016, [5, 0]), 0x02)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_ping_and_unknown_control_pdus_are_answered()
    var c = connected(24, 200)
    var cen = first_central(24)
    var host: [Int] = []
    cen_send(var cen, ctrl_pdu(ll_data.OP_PING_REQ, []))
    cen_send(var cen, ctrl_pdu(0x1A, [1, 2, 3, 4, 5, 6, 7, 8]))
    conn_run(var c, var cen, 5000, 300000, var host)
    var rsp = 0
    var unk = 0
    for p in cen.got
        if t_op(p) == ll_data.OP_PING_RSP
            rsp = rsp + 1
        if t_op(p) == ll_data.OP_UNKNOWN_RSP
            unk = unk + 1
            test.assert_eq(t_byte(p, 1), 0x1A)
    test.assert_eq(rsp, 1)
    test.assert_eq(unk, 1)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_connection_update_changes_the_interval_and_tells_the_host()
    var c = connected(24, 400)
    var cen = first_central(24)
    var host: [Int] = []
    conn_run(var c, var cen, 5000, 100000, var host)
    // New interval of 48 units, window of 2 at offset 3, ten events on.
    let instant = cen.ev + 10
    cen.upd_instant = instant
    cen.upd_interval = 48
    cen.upd_offset = 3
    cen_send(var cen, ctrl_pdu(ll_data.OP_CONNECTION_UPDATE_IND,
        [2, 3, 0, 48, 0, 0, 0, 0x90, 0x01, instant & 0xFF, (instant >>> 8) & 0xFF]))
    conn_run(var c, var cen, 100000, 3000000, var host)
    test.assert(ll_link.link_live(var c.links[0]))
    test.assert_eq(c.links[0].interval, 48)
    test.assert_eq(cen.window_miss, 0)
    // The events after the instant are 60 ms apart.
    let n = list.len(cen.log_t)
    test.assert_eq(cen.log_t[n - 1] - cen.log_t[n - 2], 60000)
    let us = meta_events(host, 0x03)
    test.assert_eq(list.len(us), 1)
    test.assert_eq(us[0][2], 10)
    test.assert_eq(us[0][4], 0)
    test.assert_eq(us[0][5] | (us[0][6] << 8), 1)
    test.assert_eq(us[0][7] | (us[0][8] << 8), 48)
    test.assert_eq(us[0][11] | (us[0][12] << 8), 400)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_channel_map_update_and_read_channel_map()
    var c = connected(24, 200)
    var cen = first_central(24)
    var host: [Int] = []
    conn_run(var c, var cen, 5000, 50000, var host)
    let before = run(var c, 0x2015, [1, 0])
    test.assert_eq(before, [0x04, 0x0E, 0x0B, 0x01, 0x15, 0x20, 0x00, 1, 0, 0xFF, 0xFF, 0xFF, 0xFF, 0x1F])
    let instant = cen.ev + 8
    cen_send(var cen,
        ctrl_pdu(ll_data.OP_CHANNEL_MAP_IND, [0x1F, 0, 0, 0, 0, instant & 0xFF, (instant >>> 8) & 0xFF]))
    conn_run(var c, var cen, 50000, 600000, var host)
    let after = run(var c, 0x2015, [1, 0])
    test.assert_eq(after, [0x04, 0x0E, 0x0B, 0x01, 0x15, 0x20, 0x00, 1, 0, 0x1F, 0, 0, 0, 0])
    // Every event from the instant on uses channels 0 to 4, and the ones before
    // used others.
    var used = true
    var before = false
    for i in 0..list.len(cen.log_ch)
        if i >= instant and cen.log_ch[i] > 4
            used = false
        if i < instant and cen.log_ch[i] > 4
            before = true
    test.assert(used)
    test.assert(before)
    test.assert_eq(run(var c, 0x2015, [2, 0]), [0x04, 0x0E, 0x0B, 0x01, 0x15, 0x20, 0x02, 2, 0, 0, 0, 0, 0, 0])

// ── Errors on the air ───────────────────────────────────────────────

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_a_bad_crc_is_answered_without_acknowledging_and_the_central_sends_again()
    var c = connected(24, 200)
    var cen = first_central(24)
    cen_send(var cen, data_pdu(ll_data.LLID_START, 6, 0x20))
    var host: [Int] = []
    conn_run(var c, var cen, 5000, 60000, var host)
    cen.bad = 1
    cen_send(var cen, data_pdu(ll_data.LLID_START, 6, 0x70))
    conn_run(var c, var cen, 60000, 400000, var host)
    // Both reached the Host once, in order.
    let acl = acl_packets(host)
    test.assert_eq(list.len(acl), 2)
    test.assert_eq(acl[0][5], 0x20)
    test.assert_eq(acl[1][5], 0x70)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_two_bad_packets_in_a_row_close_the_event_without_an_answer()
    var c = connected(24, 200)
    var cen = first_central(24)
    var host: [Int] = []
    conn_run(var c, var cen, 5000, 60000, var host)
    cen.bad = 2
    cen_send(var cen, data_pdu(ll_data.LLID_START, 6, 0x70))
    conn_run(var c, var cen, 60000, 400000, var host)
    // The event with two bad packets in a row got one answer, not two; the data
    // is sent again and arrives once.
    test.assert(ll_link.link_live(var c.links[0]))
    test.assert_eq(list.len(acl_packets(host)), 1)
    test.assert_eq(acl_packets(host)[0][5], 0x70)

// ── The radio shared with advertising ───────────────────────────────

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_non_connectable_advertising_runs_between_connection_events_and_never_into_them()
    var c = connected(24, 200)
    test.assert_eq(status_of(var c, 0x2006, adv_params(3)), 0)
    test.assert_eq(status_of(var c, 0x2008, data31([2, 1, 6])), 0)
    test.assert_eq(status_of(var c, 0x200A, [1]), 0)
    var cen = first_central(24)
    var host: [Int] = []
    var air = adv_air_new()
    conn_run_adv(var c, var cen, var air, 5000, 1000000, var host)
    test.assert(ll_link.link_live(var c.links[0]))
    test.assert_eq(cen.window_miss, 0)
    // Advertising ran, and every PDU ended a guard before the Central's anchor.
    test.assert(air.pdus >= 10)
    test.assert_eq(air.overruns, 0)
    test.assert(cen.events >= 30)

// The advertising events of the executor: each PDU is placed on the air only
// when the arbiter says it fits, as the radio program does, and the number of
// PDUs and of those that ended too near the next anchor are counted.
struct AdvAir
    var pdus: Int
    var overruns: Int

fn adv_air_new() -> AdvAir
    AdvAir { pdus: 0, overruns: 0 }

fn adv_event(var c: ctl_hci.Controller, var cen: Cen, var air: AdvAir, start: Int) -> Int
    var now = start
    var more = true
    while more
        let start = ll_adv.adv_due(var c.adv)
        if start > now
            now = start
        ctl_hci.ctl_set_time(var c, now)
        ll_adv.adv_pdu_start(var c.adv, now)
        let end = now + ll_pdu.airtime_us(c.adv.pdu.n) + 150 + 214
        air.pdus = air.pdus + 1
        if end + 140 > ll_link.link_listen_start(var c.links[0]) and now < ll_link.link_listen_end(var c.links[0])
            air.overruns = air.overruns + 1
        now = end
        ctl_hci.ctl_set_time(var c, now)
        ctl_hci.ctl_adv_pdu_end(var c, now)
        more = c.adv.enabled and not ll_adv.adv_at_event_start(var c.adv)
        if more and not ctl_hci.ctl_ll_adv_room(var c)
            more = false
    now

fn conn_run_adv(var c: ctl_hci.Controller, var cen: Cen, var air: AdvAir, start: Int, until: Int,
                var host: [Int])
    var now = start
    var guard = 0
    while now < until and guard < 200000
        guard = guard + 1
        host_read(var c, var host)
        ctl_hci.ctl_set_time(var c, now)
        let cls = ctl_hci.ctl_ll_pick(var c, false)
        if cls == ll_arb.class_acl()
            if now < cen.anchor
                now = cen.anchor
            ctl_hci.ctl_set_time(var c, now)
            now = cen_event(var c, var cen)
            ctl_hci.ctl_set_time(var c, now)
            cen_next(var cen)
        else if cls == ll_arb.class_adv()
            now = adv_event(var c, var cen, var air, now)
        else
            let t = wake_time(var c)
            if t < 0 or t > until
                now = until
            else if t > now
                now = t
            else
                now = now + 1
    test.assert(guard < 200000)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_a_reset_drops_the_connection_without_an_event()
