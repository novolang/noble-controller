@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0 and noble_controller.CONFIG.CTL_LINKS >= 2)
@test
fn test_a_connect_ind_takes_the_free_slot_while_the_last_connection_is_unreported()
    var c = connected(24, 200)
    test.assert_eq(status_of(var c, 0x2006, adv_params(3)), 0)
    link_end(var c)
    var pol = ll_policy.default_link_policy()
    var p = connect_ind(24, 200, 0)
    // The Disconnection Complete of handle 1 is still owed; the new connection
    // takes the other slot, as handle 2.
    test.assert(ctl_hci.ctl_connect_ind(var c, var pol, var p, 9000))
    test.assert_eq(c.links[1].handle, 2)
    let r = run(var c, 0x1001, [])
    let ds = events_coded(r, 0x05)
    test.assert_eq(list.len(ds), 1)
    test.assert_eq(ds[0][4], 1)
    let cs = meta_events(r, 0x01)
    test.assert_eq(list.len(cs), 1)
    test.assert_eq(cs[0][5], 2)

// End the connection from the Link Layer's side, as a supervision timeout does.
fn link_end(var c: ctl_hci.Controller)
    ll_link.link_close(var c.links[0], 0x08)
    ctl_hci.ctl_conn_done(var c, 0, 9000)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_a_central_that_changes_nothing_but_the_anchor_leaves_the_host_unnotified_of_a_move()
    var c = connected(24, 400)
    var cen = first_central(24)
    var host: [Int] = []
    conn_run(var c, var cen, 5000, 100000, var host)
    // An update that keeps the interval, latency and timeout moves the anchor.
    let instant = cen.ev + 10
    cen.upd_instant = instant
    cen.upd_interval = 24
    cen.upd_offset = 2
    cen_send(var cen, ctrl_pdu(ll_data.OP_CONNECTION_UPDATE_IND,
        [2, 2, 0, 24, 0, 0, 0, 0x90, 0x01, instant & 0xFF, (instant >>> 8) & 0xFF]))
    conn_run(var c, var cen, 100000, 1500000, var host)
    test.assert(ll_link.link_live(var c.links[0]))
    test.assert_eq(cen.window_miss, 0)

// ── The data length and the PHY ─────────────────────────────────────

// The Host enables the LE events through LE PHY Update Complete.
fn enable_c7_events(var c: ctl_hci.Controller)
    test.assert_eq(status_of(var c, 0x2001, [0xFF, 0xFF, 0x0F, 0, 0, 0, 0, 0]), 0)

@test
fn test_the_data_length_commands_answer_with_their_defaults_and_refuse_bad_values()
    var c = fresh()
    // Supported_Max_TX_Octets, TX_Time, RX_Octets, RX_Time: 251, 17040 both ways.
    let m = run(var c, 0x202F, [])
    test.assert_eq(m[2], 12)
    test.assert_eq(m[6], 0)
    test.assert_eq(m[7] | (m[8] << 8), 251)
    test.assert_eq(m[9] | (m[10] << 8), 17040)
    test.assert_eq(m[11] | (m[12] << 8), 251)
    test.assert_eq(m[13] | (m[14] << 8), 17040)
    let s = run(var c, 0x2023, [])
    test.assert_eq(s[6], 0)
    test.assert_eq(s[7] | (s[8] << 8), 27)
    test.assert_eq(s[9] | (s[10] << 8), 328)
    test.assert_eq(status_of(var c, 0x2024, [26, 0, 0x48, 0x01]), 0x12)
    test.assert_eq(status_of(var c, 0x2024, [252, 0, 0x48, 0x01]), 0x12)
    test.assert_eq(status_of(var c, 0x2024, [27, 0, 0x47, 0x01]), 0x12)
    test.assert_eq(status_of(var c, 0x2024, [27, 0, 0x91, 0x42]), 0x12)
    test.assert_eq(status_of(var c, 0x2024, [100, 0, 0xE8, 0x03]), 0)
    let t = run(var c, 0x2023, [])
    test.assert_eq(t[7] | (t[8] << 8), 100)
    test.assert_eq(t[9] | (t[10] << 8), 1000)
    // A reset puts the defaults back.
    test.assert_eq(status_of(var c, 0x0C03, []), 0)
    let u = run(var c, 0x2023, [])
    test.assert_eq(u[7] | (u[8] << 8), 27)
    test.assert(not c.dl_sugg_set)

@test
fn test_the_phy_commands_check_the_masks_and_the_handle_without_a_connection()
    var c = fresh()
    test.assert_eq(status_of(var c, 0x2031, [0, 1, 2]), 0x11)
    test.assert_eq(status_of(var c, 0x2031, [0, 8, 8]), 0x11)
    test.assert_eq(status_of(var c, 0x2031, [0, 0, 0]), 0x12)
    test.assert_eq(status_of(var c, 0x2031, [1, 0, 2]), 0)
    test.assert(c.phy_def_set)
    test.assert_eq(c.phy_def_tx, 7)
    test.assert_eq(c.phy_def_rx, 2)
    test.assert_eq(status_of(var c, 0x2031, [3, 0, 0]), 0)
    test.assert(not c.phy_def_set)
    test.assert_eq(status_of(var c, 0x2031, [0, 3, 3]), 0)
    test.assert(c.phy_def_set)
    // No connection to name.
    let r = run(var c, 0x2030, [5, 0])
    test.assert_eq(r[6], 0x02)
    test.assert_eq(r[7] | (r[8] << 8), 5)
    test.assert_eq(r[9], 0)
    test.assert_eq(r[10], 0)
    test.assert_eq(cmd_status(var c, 0x2032, [5, 0, 0, 2, 2, 0, 0]), 0x02)
    let d = run(var c, 0x2022, [5, 0, 100, 0, 0xE8, 0x03])
    test.assert_eq(d[6], 0x02)
    test.assert_eq(d[7] | (d[8] << 8), 5)
    // The commands are listed in Supported Commands and the features say what they serve.
    let sc = run(var c, 0x1002, [])
    test.assert_eq((sc[7 + 33] >>> 6) & 3, 3)
    test.assert_eq(sc[7 + 34] & 1, 1)
    test.assert_eq((sc[7 + 35] >>> 3) & 15, 15)
    let f = run(var c, 0x2003, [])
    test.assert_eq(f[7] & 0x20, 0x20)
    test.assert_eq(f[8] & 0x09, 0x09)
    // Without the Link Layer the commands are not answered.
    var bare = ctl_hci.controller_new(0)
    test.assert_eq(status_of(var bare, 0x2031, [0, 1, 1]), 0x01)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_a_new_connection_asks_for_the_data_length_and_the_host_hears_the_change()
    var c = connected(24, 400)
    enable_c7_events(var c)
    var cen = first_central(24)
    cen.dle = true
    var host: [Int] = []
    conn_run(var c, var cen, 5000, 400000, var host)
    test.assert_eq(list.len(cen.lens), 1)
    // The Controller's own limits: it receives and sends 251 octets in 2120 microseconds.
    test.assert_eq(t_byte(cen.lens[0], 1) | (t_byte(cen.lens[0], 2) << 8), 251)
    test.assert_eq(t_byte(cen.lens[0], 3) | (t_byte(cen.lens[0], 4) << 8), 2120)
    test.assert_eq(t_byte(cen.lens[0], 5) | (t_byte(cen.lens[0], 6) << 8), 251)
    test.assert_eq(t_byte(cen.lens[0], 7) | (t_byte(cen.lens[0], 8) << 8), 2120)
    let ev = meta_events(host, 0x07)
    test.assert_eq(list.len(ev), 1)
    // Handle, then the transmit octets and time, then the receive octets and time.
    test.assert_eq(ev[0][4] | (ev[0][5] << 8), 1)
    test.assert_eq(ev[0][6] | (ev[0][7] << 8), 251)
    test.assert_eq(ev[0][8] | (ev[0][9] << 8), 2120)
    test.assert_eq(ev[0][10] | (ev[0][11] << 8), 251)
    test.assert_eq(ev[0][12] | (ev[0][13] << 8), 2120)
    test.assert(not c.links[0].dl_wait)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_a_central_without_the_data_length_extension_keeps_the_connection_at_27_octets()
    var c = connected(24, 400)
    enable_c7_events(var c)
    var cen = first_central(24)
    var host: [Int] = []
    conn_run(var c, var cen, 5000, 400000, var host)
    test.assert_eq(list.len(cen.lens), 1)
    test.assert(c.links[0].dl_unsup)
    test.assert_eq(list.len(meta_events(host, 0x07)), 0)
    test.assert_eq(ll_link.tx_limit(var c.links[0]), 27)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_set_data_length_tells_the_peer_and_cuts_a_longer_packet_into_pieces_for_one_buffer()
    var c = connected(24, 400)
    enable_c7_events(var c)
    var cen = first_central(24)
    cen.dle = true
    cen.dle_rx = 60
    var host: [Int] = []
    conn_run(var c, var cen, 5000, 300000, var host)
    // The Central takes 60 octets: a packet of 150 octets from the Host goes out in three PDUs and the
    // Host's buffer comes back once.
    var acl: [Int] = []
    for i in 0..150
        list.push(acl, i)
    feed(var c, host_acl(1, 0, acl))
    conn_run(var c, var cen, 300000, 700000, var host)
    var sizes: [Int] = []
    for p in cen.got
        if t_llid(p) != ll_data.LLID_CONTROL
            list.push(sizes, t_len(p))
    test.assert_eq(sizes, [60, 60, 30])
    test.assert_eq(t_llid(cen.got[0]), ll_data.LLID_START)
    test.assert_eq(t_llid(cen.got[1]), ll_data.LLID_CONTINUE)
    var total = 0
    for e in events_coded(host, 0x13)
        total = total + (e[6] | (e[7] << 8))
    test.assert_eq(total, 1)
    // The Host sets 100 octets and 1000 microseconds: a Command Complete with the handle, and the request goes.
    let r = run(var c, 0x2022, [1, 0, 100, 0, 0xE8, 0x03])
    test.assert_eq(r[6], 0)
    test.assert_eq(r[7] | (r[8] << 8), 1)
    conn_run(var c, var cen, 700000, 900000, var host)
    test.assert_eq(list.len(cen.lens), 2)
    test.assert_eq(t_byte(cen.lens[1], 5) | (t_byte(cen.lens[1], 6) << 8), 100)
    test.assert_eq(t_byte(cen.lens[1], 7) | (t_byte(cen.lens[1], 8) << 8), 1000)
    let bad = run(var c, 0x2022, [1, 0, 20, 0, 0xE8, 0x03])
    test.assert_eq(bad[6], 0x12)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_a_peer_request_for_the_data_length_is_answered_and_masked_events_are_not_sent()
    var c = connected(24, 400)
    var cen = first_central(24)
    // The LE Meta event for the Data Length Change is not in the Host's mask.
    cen_send(var cen, ctrl_pdu(ll_data.OP_LENGTH_REQ, [251, 0, 0x48, 0x08, 100, 0, 0xE8, 0x03]))
    var host: [Int] = []
    conn_run(var c, var cen, 5000, 400000, var host)
    var answered = false
    for p in cen.got
        if t_op(p) == ll_data.OP_LENGTH_RSP
            answered = true
            test.assert_eq(t_byte(p, 1) | (t_byte(p, 2) << 8), 251)
    test.assert(answered)
    test.assert_eq(list.len(meta_events(host, 0x07)), 0)
    test.assert_eq(c.links[0].dl_rem_tx_octets, 100)
    test.assert_eq(c.links[0].dl_ev_rx_octets, 100)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_set_phy_asks_the_central_and_the_host_hears_the_result_at_the_instant()
    var c = connected(24, 400)
    enable_c7_events(var c)
    var cen = first_central(24)
    cen.dle = true
    var host: [Int] = []
    conn_run(var c, var cen, 5000, 200000, var host)
    // LE Read PHY: LE 1M both ways.
    let r0 = run(var c, 0x2030, [1, 0])
    test.assert_eq(r0[6], 0)
    test.assert_eq(r0[9], 1)
    test.assert_eq(r0[10], 1)
    // LE Set PHY, LE 2M both ways: the Command Status, then the request to the Central.
    test.assert_eq(cmd_status(var c, 0x2032, [1, 0, 0, 2, 2, 0, 0]), 0)
    conn_run(var c, var cen, 200000, 260000, var host)
    test.assert_eq(list.len(cen.phys), 1)
    test.assert_eq(t_byte(cen.phys[0], 1), 2)
    test.assert_eq(t_byte(cen.phys[0], 2), 2)
    // The Central answers with the update, the instant ten events on.
    let instant = cen.ev + 10
    cen_send(var cen, ctrl_pdu(ll_data.OP_PHY_UPDATE_IND, [2, 2, instant & 0xFF, (instant >>> 8) & 0xFF]))
    conn_run(var c, var cen, 260000, 800000, var host)
    let ev = meta_events(host, 0x0C)
    test.assert_eq(list.len(ev), 1)
    // Status, handle, TX_PHY, RX_PHY.
    test.assert_eq(ev[0][4], 0)
    test.assert_eq(ev[0][5] | (ev[0][6] << 8), 1)
    test.assert_eq(ev[0][7], 2)
    test.assert_eq(ev[0][8], 2)
    let r1 = run(var c, 0x2030, [1, 0])
    test.assert_eq(r1[9], 2)
    test.assert_eq(r1[10], 2)
    test.assert_eq(c.links[0].phy, 2)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_a_masked_phy_update_complete_is_not_sent_and_a_second_set_phy_is_disallowed_while_one_runs()
    var c = connected(24, 400)
    var cen = first_central(24)
    cen.dle = true
    var host: [Int] = []
    conn_run(var c, var cen, 5000, 200000, var host)
    test.assert_eq(cmd_status(var c, 0x2032, [1, 0, 0, 2, 2, 0, 0]), 0)
    test.assert_eq(cmd_status(var c, 0x2032, [1, 0, 0, 1, 1, 0, 0]), 0x0C)
    conn_run(var c, var cen, 200000, 260000, var host)
    let instant = cen.ev + 10
    cen_send(var cen, ctrl_pdu(ll_data.OP_PHY_UPDATE_IND, [2, 2, instant & 0xFF, (instant >>> 8) & 0xFF]))
    conn_run(var c, var cen, 260000, 800000, var host)
    test.assert_eq(c.links[0].phy, 2)
    test.assert_eq(list.len(meta_events(host, 0x0C)), 0)
    test.assert(not ll_link.link_owes(var c.links[0], ll_link.EV_PHY))

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_the_default_phy_of_the_host_is_asked_for_by_the_new_connection_itself()
    var c = fresh()
    test.assert_eq(status_of(var c, 0x2031, [0, 2, 2]), 0)
    test.assert_eq(status_of(var c, 0x2024, [120, 0, 0xB0, 0x04]), 0)
    advertise(var c, 0)
    ctl_hci.ctl_set_time(var c, 1000)
    var pol = ll_policy.default_link_policy()
    var p = connect_ind(24, 400, 0)
    test.assert(ctl_hci.ctl_connect_ind(var c, var pol, var p, 5000))
    var cen = first_central(24)
    cen.dle = true
    var host: [Int] = []
    conn_run(var c, var cen, 5000, 600000, var host)
    // The Host's suggested length is the start of the Controller's own limits for the transmit side.
    test.assert_eq(t_byte(cen.lens[0], 5) | (t_byte(cen.lens[0], 6) << 8), 120)
    test.assert_eq(t_byte(cen.lens[0], 7) | (t_byte(cen.lens[0], 8) << 8), 1200)
    // The request for LE 2M goes out after the length procedure and a few events.
    test.assert_eq(list.len(cen.phys), 1)
    test.assert_eq(t_byte(cen.phys[0], 1), 2)
    test.assert(not c.links[0].phy_host)

// ── Read Transmit Power Level, Read RSSI, LE Channel Selection Algorithm ─────

// A Peripheral link in slot 0 (handle 1) beside a Host that enabled the LE events of
// `le_low`.
fn linked(le_low: Int, chsel: Bool) -> ctl_hci.Controller
    var c = fresh()
    test.assert_eq(status_of(var c, 0x2001, [le_low & 0xFF, (le_low >>> 8) & 0xFF, (le_low >>> 16) & 0xFF, 0, 0, 0, 0, 0]),
        0)
    advertise(var c, 0)
    var pol = ll_policy.default_link_policy()
    var p = connect_ind(24, 200, 0)
    if chsel
        p.b[0] = (p.b[0] as Int | ll_pdu.CHSEL) as u8
    test.assert(ctl_hci.ctl_connect_ind(var c, var pol, var p, 5000))
    c

fn bytes_of_status(opcode: Int, status: Int) -> [Int]
    [0x04, 0x0E, 0x04, 0x01, opcode & 0xFF, (opcode >>> 8) & 0xFF, status]

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_the_channel_selection_algorithm_event_follows_the_connection_complete()
    // The event is bit 19 of the LE event mask, which a Host sets: algorithm #1 and #2.
    var a = linked(0x08001F, false)
    let ea = events_coded(run(var a, 0x1001, []), 0x3E)
    test.assert_eq(list.len(ea), 2)
    test.assert_eq(ea[0][3], 0x01)
    test.assert_eq(ea[1][3], 0x14)
    test.assert_eq(ea[1][4] | (ea[1][5] << 8), 1)
    test.assert_eq(ea[1][6], 0)
    var b = linked(0x08001F, true)
    let eb = events_coded(run(var b, 0x1001, []), 0x3E)
    test.assert_eq(list.len(eb), 2)
    test.assert_eq(eb[1][3], 0x14)
    test.assert_eq(eb[1][6], 1)
    // The Enhanced event is followed by it too.
    var d = linked(0x08021F, false)
    let ed = events_coded(run(var d, 0x1001, []), 0x3E)
    test.assert_eq(ed[0][3], 0x0A)
    test.assert_eq(ed[1][3], 0x14)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_the_channel_selection_algorithm_event_is_not_sent_when_masked()
    var c = linked(0x1F, true)
    let e = events_coded(run(var c, 0x1001, []), 0x3E)
    test.assert_eq(list.len(e), 1)
    test.assert_eq(e[0][3], 0x01)
    test.assert(not ll_link.link_owes(var c.links[0], ll_link.EV_CHSEL))

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_read_transmit_power_level_answers_for_a_connection()
    var c = linked(0x1F, false)
    let _x = run(var c, 0x1001, [])
    // Type 0 is the current level, type 1 the maximum.
    test.assert_eq(run(var c, 0x0C2D, [1, 0, 0]),
        [0x04, 0x0E, 0x07, 0x01, 0x2D, 0x0C, 0x00, 1, 0, ctl_hci.TX_POWER_DBM & 0xFF])
    test.assert_eq(run(var c, 0x0C2D, [1, 0, 1]),
        [0x04, 0x0E, 0x07, 0x01, 0x2D, 0x0C, 0x00, 1, 0, ctl_hci.TX_POWER_MAX_DBM])
    // A Type outside 0 and 1 and a handle that is not a connection are refused.
    test.assert_eq(run(var c, 0x0C2D, [1, 0, 2]), [0x04, 0x0E, 0x07, 0x01, 0x2D, 0x0C, 0x12, 1, 0, 0])
    test.assert_eq(run(var c, 0x0C2D, [5, 0, 0]), [0x04, 0x0E, 0x07, 0x01, 0x2D, 0x0C, 0x02, 5, 0, 0])
    // The command takes three parameters.
    test.assert_eq(run(var c, 0x0C2D, [1, 0]), bytes_of_status(0x0C2D, 0x12))

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_read_rssi_reports_the_last_packet_of_the_link()
    var c = linked(0x1F, false)
    let _x = run(var c, 0x1001, [])
    // 127 says the radio gave no reading yet.
    test.assert_eq(run(var c, 0x1405, [1, 0]), [0x04, 0x0E, 0x07, 0x01, 0x05, 0x14, 0x00, 1, 0, 127])
    ctl_hci.lk_note_rssi(var c, 0, -60)
    test.assert_eq(run(var c, 0x1405, [1, 0]), [0x04, 0x0E, 0x07, 0x01, 0x05, 0x14, 0x00, 1, 0, 0xC4])
    test.assert_eq(run(var c, 0x1405, [7, 0]), [0x04, 0x0E, 0x07, 0x01, 0x05, 0x14, 0x02, 7, 0, 0])
    test.assert_eq(run(var c, 0x1405, [1]), bytes_of_status(0x1405, 0x12))
