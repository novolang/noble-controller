    for op in [0x0406, 0x041D, 0x2015, 0x2016]
        test.assert_eq(status_of(var c, op, zeros((if op == 0x0406 then 3 else 2))), 0x01)

@test
fn test_the_supported_commands_name_the_connection_commands()
    var c = fresh()
    let r = run(var c, 0x1002, [])
    let base = 7
    test.assert_eq(r[base + 0] & 0x20, 0x20)
    test.assert_eq(r[base + 2] & 0x80, 0x80)
    test.assert_eq(r[base + 27] & 0x30, 0x30)

// ── Events that wait for a slot, masked events, defensive paths ─────

// Set what the Link Layer owes the Host, for a test.
fn set_owed(var c: ctl_hci.Controller, v: Int)
    c.links[0].owed = v

fn set_completed(var c: ctl_hci.Controller, v: Int)
    c.links[0].completed = v

fn set_feat_status(var c: ctl_hci.Controller, v: Int)
    c.links[0].feat_status = v

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_events_wait_for_a_free_slot_and_go_out_in_the_order_they_came()
    var c = connected(24, 200)
    var cen = first_central(24)
    var host: [Int] = []
    conn_run(var c, var cen, 5000, 100000, var host)
    // Every slot taken: the update, version and features events cannot be built.
    for _ in 0..4
        test.assert(ctl_pool.pool_take(var c.pool) >= 0)
    set_owed(var c, ll_link.EV_UPDATED | ll_link.EV_VERSION | ll_link.EV_FEATURES | ll_link.EV_COMPLETED)
    set_completed(var c, 2)
    ctl_hci.ctl_flush_events(var c)
    test.assert_eq(c.links[0].owed,
        ll_link.EV_UPDATED | ll_link.EV_VERSION | ll_link.EV_FEATURES | ll_link.EV_COMPLETED)
    // One slot at a time: each event goes when one is free, in that order.
    ctl_pool.pool_give(var c.pool, 0)
    ctl_hci.ctl_flush_events(var c)
    test.assert(not ll_link.link_owes(var c.links[0], ll_link.EV_UPDATED))
    test.assert(ll_link.link_owes(var c.links[0], ll_link.EV_VERSION))
    var out = drain(var c)
    test.assert_eq(list.len(meta_events(out, 0x03)), 1)
    ctl_hci.ctl_flush_events(var c)
    test.assert(not ll_link.link_owes(var c.links[0], ll_link.EV_VERSION))
    out = drain(var c)
    test.assert_eq(list.len(events_coded(out, 0x0C)), 1)
    ctl_hci.ctl_flush_events(var c)
    test.assert(not ll_link.link_owes(var c.links[0], ll_link.EV_FEATURES))
    out = drain(var c)
    test.assert_eq(list.len(meta_events(out, 0x04)), 1)
    ctl_hci.ctl_flush_events(var c)
    out = drain(var c)
    test.assert_eq(list.len(events_coded(out, 0x13)), 1)
    test.assert_eq(c.links[0].owed, 0)
    // The Disconnection Complete and the connection one wait for a slot too.
    for _ in 0..4
        let s = ctl_pool.pool_take(var c.pool)
        test.assert(s >= 0 or s == ctl_pool.NO_SLOT)
    set_owed(var c, ll_link.EV_CONNECTED)
    ctl_hci.ctl_flush_events(var c)
    test.assert(ll_link.link_owes(var c.links[0], ll_link.EV_CONNECTED))
    set_owed(var c, ll_link.EV_DISCONNECTED)
    ctl_hci.ctl_flush_events(var c)
    test.assert(ll_link.link_owes(var c.links[0], ll_link.EV_DISCONNECTED))

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_masked_events_are_dropped_not_kept()
    var c = connected(24, 200)
    // The LE mask lets only the Connection Complete through, and the event mask
    // no Read Remote Version Information Complete.
    test.assert_eq(status_of(var c, 0x2001, [0x01, 0, 0, 0, 0, 0, 0, 0]), 0)
    test.assert_eq(status_of(var c, 0x0C01, [0xFF, 0xF7, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x3F]), 0)
    set_owed(var c, ll_link.EV_UPDATED | ll_link.EV_VERSION | ll_link.EV_FEATURES)
    ctl_hci.ctl_flush_events(var c)
    test.assert_eq(c.links[0].owed, 0)
    let out = drain(var c)
    test.assert_eq(list.len(events_coded(out, 0x0C)), 0)
    test.assert_eq(list.len(meta_events(out, 0x03)), 0)
    test.assert_eq(list.len(meta_events(out, 0x04)), 0)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_features_that_failed_are_reported_with_zeros()
