@test
fn test_a_group_of_more_than_two_streams_is_checked_against_the_ramp_up_of_the_radio()
    if not ctl_limits.iso_on() or ctl_limits.cis_slots() < 4
        return
    // The radio with a fast ramp-up takes three and four streams in either packing.
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    ll_air.air_profile(var air, var c)
    cis_cen_connect(var c, var rf, var air)
    for n in 3..5
        test.assert_eq(complete_of_ctl(var c, 0x2062, cig_request_full(n, 0, 1, 40, 40, 3, 10000, 20))[6], 0)
        test.assert_eq(complete_of_ctl(var c, 0x2062, cig_request_full(n, 1, 1, 40, 40, 3, 10000, 20))[6], 0)
    // The radio without one needs more than T_MSS_CIS between subevents: three or four streams of one subevent follow
    // one another too close in both packings, and so do the subevents of a stream.
    var s = fresh()
    var rf2 = ll_air.rf_new()
    var air2 = sim_new()
    slow_board(var s, var air2)
    cis_cen_connect(var s, var rf2, var air2)
    for n in 3..5
        test.assert_eq(complete_of_ctl(var s, 0x2062, cig_request_full(n, 0, 0, 40, 40, 3, 10000, 20))[6], 0x11)
        test.assert_eq(complete_of_ctl(var s, 0x2062, cig_request_full(n, 1, 0, 40, 40, 3, 10000, 20))[6], 0x11)
        test.assert_eq(complete_of_ctl(var s, 0x2062, cig_request_full(n, 0, 1, 40, 40, 3, 10000, 20))[6], 0x11)
    test.assert(s.links[0].live)

// The packets the Controller has completed for `handle` among the octets of `bytes` from the index `from` on, the sum of the counts of
// the Number Of Completed Packets events, and the index the complete packets end at: [count, end].
fn credits_in(bytes: [Int], from: Int, handle: Int) -> [Int]
    var n = 0
    var i = from
    while i + 5 <= list.len(bytes)
        var len = 0
        if bytes[i] == 0x04
            len = 3 + bytes[i + 2]
        else if bytes[i] == 0x05
            len = 5 + bytes[i + 3] + ((bytes[i + 4] & 0x3F) << 8)
        else
            break
        if i + len > list.len(bytes)
            break
        if bytes[i] == 0x04 and bytes[i + 1] == 0x13
            let cnt = bytes[i + 3]
            for k in 0..cnt
                if (bytes[i + 4 + 2 * k] | (bytes[i + 5 + 2 * k] << 8)) == handle
                    n = n + (bytes[i + 4 + 2 * cnt + 2 * k] | (bytes[i + 5 + 2 * cnt + 2 * k] << 8))
        i = i + len
    [n, i]

// Run the program as `cis_run` does, with a Host that sends an SDU of `feed` octets to the stream in slot 0 only when `buffers` or
// fewer of the packets it sent are not completed (each HCI ISO Data packet is a credit): returns the SDUs sent.
fn cis_run_credits(var c: ctl_hci.Controller, var rf: ll_air.Rf, var air: SimAir, until: Int,
                   feed: Int, buffers: Int) -> Int
    var rx = ll_pdu.pdu_new()
    var policy = ll_policy.default_link_policy()
    var cc = ll_ccm.soft_cipher_new()
    var guard = 0
    let start = c.cis[0].sdu_in
    var seq = start
    var packets = 0
    var got = 0
    var pos = list.len(air.host)
    let per = (4 + feed + ll_iso.ISO_LOAD - 1) / ll_iso.ISO_LOAD
    while air.now < until and guard < 600000
        guard = guard + 1
        if packets - got + per <= buffers and ctl_hci.ctl_accepts(var c) and c.cis[0].state == ll_iso.S_UP
            for b in host_iso(c.cis[0].handle, seq, feed)
                ctl_hci.ctl_rx(var c, b)
            seq = seq + 1
            packets = packets + per
        let _ran = ctl_hci.ctl_step(var c)
        while ctl_hci.ctl_tx_pending(var c)
            list.push(air.host, ctl_hci.ctl_tx_next(var c))
        let cr = credits_in(air.host, pos, c.cis[0].handle)
        got = got + cr[0]
        pos = cr[1]
        let before = air.now
        ll_air.ll_poll(var air, var c, var rf, var rx, var policy, var cc)
        if air.now == before
            air.now = air.now + 10
    test.assert(guard < 600000)
    seq - start

@test
fn test_a_host_that_waits_for_the_credit_of_each_sdu_sends_one_in_every_iso_interval()
    if not ctl_limits.iso_on() or ctl_limits.cis_slots() < 1
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    cis_cen_up_req(var c, var rf, var air, 1, 0, 0, 280, false, cig_request_full(1, 0, 2, 310, 280, 3, 20000, 60))
    let n0 = c.cis[0].n_events
    let sent = cis_run_credits(var c, var rf, var air, air.now + 2000000, 310, 3)
    let events = c.cis[0].n_events - n0
    test.assert(events >= 90)
    test.assert_eq(sent, events)

// ── LE Extended Create Connection ───────────────────────────────────
//
// The Controller initiates for the device 0x30..0x35 on the simulated air.  The advertiser's packets are
// scripted: an ADV_EXT_IND on the primary channel 37 whose Auxiliary Pointer says channel 12, `offset`
// units after its first bit, then the AUX_ADV_IND on channel 12 at that time, and the AUX_CONNECT_RSP
// the advertiser answers the Controller's AUX_CONNECT_REQ with.

// An extended advertising PDU of the type `ty` and AdvMode `mode` with the fields the flags announce:
// AdvA (bit 0) of `first`, TargetA (bit 1) of `target`, ADI (bit 3) and the Auxiliary Pointer (bit 4)
// to channel `ch`, `offset` units of 30 microseconds and `phy` (0: LE 1M, 1: LE 2M).
fn ext_pdu(ty: Int, mode: Int, flags: Int, first: Int, target: Int, ch: Int, offset: Int,
           phy: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    var body: [Int] = [flags]
    if (flags & 1) != 0
        for k in 0..6
            list.push(body, first + k)
    if (flags & 2) != 0
        for k in 0..6
            list.push(body, target + k)
    if (flags & 8) != 0
        list.push(body, 0x34)
        list.push(body, 0x12)
    if (flags & 16) != 0
        list.push(body, ch)
        list.push(body, offset & 0xFF)
        list.push(body, ((offset >>> 8) & 0x1F) | (phy << 5))
    ll_pdu.pdu_begin(var p, ty, 0, 0)
    let _h = ll_pdu.pdu_put(var p, list.len(body) | (mode << 6))
    for v in body
        let _b = ll_pdu.pdu_put(var p, v)
    ll_pdu.pdu_finish(var p)
    p

fn ext_set(lo: Int, hi: Int, timeout: Int) -> [Int]
    var p: [Int] = []
    for v in [16, 16, lo, hi, 0, timeout, 0, 0]
        list.push(p, v & 0xFF)
        list.push(p, v >>> 8)
    p

// LE Extended Create Connection to the device 0x30..0x35 on the Initiating_PHYs `phys`: the set of LE 1M has the
// interval 24, the set of LE 2M (when `phys` has it) 40 to 60.
fn ext_create_connection(phys: Int, policy: Int) -> [Int]
    var p: [Int] = [policy, 0, 0]
    for i in 0..6
        list.push(p, 0x30 + i)
    list.push(p, phys)
    for b in ext_set(24, 24, 200)
        list.push(p, b)
    if (phys & 2) != 0
        for b in ext_set(40, 60, 300)
            list.push(p, b)
    p

// The Controller as Central through LE Extended Create Connection: the Host's events are enabled and the command is sent.
fn ext_start(var c: ctl_hci.Controller, var air: SimAir, params: [Int])
    test.assert_eq(status_of(var c, 0x2001, [0xFF, 0xFF, 0x0F, 0, 0, 0, 0, 0]), 0)
    test.assert_eq(status_of(var c, 0x0C63, [0, 0, 0, 0, 0, 0, 0, 0]), 0)
    air.periph = true
    test.assert_eq(cmd_status(var c, 0x2043, params), 0)

// The advertiser's three packets: the ADV_EXT_IND at 2000 on channel 37 with the pointer to channel 12 after
// 3000 microseconds on `phy`, the AUX_ADV_IND at 5000 and the AUX_CONNECT_RSP to the request.
fn ext_advertiser(var air: SimAir, mode: Int, flags: Int, phy: Int, answer: Bool)
    hear(var air, 2000, 37, ext_pdu(7, mode, 0x18, 0, 0, 12, 100, phy))
    hear(var air, 5000, 12, ext_pdu(7, mode, flags, 0x30, 0x10, 0, 0, 0))
    if answer
        react(var air, 5, 12, ext_pdu(8, 0, 0x03, 0x30, 0x10, 0, 0, 0), 1)

// The index of the last packet of type `ty` the Controller sent on the advertising channels' access address.
fn last_tx_of(var air: SimAir, ty: Int) -> Int
    var k = -1
    for i in 0..list.len(air.tx_t)
        // (The legacy initiating window does not set an access address, so the simulated air still holds 0.)
        if air.tx_ty[i] == ty and (air.tx_aa[i] == ll_radio.ADV_ACCESS_ADDRESS or air.tx_aa[i] == 0)
            k = i
    k

// The index of the first packet of the Central on a connection (not the advertising channels' access address).
fn first_data_tx(var air: SimAir) -> Int
    for i in 0..list.len(air.tx_t)
        if air.tx_aa[i] != ll_radio.ADV_ACCESS_ADDRESS and air.tx_aa[i] != 0
            return i
    -1

@when(noble_controller.CONFIG.CTL_CENTRAL > 0)
@test
fn test_extended_create_connection_connects_to_a_legacy_advertiser_with_the_set_of_le_1m()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    ext_start(var c, var air, ext_create_connection(3, 0))
    hear(var air, 2000, 37, from_peer(ll_pdu.ADV_IND, 5))
    run(var c, var rf, var air, 300000)
    test.assert(c.links[0].live)
    test.assert(c.links[0].central)
    test.assert_eq(rf.init_sent, 1)
    test.assert_eq(rf.cen_aborts, 0)
    test.assert_eq(rf.ramp_timeouts, 0)
    // The CONNECT_IND went out T_IFS after the advertisement on channel 37, with the interval of LE 1M, and the
    // transmit window is 1.25 ms after its end.
    let k = last_tx_of(var air, 5)
    test.assert(k >= 0)
    test.assert_eq(air.tx_ch[k], 37)
    test.assert_eq(air.tx_t[k], 2000 + (5 + 6 + 2 + 8) * 8 + 150)
    test.assert_eq(air.tx_body[k][24], 24)
    test.assert_eq(c.links[0].interval, 24)
    test.assert_eq(c.links[0].phy, 1)
    test.assert_eq(c.init.aux_followed, 0)
    let d = first_data_tx(var air)
    test.assert_eq(air.tx_t[d], air.tx_t[k] + (36 + 8) * 8 + 1250)
    test.assert_eq(list.len(meta_events(air.host, 0x0A)), 1)

@when(noble_controller.CONFIG.CTL_CENTRAL > 0)
@test
fn test_extended_create_connection_follows_an_adv_ext_ind_and_connects_through_the_aux_packets()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    ext_start(var c, var air, ext_create_connection(1, 0))
    ext_advertiser(var air, 1, 0x09, 0, true)
    run(var c, var rf, var air, 300000)
    test.assert(c.links[0].live)
    test.assert(c.links[0].central)
    test.assert(rf.cen_events >= 5)
    test.assert_eq(rf.init_sent, 1)
    test.assert_eq(rf.conn_open, 1)
    test.assert_eq(rf.cen_aborts, 0)
    test.assert_eq(rf.ramp_timeouts, 0)
    test.assert_eq(rf.chain_cut, 0)
    test.assert_eq(c.init.aux_seen, 1)
    test.assert_eq(c.init.aux_followed, 1)
    test.assert_eq(c.init.aux_connects, 1)
    test.assert_eq(c.init.aux_missed, 0)
    test.assert_eq(c.init.aux_rsp_missed, 0)
    // The ADV_EXT_IND was not answered: the first packet the Controller sent is the request, on channel 12 T_IFS
    // after the end of the AUX_ADV_IND (12 octets from 5000), and it is a CONNECT_IND with the AdvA of the
    // advertiser and the interval of the set; its ChSel bit is reserved and clear, and the connection uses
    // channel selection algorithm #2 all the same.
    test.assert_eq(count_tx(var air, 5), 1)
    let k = last_tx_of(var air, 5)
    test.assert_eq(air.tx_ch[k], 12)
    test.assert_eq(air.tx_t[k], 5000 + (12 + 8) * 8 + 150)
    test.assert_eq(air.tx_h[k] & 0xE0, 0x00)
    test.assert_eq(air.tx_body[k][8], 0x30)
    test.assert_eq(air.tx_body[k][13], 0x35)
    test.assert_eq(air.tx_body[k][2], 0x10)
    test.assert_eq(air.tx_body[k][24], 24)
    test.assert(c.links[0].csa2)
    // The first connection event is due 2.5 ms after the end of the request, the extra 1.25 ms of an AUX_CONNECT_REQ.
    let d = first_data_tx(var air)
    test.assert_eq(air.tx_t[d], air.tx_t[k] + (36 + 8) * 8 + 2500)
    // The Host got the Enhanced Connection Complete event, as Central, of the advertiser.
    let ev = meta_events(air.host, 0x0A)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0)
    test.assert_eq(ev[0][7], 0)
    test.assert_eq(ev[0][9], 0x30)
    test.assert_eq(air.holds, air.releases)

@when(noble_controller.CONFIG.CTL_CENTRAL > 0)
@test
fn test_extended_create_connection_uses_the_set_and_the_phy_of_a_secondary_channel_on_le_2m()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    ext_start(var c, var air, ext_create_connection(3, 0))
    ext_advertiser(var air, 1, 0x09, 1, true)
