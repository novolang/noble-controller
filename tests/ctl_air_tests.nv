    test.assert_eq(list.len(est), 1)
    test.assert_eq(est[0][4], 0x3E)
    test.assert_eq(d.bigs[0].state, ll_big.B_FREE)
    // The packets stop at 550 ms: the synchronization times out at the BIG_Sync_Timeout (100 ms), with Connection Timeout.
    var e = fresh()
    var rf3 = ll_air.rf_new()
    var air3 = sim_new()
    big_replay(var air, var air3, [aa], 550000, 100000000, -1)
    big_sink(var e, var rf3, var air3, [1], 0, 0, 0x0A, 900000)
    test.assert_eq(meta_events(air3.host, 0x1D)[0][4], 0)
    let lost = meta_events(air3.host, 0x1E)
    test.assert_eq(list.len(lost), 1)
    test.assert_eq(lost[0][5], 0x08)

@when(noble_controller.CONFIG.CTL_BIS >= 2)
@test
fn test_le_big_create_sync_and_terminate_sync_answer_the_errors_of_the_specification()
    if not ctl_limits.big_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    big_source(var c, var rf, var air, 2, 0, 0, 500000, 10, 0)
    var d = fresh()
    var rf2 = ll_air.rf_new()
    var air2 = sim_new()
    big_replay(var air, var air2, [], 0, 0, -1)
    // No synchronization: Unknown Advertising Identifier.
    test.assert_eq(cmd_status(var d, 0x206B, big_sync_params(0, 0, 0, 0x64, [1])), 0x42)
    xscan_on(var d, 0, 0)
    test.assert_eq(status_of(var d, 0x2001, v1_sync_mask()), 0)
    test.assert_eq(big_psync(var d, 400), 0)
    run(var d, var rf2, var air2, 150000)
    let h = meta_events(air2.host, 0x0E)[0][5]
    // Out-of-range values: the BIS_Number 0 and 32, a list not ascending and with a duplicate, a timeout under 100 ms, MSE over 31, a
    // handle over 0xEF, none listed, and a length that disagrees with the count.
    test.assert_eq(cmd_status(var d, 0x206B, big_sync_params(h, 0, 0, 0x64, [0])), 0x12)
    test.assert_eq(cmd_status(var d, 0x206B, big_sync_params(h, 0, 0, 0x64, [32])), 0x12)
    test.assert_eq(cmd_status(var d, 0x206B, big_sync_params(h, 0, 0, 0x64, [2, 1])), 0x12)
    test.assert_eq(cmd_status(var d, 0x206B, big_sync_params(h, 0, 0, 0x64, [1, 1])), 0x12)
    test.assert_eq(cmd_status(var d, 0x206B, big_sync_params(h, 0, 0, 5, [1])), 0x12)
    test.assert_eq(cmd_status(var d, 0x206B, big_sync_params(h, 0, 32, 0x64, [1])), 0x12)
    var many: [Int] = []
    for k in 1..ctl_limits.bis_slots() + 2
        list.push(many, k)
    // (Num_BIS is 1 to 31: with 31 slots the list is 32 long and the command is Invalid HCI Command Parameters.)
    var beyond = 0x0D
    if ctl_limits.bis_slots() + 1 > 31
        beyond = 0x12
    test.assert_eq(cmd_status(var d, 0x206B, big_sync_params(h, 0, 0, 0x64, many)), beyond)
    // The right request; then a second while the first waits, and the same BIG_Handle.
    run(var d, var rf2, var air2, 250000)
    test.assert_eq(cmd_status(var d, 0x206B, big_sync_params(h, 0, 0, 0x64, [1])), 0)
    test.assert_eq(cmd_status(var d, 0x206B, big_sync_params(h, 0, 0, 0x64, [1])), 0x0C)
    // LE BIG Terminate Sync of the group that is being made: Sync Established with Operation Cancelled by Host (0x44); an unknown BIG: 0x42.
    send(var d, 0x206C, [0])
    let _r = ctl_hci.ctl_step(var d)
    let done = drain(var d)
    test.assert_eq(done[6], 0)
    test.assert_eq(done[7], 0)
    run(var d, var rf2, var air2, 260000)
    let est = meta_events(air2.host, 0x1D)
    test.assert_eq(est[list.len(est) - 1][4], 0x44)
    send(var d, 0x206C, [0])
    let _s = ctl_hci.ctl_step(var d)
    test.assert_eq(drain(var d)[6], 0x42)
    // A synchronization that is up is ended by LE BIG Terminate Sync with no event, and its handles are gone.
    run(var d, var rf2, var air2, 300000)
    test.assert_eq(cmd_status(var d, 0x206B, big_sync_params(h, 0, 0, 0x64, [1, 2])), 0)
    run(var d, var rf2, var air2, 450000)
    test.assert_eq(d.bigs[0].state, ll_big.B_UP)
    test.assert_eq(big_out_path(var d, 0x200), 0)
    send(var d, 0x206C, [0])
    let _t = ctl_hci.ctl_step(var d)
    test.assert_eq(drain(var d)[6], 0)
    test.assert_eq(big_out_path(var d, 0x200), 0x02)
    test.assert_eq(d.bigs[0].state, ll_big.B_FREE)
    let before = list.len(meta_events(air2.host, 0x1E))
    run(var d, var rf2, var air2, 500000)
    test.assert_eq(list.len(meta_events(air2.host, 0x1E)), before)

@test
fn test_link_quality_of_a_bis_counts_the_payloads_that_did_not_arrive()
    if not ctl_limits.big_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    big_source(var c, var rf, var air, 1, 0, 0, 900000, 10, 0)
    let v = big_info_view(var air, big_info_pdu(var air))
    let first = air.tx_t[big_sent(var air, v.saa, 1)[0]]
    var d = fresh()
    var rf2 = ll_air.rf_new()
    var air2 = sim_new()
    big_replay(var air,
        var air2,
        [ll_big.bis_aa(v.saa, 1)],
        first + 30 * 10000 - 50,
        first + 31 * 10000 - 50,
        -1)
    big_sink(var d, var rf2, var air2, [1], 0, 0, 0x64, 800000)
    send(var d, 0x2075, [0x00, 0x02])
    let _a = ctl_hci.ctl_step(var d)
    let q = drain(var d)
    test.assert_eq(q[6], 0)
    test.assert_eq(q[7] | (q[8] << 8), 0x200)
    // The seven counters of four octets each: TX counters 0, CRC errors 0, one payload unreceived, no duplicate.
    test.assert_eq(q[9] | (q[10] << 8), 0)
    test.assert_eq(q[25] | (q[26] << 8), 0)
    test.assert_eq(q[29] | (q[30] << 8), 1)
    test.assert_eq(q[33] | (q[34] << 8), 0)

// The Command Complete of a command that takes a connection handle: the packet.
fn handle_cmd(var c: ctl_hci.Controller, opcode: Int, h: Int) -> [Int]
    send(var c, opcode, [h & 0xFF, h >>> 8])
    let _a = ctl_hci.ctl_step(var c)
    drain(var c)

@when(noble_controller.CONFIG.CTL_BIS >= 2)
@test
fn test_le_read_iso_tx_sync_of_a_bis_names_the_last_sdu_and_the_anchor_point_of_its_event()
    if not ctl_limits.big_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    big_train(var c, var rf, var air)
    test.assert_eq(cmd_status(var c, 0x2068, big_params(0, 1, 2, 10000, 40, 20, 1, 2, 0, 0)), 0)
    run(var c, var rf, var air, 300000)
    // No input path yet, then a path and no SDU: Command Disallowed.  A handle that is no stream: Unknown Connection Identifier.
    test.assert_eq(handle_cmd(var c, 0x2061, 0x200)[6], 0x0C)
    test.assert_eq(handle_cmd(var c, 0x2061, 0x300)[6], 0x02)
    test.assert_eq(big_path(var c, 0x200), 0)
    test.assert_eq(handle_cmd(var c, 0x2061, 0x200)[6], 0x0C)
    var t = air.now
    for k in 0..5
        big_feed(var c, 0x200, 10 + k, 1)
        t = t + 10000
        run(var c, var rf, var air, t)
    let q = handle_cmd(var c, 0x2061, 0x200)
    // Status, handle, Packet_Sequence_Number 4 (the fifth SDU), the BIG anchor point of an event (32 bits), Time_Offset 0 (unframed).
    test.assert_eq(q[6], 0)
    test.assert_eq(q[7] | (q[8] << 8), 0x200)
    test.assert_eq(q[9] | (q[10] << 8), 4)
    let stamp = q[11] | (q[12] << 8) | (q[13] << 16) | (q[14] << 24)
    let v = big_info_view(var air, big_info_pdu(var air))
    let b1 = big_sent(var air, v.saa, 1)
    let first = air.tx_t[b1[0]]
    test.assert_eq((stamp - first) % 10000, 0)
    test.assert(stamp >= first and stamp <= air.now + 10000)
    test.assert_eq(q[15] | (q[16] << 8) | (q[17] << 16), 0)
    // The second BIS has taken no SDU.
    test.assert_eq(big_path(var c, 0x201), 0)
    test.assert_eq(handle_cmd(var c, 0x2061, 0x201)[6], 0x0C)

@test
fn test_le_read_iso_tx_sync_and_link_quality_of_a_bis_are_refused_where_the_specification_has_no_such_stream()
    if not ctl_limits.big_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    big_source(var c, var rf, var air, 1, 0, 0, 500000, 10, 0)
    var d = fresh()
    var rf2 = ll_air.rf_new()
    var air2 = sim_new()
    big_replay(var air, var air2, [], 0, 0, -1)
    big_sink(var d, var rf2, var air2, [1], 0, 0, 0x64, 500000)
    // The Synchronized Receiver's BIS does not transmit SDUs: Command Disallowed for LE Read ISO TX Sync; its link quality reads.
    test.assert_eq(handle_cmd(var d, 0x2061, 0x200)[6], 0x0C)
    test.assert_eq(handle_cmd(var d, 0x2075, 0x200)[6], 0)
    // LE Read ISO Link Quality is the Synchronized Receiver's command: the Isochronous Broadcaster's stream is an Unknown Connection Identifier.
    test.assert_eq(handle_cmd(var c, 0x2075, 0x200)[6], 0x02)
    // A group the Controller is not synchronized to (the receiver's other handle) is not a stream either.
    test.assert_eq(handle_cmd(var d, 0x2075, 0x300)[6], 0x02)

// ── ISO test mode on a BIS ───────────────────────────────────────────

// The counters of LE ISO Read Test Counters or LE ISO Test End as [status, received, missed, failed].
fn test_counters(var c: ctl_hci.Controller, opcode: Int, h: Int) -> [Int]
    let q = handle_cmd(var c, opcode, h)
    [q[6], q[9] | (q[10] << 8) | (q[11] << 16) | (q[12] << 24), q[13] | (q[14] << 8) | (q[15] << 16) | (q[16] << 24),
     q[17] | (q[18] << 8) | (q[19] << 16) | (q[20] << 24)]

// The SDU counter in the first four octets of the data of the PDU `body` (header, length, data).
fn pdu_counter(body: [Int]) -> Int
    body[2] | (body[3] << 8) | (body[4] << 16) | (body[5] << 24)

@when(noble_controller.CONFIG.CTL_BIS >= 2)
@test
fn test_iso_transmit_test_of_a_bis_sends_counted_sdus_and_asks_the_host_for_nothing()
    if not ctl_limits.big_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    big_train(var c, var rf, var air)
    test.assert_eq(cmd_status(var c, 0x2068, big_params(0, 1, 2, 10000, 40, 20, 0, 2, 0, 0)), 0)
    run(var c, var rf, var air, 300000)
    let v = big_info_view(var air, big_info_pdu(var air))
    // The errors: a handle that is no stream, a reserved Payload_Type, a test that is not on.
    test.assert_eq(status_of(var c, 0x2070, [0x00, 0x03, 2]), 0x02)
    test.assert_eq(status_of(var c, 0x2070, [0x00, 0x02, 3]), 0x12)
    test.assert_eq(test_counters(var c, 0x2072, 0x200)[0], 0x11)
    test.assert_eq(test_counters(var c, 0x2073, 0x200)[0], 0x11)
    // The test: Payload_Type 2, SDUs of the largest size.  The input data path is Command Disallowed from now on, and a test is Command Disallowed with one.
    test.assert_eq(status_of(var c, 0x2070, [0x00, 0x02, 2]), 0)
    test.assert_eq(big_path(var c, 0x200), 0x0C)
    test.assert_eq(big_path(var c, 0x201), 0)
    test.assert_eq(status_of(var c, 0x2070, [0x01, 0x02, 2]), 0x0C)
    // A Synchronized Receiver's test does not apply to a broadcaster's BIS.
    test.assert_eq(status_of(var c, 0x2071, [0x00, 0x02, 2]), 0x11)
    run(var c, var rf, var air, 700000)
    let b1 = big_sent(var air, v.saa, 1)
    // Every PDU after the start: LLID 0 (a complete SDU), 40 octets, the counter of the event (the payload counter, UPPS 1) and the pattern.
    var first = -1
    for k in 0..list.len(b1)
        if first < 0 and air.tx_body[b1[k]][1] == 40
            first = k
    test.assert(first >= 0)
    test.assert(list.len(b1) - first >= 20)
    var prev = -1
    for k in first..list.len(b1)
        let body = air.tx_body[b1[k]]
        test.assert_eq(body[0] & 3, 0)
        test.assert_eq(body[1], 40)
        let n = pdu_counter(body)
        if prev >= 0
            test.assert_eq(n, prev + 1)
        prev = n
        test.assert_eq(body[6], (n + 4) & 0xFF)
        test.assert_eq(body[41], (n + 39) & 0xFF)
    // The Host sent nothing, and is owed no credit for the SDUs the Controller made.
    test.assert_eq(credits_in(air.host, 0, 0x200)[0], 0)
    // The other BIS keeps padding with empty PDUs of LLID 1.
    let b2 = big_sent(var air, v.saa, 2)
    test.assert_eq(air.tx_body[b2[list.len(b2) - 1]][1], 0)
    test.assert_eq(air.tx_body[b2[list.len(b2) - 1]][0] & 3, 1)
    // LE ISO Test End: zero counters for a stream that only transmitted, then the SDUs stop and the BIS pads.
    let end = test_counters(var c, 0x2073, 0x200)
    test.assert_eq(end[0], 0)
    test.assert_eq(end[1] + end[2] + end[3], 0)
    test.assert_eq(test_counters(var c, 0x2073, 0x200)[0], 0x11)
    run(var c, var rf, var air, 900000)
    let b1b = big_sent(var air, v.saa, 1)
    test.assert_eq(air.tx_body[b1b[list.len(b1b) - 1]][1], 0)
    test.assert_eq(air.tx_body[b1b[list.len(b1b) - 1]][0] & 3, 1)
    // Payload_Type 0: zero-length SDUs, LLID 0 and no data; Payload_Type 1: lengths from 4 to Max_SDU that differ.
    test.assert_eq(status_of(var c, 0x2070, [0x00, 0x02, 0]), 0)
    run(var c, var rf, var air, 1000000)
    let b1c = big_sent(var air, v.saa, 1)
    test.assert_eq(air.tx_body[b1c[list.len(b1c) - 1]][0] & 3, 0)
    test.assert_eq(air.tx_body[b1c[list.len(b1c) - 1]][1], 0)
    test.assert_eq(test_counters(var c, 0x2073, 0x200)[0], 0)
    test.assert_eq(status_of(var c, 0x2070, [0x00, 0x02, 1]), 0)
    let at = list.len(big_sent(var air, v.saa, 1))
    run(var c, var rf, var air, 1300000)
    let b1d = big_sent(var air, v.saa, 1)
    var lens: [Int] = []
    for k in at..list.len(b1d)
        let body = air.tx_body[b1d[k]]
        test.assert(body[1] >= 4 and body[1] <= 40)
        test.assert_eq(body[0] & 3, 0)
        var seen = false
        for l in lens
            if l == body[1]
                seen = true
        if not seen
            list.push(lens, body[1])
    test.assert(list.len(lens) >= 5)

@test
fn test_iso_receive_test_of_a_bis_counts_received_missed_and_failed_sdus()
    if not ctl_limits.big_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    // The broadcaster makes the SDUs itself, from the start.
    big_train(var c, var rf, var air)
    test.assert_eq(cmd_status(var c, 0x2068, big_params(0, 1, 1, 10000, 40, 20, 1, 2, 0, 0)), 0)
    run(var c, var rf, var air, 250000)
    test.assert_eq(status_of(var c, 0x2070, [0x00, 0x02, 2]), 0)
    run(var c, var rf, var air, 1100000)
    let v = big_info_view(var air, big_info_pdu(var air))
    let first = air.tx_t[big_sent(var air, v.saa, 1)[0]]
    // The receiver: synchronized, and the test instead of an output data path.  One event is lost on air.
    var d = fresh()
    var rf2 = ll_air.rf_new()
    var air2 = sim_new()
    big_replay(var air,
        var air2,
        [ll_big.bis_aa(v.saa, 1)],
        first + 60 * 10000 - 50,
        first + 61 * 10000 - 50,
        -1)
    xscan_on(var d, 0, 0)
    test.assert_eq(status_of(var d, 0x2001, v1_sync_mask()), 0)
    test.assert_eq(big_psync(var d, 400), 0)
    run(var d, var rf2, var air2, 150000)
    let handle = meta_events(air2.host, 0x0E)[0][5] | (meta_events(air2.host, 0x0E)[0][6] << 8)
    run(var d, var rf2, var air2, 250000)
    test.assert_eq(cmd_status(var d, 0x206B, big_sync_params(handle, 0, 0, 0x64, [1])), 0)
    var t = 250000
    while list.len(meta_events(air2.host, 0x1D)) == 0 and t < 800000
        t = t + 10000
        run(var d, var rf2, var air2, t)
    test.assert_eq(meta_events(air2.host, 0x1D)[0][4], 0)
    // A test of a broadcaster's BIS: the receiver's BIS 0x200 takes it, a stream that does not exist does not.
    test.assert_eq(status_of(var d, 0x2071, [0x00, 0x03, 2]), 0x02)
    test.assert_eq(status_of(var d, 0x2071, [0x00, 0x02, 3]), 0x12)
    test.assert_eq(status_of(var d, 0x2070, [0x00, 0x02, 2]), 0x11)
    test.assert_eq(test_counters(var d, 0x2072, 0x200)[0], 0x11)
    test.assert_eq(status_of(var d, 0x2071, [0x00, 0x02, 2]), 0)
    test.assert_eq(big_out_path(var d, 0x200), 0x0C)
    run(var d, var rf2, var air2, 1100000)
    let n = test_counters(var d, 0x2072, 0x200)
    test.assert_eq(n[0], 0)
    // Read does not reset: the same again, and the SDUs that came while the test ran are received, one missed, none failed, and none went to the Host.
    test.assert_eq(test_counters(var d, 0x2072, 0x200)[1], n[1])
    test.assert(n[1] >= 30)
    test.assert_eq(n[2], 1)
    test.assert_eq(n[3], 0)
    test.assert_eq(list.len(big_got(var air2, 0x200)), 0)
    // The test ends with the counters; a second end is refused.
    let end = test_counters(var d, 0x2073, 0x200)
    test.assert_eq(end[0], 0)
    test.assert(end[1] >= n[1])
    test.assert_eq(test_counters(var d, 0x2073, 0x200)[0], 0x11)
    test.assert_eq(big_out_path(var d, 0x200), 0)

// ── Periodic Advertising Sync Transfer ──────────────────────────────
//
// The Controller is the Central of a connection to the simulated Peripheral (the connection interval is 30 ms, the anchor points are the
// first packets the Controller sends in each event).  As the sender, its train is the one of the set 1: the PDU it queues must name an event of the
// train that the air log shows, counted from a connection event the log shows.  As the recipient, the Peripheral sends the PDU, and the
// train is scripted (the AUX_SYNC_IND PDUs at the times the PDU gives); the Controller must find them without scanning.  The cases run in a build
// with the feature (`ctl_per`, `pc` in configs/); in one without, the commands are unknown and the PDU is answered with LL_UNKNOWN_RSP.

// The LE events up to bit 47 less bits 36 and 37 (the [v2] report and Transfer Received events, which a Controller with PAwR sync sends in place of the v1 ones when they are set), and the Host's default transfer parameters `mode`, `skip`, `timeout`.
fn past_host(var c: ctl_hci.Controller, mode: Int, timeout: Int)
    test.assert_eq(status_of(var c, 0x2001, [0xFF, 0xFF, 0xFF, 0xFF, 0xCF, 0xFF, 0, 0]), 0)
    test.assert_eq(status_of(var c, 0x0C63, [0, 0, 0, 0, 0, 0, 0, 0]), 0)
    if mode > 0
        test.assert_eq(status_of(var c, 0x205D, [mode, 0, 0, timeout & 0xFF, timeout >>> 8, 0]), 0)

// The Controller as Central connected to the Peripheral of `air`, whose script is `pdus`, at the simulated time `until`.
fn past_connect(var c: ctl_hci.Controller, var rf: ll_air.Rf, var air: SimAir, pdus: [Pdu],
                until: Int)
    air.periph = true
    send(var c, 0x200D, create_connection())
    let _ran = ctl_hci.ctl_step(var c)
    let _d = drain(var c)
    hear(var air, 2000, 37, from_peer(ll_pdu.ADV_IND, 5))
    run(var c, var rf, var air, 60000)
    test.assert(c.links[0].live)
    test.assert(c.links[0].central)
    // The script starts with the connection: the CONNECT_IND is a packet of the Central too, to the simulated air.
    for p in pdus
        list.push(air.p_pdus, p)
    run(var c, var rf, var air, until)

// The anchor points of the connection events the Controller sent in, in order of the counter from 0: the first packet of each.
fn past_anchors(var air: SimAir, aa: Int) -> [Int]
    var out: [Int] = []
    var last = -1000000
    for i in 0..list.len(air.tx_t)
        if air.tx_aa[i] == aa
            if air.tx_t[i] - last > 15000
                list.push(out, air.tx_t[i])
            last = air.tx_t[i]
    out

// The index of the k-th LL_PERIODIC_SYNC_IND the Controller sent with the access address `aa`, -1 for none.
fn past_sent(var air: SimAir, aa: Int, k: Int) -> Int
    var n = 0
    for i in 0..list.len(air.tx_t)
        if air.tx_aa[i] == aa and air.tx_op[i] == 0x1C and (air.tx_h[i] & 3) == 3
            if n == k
                return i
            n = n + 1
    -1

@test
fn test_the_sender_names_an_event_of_its_own_train_from_a_connection_event_the_log_shows()
    if not ctl_limits.past_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    past_host(var c, 0, 0)
    past_connect(var c, var rf, var air, [], 150000)
    xa_set(var c, 1, 0, 0, 5, 0, [2, 1, 6])
    past_host(var c, 0, 0)
    test.assert_eq(status_of(var c, 0x203E, pa_params(1, 32, 32, 0)), 0)
    test.assert_eq(status_of(var c, 0x203F, pa_data(1, 3, [1, 2, 3])), 0)
    test.assert_eq(status_of(var c, 0x2040, [1, 1]), 0)
    test.assert_eq(status_of(var c, 0x2039, xa_enable(1, 1, 0, 0)), 0)
    run(var c, var rf, var air, 500000)
    // The command names the connection (handle 1), the Service_Data 0x1234 and the set 1.
    send(var c, 0x205B, [1, 0, 0x34, 0x12, 1])
    let _s = ctl_hci.ctl_step(var c)
    let done = drain(var c)
    test.assert_eq(done[6], 0)
    test.assert_eq(done[7] | (done[8] << 8), 1)
    run(var c, var rf, var air, 800000)
    let aa = c.links[0].aa
    let at = past_sent(var air, aa, 0)
    test.assert(at >= 0)
    test.assert_eq(past_sent(var air, aa, 1), -1)
    var p = tx_pdu(air, at)
    let si = 2 + ll_past.AT_SYNC_INFO
    test.assert_eq(ll_data.dpdu_len(var p), 35)
    test.assert_eq(ll_data.dpdu_u16(var p, ll_past.AT_ID), 0x1234)
    // The train is the one the set announced.
    let an = pa_announces(var air)
    var ann = tx_pdu(air, an[0])
    let xa = ll_ext.ext_parse(var ann)
    let train_aa = ll_per.si_aa(var ann, xa.sync)
    test.assert_eq(ll_per.si_aa(var p, si), train_aa)
    test.assert_eq(ll_per.si_crc(var p, si), ll_per.si_crc(var ann, xa.sync))
    test.assert_eq(ll_per.si_interval(var p, si), 32)
    test.assert_eq(ll_per.si_chmap(var p, si), 0x1FFFFFFFFF)
    test.assert_eq(ll_per.si_sca(var p, si), 5)
    let who = ll_data.dpdu_byte(var p, ll_past.AT_SID)
    test.assert_eq(who & 0x0F, 5)
    test.assert_eq((who >>> 4) & 1, 0)
    test.assert_eq(who >>> 5, 5)
    test.assert_eq(ll_data.dpdu_byte(var p, ll_past.AT_PHY), 1)
    for k in 0..6
        test.assert_eq(ll_data.dpdu_byte(var p, ll_past.AT_ADVA + k), 0x10 + k)
    // The events of the train: the first PDU of each, in order; the counter of the first is the announcement's less its place.
    let sy = pa_sent_with(var air, train_aa)
    var first_counter = 0
    let off0 = ll_per.si_offset_us(var ann, xa.sync)
    for m in 0..list.len(sy)
        let d = air.tx_t[sy[m]] - (air.tx_t[an[0]] + off0)
        if d >= 0 and d < 30
            first_counter = ll_per.si_counter(var ann, xa.sync) - m
    // The reference is a connection event of the log, the offset leads to the AUX_SYNC_IND of the counter PEa.
    let anchors = past_anchors(var air, aa)
    let ceref = ll_data.dpdu_u16(var p, ll_past.AT_CE_REF)
    let ces = ll_data.dpdu_u16(var p, ll_past.AT_CE_SYNC)
    test.assert(ceref < list.len(anchors))
    test.assert(ces <= ceref)
    let unit = ll_past.rx_unit_us(var p, si)
    let target = anchors[ceref] + ll_past.rx_offset_us(var p, si)
    let pea = ll_per.si_counter(var p, si)
    var found = -1
    for m in 0..list.len(sy)
        let d = air.tx_t[sy[m]] - target
        if d >= 0 and d < unit
            found = m
    test.assert(found >= 0)
    test.assert_eq(pea, (first_counter + found) & 0xFFFF)
    // lastPaEventCounter is an event the Controller had sent before the PDU went out.
    let peb = ll_data.dpdu_u16(var p, ll_past.AT_LAST_PE)
    let mb = (peb - first_counter) & 0xFFFF
    test.assert(mb < list.len(sy))
    test.assert(air.tx_t[sy[mb]] < air.tx_t[at])
    // The connection went on, and the train never lost an event to the transfer.
    test.assert_eq(rf.cen_missed, 0)
    test.assert_eq(rf.cen_aborts, 0)
    test.assert_eq(rf.ramp_timeouts, 0)
    test.assert_eq(c.per_late, 0)

@test
fn test_the_sender_describes_a_train_with_responses_by_ll_periodic_sync_wr_ind_with_the_timing_of_its_subevents()
    // [Vol 6] Part B, Section 5.1.13: for PAwR the LL_PERIODIC_SYNC_WR_IND PDU shall be used; its tail is the timing the AUX_ADV_IND announces.
    if not ctl_limits.past_on() or not ctl_limits.pawr_adv_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    past_host(var c, 0, 0)
    past_connect(var c, var rf, var air, [], 150000)
    xa_set(var c, 1, 0, 0, 5, 0, [2, 1, 6])
    past_host(var c, 0, 0)
    test.assert_eq(status_of(var c, 0x2086, pw_params(1, PW_IV, PW_IV, 0, 2, PW_SI, PW_DELAY, PW_SPACING, 3)), 0)
    test.assert_eq(status_of(var c, 0x2040, [1, 1]), 0)
    test.assert_eq(status_of(var c, 0x2039, xa_enable(1, 1, 0, 0)), 0)
    run(var c, var rf, var air, 500000)
    send(var c, 0x205B, [1, 0, 0x34, 0x12, 1])
    let _s = ctl_hci.ctl_step(var c)
    let done = drain(var c)
    test.assert_eq(done[6], 0)
    run(var c, var rf, var air, 800000)
    let aa = c.links[0].aa
    // The PDU that went out is LL_PERIODIC_SYNC_WR_IND, not LL_PERIODIC_SYNC_IND.
    test.assert_eq(past_sent(var air, aa, 0), -1)
    var at = -1
    for k in 0..list.len(air.tx_t)
        if air.tx_aa[k] == aa and air.tx_op[k] == ll_data.OP_PERIODIC_SYNC_WR_IND and (air.tx_h[k] & 3) == 3
            at = k
    test.assert(at >= 0)
    var p = tx_pdu(air, at)
    test.assert_eq(ll_data.dpdu_len(var p), ll_data.ctrl_payload_len(ll_data.OP_PERIODIC_SYNC_WR_IND))
    test.assert_eq(ll_data.dpdu_u16(var p, ll_past.AT_ID), 0x1234)
    // The tail repeats the Response Timing Information of the AUX_ADV_IND: RspAA, Num_Subevents, Subevent_Interval, Delay and Spacing.
    let an = pa_announces(var air)
    var ann = tx_pdu(air, an[0])
    let xa = ll_ext.ext_parse(var ann)
    let ti = ll_pawr.timing_find(var ann, xa.acad_at, xa.acad_len)
    test.assert(ti >= 0)
    let tail = 1 + ll_past.CTR_OCTETS
    let rsp_aa = ll_data.dpdu_byte(var p, tail) | (ll_data.dpdu_byte(var p, tail + 1) << 8) | (ll_data.dpdu_byte(var p, tail + 2) << 16) | (ll_data.dpdu_byte(var p, tail + 3) << 24)
    test.assert_eq(rsp_aa, ll_pawr.timing_aa(var ann, ti))
    test.assert_eq(ll_data.dpdu_byte(var p, tail + 4), 2)
    test.assert_eq(ll_data.dpdu_byte(var p, tail + 5), PW_SI)
    test.assert_eq(ll_data.dpdu_byte(var p, tail + 6), PW_DELAY)
    test.assert_eq(ll_data.dpdu_byte(var p, tail + 7), PW_SPACING)
    test.assert_eq(ll_per.si_aa(var p, 2 + ll_past.AT_SYNC_INFO), ll_per.si_aa(var ann, xa.sync))

// The scripted train for the receiver cases: the AUX_SYNC_IND of the counter `pea` is at `t_a`, the interval is 40 ms, and `from` to `to` events
// are heard (event n is at t_a + 40000 n with the counter pea + n), those from `miss_from` to `miss_to` not.
fn past_train(var air: SimAir, aa: Int, t_a: Int, pea: Int, from: Int, to: Int, miss_from: Int,
              miss_to: Int, data: [Int])
    for n in from..to
        let t = t_a + n * 40000
        if t > 20000 and (n < miss_from or n >= miss_to)
            hear_aa(var air,
                t,
                ll_link.csa2_channel(ll_per.channel_id(aa), (pea + n) & 0xFFFF, 0x1FFFFFFFFF, 37),
                xp(0, -1, -1, 0, -1, 0, 0, -200, data),
                0,
                aa)

// The PDU the Peripheral sends: the train with the access address `aa`, its AUX_SYNC_IND of the counter `pea` at the offset `off` from the connection
// event `ceref`, the last event its sender had `peb`, in the connection event `ces`.
fn past_pdu(aa: Int, off: Int, pea: Int, ceref: Int, peb: Int, ces: Int, sdata: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    var a: Vec[u8; 6] = Vec.new()
    for k in 0..6
        let _x = a.push((0x30 + k) as u8)
    var o = ll_past.Offer { ok: true, pea: pea, at: 0, ceref: ceref, ref_us: 0, off_us: off }
    ll_past.put_sync_ind(var p,
        sdata,
        var o,
        32,
        0x1FFFFFFFFF,
        3,
        aa,
        0x123456,
        peb,
        6,
        0,
        3,
        ll_phy.PHY_1M,
        var a,
        ces)
    p

// The Controller as Central with the Host's default mode `mode`, whose Peripheral sends the PDU in its first event and whose train is scripted:
// the reference is the connection event `ceref` of the connection a first run (without the PDU) shows.
fn past_receive(mode: Int, ceref: Int, off: Int, miss_from: Int, miss_to: Int, until: Int) -> SimAir
    var first = fresh()
    var rf0 = ll_air.rf_new()
    var air0 = sim_new()
    past_host(var first, 0, 0)
    past_connect(var first, var rf0, var air0, [], 150000 + ceref * 30000)
    let anchors = past_anchors(var air0, first.links[0].aa)
    test.assert(list.len(anchors) > ceref)
    let aa = pa_aa()
    let t_a = anchors[ceref] + off + 12
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    past_host(var c, mode, 100)
    var pdus: [Pdu] = [past_pdu(aa, off, 700, ceref, 699, 1, 0xBEEF)]
    past_train(var air, aa, t_a, 700, -30, 40, miss_from, miss_to, [7, 8, 9])
    past_connect(var c, var rf, var air, pdus, until)
    // Every event the train sent was heard from the first one the Controller listened to: no window was missed, the connection's events apart.
    if miss_from < 1000
        test.assert_eq(c.psyncs[0].heard, 0)
    else if mode > 0
        test.assert_eq(c.psyncs[0].missed, 0)
        test.assert(c.psyncs[0].heard >= 20)
    test.assert_eq(rf.cen_missed, 0)
    test.assert_eq(rf.ramp_timeouts, 0)
    air

@test
fn test_the_receiver_finds_the_train_the_pdu_describes_without_scanning_and_tells_the_host()
    if not ctl_limits.past_on()
        return
    // Mode 2: the Host is told and the reports are on.  The offset 4980 puts the train's events away from the connection's.
    let air = past_receive(2, 20, 4980, 1000, 1000, 1500000)
    let ev = meta_events(air.host, 0x18)
    test.assert_eq(list.len(ev), 1)
    let e = ev[0]
    // Status, Connection_Handle 1, Service_Data 0xBEEF, Sync_Handle 0, SID 6, public (0), the address 0x30.., LE 1M, interval 32, the accuracy 3.
    test.assert_eq(e[4], 0)
    test.assert_eq(e[5] | (e[6] << 8), 1)
    test.assert_eq(e[7] | (e[8] << 8), 0xBEEF)
    test.assert_eq(e[9] | (e[10] << 8), 0)
    test.assert_eq(e[11], 6)
    test.assert_eq(e[12], 0)
    test.assert_eq(e[13], 0x30)
    test.assert_eq(e[19], 1)
    test.assert_eq(e[20] | (e[21] << 8), 32)
    test.assert_eq(e[22], 3)
    // No Sync Established event: the transfer has its own.
    test.assert_eq(list.len(meta_events(air.host, 0x0E)), 0)
    // The reports came event after event, each with the three octets.
    let rs = pa_reports(air.host)
    test.assert(list.len(rs) >= 15)
    for r in rs
        test.assert_eq(r[10], 3)
        test.assert_eq(r[11], 7)
    test.assert_eq(list.len(meta_events(air.host, 0x10)), 0)

@test
fn test_a_transferred_train_with_the_mode_of_events_only_reports_nothing_until_the_host_turns_the_reports_on()
    if not ctl_limits.past_on()
        return
    var air = past_receive(1, 20, 4980, 1000, 1000, 1000000)
    test.assert_eq(list.len(meta_events(air.host, 0x18)), 1)
    test.assert_eq(list.len(pa_reports(air.host)), 0)

@test
fn test_a_transfer_the_host_did_not_ask_for_is_ignored()
    if not ctl_limits.past_on()
        return
    var air = past_receive(0, 20, 4980, 1000, 1000, 1000000)
    test.assert_eq(list.len(meta_events(air.host, 0x18)), 0)
    test.assert_eq(list.len(pa_reports(air.host)), 0)

@test
fn test_a_transferred_train_that_is_never_heard_fails_with_synchronization_timeout_after_six_events()
    if not ctl_limits.past_on()
        return
    var air = past_receive(2, 20, 4980, -1000, 1000, 1500000)
    let ev = meta_events(air.host, 0x18)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0x3E)
    test.assert_eq(ev[0][5] | (ev[0][6] << 8), 1)
    test.assert_eq(ev[0][7] | (ev[0][8] << 8), 0xBEEF)
    test.assert_eq(list.len(pa_reports(air.host)), 0)

@test
fn test_the_sender_describes_a_train_it_is_synchronized_to_by_the_events_it_heard()
    if not ctl_limits.past_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    past_host(var c, 0, 0)
    past_connect(var c, var rf, var air, [], 150000)
    xscan_on(var c, 0, 0)
    test.assert_eq(pa_create(var c, 0, 400), 0)
    // The advertiser's train (interval 20 ms, counter 100 at its first event) is announced 200 ms from now.
    let aa = pa_aa()
    let t0 = air.now + 200000
    // The advertiser announces it again every 47 ms (the scanner shares the radio with the connection), each time with the offset to a later event.
    for j in 0..8
        let a = t0 + 5000 + j * 47000
        let n = (a + 10000 - (t0 + 15000) + 19999) / 20000
        hear(var air, a - 3000, 37, xp(0, -1, 0x111, 5, 12, 100, 0, -200, []))
        hear(var air, a, 12, pa_announce_pdu(t0 + 15000 + n * 20000 - a, 16, aa, 100 + n))
    for k in 0..60
        hear_aa(var air,
            t0 + 15000 + k * 20000,
            ll_link.csa2_channel(ll_per.channel_id(aa), (100 + k) & 0xFFFF, 0x1FFFFFFFFF, 37),
            xp(0, -1, -1, 0, -1, 0, 0, -200, [1, 2]),
            0,
            aa)
    run(var c, var rf, var air, t0 + 600000)
    test.assert_eq(list.len(meta_events(air.host, 0x0E)), 1)
    // The Host asks for the train to be described to the connection (handle 1) with Service_Data 0x0102; the Sync_Handle is 0.
    send(var c, 0x205A, [1, 0, 0x02, 0x01, 0, 0])
    let _s = ctl_hci.ctl_step(var c)
    let done = drain(var c)
    test.assert_eq(done[6], 0)
    test.assert_eq(done[7] | (done[8] << 8), 1)
    run(var c, var rf, var air, t0 + 900000)
    let conn_aa = c.links[0].aa
    let at = past_sent(var air, conn_aa, 0)
    test.assert(at >= 0)
    var p = tx_pdu(air, at)
    let si = 2 + ll_past.AT_SYNC_INFO
    test.assert_eq(ll_data.dpdu_u16(var p, ll_past.AT_ID), 0x0102)
    test.assert_eq(ll_per.si_aa(var p, si), aa)
    test.assert_eq(ll_per.si_crc(var p, si), 0x123456)
    test.assert_eq(ll_per.si_interval(var p, si), 16)
    test.assert_eq(ll_per.si_sca(var p, si), 5)
    let who = ll_data.dpdu_byte(var p, ll_past.AT_SID)
    test.assert_eq(who & 0x0F, 5)
    test.assert_eq((who >>> 4) & 1, 0)
    test.assert_eq(who >>> 5, 5)
    test.assert_eq(ll_data.dpdu_byte(var p, ll_past.AT_PHY), 1)
    test.assert_eq(ll_data.dpdu_byte(var p, ll_past.AT_ADVA), 0x30)
    // The offset from the connection event the PDU names leads to the event of the scripted train that has the counter PEa, within one unit.
    let anchors = past_anchors(var air, conn_aa)
    let ceref = ll_data.dpdu_u16(var p, ll_past.AT_CE_REF)
    test.assert(ceref < list.len(anchors))
    let unit = ll_past.rx_unit_us(var p, si)
    let target = anchors[ceref] + ll_past.rx_offset_us(var p, si)
    let pea = ll_per.si_counter(var p, si)
    var found = -1
    for k in 0..60
        let d = t0 + 15000 + k * 20000 - target
        if d >= 0 and d < unit
            found = k
    test.assert(found >= 0)
    test.assert_eq(pea, 100 + found)
    // lastPaEventCounter is an event the Controller heard, before the PDU was queued.
    let peb = ll_data.dpdu_u16(var p, ll_past.AT_LAST_PE)
    test.assert(peb >= 100 and peb < 160)
    test.assert(t0 + 15000 + (peb - 100) * 20000 < air.tx_t[at])
    test.assert_eq(rf.cen_missed, 0)
    test.assert_eq(rf.ramp_timeouts, 0)

@test
fn test_the_transfer_commands_check_the_handles_the_state_and_the_parameters()
    if not ctl_limits.past_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    past_host(var c, 0, 0)
    // No connection and no synchronization: the Connection_Handle and the Sync_Handle are unknown.
    test.assert_eq(status_of(var c, 0x205A, [1, 0, 0, 0, 0, 0]), 0x42)
    test.assert_eq(status_of(var c, 0x205B, [1, 0, 0, 0, 3]), 0x42)
    test.assert_eq(status_of(var c, 0x205C, [1, 0, 1, 0, 0, 10, 0, 0]), 0x02)
    // The default parameters: a Mode, Skip and Sync_Timeout out of range, the duplicate filter and a CTE type the Controller does not have.
    test.assert_eq(status_of(var c, 0x205D, [4, 0, 0, 10, 0, 0]), 0x12)
    test.assert_eq(status_of(var c, 0x205D, [1, 0xF4, 1, 10, 0, 0]), 0x12)
    test.assert_eq(status_of(var c, 0x205D, [1, 0, 0, 9, 0, 0]), 0x12)
    test.assert_eq(status_of(var c, 0x205D, [1, 0, 0, 1, 0x40, 0]), 0x12)
    test.assert_eq(status_of(var c, 0x205D, [3, 0, 0, 10, 0, 0]), 0x11)
    test.assert_eq(status_of(var c, 0x205D, [1, 0, 0, 10, 0, 1]), 0x11)
    test.assert_eq(status_of(var c, 0x205D, [1, 0, 0, 10, 0, 0x1F]), 0x0C)
    test.assert_eq(status_of(var c, 0x205D, [2, 0xF3, 1, 0, 0x40, 0]), 0)
    // With a connection: the parameters of the connection override the default, and a Sync_Handle that is not synchronized is unknown.
    past_connect(var c, var rf, var air, [], 150000)
    test.assert_eq(status_of(var c, 0x205A, [1, 0, 0, 0, 0, 0]), 0x42)
    test.assert_eq(status_of(var c, 0x205B, [1, 0, 0, 0, 3]), 0x42)
    // A set with no train enabled is Command Disallowed.
    xa_set(var c, 1, 0, 0, 5, 0, [2, 1, 6])
    past_host(var c, 0, 0)
    test.assert_eq(status_of(var c, 0x205B, [1, 0, 0, 0, 1]), 0x0C)
    test.assert_eq(status_of(var c, 0x205C, [1, 0, 3, 0, 0, 10, 0, 0]), 0x11)
    test.assert_eq(status_of(var c, 0x205C, [1, 0, 2, 0, 0, 10, 0, 0x1F]), 0x0C)
    test.assert_eq(status_of(var c, 0x205C, [1, 0, 2, 0, 0, 10, 0, 0]), 0)
    test.assert_eq(c.past_cfg[0].mode, 2)
    test.assert_eq(c.past_def.mode, 2)
    test.assert_eq(status_of(var c, 0x205C, [1, 0, 0, 0, 0, 10, 0, 0]), 0)
    test.assert_eq(c.past_cfg[0].mode, 0)
    test.assert_eq(c.past_def.mode, 2)

@test
fn test_a_second_transfer_waits_for_the_first_and_a_reset_forgets_the_parameters()
    if not ctl_limits.past_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    past_host(var c, 2, 100)
    past_connect(var c, var rf, var air, [], 150000)
    xa_set(var c, 1, 0, 0, 5, 0, [2, 1, 6])
    past_host(var c, 2, 100)
    test.assert_eq(status_of(var c, 0x203E, pa_params(1, 32, 32, 0)), 0)
    test.assert_eq(status_of(var c, 0x203F, pa_data(1, 3, [1, 2, 3])), 0)
    test.assert_eq(status_of(var c, 0x2040, [1, 1]), 0)
    // The set is not enabled yet, so the train is not running and the first transfer stays queued: a second finds the connection busy.
    test.assert_eq(status_of(var c, 0x205B, [1, 0, 1, 0, 1]), 0)
    test.assert_eq(status_of(var c, 0x205B, [1, 0, 2, 0, 1]), 0x0C)
    // LE Reset forgets the queue, the connection and the parameters.
    test.assert_eq(status_of(var c, 0x0C03, []), 0)
    test.assert_eq(c.past_def.mode, 0)
    test.assert(not c.past_tx[0].used)
    test.assert_eq(c.past_cfg[0].mode, 0)

@test
fn test_a_build_without_the_feature_answers_none_of_its_commands_and_the_pdu_with_an_unknown_response()
    if ctl_limits.past_on()
        return
    var c = fresh()
    test.assert_eq(status_of(var c, 0x205A, [1, 0, 0, 0, 0, 0]), 0x01)
    test.assert_eq(status_of(var c, 0x205B, [1, 0, 0, 0, 3]), 0x01)
    test.assert_eq(status_of(var c, 0x205C, [1, 0, 1, 0, 0, 10, 0, 0]), 0x01)
    test.assert_eq(status_of(var c, 0x205D, [1, 0, 0, 10, 0, 0]), 0x01)
    test.assert_eq(ctl_limits.features_octet3() & 3, 0)

@test
fn test_the_supported_commands_and_the_le_features_say_whether_the_build_has_the_transfer()
    var c = fresh()
    var on = 0
    if ctl_limits.past_on()
        on = 1
    // The event: indicator, code, length, credits, opcode (2), status, then the 64 octets.
    let r = complete_of_ctl(var c, 0x1002, [])
    test.assert_eq((r[7 + 40] >>> 6) & 3, 3 * on)
    test.assert_eq(r[7 + 41] & 3, 3 * on)
    // LE features 24 and 25 are octet 3 bits 0 and 1; feature 13 (Periodic Advertising) is octet 1 bit 5.
    let f = complete_of_ctl(var c, 0x2003, [])
    test.assert_eq(f[7 + 3] & 3, 3 * on)
    var periodic = 0
    if ctl_limits.per_on()
        periodic = 1
    test.assert_eq((f[7 + 1] >>> 5) & 1, periodic)
    // The features the Controller sends its peer say the same.
    test.assert_eq(ctl_limits.features_octet3() & 3, 3 * on)

// ── Periodic advertising with responses ─────────────────────────────
//
// A train with responses sends, in each event, an AUX_SYNC_SUBEVENT_IND for each subevent on the channel of the XOR of the event counter and the
// subevent number, then listens in the response slots the Host asked for on the same channel with the access address of the responses; the
// AUX_ADV_IND carries the Response Timing Information.  The train these cases run has 2 subevents 15 ms apart in an interval of 40 ms, 3 response
// slots 2.5 ms after the start of a subevent and 2 ms apart.  The Host here answers each request for data as it comes (`pw_run`).

const PW_IV = 32
const PW_SI = 12
const PW_DELAY = 2
const PW_SPACING = 16

// LE Set Periodic Advertising Parameters [v2] for the set `handle`.
fn pw_params(handle: Int, lo: Int, hi: Int, props: Int, n_sub: Int, si: Int, delay: Int,
             spacing: Int, slots: Int) -> [Int]
    [handle,
        lo & 0xFF,
        lo >>> 8,
        hi & 0xFF,
        hi >>> 8,
        props & 0xFF,
        props >>> 8,
        n_sub,
        si,
        delay,
        spacing,
        slots]

// Every LE event the cases read: those of the set 1 up to bit 21, and the events of PAwR (bits 35 to 39).
fn pw_mask(var c: ctl_hci.Controller)
    test.assert_eq(status_of(var c, 0x2001, [0xFF, 0xFF, 0x3F, 0, 0xF8, 0, 0, 0]), 0)

// The set 1 with a train of `n_sub` subevents and `slots` response slots, enabled; its events are masked in.
fn pw_train(var c: ctl_hci.Controller, n_sub: Int, slots: Int)
    xa_set(var c, 1, 0, 0, 5, 0, [2, 1, 6])
    pw_mask(var c)
    test.assert_eq(status_of(var c, 0x2086, pw_params(1, PW_IV, PW_IV, 0, n_sub, PW_SI, PW_DELAY, PW_SPACING, slots)),
        0)
    test.assert_eq(status_of(var c, 0x2040, [1, 1]), 0)
    test.assert_eq(status_of(var c, 0x2039, xa_enable(1, 1, 0, 0)), 0)

// Run to `until`, answering each request for data: every subevent asked about gets 3 octets (0xD0 + the subevent, the request's number, the
// subevent again) and the response slots `rs` to `rs + rc - 1`.  `seen[0]` counts the requests answered.
fn pw_run(var c: ctl_hci.Controller, var rf: ll_air.Rf, var air: SimAir, until: Int, n_sub: Int,
          rs: Int, rc: Int, var seen: [Int])
    var t = air.now
    while t < until
        t = t + 1000
        run(var c, var rf, var air, t)
        let rq = meta_events(air.host, 0x27)
        while seen[0] < list.len(rq)
            let e = rq[seen[0]]
            seen[0] = seen[0] + 1
            for k in 0..e[6]
                let sub = (e[5] + k) % n_sub
                test.assert_eq(status_of(var c, 0x2082, [e[4], 1, sub, rs, rc, 3, 0xD0 + sub, seen[0], sub]), 0)

// The indexes of the PDUs the Controller sent with the access address `aa` that carry `n` octets of data.
fn pw_sent(var air: SimAir, aa: Int, n: Int) -> [Int]
    var out: [Int] = []
    for i in pa_sent_with(var air, aa)
        var p = tx_pdu(air, i)
        let x = ll_ext.ext_parse(var p)
        if x.ok and x.data_len == n
            list.push(out, i)
    out

@when(noble_controller.CONFIG.CTL_PER_ADV > 0 and noble_controller.CONFIG.CTL_ADV_SETS > 0)
@test
fn test_a_build_without_the_advertiser_refuses_subevents_and_its_commands()
    if ctl_limits.pawr_adv_on()
        return
    var c = fresh()
    xa_set(var c, 1, 0, 0, 5, 0, [2, 1, 6])
    test.assert_eq(status_of(var c, 0x2086, pw_params(1, PW_IV, PW_IV, 0, 2, PW_SI, PW_DELAY, PW_SPACING, 3)),
        0x11)
    test.assert_eq(status_of(var c, 0x2086, pw_params(1, PW_IV, PW_IV, 0, 0, 0, 0, 0, 0)), 0)
    test.assert_eq(status_of(var c, 0x2082, [1, 1, 0, 0, 1, 1, 7]), 0x01)
    test.assert_eq(ctl_limits.features_octet5() & 0x08, 0)

@test
fn test_a_build_without_the_synchronizer_answers_none_of_its_commands()
    if ctl_limits.pawr_sync_on()
        return
    var c = fresh()
    test.assert_eq(status_of(var c, 0x2083, [0, 0, 0, 0, 0, 0, 0, 0]), 0x01)
    test.assert_eq(status_of(var c, 0x2084, [0, 0, 0, 0, 1, 0]), 0x01)
    test.assert_eq(ctl_limits.features_octet5() & 0x10, 0)

@test
fn test_the_supported_commands_and_the_le_features_say_which_sides_of_pawr_the_build_has()
    var c = fresh()
    var adv = 0
    var sync = 0
    if ctl_limits.pawr_adv_on()
        adv = 1
    if ctl_limits.pawr_sync_on()
        sync = 1
    let r = complete_of_ctl(var c, 0x1002, [])
    test.assert_eq((r[7 + 46] >>> 5) & 1, adv)
    test.assert_eq((r[7 + 46] >>> 6) & 1, sync)
    test.assert_eq((r[7 + 46] >>> 7) & 1, sync)
    // LE features 43 and 44 are octet 5 bits 3 and 4.
    let f = complete_of_ctl(var c, 0x2003, [])
    test.assert_eq((f[7 + 5] >>> 3) & 1, adv)
    test.assert_eq((f[7 + 5] >>> 4) & 1, sync)

@test
fn test_the_parameters_of_a_train_with_responses_are_checked()
    if not ctl_limits.pawr_adv_on()
        return
    var c = fresh()
    xa_set(var c, 1, 0, 0, 5, 0, [2, 1, 6])
    // The subevents fill the interval: 2 x 12 is under 32; 3 x 12 is not.
    test.assert_eq(status_of(var c, 0x2086, pw_params(1, PW_IV, PW_IV, 0, 2, PW_SI, PW_DELAY, PW_SPACING, 3)), 0)
    test.assert_eq(status_of(var c, 0x2086, pw_params(1, PW_IV, PW_IV, 0, 3, PW_SI, PW_DELAY, PW_SPACING, 3)),
        0x12)
    test.assert_eq(status_of(var c, 0x2086, pw_params(1, PW_IV, PW_IV, 0, 2, PW_SI, 12, PW_SPACING, 3)), 0x12)
    test.assert_eq(status_of(var c, 0x2086, pw_params(1, PW_IV, PW_IV, 0, 2, PW_SI, PW_DELAY, 40, 3)), 0x12)
    test.assert_eq(status_of(var c, 0x2086, pw_params(1, PW_IV, PW_IV, 0, 2, PW_SI, PW_DELAY, PW_SPACING, 0)),
        0x12)
    test.assert_eq(status_of(var c, 0x2086, pw_params(1, PW_IV, PW_IV, 0, 129, PW_SI, PW_DELAY, PW_SPACING, 3)),
        0x11)
    // Only the Tx Power bit of the properties.
    test.assert_eq(status_of(var c, 0x2086, pw_params(1, PW_IV, PW_IV, 1, 2, PW_SI, PW_DELAY, PW_SPACING, 3)),
        0x12)
    test.assert_eq(status_of(var c, 0x2086, pw_params(1, PW_IV, PW_IV, 0x40, 2, PW_SI, PW_DELAY, PW_SPACING, 3)),
        0)
    // The data of a train with responses is not given with LE Set Periodic Advertising Data, and a subevent's not before the Controller asked.
    test.assert_eq(status_of(var c, 0x203F, pa_data(1, 3, [1, 2, 3])), 0x0C)
    test.assert_eq(status_of(var c, 0x2082, [1, 1, 0, 0, 1, 1, 7]), 0x0C)
    test.assert_eq(status_of(var c, 0x2082, [9, 1, 0, 0, 1, 1, 7]), 0x42)

@test
fn test_a_train_with_responses_announces_its_timing_and_sends_a_subevent_pdu_on_the_channel_of_the_counter_xor_the_subevent()
    if not ctl_limits.pawr_adv_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pw_train(var c, 2, 3)
    var seen: [Int] = [0]
    pw_run(var c, var rf, var air, 330000, 2, 0, 2, var seen)
    let an = pa_announces(var air)
    test.assert(list.len(an) >= 3)
    var aux = tx_pdu(air, an[0])
    let xa = ll_ext.ext_parse(var aux)
    test.assert(xa.ok)
    // The ACAD of the AUX_ADV_IND holds the Response Timing Information.
    test.assert_eq(xa.acad_len, ll_pawr.TIMING_OCTETS)
    let ti = ll_pawr.timing_find(var aux, xa.acad_at, xa.acad_len)
    test.assert(ti >= 0)
    test.assert_eq(ll_pawr.timing_n_sub(var aux, ti), 2)
    test.assert_eq(ll_pawr.timing_si(var aux, ti), PW_SI)
    test.assert_eq(ll_pawr.timing_delay(var aux, ti), PW_DELAY)
    test.assert_eq(ll_pawr.timing_spacing(var aux, ti), PW_SPACING)
    let rsp_aa = ll_pawr.timing_aa(var aux, ti)
    let aa = ll_per.si_aa(var aux, xa.sync)
    test.assert(ll_init.aa_valid(rsp_aa))
    test.assert(rsp_aa != aa)
    test.assert_eq(ll_per.si_interval(var aux, xa.sync), PW_IV)
    // No AUX_SYNC_IND is sent: the PDUs with the train's access address are the subevents'.
    let sy = pa_sent_with(var air, aa)
    test.assert(list.len(sy) >= 6)
    let off = ll_per.si_offset_us(var aux, xa.sync)
    let ctr = ll_per.si_counter(var aux, xa.sync)
    let ev0 = air.tx_t[an[0]] + off
    test.assert(air.tx_t[sy[0]] >= ev0 and air.tx_t[sy[0]] < ev0 + 30)
    for k in 0..6
        let ev = k / 2
        let sub = k % 2
        test.assert_eq(air.tx_t[sy[k]] - air.tx_t[sy[0]], ev * 40000 + sub * 15000)
        test.assert_eq(air.tx_ch[sy[k]],
            ll_link.csa2_channel(ll_per.channel_id(aa), ((ctr + ev) ^ sub) & 0xFFFF, 0x1FFFFFFFFF, 37))
        var p = tx_pdu(air, sy[k])
        let x = ll_ext.ext_parse(var p)
        test.assert(x.ok)
        test.assert_eq(x.mode, 0)
        test.assert_eq(x.adva, -1)
        test.assert_eq(x.sync, -1)
        test.assert_eq(x.aux, -1)
    // The Host was asked, answered, and its data went out once, in the subevent it was asked about.
    test.assert(list.len(meta_events(air.host, 0x27)) >= 2)
    let first = meta_events(air.host, 0x27)[0]
    test.assert_eq(first[4], 1)
    test.assert_eq(first[5], 0)
    var asked = 2
    if ctl_limits.pw_bufs() < 2
        asked = ctl_limits.pw_bufs()
    test.assert_eq(first[6], asked)
    let with_data = pw_sent(var air, aa, 3)
    test.assert(list.len(with_data) >= 4)
    for i in with_data
        var p = tx_pdu(air, i)
        let x = ll_ext.ext_parse(var p)
        test.assert_eq(p.b[x.data_at] as Int, 0xD0 + p.b[x.data_at + 2] as Int)
    test.assert_eq(rf.ramp_timeouts, 0)
    test.assert_eq(air.cfg_aa, ll_radio.ADV_ACCESS_ADDRESS)

@test
fn test_the_responses_that_come_in_the_slots_the_host_asked_for_are_reported_with_their_slots()
    if not ctl_limits.pawr_adv_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pw_train(var c, 2, 3)
    var seen: [Int] = [0]
    // Run until the AUX_ADV_IND shows the timing, then script the responses of the events from the third on: subevent 0, slot 1, and in subevent 1, slot 0.
    var t = 0
    for _ in 0..60
        if list.len(pa_announces(var air)) == 0
            t = t + 1000
            pw_run(var c, var rf, var air, t, 2, 0, 2, var seen)
    let an = pa_announces(var air)
    test.assert(list.len(an) >= 1)
    var aux = tx_pdu(air, an[0])
    let xa = ll_ext.ext_parse(var aux)
    let ti = ll_pawr.timing_find(var aux, xa.acad_at, xa.acad_len)
    let rsp_aa = ll_pawr.timing_aa(var aux, ti)
    let aa = ll_per.si_aa(var aux, xa.sync)
    let ctr = ll_per.si_counter(var aux, xa.sync)
    let ev0 = air.tx_t[an[0]] + ll_per.si_offset_us(var aux, xa.sync) + 15
    for k in 2..8
        let ch0 = ll_link.csa2_channel(ll_per.channel_id(aa), (ctr + k) & 0xFFFF, 0x1FFFFFFFFF, 37)
        hear_aa(var air,
            ev0 + k * 40000 + 2500 + 1 * 2000,
            ch0,
            xp(0, -1, -1, 0, -1, 0, 0, -200, [0xE0 + k]),
            0,
            rsp_aa)
        let ch1 = ll_link.csa2_channel(ll_per.channel_id(aa), ((ctr + k) ^ 1) & 0xFFFF, 0x1FFFFFFFFF, 37)
        hear_aa(var air,
            ev0 + k * 40000 + 15000 + 2500,
            ch1,
            xp(0, -1, -1, 0, -1, 0, 0, -200, [0xF0 + k, 0xF1]),
            0,
            rsp_aa)
    pw_run(var c, var rf, var air, ev0 + 8 * 40000, 2, 0, 2, var seen)
    let rep = meta_events(air.host, 0x28)
    test.assert_eq(list.len(rep), 12)
    var s0 = 0
    var s1 = 0
    for e in rep
        // [4, 0x3E, n, 0x28, handle, subevent, TX_Status, Num_Responses, Tx Power, RSSI, CTE, slot, Data_Status, length, data]
        test.assert_eq(e[4], 1)
        test.assert_eq(e[6], 0)
        test.assert_eq(e[7], 1)
        test.assert_eq(e[8], 0x7F)
        test.assert_eq(e[10], 0xFF)
        test.assert_eq(e[12], 0)
        if e[5] == 0
            s0 = s0 + 1
            test.assert_eq(e[11], 1)
            test.assert_eq(e[13], 1)
            test.assert(e[14] >= 0xE2 and e[14] <= 0xE7)
        else
            s1 = s1 + 1
            test.assert_eq(e[11], 0)
            test.assert_eq(e[13], 2)
            test.assert_eq(e[15], 0xF1)
    test.assert_eq(s0, 6)
    test.assert_eq(s1, 6)
    test.assert_eq(rf.ramp_timeouts, 0)

@test
fn test_a_subevent_the_host_gave_no_data_for_is_sent_empty_and_a_late_answer_is_refused()
    if not ctl_limits.pawr_adv_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pw_train(var c, 2, 3)
    run(var c, var rf, var air, 200000)
    let an = pa_announces(var air)
    var aux = tx_pdu(air, an[0])
    let xa = ll_ext.ext_parse(var aux)
    let aa = ll_per.si_aa(var aux, xa.sync)
    // The Host answered nothing: every subevent went out with no data, and the first request's subevents have passed.
    let sy = pa_sent_with(var air, aa)
    test.assert(list.len(sy) >= 4)
    for i in sy
        var p = tx_pdu(air, i)
        test.assert_eq(ll_ext.ext_parse(var p).data_len, 0)
    test.assert(list.len(meta_events(air.host, 0x27)) >= 2)
    test.assert_eq(list.len(meta_events(air.host, 0x28)), 0)
    // The data of a subevent the Controller has gone by is refused as one it did not ask about, as is data for a subevent past the train's.
    test.assert_eq(status_of(var c, 0x2082, [1, 1, 5, 0, 1, 1, 7]), 0x0C)
    // Two elements for the same subevent, and a length that runs past the command.
    test.assert_eq(status_of(var c, 0x2082, [1, 2, 0, 0, 1, 1, 7, 0, 0, 1, 1, 7]), 0x12)
    test.assert_eq(status_of(var c, 0x2082, [1, 1, 0, 0, 1, 9, 7]), 0x12)

@test
fn test_a_synchronization_to_a_train_with_responses_listens_to_the_subevents_chosen_and_sends_the_response_in_its_slot()
    if not ctl_limits.pawr_sync_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    xscan_on(var c, 0, 0)
    pw_mask(var c)
    let aa = pa_aa()
    let rsp_aa = pw_rsp_aa(aa)
    test.assert_eq(pa_create(var c, 0, 400), 0)
    pw_peer(var air, aa, rsp_aa, 2, 8)
    run(var c, var rf, var air, 120000)
    // Sync Established [v2]: the handle, and the timing of the train.
    let est = meta_events(air.host, 0x24)
    test.assert_eq(list.len(est), 1)
    let e = est[0]
    test.assert_eq(e[4], 0)
    test.assert_eq(e[5] | (e[6] << 8), 0)
    test.assert_eq(e[16] | (e[17] << 8), PW_IV)
    test.assert_eq(e[19], 2)
    test.assert_eq(e[20], PW_SI)
    test.assert_eq(e[21], PW_DELAY)
    test.assert_eq(e[22], PW_SPACING)
    test.assert_eq(list.len(meta_events(air.host, 0x0E)), 0)
    // The reports [v2] come for subevent 0 alone (the default), one an event, with the counter of the event and the subevent.
    let r1 = meta_events(air.host, 0x25)
    test.assert(list.len(r1) >= 2)
    for r in r1
        // [4, 0x3E, n, 0x25, handle(2), tx power, RSSI, CTE, event counter(2), subevent, status, length, data...]
        test.assert_eq(r[11], 0)
        test.assert_eq(r[12], 0)
        test.assert_eq(r[13], 2)
        test.assert_eq(r[14], 0xC0)
        test.assert_eq(r[9] | (r[10] << 8), pw_ctr() + r[15])
    // Subevents 0 and 1 now: LE Set Periodic Sync Subevent (the properties 0, two subevents).
    test.assert_eq(status_of(var c, 0x2084, [0, 0, 0, 0, 2, 0, 1]), 0)
    // A subevent the train lacks and a handle the Host does not know.
    test.assert_eq(status_of(var c, 0x2084, [0, 0, 0, 0, 1, 2]), 0x12)
    test.assert_eq(status_of(var c, 0x2084, [9, 0, 0, 0, 1, 1]), 0x42)
    var guard = 0
    var rs = meta_events(air.host, 0x25)
    while (list.len(rs) < list.len(r1) + 3 or rs[list.len(rs) - 1][11] != 1) and guard < 400
        run(var c, var rf, var air, air.now + 1000)
        rs = meta_events(air.host, 0x25)
        guard = guard + 1
    var both = 0
    var one = 0
    for k in list.len(r1)..list.len(rs)
        test.assert_eq(rs[k][12], 0)
        test.assert_eq(rs[k][14], 0xC0 + rs[k][11])
        if rs[k][11] == 0
            both = both + 1
        else
            one = one + 1
    test.assert(both >= 1 and one >= 1)
    // The Host answers the last report, of the event `req_ev`, subevent 1: a response in subevent 0 is for the next event, slot 2.
    let q = rs[list.len(rs) - 1]
    let req_ev = q[9] | (q[10] << 8)
    test.assert_eq(status_of(var c, 0x2083, [0, 0, req_ev & 0xFF, req_ev >>> 8, 1, 0, 2, 3, 0xA1, 0xA2, 0xA3]), 0)
    // The slot of the request's own subevent has passed by the time the Controller reads the command; so has an earlier event's.  A subevent the
    // synchronization does not listen to, and a handle the Host does not know.
    test.assert_eq(status_of(var c, 0x2083, [0, 0, req_ev & 0xFF, req_ev >>> 8, 1, 1, 2, 1, 7]), 0x46)
    test.assert_eq(status_of(var c, 0x2083, [0, 0, (req_ev - 3) & 0xFF, 0, 1, 0, 2, 1, 7]), 0x46)
    test.assert_eq(status_of(var c, 0x2083, [0, 0, req_ev & 0xFF, req_ev >>> 8, 1, 2, 2, 1, 7]), 0x0C)
    test.assert_eq(status_of(var c, 0x2083, [7, 0, req_ev & 0xFF, req_ev >>> 8, 1, 0, 2, 1, 7]), 0x42)
    run(var c, var rf, var air, 340000)
    // It went out once, in slot 2 of that subevent: the delay and two spacings after the start of the AUX_SYNC_SUBEVENT_IND, on its channel, with RspAA.
    let sent = pa_sent_with(var air, rsp_aa)
    test.assert_eq(list.len(sent), 1)
    let ev_t = 15000 + (req_ev + 1 - pw_ctr()) * 40000
    test.assert(air.tx_t[sent[0]] >= ev_t + 2500 + 2 * 2000 - 5 and air.tx_t[sent[0]] <= ev_t + 2500 + 2 * 2000 + 40)
    test.assert_eq(air.tx_ch[sent[0]],
        ll_link.csa2_channel(ll_per.channel_id(aa), (req_ev + 1) & 0xFFFF, 0x1FFFFFFFFF, 37))
    var p = tx_pdu(air, sent[0])
    let x = ll_ext.ext_parse(var p)
    test.assert(x.ok)
    test.assert_eq(x.data_len, 3)
    test.assert_eq(p.b[x.data_at] as Int, 0xA1)
    test.assert_eq(rf.ramp_timeouts, 0)

// The access address a scripted train uses for its responses.
fn pw_rsp_aa(aa: Int) -> Int
    var t = ll_per.padv_new()
    ll_per.padv_seed(var t, 77)
    ll_per.padv_start(var t, ll_init.CHMAP_ALL, 0)
    var r = ll_pawr.rsp_aa_make(var t)
    if r == aa
        r = r ^ 0x00010000
    r

// The counter of the first event of the scripted train.
fn pw_ctr() -> Int
    100

// The AUX_ADV_IND of a scripted train with responses: the SyncInfo (the first event 10 ms on) and the Response Timing Information.
fn pw_announce_pdu(aa: Int, rsp_aa: Int) -> Pdu
    var si: Vec[u8; 18] = Vec.new()
    for _ in 0..18
        let _a = si.push(0)
    ll_per.syncinfo_put(var si, 10000, PW_IV, 0x1FFFFFFFFF, 5, aa, 0x123456, pw_ctr())
    var addr: Vec[u8; 6] = Vec.new()
    var none: Vec[u8; 6] = Vec.new()
    for i in 0..6
        let _b = addr.push((0x30 + i) as u8)
        let _n = none.push(0)
    var src: ll_xadv.AdvData = Vec.new()
    var t = ll_per.padv_new()
    ll_pawr.timing_put(var t, rsp_aa, 2, PW_SI, PW_DELAY, PW_SPACING)
    var p = ll_pdu.pdu_new()
    ll_xadv.ext_build_acad(var p,
        7,
        0,
        0,
        0,
        true,
        var addr,
        false,
        var none,
        true,
        0x111,
        5,
        false,
        0,
        0,
        0,
        false,
        0,
        true,
        var si,
        var src,
        0,
        0,
        var t.acad,
        t.acad_n)
    p

// The scripted train as the scanner hears it: the ADV_EXT_IND at 2000 on channel 37, the AUX_ADV_IND at 5000 on channel 12, and the
// AUX_SYNC_SUBEVENT_IND of both subevents of the first `events` events (data 0xC0 + the subevent, and the event's number).
fn pw_peer(var air: SimAir, aa: Int, rsp_aa: Int, n_sub: Int, events: Int)
    hear(var air, 2000, 37, xp(0, -1, 0x111, 5, 12, 100, 0, -200, []))
    hear(var air, 5000, 12, pw_announce_pdu(aa, rsp_aa))
    for k in 0..events
        for s in 0..n_sub
            let ch = ll_link.csa2_channel(ll_per.channel_id(aa), ((pw_ctr() + k) ^ s) & 0xFFFF, 0x1FFFFFFFFF, 37)
            hear(var air,
                15000 + k * 40000 + s * 15000,
                ch,
                xp(0, -1, -1, 0, -1, 0, 0, -200, [0xC0 + s, k]))

// ── LE Power Control (build with `ctl_pcl` in the profile) ─────────────────────

// Feature bit 35 (LE Power Control Request), octet 4 bit 3, as the simulated peer reports it.
const PCL_FEATURE = 0x08

// The LL Control PDUs with the opcode `op` the Controller has sent.
fn pcl_sent(var air: SimAir, op: Int) -> Int
    var n = 0
    for i in 0..list.len(air.tx_op)
        if air.tx_op[i] == op and (air.tx_h[i] & 3) == 3
            n = n + 1
    n

// A Central connection to the simulated Peripheral, which reports the feature, with every LE event enabled.
fn pcl_cen_connect(var c: ctl_hci.Controller, var rf: ll_air.Rf, var air: SimAir, f4: Int)
    test.assert_eq(status_of(var c, 0x2001, [0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF]), 0)
    air.peer_f4 = f4
    air.periph = true
    send(var c, 0x200D, create_connection())
    let _ran = ctl_hci.ctl_step(var c)
    let _d = drain(var c)
    hear(var air, 2000, 37, from_peer(ll_pdu.ADV_IND, 5))
    cis_run(var c, var rf, var air, 200000, 0, 0)
    test.assert(c.links[0].live)
    test.assert(c.links[0].central)

// A Peripheral connection to the simulated Central with every LE event enabled.
fn pcl_per_connect(var c: ctl_hci.Controller, var rf: ll_air.Rf, var air: SimAir)
    test.assert_eq(status_of(var c, 0x2001, [0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF]), 0)
    advertise(var c, 0)
    air.central = true
    air.acl_period = 30000
    react(var air, ll_pdu.ADV_IND, 37, connect_ind(), 1)
    cis_run(var c, var rf, var air, 100000, 0, 0)
    test.assert(c.links[0].live)

fn pcl_req(mask: Int, delta: Int, level: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_pcl.put_req(var p, mask, delta, level)
    p

fn pcl_rsp(flags: Int, delta: Int, level: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_pcl.put_rsp(var p, flags, delta, level, 0xFF)
    p

// The LE Transmit Power Reporting events (subevent 0x21) the Host has read.
fn pcl_events(var air: SimAir) -> [[Int]]
    meta_events(air.host, 0x21)

// The Central asks (LE Read Remote Transmit Power Level), the Peripheral answers LL_POWER_CONTROL_RSP over the air and the Host gets
// the report with reason Read.
@test
fn test_a_central_reads_the_remote_power_level_over_the_air()
    if not ctl_limits.pcl_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pcl_cen_connect(var c, var rf, var air, PCL_FEATURE)
    let h = c.links[0].handle
    test.assert_eq(cmd_status(var c, 0x2077, [h & 0xFF, h >>> 8, 1]), 0)
    cis_run(var c, var rf, var air, air.now + 200000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_POWER_CONTROL_REQ), 1)
    test.assert_eq(list.len(pcl_events(var air)), 0)
    list.push(air.p_pdus, pcl_rsp(0x01, 0, -10))
    cis_run(var c, var rf, var air, air.now + 200000, 0, 0)
    let ev = pcl_events(var air)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0)
    test.assert_eq(ev[0][7], 2)
    test.assert_eq(ev[0][8], 1)
    test.assert_eq(ev[0][9], 0xF6)
    test.assert_eq(ev[0][10], 0x01)
    test.assert_eq(pcl_sent(var air, ll_data.OP_POWER_CONTROL_REQ), 1)

// The Central of the air asks for a step of -4 dB on LE 1M: the Controller moves its level, answers LL_POWER_CONTROL_RSP carrying the
// level and the change, and reports to the Host that enabled local reporting.
@test
fn test_a_peripheral_answers_a_power_control_request_and_moves_its_level()
    if not ctl_limits.pcl_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pcl_per_connect(var c, var rf, var air)
    let h = c.links[0].handle
    test.assert_eq(status_of(var c, 0x207A, [h & 0xFF, h >>> 8, 1, 0]), 0)
    list.push(air.c_pdus, pcl_req(0x01, -4, 125))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_POWER_CONTROL_RSP), 1)
    test.assert_eq(c.links[0].txp[0] as Int, -4)
    test.assert_eq(c.links[0].txp[1] as Int, 0)
    let ev = pcl_events(var air)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][7], 0)
    test.assert_eq(ev[0][8], 1)
    test.assert_eq(ev[0][9], 0xFC)
    test.assert_eq(ev[0][11], 0xFC)

// A request naming no PHY of the link is answered with LL_REJECT_EXT_IND, error 0x20 (Unsupported LL Parameter Value), and the level stays.
@test
fn test_a_request_with_a_phy_mask_naming_no_phy_is_rejected_over_the_air()
    if not ctl_limits.pcl_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pcl_per_connect(var c, var rf, var air)
    list.push(air.c_pdus, pcl_req(0x03, 0, 0))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_REJECT_EXT_IND), 1)
    test.assert_eq(pcl_sent(var air, ll_data.OP_POWER_CONTROL_RSP), 0)
    var found = 0
    for i in 0..list.len(air.tx_op)
        if air.tx_op[i] == ll_data.OP_REJECT_EXT_IND and (air.tx_h[i] & 3) == 3
            found = found + 1
            test.assert_eq(air.tx_body[i][3], 0x23)
            test.assert_eq(air.tx_body[i][4], 0x20)
    test.assert_eq(found, 1)
    test.assert_eq(c.links[0].txp[0] as Int, 0)

// Both ends ask in the same event: the Controller answers the peer's request without letting it change its own, and the answer to its
// own request is still reported.
@test
fn test_a_request_crossing_the_controllers_own_is_answered_and_the_own_one_still_completes()
    if not ctl_limits.pcl_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pcl_cen_connect(var c, var rf, var air, PCL_FEATURE)
    let h = c.links[0].handle
    test.assert_eq(cmd_status(var c, 0x2077, [h & 0xFF, h >>> 8, 1]), 0)
    list.push(air.p_pdus, pcl_req(0x01, -6, 125))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_POWER_CONTROL_REQ), 1)
    test.assert_eq(pcl_sent(var air, ll_data.OP_POWER_CONTROL_RSP), 1)
    test.assert_eq(c.links[0].txp[0] as Int, 0)
    list.push(air.p_pdus, pcl_rsp(0x00, 0, -3))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    var read = 0
    for e in pcl_events(var air)
        if e[7] == 2
            read = read + 1
            test.assert_eq(e[4], 0)
    test.assert_eq(read, 1)

// The peer answers the request with LL_REJECT_EXT_IND 0x20: the Host gets the report with that status.
@test
fn test_a_peer_that_rejects_the_request_is_reported_with_the_error()
    if not ctl_limits.pcl_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pcl_cen_connect(var c, var rf, var air, PCL_FEATURE)
    let h = c.links[0].handle
    test.assert_eq(cmd_status(var c, 0x2077, [h & 0xFF, h >>> 8, 1]), 0)
    cis_run(var c, var rf, var air, air.now + 200000, 0, 0)
    var j = ll_pdu.pdu_new()
    ll_data.ctrl_reject_ext(var j, 0x23, 0x20)
    list.push(air.p_pdus, j)
    cis_run(var c, var rf, var air, air.now + 200000, 0, 0)
    let ev = pcl_events(var air)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0x20)

// A peer that ignores the request: the wait ends after WAIT_US with status 0x22 (LMP/LL Response Timeout), and the next request is accepted.
@test
fn test_a_peer_that_ignores_the_request_ends_the_wait_with_the_response_timeout()
    if not ctl_limits.pcl_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pcl_cen_connect(var c, var rf, var air, PCL_FEATURE)
    let h = c.links[0].handle
    test.assert_eq(cmd_status(var c, 0x2077, [h & 0xFF, h >>> 8, 1]), 0)
    cis_run(var c, var rf, var air, air.now + 200000, 0, 0)
    test.assert_eq(list.len(pcl_events(var air)), 0)
    cis_run(var c, var rf, var air, air.now + ll_pcl.WAIT_US + 500000, 0, 0)
    let ev = pcl_events(var air)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0x22)

// A peer that does not report the feature: LE Read Remote Transmit Power Level answers Unsupported Remote Feature (0x1A) and sends nothing.
@test
fn test_a_peer_without_the_feature_is_not_asked()
    if not ctl_limits.pcl_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pcl_cen_connect(var c, var rf, var air, 0)
    let h = c.links[0].handle
    // The Controller learns the peer's features with LE Read Remote Features, which the sim peer answers.
    test.assert_eq(cmd_status(var c, 0x2016, [h & 0xFF, h >>> 8]), 0)
    cis_run(var c, var rf, var air, air.now + 200000, 0, 0)
    test.assert_eq(cmd_status(var c, 0x2077, [h & 0xFF, h >>> 8, 1]), 0x1A)
    cis_run(var c, var rf, var air, air.now + 100000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_POWER_CONTROL_REQ), 0)

// A build without the feature answers the peer's request with LL_UNKNOWN_RSP naming the opcode.
@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_a_build_without_power_control_answers_the_request_with_unknown_response()
    if ctl_limits.pcl_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pcl_per_connect(var c, var rf, var air)
    list.push(air.c_pdus, pcl_req(0x01, 0, 0))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_UNKNOWN_RSP), 1)
    test.assert_eq(pcl_sent(var air, ll_data.OP_POWER_CONTROL_RSP), 0)

// ── Connection Subrating (build with `ctl_subrate` in the profile) ─────────────

// Feature bits 37 and 38 (octet 4 bits 5 and 6), as the simulated peer reports them.
const SUB_FEATURE = 0x60

// A Peripheral connection to the simulated Central whose Host set the Connection Subrating (Host Support) bit first.
fn sub_per_connect(var c: ctl_hci.Controller, var rf: ll_air.Rf, var air: SimAir)
    test.assert_eq(status_of(var c, 0x2001, [0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF]), 0)
    test.assert_eq(status_of(var c, 0x2074, [38, 1]), 0)
    advertise(var c, 0)
    air.central = true
    air.acl_period = 30000
    react(var air, ll_pdu.ADV_IND, 37, connect_ind(), 1)
    cis_run(var c, var rf, var air, 100000, 0, 0)
    test.assert(c.links[0].live)

// A Central connection to the simulated Peripheral, which reports both subrating bits, with the Host Support bit set first.
fn sub_cen_connect(var c: ctl_hci.Controller, var rf: ll_air.Rf, var air: SimAir)
    test.assert_eq(status_of(var c, 0x2001, [0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF]), 0)
    test.assert_eq(status_of(var c, 0x2074, [38, 1]), 0)
    air.peer_f4 = SUB_FEATURE
    air.periph = true
    send(var c, 0x200D, create_connection())
    let _ran = ctl_hci.ctl_step(var c)
    let _d = drain(var c)
    hear(var air, 2000, 37, from_peer(ll_pdu.ADV_IND, 5))
    cis_run(var c, var rf, var air, 200000, 0, 0)
    test.assert(c.links[0].live)
    test.assert(c.links[0].central)
    // The feature exchange the Host would ask for: the peer reports both bits.
    cis_run(var c, var rf, var air, air.now + 400000, 0, 0)
    t_peer_features(var c.links[0], 0, ll_link.FEAT0_EXT_REJECT)
    t_peer_features(var c.links[0], 4, SUB_FEATURE)

fn sub_ind(factor: Int, base: Int, lat: Int, cont: Int, timeout: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_sub.put_ind(var p, factor, base, lat, cont, timeout)
    p

fn sub_req(fmin: Int, fmax: Int, lat: Int, cont: Int, timeout: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_sub.put_req(var p, fmin, fmax, lat, cont, timeout)
    p

// The LE Subrate Change events (subevent 0x23) the Host has read.
fn sub_events(var air: SimAir) -> [[Int]]
    meta_events(air.host, 0x23)

// The command LE Subrate Request: the handle and the five values.
fn sub_request_params(h: Int, fmin: Int, fmax: Int, lat: Int, cont: Int, to: Int) -> [Int]
    [h & 0xFF,
        h >>> 8,
        fmin & 0xFF,
        fmin >>> 8,
        fmax & 0xFF,
        fmax >>> 8,
        lat & 0xFF,
        lat >>> 8,
        cont & 0xFF,
        cont >>> 8,
        to & 0xFF,
        to >>> 8]

// The command LE Set Default Subrate: the five values.
fn sub_default_params(fmin: Int, fmax: Int, lat: Int, cont: Int, to: Int) -> [Int]
    [fmin & 0xFF,
        fmin >>> 8,
        fmax & 0xFF,
        fmax >>> 8,
        lat & 0xFF,
        lat >>> 8,
        cont & 0xFF,
        cont >>> 8,
        to & 0xFF,
        to >>> 8]

// The packets the Controller has sent so far.
fn sub_tx(var air: SimAir) -> Int
    list.len(air.tx_t)

// Without the feature the commands are unknown and LL_SUBRATE_IND is answered with LL_UNKNOWN_RSP.
@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_a_build_without_subrating_answers_neither_command_nor_pdu()
    if ctl_limits.sub_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pcl_per_connect(var c, var rf, var air)
    test.assert_eq(status_of(var c, 0x207D, sub_default_params(1, 4, 0, 0, 500)), 1)
    list.push(air.c_pdus, sub_ind(4, 0, 0, 0, 500))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_UNKNOWN_RSP), 1)
    test.assert_eq(c.links[0].sub_factor as Int, 1)

// A Peripheral takes LL_SUBRATE_IND at once: it listens on one event in four, reports the change, and keeps the connection.
@test
fn test_a_peripheral_applies_the_indication_and_listens_on_one_event_in_four()
    if not ctl_limits.sub_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    sub_per_connect(var c, var rf, var air)
    let n0 = sub_tx(var air)
    cis_run(var c, var rf, var air, air.now + 1200000, 0, 0)
    let full = sub_tx(var air) - n0
    test.assert(full >= 38)
    list.push(air.c_pdus, sub_ind(4, 0, 0, 0, 500))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(c.links[0].sub_factor as Int, 4)
    test.assert_eq(c.links[0].timeout, 500)
    let ev = sub_events(var air)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0)
    test.assert_eq(ev[0][7], 4)
    test.assert_eq(ev[0][13] | (ev[0][14] << 8), 500)
    let n1 = sub_tx(var air)
    cis_run(var c, var rf, var air, air.now + 1200000, 0, 0)
    let sub = sub_tx(var air) - n1
    test.assert(sub >= 9 and sub <= 11)
    test.assert(c.links[0].live)

// Data on a subrated event makes the events after it, as many as the continuation number, continuation events: the Peripheral listens on them.
@test
fn test_data_on_a_subrated_event_makes_the_next_events_continuation_events()
    if not ctl_limits.sub_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    sub_per_connect(var c, var rf, var air)
    list.push(air.c_pdus, sub_ind(8, 0, 0, 2, 500))
    cis_run(var c, var rf, var air, air.now + 1500000, 0, 0)
    test.assert_eq(c.links[0].sub_cont as Int, 2)
    let quiet0 = sub_tx(var air)
    cis_run(var c, var rf, var air, air.now + 1920000, 0, 0)
    let quiet = sub_tx(var air) - quiet0
    // 1.92 s is eight subrated events of 240 ms.
    test.assert(quiet >= 7 and quiet <= 9)
    // A start of an L2CAP PDU of two octets in a subrated event.
    var d = ll_pdu.pdu_new()
    ll_data.dpdu_begin(var d, ll_data.LLID_START)
    let _a = ll_pdu.pdu_put(var d, 0x01)
    let _b = ll_pdu.pdu_put(var d, 0x00)
    let _c = ll_pdu.pdu_put(var d, 0x04)
    let _e = ll_pdu.pdu_put(var d, 0x00)
    ll_data.dpdu_finish(var d)
    list.push(air.c_pdus, d)
    let busy0 = sub_tx(var air)
    cis_run(var c, var rf, var air, air.now + 1920000, 0, 0)
    let busy = sub_tx(var air) - busy0
    // The packet and the two continuation events after it come on top of the subrated events.
    test.assert(busy >= quiet + 2)
    test.assert(busy <= quiet + 4)

// A Peripheral whose Central goes silent still loses the connection at the supervision timeout, with the events between used ones skipped.
@test
fn test_supervision_timeout_fires_across_skipped_events()
    if not ctl_limits.sub_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    sub_per_connect(var c, var rf, var air)
    list.push(air.c_pdus, sub_ind(8, 0, 0, 0, 100))
    cis_run(var c, var rf, var air, air.now + 800000, 0, 0)
    test.assert_eq(c.links[0].sub_factor as Int, 8)
    test.assert(c.links[0].live)
    air.central = false
    air.acl_period = 0
    cis_run(var c, var rf, var air, air.now + 3000000, 0, 0)
    var why = -1
    for e in packets_of(air.host)
        if e[0] == 0x04 and e[1] == 0x05
            why = e[6]
    test.assert_eq(why, 0x08)
    test.assert(not c.links[0].live)

// A Central starts the update on the Host's request, sends LL_SUBRATE_IND, takes the new values at the acknowledgement and reports the change.
@test
fn test_a_central_updates_the_subrate_on_the_hosts_request()
    if not ctl_limits.sub_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    sub_cen_connect(var c, var rf, var air)
    let h = c.links[0].handle
    test.assert_eq(cmd_status(var c, 0x207E, sub_request_params(h, 4, 4, 0, 1, 500)), 0)
    cis_run(var c, var rf, var air, air.now + 600000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_SUBRATE_IND), 1)
    test.assert_eq(c.links[0].sub_factor as Int, 4)
    test.assert_eq(c.links[0].sub_cont as Int, 1)
    test.assert_eq(c.links[0].timeout, 500)
    test.assert(not c.links[0].sub_tr)
    let ev = sub_events(var air)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0)
    test.assert_eq(ev[0][7], 4)
    let n0 = sub_tx(var air)
    cis_run(var c, var rf, var air, air.now + 1200000, 0, 0)
    let sub = sub_tx(var air) - n0
    test.assert(sub >= 9 and sub <= 11)
    test.assert(c.links[0].live)

// A request outside what the Host allows, or one without the Host's support bit, is refused with LL_REJECT_EXT_IND; an allowed one is
// answered with LL_SUBRATE_IND and the values the rules pick.
@test
fn test_a_central_answers_the_requests_of_its_peripheral()
    if not ctl_limits.sub_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    sub_cen_connect(var c, var rf, var air)
    test.assert_eq(status_of(var c, 0x207D, sub_default_params(2, 8, 2, 1, 400)), 0)
    // The connection took its limits when it was made, before the default: set them for this connection with the command.
    c.sub[0].amin = 2
    c.sub[0].amax = 8
    c.sub[0].alat = 2
    c.sub[0].acont = 1
    c.sub[0].ato = 400
    list.push(air.p_pdus, sub_req(9, 12, 0, 0, 300))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_REJECT_EXT_IND), 1)
    test.assert_eq(c.links[0].sub_factor as Int, 1)
    list.push(air.p_pdus, sub_req(3, 6, 1, 0, 300))
    cis_run(var c, var rf, var air, air.now + 600000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_SUBRATE_IND), 1)
    test.assert_eq(c.links[0].sub_factor as Int, 3)
    test.assert_eq(c.links[0].latency, 1)
    test.assert_eq(c.links[0].sub_cont as Int, 1)
    test.assert_eq(c.links[0].timeout, 300)
    let ev = sub_events(var air)
    test.assert_eq(list.len(ev), 1)

// A request that arrives while the Central's own update is open is refused with Different Transaction Collision (0x23).
@test
fn test_a_request_that_crosses_the_centrals_own_update_is_refused()
    if not ctl_limits.sub_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    sub_cen_connect(var c, var rf, var air)
    c.sub[0].amin = 1
    c.sub[0].amax = 8
    c.sub[0].alat = 2
    c.sub[0].ato = 400
    c.links[0].sub_tr = true
    list.push(air.p_pdus, sub_req(2, 4, 0, 0, 300))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_REJECT_EXT_IND), 1)
    var code = -1
    for i in 0..list.len(air.tx_op)
        if air.tx_op[i] == ll_data.OP_REJECT_EXT_IND
            code = air.tx_b2[i]
    test.assert_eq(code, 0x23)

// A Peripheral sends LL_SUBRATE_REQ on the Host's request and reports the Central's answer; a refusal is reported with its error.
@test
fn test_a_peripheral_asks_and_hears_the_answer_or_the_refusal()
    if not ctl_limits.sub_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    sub_per_connect(var c, var rf, var air)
    t_peer_features(var c.links[0], 4, 0x60)
    let h = c.links[0].handle
    test.assert_eq(cmd_status(var c, 0x207E, sub_request_params(h, 2, 4, 0, 0, 500)), 0)
    // A second request while one waits is not allowed.
    test.assert_eq(cmd_status(var c, 0x207E, sub_request_params(h, 2, 4, 0, 0, 500)), 0x0C)
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_SUBRATE_REQ), 1)
    var rej = ll_pdu.pdu_new()
    ll_data.ctrl_reject_ext(var rej, ll_data.OP_SUBRATE_REQ, 0x11)
    list.push(air.c_pdus, rej)
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    var ev = sub_events(var air)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0x11)
    test.assert_eq(c.links[0].sub_factor as Int, 1)
    test.assert_eq(cmd_status(var c, 0x207E, sub_request_params(h, 2, 4, 0, 0, 500)), 0)
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    list.push(air.c_pdus, sub_ind(2, 0, 0, 0, 500))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    ev = sub_events(var air)
    test.assert_eq(list.len(ev), 2)
    test.assert_eq(ev[1][4], 0)
    test.assert_eq(ev[1][7], 2)

// The ranges and errors of the two commands.
@test
fn test_the_subrate_commands_check_their_values()
    if not ctl_limits.sub_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    sub_cen_connect(var c, var rf, var air)
    let h = c.links[0].handle
    test.assert_eq(status_of(var c, 0x207D, sub_default_params(4, 2, 0, 0, 500)), 0x12)
    test.assert_eq(status_of(var c, 0x207D, sub_default_params(1, 250, 2, 0, 500)), 0x12)
    test.assert_eq(status_of(var c, 0x207D, sub_default_params(0, 2, 0, 0, 500)), 0x12)
    test.assert_eq(status_of(var c, 0x207D, sub_default_params(1, 4, 0, 0, 5)), 0x12)
    test.assert_eq(status_of(var c, 0x207D, sub_default_params(1, 4, 0, 0, 500)), 0)
    test.assert_eq(cmd_status(var c, 0x207E, sub_request_params(h + 1, 2, 4, 0, 0, 500)), 0x02)
    test.assert_eq(cmd_status(var c, 0x207E, sub_request_params(h, 4, 2, 0, 0, 500)), 0x12)
    test.assert_eq(cmd_status(var c, 0x207E, sub_request_params(h, 2, 4, 0, 4, 500)), 0x12)
    test.assert_eq(cmd_status(var c, 0x207E, sub_request_params(h, 2, 200, 4, 0, 500)), 0x12)
    test.assert_eq(cmd_status(var c, 0x207E, sub_request_params(h, 2, 4, 0, 0, 20)), 0x12)
    t_peer_features(var c.links[0], 4, 0)
    test.assert_eq(cmd_status(var c, 0x207E, sub_request_params(h, 2, 4, 0, 0, 500)), 0x1A)

// ── Feature Page Exchange (build with `ctl_featpages` in the profile) ──────────

fn featext_events(var air: SimAir) -> [[Int]]
    meta_events(air.host, 0x2B)

fn featext_req(maxp: Int, page: Int, p1: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_feat.put_ext(var p, ll_data.OP_FEATURE_EXT_REQ, maxp, page, p1)
    p

fn featext_rsp(maxp: Int, page: Int, p1: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_feat.put_ext(var p, ll_data.OP_FEATURE_EXT_RSP, maxp, page, p1)
    p

// The body of the last control PDU with opcode `op` the Controller sent, [] for none.
fn pcl_last_body(var air: SimAir, op: Int) -> [Int]
    var out: [Int] = []
    for i in 0..list.len(air.tx_op)
        if air.tx_op[i] == op and (air.tx_h[i] & 3) == 3
            out = air.tx_body[i][:]
    out

fn featext_read_all(var c: ctl_hci.Controller, pages: Int) -> Int
    let h = c.links[0].handle
    cmd_status(var c, 0x2088, [h & 0xFF, h >>> 8, pages])

// A build without the Feature Page Exchange: the commands are unknown and the PDUs are answered with LL_UNKNOWN_RSP.
@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_a_build_without_feature_pages_answers_neither_command_nor_pdu()
    if ctl_limits.feat_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pcl_per_connect(var c, var rf, var air)
    test.assert_eq(status_of(var c, 0x2087, []), 1)
    let h = c.links[0].handle
    test.assert_eq(status_of(var c, 0x2088, [h & 0xFF, h >>> 8, 1]), 1)
    list.push(air.c_pdus, featext_req(0, 1, 0))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_UNKNOWN_RSP), 1)
    test.assert_eq(pcl_sent(var air, ll_data.OP_FEATURE_EXT_RSP), 0)

// LE Read All Local Supported Features: the highest page, page 0 with feature 63, the pages above zero, 248 octets.
@test
fn test_read_all_local_features_returns_248_octets_with_feature_63()
    if not ctl_limits.feat_on()
        return
    var c = fresh()
    send(var c, 0x2087, [])
    let _ran = ctl_hci.ctl_step(var c)
    let r = drain(var c)
    test.assert_eq(list.len(r), 7 + 1 + 248)
    test.assert_eq(r[6], 0)
    test.assert_eq(r[7], ll_feat.max_page(ctl_limits.page1_bits()))
    test.assert_eq(r[8 + 7], 0x80)
    test.assert_eq(r[8 + 0], 0x7F)
    // Page 1 holds the bits of the build (bit 72 with Connection Rate), the others are zero.
    test.assert_eq(r[8 + 8], ctl_limits.page1_bits() & 0xFF)
    test.assert_eq(r[8 + 9], (ctl_limits.page1_bits() >>> 8) & 0xFF)
    for i in 10..248
        test.assert_eq(r[8 + i], 0)
    // Page 0 is what LE Read Local Supported Features gives.
    send(var c, 0x2003, [])
    let _r2 = ctl_hci.ctl_step(var c)
    let q = drain(var c)
    for i in 0..8
        test.assert_eq(q[7 + i], r[8 + i])

// A peer asks for a page: the Controller answers the same page with its highest page, refuses page 0 and 11, and answers a page above 1 with zeros.
@test
fn test_a_peer_page_request_is_answered_and_the_numbers_are_checked()
    if not ctl_limits.feat_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pcl_per_connect(var c, var rf, var air)
    list.push(air.c_pdus, featext_req(1, 1, 0x0102))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    var b = pcl_last_body(var air, ll_data.OP_FEATURE_EXT_RSP)
    test.assert_eq(list.len(b), 29)
    test.assert_eq(b[3], ll_feat.max_page(ctl_limits.page1_bits()))
    test.assert_eq(b[4], 1)
    test.assert_eq(b[5], ctl_limits.page1_bits() & 0xFF)
    test.assert_eq(b[6], (ctl_limits.page1_bits() >>> 8) & 0xFF)
    // The peer's page was kept.
    test.assert_eq(ll_link.fx_get(c.links[0], ll_link.FX_HAVE, 1), 1)
    test.assert_eq(ll_link.fx_get(c.links[0], ll_link.FX_PEER, 0xFFFFFF) & 0xFF, 0x02)
    test.assert_eq(ll_link.fx_get(c.links[0], ll_link.FX_MAX, 0xF), 1)
    // A Controller whose page 1 has bits says so: the highest page is 1 and the octets follow.
    ll_link.fx_put(var c.links[0], ll_link.FX_LOCAL, 0xFFFF, 0x0A05)
    list.push(air.c_pdus, featext_req(0, 1, 0))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    b = pcl_last_body(var air, ll_data.OP_FEATURE_EXT_RSP)
    test.assert_eq(b[3], 1)
    test.assert_eq(b[4], 1)
    test.assert_eq(b[5], 0x05)
    test.assert_eq(b[6], 0x0A)
    list.push(air.c_pdus, featext_req(10, 3, 0))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    b = pcl_last_body(var air, ll_data.OP_FEATURE_EXT_RSP)
    test.assert_eq(b[4], 3)
    test.assert_eq(b[5], 0)
    let n = pcl_sent(var air, ll_data.OP_FEATURE_EXT_RSP)
    list.push(air.c_pdus, featext_req(0, 0, 0))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    list.push(air.c_pdus, featext_req(0, 11, 0))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_FEATURE_EXT_RSP), n)
    test.assert_eq(pcl_sent(var air, ll_data.OP_REJECT_EXT_IND), 2)
    b = pcl_last_body(var air, ll_data.OP_REJECT_EXT_IND)
    test.assert_eq(b[3], 0x2B)
    test.assert_eq(b[4], 0x1E)
    test.assert(c.links[0].live)

// A Central reads all remote features of a peer with feature 63: page 0, then page 1; the Host hears one event, and the Controller holds the pages.
@test
fn test_a_central_reads_all_remote_features_over_the_air()
    if not ctl_limits.feat_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    air.peer_f7 = 0x80
    air.peer_p1 = 0x0300
    air.peer_maxp = 1
    pcl_cen_connect(var c, var rf, var air, 0)
    test.assert_eq(featext_read_all(var c, 1), 0)
    cis_run(var c, var rf, var air, air.now + 600000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_FEATURE_REQ), 1)
    test.assert_eq(pcl_sent(var air, ll_data.OP_FEATURE_EXT_REQ), 1)
    let ev = featext_events(var air)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0)
    test.assert_eq(ev[0][7], 1)
    test.assert_eq(ev[0][8], 1)
    test.assert_eq(ev[0][9 + 7], 0x80)
    test.assert_eq(ev[0][17 + 1], 0x03)
    test.assert_eq(list.len(ev[0]), 4 + 1 + 2 + 2 + 248)
    // No page 0 event was sent: the Host asked for all pages.
    test.assert_eq(list.len(meta_events(air.host, 0x04)), 0)
    // The pages are held: a second read sends nothing.
    test.assert_eq(featext_read_all(var c, 10), 0)
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_FEATURE_REQ), 1)
    test.assert_eq(pcl_sent(var air, ll_data.OP_FEATURE_EXT_REQ), 1)
    test.assert_eq(list.len(featext_events(var air)), 2)

// A peer without feature 63 is not asked for a page, whatever the Host asked for; nor is one when the Host asked for page 0 only.
@test
fn test_no_page_is_requested_from_a_peer_without_feature_63_or_for_page_0()
    if not ctl_limits.feat_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pcl_cen_connect(var c, var rf, var air, 0)
    test.assert_eq(featext_read_all(var c, 10), 0)
    cis_run(var c, var rf, var air, air.now + 400000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_FEATURE_EXT_REQ), 0)
    var ev = featext_events(var air)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0)
    test.assert_eq(ev[0][7], 0)
    test.assert_eq(ev[0][8], 0)
    // The same with page 0 only and a peer that has the feature.
    var c2 = fresh()
    var rf2 = ll_air.rf_new()
    var air2 = sim_new()
    air2.peer_f7 = 0x80
    pcl_cen_connect(var c2, var rf2, var air2, 0)
    test.assert_eq(featext_read_all(var c2, 0), 0)
    cis_run(var c2, var rf2, var air2, air2.now + 400000, 0, 0)
    test.assert_eq(pcl_sent(var air2, ll_data.OP_FEATURE_EXT_REQ), 0)
    ev = featext_events(var air2)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0)
    test.assert_eq(ev[0][8], 0)

// The peer's highest page is reported as it is (Max_Remote_Page), with page 1 the highest page obtained.
@test
fn test_the_remote_highest_page_is_reported_beyond_the_pages_obtained()
    if not ctl_limits.feat_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    air.peer_f7 = 0x80
    air.peer_maxp = 10
    air.peer_p1 = 0x10
    pcl_cen_connect(var c, var rf, var air, 0)
    test.assert_eq(featext_read_all(var c, 10), 0)
    cis_run(var c, var rf, var air, air.now + 600000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_FEATURE_EXT_REQ), 1)
    let ev = featext_events(var air)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][7], 10)
    test.assert_eq(ev[0][8], 1)
    test.assert_eq(ev[0][17], 0x10)

// The error cases of the command: an unknown handle, a page above 10, a second read while one is open.
@test
fn test_read_all_remote_features_checks_its_parameters_and_runs_one_at_a_time()
    if not ctl_limits.feat_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    air.peer_f7 = 0x80
    air.peer_ext = 4
    pcl_cen_connect(var c, var rf, var air, 0)
    let h = c.links[0].handle
    test.assert_eq(cmd_status(var c, 0x2088, [(h + 1) & 0xFF, (h + 1) >>> 8, 1]), 0x02)
    test.assert_eq(featext_read_all(var c, 11), 0x12)
    test.assert_eq(featext_read_all(var c, 1), 0)
    cis_run(var c, var rf, var air, air.now + 400000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_FEATURE_EXT_REQ), 1)
    test.assert_eq(list.len(featext_events(var air)), 0)
    test.assert_eq(featext_read_all(var c, 1), 0x0C)
    // LE Read Remote Features (page 0) is not started beside the open exchange either.
    test.assert_eq(cmd_status(var c, 0x2016, [h & 0xFF, h >>> 8]), 0x0C)

// Requests that cross: the peer asks for a page while the Controller waits for its answer; both are answered and the read completes.
@test
fn test_crossing_page_requests_are_both_answered()
    if not ctl_limits.feat_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    air.peer_f7 = 0x80
    air.peer_ext = 4
    pcl_cen_connect(var c, var rf, var air, 0)
    test.assert_eq(featext_read_all(var c, 1), 0)
    cis_run(var c, var rf, var air, air.now + 400000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_FEATURE_EXT_REQ), 1)
    list.push(air.p_pdus, featext_req(1, 1, 0x40))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_FEATURE_EXT_RSP), 1)
    test.assert_eq(list.len(featext_events(var air)), 0)
    list.push(air.p_pdus, featext_rsp(1, 1, 0x40))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    let ev = featext_events(var air)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0)
    test.assert_eq(ev[0][17], 0x40)

// A peer that does not know the PDU, refuses it, or answers another page ends the read with a status.
@test
fn test_a_peer_that_cannot_answer_a_page_request_ends_the_read_with_a_status()
    if not ctl_limits.feat_on()
        return
    let codes: [Int] = [0x1A, 0x1F, 0x1E]
    for k in 0..3
        var c = fresh()
        var rf = ll_air.rf_new()
        var air = sim_new()
        air.peer_f7 = 0x80
        air.peer_ext = k + 1
        pcl_cen_connect(var c, var rf, var air, 0)
        test.assert_eq(featext_read_all(var c, 1), 0)
        cis_run(var c, var rf, var air, air.now + 600000, 0, 0)
        let ev = featext_events(var air)
        test.assert_eq(list.len(ev), 1)
        test.assert_eq(ev[0][4], codes[k])
        test.assert_eq(ev[0][7], 0)
        test.assert_eq(ev[0][8], 0)
        test.assert_eq(ev[0][17], 0)
        test.assert(c.links[0].live)

// A Peripheral reads all remote features: LL_PERIPHERAL_FEATURE_REQ, then the page request, both answered by the scripted Central.
@test
fn test_a_peripheral_reads_all_remote_features_over_the_air()
    if not ctl_limits.feat_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pcl_per_connect(var c, var rf, var air)
    test.assert_eq(featext_read_all(var c, 1), 0)
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_PERIPHERAL_FEATURE_REQ), 1)
    var p = ll_pdu.pdu_new()
    var f: Vec[u8; 8] = Vec.new()
    for _ in 0..8
        let _f = f.push(0)
    f[0] = 0x7F
    f[7] = 0x80
    ll_data.ctrl_features(var p, ll_data.OP_FEATURE_RSP, var f)
    list.push(air.c_pdus, p)
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_FEATURE_EXT_REQ), 1)
    list.push(air.c_pdus, featext_rsp(1, 1, 0x7))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    let ev = featext_events(var air)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0)
    test.assert_eq(ev[0][8], 1)
    test.assert_eq(ev[0][17], 0x07)
    // A Central that answers the Peripheral's request with LL_UNKNOWN_RSP ends the read as unsupported.
    var c2 = fresh()
    var rf2 = ll_air.rf_new()
    var air2 = sim_new()
    pcl_per_connect(var c2, var rf2, var air2)
    test.assert_eq(featext_read_all(var c2, 1), 0)
    cis_run(var c2, var rf2, var air2, air2.now + 300000, 0, 0)
    var u = ll_pdu.pdu_new()
    ll_data.ctrl_unknown_rsp(var u, ll_data.OP_PERIPHERAL_FEATURE_REQ)
    list.push(air2.c_pdus, u)
    cis_run(var c2, var rf2, var air2, air2.now + 300000, 0, 0)
    let ev2 = featext_events(var air2)
    test.assert_eq(list.len(ev2), 1)
    test.assert_eq(ev2[0][4], 0x1A)

// ── Connection Rate (build with `ctl_connrate` in the profile) ─────────────────

// Feature bits 72 and 73 (octet 1 bits 0 and 1 of page 1), as the simulated peer reports them.
const RATE_P1 = 0x300

fn rate_events(var air: SimAir) -> [[Int]]
    meta_events(air.host, 0x37)

// The command LE Connection Rate Request: the handle, the interval range, the subrate range, the latency, the continuation number, the timeout
// and the connection event lengths.
fn rate_request_params(h: Int, imin: Int, imax: Int, fmin: Int, fmax: Int, lat: Int, cont: Int,
                       to: Int) -> [Int]
    var p: [Int] = []
    for v in [h, imin, imax, fmin, fmax, lat, cont, to, 1, 0x7CFF]
        list.push(p, v & 0xFF)
        list.push(p, (v >>> 8) & 0xFF)
    p

// The command LE Set Default Rate Parameters: the same without the handle.
fn rate_default_params(imin: Int, imax: Int, fmin: Int, fmax: Int, lat: Int, cont: Int,
                       to: Int) -> [Int]
    var p: [Int] = []
    for v in [imin, imax, fmin, fmax, lat, cont, to, 1, 0x7CFF]
        list.push(p, v & 0xFF)
        list.push(p, (v >>> 8) & 0xFF)
    p

fn rate_req_pdu(imin: Int, imax: Int, fmin: Int, fmax: Int, lat: Int, cont: Int, to: Int,
                period: Int, ref: Int, off0: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_rate.put_req(var p, imin, imax, fmin, fmax, lat, cont, to, period, ref, off0)
    p

fn rate_ind_pdu(woff: Int, iv: Int, instant: Int, factor: Int, lat: Int, cont: Int, to: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_rate.put_ind(var p, woff, iv, instant, factor, lat, cont, to)
    p

// A Peripheral connection to the simulated Central whose Host set the Connection Subrating and Shorter Connection Intervals (Host Support) bits
// (73 only when `host73`), the peer's page 1 known to have both bits.
fn rate_per_connect(var c: ctl_hci.Controller, var rf: ll_air.Rf, var air: SimAir, host73: Bool)
    test.assert_eq(status_of(var c, 0x2001, [0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF]), 0)
    test.assert_eq(status_of(var c, 0x2074, [38, 1]), 0)
    if host73
        test.assert_eq(status_of(var c, 0x2074, [73, 1]), 0)
    advertise(var c, 0)
    air.central = true
    air.acl_period = 30000
    react(var air, ll_pdu.ADV_IND, 37, connect_ind(), 1)
    cis_run(var c, var rf, var air, 100000, 0, 0)
    test.assert(c.links[0].live)
    t_peer_features(var c.links[0], 4, SUB_FEATURE)
    t_peer_features(var c.links[0], 7, 0x80)
    ll_link.fx_put(var c.links[0], ll_link.FX_PEER, 0xFFFFFF, RATE_P1)
    ll_link.fx_put(var c.links[0], ll_link.FX_HAVE, 1, 1)

// A Central connection to the simulated Peripheral, which reports feature 63 and the page 1 `p1`; the Controller reads the page when the Host
// asks for a rate change.
fn rate_cen_connect(var c: ctl_hci.Controller, var rf: ll_air.Rf, var air: SimAir, p1: Int)
    test.assert_eq(status_of(var c, 0x2001, [0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF]), 0)
    test.assert_eq(status_of(var c, 0x2074, [38, 1]), 0)
    test.assert_eq(status_of(var c, 0x2074, [73, 1]), 0)
    air.peer_f4 = SUB_FEATURE
    air.peer_f7 = 0x80
    air.peer_p1 = p1
    air.peer_maxp = 1
    air.periph = true
    send(var c, 0x200D, create_connection())
    let _ran = ctl_hci.ctl_step(var c)
    let _d = drain(var c)
    hear(var air, 2000, 37, from_peer(ll_pdu.ADV_IND, 5))
    cis_run(var c, var rf, var air, 200000, 0, 0)
    test.assert(c.links[0].live)
    test.assert(c.links[0].central)

// A build without Connection Rate: its four commands are unknown, its two PDUs are answered with LL_UNKNOWN_RSP, and LE feature 72 is clear.
@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_a_build_without_connection_rate_answers_neither_commands_nor_pdus()
    if ctl_limits.rate_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pcl_per_connect(var c, var rf, var air)
    test.assert_eq(status_of(var c, 0x20A2, rate_default_params(60, 400, 1, 4, 0, 0, 500)), 1)
    test.assert_eq(status_of(var c, 0x20A3, []), 1)
    test.assert_eq(status_of(var c, 0x2097, [73, 0, 1]), 1)
    test.assert_eq(cmd_status_of(var c, 0x20A1, rate_request_params(c.links[0].handle, 60, 400, 1, 4, 0, 0, 500)),
        1)
    list.push(air.c_pdus, rate_ind_pdu(0, 240, 12, 4, 0, 1, 500))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_UNKNOWN_RSP), 1)
    test.assert_eq(c.links[0].sub_factor as Int, 1)
    // LE Set Host Feature (a build with isochronous channels has it) names bit 73 as unsupported.
    if ctl_limits.iso_on()
        test.assert_eq(status_of(var c, 0x2074, [73, 1]), 0x11)

// LE feature 72 is in the Controller's page 1; bit 73 follows the Host; the four commands are in Supported Commands.
@test
fn test_the_page_1_bits_and_the_supported_commands_of_connection_rate()
    if not ctl_limits.rate_on()
        return
    var c = fresh()
    // Bit 75, Channel Sounding Enhancement #1, is bit 3 of the second octet of page 1 in a build with it.
    var cs_hi = 0
    if ctl_limits.cs_ipt_on()
        cs_hi = 0x08
    send(var c, 0x2087, [])
    let _a = ctl_hci.ctl_step(var c)
    var r = drain(var c)
    test.assert_eq(r[8 + 9], 0x01 | cs_hi)
    test.assert_eq(r[7], 1)
    // The Host sets bit 73 with LE Set Host Feature [v1], and clears it with [v2], which has a two-octet bit number.
    test.assert_eq(status_of(var c, 0x2074, [73, 1]), 0)
    send(var c, 0x2087, [])
    let _b = ctl_hci.ctl_step(var c)
    r = drain(var c)
    test.assert_eq(r[8 + 9], 0x03 | cs_hi)
    test.assert_eq(status_of(var c, 0x2097, [73, 0, 0]), 0)
    send(var c, 0x2087, [])
    let _d = ctl_hci.ctl_step(var c)
    r = drain(var c)
    test.assert_eq(r[8 + 9], 0x01 | cs_hi)
    test.assert_eq(status_of(var c, 0x2097, [73, 0, 1]), 0)
    test.assert_eq(status_of(var c, 0x2097, [99, 0, 1]), 0x11)
    test.assert_eq(status_of(var c, 0x2097, [73, 0, 2]), 0x11)
    // Supported Commands: octet 47 bit 4, octet 48 bits 5 to 7.
    send(var c, 0x1002, [])
    let _e = ctl_hci.ctl_step(var c)
    let s = drain(var c)
    test.assert_eq(s[7 + 47] & 0x10, 0x10)
    test.assert_eq(s[7 + 48] & 0xE0, 0xE0)

// LE Read Minimum Supported Connection Interval: 1.25 ms and no group.
@test
fn test_the_minimum_supported_connection_interval_is_1_25_ms_without_groups()
    if not ctl_limits.rate_on()
        return
    var c = fresh()
    send(var c, 0x20A3, [])
    let _a = ctl_hci.ctl_step(var c)
    let r = drain(var c)
    test.assert_eq(list.len(r), 9)
    test.assert_eq(r[6], 0)
    test.assert_eq(r[7], 10)
    test.assert_eq(r[8], 0)

// The ranges and errors of the two commands.
@test
fn test_the_connection_rate_commands_check_their_values()
    if not ctl_limits.rate_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    rate_per_connect(var c, var rf, var air, true)
    let h = c.links[0].handle
    test.assert_eq(status_of(var c, 0x20A2, rate_default_params(400, 60, 1, 4, 0, 0, 500)), 0x12)
    test.assert_eq(status_of(var c, 0x20A2, rate_default_params(2, 400, 1, 4, 0, 0, 500)), 0x12)
    test.assert_eq(status_of(var c, 0x20A2, rate_default_params(60, 400, 4, 1, 0, 0, 500)), 0x12)
    test.assert_eq(status_of(var c, 0x20A2, rate_default_params(60, 400, 1, 4, 0, 4, 500)), 0x12)
    test.assert_eq(status_of(var c, 0x20A2, rate_default_params(60, 400, 1, 4, 0, 0, 5)), 0x12)
    test.assert_eq(status_of(var c, 0x20A2, rate_default_params(60, 8000, 1, 4, 0, 0, 50)), 0x12)
    test.assert_eq(status_of(var c, 0x20A2, rate_default_params(60, 400, 1, 4, 0, 0, 500)), 0)
    test.assert_eq(cmd_status(var c, 0x20A1, rate_request_params(h + 1, 60, 400, 1, 4, 0, 0, 500)), 0x02)
    test.assert_eq(cmd_status(var c, 0x20A1, rate_request_params(h, 400, 60, 1, 4, 0, 0, 500)), 0x12)
    test.assert_eq(cmd_status(var c, 0x20A1, rate_request_params(h, 60, 400, 1, 4, 0, 4, 500)), 0x12)
    test.assert_eq(cmd_status(var c, 0x20A1, rate_request_params(h, 60, 400, 1, 200, 4, 0, 500)), 0x12)
    test.assert_eq(cmd_status(var c, 0x20A1, rate_request_params(h, 60, 400, 1, 4, 0, 0, 20)), 0x12)
    // No interval of the rounded set in the range.
    test.assert_eq(cmd_status(var c, 0x20A1, rate_request_params(h, 11, 19, 1, 4, 0, 0, 500)), 0x20)
    // Interval_Max below connIntervalRequired: the peer sends 251 octets in 2120 us, so 300 + 2120 us are required, which is 20 units of 125 us.
    c.links[0].dl_rem_tx_octets = 251
    c.links[0].dl_rem_tx_time = 2120
    test.assert_eq(cmd_status(var c, 0x20A1, rate_request_params(h, 10, 19, 1, 4, 0, 0, 500)), 0x11)
    // A request the peer is not known to support, and one the Host's own bit does not allow.
    ll_link.fx_put(var c.links[0], ll_link.FX_PEER, 0xFFFFFF, 0x100)
    c.links[0].dl_rem_tx_octets = 27
    c.links[0].dl_rem_tx_time = 328
    test.assert_eq(cmd_status(var c, 0x20A1, rate_request_params(h, 60, 400, 1, 4, 0, 0, 500)), 0)
    var c2 = fresh()
    var rf2 = ll_air.rf_new()
    var air2 = sim_new()
    rate_per_connect(var c2, var rf2, var air2, false)
    test.assert_eq(cmd_status(var c2, 0x20A1, rate_request_params(c2.links[0].handle, 60, 400, 1, 4, 0, 0, 500)),
        0x1A)

// A Peripheral sends LL_CONNECTION_RATE_REQ on the Host's request; the Central answers with LL_CONNECTION_RATE_IND, which applies at its instant, and
// the Host hears the change once.  The Controller then listens on one event in four, at the same interval.
@test
fn test_a_peripheral_asks_and_applies_the_central_update_at_the_instant()
    if not ctl_limits.rate_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    rate_per_connect(var c, var rf, var air, true)
    let h = c.links[0].handle
    test.assert_eq(cmd_status(var c, 0x20A1, rate_request_params(h, 200, 400, 2, 4, 0, 1, 500)), 0)
    // A second request while one waits is not allowed.
    test.assert_eq(cmd_status(var c, 0x20A1, rate_request_params(h, 200, 400, 2, 4, 0, 1, 500)), 0x0C)
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_CONNECTION_RATE_REQ), 1)
    var b = pcl_last_body(var air, ll_data.OP_CONNECTION_RATE_REQ)
    test.assert_eq(list.len(b), 29)
    test.assert_eq(b[3] | (b[4] << 8), 200)
    test.assert_eq(b[5] | (b[6] << 8), 400)
    test.assert_eq(b[7] | (b[8] << 8), 2)
    test.assert_eq(b[9] | (b[10] << 8), 4)
    test.assert_eq(b[11] | (b[12] << 8), 0)
    test.assert_eq(b[13] | (b[14] << 8), 1)
    test.assert_eq(b[15] | (b[16] << 8), 500)
    test.assert_eq(b[17] | (b[18] << 8), 0)
    test.assert_eq(b[21] | (b[22] << 8), 0xFFFF)
    // The Central picks 30 ms (240) and the factor 4, at an instant eight events on.
    let instant = (c.links[0].ev_count + 8) & 0xFFFF
    list.push(air.c_pdus, rate_ind_pdu(0, 240, instant, 4, 0, 1, 500))
    cis_run(var c, var rf, var air, air.now + 600000, 0, 0)
    test.assert_eq(c.links[0].sub_factor as Int, 4)
    test.assert_eq(c.links[0].sub_cont as Int, 1)
    test.assert_eq(c.links[0].interval, 24)
    test.assert_eq(c.links[0].timeout, 500)
    let ev = rate_events(var air)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0)
    test.assert_eq(ev[0][7] | (ev[0][8] << 8), 240)
    test.assert_eq(ev[0][9] | (ev[0][10] << 8), 4)
    test.assert_eq(ev[0][13] | (ev[0][14] << 8), 1)
    test.assert_eq(ev[0][15] | (ev[0][16] << 8), 500)
    test.assert_eq(list.len(sub_events(var air)), 0)
    let n0 = sub_tx(var air)
    cis_run(var c, var rf, var air, air.now + 1200000, 0, 0)
    let sub = sub_tx(var air) - n0
    test.assert(sub >= 9 and sub <= 11)
    test.assert(c.links[0].live)

// The Central refuses the request, or does not know it: the Host hears the code, and the connection goes on.
@test
fn test_a_refused_request_is_reported_with_the_error_or_as_unsupported()
    if not ctl_limits.rate_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    rate_per_connect(var c, var rf, var air, true)
    let h = c.links[0].handle
    test.assert_eq(cmd_status(var c, 0x20A1, rate_request_params(h, 200, 400, 2, 4, 0, 1, 500)), 0)
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    var rej = ll_pdu.pdu_new()
    ll_data.ctrl_reject_ext(var rej, ll_data.OP_CONNECTION_RATE_REQ, 0x20)
    list.push(air.c_pdus, rej)
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    var ev = rate_events(var air)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0x20)
    test.assert_eq(c.links[0].sub_factor as Int, 1)
    test.assert_eq(cmd_status(var c, 0x20A1, rate_request_params(h, 200, 400, 2, 4, 0, 1, 500)), 0)
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    var u = ll_pdu.pdu_new()
    ll_data.ctrl_unknown_rsp(var u, ll_data.OP_CONNECTION_RATE_REQ)
    list.push(air.c_pdus, u)
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    ev = rate_events(var air)
    test.assert_eq(list.len(ev), 2)
    test.assert_eq(ev[1][4], 0x1A)
    test.assert(c.links[0].live)

// A Peripheral that is sent a Connection Rate Update it does not support answers LL_UNKNOWN_RSP and keeps its parameters.
@test
fn test_a_peripheral_answers_an_unsupported_indication_with_unknown_response()
    if not ctl_limits.rate_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    rate_per_connect(var c, var rf, var air, true)
    // 31.25 ms is not a multiple of 1.25 ms.
    list.push(air.c_pdus, rate_ind_pdu(0, 250 + 5, (c.links[0].ev_count + 8) & 0xFFFF, 1, 0, 0, 500))
    cis_run(var c, var rf, var air, air.now + 600000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_UNKNOWN_RSP), 1)
    test.assert_eq(c.links[0].interval, 24)
    test.assert(c.links[0].live)
    test.assert_eq(list.len(rate_events(var air)), 0)

// A Central reads the peer's page 1 itself when the Host asks for a rate change, without telling the Host, then sends LL_CONNECTION_RATE_IND; the new
// interval and factor apply at the instant and the Host hears one LE Connection Rate Change.
@test
fn test_a_central_reads_the_peers_page_and_updates_on_the_hosts_request()
    if not ctl_limits.rate_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    rate_cen_connect(var c, var rf, var air, RATE_P1)
    let h = c.links[0].handle
    test.assert_eq(cmd_status(var c, 0x20A1, rate_request_params(h, 400, 400, 2, 2, 0, 1, 500)), 0)
    cis_run(var c, var rf, var air, air.now + 1500000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_FEATURE_EXT_REQ), 1)
    test.assert_eq(list.len(meta_events(air.host, 0x2B)), 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_CONNECTION_RATE_IND), 1)
    test.assert_eq(c.links[0].interval, 40)
    test.assert_eq(c.links[0].sub_factor as Int, 2)
    test.assert_eq(c.links[0].sub_cont as Int, 1)
    test.assert_eq(c.links[0].timeout, 500)
    let ev = rate_events(var air)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0)
    test.assert_eq(ev[0][7] | (ev[0][8] << 8), 400)
    test.assert_eq(ev[0][9] | (ev[0][10] << 8), 2)
    test.assert(c.links[0].live)
    // The peer's page is held now: the next request needs no read.
    test.assert_eq(cmd_status(var c, 0x20A1, rate_request_params(h, 240, 240, 1, 1, 0, 0, 500)), 0)
    cis_run(var c, var rf, var air, air.now + 1500000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_FEATURE_EXT_REQ), 1)
    test.assert_eq(pcl_sent(var air, ll_data.OP_CONNECTION_RATE_IND), 2)
    test.assert_eq(c.links[0].interval, 24)
    test.assert_eq(list.len(rate_events(var air)), 2)

// A peer whose page 1 lacks the Host Support bit ends the request with Unsupported Remote Feature, and nothing is sent.
@test
fn test_a_peer_without_the_host_support_bit_ends_the_request_as_unsupported()
    if not ctl_limits.rate_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    rate_cen_connect(var c, var rf, var air, 0x100)
    let h = c.links[0].handle
    test.assert_eq(cmd_status(var c, 0x20A1, rate_request_params(h, 400, 400, 2, 2, 0, 1, 500)), 0)
    cis_run(var c, var rf, var air, air.now + 1500000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_CONNECTION_RATE_IND), 0)
    let ev = rate_events(var air)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0x1A)
    test.assert_eq(c.links[0].interval, 24)
    test.assert_eq(list.len(meta_events(air.host, 0x2B)), 0)

// A Central answers the requests of its Peripheral by the limits of the Host: a field out of range, an Interval_Max below connIntervalRequired and a
// request without the Host's bit are refused with their codes, one outside the limits with Unsupported LL Parameter Value, and an allowed one
// is answered with LL_CONNECTION_RATE_IND at the longest supported interval of both ranges, the anchor offset the request names, and the values
// `ll_sub` picks.
@test
fn test_a_central_answers_the_rate_requests_of_its_peripheral()
    if not ctl_limits.rate_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    rate_cen_connect(var c, var rf, var air, RATE_P1)
    test.assert_eq(status_of(var c, 0x20A2, rate_default_params(120, 800, 2, 8, 1, 1, 400)), 0)
    // The connection took its limits when it was made, before the default: set them for this connection.
    c.sub[0].amin = 2
    c.sub[0].amax = 8
    c.sub[0].alat = 1
    c.sub[0].acont = 1
    c.sub[0].ato = 400
    c.sub[0].aiv = ll_rate.pack(120, 800)
    // A field out of range: Interval_Max below Interval_Min.
    list.push(air.p_pdus, rate_req_pdu(300, 200, 3, 6, 1, 0, 300, 0, 0, 0xFFFF))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_REJECT_EXT_IND), 1)
    test.assert_eq(pcl_last_body(var air, ll_data.OP_REJECT_EXT_IND)[4], 0x1E)
    // Outside the limits: 2 ms to 5 ms against 15 ms to 100 ms.
    list.push(air.p_pdus, rate_req_pdu(16, 40, 3, 6, 1, 0, 300, 0, 0, 0xFFFF))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_REJECT_EXT_IND), 2)
    test.assert_eq(pcl_last_body(var air, ll_data.OP_REJECT_EXT_IND)[4], 0x20)
    // Outside the limits: a factor above what the Host allows.
    list.push(air.p_pdus, rate_req_pdu(160, 400, 9, 12, 0, 0, 300, 0, 0, 0xFFFF))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_REJECT_EXT_IND), 3)
    test.assert_eq(pcl_last_body(var air, ll_data.OP_REJECT_EXT_IND)[4], 0x20)
    test.assert_eq(c.links[0].sub_factor as Int, 1)
    // An allowed request: 20 ms to 50 ms with the preferred periodicity 150 (18.75 ms) and Offset0 20 (2.5 ms): the longest multiple of the
    // periodicity in the range is 300 (37.5 ms), the factor 3 and the latency 1.
    let ref = c.links[0].ev_count
    list.push(air.p_pdus, rate_req_pdu(160, 400, 3, 6, 1, 0, 300, 150, ref, 20))
    cis_run(var c, var rf, var air, air.now + 600000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_CONNECTION_RATE_IND), 1)
    let b = pcl_last_body(var air, ll_data.OP_CONNECTION_RATE_IND)
    test.assert_eq(list.len(b), 17)
    test.assert_eq(b[5] | (b[6] << 8), 300)
    test.assert_eq(b[9] | (b[10] << 8), 3)
    test.assert_eq(b[11] | (b[12] << 8), 1)
    test.assert_eq(b[13] | (b[14] << 8), 1)
    test.assert_eq(b[15] | (b[16] << 8), 300)
    test.assert_eq(b[3] | (b[4] << 8), ll_link.anchor_offset(24, 30, b[7] | (b[8] << 8), ref, 2) * 10)
    test.assert_eq(c.links[0].interval, 30)
    test.assert_eq(c.links[0].sub_factor as Int, 3)
    let ev = rate_events(var air)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0)
    test.assert(c.links[0].live)

// A request without the Host's bit, one that crosses the Central's own update and one with an Interval_Max below connIntervalRequired are refused.
@test
fn test_a_central_refuses_a_request_without_the_bit_or_during_an_update_or_below_the_required_interval()
    if not ctl_limits.rate_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    rate_cen_connect(var c, var rf, var air, RATE_P1)
    c.sub[0].amin = 1
    c.sub[0].amax = 8
    c.sub[0].alat = 2
    c.sub[0].ato = 400
    c.sub[0].aiv = ll_rate.pack(10, 800)
    // Interval_Max 5 (625 us) is below the 628 us the default packet lengths require.
    list.push(air.p_pdus, rate_req_pdu(3, 5, 1, 4, 0, 0, 300, 0, 0, 0xFFFF))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_last_body(var air, ll_data.OP_REJECT_EXT_IND)[4], 0x11)
    // The Central's own update is open.
    c.links[0].upd_pending = true
    list.push(air.p_pdus, rate_req_pdu(160, 400, 1, 4, 0, 0, 300, 0, 0, 0xFFFF))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_REJECT_EXT_IND), 2)
    test.assert_eq(pcl_last_body(var air, ll_data.OP_REJECT_EXT_IND)[4], 0x23)
    c.links[0].upd_pending = false
    // The Host's bit is clear on this connection.
    ll_link.link_set_host_rate(var c.links[0], false)
    list.push(air.p_pdus, rate_req_pdu(160, 400, 1, 4, 0, 0, 300, 0, 0, 0xFFFF))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_REJECT_EXT_IND), 3)
    test.assert_eq(pcl_last_body(var air, ll_data.OP_REJECT_EXT_IND)[4], 0x11)
    test.assert_eq(pcl_sent(var air, ll_data.OP_CONNECTION_RATE_IND), 0)

// A Peripheral that answers the Central's LL_CONNECTION_RATE_IND with LL_UNKNOWN_RSP ends the procedure: the update does not happen and the Host is told.
@test
fn test_a_peripheral_that_does_not_know_the_indication_cancels_the_update()
    if not ctl_limits.rate_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    rate_cen_connect(var c, var rf, var air, RATE_P1)
    let h = c.links[0].handle
    ll_link.fx_put(var c.links[0], ll_link.FX_PEER, 0xFFFFFF, RATE_P1)
    ll_link.fx_put(var c.links[0], ll_link.FX_HAVE, 1, 1)
    test.assert_eq(cmd_status(var c, 0x20A1, rate_request_params(h, 400, 400, 2, 2, 0, 1, 500)), 0)
    cis_run(var c, var rf, var air, air.now + 100000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_CONNECTION_RATE_IND), 1)
    var u = ll_pdu.pdu_new()
    ll_data.ctrl_unknown_rsp(var u, ll_data.OP_CONNECTION_RATE_IND)
    list.push(air.p_pdus, u)
    cis_run(var c, var rf, var air, air.now + 1500000, 0, 0)
    test.assert_eq(c.links[0].interval, 24)
    test.assert_eq(c.links[0].sub_factor as Int, 1)
    test.assert(not c.links[0].upd_pending)
    let ev = rate_events(var air)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0x1A)
    test.assert(c.links[0].live)

// ── Frame Space Update (build with `ctl_framespace` in the profile) ────────────

// Feature bit 65 (bit 1 of page 1), as the simulated peer reports it.
const FS_P1 = 0x02

fn fs_events(var air: SimAir) -> [[Int]]
    meta_events(air.host, 0x35)

// The command LE Frame Space Update: the handle, the range, the PHYs and the spacing types.
fn fs_params(h: Int, fmin: Int, fmax: Int, phys: Int, types: Int) -> [Int]
    [h & 0xFF,
        h >>> 8,
        fmin & 0xFF,
        fmin >>> 8,
        fmax & 0xFF,
        fmax >>> 8,
        phys,
        types & 0xFF,
        types >>> 8]

fn fs_req_pdu(fmin: Int, fmax: Int, phys: Int, types: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_fs.put_req(var p, fmin, fmax, phys, types)
    p

fn fs_rsp_pdu(fs: Int, phys: Int, types: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_fs.put_rsp(var p, fs, phys, types)
    p

fn fs_reject_pdu(code: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_data.ctrl_reject_ext(var p, ll_data.OP_FRAME_SPACE_REQ, code)
    p

// A Peripheral connection to the simulated Central, the peer's page 1 known to have bit 65.
fn fs_per_connect(var c: ctl_hci.Controller, var rf: ll_air.Rf, var air: SimAir)
    pcl_per_connect(var c, var rf, var air)
    t_peer_features(var c.links[0], 0, ll_link.FEAT0_EXT_REJECT)
    t_peer_features(var c.links[0], 7, ll_feat.OCTET7_EXT)
    ll_link.fx_put(var c.links[0], ll_link.FX_PEER, 0xFFFFFF, FS_P1)
    ll_link.fx_put(var c.links[0], ll_link.FX_HAVE, 1, 1)

// A Central connection to the simulated Peripheral, the peer's page 1 known to have bit 65.
fn fs_cen_connect(var c: ctl_hci.Controller, var rf: ll_air.Rf, var air: SimAir)
    pcl_cen_connect(var c, var rf, var air, 0)
    t_peer_features(var c.links[0], 0, ll_link.FEAT0_EXT_REJECT)
    t_peer_features(var c.links[0], 7, ll_feat.OCTET7_EXT)
    ll_link.fx_put(var c.links[0], ll_link.FX_PEER, 0xFFFFFF, FS_P1)
    ll_link.fx_put(var c.links[0], ll_link.FX_HAVE, 1, 1)

// A build without Frame Space Update: its command is unknown, its two PDUs are answered with LL_UNKNOWN_RSP, and bit 65 is clear.
@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_a_build_without_frame_space_update_answers_neither_command_nor_pdus()
    if ctl_limits.fs_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pcl_per_connect(var c, var rf, var air)
    test.assert_eq(cmd_status_of(var c, 0x209D, fs_params(c.links[0].handle, 100, 200, 1, 1)), 1)
    list.push(air.c_pdus, fs_req_pdu(100, 200, 1, 1))
    list.push(air.c_pdus, fs_rsp_pdu(150, 0, 0))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_UNKNOWN_RSP), 2)
    test.assert_eq(pcl_sent(var air, ll_data.OP_FRAME_SPACE_RSP), 0)
    test.assert_eq(list.len(fs_events(var air)), 0)
    test.assert_eq(ctl_limits.page1_bits() & 0x2, 0)

// Bit 65 is in the Controller's page 1 and the command is in Supported Commands (octet 48 bit 1).
@test
fn test_the_page_1_bit_and_the_supported_command_of_frame_space_update()
    if not ctl_limits.fs_on()
        return
    var c = fresh()
    send(var c, 0x2087, [])
    let _a = ctl_hci.ctl_step(var c)
    let r = drain(var c)
    test.assert_eq(r[8 + 8] & 0x02, 0x02)
    test.assert_eq(r[7], 1)
    send(var c, 0x1002, [])
    let _b = ctl_hci.ctl_step(var c)
    let s = drain(var c)
    test.assert_eq(s[7 + 48] & 0x02, 0x02)

// The ranges and errors of the command.
@test
fn test_the_frame_space_command_checks_its_values()
    if not ctl_limits.fs_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    fs_per_connect(var c, var rf, var air)
    let h = c.links[0].handle
    test.assert_eq(cmd_status(var c, 0x209D, fs_params(h + 1, 100, 200, 1, 1)), 0x02)
    test.assert_eq(cmd_status(var c, 0x209D, fs_params(h, 200, 100, 1, 1)), 0x12)
    test.assert_eq(cmd_status(var c, 0x209D, fs_params(h, 0, 0x2711, 1, 1)), 0x12)
    test.assert_eq(cmd_status(var c, 0x209D, fs_params(h, 100, 200, 0, 1)), 0x12)
    test.assert_eq(cmd_status(var c, 0x209D, fs_params(h, 100, 200, 1, 0)), 0x12)
    // A reserved bit of the PHYs or the spacing types, and LE Coded on a radio without it.
    test.assert_eq(cmd_status(var c, 0x209D, fs_params(h, 100, 200, 9, 1)), 0x11)
    test.assert_eq(cmd_status(var c, 0x209D, fs_params(h, 100, 200, 1, 0x20)), 0x11)
    ctl_hci.ctl_set_coded(var c, false)
    test.assert_eq(cmd_status(var c, 0x209D, fs_params(h, 100, 200, 4, 1)), 0x11)
    ctl_hci.ctl_set_coded(var c, true)
    // A peer known to lack the feature: no page 1 bit, and no feature 63.
    ll_link.fx_put(var c.links[0], ll_link.FX_PEER, 0xFFFFFF, 0x100)
    test.assert_eq(cmd_status(var c, 0x209D, fs_params(h, 100, 200, 1, 1)), 0x1A)
    ll_link.fx_put(var c.links[0], ll_link.FX_PEER, 0xFFFFFF, FS_P1)
    t_peer_features(var c.links[0], 7, 0)
    test.assert_eq(cmd_status(var c, 0x209D, fs_params(h, 100, 200, 1, 1)), 0x1A)
    t_peer_features(var c.links[0], 0, ll_link.FEAT0_EXT_REJECT)
    t_peer_features(var c.links[0], 7, ll_feat.OCTET7_EXT)
    // A request in progress.
    test.assert_eq(cmd_status(var c, 0x209D, fs_params(h, 100, 200, 1, 1)), 0)
    test.assert_eq(cmd_status(var c, 0x209D, fs_params(h, 100, 200, 1, 1)), 0x0C)

// The Host asks, the Controller sends LL_FRAME_SPACE_REQ with the range cut to the 150 microseconds it keeps, the peer answers that nothing
// changes, and the Host hears one LE Frame Space Update Complete with the Host as the initiator.
@test
fn test_the_host_asks_and_the_peer_answers_that_nothing_changes()
    if not ctl_limits.fs_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    fs_per_connect(var c, var rf, var air)
    let h = c.links[0].handle
    test.assert_eq(cmd_status(var c, 0x209D, fs_params(h, 100, 0x2710, 3, 0x1F)), 0)
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_FRAME_SPACE_REQ), 1)
    let b = pcl_last_body(var air, ll_data.OP_FRAME_SPACE_REQ)
    test.assert_eq(list.len(b), 10)
    test.assert_eq(b[3] | (b[4] << 8), 150)
    test.assert_eq(b[5] | (b[6] << 8), 150)
    test.assert_eq(b[7], 3)
    test.assert_eq(b[8] | (b[9] << 8), 0x1F)
    test.assert_eq(list.len(fs_events(var air)), 0)
    list.push(air.c_pdus, fs_rsp_pdu(150, 0, 0))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    let ev = fs_events(var air)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(list.len(ev[0]), 13)
    test.assert_eq(ev[0][4], 0)
    test.assert_eq(ev[0][5] | (ev[0][6] << 8), h)
    test.assert_eq(ev[0][7], 0)
    test.assert_eq(ev[0][8] | (ev[0][9] << 8), 150)
    test.assert_eq(ev[0][10], 0)
    test.assert_eq(ev[0][11] | (ev[0][12] << 8), 0)
    // The command is free again.
    test.assert_eq(cmd_status(var c, 0x209D, fs_params(h, 150, 150, 1, 1)), 0)
    test.assert(c.links[0].live)

// An answer that names PHYs and spacing types inside the request is reported as it came; the same on a Central.
@test
fn test_an_answer_that_names_a_phy_and_a_spacing_type_is_reported()
    if not ctl_limits.fs_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    fs_cen_connect(var c, var rf, var air)
    let h = c.links[0].handle
    test.assert_eq(cmd_status(var c, 0x209D, fs_params(h, 150, 150, 3, 0x0F)), 0)
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_FRAME_SPACE_REQ), 1)
    list.push(air.p_pdus, fs_rsp_pdu(150, 2, 0x08))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    let ev = fs_events(var air)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0)
    test.assert_eq(ev[0][8] | (ev[0][9] << 8), 150)
    test.assert_eq(ev[0][10], 2)
    test.assert_eq(ev[0][11] | (ev[0][12] << 8), 0x08)

// An answer with another value, or with a PHY or a spacing type the request did not name, is invalid; an answer before the request went out
// is none.
@test
fn test_an_invalid_answer_ends_the_request_with_invalid_ll_parameters()
    if not ctl_limits.fs_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    fs_per_connect(var c, var rf, var air)
    let h = c.links[0].handle
    test.assert_eq(cmd_status(var c, 0x209D, fs_params(h, 100, 200, 1, 1)), 0)
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    list.push(air.c_pdus, fs_rsp_pdu(100, 0, 0))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    var ev = fs_events(var air)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0x1E)
    test.assert_eq(cmd_status(var c, 0x209D, fs_params(h, 100, 200, 1, 1)), 0)
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    list.push(air.c_pdus, fs_rsp_pdu(150, 4, 1))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    ev = fs_events(var air)
    test.assert_eq(list.len(ev), 2)
    test.assert_eq(ev[1][4], 0x1E)
    // An answer with no request out is dropped.
    list.push(air.c_pdus, fs_rsp_pdu(150, 0, 0))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(list.len(fs_events(var air)), 2)
    test.assert(c.links[0].live)

// The peer refuses, or does not know the PDU: the Host hears the code, or Unsupported Remote Feature.
@test
fn test_a_refused_frame_space_request_is_reported_with_the_error_or_as_unsupported()
    if not ctl_limits.fs_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    fs_per_connect(var c, var rf, var air)
    let h = c.links[0].handle
    test.assert_eq(cmd_status(var c, 0x209D, fs_params(h, 100, 200, 1, 1)), 0)
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    list.push(air.c_pdus, fs_reject_pdu(0x20))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    var ev = fs_events(var air)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0x20)
    test.assert_eq(cmd_status(var c, 0x209D, fs_params(h, 100, 200, 1, 1)), 0)
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    var u = ll_pdu.pdu_new()
    ll_data.ctrl_unknown_rsp(var u, ll_data.OP_FRAME_SPACE_REQ)
    list.push(air.c_pdus, u)
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    ev = fs_events(var air)
    test.assert_eq(list.len(ev), 2)
    test.assert_eq(ev[1][4], 0x1A)
    // A refusal or an unknown answer with no request out is dropped.
    list.push(air.c_pdus, fs_reject_pdu(0x20))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(list.len(fs_events(var air)), 2)
    test.assert(c.links[0].live)

// A range above the 150 microseconds this Controller keeps ends at once with Unsupported Feature or Parameter Value, and nothing is sent.
@test
fn test_a_range_above_150_microseconds_ends_without_a_request()
    if not ctl_limits.fs_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    fs_per_connect(var c, var rf, var air)
    let h = c.links[0].handle
    send(var c, 0x209D, fs_params(h, 151, 300, 1, 1))
    let _a = ctl_hci.ctl_step(var c)
    let r = drain(var c)
    let ev = meta_events(r, 0x35)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0x11)
    test.assert_eq(ev[0][8] | (ev[0][9] << 8), 150)
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_FRAME_SPACE_REQ), 0)
    // The command is free again.
    test.assert_eq(cmd_status(var c, 0x209D, fs_params(h, 100, 200, 1, 1)), 0)

// The Controller answers the peer's request in either role: with FS 150 and no PHY and no spacing type when 150 lies in the range, otherwise
// with LL_REJECT_EXT_IND and the code; the Host is told nothing, since nothing changes.
@test
fn test_the_controller_answers_the_peers_request()
    if not ctl_limits.fs_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    fs_per_connect(var c, var rf, var air)
    list.push(air.c_pdus, fs_req_pdu(100, 200, 7, 0x1F))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_FRAME_SPACE_RSP), 1)
    let b = pcl_last_body(var air, ll_data.OP_FRAME_SPACE_RSP)
    test.assert_eq(list.len(b), 8)
    test.assert_eq(b[3] | (b[4] << 8), 150)
    test.assert_eq(b[5], 0)
    test.assert_eq(b[6] | (b[7] << 8), 0)
    // 150 microseconds outside the range: 0x11.
    list.push(air.c_pdus, fs_req_pdu(160, 300, 1, 1))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_REJECT_EXT_IND), 1)
    test.assert_eq(pcl_last_body(var air, ll_data.OP_REJECT_EXT_IND)[4], 0x11)
    list.push(air.c_pdus, fs_req_pdu(0, 149, 1, 1))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_last_body(var air, ll_data.OP_REJECT_EXT_IND)[4], 0x11)
    // A range the wrong way round, one above 10 ms and one without a PHY or a spacing type: 0x1E.
    for v in [[200, 100, 1, 1], [0, 10001, 1, 1], [100, 200, 0, 1], [100, 200, 1, 0]]
        let n = pcl_sent(var air, ll_data.OP_REJECT_EXT_IND)
        list.push(air.c_pdus, fs_req_pdu(v[0], v[1], v[2], v[3]))
        cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
        test.assert_eq(pcl_sent(var air, ll_data.OP_REJECT_EXT_IND), n + 1)
        test.assert_eq(pcl_last_body(var air, ll_data.OP_REJECT_EXT_IND)[4], 0x1E)
    test.assert_eq(pcl_sent(var air, ll_data.OP_FRAME_SPACE_RSP), 1)
    test.assert_eq(list.len(fs_events(var air)), 0)
    test.assert(c.links[0].live)
    // The Central answers in the same way.
    var m = fresh()
    var rf2 = ll_air.rf_new()
    var air2 = sim_new()
    fs_cen_connect(var m, var rf2, var air2)
    list.push(air2.p_pdus, fs_req_pdu(150, 150, 1, 4))
    cis_run(var m, var rf2, var air2, air2.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air2, ll_data.OP_FRAME_SPACE_RSP), 1)

// Two requests that cross: the Central refuses the Peripheral's with LL Procedure Collision and goes on with its own; the Peripheral answers the
// Central's and takes the rejection of its own.
@test
fn test_requests_that_cross_end_with_the_central_s_request()
    if not ctl_limits.fs_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    fs_cen_connect(var c, var rf, var air)
    let h = c.links[0].handle
    test.assert_eq(cmd_status(var c, 0x209D, fs_params(h, 100, 200, 1, 1)), 0)
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    list.push(air.p_pdus, fs_req_pdu(100, 200, 1, 1))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_REJECT_EXT_IND), 1)
    test.assert_eq(pcl_last_body(var air, ll_data.OP_REJECT_EXT_IND)[4], 0x23)
    test.assert_eq(pcl_sent(var air, ll_data.OP_FRAME_SPACE_RSP), 0)
    list.push(air.p_pdus, fs_rsp_pdu(150, 0, 0))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(list.len(fs_events(var air)), 1)
    var p = fresh()
    var rf2 = ll_air.rf_new()
    var air2 = sim_new()
    fs_per_connect(var p, var rf2, var air2)
    test.assert_eq(cmd_status(var p, 0x209D, fs_params(p.links[0].handle, 100, 200, 1, 1)), 0)
    cis_run(var p, var rf2, var air2, air2.now + 300000, 0, 0)
    list.push(air2.c_pdus, fs_req_pdu(100, 200, 1, 1))
    cis_run(var p, var rf2, var air2, air2.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air2, ll_data.OP_FRAME_SPACE_RSP), 1)
    list.push(air2.c_pdus, fs_reject_pdu(0x23))
    cis_run(var p, var rf2, var air2, air2.now + 300000, 0, 0)
    let ev = fs_events(var air2)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0x23)

// A request the peer leaves unanswered is given up with Command Timeout, status 0x22, and one on a connection that ended is dropped.
@test
fn test_an_unanswered_request_times_out_and_a_closed_link_drops_it()
    if not ctl_limits.fs_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    fs_per_connect(var c, var rf, var air)
    let h = c.links[0].handle
    test.assert_eq(cmd_status(var c, 0x209D, fs_params(h, 100, 200, 1, 1)), 0)
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    ctl_hci.ctl_set_time(var c, c.now + ll_sub.WAIT_US + 1)
    test.assert(ctl_hci.ctl_fs_poll(var c))
    let r = drain(var c)
    let ev = meta_events(r, 0x35)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0x22)
    test.assert(not ctl_hci.ctl_fs_poll(var c))
    // The connection ends while a request is out.
    test.assert_eq(cmd_status(var c, 0x209D, fs_params(h, 100, 200, 1, 1)), 0)
    c.links[0].closing = true
    test.assert(ctl_hci.ctl_fs_poll(var c))
    test.assert(not c.sub_def[0].wait)
    test.assert_eq(list.len(meta_events(drain(var c), 0x35)), 0)

// ── Path loss monitoring (build with `ctl_ploss` in the profile) ────────────────

// The parameters of LE Set Path Loss Reporting Parameters for the connection `h`.
fn pl_params(h: Int, ht: Int, hh: Int, lt: Int, lh: Int, mt: Int) -> [Int]
    [h & 0xFF, h >>> 8, ht, hh, lt, lh, mt & 0xFF, mt >>> 8]

// The LE Path Loss Threshold events (subevent 0x20) the Host has read, each [4, 0x3E, 6, 0x20, handle (2), path loss, zone].
fn pl_events(var air: SimAir) -> [[Int]]
    meta_events(air.host, 0x20)

// A command whose octets the Host reads in full: the events it caused stay with the Host's bytes of the air, and the result is the Status of the Command Complete.
fn pl_cmd(var c: ctl_hci.Controller, var air: SimAir, opcode: Int, params: [Int]) -> Int
    send(var c, opcode, params)
    let _ran = ctl_hci.ctl_step(var c)
    let r = drain(var c)
    for b in r
        list.push(air.host, b)
    test.assert(list.len(r) >= 7)
    r[6]

// A Central connection to a simulated peer that has LE Power Control (it answers when the test pushes the answer), with the parameters High 90 +- 4,
// Low 60 +- 6 and `mt` events, and reporting on.  The signal strength is -60 dBm.
fn pl_connect(var c: ctl_hci.Controller, var rf: ll_air.Rf, var air: SimAir, mt: Int)
    pcl_cen_connect(var c, var rf, var air, 0)
    let h = c.links[0].handle
    test.assert_eq(pl_cmd(var c, var air, 0x2078, pl_params(h, 90, 4, 60, 6, mt)), 0)
    test.assert_eq(pl_cmd(var c, var air, 0x2079, [h & 0xFF, h >>> 8, 1]), 0)

// A stretch of connection events in which the Controller asks the peer for its level, and the peer's LL_POWER_CONTROL_RSP for it.
fn pl_answer(var c: ctl_hci.Controller, var rf: ll_air.Rf, var air: SimAir, level: Int)
    cis_run(var c, var rf, var air, air.now + 200000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_POWER_CONTROL_REQ), 1)
    list.push(air.p_pdus, pcl_rsp(0x00, 0, level))

// The Controller asks the peer for its level once reporting is on, and the first report is the zone of the first path loss: 0 dBm less -60 dBm is 60 dB, the Low threshold,
// which is the Middle zone.  A path loss that rises past the High boundary (the strength falls to -110 dBm: 110 dB) is reported as High after the minimum time, and one that
// falls back below it as Middle; two reports in a row never name the same zone.
@test
fn test_the_path_loss_moves_between_the_zones_with_the_signal_strength()
    if not ctl_limits.ploss_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pl_connect(var c, var rf, var air, 3)
    test.assert_eq(list.len(pl_events(var air)), 0)
    pl_answer(var c, var rf, var air, 0)
    cis_run(var c, var rf, var air, air.now + 200000, 0, 0)
    var ev = pl_events(var air)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], c.links[0].handle)
    test.assert_eq(ev[0][6], 60)
    test.assert_eq(ev[0][7], 1)
    // No event while the path loss stays in the zone.
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(list.len(pl_events(var air)), 1)
    air.rssi = -110
    cis_run(var c, var rf, var air, air.now + 900000, 0, 0)
    ev = pl_events(var air)
    test.assert_eq(list.len(ev), 2)
    test.assert(ev[1][6] >= 94)
    test.assert_eq(ev[1][7], 2)
    air.rssi = -70
    cis_run(var c, var rf, var air, air.now + 900000, 0, 0)
    ev = pl_events(var air)
    test.assert_eq(list.len(ev), 3)
    test.assert(ev[2][6] <= 86)
    test.assert_eq(ev[2][7], 1)
    // Down through the Low boundary (54 dB or less): the strength of 0 dBm.
    air.rssi = 0
    cis_run(var c, var rf, var air, air.now + 900000, 0, 0)
    ev = pl_events(var air)
    test.assert_eq(list.len(ev), 4)
    test.assert(ev[3][6] <= 54)
    test.assert_eq(ev[3][7], 0)

// The peer's own level moves with LL_POWER_CHANGE_IND: the path loss follows it.
@test
fn test_a_power_change_indication_of_the_peer_moves_the_path_loss()
    if not ctl_limits.ploss_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pl_connect(var c, var rf, var air, 2)
    pl_answer(var c, var rf, var air, 0)
    cis_run(var c, var rf, var air, air.now + 200000, 0, 0)
    test.assert_eq(list.len(pl_events(var air)), 1)
    // The peer raises its level by 40 dB: 100 dB of path loss.
    var p = ll_pdu.pdu_new()
    ll_pcl.put_ind(var p, ll_pcl.MASK_1M, 0, 40, 40)
    list.push(air.p_pdus, p)
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    let ev = pl_events(var air)
    test.assert_eq(list.len(ev), 2)
    test.assert_eq(ev[1][6], 100)
    test.assert_eq(ev[1][7], 2)

// A crossing that does not last Min_Time_Spent events is not reported.
@test
fn test_a_crossing_shorter_than_the_minimum_time_is_not_reported()
    if not ctl_limits.ploss_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pl_connect(var c, var rf, var air, 400)
    pl_answer(var c, var rf, var air, 0)
    cis_run(var c, var rf, var air, air.now + 200000, 0, 0)
    test.assert_eq(list.len(pl_events(var air)), 1)
    air.rssi = -110
    cis_run(var c, var rf, var air, air.now + 600000, 0, 0)
    air.rssi = -60
    cis_run(var c, var rf, var air, air.now + 600000, 0, 0)
    test.assert_eq(list.len(pl_events(var air)), 1)

// A peer that refuses the question: the Host hears 0xFF, and the first measurement after the peer tells its level is reported as a first one.
@test
fn test_a_peer_that_cannot_give_its_level_is_reported_as_unavailable()
    if not ctl_limits.ploss_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pl_connect(var c, var rf, var air, 3)
    cis_run(var c, var rf, var air, air.now + 200000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_POWER_CONTROL_REQ), 1)
    var j = ll_pdu.pdu_new()
    ll_data.ctrl_reject_ext(var j, 0x23, 0x20)
    list.push(air.p_pdus, j)
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    var ev = pl_events(var air)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][6], 0xFF)
    // Nothing more is asked or reported while the level stays unknown.
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(list.len(pl_events(var air)), 1)
    test.assert_eq(pcl_sent(var air, ll_data.OP_POWER_CONTROL_REQ), 1)
    // The peer tells its level on its own: the path loss is reported as a first one.
    var p = ll_pdu.pdu_new()
    ll_pcl.put_ind(var p, ll_pcl.MASK_1M, 0, 0, 0)
    list.push(air.p_pdus, p)
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    ev = pl_events(var air)
    test.assert_eq(list.len(ev), 2)
    test.assert_eq(ev[1][6], 60)
    test.assert_eq(ev[1][7], 1)

// A peer whose features are known and lack LE Power Control is not asked.
@test
fn test_a_peer_without_power_control_is_not_asked_for_its_level()
    if not ctl_limits.ploss_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pcl_cen_connect(var c, var rf, var air, 0)
    let h = c.links[0].handle
    test.assert_eq(cmd_status(var c, 0x2016, [h & 0xFF, h >>> 8]), 0)
    cis_run(var c, var rf, var air, air.now + 200000, 0, 0)
    test.assert_eq(pl_cmd(var c, var air, 0x2078, pl_params(h, 90, 4, 60, 6, 3)), 0)
    test.assert_eq(pl_cmd(var c, var air, 0x2079, [h & 0xFF, h >>> 8, 1]), 0)
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    let ev = pl_events(var air)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][6], 0xFF)
    test.assert_eq(pcl_sent(var air, ll_data.OP_POWER_CONTROL_REQ), 0)

// New parameters that put the path loss in another zone are reported at once, whatever the minimum time; reporting off stops the events and on again starts with a first report.
@test
fn test_new_parameters_and_the_switch_are_followed_at_once()
    if not ctl_limits.ploss_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pl_connect(var c, var rf, var air, 400)
    pl_answer(var c, var rf, var air, 0)
    cis_run(var c, var rf, var air, air.now + 200000, 0, 0)
    test.assert_eq(list.len(pl_events(var air)), 1)
    let h = c.links[0].handle
    // 60 dB is below a Low boundary of 70 + 5: the Low zone.
    test.assert_eq(pl_cmd(var c, var air, 0x2078, pl_params(h, 0xFF, 0, 70, 5, 400)), 0)
    test.assert_eq(list.len(pl_events(var air)), 2)
    test.assert_eq(pl_events(var air)[1][7], 0)
    test.assert_eq(pl_cmd(var c, var air, 0x2079, [h & 0xFF, h >>> 8, 0]), 0)
    air.rssi = -120
    cis_run(var c, var rf, var air, air.now + 400000, 0, 0)
    test.assert_eq(list.len(pl_events(var air)), 2)
    // On again, twice: the level is known, so the first report follows the next sample and is the zone of the path loss now.
    test.assert_eq(pl_cmd(var c, var air, 0x2079, [h & 0xFF, h >>> 8, 1]), 0)
    test.assert_eq(pl_cmd(var c, var air, 0x2079, [h & 0xFF, h >>> 8, 1]), 0)
    cis_run(var c, var rf, var air, air.now + 200000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_POWER_CONTROL_REQ), 1)
    test.assert_eq(list.len(pl_events(var air)), 3)
    test.assert_eq(pl_events(var air)[2][7], 1)

// The commands' errors, Supported Commands (octet 44 bits 5 and 6) and feature 35 (octet 4 bit 3 of the LE features).
@test
fn test_the_path_loss_commands_check_their_parameters_and_the_build_says_it_has_them()
    var c = fresh()
    var on = 0
    if ctl_limits.ploss_on()
        on = 1
    let r = complete_of_ctl(var c, 0x1002, [])
    test.assert_eq((r[7 + 44] >>> 5) & 3, 3 * on)
    let f = complete_of_ctl(var c, 0x2003, [])
    test.assert_eq((f[7 + 4] >>> 3) & 1, on)
    test.assert_eq((ctl_limits.features_octet4() >>> 3) & 1, on)
    if on == 0
        test.assert_eq(status_of(var c, 0x2078, pl_params(1, 90, 4, 60, 6, 3)), 1)
        test.assert_eq(status_of(var c, 0x2079, [1, 0, 1]), 1)
        return
    var rf = ll_air.rf_new()
    var air = sim_new()
    pcl_cen_connect(var c, var rf, var air, 0)
    let h = c.links[0].handle
    test.assert_eq(status_of(var c, 0x2078, pl_params(0x99, 90, 4, 60, 6, 3)), 0x02)
    test.assert_eq(status_of(var c, 0x2079, [0x99, 0, 1]), 0x02)
    // The switch needs the parameters first.
    test.assert_eq(status_of(var c, 0x2079, [h & 0xFF, h >>> 8, 1]), 0x0C)
    test.assert_eq(status_of(var c, 0x2079, [h & 0xFF, h >>> 8, 0]), 0x0C)
    // High + hysteresis above 255, Low below its hysteresis, Low above High, the zones overlapping.
    test.assert_eq(status_of(var c, 0x2078, pl_params(h, 0xFF, 1, 60, 6, 3)), 0x12)
    test.assert_eq(status_of(var c, 0x2078, pl_params(h, 90, 4, 5, 6, 3)), 0x12)
    test.assert_eq(status_of(var c, 0x2078, pl_params(h, 50, 0, 60, 0, 3)), 0x12)
    test.assert_eq(status_of(var c, 0x2078, pl_params(h, 70, 5, 60, 6, 3)), 0x12)
    test.assert_eq(status_of(var c, 0x2078, pl_params(h, 90, 4, 60, 6, 3)), 0)
    test.assert_eq(status_of(var c, 0x2078, pl_params(h, 0xFF, 0, 60, 6, 0)), 0)
    test.assert_eq(status_of(var c, 0x2079, [h & 0xFF, h >>> 8, 2]), 0x12)
    test.assert_eq(status_of(var c, 0x2079, [h & 0xFF, h >>> 8, 1]), 0)
    test.assert_eq(status_of(var c, 0x2079, [h & 0xFF, h >>> 8, 1]), 0)
    test.assert_eq(status_of(var c, 0x2079, [h & 0xFF, h >>> 8, 0]), 0)
    test.assert_eq(status_of(var c, 0x2079, [h & 0xFF, h >>> 8, 0]), 0)
    // Too few octets.
    test.assert_eq(status_of(var c, 0x2078, [h & 0xFF, h >>> 8, 90]), 0x12)

// ── LE Request Peer SCA (build with `ctl_peersca` in the profile) ───────────────

// The LL Control PDUs LL_CLOCK_ACCURACY_RSP, LL_UNKNOWN_RSP and LL_REJECT_EXT_IND the simulated peer sends in answer.
fn sca_rsp(class: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_data.ctrl_begin(var p, ll_data.OP_CLOCK_ACCURACY_RSP)
    let _a = ll_pdu.pdu_put(var p, class)
    ll_data.dpdu_finish(var p)
    p

fn sca_unknown() -> Pdu
    var p = ll_pdu.pdu_new()
    ll_data.ctrl_unknown_rsp(var p, ll_data.OP_CLOCK_ACCURACY_REQ)
    p

fn sca_reject(code: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_data.ctrl_reject_ext(var p, ll_data.OP_CLOCK_ACCURACY_REQ, code)
    p

// The LE Request Peer SCA Complete events (subevent 0x1F) the Host has read, each [4, 0x3E, 5, 0x1F, status, handle (2), class].
fn sca_events(var air: SimAir) -> [[Int]]
    meta_events(air.host, 0x1F)

// The Central asks, the Peripheral of the air answers with its class: the Host hears it, with the handle, and the class is the one the
// window widening reads.  A second request is accepted once the first has ended.
@test
fn test_a_central_asks_the_peer_for_its_clock_accuracy()
    if not ctl_limits.sca_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pcl_cen_connect(var c, var rf, var air, 0)
    let h = c.links[0].handle
    test.assert_eq(cmd_status(var c, 0x206D, [h & 0xFF, h >>> 8]), 0)
    cis_run(var c, var rf, var air, air.now + 200000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_CLOCK_ACCURACY_REQ), 1)
    test.assert_eq(list.len(sca_events(var air)), 0)
    list.push(air.p_pdus, sca_rsp(3))
    cis_run(var c, var rf, var air, air.now + 200000, 0, 0)
    var ev = sca_events(var air)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0)
    test.assert_eq(ev[0][5] | (ev[0][6] << 8), h)
    test.assert_eq(ev[0][7], 3)
    test.assert_eq(c.links[0].sca, 3)
    test.assert_eq(cmd_status(var c, 0x206D, [h & 0xFF, h >>> 8]), 0)
    cis_run(var c, var rf, var air, air.now + 200000, 0, 0)
    list.push(air.p_pdus, sca_rsp(6))
    cis_run(var c, var rf, var air, air.now + 200000, 0, 0)
    ev = sca_events(var air)
    test.assert_eq(list.len(ev), 2)
    test.assert_eq(ev[1][7], 6)

// The Peripheral asks the Central of the air.
@test
fn test_a_peripheral_asks_the_peer_for_its_clock_accuracy()
    if not ctl_limits.sca_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pcl_per_connect(var c, var rf, var air)
    let h = c.links[0].handle
    test.assert_eq(cmd_status(var c, 0x206D, [h & 0xFF, h >>> 8]), 0)
    list.push(air.c_pdus, sca_rsp(1))
    cis_run(var c, var rf, var air, air.now + 300000, 0, 0)
    test.assert_eq(pcl_sent(var air, ll_data.OP_CLOCK_ACCURACY_REQ), 1)
    let ev = sca_events(var air)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0)
    test.assert_eq(ev[0][7], 1)

// A peer that answers LL_UNKNOWN_RSP ends the command with Unsupported Feature or Parameter Value, and one that sends LL_REJECT_EXT_IND with its code; neither
// leaves a class in the event.
@test
fn test_a_peer_that_refuses_the_request_is_reported_with_the_error()
    if not ctl_limits.sca_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pcl_cen_connect(var c, var rf, var air, 0)
    let h = c.links[0].handle
    test.assert_eq(cmd_status(var c, 0x206D, [h & 0xFF, h >>> 8]), 0)
    cis_run(var c, var rf, var air, air.now + 200000, 0, 0)
    list.push(air.p_pdus, sca_unknown())
    cis_run(var c, var rf, var air, air.now + 200000, 0, 0)
    var ev = sca_events(var air)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0x11)
    test.assert_eq(ev[0][7], 0)
    test.assert_eq(cmd_status(var c, 0x206D, [h & 0xFF, h >>> 8]), 0)
    cis_run(var c, var rf, var air, air.now + 200000, 0, 0)
    list.push(air.p_pdus, sca_reject(0x20))
    cis_run(var c, var rf, var air, air.now + 200000, 0, 0)
    ev = sca_events(var air)
    test.assert_eq(list.len(ev), 2)
    test.assert_eq(ev[1][4], 0x20)

// The command's errors: an unknown handle, a second request while one waits, and a peer whose features are known to lack the feature.
@test
fn test_the_request_for_the_peers_clock_accuracy_checks_the_connection_and_the_peer()
    if not ctl_limits.sca_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    air.peer_f3 = 0x33
    pcl_cen_connect(var c, var rf, var air, 0)
    let h = c.links[0].handle
    test.assert_eq(cmd_status(var c, 0x206D, [0x99, 0]), 0x02)
    test.assert_eq(cmd_status(var c, 0x206D, [h & 0xFF, h >>> 8]), 0)
    test.assert_eq(cmd_status(var c, 0x206D, [h & 0xFF, h >>> 8]), 0x0C)
    cis_run(var c, var rf, var air, air.now + 200000, 0, 0)
    list.push(air.p_pdus, sca_rsp(2))
    cis_run(var c, var rf, var air, air.now + 200000, 0, 0)
    test.assert_eq(list.len(sca_events(var air)), 1)
    // The peer's features are read: bit 26 is clear.
    test.assert_eq(cmd_status(var c, 0x2016, [h & 0xFF, h >>> 8]), 0)
    cis_run(var c, var rf, var air, air.now + 200000, 0, 0)
    test.assert_eq(cmd_status(var c, 0x206D, [h & 0xFF, h >>> 8]), 0x1A)
    test.assert_eq(pcl_sent(var air, ll_data.OP_CLOCK_ACCURACY_REQ), 1)

// A peer that does not answer in 40 s ends the connection with Connection Terminated Due to Response Timeout, as any Link Layer procedure does.
@test
fn test_a_peer_that_does_not_answer_the_request_ends_the_connection()
    if not ctl_limits.sca_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pcl_cen_connect(var c, var rf, var air, 0)
    let h = c.links[0].handle
    test.assert_eq(cmd_status(var c, 0x206D, [h & 0xFF, h >>> 8]), 0)
    cis_run(var c, var rf, var air, air.now + 41000000, 0, 0)
    test.assert(not c.links[0].live)
    test.assert_eq(list.len(sca_events(var air)), 0)

// The command and its Supported Commands bit (octet 43 bit 2) follow the build.
@test
fn test_the_build_says_whether_it_has_the_request_for_the_peers_clock_accuracy()
    var c = fresh()
    var on = 0
    if ctl_limits.sca_on()
        on = 1
    let r = complete_of_ctl(var c, 0x1002, [])
    test.assert_eq((r[7 + 43] >>> 2) & 1, on)
    if on == 0
        test.assert_eq(status_of(var c, 0x206D, [1, 0]), 1)

@test
fn test_stop_rx_with_the_receiver_off_halts_nothing()
    // The receiver of a scan window is the only one `stop_rx` halts; `rf_new` has none, and a Rf cannot be written from a test.
    var rf = ll_air.rf_new()
    var air = sim_new()
    air.state = LISTEN
    ll_air.stop_rx(var air, var rf)
    test.assert_eq(air.state, LISTEN)
    test.assert_eq(rf.rx_on, false)
