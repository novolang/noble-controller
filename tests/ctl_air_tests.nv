@test
fn test_extended_scan_closes_a_chain_whose_next_pdu_does_not_come_with_truncated_data()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    xscan_on(var c, 0, 0)
    hear(var air, 2000, 37, xp(0, -1, 7, 2, 12, 100, 0, -200, []))
    hear(var air, 5000, 12, xp(0, 0x30, 7, 2, 13, 200, 0, -200, count_from(0, 30)))
    run(var c, var rf, var air, 40000)
    let ev = xreports(air.host)
    test.assert_eq(list.len(ev), 2)
    test.assert_eq(x_et(ev[0]) & 0x60, 0x20)
    test.assert_eq(x_et(ev[1]) & 0x60, 0x40)
    test.assert_eq(x_len(ev[1]), 0)
    test.assert_eq(c.scan.x_missed, 1)
    test.assert_eq(c.scan.x_truncated, 1)
