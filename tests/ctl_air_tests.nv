@test
fn test_a_receiver_that_hears_nothing_fails_after_six_events_and_one_that_stops_hearing_times_out()
    if not ctl_limits.big_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    big_source(var c, var rf, var air, 1, 0, 0, 800000, 10, 0)
    let v = big_info_view(var air, big_info_pdu(var air))
    let aa = ll_big.bis_aa(v.saa, 1)
    // No BIS packet is replayed: the train alone.
    var d = fresh()
    var rf2 = ll_air.rf_new()
    var air2 = sim_new()
    big_replay(var air, var air2, [aa], 0, 100000000, -1)
    big_sink(var d, var rf2, var air2, [1], 0, 0, 0x64, 600000)
