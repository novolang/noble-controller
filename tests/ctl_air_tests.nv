// ── Periodic advertising and periodic advertising synchronization ──
//
// The train of an advertising set is announced by the SyncInfo in the AUX_ADV_IND of the set and sent from then on at its own interval:
// the AUX_SYNC_IND and the AUX_CHAIN_IND PDUs behind it carry the access address the SyncInfo gives, on the channels of channel
// selection algorithm #2.  A synchronization is scripted the other way round: a peer's AUX_ADV_IND carries the SyncInfo, and its
// AUX_SYNC_IND PDUs come at the times the SyncInfo and the interval give.

// LE Set Periodic Advertising Parameters and Data for the set `handle`.
fn pa_params(handle: Int, lo: Int, hi: Int, props: Int) -> [Int]
    [handle, lo & 0xFF, lo >>> 8, hi & 0xFF, hi >>> 8, props & 0xFF, props >>> 8]

fn pa_data(handle: Int, op: Int, data: [Int]) -> [Int]
    var p: [Int] = [handle, op, list.len(data)]
    for d in data
        list.push(p, d)
    p

// The set 1 (SID 5, 3 octets of advertising data) with a train of the interval `iv` (units of 1.25 ms) and `data`, enabled.
fn pa_train(var c: ctl_hci.Controller, iv: Int, props: Int, data: [Int])
    xa_set(var c, 1, 0, 0, 5, 0, [2, 1, 6])
    test.assert_eq(status_of(var c, 0x203E, pa_params(1, iv, iv, props)), 0)
    test.assert_eq(status_of(var c, 0x203F, pa_data(1, 3, data)), 0)
    test.assert_eq(status_of(var c, 0x2040, [1, 1]), 0)

// The indexes of the PDUs of type 7 the Controller sent that carry a SyncInfo (the AUX_ADV_IND of a set that announces a train).
fn pa_announces(var air: SimAir) -> [Int]
    var out: [Int] = []
    for i in tx_of(var air, 7)
        var p = tx_pdu(air, i)
        let x = ll_ext.ext_parse(var p)
        if x.ok and x.sync >= 0
            list.push(out, i)
    out

// The indexes of the PDUs sent with the access address `aa`.
fn pa_sent_with(var air: SimAir, aa: Int) -> [Int]
    var out: [Int] = []
    for i in 0..list.len(air.tx_t)
        if air.tx_aa[i] == aa
            list.push(out, i)
    out

@when(noble_controller.CONFIG.CTL_PER_ADV > 0 and noble_controller.CONFIG.CTL_ADV_SETS > 0)
@test
fn test_a_train_is_announced_in_the_syncinfo_and_its_events_follow_the_interval_and_the_channels()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pa_train(var c, 32, 0, count_from(1, 20))
    test.assert_eq(status_of(var c, 0x2039, xa_enable(1, 1, 0, 0)), 0)
    run(var c, var rf, var air, 300000)
    let an = pa_announces(var air)
    test.assert(list.len(an) >= 3)
    var aux = tx_pdu(air, an[0])
    let xa = ll_ext.ext_parse(var aux)
    test.assert(xa.ok)
    test.assert_eq(ll_ext.adi_sid(var aux, xa.adi), 5)
    test.assert_eq(xa.data_len, 3)
    test.assert_eq(xa.aux, -1)
    let at = xa.sync
    let aa = ll_per.si_aa(var aux, at)
    test.assert(ll_init.aa_valid(aa))
    test.assert_eq(ll_per.si_interval(var aux, at), 32)
    test.assert_eq(ll_per.si_chmap(var aux, at), 0x1FFFFFFFFF)
    test.assert_eq(ll_per.si_sca(var aux, at), 5)
    let sy = pa_sent_with(var air, aa)
    test.assert(list.len(sy) >= 5)
    // The AUX_SYNC_IND PDUs carry the data, no address, no ADI and no SyncInfo, and the radio is back on the advertising channels' address.
    var p0 = tx_pdu(air, sy[0])
    let x0 = ll_ext.ext_parse(var p0)
    test.assert(x0.ok)
    test.assert_eq(x0.mode, 0)
    test.assert_eq(x0.adva, -1)
    test.assert_eq(x0.adi, -1)
    test.assert_eq(x0.sync, -1)
    test.assert_eq(x0.aux, -1)
    test.assert_eq(x0.data_len, 20)
    test.assert_eq(p0.b[x0.data_at + 19] as Int, 20)
    test.assert_eq(air.cfg_aa, ll_radio.ADV_ACCESS_ADDRESS)
    // Every announcement names an event: the first bit of the AUX_SYNC_IND is in the unit after the offset, and the counter is the one of its place.
    var first_counter = 0
    for j in 0..3
        var a = tx_pdu(air, an[j])
        let xj = ll_ext.ext_parse(var a)
        let off = ll_per.si_offset_us(var a, xj.sync)
        let ctr = ll_per.si_counter(var a, xj.sync)
        var found = -1
        for m in 0..list.len(sy)
            let d = air.tx_t[sy[m]] - (air.tx_t[an[j]] + off)
            if d >= 0 and d < 30
                found = m
        test.assert(found >= 0)
        if j == 0
            first_counter = ctr - found
        test.assert_eq(ctr, (first_counter + found) & 0xFFFF)
        test.assert_eq(ll_per.si_aa(var a, xj.sync), aa)
    // The events are an interval (40 ms) apart and sit on the channels of the counter.
    for k in 0..5
        test.assert_eq(air.tx_ch[sy[k]],
            ll_link.csa2_channel(ll_per.channel_id(aa), (first_counter + k) & 0xFFFF, 0x1FFFFFFFFF, 37))
        if k > 0
            test.assert_eq(air.tx_t[sy[k]] - air.tx_t[sy[k - 1]], 40000)
    test.assert_eq(rf.ramp_timeouts, 0)
    test.assert_eq(rf.x_adv_err_min_us, 0)
    test.assert_eq(rf.x_adv_err_max_us, 0)
    test.assert_eq(air.holds, air.releases)

@when(noble_controller.CONFIG.CTL_PER_ADV > 0 and noble_controller.CONFIG.CTL_ADV_SETS > 0)
@test
fn test_the_train_goes_on_when_the_set_is_disabled_and_stops_when_it_is_disabled()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pa_train(var c, 16, 0, count_from(1, 5))
    test.assert_eq(status_of(var c, 0x2039, xa_enable(1, 1, 0, 0)), 0)
    run(var c, var rf, var air, 100000)
    let an_first = pa_announces(var air)
    var a_first = tx_pdu(air, an_first[0])
    let aa = ll_per.si_aa(var a_first, ll_ext.ext_parse(var a_first).sync)
    let n0 = list.len(pa_sent_with(var air, aa))
    test.assert(n0 >= 3)
    // The set is disabled: no announcement follows, the events do.
    test.assert_eq(status_of(var c, 0x2039, xa_enable(0, 1, 0, 0)), 0)
    let an0 = list.len(pa_announces(var air))
    run(var c, var rf, var air, 300000)
    test.assert_eq(list.len(pa_announces(var air)), an0)
    let n1 = list.len(pa_sent_with(var air, aa))
    test.assert(n1 >= n0 + 8)
    // The train is disabled: it falls silent.
    test.assert_eq(status_of(var c, 0x2040, [0, 1]), 0)
    run(var c, var rf, var air, 400000)
    test.assert(list.len(pa_sent_with(var air, aa)) <= n1 + 1)
    // Enabled again with the set on, it starts anew with another access address.
    test.assert_eq(status_of(var c, 0x2040, [1, 1]), 0)
    test.assert_eq(status_of(var c, 0x2039, xa_enable(1, 1, 0, 0)), 0)
    run(var c, var rf, var air, 600000)
    let an1 = pa_announces(var air)
    var last = tx_pdu(air, an1[list.len(an1) - 1])
    let aa2 = ll_per.si_aa(var last, ll_ext.ext_parse(var last).sync)
    test.assert(aa2 != aa)
    test.assert(list.len(pa_sent_with(var air, aa2)) >= 3)

@when(noble_controller.CONFIG.CTL_PER_ADV > 0 and noble_controller.CONFIG.CTL_ADV_SETS > 0)
@test
fn test_a_train_of_251_octets_goes_in_an_aux_sync_ind_and_a_chain_pdu_where_the_pointer_says()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pa_train(var c, 64, 0x40, count_from(0, 251))
    test.assert_eq(status_of(var c, 0x2039, xa_enable(1, 1, 0, 0)), 0)
    run(var c, var rf, var air, 200000)
    var a = tx_pdu(air, pa_announces(var air)[0])
    let aa = ll_per.si_aa(var a, ll_ext.ext_parse(var a).sync)
    let sy = pa_sent_with(var air, aa)
    test.assert(list.len(sy) >= 4)
    // The AUX_SYNC_IND: the Tx Power, 229 octets of data and the pointer; the chain PDU: the last 22 octets, on the channel and at the time of the pointer, the same access address.
    var s0 = tx_pdu(air, sy[0])
    let x0 = ll_ext.ext_parse(var s0)
    test.assert(x0.ok)
    test.assert(x0.txp >= 0)
    test.assert_eq(x0.data_len, 229)
    test.assert(x0.aux >= 0)
    var s1 = tx_pdu(air, sy[1])
    let x1 = ll_ext.ext_parse(var s1)
    test.assert(x1.ok)
    test.assert_eq(x1.data_len, 22)
    test.assert_eq(x1.aux, -1)
    test.assert_eq(x1.txp, -1)
    test.assert_eq(air.tx_ch[sy[1]], ll_init.aux_channel(var s0, x0.aux))
    test.assert_eq(air.tx_t[sy[1]], air.tx_t[sy[0]] + ll_init.aux_offset_us(var s0, x0.aux))
    test.assert(ll_init.aux_offset_us(var s0, x0.aux) - ll_phy.air_us(1, true, s0.n) >= 300)
    test.assert_eq(s0.b[x0.data_at + 228] as Int, 228)
    test.assert_eq(s1.b[x1.data_at] as Int, 229)
    test.assert_eq(s1.b[x1.data_at + 21] as Int, 250)
    // The next event is an interval later.
    test.assert_eq(air.tx_t[sy[2]] - air.tx_t[sy[0]], 80000)

@when(noble_controller.CONFIG.CTL_PER_ADV > 0 and noble_controller.CONFIG.CTL_ADV_SETS > 0)
@test
fn test_the_periodic_advertising_commands_check_their_parameters_and_the_state()
    var c = fresh()
    // The commands are listed, and so is the feature.
    send(var c, 0x1002, [])
    let _r = ctl_hci.ctl_step(var c)
    let sup = drain(var c)
    test.assert_eq(sup[7 + 37] & 0x1C, 0x1C)
    test.assert_eq(sup[7 + 38] & 0x7F, 0x7F)
    test.assert_eq(sup[7 + 40] & 0x20, 0x20)
    test.assert_eq(sup[7 + 47] & 0x02, 0x02)
    send(var c, 0x2003, [])
    let _s = ctl_hci.ctl_step(var c)
    let feat = drain(var c)
    test.assert_eq(feat[7 + 1], ctl_limits.features_octet1())
    test.assert_eq(feat[7 + 1] & 0x20, 0x20)
    // Without a set, parameters, data and enable are Unknown Advertising Identifier.
    test.assert_eq(status_of(var c, 0x203E, pa_params(1, 32, 64, 0)), 0x42)
    test.assert_eq(status_of(var c, 0x203F, pa_data(1, 3, [1])), 0x42)
    test.assert_eq(status_of(var c, 0x2040, [1, 1]), 0x42)
    xa_set(var c, 1, 0, 0, 5, 0, [2, 1, 6])
    test.assert_eq(status_of(var c, 0x203F, pa_data(1, 3, [1])), 0x0C)
    test.assert_eq(status_of(var c, 0x2040, [1, 1]), 0x0C)
    test.assert_eq(status_of(var c, 0x203E, pa_params(1, 5, 64, 0)), 0x12)
    test.assert_eq(status_of(var c, 0x203E, pa_params(1, 64, 32, 0)), 0x12)
    test.assert_eq(status_of(var c, 0x203E, pa_params(1, 32, 64, 0)), 0)
    // The [v2] command answers the handle, and refuses subevents.
    send(var c, 0x2086, [1, 32, 0, 64, 0, 0, 0, 0, 0, 0, 0, 0])
    let _t = ctl_hci.ctl_step(var c)
    let v2 = drain(var c)
    test.assert_eq(v2[6], 0)
    test.assert_eq(v2[7], 1)
    // Subevents: Unsupported Feature or Parameter Value in a build without the advertiser's side of PAwR; with it, these four are too many for the interval.
    var subevents = 0x11
    if ctl_limits.pawr_adv_on()
        subevents = 0x12
    test.assert_eq(status_of(var c, 0x2086, [1, 32, 0, 64, 0, 0, 0, 4, 20, 2, 4, 3]), subevents)
    // Fragments: partial data keeps the train from being enabled, a continuation needs a first fragment.
    test.assert_eq(status_of(var c, 0x203F, pa_data(1, 0, [1, 2])), 0x0C)
    test.assert_eq(status_of(var c, 0x203F, pa_data(1, 1, [1, 2])), 0)
    test.assert_eq(status_of(var c, 0x2040, [1, 1]), 0x0C)
    test.assert_eq(status_of(var c, 0x203F, pa_data(1, 2, [3])), 0)
    test.assert_eq(status_of(var c, 0x203F, pa_data(1, 4, [])), 0x12)
    test.assert_eq(status_of(var c, 0x2040, [3, 1]), 0x11)
    test.assert_eq(status_of(var c, 0x2040, [4, 1]), 0x12)
    test.assert_eq(status_of(var c, 0x2040, [1, 1]), 0)
    // Enabled: only complete data and unchanged data, no new parameters, no removal of the set.
    test.assert_eq(status_of(var c, 0x203F, pa_data(1, 1, [1])), 0x0C)
    test.assert_eq(status_of(var c, 0x203F, pa_data(1, 4, [])), 0)
    test.assert_eq(status_of(var c, 0x203F, pa_data(1, 3, [7, 8])), 0)
    test.assert_eq(status_of(var c, 0x203E, pa_params(1, 32, 64, 0)), 0x0C)
    test.assert_eq(status_of(var c, 0x203C, [1]), 0x0C)
    test.assert_eq(status_of(var c, 0x203D, []), 0x0C)
    test.assert_eq(status_of(var c, 0x2036, xa_params(1, 0, 0x20, 7, 0, 1, 5, 0)), 0x0C)
    // 251 octets in events of 7.5 ms fit on LE 1M and do not on LE Coded, whose packets are 64 microseconds an octet.
    test.assert_eq(status_of(var c, 0x2040, [0, 1]), 0)
    test.assert_eq(status_of(var c, 0x203F, pa_data(1, 3, count_from(0, 251))), 0)
    test.assert_eq(status_of(var c, 0x203E, pa_params(1, 6, 6, 0)), 0)
    test.assert_eq(status_of(var c, 0x2040, [1, 1]), 0)
    test.assert_eq(status_of(var c, 0x203F, pa_data(1, 3, count_from(0, 251))), 0)
    test.assert_eq(status_of(var c, 0x2040, [0, 1]), 0)
    test.assert_eq(status_of(var c, 0x2036, xa_params(1, 0, 0x20, 7, 0, 3, 5, 0)), 0)
    test.assert_eq(status_of(var c, 0x203E, pa_params(1, 6, 6, 0)), 0x45)
    test.assert_eq(status_of(var c, 0x203F, pa_data(1, 3, count_from(0, 20))), 0)
    test.assert_eq(status_of(var c, 0x203F, pa_data(1, 3, count_from(0, 251))), 0x45)
    test.assert_eq(status_of(var c, 0x203E, pa_params(1, 6, 6, 0)), 0)
    test.assert_eq(status_of(var c, 0x2036, xa_params(1, 0, 0x20, 7, 0, 1, 5, 0)), 0)
    // A set that is scannable or connectable has no train; a train's set cannot become one while the train is enabled (Disallowed above).
    test.assert_eq(status_of(var c, 0x2040, [0, 1]), 0)
    test.assert_eq(status_of(var c, 0x2036, xa_params(1, 0x0001, 0x20, 7, 0, 1, 5, 0)), 0)
    test.assert_eq(status_of(var c, 0x2040, [1, 1]), 0x0C)
    test.assert_eq(status_of(var c, 0x203E, pa_params(1, 32, 64, 0)), 0x12)
    // Removing the set removes the train; the train is gone after Reset too.
    test.assert_eq(status_of(var c, 0x203C, [1]), 0)
    xa_set(var c, 1, 0, 0, 5, 0, [])
    test.assert_eq(status_of(var c, 0x203F, pa_data(1, 3, [1])), 0x0C)
    test.assert_eq(status_of(var c, 0x203E, pa_params(1, 32, 64, 0)), 0)
    test.assert_eq(status_of(var c, 0x0C03, []), 0)
    test.assert_eq(status_of(var c, 0x2001, [0xFF, 0xFF, 0x3F, 0, 0, 0, 0, 0]), 0)
    test.assert_eq(status_of(var c, 0x203F, pa_data(1, 3, [1])), 0x42)

@when(noble_controller.CONFIG.CTL_PER_ADV > 0 and noble_controller.CONFIG.CTL_ADV_SETS > 0)
@test
fn test_the_periodic_advertiser_list_and_the_requests_check_their_state()
    var c = fresh()
    send(var c, 0x204A, [])
    let _a = ctl_hci.ctl_step(var c)
    let sz = drain(var c)
    test.assert_eq(sz[7], ctl_limits.pal_n())
    var add: [Int] = [1, 0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 5]
    test.assert_eq(status_of(var c, 0x2047, add), 0)
    test.assert_eq(status_of(var c, 0x2047, add), 0x12)
    test.assert_eq(status_of(var c, 0x2047, [2, 0, 0, 0, 0, 0, 0, 5]), 0x12)
    test.assert_eq(status_of(var c, 0x2048, [1, 0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 6]), 0x42)
    test.assert_eq(status_of(var c, 0x2048, add), 0)
    test.assert_eq(status_of(var c, 0x2049, []), 0)
    // The requests: statuses of the Command Status.
    test.assert_eq(status_of(var c, 0x2045, []), 0x0C)
    test.assert_eq(cmd_status(var c, 0x2044, cs(0, 16, 0, 0, 100, 0)), 0x12)
    test.assert_eq(cmd_status(var c, 0x2044, cs(0, 1, 2, 0, 100, 0)), 0x12)
    test.assert_eq(cmd_status(var c, 0x2044, cs(8, 1, 0, 0, 100, 0)), 0x12)
    test.assert_eq(cmd_status(var c, 0x2044, cs(4, 1, 0, 0, 100, 0)), 0x11)
    test.assert_eq(cmd_status(var c, 0x2044, cs(0, 1, 0, 0, 9, 0)), 0x12)
    test.assert_eq(cmd_status(var c, 0x2044, cs(0, 1, 0, 0x1F4, 100, 0)), 0x12)
    test.assert_eq(cmd_status(var c, 0x2044, cs(0, 1, 0, 0, 100, 0x1F)), 0x0C)
    test.assert_eq(cmd_status(var c, 0x2044, cs(0, 1, 0, 0, 100, 1)), 0x11)
    test.assert_eq(cmd_status(var c, 0x2044, cs(0, 1, 0, 0x1F3, 0x4000, 0)), 0)
    test.assert_eq(cmd_status(var c, 0x2044, cs(0, 1, 0, 0, 100, 0)), 0x0C)
    test.assert_eq(status_of(var c, 0x2047, add), 0x0C)
    test.assert_eq(status_of(var c, 0x2049, []), 0x0C)
    test.assert_eq(status_of(var c, 0x2048, add), 0x0C)
    // The Cancel owes the Host LE Periodic Advertising Sync Established with status 0x44, after the Command Complete.
    var rf = ll_air.rf_new()
    var air = sim_new()
    test.assert_eq(status_of(var c, 0x2001, [0xFF, 0xFF, 0x3F, 0, 0, 0, 0, 0]), 0)
    test.assert_eq(status_of(var c, 0x2045, []), 0)
    run(var c, var rf, var air, 1000)
    test.assert_eq(status_of(var c, 0x2045, []), 0x0C)
    test.assert_eq(status_of(var c, 0x2046, [0, 0]), 0x42)
    test.assert_eq(status_of(var c, 0x2059, [0, 0, 1]), 0x42)
    let ev = meta_events(air.host, 0x0E)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0x44)
    test.assert_eq(list.len(ev[0]), 3 + 16)

// The AUX_ADV_IND of the advertiser 0x30.. (SID 5) that announces a train: the SyncInfo with the offset, the interval, the access
// address and the counter.
fn pa_announce_pdu(offset: Int, interval: Int, aa: Int, counter: Int) -> Pdu
    var si: Vec[u8; 18] = Vec.new()
    for _ in 0..18
        let _a = si.push(0)
    ll_per.syncinfo_put(var si, offset, interval, 0x1FFFFFFFFF, 5, aa, 0x123456, counter)
    var addr: Vec[u8; 6] = Vec.new()
    var none: Vec[u8; 6] = Vec.new()
    for i in 0..6
        let _b = addr.push((0x30 + i) as u8)
        let _n = none.push(0)
    var src: ll_xadv.AdvData = Vec.new()
    var p = ll_pdu.pdu_new()
    ll_xadv.ext_build(var p,
        7,
        0,
        0,
        0,
        true,
        var addr,
        false,
        var none,
        true,
        0x111,
        5,
        false,
        0,
        0,
        0,
        false,
        0,
        true,
        var si,
        var src,
        0,
        0)
    p

// The peer's train as the scanner hears it: the ADV_EXT_IND at 2000 on channel 37, the AUX_ADV_IND at 5000 on channel 12 with the
// SyncInfo, and the first `count` events of the train (the access address `aa`, counter 100 for the first) with `data`, except the
// events from `miss_from` to `miss_to`.  The first event is 10 ms after the AUX_ADV_IND, the interval 20 ms.
fn pa_peer(var air: SimAir, aa: Int, count: Int, data: [Int], miss_from: Int, miss_to: Int)
    hear(var air, 2000, 37, xp(0, -1, 0x111, 5, 12, 100, 0, -200, []))
    hear(var air, 5000, 12, pa_announce_pdu(10000, 16, aa, 100))
    for k in 0..count
        if k < miss_from or k >= miss_to
            hear(var air,
                15000 + k * 20000,
                ll_link.csa2_channel(ll_per.channel_id(aa), (100 + k) & 0xFFFF, 0x1FFFFFFFFF, 37),
                xp(0, -1, -1, 0, -1, 0, 0, -200, data))

// The parameters of LE Periodic Advertising Create Sync: the Options, the SID, the address type, the address 1 to 6, Skip, Sync_Timeout, Sync_CTE_Type.
fn cs(opts: Int, sid: Int, kind: Int, skip: Int, timeout: Int, cte: Int) -> [Int]
    [opts, sid, kind, 1, 2, 3, 4, 5, 6, skip & 0xFF, skip >>> 8, timeout & 0xFF, timeout >>> 8, cte]

// LE Periodic Advertising Create Sync for the advertiser 0x30.. (SID 5, public) with the Options `opts` and the Sync_Timeout `timeout`.
fn pa_create(var c: ctl_hci.Controller, opts: Int, timeout: Int) -> Int
    cmd_status(var c,
        0x2044,
        [opts, 5, 0, 0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0, 0, timeout & 0xFF, timeout >>> 8, 0])

fn pa_aa() -> Int
    var t = ll_per.padv_new()
    ll_per.padv_seed(var t, 99)
    ll_per.padv_start(var t, ll_init.CHMAP_ALL, 0)
    t.aa

// The LE Periodic Advertising Report events among the octets the Host has read: [4, 0x3E, n, 0x0F, handle(2), tx power, RSSI, CTE type, status, length, data...].
fn pa_reports(bytes: [Int]) -> [[Int]]
    meta_events(bytes, 0x0F)

@when(noble_controller.CONFIG.CTL_PER_ADV > 0 and noble_controller.CONFIG.CTL_ADV_SETS > 0)
@test
fn test_a_synchronization_follows_the_syncinfo_and_reports_each_event()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    let aa = pa_aa()
    xscan_on(var c, 0, 0)
    test.assert_eq(pa_create(var c, 0, 400), 0)
    pa_peer(var air, aa, 12, [1, 2, 3, 4, 5], 99, 99)
    run(var c, var rf, var air, 300000)
    // The scan reported the AUX_ADV_IND as well (its periodic interval is the train's).
    let est = meta_events(air.host, 0x0E)
    test.assert_eq(list.len(est), 1)
    let e = est[0]
    test.assert_eq(e[4], 0)
    test.assert_eq(e[5] | (e[6] << 8), 0)
    test.assert_eq(e[7], 5)
    test.assert_eq(e[8], 0)
    test.assert_eq(e[9], 0x30)
    test.assert_eq(e[15], 1)
    test.assert_eq(e[16] | (e[17] << 8), 16)
    test.assert_eq(e[18], 5)
    let rs = pa_reports(air.host)
    test.assert_eq(list.len(rs), 12)
    for r in rs
        test.assert_eq(r[4] | (r[5] << 8), 0)
        test.assert_eq(r[6], 0x7F)
        test.assert_eq(r[8], 0xFF)
        test.assert_eq(r[9], 0)
        test.assert_eq(r[10], 5)
        test.assert_eq(r[11], 1)
        test.assert_eq(r[15], 5)
    test.assert_eq(list.len(meta_events(air.host, 0x10)), 0)
    // The receiver listened with the access address and seed of the SyncInfo and was never late.
    test.assert_eq(rf.ramp_timeouts, 0)
    test.assert_eq(air.cfg_aa, ll_radio.ADV_ACCESS_ADDRESS)
    test.assert(not c.preq.pending)

@when(noble_controller.CONFIG.CTL_PER_ADV > 0 and noble_controller.CONFIG.CTL_ADV_SETS > 0)
@test
fn test_events_that_do_not_come_are_missed_until_the_sync_timeout_and_then_the_sync_is_lost()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    let aa = pa_aa()
    xscan_on(var c, 0, 0)
    // The timeout is 100 ms: three events of 20 ms are missed and the train is heard again; the fourth would be 100 ms since the last packet.
    test.assert_eq(pa_create(var c, 0, 10), 0)
    pa_peer(var air, aa, 20, [9], 4, 7)
    run(var c, var rf, var air, 400000)
    test.assert_eq(list.len(meta_events(air.host, 0x0E)), 1)
    test.assert_eq(list.len(meta_events(air.host, 0x10)), 0)
    test.assert_eq(list.len(pa_reports(air.host)), 17)
    var c2 = fresh()
    var rf2 = ll_air.rf_new()
    var air2 = sim_new()
    xscan_on(var c2, 0, 0)
    test.assert_eq(pa_create(var c2, 0, 10), 0)
    pa_peer(var air2, aa, 20, [9], 4, 20)
    run(var c2, var rf2, var air2, 400000)
    let lost = meta_events(air2.host, 0x10)
    test.assert_eq(list.len(lost), 1)
    test.assert_eq(lost[0][4] | (lost[0][5] << 8), 0)
    test.assert_eq(list.len(pa_reports(air2.host)), 4)
    // The handle is gone: Terminate Sync names none.
    test.assert_eq(status_of(var c2, 0x2046, [0, 0]), 0x42)

@when(noble_controller.CONFIG.CTL_PER_ADV > 0 and noble_controller.CONFIG.CTL_ADV_SETS > 0)
@test
fn test_a_syncinfo_whose_train_is_not_heard_in_six_events_fails_with_synchronization_timeout()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    let aa = pa_aa()
    xscan_on(var c, 0, 0)
    test.assert_eq(pa_create(var c, 0, 400), 0)
    pa_peer(var air, aa, 0, [], 0, 0)
    run(var c, var rf, var air, 400000)
    let est = meta_events(air.host, 0x0E)
    test.assert_eq(list.len(est), 1)
    test.assert_eq(est[0][4], 0x3E)
    test.assert_eq(est[0][5] | (est[0][6] << 8), 0)
    test.assert_eq(est[0][7], 5)
    test.assert(not c.preq.pending)
    // Another request is taken, and the slot is free.
    test.assert_eq(pa_create(var c, 0, 400), 0)

@when(noble_controller.CONFIG.CTL_PER_ADV > 0 and noble_controller.CONFIG.CTL_ADV_SETS > 0)
@test
fn test_a_chain_is_followed_and_reported_in_pieces_and_a_cut_chain_is_closed_as_truncated()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    let aa = pa_aa()
    xscan_on(var c, 0, 0)
    test.assert_eq(pa_create(var c, 0, 400), 0)
    hear(var air, 2000, 37, xp(0, -1, 0x111, 5, 12, 100, 0, -200, []))
    hear(var air, 5000, 12, pa_announce_pdu(10000, 16, aa, 100))
    // Each event: an AUX_SYNC_IND of 229 octets that points 2310 microseconds on (its packet takes 1960) to an AUX_CHAIN_IND of 22; the third event's chain PDU does not come.
    for k in 0..4
        let t = 15000 + k * 20000
        let ch = ll_link.csa2_channel(ll_per.channel_id(aa), (100 + k) & 0xFFFF, 0x1FFFFFFFFF, 37)
        hear(var air, t, ch, xp(0, -1, -1, 0, 20, 77, 0, 5, count_from(0, 229)))
        if k != 2
            hear(var air, t + 2310, 20, xp(0, -1, -1, 0, -1, 0, 0, -200, count_from(229, 22)))
    run(var c, var rf, var air, 120000)
    let rs = pa_reports(air.host)
    test.assert_eq(list.len(rs), 8)
    // First event: the 229 octets and 'more data to come' (status 1), then the 22 and 'complete'; the Tx Power is the first PDU's.
    test.assert_eq(rs[0][9], 1)
    test.assert_eq(rs[0][10], 229)
    test.assert_eq(rs[0][6], 5)
    test.assert_eq(rs[1][9], 0)
    test.assert_eq(rs[1][10], 22)
    test.assert_eq(rs[1][11], 229)
    test.assert_eq(rs[1][6], 5)
    // The third event: the first piece, then a report of no data and 'truncated' (status 2).
    test.assert_eq(rs[4][9], 1)
    test.assert_eq(rs[5][9], 2)
    test.assert_eq(rs[5][10], 0)
    // The fourth event is whole again.
    test.assert_eq(rs[6][9], 1)
    test.assert_eq(rs[7][9], 0)
    test.assert_eq(rf.ramp_timeouts, 0)

@when(noble_controller.CONFIG.CTL_PER_ADV > 0 and noble_controller.CONFIG.CTL_ADV_SETS > 0)
@test
fn test_reports_off_and_on_terminate_and_a_second_request_for_the_same_train()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    let aa = pa_aa()
    xscan_on(var c, 0, 0)
    // Options bit 1: the reports are initially disabled.
    test.assert_eq(pa_create(var c, 2, 400), 0)
    pa_peer(var air, aa, 12, [1, 2], 99, 99)
    run(var c, var rf, var air, 80000)
    test.assert_eq(list.len(meta_events(air.host, 0x0E)), 1)
    test.assert_eq(list.len(pa_reports(air.host)), 0)
    // The same train again: Connection Already Exists.
    test.assert_eq(pa_create(var c, 0, 400), 0x0B)
    test.assert_eq(status_of(var c, 0x2059, [0, 0, 2]), 0x11)
    test.assert_eq(status_of(var c, 0x2059, [0, 0, 4]), 0x12)
    test.assert_eq(status_of(var c, 0x2059, [0, 0, 1]), 0)
    run(var c, var rf, var air, 150000)
    let n1 = list.len(pa_reports(air.host))
    test.assert(n1 >= 3)
    test.assert_eq(status_of(var c, 0x2059, [0, 0, 0]), 0)
    run(var c, var rf, var air, 200000)
    test.assert_eq(list.len(pa_reports(air.host)), n1)
    test.assert_eq(status_of(var c, 0x2046, [0, 0]), 0)
    test.assert_eq(status_of(var c, 0x2046, [0, 0]), 0x42)
    run(var c, var rf, var air, 260000)
    test.assert_eq(list.len(pa_reports(air.host)), n1)
    test.assert_eq(list.len(meta_events(air.host, 0x10)), 0)

// ── Resolvable Private Addresses of extended sets ───────────────────
//
// A set with Own_Address_Type 2 advertises with the local RPA of the resolving list entry of its peer, which the program makes between
// activities (`ctl_privacy_poll`, with random octets from `ctl_entropy_put`) and renews at the RPA timeout; a directed set names its
// peer with an RPA made with the peer's IRK.  The set waits until the address exists.

// The resolving list with the peer 0x60..0x65 (public) of `xa_params`, its IRK and a local IRK, resolution on, an RPA timeout of 2 s.
fn rpa_entry(var c: ctl_hci.Controller)
    var p: [Int] = [0, 0x60, 0x61, 0x62, 0x63, 0x64, 0x65]
    for k in 0..16
        list.push(p, 0x30 + k)
    for k in 0..16
        list.push(p, 0x50 + k)
    test.assert_eq(status_of(var c, 0x2027, p), 0)
    test.assert_eq(status_of(var c, 0x202D, [1]), 0)
    test.assert_eq(status_of(var c, 0x202E, [2, 0]), 0)

// `run` with the work of privacy the program does between activities; `entropy` says whether it has random octets to give.
fn run_priv(var c: ctl_hci.Controller, var rf: ll_air.Rf, var air: SimAir, until: Int,
            entropy: Bool)
    var rx = ll_pdu.pdu_new()
    var policy = ll_policy.default_link_policy()
    var cc = ll_ccm.soft_cipher_new()
    var guard = 0
    var seed = 7
    while air.now < until and guard < 400000
        guard = guard + 1
        let _ran = ctl_hci.ctl_step(var c)
        while ctl_hci.ctl_tx_pending(var c)
            list.push(air.host, ctl_hci.ctl_tx_next(var c))
        if entropy and ctl_hci.ctl_entropy_wanted(var c)
            var e: Vec[u8; 12] = Vec.new()
            for k in 0..12
                let _a = e.push((seed + k * 37) as u8)
            seed = seed + 1
            ctl_hci.ctl_entropy_put(var c, var e)
        let _p = ctl_hci.ctl_privacy_poll(var c, var cc)
        let before = air.now
        ll_air.ll_poll(var air, var c, var rf, var rx, var policy, var cc)
        if air.now == before
            air.now = air.now + 10
    test.assert(guard < 400000)

// The AdvA (`which` 0) or TargetA (1) of the k-th PDU of type 7 that has one, as six octets, and its type bit.
fn aux_addr(var air: SimAir, k: Int, which: Int) -> [Int]
    var seen = 0
    for i in tx_of(var air, 7)
        var p = tx_pdu(air, i)
        let x = ll_ext.ext_parse(var p)
        var at = x.adva
        if which == 1
            at = x.targeta
        if x.ok and at >= 0 and x.sync < 0
            if seen == k
                var out: [Int] = []
                for j in 0..6
                    list.push(out, p.b[at + j] as Int)
                if which == 0
                    list.push(out, ll_pdu.pdu_tx_add(var p))
                else
                    list.push(out, ll_pdu.pdu_rx_add(var p))
                return out
            seen = seen + 1
    []

// The PDUs of type 7 with an AdvA the Controller sent.
fn aux_count(var air: SimAir) -> Int
    var n = 0
    for i in tx_of(var air, 7)
        var p = tx_pdu(air, i)
        let x = ll_ext.ext_parse(var p)
        if x.ok and x.adva >= 0 and x.sync < 0
            n = n + 1
    n

fn is_rpa_octets(a: [Int]) -> Bool
    list.len(a) == 7 and (a[5] & 0xC0) == 0x40 and a[6] == 1

@when(noble_controller.CONFIG.CTL_ADV_SETS > 0)
@test
fn test_a_set_with_own_address_type_2_waits_for_its_rpa_advertises_it_and_renews_it_at_the_timeout()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    rpa_entry(var c)
    xa_set(var c, 1, 0, 2, 5, 0, [2, 1, 6])
    test.assert_eq(status_of(var c, 0x2039, xa_enable(1, 1, 0, 0)), 0)
    // No random octets, no RPA: the set sends nothing.
    run_priv(var c, var rf, var air, 80000, false)
    test.assert_eq(count_tx(var air, 7), 0)
    run_priv(var c, var rf, var air, 300000, true)
    test.assert(count_tx(var air, 7) >= 8)
    let first = aux_addr(var air, 0, 0)
    test.assert(is_rpa_octets(first))
    var local = ctl_hci.rl_local_vec(var c, 0)
    for j in 0..6
        test.assert_eq(first[j], local[j] as Int)
    // The same address in every event of the timeout, and another once it ran out.
    test.assert_eq(aux_addr(var air, 3, 0), first)
    run_priv(var c, var rf, var air, 2800000, true)
    let last = aux_addr(var air, aux_count(var air) - 1, 0)
    test.assert(is_rpa_octets(last))
    test.assert(last != first)
    test.assert_eq(rf.ramp_timeouts, 0)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_a_directed_set_names_its_peer_with_an_rpa_made_with_the_peers_irk()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    rpa_entry(var c)
    xa_set(var c, 1, 0x0005, 2, 5, 0, [])
    test.assert_eq(status_of(var c, 0x2039, xa_enable(1, 1, 0, 0)), 0)
    run_priv(var c, var rf, var air, 300000, true)
    test.assert(count_tx(var air, 7) >= 8)
    let own = aux_addr(var air, 0, 0)
    let target = aux_addr(var air, 0, 1)
    test.assert(is_rpa_octets(own))
    test.assert(is_rpa_octets(target))
    // The TargetA is not the identity of the peer (0x60..0x65), and resolves with the peer's IRK.
    test.assert(target[0] != 0x60 or target[1] != 0x61)
    var tv: Vec[u8; 6] = Vec.new()
    for j in 0..6
        let _t = tv.push(target[j] as u8)
    var cc = ll_ccm.soft_cipher_new()
    test.assert_eq(ll_privacy.rl_resolve(var c.rl, var cc, var tv), 0)

@when(noble_controller.CONFIG.CTL_ADV_SETS > 0)
@test
fn test_own_address_type_2_with_no_entry_is_the_public_address_and_3_the_random_one()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    xa_set(var c, 1, 0, 2, 5, 0, [2, 1, 6])
    test.assert_eq(status_of(var c, 0x2039, xa_enable(1, 1, 0, 0)), 0)
    run_priv(var c, var rf, var air, 100000, true)
    let public_addr = aux_addr(var air, 0, 0)
    test.assert_eq(list.len(public_addr), 7)
    test.assert_eq(public_addr[0], 0x10)
    test.assert_eq(public_addr[5], 0x15)
    test.assert_eq(public_addr[6], 0)
    var d = fresh()
    var rf2 = ll_air.rf_new()
    var air2 = sim_new()
    xa_set(var d, 1, 0, 3, 5, 0, [2, 1, 6])
    test.assert_eq(status_of(var d, 0x2035, [1, 0xC1, 0xC2, 0xC3, 0xC4, 0xC5, 0xC6]), 0)
    test.assert_eq(status_of(var d, 0x2039, xa_enable(1, 1, 0, 0)), 0)
    run_priv(var d, var rf2, var air2, 100000, true)
    let rnd = aux_addr(var air2, 0, 0)
    test.assert_eq(rnd[0], 0xC1)
    test.assert_eq(rnd[5], 0xC6)
    test.assert_eq(rnd[6], 1)

// ── Broadcast isochronous groups: the Isochronous Broadcaster ───────
//
// LE Create BIG on the train of an advertising set: the group sends the subevents of its BISes at the times and on the channels
// that its BIGInfo, in the ACAD of the AUX_SYNC_IND of the train, gives, a payload the Host supplied in IRC subevents of the event it
// belongs to, empty PDUs in the others; the key of an encrypted group is derived from the Broadcast_Code and the GSKD of the BIGInfo
// and the payloads are sealed with the nonce of their number.  The receiver is the test: it reads the BIGInfo from what went on air and
// holds the Controller to it.

// LE Create BIG: the BIG `handle` on the train of the set `ah`, `num` BISes with SDUs of `max_sdu` octets every `sdu_int`
// microseconds, `lat` milliseconds of latency, RTN `rtn`, the PHYs `phys`, the packing, no framing, the encryption and a Broadcast_Code.
fn big_params(handle: Int, ah: Int, num: Int, sdu_int: Int, max_sdu: Int, lat: Int, rtn: Int,
              phys: Int, packing: Int, enc: Int) -> [Int]
    var p: [Int] = [handle, ah, num, sdu_int & 0xFF, (sdu_int >>> 8) & 0xFF, (sdu_int >>> 16) & 0xFF, max_sdu & 0xFF, max_sdu >>> 8,
                    lat & 0xFF, lat >>> 8, rtn, phys, packing, 0, enc]
    for i in 0..16
        if enc == 1
            list.push(p, 0x40 + i)
        else
            list.push(p, 0)
    p

// The Controller with all events enabled and the train of the set 1 (interval 32 units, 20 octets of data) running.
fn big_train(var c: ctl_hci.Controller, var rf: ll_air.Rf, var air: SimAir)
    pa_train(var c, 32, 0, count_from(1, 20))
    test.assert_eq(status_of(var c, 0x2001, [0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF]), 0)
    test.assert_eq(status_of(var c, 0x2039, xa_enable(1, 1, 0, 0)), 0)
    run(var c, var rf, var air, 120000)

// 24 random octets for the key of an encrypted group.
fn big_random(var c: ctl_hci.Controller)
    for r in 0..2
        var v: Vec[u8; 12] = Vec.new()
        for i in 0..12
            let _x = v.push((0x90 + i + 12 * r) as u8)
        ctl_hci.ctl_big_random_put(var c, var v)

// The last AUX_SYNC_IND the Controller sent that carries a BIGInfo: its index, -1 for none.
fn big_info_pdu(var air: SimAir) -> Int
    var best = -1
    for i in tx_of(var air, 7)
        var p = tx_pdu(air, i)
        let x = ll_ext.ext_parse(var p)
        if x.ok and x.sync < 0 and x.acad_len > 0 and ll_big.acad_find(var p, x.acad_at, x.acad_len) >= 0
            best = i
    best

fn big_info_view(var air: SimAir, i: Int) -> ll_big.InfoView
    var p = tx_pdu(air, i)
    let x = ll_ext.ext_parse(var p)
    let f = ll_big.acad_find(var p, x.acad_at, x.acad_len)
    ll_big.info_get(var p, f / 64, f % 64)

// The indexes of the PDUs sent with the access address of BIS `n` of the group whose seed is `saa`.
fn big_sent(var air: SimAir, saa: Int, n: Int) -> [Int]
    pa_sent_with(var air, ll_big.bis_aa(saa, n))

@when(noble_controller.CONFIG.CTL_BIS >= 2)
@test
fn test_create_big_sends_the_subevents_of_the_bises_at_the_times_and_on_the_channels_of_the_biginfo()
    if not ctl_limits.big_on()
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    big_train(var c, var rf, var air)
    test.assert_eq(cmd_status(var c, 0x2068, big_params(0, 1, 2, 10000, 100, 20, 1, 2, 0, 0)), 0)
    run(var c, var rf, var air, 500000)
    // LE Create BIG Complete: success, the BIG_Handle, the BIG_Sync_Delay, the transport latency, LE 2M, NSE 2, BN 1, PTO 0, IRC 2,
    // Max_PDU 100, an ISO interval of 8 units, two BISes with the handles of their slots.
    let ev = meta_events(air.host, 0x1B)
    test.assert_eq(list.len(ev), 1)
    let e = ev[0]
    test.assert_eq(e[4], 0)
    test.assert_eq(e[5], 0)
    let sync_delay = e[6] | (e[7] << 8) | (e[8] << 16)
    let latency = e[9] | (e[10] << 8) | (e[11] << 16)
    test.assert_eq(e[12], 2)
    test.assert_eq(e[13], 2)
    test.assert_eq(e[14], 1)
    test.assert_eq(e[15], 0)
    test.assert_eq(e[16], 2)
    test.assert_eq(e[17] | (e[18] << 8), 100)
    test.assert_eq(e[19] | (e[20] << 8), 8)
    test.assert_eq(e[21], 2)
    test.assert_eq(e[22] | (e[23] << 8), 0x200)
    test.assert_eq(e[24] | (e[25] << 8), 0x201)
    test.assert_eq(sync_delay, c.bigs[0].sync_delay)
    test.assert_eq(latency, c.bigs[0].latency)
    test.assert(latency <= 20000)
    // The BIGInfo: what the Controller derived.
    let bi = big_info_pdu(var air)
    test.assert(bi >= 0)
    let v = big_info_view(var air, bi)
    test.assert(v.ok)
    test.assert(not v.enc)
    test.assert_eq(v.iso, 8)
    test.assert_eq(v.num_bis, 2)
    test.assert_eq(v.nse, 2)
    test.assert_eq(v.bn, 1)
    test.assert_eq(v.irc, 2)
    test.assert_eq(v.pto, 0)
    test.assert_eq(v.max_pdu, 100)
    test.assert_eq(v.phy, 2)
    test.assert_eq(v.sdu_int, 10000)
    test.assert_eq(v.max_sdu, 100)
    test.assert_eq(v.sub_int, c.bigs[0].sub_int)
    test.assert_eq(v.bis_sp, c.bigs[0].bis_sp)
    test.assert(ll_big.saa_valid(v.saa, 2, false))
    // Sequential: BIS 2 starts after the two subevents of BIS 1.
    test.assert_eq(v.bis_sp, v.nse * v.sub_int)
    // The anchor point is no earlier than the offset and less than a unit later.
    let b1 = big_sent(var air, v.saa, 1)
    let b2 = big_sent(var air, v.saa, 2)
    test.assert(list.len(b1) >= 20)
    test.assert_eq(list.len(b1), list.len(b2))
    var anchored = false
    for k in 0..list.len(b1)
        let d = air.tx_t[b1[k]] - (air.tx_t[bi] + v.off_us)
        if d >= 0 and d <= v.unit
            anchored = true
    test.assert(anchored)
    // Every event: BIS 1 at the anchor and a Sub_Interval later, BIS 2 a BIS_Spacing after BIS 1 and again; ISO_Interval apart.
    let first = air.tx_t[b1[0]]
    for ev_i in 0..8
        let a = first + ev_i * 10000
        test.assert_eq(air.tx_t[b1[2 * ev_i]], a)
        test.assert_eq(air.tx_t[b1[2 * ev_i + 1]], a + v.sub_int)
        test.assert_eq(air.tx_t[b2[2 * ev_i]], a + v.bis_sp)
        test.assert_eq(air.tx_t[b2[2 * ev_i + 1]], a + v.bis_sp + v.sub_int)
        // The channels of channel selection algorithm #2 for the stream's access address, the event counter and the subevent.
        test.assert_eq(air.tx_ch[b1[2 * ev_i]], ll_iso.sub_channel(ll_big.bis_aa(v.saa, 1), ev_i, 1, v.chmap, 37))
        test.assert_eq(air.tx_ch[b1[2 * ev_i + 1]],
            ll_iso.sub_channel(ll_big.bis_aa(v.saa, 1), ev_i, 2, v.chmap, 37))
        test.assert_eq(air.tx_ch[b2[2 * ev_i + 1]],
            ll_iso.sub_channel(ll_big.bis_aa(v.saa, 2), ev_i, 2, v.chmap, 37))
        // The PHY is LE 2M, and with no data from the Host the PDUs are empty ones of LLID 1.
        test.assert_eq(air.tx_phy[b1[2 * ev_i]], 2)
        test.assert_eq(air.tx_n[b1[2 * ev_i]], 2)
        test.assert_eq(air.tx_h[b1[2 * ev_i]], 1)
    test.assert_eq(rf.ramp_timeouts, 0)
    test.assert_eq(rf.big_late, 0)
    test.assert_eq(air.holds, air.releases)

// One BIG of two BISes with the PTS rig's numbers (a 100 ms train of 74 octets of data): the events of BIS 1 come every ISO_Interval, no
// subevent is late, and every BIGInfo names an anchor point that a subevent keeps.  An ISO interval of 7.5 ms is no divisor of the train's
// 100 ms, so the train's events fall on the group's events in turn; the train gives such an event up (`ctl_hci.ctl_padv_room`) and the group
// loses no subevent.
fn big_regular(sdu_int: Int, max_sdu: Int, lat: Int)
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pa_train(var c, 80, 0, count_from(1, 74))
    test.assert_eq(status_of(var c, 0x2001, [0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF]), 0)
    test.assert_eq(status_of(var c, 0x2039, xa_enable(1, 1, 0, 0)), 0)
    run(var c, var rf, var air, 300000)
    test.assert_eq(cmd_status(var c, 0x2068, big_params(0, 1, 2, sdu_int, max_sdu, lat, 1, 2, 0, 0)), 0)
    run(var c, var rf, var air, 1500000)
    let bi = big_info_pdu(var air)
    test.assert(bi >= 0)
    let v = big_info_view(var air, bi)
    let b1 = big_sent(var air, v.saa, 1)
    let b2 = big_sent(var air, v.saa, 2)
    test.assert(list.len(b1) >= 2 * 100)
    // Every BIGInfo on the train names an anchor point that a BIS 1 subevent keeps, to within one offset unit.
    var bad = 0
    var seen = 0
    for i in tx_of(var air, 7)
        var q = tx_pdu(air, i)
        let x = ll_ext.ext_parse(var q)
        if x.ok and x.sync < 0 and x.acad_len > 0 and ll_big.acad_find(var q, x.acad_at, x.acad_len) >= 0
            let w = big_info_view(var air, i)
            seen = seen + 1
            var hit = false
            for k in 0..list.len(b1)
                let d = air.tx_t[b1[k]] - (air.tx_t[i] + w.off_us)
                if d >= 0 and d <= w.unit
                    hit = true
            if not hit
                bad = bad + 1
    test.assert(seen >= 5)
    test.assert_eq(bad, 0)
    let iso = v.iso * 1250
    let events = b1[0::2]
    for j in 1..list.len(events)
        test.assert_eq(air.tx_t[events[j]] - air.tx_t[events[j - 1]], iso)
    // The train goes on: it sends most of its events (the ones that fall on the group's event are given up).
    test.assert(c.pads[0].events >= 8)
    // The anchor point of the group is placed where the most events of the train keep clear of the group's: at least one in three runs.
    test.assert(c.pads[0].events + c.pads[0].late <= c.pads[0].events * 3 + 2)
    // An ISO interval that divides the train's keeps its place behind the event it follows: none is given up.
    if sdu_int == 10000
        test.assert_eq(c.pads[0].late, 0)
    test.assert_eq(rf.big_late, 0)
    test.assert_eq(rf.ramp_timeouts, 0)

// SDUs of `max_sdu` octets on both BISes of a 10 ms group, one each per interval: every PDU of both BISes carries the SDU whole, with the
// length byte of its size.
fn big_data(max_sdu: Int)
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    pa_train(var c, 80, 0, count_from(1, 74))
    test.assert_eq(status_of(var c, 0x2001, [0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF]), 0)
    test.assert_eq(status_of(var c, 0x2039, xa_enable(1, 1, 0, 0)), 0)
    run(var c, var rf, var air, 120000)
    test.assert_eq(cmd_status(var c, 0x2068, big_params(0, 1, 2, 10000, max_sdu, 20, 1, 2, 0, 0)), 0)
    run(var c, var rf, var air, 300000)
    for h in [0x200, 0x201]
        test.assert_eq(big_path(var c, h), 0)
    let bi = big_info_pdu(var air)
    let v = big_info_view(var air, bi)
    for k in 0..4
        for h in [0x200, 0x201]
            for b in host_iso(h, 100 + k, max_sdu)
                ctl_hci.ctl_rx(var c, b)
            let _r = ctl_hci.ctl_step(var c)
    run(var c, var rf, var air, 500000)
    var n1 = 0
    for k in big_sent(var air, v.saa, 1)
        if air.tx_n[k] > 2
            n1 = n1 + 1
            test.assert_eq(air.tx_body[k][1], max_sdu)
            test.assert_eq(air.tx_n[k], max_sdu + 2)
    var n2 = 0
    for k in big_sent(var air, v.saa, 2)
        if air.tx_n[k] > 2
            n2 = n2 + 1
            test.assert_eq(air.tx_body[k][1], max_sdu)
            test.assert_eq(air.tx_n[k], max_sdu + 2)
    // Four SDUs a BIS, each in the two subevents of its event.
    test.assert_eq(n1, 8)
    test.assert_eq(n2, 8)
    test.assert_eq(rf.big_late, 0)
    test.assert_eq(rf.ramp_timeouts, 0)

@when(noble_controller.CONFIG.CTL_BIS >= 2)
