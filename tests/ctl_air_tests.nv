    run(var c, var rf, var air, 300000)
    test.assert(c.links[0].live)
    test.assert_eq(c.init.aux_connects, 1)
    let k = last_tx_of(var air, 5)
    test.assert_eq(air.tx_ch[k], 12)
    test.assert_eq(air.tx_t[k], 5000 + (12 + 9) * 4 + 150)
    // The connection starts on LE 2M with the interval and timeout of the set of LE 2M.
    test.assert_eq(c.links[0].phy, 2)
    test.assert_eq(c.links[0].interval, 60)
    test.assert_eq(c.links[0].timeout, 300)
    test.assert_eq(air.tx_body[k][24], 60)
    let d = first_data_tx(var air)
    test.assert_eq(air.tx_t[d], air.tx_t[k] + (36 + 9) * 4 + 2500)
    test.assert(first_event_on(var air, 2) >= 0)
    test.assert_eq(rf.cen_aborts, 0)
    test.assert_eq(rf.ramp_timeouts, 0)

