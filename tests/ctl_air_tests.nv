    var rf2 = ll_air.rf_new()
    var air2 = sim_new()
    xscan_on(var d, 0, 0)
    hear(var air2, 2000, 37, xp(0, -1, 7, 2, 12, 100, 0, -200, []))
    run(var d, var rf2, var air2, 20000)
    test.assert_eq(list.len(xreports(air2.host)), 0)
    test.assert_eq(d.scan.x_missed, 1)
    test.assert_eq(d.scan.x_truncated, 0)

@test
fn test_an_active_extended_scan_asks_a_scannable_aux_adv_ind_and_reports_the_response_and_its_chain()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    xscan_on(var c, 1, 0)
    hear(var air, 2000, 37, xp(2, -1, 3, 4, 12, 100, 0, -200, []))
    hear(var air, 5000, 12, xp(2, 0x30, 3, 4, -1, 0, 0, -200, []))
    react(var air, ll_pdu.SCAN_REQ, 12, xp(0, 0x30, 3, 4, 13, 100, 0, -200, count_from(0, 20)), 1)
    // The response starts T_IFS after the request (5310 to 5486), its pointer says 3 ms after its first bit.
    hear(var air, 5310 + 176 + 150 + 3000, 13, xp(0, -1, 3, 4, -1, 0, 0, -200, count_from(20, 10)))
    run(var c, var rf, var air, 40000)
    // The AUX_SCAN_REQ went out on channel 12 T_IFS after the AUX_ADV_IND (12 octets).
    test.assert_eq(count_tx(var air, ll_pdu.SCAN_REQ), 1)
    let k = last_tx_of(var air, ll_pdu.SCAN_REQ)
    test.assert_eq(air.tx_ch[k], 12)
    test.assert_eq(air.tx_t[k], 5000 + (12 + 8) * 8 + 150)
    test.assert_eq(air.tx_body[k][8], 0x30)
    test.assert_eq(air.tx_body[k][13], 0x35)
    test.assert_eq(air.tx_body[k][2], 0x10)
    test.assert_eq(rf.x_asks, 1)
    // The answer armed while the ADV_EXT_IND arrived was taken back; the AUX_ADV_IND's was sent.
    test.assert_eq(rf.spec_aborts, 1)
    let ev = xreports(air.host)
    test.assert_eq(list.len(ev), 3)
    // The advertisement: scannable, no data.  The response: scannable and a scan response, 20 octets then 10.
    test.assert_eq(x_et(ev[0]), 0x0002)
    test.assert_eq(x_len(ev[0]), 0)
    test.assert_eq(x_et(ev[1]) & 0x1F, 0x000A)
    test.assert_eq(x_et(ev[1]) & 0x60, 0x20)
    test.assert_eq(x_len(ev[1]), 20)
    test.assert_eq(x_et(ev[2]) & 0x1F, 0x000A)
    test.assert_eq(x_et(ev[2]) & 0x60, 0)
    test.assert_eq(x_len(ev[2]), 10)
    test.assert_eq(ev[2][29], 20)
    test.assert_eq(c.scan.responses, 1)

