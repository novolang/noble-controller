@when(noble_controller.CONFIG.CTL_CENTRAL > 0)
@test
fn test_an_aux_adv_ind_of_another_advertiser_or_a_scannable_one_is_not_answered()
    // An AUX_ADV_IND from a device the Host did not name: followed, judged, not answered.
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    ext_start(var c, var air, ext_create_connection(1, 0))
    hear(var air, 2000, 37, ext_pdu(7, 1, 0x18, 0, 0, 12, 100, 0))
    hear(var air, 5000, 12, ext_pdu(7, 1, 0x09, 0x50, 0, 0, 0, 0))
    run(var c, var rf, var air, 60000)
    test.assert_eq(c.init.aux_followed, 1)
    test.assert_eq(count_tx(var air, 5), 0)
    test.assert(c.init.enabled)
    test.assert(rf.spec_aborts >= 1)
    // A scannable one is not followed at all.
    var d = fresh()
    var rf2 = ll_air.rf_new()
    var air2 = sim_new()
    ext_start(var d, var air2, ext_create_connection(1, 0))
    ext_advertiser(var air2, 2, 0x09, 0, false)
    run(var d, var rf2, var air2, 60000)
    test.assert_eq(d.init.aux_followed, 0)
    test.assert_eq(count_tx(var air2, 5), 0)
    // A directed one to this Controller is answered, one to another initiator is not.
    var e = fresh()
    var rf3 = ll_air.rf_new()
    var air3 = sim_new()
    ext_start(var e, var air3, ext_create_connection(1, 0))
    ext_advertiser(var air3, 1, 0x0B, 0, true)
    run(var e, var rf3, var air3, 100000)
    test.assert(e.links[0].live)
    var f = fresh()
    var rf4 = ll_air.rf_new()
    var air4 = sim_new()
    ext_start(var f, var air4, ext_create_connection(1, 0))
    hear(var air4, 2000, 37, ext_pdu(7, 1, 0x18, 0, 0, 12, 100, 0))
    hear(var air4, 5000, 12, ext_pdu(7, 1, 0x0B, 0x30, 0x70, 0, 0, 0))
    run(var f, var rf4, var air4, 60000)
    test.assert_eq(count_tx(var air4, 5), 0)
    test.assert(not f.links[0].live)

