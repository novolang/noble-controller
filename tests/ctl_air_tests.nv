@test
fn test_four_streams_of_one_group_run_in_sequence_and_interleaved()
    if not ctl_limits.iso_on() or ctl_limits.cis_slots() < 4
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    // Four streams of 40 octets with one retransmission: two subevents each, 4 x 2 x 760 microseconds in the interval.
    cis_cen_up_req(var c, var rf, var air, 4, 0, 40, 40, false, cig_request_full(4, 0, 1, 40, 40, 3, 10000, 20))
    for k in 1..4
        test.assert_eq(c.cis[k].off_cig - c.cis[k - 1].off_cig, c.cis[0].nse * c.cis[0].sub_int)
    cen_group_check(var c, var rf, var air, 4, 40, 40, 100)
    var d = fresh()
    var rf2 = ll_air.rf_new()
    var air2 = sim_new()
    cis_cen_up_req(var d, var rf2, var air2, 4, 1, 40, 40, false, cig_request_full(4, 1, 1, 40, 40, 3, 10000, 20))
    let slot = ll_iso.plan_slot_us(d.radio, d.cis[0].phy, d.cis[0].max_pdu_c, d.cis[0].max_pdu_p)
    test.assert_eq(d.cis[0].sub_int, 4 * slot)
    for k in 1..4
        test.assert_eq(d.cis[k].off_cig - d.cis[k - 1].off_cig, slot)
    cen_group_check(var d, var rf2, var air2, 4, 40, 40, 100)

