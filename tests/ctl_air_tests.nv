@test
fn test_extended_scan_filters_duplicates_by_address_and_did_and_reports_a_new_did()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    xscan_on(var c, 0, 1)
    // The windows are 10 ms on channels 37, 38, 39, so channel 37 is heard at 2000 and 32000 and 62000.
    for k in 0..3
        let did = if k == 2
            0x400
        else
            0x100
        hear(var air, 2000 + k * 30000, 37, xp(0, -1, did, 1, 12, 100, 0, -200, []))
        hear(var air, 5000 + k * 30000, 12, xp(0, 0x30, did, 1, -1, 0, 0, -200, [k]))
    run(var c, var rf, var air, 80000)
    let ev = xreports(air.host)
    test.assert_eq(list.len(ev), 2)
    test.assert_eq(ev[0][29], 0)
    test.assert_eq(ev[1][29], 2)
    test.assert_eq(c.scan.duplicates, 1)
    // Without the filter every advertisement is reported.
    var d = fresh()
    var rf2 = ll_air.rf_new()
    var air2 = sim_new()
    xscan_on(var d, 0, 0)
    for k in 0..3
        hear(var air2, 2000 + k * 30000, 37, xp(0, -1, 0x100, 1, 12, 100, 0, -200, []))
        hear(var air2, 5000 + k * 30000, 12, xp(0, 0x30, 0x100, 1, -1, 0, 0, -200, [k]))
    run(var d, var rf2, var air2, 80000)
    test.assert_eq(list.len(xreports(air2.host)), 3)

@test
fn test_extended_scan_takes_the_address_of_the_adv_ext_ind_when_the_aux_adv_ind_has_none_and_reports_an_anonymous_one()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    xscan_on(var c, 0, 0)
    // A non-connectable advertiser puts its AdvA in the ADV_EXT_IND.
    hear(var air, 2000, 37, xp(0, 0x30, 9, 6, 12, 100, 0, -200, []))
    hear(var air, 5000, 12, xp(0, -1, 9, 6, -1, 0, 0, -200, [1, 2, 3]))
    // One that names no address at all is anonymous: Address_Type 0xFF, no address.
    hear(var air, 32000, 37, xp(0, -1, 10, 6, 12, 100, 0, -200, []))
    hear(var air, 35000, 12, xp(0, -1, 10, 6, -1, 0, 0, -200, [4, 5]))
    run(var c, var rf, var air, 60000)
    let ev = xreports(air.host)
    test.assert_eq(list.len(ev), 2)
    test.assert_eq(ev[0][7], 0)
    test.assert_eq(ev[0][8], 0x30)
    test.assert_eq(ev[0][13], 0x35)
    test.assert_eq(ev[0][16], 6)
    test.assert_eq(x_len(ev[0]), 3)
    test.assert_eq(ev[1][7], 0xFF)
    test.assert_eq(ev[1][8], 0)
    test.assert_eq(x_len(ev[1]), 2)

@test
fn test_extended_scan_follows_a_chain_and_reports_each_pdu_with_the_status_of_the_data()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    xscan_on(var c, 0, 0)
    hear(var air, 2000, 37, xp(0, -1, 7, 2, 12, 100, 0, -200, []))
    // 200 octets, a pointer to channel 13 after 6 ms; the chain PDU holds 100 and a pointer to channel 14.
    hear(var air, 5000, 12, xp(0, 0x30, 7, 2, 13, 200, 0, -200, count_from(0, 200)))
    hear(var air, 5000 + 6000, 13, xp(0, -1, 7, 2, 14, 200, 0, -200, count_from(200, 100)))
    hear(var air, 5000 + 12000, 14, xp(0, -1, 7, 2, -1, 0, 0, -200, count_from(44, 20)))
    run(var c, var rf, var air, 40000)
    let ev = xreports(air.host)
    test.assert_eq(list.len(ev), 3)
    // Incomplete, more data to come (status 1 in bits 5 and 6), then again, then complete.
    test.assert_eq(x_et(ev[0]) & 0x60, 0x20)
    test.assert_eq(x_et(ev[1]) & 0x60, 0x20)
    test.assert_eq(x_et(ev[2]) & 0x60, 0)
    test.assert_eq(x_len(ev[0]), 200)
    test.assert_eq(x_len(ev[1]), 100)
    test.assert_eq(x_len(ev[2]), 20)
    test.assert_eq(ev[1][29], 200)
    test.assert_eq(ev[2][29], 44)
    // Every report names the advertiser the first PDU named.
    test.assert_eq(ev[2][8], 0x30)
    test.assert_eq(ev[2][16], 2)
    test.assert_eq(rf.x_chains, 2)
    test.assert_eq(c.scan.x_followed, 3)

@test
