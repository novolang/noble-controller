@when(noble_controller.CONFIG.CTL_CENTRAL > 0)
@test
fn test_a_connect_rsp_that_comes_later_than_t_ifs_is_taken()
    // The SoftDevice Controller answers 308 to 470 microseconds after the request. The request ends at
    // 5310 + 352; the answer's first bit is 400 after that.
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    ext_start(var c, var air, ext_create_connection(1, 0))
    hear(var air, 2000, 37, ext_pdu(7, 1, 0x18, 0, 0, 12, 100, 0))
    hear(var air, 5000, 12, ext_pdu(7, 1, 0x09, 0x30, 0x10, 0, 0, 0))
    hear(var air, 5310 + 352 + 400, 12, ext_pdu(8, 0, 0x03, 0x30, 0x10, 0, 0, 0))
    run(var c, var rf, var air, 300000)
    test.assert(c.links[0].live)
    test.assert_eq(c.init.aux_rsp_missed, 0)
    test.assert_eq(rf.aux_rsp_min_us, 400)
    test.assert_eq(rf.aux_rsp_max_us, 400)
    // One that comes after the wait is a request without a response.
    var d = fresh()
    var rf2 = ll_air.rf_new()
    var air2 = sim_new()
    ext_start(var d, var air2, ext_create_connection(1, 0))
    hear(var air2, 2000, 37, ext_pdu(7, 1, 0x18, 0, 0, 12, 100, 0))
    hear(var air2, 5000, 12, ext_pdu(7, 1, 0x09, 0x30, 0x10, 0, 0, 0))
    hear(var air2, 5310 + 352 + 1100, 12, ext_pdu(8, 0, 0x03, 0x30, 0x10, 0, 0, 0))
    run(var d, var rf2, var air2, 60000)
    test.assert(not d.links[0].live)
    test.assert_eq(d.init.aux_rsp_missed, 1)

