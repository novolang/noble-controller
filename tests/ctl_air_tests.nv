@test
fn test_extended_scan_commands_check_their_parameters_and_the_family_of_commands_in_use()
    var c = fresh()
    // Reserved Scanning_PHYs bits, an empty set, LE 2M and a range error are Invalid HCI Command Parameters.
    test.assert_eq(status_of(var c, 0x2041, [0, 0, 0]), 0x12)
    test.assert_eq(status_of(var c, 0x2041, [0, 0, 2, 0, 16, 0, 16, 0]), 0x12)
    test.assert_eq(status_of(var c, 0x2041, [4, 0, 1, 0, 16, 0, 16, 0]), 0x12)
    test.assert_eq(status_of(var c, 0x2041, [0, 0, 1, 0, 16, 0, 32, 0]), 0x12)
    // The length must follow the PHYs.
    test.assert_eq(status_of(var c, 0x2041, [0, 0, 1, 0, 16, 0]), 0x12)
    // LE Coded is refused by a Controller whose radio lacks it, and taken by one that has it.
    ctl_hci.ctl_set_coded(var c, false)
    test.assert_eq(status_of(var c, 0x2041, [0, 0, 5, 0, 16, 0, 16, 0, 0, 16, 0, 16, 0]), 0x11)
    test.assert_eq(status_of(var c, 0x2041, [0, 0, 4, 0, 16, 0, 16, 0]), 0x11)
    ctl_hci.ctl_set_coded(var c, true)
    test.assert_eq(status_of(var c, 0x2041, [0, 0, 5, 0, 16, 0, 16, 0, 0, 16, 0, 16, 0]), 0)
    test.assert_eq(status_of(var c, 0x2041, [0, 0, 4, 0, 16, 0, 16, 0]), 0)
    test.assert_eq(status_of(var c, 0x2041, [0, 0, 1, 1, 16, 0, 16, 0]), 0)
    // The legacy commands are Command Disallowed from then on, and the other way round.
    test.assert_eq(status_of(var c, 0x200B, [0, 16, 0, 16, 0, 0, 0]), 0x0C)
    test.assert_eq(status_of(var c, 0x200C, [1, 0]), 0x0C)
    var d = fresh()
    test.assert_eq(status_of(var d, 0x200B, [0, 16, 0, 16, 0, 0, 0]), 0)
    test.assert_eq(status_of(var d, 0x2041, [0, 0, 1, 0, 16, 0, 16, 0]), 0x0C)
    test.assert_eq(status_of(var d, 0x2042, [1, 0, 0, 0, 0, 0]), 0x0C)
    // A Reset clears the family.
    test.assert_eq(status_of(var d, 0x0C03, []), 0)
    test.assert_eq(status_of(var d, 0x2041, [0, 0, 1, 0, 16, 0, 16, 0]), 0)
    // Filter_Duplicates 3, Enable 2, a Period with no Duration and a Duration that is not shorter than the Period.
    test.assert_eq(status_of(var d, 0x2042, [1, 3, 0, 0, 0, 0]), 0x12)
    test.assert_eq(status_of(var d, 0x2042, [2, 0, 0, 0, 0, 0]), 0x12)
    test.assert_eq(status_of(var d, 0x2042, [1, 0, 0, 0, 1, 0]), 0x12)
    test.assert_eq(status_of(var d, 0x2042, [1, 0, 200, 0, 1, 0]), 0x12)
    test.assert_eq(status_of(var d, 0x2042, [1, 0, 100, 0, 1, 0]), 0)
    // Parameters while scanning are Command Disallowed.
    test.assert_eq(status_of(var d, 0x2041, [0, 0, 1, 0, 16, 0, 16, 0]), 0x0C)
    test.assert_eq(status_of(var d, 0x2042, [0, 0, 0, 0, 0, 0]), 0)

@test
fn test_the_supported_commands_name_the_extended_scan_commands_by_their_bits_in_octet_37()
    var c = fresh()
    send(var c, 0x1002, [])
    let _ran = ctl_hci.ctl_step(var c)
    let r = drain(var c)
    // The event: indicator, code, length, credits, opcode (2), status, then the 64 octets.
    let base = 7
    test.assert_eq((r[base + 37] >>> 5) & 7, 7)
    // Octet 38 bit 0 is LE Periodic Advertising Create Sync, which a build with periodic advertising answers and one without leaves out.
    var sync_bit = 0
    if ctl_limits.per_on()
        sync_bit = 1
    test.assert_eq(r[base + 38] & 1, sync_bit)

@test
fn test_an_extended_scan_with_a_duration_ends_with_the_scan_timeout_event_and_one_with_a_period_goes_on()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    test.assert_eq(status_of(var c, 0x2001, [0xFF, 0xFF, 0x3F, 0, 0, 0, 0, 0]), 0)
    test.assert_eq(status_of(var c, 0x2041, [0, 0, 1, 0, 16, 0, 16, 0]), 0)
    // 20 units of 10 ms.
    test.assert_eq(status_of(var c, 0x2042, [1, 0, 20, 0, 0, 0]), 0)
    hear(var air, 2000, 37, from_peer(ll_pdu.ADV_IND, 1))
    hear(var air, 232000, 37, from_peer(ll_pdu.ADV_IND, 1))
    run(var c, var rf, var air, 300000)
    test.assert_eq(list.len(xreports(air.host)), 1)
    let t = meta_events(air.host, 0x11)
    test.assert_eq(list.len(t), 1)
    test.assert(not c.scan.enabled)
    // With a Period of one unit (1.28 s) the next period listens again and no timeout is told.
    var d = fresh()
    var rf2 = ll_air.rf_new()
    var air2 = sim_new()
    test.assert_eq(status_of(var d, 0x2001, [0xFF, 0xFF, 0x3F, 0, 0, 0, 0, 0]), 0)
    test.assert_eq(status_of(var d, 0x2041, [0, 0, 1, 0, 16, 0, 16, 0]), 0)
    test.assert_eq(status_of(var d, 0x2042, [1, 2, 20, 0, 1, 0]), 0)
    hear(var air2, 2000, 37, from_peer(ll_pdu.ADV_IND, 1))
    hear(var air2, 1282000, 37, from_peer(ll_pdu.ADV_IND, 1))
    hear(var air2, 232000, 37, from_peer(ll_pdu.ADV_IND, 1))
    run(var d, var rf2, var air2, 1400000)
    test.assert(d.scan.enabled)
    test.assert_eq(list.len(meta_events(air2.host, 0x11)), 0)
    // The advertisement at 2000 and the one in the second period are both reported (mode 2 empties the filter at each
    // period); the one at 232000 falls in the off time.
    test.assert_eq(list.len(xreports(air2.host)), 2)

// ── Extended advertising ────────────────────────────────────────────
//
// The Controller advertises with the sets the Host defines (LE Set Extended Advertising Parameters, Data and Enable).  A
// scanner or an initiator is scripted on the simulated air: the SCAN_REQ or the CONNECT_IND it sends T_IFS after the
// AUX_ADV_IND, which `react` plays after any PDU of type 7 the Controller sends and listens after.

// LE Set Extended Advertising Parameters: the properties, the interval range in units of 0.625 ms, the channel map,
// the own address type, the secondary PHY and the SID; no preference for the Tx Power, LE 1M as the primary PHY.
fn xa_params(handle: Int, props: Int, interval: Int, chmap: Int, own: Int, sphy: Int, sid: Int,
             notify: Int) -> [Int]
    var p: [Int] = [handle,
        props & 0xFF,
        props >>> 8,
        interval & 0xFF,
        (interval >>> 8) & 0xFF,
        0,
        interval & 0xFF,
        (interval >>> 8) & 0xFF,
        0,
        chmap,
        own,
        0]
    for i in 0..6
        list.push(p, 0x60 + i)
    for b in [0, 0x7F, 1, 0, sphy, sid, notify]
        list.push(p, b)
    p

// LE Set Extended Advertising Data or Scan Response Data: `op` and the data.
fn xa_data(handle: Int, op: Int, data: [Int]) -> [Int]
    var p: [Int] = [handle, op, 0, list.len(data)]
    for d in data
        list.push(p, d)
    p

// LE Set Extended Advertising Enable for one set.
fn xa_enable(on: Int, handle: Int, dur: Int, max_ev: Int) -> [Int]
    [on, 1, handle, dur & 0xFF, dur >>> 8, max_ev]

// The Controller with the Host's events enabled, one set defined by `props` and given `data` (a scan response for a
// scannable set), not yet enabled.
fn xa_set(var c: ctl_hci.Controller, handle: Int, props: Int, own: Int, sid: Int, notify: Int,
          data: [Int])
    test.assert_eq(status_of(var c, 0x2001, [0xFF, 0xFF, 0x3F, 0, 0, 0, 0, 0]), 0)
    test.assert_eq(status_of(var c, 0x2036, xa_params(handle, props, 0x20, 7, own, 1, sid, notify)), 0)
    if (props & 2) != 0
        test.assert_eq(status_of(var c, 0x2038, xa_data(handle, 3, data)), 0)
    else if list.len(data) > 0
        test.assert_eq(status_of(var c, 0x2037, xa_data(handle, 3, data)), 0)

// The k-th PDU the Controller sent, as a `Pdu`.
fn tx_pdu(air: SimAir, k: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    let body = air.tx_body[k]
    for j in 0..list.len(body)
        p.b[j] = body[j] as u8
    sim_set_n(var p, list.len(body))
    p

// The indexes of the PDUs of type `ty` the Controller sent.
fn tx_of(var air: SimAir, ty: Int) -> [Int]
    var out: [Int] = []
    for i in 0..list.len(air.tx_t)
        if air.tx_ty[i] == ty
            list.push(out, i)
    out

@when(noble_controller.CONFIG.CTL_ADV_SETS > 0)
@test
fn test_an_extended_event_sends_an_adv_ext_ind_on_each_channel_and_the_aux_adv_ind_where_they_point()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    xa_set(var c, 1, 0, 0, 5, 0, [2, 1, 6, 3, 9, 0x41, 0x42])
    test.assert_eq(status_of(var c, 0x2039, xa_enable(1, 1, 0, 0)), 0)
    run(var c, var rf, var air, 120000)
    let pdus = tx_of(var air, 7)
    test.assert(list.len(pdus) >= 8)
    // The first event: ADV_EXT_IND on 37, 38, 39 and the AUX_ADV_IND.
    test.assert_eq(air.tx_ch[pdus[0]], 37)
    test.assert_eq(air.tx_ch[pdus[1]], 38)
    test.assert_eq(air.tx_ch[pdus[2]], 39)
    let aux_ch = air.tx_ch[pdus[3]]
    test.assert(aux_ch >= 0 and aux_ch <= 36)
    var ext = tx_pdu(air, pdus[0])
    let x0 = ll_ext.ext_parse(var ext)
    test.assert(x0.ok)
    test.assert_eq(x0.adva, -1)
    test.assert_eq(ll_ext.adi_sid(var ext, x0.adi), 5)
    test.assert_eq(ll_init.aux_channel(var ext, x0.aux), aux_ch)
    test.assert_eq(ll_init.aux_phy_of(var ext, x0.aux), ll_phy.PHY_1M)
    // Every ADV_EXT_IND points to the instant the AUX_ADV_IND starts, and the offsets are multiples of 30 microseconds.
    for k in 0..3
        var e = tx_pdu(air, pdus[k])
        let x = ll_ext.ext_parse(var e)
        let off = ll_init.aux_offset_us(var e, x.aux)
        test.assert_eq(air.tx_t[pdus[k]] + off, air.tx_t[pdus[3]])
        test.assert_eq(off % 30, 0)
        test.assert_eq(ll_ext.adi_did(var e, x.adi), ll_ext.adi_did(var ext, x0.adi))
    test.assert_eq(air.tx_t[pdus[1]] - air.tx_t[pdus[0]], 540)
    test.assert_eq(air.tx_t[pdus[2]] - air.tx_t[pdus[1]], 540)
    // The AUX_ADV_IND: the AdvA, the ADI and the data, no pointer.
    var aux = tx_pdu(air, pdus[3])
    let xa = ll_ext.ext_parse(var aux)
    test.assert(xa.ok)
    test.assert_eq(xa.aux, -1)
    test.assert_eq(aux.b[xa.adva] as Int, 0x10)
    test.assert_eq(ll_pdu.pdu_tx_add(var aux), 0)
    test.assert_eq(xa.data_len, 7)
    test.assert_eq(aux.b[xa.data_at + 6] as Int, 0x42)
    test.assert_eq(ll_ext.adi_did(var aux, xa.adi), ll_ext.adi_did(var ext, x0.adi))
    // Nothing is listened for after a non-connectable, non-scannable set's PDUs.
    test.assert_eq(air.tx_n[pdus[3]], aux.n)
    // The start error of every PDU is nil, and the events are an interval (20 ms) apart or more.
    test.assert_eq(rf.x_adv_err_min_us, 0)
    test.assert_eq(rf.x_adv_err_max_us, 0)
    test.assert_eq(rf.ramp_timeouts, 0)
    test.assert(air.tx_t[pdus[4]] - air.tx_t[pdus[0]] >= 20000)
    test.assert(air.tx_t[pdus[4]] - air.tx_t[pdus[0]] <= 30500)
    // The Data ID stays the same from event to event while the data does, and a new data takes a new one.
    var again = tx_pdu(air, pdus[4])
    test.assert_eq(ll_ext.adi_did(var again, ll_ext.ext_parse(var again).adi), ll_ext.adi_did(var ext, x0.adi))
    test.assert_eq(air.holds, air.releases)
    test.assert_eq(air.cfg_aa, ll_radio.ADV_ACCESS_ADDRESS)

@when(noble_controller.CONFIG.CTL_ADV_SETS > 0)
@test
fn test_an_advertising_data_of_251_octets_goes_in_an_aux_adv_ind_and_a_chain_pdu_where_the_pointer_says()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    xa_set(var c, 1, 0, 0, 2, 0, [])
    test.assert_eq(status_of(var c, 0x2037, xa_data(1, 1, count_from(0, 100))), 0)
    test.assert_eq(status_of(var c, 0x2037, xa_data(1, 0, count_from(100, 100))), 0)
    test.assert_eq(status_of(var c, 0x2037, xa_data(1, 2, count_from(200, 51))), 0)
    test.assert_eq(status_of(var c, 0x2039, xa_enable(1, 1, 0, 0)), 0)
    run(var c, var rf, var air, 15000)
    let pdus = tx_of(var air, 7)
    test.assert_eq(list.len(pdus), 5)
    var aux = tx_pdu(air, pdus[3])
    let xa = ll_ext.ext_parse(var aux)
    test.assert(xa.ok)
    test.assert_eq(xa.data_len, 229)
    test.assert(xa.aux >= 0)
    let ch = ll_init.aux_channel(var aux, xa.aux)
    let off = ll_init.aux_offset_us(var aux, xa.aux)
    // The chain PDU is on the channel and at the time of the pointer, 300 microseconds or more after the end of the AUX_ADV_IND.
    var chain = tx_pdu(air, pdus[4])
    test.assert_eq(air.tx_ch[pdus[4]], ch)
    test.assert_eq(air.tx_t[pdus[4]], air.tx_t[pdus[3]] + off)
    test.assert(off - ll_phy.air_us(1, true, aux.n) >= 300)
    let xc = ll_ext.ext_parse(var chain)
    test.assert(xc.ok)
    test.assert_eq(xc.data_len, 22)
    test.assert_eq(xc.aux, -1)
    test.assert_eq(chain.b[xc.data_at] as Int, 229)
    test.assert_eq(ll_ext.adi_did(var chain, xc.adi), ll_ext.adi_did(var aux, xa.adi))
    // The 229 + 22 octets are the 251 given.
    test.assert_eq(aux.b[xa.data_at + 228] as Int, 228)
    test.assert_eq(rf.x_adv_chain, 1)

@when(noble_controller.CONFIG.CTL_ADV_SETS > 0)
@test
fn test_a_scannable_set_answers_a_scan_request_with_the_scan_response_and_its_chain_and_tells_the_host()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    xa_set(var c, 2, 2, 0, 7, 1, count_from(0, 251))
    test.assert_eq(status_of(var c, 0x2039, xa_enable(1, 2, 0, 0)), 0)
    react(var air, 7, -1, scan_req(), 1)
    run(var c, var rf, var air, 60000)
    let pdus = tx_of(var air, 7)
    test.assert(list.len(pdus) >= 6)
    // The AUX_ADV_IND carries no data and is scannable (AdvMode 2).
    var aux = tx_pdu(air, pdus[3])
    let xa = ll_ext.ext_parse(var aux)
    test.assert_eq(xa.mode, 2)
    test.assert_eq(xa.data_len, 0)
    // The request is answered T_IFS after it, on the same channel: the AUX_SCAN_RSP with AdvA, 229 octets and a pointer.
    test.assert_eq(count_tx(var air, ll_pdu.SCAN_REQ), 0)
    let rsp_at = pdus[4]
    test.assert_eq(air.tx_ch[rsp_at], air.tx_ch[pdus[3]])
    let req_end = air.tx_t[pdus[3]] + ll_phy.air_us(1, true, aux.n) + T_IFS + ll_phy.air_us(1, true, scan_req().n)
    test.assert_eq(air.tx_t[rsp_at], req_end + T_IFS)
    var rsp = tx_pdu(air, rsp_at)
    let xr = ll_ext.ext_parse(var rsp)
    test.assert(xr.ok)
    test.assert_eq(xr.adva, 4)
    test.assert_eq(rsp.b[4] as Int, 0x10)
    test.assert_eq(xr.data_len, 229)
    test.assert(xr.aux >= 0)
    // The chain PDU of the response is where the pointer says.
    var chain = tx_pdu(air, pdus[5])
    test.assert_eq(air.tx_ch[pdus[5]], ll_init.aux_channel(var rsp, xr.aux))
    test.assert_eq(air.tx_t[pdus[5]], air.tx_t[rsp_at] + ll_init.aux_offset_us(var rsp, xr.aux))
    test.assert_eq(ll_ext.ext_parse(var chain).data_len, 22)
    test.assert_eq(rf.spec_aborts, 0)
    test.assert_eq(rf.rsp_sent, 1)
    test.assert_eq(c.adv.scan_reqs, 1)
    // LE Scan Request Received: the handle of the set, the scanner's type and address.
    let ev = meta_events(air.host, 0x13)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 2)
    test.assert_eq(ev[0][5], 0)
    test.assert_eq(ev[0][6], 0x40)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_a_connectable_set_answers_a_connection_request_and_the_connection_opens_with_the_extended_window()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    xa_set(var c, 3, 1, 0, 1, 0, [2, 1, 6])
    test.assert_eq(status_of(var c, 0x2039, xa_enable(1, 3, 0, 0)), 0)
    air.central = true
    react(var air, 7, -1, connect_ind(), 1)
    run(var c, var rf, var air, 300000)
    test.assert_eq(rf.conn_open, 1)
    test.assert(c.links[0].live)
    test.assert(not c.links[0].central)
    test.assert(c.links[0].csa2)
    // The response: an AUX_CONNECT_RSP (type 8) T_IFS after the request, with the AdvA and the TargetA, the initiator's.
    let rsps = tx_of(var air, 8)
    test.assert_eq(list.len(rsps), 1)
    var rsp = tx_pdu(air, rsps[0])
    let x = ll_ext.ext_parse(var rsp)
    test.assert(x.ok)
    test.assert_eq(rsp.b[x.adva] as Int, 0x10)
    test.assert_eq(rsp.b[x.targeta] as Int, 0x40)
    test.assert_eq(rsp.b[x.targeta + 5] as Int, 0x45)
    test.assert_eq(ll_pdu.pdu_rx_add(var rsp), 1)
    let pdus = tx_of(var air, 7)
    let aux = pdus[3]
    let req_end = air.tx_t[aux] + ll_phy.air_us(1, true, air.tx_n[aux]) + T_IFS + ll_phy.air_us(1, true, connect_ind().n)
    test.assert_eq(air.tx_t[rsps[0]], req_end + T_IFS)
    // The first connection event is 2.5 ms after the end of the request, plus the transmit window offset (0) and half... the
    // window opens there: the Peripheral listens from then, so its first answer is after that.
    let d = first_data_tx(var air)
    test.assert(d >= 0)
    test.assert(air.tx_t[d] >= req_end + 2500)
    // The set ended with a connection: LE Advertising Set Terminated, Status Success, the set and the connection.
    let ev = meta_events(air.host, 0x12)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0)
    test.assert_eq(ev[0][5], 3)
    test.assert_eq(ev[0][6] | (ev[0][7] << 8), 1)
    test.assert_eq(count_tx(var air, 7), 4)
    // The set is off: no PDU of it is sent after the connection began.
    test.assert(not c.xsets[0].on)

@when(noble_controller.CONFIG.CTL_ADV_SETS > 0)
@test
fn test_a_set_ends_after_its_events_or_its_duration_with_advertising_set_terminated()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    xa_set(var c, 1, 0, 0, 1, 0, [1, 2, 3])
    test.assert_eq(status_of(var c, 0x2039, xa_enable(1, 1, 0, 3)), 0)
    run(var c, var rf, var air, 200000)
    // Three events of four PDUs.
    test.assert_eq(count_tx(var air, 7), 12)
    let ev = meta_events(air.host, 0x12)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0x43)
    test.assert_eq(ev[0][5], 1)
    test.assert_eq(ev[0][8], 3)
    test.assert(not c.xsets[0].on)
    // A Duration of 100 ms: the status is Advertising Timeout.
    var d = fresh()
    var rf2 = ll_air.rf_new()
    var air2 = sim_new()
    xa_set(var d, 4, 0, 0, 1, 0, [1])
    test.assert_eq(status_of(var d, 0x2039, xa_enable(1, 4, 10, 0)), 0)
    run(var d, var rf2, var air2, 400000)
    let ev2 = meta_events(air2.host, 0x12)
    test.assert_eq(list.len(ev2), 1)
    test.assert_eq(ev2[0][4], 0x3C)
    test.assert(count_tx(var air2, 7) >= 8)
    test.assert(count_tx(var air2, 7) <= 24)
    let last = air2.tx_t[list.len(air2.tx_t) - 1]
    test.assert(last < 100000 + 1000)

@when(noble_controller.CONFIG.CTL_ADV_SETS >= 2)
@test
fn test_two_sets_take_turns_and_each_event_is_whole()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    xa_set(var c, 1, 0, 0, 3, 0, [1])
    test.assert_eq(status_of(var c, 0x2036, xa_params(2, 0, 0x20, 7, 0, 1, 9, 0)), 0)
    test.assert_eq(status_of(var c, 0x2037, xa_data(2, 3, [2])), 0)
    test.assert_eq(status_of(var c, 0x2039, [1, 2, 1, 0, 0, 0, 2, 0, 0, 0]), 0)
    run(var c, var rf, var air, 120000)
    let pdus = tx_of(var air, 7)
    test.assert(list.len(pdus) >= 16)
    // Events of the two sets alternate: four PDUs of one set (SIDs 3 and 9 in the ADV_EXT_IND), then four of the other,
    // never mixed, and the starts are apart by the length of an event or more.
    var seen3 = 0
    var seen9 = 0
    for e in 0..4
        var p = tx_pdu(air, pdus[e * 4])
        let sid = ll_ext.adi_sid(var p, ll_ext.ext_parse(var p).adi)
        if sid == 3
            seen3 = seen3 + 1
        if sid == 9
            seen9 = seen9 + 1
        for j in 1..3
            var q = tx_pdu(air, pdus[e * 4 + j])
            test.assert_eq(ll_ext.adi_sid(var q, ll_ext.ext_parse(var q).adi), sid)
        test.assert(air.tx_t[pdus[e * 4 + 4]] - air.tx_t[pdus[e * 4]] > 2000)
    test.assert(seen3 >= 1)
    test.assert(seen9 >= 1)
    test.assert_eq(rf.x_adv_err_max_us, 0)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_a_set_of_legacy_pdus_runs_on_the_legacy_advertiser_and_ends_with_a_set_event()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    test.assert_eq(status_of(var c, 0x2001, [0xFF, 0xFF, 0x3F, 0, 0, 0, 0, 0]), 0)
    // ADV_IND through the extended commands (properties 0x13): a scan response is required before it is enabled.
    test.assert_eq(status_of(var c, 0x2036, xa_params(1, 0x13, 0x20, 7, 0, 1, 0, 0)), 0)
    test.assert_eq(status_of(var c, 0x2037, xa_data(1, 3, [2, 1, 6, 3, 9, 0x41])), 0)
    test.assert_eq(status_of(var c, 0x2039, xa_enable(1, 1, 0, 0)), 0x0C)
    test.assert_eq(status_of(var c, 0x2038, xa_data(1, 3, [2, 9, 0x42])), 0)
    test.assert_eq(status_of(var c, 0x2039, xa_enable(1, 1, 0, 0)), 0)
    react(var air, ll_pdu.ADV_IND, 38, scan_req(), 1)
    run(var c, var rf, var air, 3000)
    // The legacy PDUs of the legacy advertiser: ADV_IND on the channels, and the scan response to the request on 38.
    test.assert_eq(air.tx_ty[0], ll_pdu.ADV_IND)
    test.assert_eq(air.tx_ch[0], 37)
    test.assert_eq(count_tx(var air, 7), 0)
    test.assert_eq(count_tx(var air, ll_pdu.SCAN_RSP), 1)
    test.assert_eq(air.tx_body[0][8], 2)
    test.assert_eq(air.tx_body[0][13], 0x41)
    test.assert_eq(rf.rsp_sent, 1)

@when(noble_controller.CONFIG.CTL_ADV_SETS > 0)
@test
fn test_the_extended_advertising_commands_check_their_parameters_and_the_state()
    var c = fresh()
    // The count of sets and the longest data.
    send(var c, 0x203B, [])
    let _a = ctl_hci.ctl_step(var c)
    let r = drain(var c)
    test.assert_eq(r[6], 0)
    test.assert_eq(r[7], noble_controller.CONFIG.CTL_ADV_SETS)
    send(var c, 0x203A, [])
    let _b = ctl_hci.ctl_step(var c)
    let m = drain(var c)
    test.assert_eq(m[7] | (m[8] << 8), noble_controller.CONFIG.CTL_ADV_DATA)
    // Parameters: the Selected_Tx_Power comes back; a bad value is Invalid HCI Command Parameters, LE Coded Unsupported Feature.
    send(var c, 0x2036, xa_params(1, 0, 0x20, 7, 0, 1, 5, 0))
    let _c = ctl_hci.ctl_step(var c)
    let t = drain(var c)
    test.assert_eq(t[6], 0)
    test.assert_eq(t[7], 0)
    test.assert_eq(status_of(var c, 0x2036, xa_params(1, 0x0080, 0x20, 7, 0, 1, 5, 0)), 0x12)
    test.assert_eq(status_of(var c, 0x2036, xa_params(1, 0x0003, 0x20, 7, 0, 1, 5, 0)), 0x12)
    test.assert_eq(status_of(var c, 0x2036, xa_params(1, 0, 0x10, 7, 0, 1, 5, 0)), 0x12)
    test.assert_eq(status_of(var c, 0x2036, xa_params(1, 0, 0x20, 0, 0, 1, 5, 0)), 0x12)
    ctl_hci.ctl_set_coded(var c, false)
    test.assert_eq(status_of(var c, 0x2036, xa_params(1, 0, 0x20, 7, 0, 3, 5, 0)), 0x11)
    ctl_hci.ctl_set_coded(var c, true)
    test.assert_eq(status_of(var c, 0x2036, xa_params(0xF0, 0, 0x20, 7, 0, 1, 5, 0)), 0x12)
    test.assert_eq(status_of(var c, 0x2036, xa_params(1, 0, 0x20, 7, 0, 1, 5, 2)), 0x12)
    // Every set the build holds takes its handle (ctl_adv_sets, 2 by default); one more does not fit.
    for h in 2..noble_controller.CONFIG.CTL_ADV_SETS + 1
        test.assert_eq(status_of(var c, 0x2036, xa_params(h, 0, 0x20, 7, 0, 1, 6, 0)), 0)
    test.assert_eq(status_of(var c, 0x2036, xa_params(noble_controller.CONFIG.CTL_ADV_SETS + 1, 0, 0x20, 7, 0, 1, 7, 0)), 0x07)
    // Data: an unknown handle, an Operation out of order, a length that does not fit the command.
    test.assert_eq(status_of(var c, 0x2037, xa_data(9, 3, [1])), 0x42)
    test.assert_eq(status_of(var c, 0x2037, xa_data(1, 2, [1])), 0x0C)
    test.assert_eq(status_of(var c, 0x2037, xa_data(1, 5, [1])), 0x12)
    test.assert_eq(status_of(var c, 0x2037, [1, 3, 0, 5, 1, 2]), 0x12)
    test.assert_eq(status_of(var c, 0x2037, xa_data(1, 3, [1, 2, 3])), 0)
    // A non-scannable set takes the scan response command only to discard data (Operation 3, length zero), which is what
    // the Host sends for a set without scan response data; any data is Invalid HCI Command Parameters.
    test.assert_eq(status_of(var c, 0x2038, xa_data(1, 3, [])), 0)
    test.assert_eq(status_of(var c, 0x2038, xa_data(1, 3, [1])), 0x12)
    test.assert_eq(status_of(var c, 0x2038, xa_data(1, 1, [])), 0x12)
    // Enable: no sets with Enable 1, an unknown handle, the same handle twice.
    test.assert_eq(status_of(var c, 0x2039, [1, 0]), 0x12)
    test.assert_eq(status_of(var c, 0x2039, xa_enable(1, 9, 0, 0)), 0x42)
    test.assert_eq(status_of(var c, 0x2039, [1, 2, 1, 0, 0, 0, 1, 0, 0, 0]), 0x12)
    // Set Advertising Set Random Address, and a random address for an Own_Address_Type that needs it.
    test.assert_eq(status_of(var c, 0x2035, [9, 1, 2, 3, 4, 5, 0xC6]), 0x42)
    test.assert_eq(status_of(var c, 0x2036, xa_params(1, 0, 0x20, 7, 1, 1, 5, 0)), 0)
    test.assert_eq(status_of(var c, 0x2039, xa_enable(1, 1, 0, 0)), 0x12)
    test.assert_eq(status_of(var c, 0x2035, [1, 1, 2, 3, 4, 5, 0xC6]), 0)
    test.assert_eq(status_of(var c, 0x2039, xa_enable(1, 1, 0, 0)), 0)
    // While it is enabled: no new parameters, no fragments, no removal, no clearing, no random address change.
    test.assert_eq(status_of(var c, 0x2036, xa_params(1, 0, 0x20, 7, 0, 1, 5, 0)), 0x0C)
    test.assert_eq(status_of(var c, 0x2037, xa_data(1, 1, [1])), 0x0C)
    test.assert_eq(status_of(var c, 0x203C, [1]), 0x0C)
    test.assert_eq(status_of(var c, 0x203D, []), 0x0C)
    test.assert_eq(status_of(var c, 0x2035, [1, 1, 2, 3, 4, 5, 0xC6]), 0x0C)
    // The data of a running set may be replaced by a complete one.
    test.assert_eq(status_of(var c, 0x2037, xa_data(1, 3, [9])), 0)
    // The legacy advertising commands are Command Disallowed from the first extended one.
    test.assert_eq(status_of(var c, 0x2006, adv_params(0, 7)), 0x0C)
    test.assert_eq(status_of(var c, 0x2008, data31([1])), 0x0C)
    test.assert_eq(status_of(var c, 0x200A, [1]), 0x0C)
    // Disable all, remove, clear; a Reset clears the family.
    test.assert_eq(status_of(var c, 0x2039, [0, 0]), 0)
    test.assert_eq(status_of(var c, 0x203C, [1]), 0)
    test.assert_eq(status_of(var c, 0x203C, [1]), 0x42)
    test.assert_eq(status_of(var c, 0x203D, []), 0)
    test.assert_eq(status_of(var c, 0x2037, xa_data(2, 3, [1])), 0x42)
    test.assert_eq(status_of(var c, 0x0C03, []), 0)
    test.assert_eq(status_of(var c, 0x2006, adv_params(0, 7)), 0)
    test.assert_eq(status_of(var c, 0x2036, xa_params(1, 0, 0x20, 7, 0, 1, 5, 0)), 0x0C)
    // And the other way round.
    var d = fresh()
    test.assert_eq(status_of(var d, 0x2006, adv_params(0, 7)), 0)
    test.assert_eq(status_of(var d, 0x2036, xa_params(1, 0, 0x20, 7, 0, 1, 5, 0)), 0x0C)
    test.assert_eq(status_of(var d, 0x203D, []), 0x0C)

@when(noble_controller.CONFIG.CTL_ADV_SETS > 0)
@test
fn test_the_supported_commands_name_the_extended_advertising_commands_by_their_bits_in_octets_36_and_37()
    var c = fresh()
    send(var c, 0x1002, [])
    let _ran = ctl_hci.ctl_step(var c)
    let r = drain(var c)
    let base = 7
    // 0x2035 to 0x203B are octet 36 bits 1 to 7, 0x203C and 0x203D octet 37 bits 0 and 1, then the scan commands and
    // LE Extended Create Connection at bits 5 to 7.
    test.assert_eq(r[base + 36] & 0xFE, 0xFE)
    test.assert_eq(r[base + 37] & 0xE3, 0xE3)
    var bare = ctl_hci.controller_new(0)
    send(var bare, 0x203B, [])
    let _b = ctl_hci.ctl_step(var bare)
    let u = drain(var bare)
    test.assert_eq(u[6], 0x01)

// A build without advertising sets leaves the extended advertising commands out: they are not in the Supported Commands and the Controller answers
// them with Unknown HCI Command.
@when(noble_controller.CONFIG.CTL_ADV_SETS == 0)
@test
fn test_a_build_without_advertising_sets_leaves_the_extended_advertising_commands_out()
    var c = fresh()
    send(var c, 0x1002, [])
    let _ran = ctl_hci.ctl_step(var c)
    let r = drain(var c)
    let base = 7
    test.assert_eq(r[base + 36] & 0xFE, 0)
    test.assert_eq(r[base + 37] & 0x03, 0)
    for op in [0x2036, 0x2037, 0x2038, 0x2039, 0x203A, 0x203B, 0x203C, 0x203D]
        test.assert_eq(status_of(var c, op, []), 0x01)

// ── LE Coded ────────────────────────────────────────────────────────
//
// The scanner, the advertiser and the initiator on LE Coded.  A scripted packet is heard only by a receiver set to its PHY
// (`hear_phy`).  A Controller whose radio lacks LE Coded (`SimAir.coded_ok`) refuses it everywhere.

// LE Set Extended Scan Parameters for the PHYs in `phys` with the sets given, LE Set Extended Scan Enable (filter off).
fn xscan_phys(var c: ctl_hci.Controller, phys: Int, sets: [Int])
    test.assert_eq(status_of(var c, 0x2001, [0xFF, 0xFF, 0x3F, 0, 0, 0, 0, 0]), 0)
    var p: [Int] = [0, 0, phys]
    for b in sets
        list.push(p, b)
    test.assert_eq(status_of(var c, 0x2041, p), 0)
    test.assert_eq(status_of(var c, 0x2042, [1, 0, 0, 0, 0, 0]), 0)

// A scan set of the command: the type, the interval and the window in units of 0.625 ms.
fn scan_set(ty: Int, interval: Int, window: Int) -> [Int]
    [ty, interval & 0xFF, interval >>> 8, window & 0xFF, window >>> 8]

@test
fn test_a_scanner_of_le_coded_listens_on_it_and_follows_an_adv_ext_ind_to_a_secondary_channel_on_it()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    xscan_phys(var c, 4, scan_set(0, 16, 16))
    // The ADV_EXT_IND and the AUX_ADV_IND are on LE Coded (pointer PHY 2); an ADV_EXT_IND on LE 1M is not heard.
    hear_phy(var air, 2000, 37, xp(0, -1, 0x11, 2, 12, 100, 2, -200, []), 3)
    hear_phy(var air, 5000, 12, xp(0, 0x30, 0x11, 2, -1, 0, 0, -200, [1, 2, 3]), 3)
    hear_phy(var air, 32000, 37, xp(0, -1, 0x22, 2, 13, 100, 0, -200, []), 1)
    hear_phy(var air, 35000, 13, xp(0, 0x30, 0x22, 2, -1, 0, 0, -200, [9]), 1)
    run(var c, var rf, var air, 50000)
    let ev = xreports(air.host)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][14], 3)
    test.assert_eq(ev[0][15], 3)
    test.assert_eq(x_len(ev[0]), 3)
    test.assert_eq(ev[0][29], 1)
    // The receiver was set to LE Coded for the window, and for the secondary channel; the radio is back on LE 1M.
    test.assert(list.len(air.phy_log) >= 2)
    test.assert_eq(air.phy_log[0], 3)
    test.assert_eq(rf.ramp_timeouts, 0)
    test.assert_eq(c.scan.x_followed, 1)

@test
fn test_a_scanner_of_le_1m_and_le_coded_takes_turns_in_each_interval()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    // An interval of 100 ms: 30 ms on LE 1M, then 20 ms on LE Coded.
    var sets = scan_set(0, 160, 48)
    for b in scan_set(0, 160, 32)
        list.push(sets, b)
    xscan_phys(var c, 5, sets)
    hear_phy(var air, 2000, 37, from_peer(ll_pdu.ADV_IND, 2), 1)
    // Heard on LE Coded in the second window, and not on LE 1M.
    hear_phy(var air, 35000, 37, xp(0, -1, 0x11, 2, 12, 100, 2, -200, []), 3)
    hear_phy(var air, 38000, 12, xp(0, 0x30, 0x11, 2, -1, 0, 0, -200, [7, 8]), 3)
    // Packets on the PHY the window is not on go unheard: LE Coded in the LE 1M window, LE 1M in the LE Coded window.
    hear_phy(var air, 10000, 37, xp(0, -1, 0x33, 2, 14, 100, 2, -200, []), 3)
    hear_phy(var air, 13000, 14, xp(0, 0x30, 0x33, 2, -1, 0, 0, -200, [5]), 3)
    hear_phy(var air, 40000, 37, from_peer(ll_pdu.ADV_NONCONN_IND, 2), 1)
    run(var c, var rf, var air, 60000)
    let ev = xreports(air.host)
    test.assert_eq(list.len(ev), 2)
    test.assert_eq(x_et(ev[0]), 0x0013)
    test.assert_eq(ev[0][14], 1)
    test.assert_eq(ev[1][14], 3)
    test.assert_eq(ev[1][15], 3)
    test.assert_eq(x_len(ev[1]), 2)
    test.assert(rf.rx_phy == 1 or rf.rx_phy == 3)

@when(noble_controller.CONFIG.CTL_ADV_SETS > 0)
@test
fn test_a_radio_without_le_coded_refuses_it_in_every_command_that_names_it()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    air.coded_ok = false
    // The first poll asks the radio.
    run(var c, var rf, var air, 100)
    test.assert(not c.coded)
    // The LE feature set has no LE Coded PHY (bit 11) but keeps LE 2M (bit 8).
    send(var c, 0x2003, [])
    let _a = ctl_hci.ctl_step(var c)
    let f = drain(var c)
    test.assert_eq(f[8] & 0x08, 0)
    test.assert_eq(f[8] & 0x01, 0x01)
    // The commands: PHYs of the extended scan, advertising and initiating, the default PHY, a test.
    test.assert_eq(status_of(var c, 0x2041, [0, 0, 4, 0, 16, 0, 16, 0]), 0x11)
    test.assert_eq(status_of(var c, 0x2036, xa_params(1, 0, 0x20, 7, 0, 3, 5, 0)), 0x11)
    test.assert_eq(status_of(var c, 0x2031, [0, 4, 4]), 0x11)
    test.assert_eq(status_of(var c, 0x2031, [0, 3, 3]), 0)
    test.assert_eq(status_of(var c, 0x2033, [0x00, 0x03, 0x00]), 0x11)
    test.assert_eq(cmd_status(var c, 0x2043, ext_create_phys(5)), 0x11)
    // A radio that has it answers all of them.
    var d = fresh()
    var rf2 = ll_air.rf_new()
    var air2 = sim_new()
    run(var d, var rf2, var air2, 100)
    test.assert(d.coded)
    send(var d, 0x2003, [])
    let _b = ctl_hci.ctl_step(var d)
    let g = drain(var d)
    test.assert_eq(g[8] & 0x08, 0x08)
    test.assert_eq(status_of(var d, 0x2031, [0, 4, 4]), 0)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_a_set_on_le_coded_sends_every_pdu_on_it_in_the_coding_asked_and_a_connection_on_it_starts_3_75_ms_later()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    test.assert_eq(status_of(var c, 0x2001, [0xFF, 0xFF, 0x3F, 0, 0, 0, 0, 0]), 0)
    // LE Set Extended Advertising Parameters [v2]: connectable, LE Coded both primary and secondary, S=2 on the primary channels.
    var p = xa_params(3, 1, 0x20, 7, 0, 3, 1, 0)
    p[20] = 3
    list.push(p, 1)
    list.push(p, 2)
    test.assert_eq(status_of(var c, 0x207F, p), 0)
    test.assert_eq(status_of(var c, 0x2037, xa_data(3, 3, [2, 1, 6])), 0)
    test.assert_eq(status_of(var c, 0x2039, xa_enable(1, 3, 0, 0)), 0)
    air.central = true
    react(var air, 7, -1, connect_ind(), 1)
    run(var c, var rf, var air, 300000)
    let pdus = tx_of(var air, 7)
    test.assert_eq(list.len(pdus), 4)
    // The ADV_EXT_IND in S=2 on LE Coded naming the AUX_ADV_IND on LE Coded (pointer PHY 2), the AUX_ADV_IND in S=8.
    for k in 0..3
        test.assert_eq(air.tx_phy[pdus[k]], 3)
        test.assert(not air.tx_s8[pdus[k]])
    test.assert_eq(air.tx_phy[pdus[3]], 3)
    test.assert(air.tx_s8[pdus[3]])
    var ext = tx_pdu(air, pdus[0])
    let x0 = ll_ext.ext_parse(var ext)
    test.assert_eq(ll_init.aux_phy_of(var ext, x0.aux), ll_phy.PHY_CODED)
    test.assert_eq(air.tx_t[pdus[0]] + ll_init.aux_offset_us(var ext, x0.aux), air.tx_t[pdus[3]])
    // The AUX_CONNECT_RSP is in the coding of the AUX_ADV_IND, and the connection is on LE Coded.
    let rsps = tx_of(var air, 8)
    test.assert_eq(list.len(rsps), 1)
    test.assert_eq(air.tx_phy[rsps[0]], 3)
    test.assert(c.links[0].live)
    test.assert_eq(c.links[0].phy, 3)
    // The transmit window opens 3.75 ms after the end of the request (36 octets in S=8).
    let req_end = air.tx_t[pdus[3]] + ll_phy.air_us(3, true, air.tx_n[pdus[3]]) + T_IFS + ll_phy.air_us(3, true, connect_ind().n)
    let d = first_data_tx(var air)
    test.assert(d >= 0)
    test.assert(air.tx_t[d] >= req_end + 3750)
    test.assert(air.tx_t[d] < req_end + 3750 + 3000)
    test.assert_eq(rf.ramp_timeouts, 0)

@when(noble_controller.CONFIG.CTL_ADV_SETS >= 2)
@test
fn test_the_parameters_of_a_set_on_le_coded_and_its_options_are_checked()
    var c = fresh()
    var p = xa_params(1, 0, 0x20, 7, 0, 3, 5, 0)
    // [v2]: the options are 0, 1 or 2.
    var ok = xa_params(1, 0, 0x20, 7, 0, 3, 5, 0)
    list.push(ok, 0)
    list.push(ok, 2)
    test.assert_eq(status_of(var c, 0x207F, ok), 0)
    var bad = xa_params(1, 0, 0x20, 7, 0, 3, 5, 0)
    list.push(bad, 3)
    list.push(bad, 0)
    test.assert_eq(status_of(var c, 0x207F, bad), 0x12)
    // [v2] needs its 27 octets.
    test.assert_eq(status_of(var c, 0x207F, p), 0x12)
    send(var c, 0x1002, [])
    let _r = ctl_hci.ctl_step(var c)
    let r = drain(var c)
    test.assert_eq((r[7 + 46] >>> 2) & 1, 1)
    // The primary PHY LE Coded with the secondary on LE 1M is a set as well.
    var mixed = xa_params(2, 0, 0x20, 7, 0, 1, 6, 0)
    mixed[20] = 3
    test.assert_eq(status_of(var c, 0x2036, mixed), 0)
    // A legacy set is on LE 1M.
    var legacy = xa_params(1, 0x13, 0x20, 7, 0, 1, 0, 0)
    legacy[20] = 3
    test.assert_eq(status_of(var c, 0x2036, legacy), 0x12)

// LE Extended Create Connection to the device 0x30..0x35 for the PHYs `phys` with a set of scan interval, window and connection
// parameters for each PHY named in the order of the bits (LE 2M has none of the scan values read).
fn ext_create_phys(phys: Int) -> [Int]
    var p: [Int] = [0, 0, 0]
    for i in 0..6
        list.push(p, 0x30 + i)
    list.push(p, phys)
    for k in 0..3
        if (phys & (1 << k)) != 0
            for b in ext_set(24, 24, 200)
                list.push(p, b)
    p

@when(noble_controller.CONFIG.CTL_CENTRAL > 0)
@test
fn test_the_initiator_follows_a_connectable_adv_ext_ind_on_le_coded_and_connects_on_it()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    ext_start(var c, var air, ext_create_phys(4))
    // The advertiser: ADV_EXT_IND on LE Coded, the AUX_ADV_IND on LE Coded 3 ms after it, the AUX_CONNECT_RSP.
    hear_phy(var air, 2000, 37, ext_pdu(7, 1, 0x18, 0, 0, 12, 100, 2), 3)
    hear_phy(var air, 5000, 12, ext_pdu(7, 1, 0x09, 0x30, 0x10, 0, 0, 0), 3)
    react(var air, 5, 12, ext_pdu(8, 0, 0x03, 0x30, 0x10, 0, 0, 0), 1)
    run(var c, var rf, var air, 300000)
    test.assert_eq(c.init.aux_followed, 1)
    test.assert_eq(c.init.aux_connects, 1)
    test.assert(c.links[0].live)
    test.assert(c.links[0].central)
    test.assert_eq(c.links[0].phy, 3)
    // The request is sent T_IFS after the AUX_ADV_IND on LE Coded in S=8, with the connection parameters of the set of LE Coded.
    let k = last_tx_of(var air, 5)
    test.assert(k >= 0)
    test.assert_eq(air.tx_ch[k], 12)
    test.assert_eq(air.tx_phy[k], 3)
    test.assert(air.tx_s8[k])
    test.assert_eq(air.tx_t[k], 5000 + ll_phy.air_us(3, true, 12) + 150)
    test.assert_eq(air.tx_body[k][24], 24)
    // The first connection event is due 3.75 ms after the end of the request.
    let d = first_data_tx(var air)
    test.assert_eq(air.tx_t[d], air.tx_t[k] + ll_phy.air_us(3, true, 36) + 3750)

@when(noble_controller.CONFIG.CTL_CENTRAL > 0)
@test
fn test_an_initiator_of_le_1m_and_le_coded_scans_on_both_and_connects_on_the_one_it_hears()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    ext_start(var c, var air, ext_create_phys(5))
    // The windows of 16 units each take turns in the interval of 16: 5 ms on each.  The advertiser is on LE Coded, in the second one.
    hear_phy(var air, 7000, 37, ext_pdu(7, 1, 0x18, 0, 0, 12, 100, 2), 3)
    hear_phy(var air, 10000, 12, ext_pdu(7, 1, 0x09, 0x30, 0x10, 0, 0, 0), 3)
    react(var air, 5, 12, ext_pdu(8, 0, 0x03, 0x30, 0x10, 0, 0, 0), 1)
    run(var c, var rf, var air, 300000)
    test.assert_eq(c.init.aux_followed, 1)
    test.assert(c.links[0].live)
    test.assert_eq(c.links[0].phy, 3)
    test.assert_eq(rf.cen_aborts, 0)

// ── Framed PDUs ──────────────────────────────────────────────────────

// The stream the Central asks for with framed PDUs: SDUs of 60 octets from the Central and 50 from the Peripheral every 10 ms in an ISO
// interval of 7.5 ms, so the two do not divide; PDUs as long as the bandwidth rule of Part G, Section 2.2 asks.  The ACL interval of the
// tests, 30 ms, is four ISO intervals.
fn cis_central_framed(cis_id: Int) -> ll_iso.Cis
    var x = cis_central(cis_id)
    t_set(var x, "framed", 1)
    t_set(var x, "iso_int", 6)
    t_set(var x, "max_pdu_c", ll_iso.framed_pdu(60, 10000, 7500))
    t_set(var x, "max_pdu_p", ll_iso.framed_pdu(50, 10000, 7500))
    x

// LE Set CIG Parameters Test for the group 1 with framed PDUs: SDU intervals of 10 ms, an ISO interval of 7.5 ms, one stream (CIS_ID 2)
// of three subevents, the PDU sizes the rule asks for, one payload an event each way.
fn cig_test_framed() -> [Int]
    cig_test_framed_with(6, 3, 1, ll_iso.framed_pdu(60, 10000, 7500), ll_iso.framed_pdu(50, 10000, 7500))

// The same with the ISO interval in units of 1.25 ms, NSE, BN (both ways) and the two PDU sizes given.
fn cig_test_framed_with(iso: Int, nse: Int, bn: Int, pdu_c: Int, pdu_p: Int) -> [Int]
    var p: [Int] = [1, 0x10, 0x27, 0, 0x10, 0x27, 0, 1, 1, iso, 0, 0, 0, 1, 1]
    for b in [2, nse, 60, 0, 50, 0, pdu_c, 0, pdu_p, 0, 3, 3, bn, bn]
        list.push(p, b)
    p

// The SDUs that reached the Host as HCI ISO Data packets: valid, of `len` octets, in sequence with no gap, and with Time_Stamps that
// run at the SDU interval exactly (the SDUs of the other end arrive on a clock of that interval, and a Time_Offset puts each back at
// its place).  The answer is how many there were.
fn framed_host_sdus_in_order(pk: [[Int]], len: Int, sdu_int: Int) -> Int
    var seq = pk[0][9] | (pk[0][10] << 8)
    var ts = pk[0][5] | (pk[0][6] << 8) | (pk[0][7] << 16) | (pk[0][8] << 24)
    var first = true
    for e in pk
        test.assert_eq(e[3] | ((e[4] & 0x3F) << 8), 8 + len)
        test.assert_eq(e[9] | (e[10] << 8), seq)
        let flag = e[11] | (e[12] << 8)
        test.assert_eq(flag >>> 14, 0)
        test.assert_eq(flag & 0x0FFF, len)
        test.assert_eq(e[13] | (e[14] << 8), seq & 0xFFFF)
        let t = e[5] | (e[6] << 8) | (e[7] << 16) | (e[8] << 24)
        if not first
            test.assert_eq(t - ts, sdu_int)
        first = false
        ts = t
        seq = seq + 1
    list.len(pk)

@test
fn test_a_framed_peripheral_stream_carries_sdus_whose_interval_the_iso_interval_does_not_divide()
    if not ctl_limits.iso_on() or ctl_limits.cis_slots() < 1
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    cis_connect(var c, var rf, var air)
    var x = cis_central_framed(2)
    cis_create(var c, var rf, var air, var x, false, 60, 0)
    cis_run(var c, var rf, var air, 1700000, 4, 50)
    test.assert_eq(c.cis[0].state, ll_iso.S_UP)
    test.assert(c.cis[0].framed)
    cis_run(var c, var rf, var air, 2700000, 0, 50)
    let est = meta_events(air.host, 0x2A)
    test.assert_eq(list.len(est), 1)
    test.assert_eq(est[0][4], 0)
    // The latency of a framed direction adds the SDU interval: CIG_Sync_Delay 4000, one ISO interval of 7500, and 10000.
    test.assert_eq(est[0][13] | (est[0][14] << 8) | (est[0][15] << 16), 21500)
    test.assert_eq(est[0][16] | (est[0][17] << 8) | (est[0][18] << 16), 21500)
    test.assert_eq(est[0][26] | (est[0][27] << 8), ll_iso.framed_pdu(60, 10000, 7500))
    test.assert_eq(est[0][30] | (est[0][31] << 8), 6)
    test.assert_eq(est[0][45], 1)
    // The Central's SDUs reached the Host whole and in order; about 100 SDUs of 10 ms in the second the run has had.
    let pk = iso_packets(air.host)
    test.assert(framed_host_sdus_in_order(pk, 60, 10000) >= 90)
    // The Host's SDUs reached the Central's model whole, in order, valid.
    var got = 0
    var k = 0
    var want = air.cis_rx[1]
    while k + 4 < list.len(air.cis_rx)
        test.assert_eq(air.cis_rx[k + 1], want)
        test.assert_eq(air.cis_rx[k + 2], 50)
        test.assert_eq(air.cis_rx[k + 3], ll_iso.SDU_VALID)
        got = got + 1
        want = want + 1
        k = k + 5
    test.assert(got >= 90)
    test.assert_eq(c.cis[0].n_flush_tx, 0)
    test.assert_eq(c.cis[0].n_flush_rx, 0)
    test.assert_eq(c.cis[0].n_host_drop, 0)
    test.assert_eq(c.cis[0].n_sdu_lost, 0)
    test.assert_eq(rf.cis_aborts, 0)
    test.assert_eq(rf.cis_bad, 0)
    test.assert_eq(rf.tifs_min_ns, 150000)
    test.assert_eq(rf.tifs_max_ns, 150000)
    test.assert_eq(air.holds, air.releases)
    test.assert(c.links[0].live)

// The stream the Central asks for with framed PDUs in Unsegmented mode: the same SDUs, PDUs of whole SDUs with their 5 octets (one an
// event each way).
fn cis_central_unseg(cis_id: Int) -> ll_iso.Cis
    var x = cis_central(cis_id)
    t_set(var x, "framed", 1)
    t_set(var x, "unseg", 1)
    t_set(var x, "iso_int", 6)
    t_set(var x, "max_pdu_c", ll_iso.unseg_pdu(60, 10000, 7500))
    t_set(var x, "max_pdu_p", ll_iso.unseg_pdu(50, 10000, 7500))
    t_set(var x, "bn_c", ll_iso.unseg_bn(60, 10000, 7500))
    t_set(var x, "bn_p", ll_iso.unseg_bn(50, 10000, 7500))
    x

@test
fn test_an_unsegmented_peripheral_stream_carries_whole_sdus_with_no_framing_delay()
    if not ctl_limits.iso_on() or ctl_limits.cis_slots() < 1
        return
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    cis_connect(var c, var rf, var air)
    var x = cis_central_unseg(2)
    cis_create(var c, var rf, var air, var x, false, 60, 0)
    cis_run(var c, var rf, var air, 1700000, 4, 50)
    test.assert_eq(c.cis[0].state, ll_iso.S_UP)
    test.assert(c.cis[0].framed)
    test.assert(c.cis[0].unseg)
    cis_run(var c, var rf, var air, 2700000, 0, 50)
    let est = meta_events(air.host, 0x2A)
    test.assert_eq(list.len(est), 1)
    test.assert_eq(est[0][4], 0)
    // The latency is CIG_Sync_Delay 4000 and one ISO interval of 7500 less nothing: no SDU interval is added or taken off.
    test.assert_eq(est[0][13] | (est[0][14] << 8) | (est[0][15] << 16), 11500)
    test.assert_eq(est[0][16] | (est[0][17] << 8) | (est[0][18] << 16), 11500)
    test.assert_eq(est[0][26] | (est[0][27] << 8), ll_iso.unseg_pdu(60, 10000, 7500))
    test.assert_eq(est[0][45], 1)
    let pk = iso_packets(air.host)
    test.assert(framed_host_sdus_in_order(pk, 60, 10000) >= 90)
    var got = 0
    var k = 0
    var want = air.cis_rx[1]
    while k + 4 < list.len(air.cis_rx)
        test.assert_eq(air.cis_rx[k + 1], want)
        test.assert_eq(air.cis_rx[k + 2], 50)
        test.assert_eq(air.cis_rx[k + 3], ll_iso.SDU_VALID)
        got = got + 1
        want = want + 1
        k = k + 5
    test.assert(got >= 90)
    test.assert_eq(c.cis[0].n_flush_tx, 0)
    test.assert_eq(c.cis[0].n_flush_rx, 0)
    test.assert_eq(c.cis[0].n_sdu_lost, 0)
    test.assert_eq(rf.cis_aborts, 0)
    test.assert_eq(rf.cis_bad, 0)
    test.assert(c.links[0].live)

