// ── Extended scanning ───────────────────────────────────────────────
//
// The Controller scans with LE Set Extended Scan Parameters and Enable.  The advertiser 0x30..0x35 is scripted:
// an ADV_EXT_IND on the primary channel 37 at 2000 whose pointer names channel 12 after `offset` units of 30
// microseconds, the AUX_ADV_IND there, the AUX_CHAIN_IND its pointer names, and the AUX_SCAN_RSP the advertiser
// answers an AUX_SCAN_REQ with.

// An extended advertising PDU of the AdvMode `mode`: the AdvA 0x30.. when `adva` is not negative, the ADI (`did`,
// `sid`) when `did` is not negative, the Auxiliary Pointer to `aux_ch` after `aux_off` units on `aux_phy` when
// `aux_ch` is not negative, a Tx Power of `txp` when it is above -200, and `data`.
fn xp(mode: Int, adva: Int, did: Int, sid: Int, aux_ch: Int, aux_off: Int, aux_phy: Int, txp: Int,
      data: [Int]) -> Pdu
    var p = ll_pdu.pdu_new()
    var flags = 0
    var body: [Int] = [0]
    if adva >= 0
        flags = flags | 1
        for k in 0..6
            list.push(body, adva + k)
    if did >= 0
        flags = flags | 8
        list.push(body, did & 0xFF)
        list.push(body, ((did >>> 8) & 0x0F) | (sid << 4))
    if aux_ch >= 0
        flags = flags | 0x10
        list.push(body, aux_ch)
        list.push(body, aux_off & 0xFF)
        list.push(body, ((aux_off >>> 8) & 0x1F) | (aux_phy << 5))
    if txp > -200
        flags = flags | 0x40
        list.push(body, txp & 0xFF)
    body[0] = flags
    ll_pdu.pdu_begin(var p, 7, 0, 0)
    let _h = ll_pdu.pdu_put_data(var p, list.len(body) | (mode << 6))
    for v in body
        let _b = ll_pdu.pdu_put_data(var p, v)
    for v in data
        let _d = ll_pdu.pdu_put_data(var p, v)
    ll_pdu.pdu_finish(var p)
    p

// `n` octets of data counting up from `first`.
fn count_from(first: Int, n: Int) -> [Int]
    var d: [Int] = []
    for k in 0..n
        list.push(d, (first + k) & 0xFF)
    d

// The scanner: LE Set Extended Scan Parameters for LE 1M with the type `ty`, LE Set Extended Scan Enable with the
// duplicate filter mode `dup`.
fn xscan_on(var c: ctl_hci.Controller, ty: Int, dup: Int)
    test.assert_eq(status_of(var c, 0x2001, [0xFF, 0xFF, 0x3F, 0, 0, 0, 0, 0]), 0)
    test.assert_eq(status_of(var c, 0x2041, [0, 0, 1, ty, 16, 0, 16, 0]), 0)
    test.assert_eq(status_of(var c, 0x2042, [1, dup, 0, 0, 0, 0]), 0)

// The LE Extended Advertising Report events among the octets the Host has read.
fn xreports(bytes: [Int]) -> [[Int]]
    meta_events(bytes, 0x0D)

// The Event_Type of the report in the event `e`, and its Data_Length.  The octets of the event: the indicator, the
// code, the length, the subevent and Num_Reports, then Event_Type (5), Address_Type (7), the address (8), the PHYs
// (14, 15), the SID (16), Tx Power (17), RSSI (18), the periodic interval (19), the direct address (21 to 27),
// Data_Length (28) and the data (29).
fn x_et(e: [Int]) -> Int
    e[5] | (e[6] << 8)

fn x_len(e: [Int]) -> Int
    e[28]

@test
fn test_extended_scan_reports_an_aux_adv_ind_with_its_values_and_data()
    var c = fresh()
    var rf = ll_air.rf_new()
    var air = sim_new()
    xscan_on(var c, 0, 0)
    hear(var air, 2000, 37, xp(0, -1, 0x234, 5, 12, 100, 0, -200, []))
    hear(var air, 5000, 12, xp(0, 0x30, 0x234, 5, -1, 0, 0, -8, [2, 1, 6, 3, 9, 0x41, 0x42]))
    run(var c, var rf, var air, 20000)
    let ev = xreports(air.host)
    test.assert_eq(list.len(ev), 1)
    let e = ev[0]
    test.assert_eq(e[4], 1)
    // Neither connectable nor scannable, no scan response, extended PDU, complete data.
    test.assert_eq(x_et(e), 0)
    test.assert_eq(e[7], 0)
    test.assert_eq(e[8], 0x30)
    test.assert_eq(e[13], 0x35)
    // The primary PHY is LE 1M, the secondary LE 1M, SID 5, Tx Power -8, no periodic interval, no direct address.
    test.assert_eq(e[14], 1)
    test.assert_eq(e[15], 1)
    test.assert_eq(e[16], 5)
    test.assert_eq(e[17], 0xF8)
    test.assert_eq(e[18], 196)
    test.assert_eq(e[19] | (e[20] << 8), 0)
    test.assert_eq(e[21], 0)
    test.assert_eq(x_len(e), 7)
    test.assert_eq(e[29], 2)
    test.assert_eq(e[35], 0x42)
    test.assert_eq(c.scan.x_followed, 1)
    test.assert_eq(rf.ramp_timeouts, 0)
    // The scanner never sent a request, and the radio is set for the primary channels again.
    test.assert_eq(count_tx(var air, ll_pdu.SCAN_REQ), 0)
    test.assert_eq(air.cfg_aa, ll_radio.ADV_ACCESS_ADDRESS)
    test.assert_eq(air.phy, 1)

