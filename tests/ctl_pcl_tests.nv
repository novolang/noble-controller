// tests/ctl_pcl_tests.nv — LE Power Control as the Host and the peer see it: the opcodes of the Link Layer
// (Clock Accuracy is 0x1D/0x1E, Power Control 0x23 to 0x25), the three Host commands and the Transmit Power
// Reporting event, and the procedures of the two roles.  The Link Layer is driven by hand
// (`ctl_iso_ctrl` is given the PDUs the radio program would read from the air), so what the Controller
// queued for the peer can be read; the same procedures on a simulated air are in `ctl_air_tests.nv`.
//
// The cases run in a build with LE Power Control (`ctl_iso` or `pc` in configs/); in one without,
// the Controller answers none of the commands and the first cases say so.

use ctl_limits
use std.test
use ctl_hci
use ll_pdu
use ll_data
use ll_link
use ll_pcl
use ll_policy

// The peer told its feature octet `i` is `v` (a test sets what LL_FEATURE_RSP would).
fn t_peer_features(var l: ll_link.Link, i: Int, v: Int)
    l.have_feat = true
    l.peer_feat[i] = v as u8

// ── The Host's side ─────────────────────────────────────────────────

fn send(var c: ctl_hci.Controller, opcode: Int, params: [Int])
    ctl_hci.ctl_rx(var c, 0x01)
    ctl_hci.ctl_rx(var c, opcode & 0xFF)
    ctl_hci.ctl_rx(var c, (opcode >>> 8) & 0xFF)
    ctl_hci.ctl_rx(var c, list.len(params))
    for p in params
        ctl_hci.ctl_rx(var c, p)

fn drain(var c: ctl_hci.Controller) -> [Int]
    var out: [Int] = []
    while ctl_hci.ctl_tx_pending(var c)
        list.push(out, ctl_hci.ctl_tx_next(var c))
    out

fn run(var c: ctl_hci.Controller, opcode: Int, params: [Int]) -> [Int]
    send(var c, opcode, params)
    let _ran = ctl_hci.ctl_step(var c)
    drain(var c)

fn packets_of(bytes: [Int]) -> [[Int]]
    var out: [[Int]] = []
    var i = 0
    while i < list.len(bytes)
        var n = 0
        if bytes[i] == 0x04
            n = 3 + bytes[i + 2]
        else
            n = 5 + bytes[i + 3] + ((bytes[i + 4] & 0x3F) << 8)
        list.push(out, bytes[i:i + n])
        i = i + n
    out

fn events_coded(bytes: [Int], code: Int) -> [[Int]]
    var out: [[Int]] = []
    for e in packets_of(bytes)
        if e[0] == 0x04 and e[1] == code
            list.push(out, e[:])
    out

fn meta_events(bytes: [Int], sub: Int) -> [[Int]]
    var out: [[Int]] = []
    for e in events_coded(bytes, 0x3E)
        if e[3] == sub
            list.push(out, e[:])
    out

// The Status of the Command Complete event of a command.
fn status_of(var c: ctl_hci.Controller, opcode: Int, params: [Int]) -> Int
    let r = run(var c, opcode, params)
    let done = events_coded(r, 0x0E)
    test.assert_eq(list.len(done), 1)
    test.assert_eq(done[0][4] | (done[0][5] << 8), opcode)
    done[0][6]

// The Status of the Command Status event of a command.
fn cmd_status(var c: ctl_hci.Controller, opcode: Int, params: [Int]) -> Int
    let r = run(var c, opcode, params)
    let st = events_coded(r, 0x0F)
    test.assert_eq(list.len(st), 1)
    test.assert_eq(st[0][5] | (st[0][6] << 8), opcode)
    st[0][3]

// The Command Complete event of a command.
fn complete_of(var c: ctl_hci.Controller, opcode: Int, params: [Int]) -> [Int]
    let r = run(var c, opcode, params)
    let done = events_coded(r, 0x0E)
    test.assert_eq(list.len(done), 1)
    done[0]

fn iso_only(bytes: [Int]) -> [[Int]]
    var out: [[Int]] = []
    for e in packets_of(bytes)
        if e[0] == 0x05
            list.push(out, e[:])
    out

fn le24(v: Int) -> [Int]
    [v & 0xFF, (v >>> 8) & 0xFF, (v >>> 16) & 0xFF]

fn zeros(n: Int) -> [Int]
    var v: [Int] = []
    for _ in 0..n
        list.push(v, 0)
    v

// A Controller whose Host enabled every event and the LE events of the streams, with the Host support

fn fresh() -> ctl_hci.Controller
    var c = ctl_hci.controller_new(ctl_hci.CAP_LL)
    for i in 0..6
        ctl_hci.ctl_set_public(var c, i, 0x10 + i)
    test.assert_eq(status_of(var c, 0x0C01, [0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x3F]), 0)
    test.assert_eq(status_of(var c, 0x2001, [0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF]), 0)
    c

fn connect_ind(interval: Int, timeout: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_pdu.pdu_begin(var p, ll_pdu.CONNECT_IND, 1, 0)
    for i in 0..6
        let _a = ll_pdu.pdu_put(var p, 0x40 + i)
    for i in 0..6
        let _b = ll_pdu.pdu_put(var p, 0x10 + i)
    for b in [0x12, 0x5A, 0x65, 0x50, 0x11, 0x22, 0x33, 2]
        let _c = ll_pdu.pdu_put(var p, b)
    for v in [0, interval, 0, timeout]
        let _d = ll_pdu.pdu_put(var p, v & 0xFF)
        let _e = ll_pdu.pdu_put(var p, (v >>> 8) & 0xFF)
    for b in [0xFF, 0xFF, 0xFF, 0xFF, 0x1F, 7]
        let _f = ll_pdu.pdu_put(var p, b)
    ll_pdu.pdu_finish(var p)
    p

// A Controller with the Host support bit set and a Peripheral connection of 30 ms taken at 5000.
fn connected() -> ctl_hci.Controller
    var c = fresh()
    test.assert_eq(status_of(var c, 0x2006, [0x20, 0, 0x20, 0, 0, 0, 0, 0x70, 0x71, 0x72, 0x73, 0x74, 0x75, 7, 0]),
        0)
    test.assert_eq(status_of(var c, 0x200A, [1]), 0)
    ctl_hci.ctl_set_time(var c, 1000)
    var pol = ll_policy.default_link_policy()
    var p = connect_ind(24, 100)
    test.assert(ctl_hci.ctl_connect_ind(var c, var pol, var p, 5000))
    let _r = run(var c, 0x1001, [])
    c

fn on() -> Bool
    ctl_limits.pcl_on()

// The next LL Control PDU the Controller has for the peer on the link in slot 0: its opcode and the
// octets after it, -1 when there is none.
fn queued_op(var c: ctl_hci.Controller) -> Int
    if c.links[0].nxt_kind == ll_link.K_EMPTY
        return -1
    ll_data.dpdu_opcode(var c.links[0].nxt)

fn queued_byte(var c: ctl_hci.Controller, i: Int) -> Int
    ll_data.dpdu_byte(var c.links[0].nxt, i)

fn pop_queued(var c: ctl_hci.Controller)
    c.links[0].nxt_kind = ll_link.K_EMPTY
    ll_data.dpdu_empty(var c.links[0].nxt)

fn deliver(var c: ctl_hci.Controller, var p: Pdu)
    ctl_hci.ctl_iso_ctrl(var c, 0, var p)

fn req(mask: Int, delta: Int, level: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_pcl.put_req(var p, mask, delta, level)
    p

fn rsp(flags: Int, delta: Int, level: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_pcl.put_rsp(var p, flags, delta, level, 0xFF)
    p

fn ind(mask: Int, flags: Int, delta: Int, level: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_pcl.put_ind(var p, mask, flags, delta, level)
    p

// The handle of the connection in slot 0, as the two octets of a command.
fn hd(var c: ctl_hci.Controller) -> [Int]
    le16(c.links[0].handle)

fn le16(v: Int) -> [Int]
    [v & 0xFF, (v >>> 8) & 0xFF]

fn reports(var c: ctl_hci.Controller) -> [[Int]]
    meta_events(drain(var c), 0x21)

// ── The opcodes ─────────────────────────────────────────────────────

// The Clock Accuracy PDUs are 0x1D and 0x1E and the Power Control PDUs 0x23 to 0x25; this case fails on the values the Controller had before
// (Clock Accuracy 0x23 and 0x24), which are the Power Control opcodes.
@test
fn test_the_opcodes_of_clock_accuracy_and_power_control_are_those_of_the_specification()
    test.assert_eq(ll_data.OP_CLOCK_ACCURACY_REQ, 0x1D)
    test.assert_eq(ll_data.OP_CLOCK_ACCURACY_RSP, 0x1E)
    test.assert_eq(ll_data.OP_POWER_CONTROL_REQ, 0x23)
    test.assert_eq(ll_data.OP_POWER_CONTROL_RSP, 0x24)
    test.assert_eq(ll_data.OP_POWER_CHANGE_IND, 0x25)

// An LL_CLOCK_ACCURACY_REQ (0x1D) is answered with the 0x1E response carrying this end's class, and takes the peer's class.
@test
fn test_a_clock_accuracy_request_is_answered_with_the_response_opcode()
    var c = connected()
    var p = ll_pdu.pdu_new()
    ll_data.ctrl_begin(var p, 0x1D)
    let _a = ll_pdu.pdu_put(var p, 3)
    ll_data.dpdu_finish(var p)
    ll_link.ctrl_rx(var c.links[0], var p)
    ll_link.link_prepare(var c.links[0])
    if (ctl_limits.features_octet3() & ll_link.FEAT3_ISO) == 0
        test.assert_eq(queued_op(var c), ll_data.OP_UNKNOWN_RSP)
        return
    test.assert_eq(queued_op(var c), 0x1E)
    test.assert_eq(c.links[0].sca, 3)

// ── A build without LE Power Control ────────────────────────────────

@test
fn test_a_build_without_power_control_answers_none_of_its_commands_and_the_pdus_with_unknown_response()
    if on()
        return
    var c = connected()
    for op in [0x2076, 0x2077, 0x207A]
        let r = run(var c, op, [0, 0, 1, 0])
        let done = events_coded(r, 0x0E)
        test.assert_eq(done[0][6], ctl_hci.STATUS_UNKNOWN_COMMAND)
    test.assert_eq(ctl_limits.features_octet4() & ll_link.FEAT4_PCL, 0)
    var p = req(1, 0, 0)
    ll_link.ctrl_rx(var c.links[0], var p)
    ll_link.link_prepare(var c.links[0])
    test.assert_eq(queued_op(var c), ll_data.OP_UNKNOWN_RSP)
    test.assert_eq(queued_byte(var c, 1), 0x23)

// ── The Host's commands ─────────────────────────────────────────────

@test
fn test_the_features_and_the_commands_of_power_control_are_reported()
    if not on()
        return
    test.assert_eq(ctl_limits.features_octet4() & ll_link.FEAT4_PCL, 0x06)
    var c = fresh()
    let r = complete_of(var c, 0x1002, [])
    // Supported Commands: octet 44 has bits 3, 4 and 7; bits 5 and 6 (path loss) follow the build with path loss monitoring.
    var want = 0x98
    if ctl_limits.ploss_on()
        want = 0xD8
    test.assert_eq(r[7 + 44] & 0xD8, want)

@test
fn test_enhanced_read_reports_the_level_and_the_maximum_of_the_phy()
    if not on()
        return
    var c = connected()
    let hh = hd(var c)
    let r = complete_of(var c, 0x2076, [hh[0], hh[1], 1])
    test.assert_eq(r[6], 0)
    test.assert_eq(r[9], 1)
    test.assert_eq(r[10], 0)
    test.assert_eq(r[11], 8)
    test.assert_eq(complete_of(var c, 0x2076, [hh[0], hh[1], 0])[6], 0x12)
    test.assert_eq(complete_of(var c, 0x2076, [hh[0], hh[1], 5])[6], 0x12)
    test.assert_eq(complete_of(var c, 0x2076, [0x30, 0, 1])[6], 0x02)

@test
fn test_read_remote_sends_a_request_and_reports_the_answer_with_reason_read()
    if not on()
        return
    var c = connected()
    let hh = hd(var c)
    test.assert_eq(cmd_status(var c, 0x2077, [hh[0], hh[1], 2]), 0)
    let _s = ctl_hci.ctl_step(var c)
    test.assert_eq(queued_op(var c), ll_data.OP_POWER_CONTROL_REQ)
    test.assert_eq(queued_byte(var c, 1), 0x02)
    test.assert_eq(queued_byte(var c, 2), 0)
    // A second request while the first waits is Command Disallowed.
    test.assert_eq(cmd_status(var c, 0x2077, [hh[0], hh[1], 1]), 0x0C)
    var a = rsp(0x01, 0, -10)
    deliver(var c, var a)
    let ev = reports(var c)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][4], 0)
    test.assert_eq(ev[0][7], 2)
    test.assert_eq(ev[0][8], 2)
    test.assert_eq(ev[0][9], 0xF6)
    test.assert_eq(ev[0][10], 0x01)
    test.assert_eq(ev[0][11], 0)
    // The next one is accepted again.
    test.assert_eq(cmd_status(var c, 0x2077, [hh[0], hh[1], 1]), 0)

@test
fn test_read_remote_refuses_what_it_cannot_send()
    if not on()
        return
    var c = connected()
    let hh = hd(var c)
    test.assert_eq(cmd_status(var c, 0x2077, [hh[0], hh[1], 0]), 0x12)
    test.assert_eq(cmd_status(var c, 0x2077, [hh[0], hh[1], 5]), 0x12)
    test.assert_eq(cmd_status(var c, 0x2077, [0x30, 0, 1]), 0x02)
    // A peer that said it lacks the feature is Unsupported Remote Feature.
    t_peer_features(var c.links[0], 4, 0)
    test.assert_eq(cmd_status(var c, 0x2077, [hh[0], hh[1], 1]), 0x1A)

@test
fn test_a_refusal_of_the_request_is_reported_with_its_status_and_a_silent_peer_times_out()
    if not on()
        return
    var c = connected()
    let hh = hd(var c)
    test.assert_eq(cmd_status(var c, 0x2077, [hh[0], hh[1], 1]), 0)
    var j = ll_pdu.pdu_new()
    ll_data.ctrl_reject_ext(var j, 0x23, 0x20)
    deliver(var c, var j)
    let e1 = reports(var c)
    test.assert_eq(list.len(e1), 1)
    test.assert_eq(e1[0][4], 0x20)
    // LL_UNKNOWN_RSP naming the request is Unsupported Remote Feature.
    pop_queued(var c)
    test.assert_eq(cmd_status(var c, 0x2077, [hh[0], hh[1], 1]), 0)
    var u = ll_pdu.pdu_new()
    ll_data.ctrl_unknown_rsp(var u, 0x23)
    deliver(var c, var u)
    let e2 = reports(var c)
    test.assert_eq(list.len(e2), 1)
    test.assert_eq(e2[0][4], 0x1A)
    // A peer that never answers: the wait ends with Connection Timeout style Status 0x22.
    pop_queued(var c)
    test.assert_eq(cmd_status(var c, 0x2077, [hh[0], hh[1], 1]), 0)
    ctl_hci.ctl_set_time(var c, 5000 + ll_pcl.WAIT_US + 10)
    let _s = ctl_hci.ctl_step(var c)
    let e3 = reports(var c)
    test.assert_eq(list.len(e3), 1)
    test.assert_eq(e3[0][4], 0x22)

@test
fn test_reporting_enable_validates_and_remote_reporting_asks_the_peer_once()
    if not on()
        return
    var c = connected()
    let hh = hd(var c)
    test.assert_eq(status_of(var c, 0x207A, [hh[0], hh[1], 2, 0]), 0x12)
    test.assert_eq(status_of(var c, 0x207A, [hh[0], hh[1], 0, 2]), 0x12)
    test.assert_eq(status_of(var c, 0x207A, [0x30, 0, 1, 1]), 0x02)
    let r = complete_of(var c, 0x207A, [hh[0], hh[1], 1, 1])
    test.assert_eq(r[6], 0)
    let _s = ctl_hci.ctl_step(var c)
    test.assert_eq(queued_op(var c), ll_data.OP_POWER_CONTROL_REQ)
    // The peer's answer is a remote report (reason 1) as the Host enabled them.
    var a = rsp(0x00, 0, 5)
    deliver(var c, var a)
    let ev = reports(var c)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][7], 1)
    test.assert_eq(ev[0][9], 5)
    // A change indication is a remote report on each PHY the mask names.
    var i = ind(0x03, 0x02, 3, 8)
    deliver(var c, var i)
    let e2 = reports(var c)
    test.assert_eq(list.len(e2), 2)
    test.assert_eq(e2[0][8], 1)
    test.assert_eq(e2[1][8], 2)
    test.assert_eq(e2[0][10], 0x02)
    test.assert_eq(e2[0][11], 3)
    // With the reports off, an indication is kept and not reported.
    test.assert_eq(status_of(var c, 0x207A, [hh[0], hh[1], 0, 0]), 0)
    var i2 = ind(0x01, 0x00, 0, 4)
    deliver(var c, var i2)
    test.assert_eq(list.len(reports(var c)), 0)

// ── The procedures ──────────────────────────────────────────────────

@test
fn test_a_request_moves_the_level_and_the_answer_carries_the_change()
    if not on()
        return
    var c = connected()
    let hh = hd(var c)
    test.assert_eq(status_of(var c, 0x207A, [hh[0], hh[1], 1, 0]), 0)
    var p = req(0x01, -4, 126 - 1)
    deliver(var c, var p)
    test.assert_eq(queued_op(var c), ll_data.OP_POWER_CONTROL_RSP)
    test.assert_eq(queued_byte(var c, 1), 0)
    test.assert_eq(queued_byte(var c, 2), 0xFC)
    test.assert_eq(queued_byte(var c, 3), 0xFC)
    test.assert_eq(queued_byte(var c, 4), 0xFF)
    test.assert_eq(c.links[0].txp[0] as Int, -4)
    test.assert_eq(c.links[0].txp[1] as Int, 0)
    let ev = reports(var c)
    test.assert_eq(list.len(ev), 1)
    test.assert_eq(ev[0][7], 0)
    test.assert_eq(ev[0][8], 1)
    test.assert_eq(ev[0][9], 0xFC)
    test.assert_eq(ev[0][11], 0xFC)
    // A step that does not move reports nothing, and the delta stops at the range of the radio.
    pop_queued(var c)
    var q = req(0x01, 0x7F, 0)
    deliver(var c, var q)
    test.assert_eq(queued_byte(var c, 1), 0x02)
    test.assert_eq(queued_byte(var c, 3), 8)
    pop_queued(var c)
    var z = req(0x01, 0, 0)
    deliver(var c, var z)
    test.assert_eq(list.len(reports(var c)), 1)
    pop_queued(var c)
    var lo = req(0x02, -100, 0)
    deliver(var c, var lo)
    test.assert_eq(queued_byte(var c, 1), 0x01)
    test.assert_eq(queued_byte(var c, 3), 0xD2)

@test
fn test_a_request_naming_no_phy_or_the_unmanaged_level_is_rejected()
    if not on()
        return
    var c = connected()
    var a = req(0x03, 0, 0)
    deliver(var c, var a)
    test.assert_eq(queued_op(var c), ll_data.OP_REJECT_EXT_IND)
    test.assert_eq(queued_byte(var c, 1), 0x23)
    test.assert_eq(queued_byte(var c, 2), 0x20)
    pop_queued(var c)
    var b = req(0x01, 0, ll_pcl.TX_UNMANAGED)
    deliver(var c, var b)
    test.assert_eq(queued_byte(var c, 2), 0x1E)
    pop_queued(var c)
    ctl_hci.ctl_set_coded(var c, false)
    var d = req(0x04, 0, 0)
    deliver(var c, var d)
    test.assert_eq(queued_byte(var c, 2), 0x20)

@test
fn test_a_request_that_crosses_this_ends_own_changes_nothing()
    if not on()
        return
    var c = connected()
    let hh = hd(var c)
    test.assert_eq(cmd_status(var c, 0x2077, [hh[0], hh[1], 1]), 0)
    pop_queued(var c)
    var p = req(0x01, -6, 0)
    deliver(var c, var p)
    test.assert_eq(queued_op(var c), ll_data.OP_POWER_CONTROL_RSP)
    test.assert_eq(queued_byte(var c, 2), 0)
    test.assert_eq(c.links[0].txp[0] as Int, 0)

@test
fn test_a_new_connection_starts_at_the_default_level_with_nothing_enabled()
    if not on()
        return
    var c = connected()
    let hh = hd(var c)
    test.assert_eq(status_of(var c, 0x207A, [hh[0], hh[1], 1, 0]), 0)
    var p = req(0x01, -4, 0)
    deliver(var c, var p)
    test.assert_eq(c.links[0].txp[0] as Int, -4)
    ctl_hci.apply_defaults(var c, 0)
    test.assert_eq(c.links[0].txp[0] as Int, 0)
    test.assert(not c.pcl[0].local_rep)
    test.assert(not c.pcl[0].wait)
