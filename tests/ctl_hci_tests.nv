@test
fn test_le_rand_is_answered_when_the_hardware_has_run()
    var c = fresh()
    send(var c, ctl_hci.OP_LE_RAND, [])
    test.assert(ctl_hci.ctl_step(var c))
    test.assert_eq(ctl_hci.ctl_async_kind(var c), ctl_hci.PEND_RAND)
    test.assert(not ctl_hci.ctl_accepts(var c))
    test.assert(not ctl_hci.ctl_tx_pending(var c))
    for i in 0..8
        ctl_hci.ctl_async_put(var c, i, 0xA0 + i)
    ctl_hci.ctl_async_complete(var c)
    test.assert_eq(ctl_hci.ctl_async_kind(var c), ctl_hci.PEND_NONE)
    test.assert(ctl_hci.ctl_accepts(var c))
    test.assert_eq(drain(var c),
        [0x04, 0x0E, 0x0C, 0x01, 0x18, 0x20, 0x00, 0xA0, 0xA1, 0xA2, 0xA3, 0xA4, 0xA5, 0xA6, 0xA7])

@test
fn test_le_encrypt_hands_the_cipher_its_operands_most_significant_octet_first()
    var c = fresh()
    var key: [Int] = []
    var plain: [Int] = []
    for i in 0..16
        list.push(key, 0x10 + i)
        list.push(plain, 0x20 + i)
    send(var c, ctl_hci.OP_LE_ENCRYPT, list.concat(key, plain))
    test.assert(ctl_hci.ctl_step(var c))
    test.assert_eq(ctl_hci.ctl_async_kind(var c), ctl_hci.PEND_ENCRYPT)
    test.assert(not ctl_hci.ctl_accepts(var c))
    // The parameter holds the least significant octet first.
    test.assert_eq(ctl_hci.ctl_async_key(var c, 0), 0x1F)
    test.assert_eq(ctl_hci.ctl_async_key(var c, 15), 0x10)
    test.assert_eq(ctl_hci.ctl_async_plain(var c, 0), 0x2F)
    test.assert_eq(ctl_hci.ctl_async_plain(var c, 15), 0x20)
    // A cipher that copies its plaintext shows the order the answer takes.
    for i in 0..16
        ctl_hci.ctl_async_put(var c, i, ctl_hci.ctl_async_plain(var c, i))
    ctl_hci.ctl_async_complete(var c)
    let got = drain(var c)
    test.assert_eq(list.len(got), 7 + 16)
    test.assert_eq(got[2], 20)
    for i in 0..16
        test.assert_eq(got[7 + i], 0x20 + i)

@test
fn test_le_encrypt_reports_a_hardware_failure()
    var c = fresh()
