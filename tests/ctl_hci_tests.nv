// tests/ctl_hci_tests.nv — the Controller's HCI layer driven the way a Host's
// UART drives it: Commands go in octet by octet, the events come out octet by
// octet.

use noble_controller_config
use std.test
use hci_frame
use hci_commands
use ctl_hci
use ctl_pool
use h4_rx

// Feed one Command to the ctl_hci.Controller as the Host's UART would.
fn send(var c: ctl_hci.Controller, opcode: Int, params: [Int])
    ctl_hci.ctl_rx(var c, 0x01)
    ctl_hci.ctl_rx(var c, opcode & 0xFF)
    ctl_hci.ctl_rx(var c, (opcode >>> 8) & 0xFF)
    ctl_hci.ctl_rx(var c, list.len(params))
    for p in params
        ctl_hci.ctl_rx(var c, p)

// Every octet the Controller has to send.
fn drain(var c: ctl_hci.Controller) -> [Int]
    var out: [Int] = []
    while ctl_hci.ctl_tx_pending(var c)
        list.push(out, ctl_hci.ctl_tx_next(var c))
    out

// A Command, its answer.
fn run(var c: ctl_hci.Controller, opcode: Int, params: [Int]) -> [Int]
    send(var c, opcode, params)
    let _ran = ctl_hci.ctl_step(var c)
    drain(var c)

fn zeros(n: Int) -> [Int]
    var v: [Int] = []
    for _ in 0..n
        list.push(v, 0)
    v

fn bytes_of(opcode: Int, status: Int) -> [Int]
    [0x04, 0x0E, 0x04, 0x01, opcode & 0xFF, (opcode >>> 8) & 0xFF, status]

fn fresh() -> ctl_hci.Controller
    var c = ctl_hci.controller_new(ctl_hci.CAP_ECB | ctl_hci.CAP_RNG)
    for i in 0..6
        ctl_hci.ctl_set_public(var c, i, 0x10 + i)
    c

fn test_address(n: Int) -> [Int]
    [n, 0x22, 0x33, 0x44, 0x55, 0x66]

@test
fn test_capacities_match_the_constants()
    let c = ctl_hci.controller_new(0)
    test.assert_eq(c.fal_used.capacity(), ctl_hci.FILTER_ACCEPT_LIST_SIZE)
    test.assert_eq(c.fal_type.capacity(), ctl_hci.FILTER_ACCEPT_LIST_SIZE)
    test.assert_eq(c.fal_addr.capacity(), ctl_hci.FILTER_ACCEPT_LIST_SIZE * 6)
    test.assert_eq(c.public.capacity(), 6)
    test.assert_eq(c.random.capacity(), 6)
    test.assert_eq(c.block.capacity(), 16)
    test.assert_eq(c.key.capacity(), 16)
    test.assert_eq(c.result.capacity(), 16)
    test.assert_eq(c.links.capacity(), noble_controller_config.CTL_LINKS)
    test.assert_eq(c.links.len(), noble_controller_config.CTL_LINKS)

// A slot the build does not have holds no connection: a build with one link asks for the access address of its second slot when it starts
// an initiator, and the answer is 0, the address no connection has.
@test
fn test_a_slot_beyond_the_links_has_no_access_address()
    var c = ctl_hci.controller_new(0)
    test.assert_eq(ctl_hci.slot_aa(var c, noble_controller_config.CTL_LINKS), 0)
    test.assert_eq(ctl_hci.slot_aa(var c, noble_controller_config.CTL_LINKS + 3), 0)
    test.assert_eq(ctl_hci.slot_aa(var c, 0), 0)

@test
fn test_opcodes_match_the_hosts()
    test.assert_eq(ctl_hci.OP_RESET, hci_commands.opcode_hci_reset())
    test.assert_eq(ctl_hci.OP_SET_CONTROLLER_TO_HOST_FLOW_CONTROL,
        hci_commands.opcode_set_controller_to_host_flow_control())
    test.assert_eq(ctl_hci.OP_HOST_BUFFER_SIZE, hci_commands.opcode_host_buffer_size())
    test.assert_eq(ctl_hci.OP_HOST_NUMBER_OF_COMPLETED_PACKETS,
        hci_commands.opcode_host_number_of_completed_packets())
    test.assert_eq(ctl_hci.OP_SET_EVENT_MASK, hci_commands.opcode_hci_set_event_mask())
    test.assert_eq(ctl_hci.OP_READ_LOCAL_VERSION, hci_commands.opcode_read_local_version_information())
    test.assert_eq(ctl_hci.OP_READ_LOCAL_SUPPORTED_COMMANDS, hci_commands.opcode_read_local_supported_commands())
    test.assert_eq(ctl_hci.OP_READ_LOCAL_SUPPORTED_FEATURES, hci_commands.opcode_read_local_supported_features())
    test.assert_eq(ctl_hci.OP_READ_BD_ADDR, hci_commands.opcode_read_bd_addr())
    test.assert_eq(ctl_hci.OP_LE_SET_EVENT_MASK, hci_commands.opcode_le_set_event_mask())
    test.assert_eq(ctl_hci.OP_LE_READ_BUFFER_SIZE, hci_commands.opcode_le_read_buffer_size())
    test.assert_eq(ctl_hci.OP_LE_READ_LOCAL_SUPPORTED_FEATURES,
        hci_commands.opcode_le_read_local_supported_features())
    test.assert_eq(ctl_hci.OP_LE_SET_RANDOM_ADDRESS, hci_commands.opcode_le_set_random_address())
    test.assert_eq(ctl_hci.OP_LE_READ_FILTER_ACCEPT_LIST_SIZE, hci_commands.opcode_le_read_white_list_size())
    test.assert_eq(ctl_hci.OP_LE_CLEAR_FILTER_ACCEPT_LIST, hci_commands.opcode_le_clear_filter_accept_list())
    test.assert_eq(ctl_hci.OP_LE_ADD_DEVICE_TO_FILTER_ACCEPT_LIST,
        hci_commands.opcode_le_add_device_to_filter_accept_list())
    test.assert_eq(ctl_hci.OP_LE_ENCRYPT, hci_commands.opcode_le_encrypt())
    test.assert_eq(ctl_hci.OP_LE_RAND, hci_commands.opcode_le_rand())
    test.assert_eq(ctl_hci.OP_LE_READ_SUPPORTED_STATES, hci_commands.opcode_le_read_supported_states())

@test
fn test_reset_is_answered_with_success()
    var c = fresh()
    test.assert_eq(run(var c, ctl_hci.OP_RESET, []), bytes_of(ctl_hci.OP_RESET, 0))

@test
fn test_read_local_version_reports_the_specification_and_no_vendor()
    var c = fresh()
    let want = [0x04, 0x0E, 0x0C, 0x01, 0x01, 0x10, 0x00, 0x11, 0x01, 0x00, 0x11, 0xFF, 0xFF, 0x01, 0x00]
    test.assert_eq(run(var c, ctl_hci.OP_READ_LOCAL_VERSION, []), want)

@test
fn test_read_bd_addr_returns_the_public_address_least_significant_first()
    var c = fresh()
    let want = [0x04, 0x0E, 0x0A, 0x01, 0x09, 0x10, 0x00, 0x10, 0x11, 0x12, 0x13, 0x14, 0x15]
    test.assert_eq(run(var c, ctl_hci.OP_READ_BD_ADDR, []), want)

@test
fn test_read_local_supported_features_claims_le_only()
    var c = fresh()
    let got = run(var c, ctl_hci.OP_READ_LOCAL_SUPPORTED_FEATURES, [])
    test.assert_eq(list.len(got), 15)
    test.assert_eq(got[2], 12)
    test.assert_eq(got[6], 0)
    for i in 0..8
        test.assert_eq(got[7 + i], (if i == 4 then 0x60 else 0))

@test
fn test_le_read_buffer_size_reports_the_acl_path()
    var c = fresh()
    test.assert_eq(run(var c, ctl_hci.OP_LE_READ_BUFFER_SIZE, []),
        [0x04, 0x0E, 0x07, 0x01, 0x02, 0x20, 0x00, 251, 0x00, ctl_hci.ACL_BUFFERS])

// Read Buffer Size and Read Local Name belong to BR/EDR; an LE Controller answers them
// with Unknown HCI Command and leaves their bits clear (HCI.TS HCI/GEV/BV-01-C).
@test
fn test_the_br_edr_only_commands_are_unknown()
    var c = fresh()
    test.assert_eq(run(var c, 0x1005, []), bytes_of(0x1005, 0x01))
    test.assert_eq(run(var c, 0x0C14, []), bytes_of(0x0C14, 0x01))
    let got = run(var c, ctl_hci.OP_READ_LOCAL_SUPPORTED_COMMANDS, [])
    // Octet 14 bit 7 was Read Buffer Size, octet 7 bit 1 Read Local Name.
    test.assert_eq(got[7 + 14] & 0x80, 0)
    test.assert_eq(got[7 + 7] & 0x02, 0)

// Read Transmit Power Level (octet 10 bit 2) and Read RSSI (octet 15 bit 5) are listed
// when the build has a Link Layer.
// The test commands are listed (octet 28 bits 4 to 6, octet 35 bit 7, octet 36 bit 0, octet 39
// bits 3 and 4, octet 45 bit 0) when the build has a Link Layer.
@test
fn test_the_direct_test_mode_commands_are_listed()
    var c = ctl_hci.controller_new(ctl_hci.CAP_LL)
    let got = run(var c, ctl_hci.OP_READ_LOCAL_SUPPORTED_COMMANDS, [])
    test.assert_eq(got[7 + 28] & 0x70, 0x70)
    test.assert_eq(got[7 + 35] & 0x80, 0x80)
    test.assert_eq(got[7 + 36] & 0x01, 0x01)
    test.assert_eq(got[7 + 39] & 0x18, 0x18)
    test.assert_eq(got[7 + 45] & 0x01, 0x01)
    // Without a Link Layer there is no radio to test.
    var d = fresh()
    let none = run(var d, ctl_hci.OP_READ_LOCAL_SUPPORTED_COMMANDS, [])
    test.assert_eq(none[7 + 28] & 0x70, 0)
    test.assert_eq(none[7 + 45] & 0x01, 0)

@test
fn test_read_transmit_power_level_and_read_rssi_are_listed()
    var c = ctl_hci.controller_new(ctl_hci.CAP_LL)
    let got = run(var c, ctl_hci.OP_READ_LOCAL_SUPPORTED_COMMANDS, [])
    test.assert_eq(got[7 + 10] & 0x04, 0x04)
    test.assert_eq(got[7 + 15] & 0x20, 0x20)
    var d = fresh()
    let none = run(var d, ctl_hci.OP_READ_LOCAL_SUPPORTED_COMMANDS, [])
    test.assert_eq(none[7 + 10] & 0x04, 0)
    test.assert_eq(none[7 + 15] & 0x20, 0)

@test
fn test_le_features_and_states_claim_nothing()
    var c = fresh()
    test.assert_eq(run(var c, ctl_hci.OP_LE_READ_LOCAL_SUPPORTED_FEATURES, []),
        list.concat([0x04, 0x0E, 0x0C, 0x01, 0x03, 0x20, 0x00], zeros(8)))
    test.assert_eq(run(var c, ctl_hci.OP_LE_READ_SUPPORTED_STATES, []),
        list.concat([0x04, 0x0E, 0x0C, 0x01, 0x1C, 0x20, 0x00], zeros(8)))

@test
fn test_default_masks_let_the_events_through()
    var c = fresh()
    test.assert(ctl_hci.event_enabled(var c, hci_frame.EVT_DISCONNECTION_COMPLETE))
    test.assert(ctl_hci.event_enabled(var c, hci_frame.EVT_HARDWARE_ERROR))
    test.assert(ctl_hci.event_enabled(var c, 45))
    test.assert(not ctl_hci.event_enabled(var c, 46))
    test.assert(not ctl_hci.event_enabled(var c, 0))
    test.assert(not ctl_hci.event_enabled(var c, 65))
    // The LE Meta event is off until the Host turns it on, and with it every
    // LE subevent.
    test.assert(not ctl_hci.event_enabled(var c, hci_frame.EVT_LE_META_EVENT))
    test.assert(not ctl_hci.le_event_enabled(var c, 1))
    let _a = run(var c, ctl_hci.OP_SET_EVENT_MASK, [0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x1F, 0x00, 0x20])
    test.assert(ctl_hci.event_enabled(var c, hci_frame.EVT_LE_META_EVENT))
    test.assert(ctl_hci.le_event_enabled(var c, 1))
    test.assert(ctl_hci.le_event_enabled(var c, 5))
    test.assert(not ctl_hci.le_event_enabled(var c, 6))

@test
fn test_set_event_mask_replaces_the_mask()
    var c = fresh()
    let got = run(var c, ctl_hci.OP_SET_EVENT_MASK, [0x10, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x80])
    test.assert_eq(got, bytes_of(ctl_hci.OP_SET_EVENT_MASK, 0))
    test.assert(ctl_hci.event_enabled(var c, 5))
    test.assert(not ctl_hci.event_enabled(var c, hci_frame.EVT_HARDWARE_ERROR))
    test.assert(not ctl_hci.event_enabled(var c, hci_frame.EVT_LE_META_EVENT))
    test.assert(ctl_hci.event_enabled(var c, 64))

@test
fn test_le_set_event_mask_replaces_the_le_mask()
    var c = fresh()
    let _m = run(var c, ctl_hci.OP_SET_EVENT_MASK, [0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0x1F, 0x00, 0x20])
    let got = run(var c, ctl_hci.OP_LE_SET_EVENT_MASK, [0x02, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00])
    test.assert_eq(got, bytes_of(ctl_hci.OP_LE_SET_EVENT_MASK, 0))
    test.assert(not ctl_hci.le_event_enabled(var c, 1))
    test.assert(ctl_hci.le_event_enabled(var c, 2))
    test.assert(ctl_hci.le_event_enabled(var c, 33))

@test
fn test_the_le_mask_applies_only_while_the_le_meta_event_is_enabled()
    var c = fresh()
    let _a = run(var c, ctl_hci.OP_SET_EVENT_MASK, zeros(8))
    test.assert(not ctl_hci.le_event_enabled(var c, 1))

@test
fn test_reset_restores_the_defaults()
    var c = fresh()
    let _a = run(var c, ctl_hci.OP_SET_EVENT_MASK, zeros(8))
    let _b = run(var c, ctl_hci.OP_LE_SET_EVENT_MASK, zeros(8))
    let _c = run(var c, ctl_hci.OP_LE_SET_RANDOM_ADDRESS, test_address(0xC1))
    let _d = run(var c, ctl_hci.OP_LE_ADD_DEVICE_TO_FILTER_ACCEPT_LIST, list.concat([0], test_address(1)))
    test.assert(c.random_set)
    test.assert_eq(ctl_hci.fal_count(var c), 1)
    let got = run(var c, ctl_hci.OP_RESET, [])
    test.assert_eq(got, bytes_of(ctl_hci.OP_RESET, 0))
    test.assert(ctl_hci.event_enabled(var c, hci_frame.EVT_HARDWARE_ERROR))
    test.assert_eq(c.le_low, ctl_hci.LE_MASK_DEFAULT)
    test.assert_eq(c.le_high, 0)
    test.assert(not c.random_set)
    test.assert_eq(c.random[0] as Int, 0)
    test.assert_eq(ctl_hci.fal_count(var c), 0)
    test.assert_eq(c.resets, 1)

@test
fn test_reset_keeps_the_public_address()
    var c = fresh()
    let _a = run(var c, ctl_hci.OP_RESET, [])
    test.assert_eq(c.public[5] as Int, 0x15)

@test
fn test_reset_drops_events_not_begun()
    var c = fresh()
    // Two answers wait: nothing reads them out before the Reset.
    send(var c, ctl_hci.OP_READ_BD_ADDR, [])
    let _a = ctl_hci.ctl_step(var c)
    send(var c, ctl_hci.OP_READ_LOCAL_VERSION, [])
    let _b = ctl_hci.ctl_step(var c)
    send(var c, ctl_hci.OP_RESET, [])
    let _c = ctl_hci.ctl_step(var c)
    test.assert_eq(drain(var c), bytes_of(ctl_hci.OP_RESET, 0))

@test
fn test_set_random_address_stores_the_address()
    var c = fresh()
    let got = run(var c, ctl_hci.OP_LE_SET_RANDOM_ADDRESS, test_address(0xC1))
    test.assert_eq(got, bytes_of(ctl_hci.OP_LE_SET_RANDOM_ADDRESS, 0))
    test.assert(c.random_set)
    test.assert_eq(c.random[0] as Int, 0xC1)
    test.assert_eq(c.random[5] as Int, 0x66)

@test
fn test_supported_commands_lists_what_is_answered()
    var c = ctl_hci.controller_new(0)
    let got = run(var c, ctl_hci.OP_READ_LOCAL_SUPPORTED_COMMANDS, [])
    test.assert_eq(list.len(got), 7 + 64)
    test.assert_eq(got[2], 68)
    test.assert_eq(got[6], 0)
    // Octet 5: Set Event Mask and Reset.
    test.assert_eq(got[7 + 5], 0xC0)
    // Octet 7: nothing (Read Local Name is BR/EDR).
    test.assert_eq(got[7 + 7], 0x00)
    // Octet 14: Read Local Version, Supported Features (Read Buffer Size is BR/EDR).
    test.assert_eq(got[7 + 14], 0x28)
    // Octet 15: Read BD_ADDR.
    test.assert_eq(got[7 + 15], 0x02)
    // Octet 25: LE Set Event Mask, Read Buffer Size, Local Supported
    // Features, Set Random Address.
    test.assert_eq(got[7 + 25], 0x17)
    // Octet 26: Filter Accept List size and clear.
    test.assert_eq(got[7 + 26], 0xC0)
    // Octet 27: add and remove, and neither LE Encrypt nor LE Rand without
    // hardware for them.
    test.assert_eq(got[7 + 27], 0x03)
    // Octet 28: LE Read Supported States.
    test.assert_eq(got[7 + 28], 0x08)

@test
fn test_supported_commands_adds_the_commands_the_hardware_allows()
    var c = fresh()
    let got = run(var c, ctl_hci.OP_READ_LOCAL_SUPPORTED_COMMANDS, [])
    test.assert_eq(got[7 + 27], 0xC3)

@test
fn test_every_opcode_is_answered_exactly_when_the_bit_field_lists_it()
    var c = fresh()
    let field = run(var c, ctl_hci.OP_READ_LOCAL_SUPPORTED_COMMANDS, [])
    var answered = 0
    for opcode in 0..0x10000
        var out = run(var c, opcode, [])
        // A command that waits for the hardware is finished with a fixed answer.
        if ctl_hci.ctl_async_kind(var c) != ctl_hci.PEND_NONE
            ctl_hci.ctl_async_fail(var c)
            out = drain(var c)
        let bit = ctl_hci.command_bit(opcode)
        let listed = bit >= 0 and ((field[7 + bit / 8] >>> (bit % 8)) & 1) == 1
        if opcode == ctl_hci.OP_HOST_NUMBER_OF_COMPLETED_PACKETS
            // Listed, and answered with no event at all ([Vol 4] Part E, Section 7.3.40).
            test.assert(listed)
            test.assert_eq(list.len(out), 0)
            answered = answered + 1
            continue
        let status = out[6]
        if opcode == ctl_hci.OP_READ_LOCAL_SUPPORTED_COMMANDS
            test.assert_eq(status, 0)
        else if listed
            test.assert(status != ctl_hci.STATUS_UNKNOWN_COMMAND)
            answered = answered + 1
        else
            test.assert_eq(status, ctl_hci.STATUS_UNKNOWN_COMMAND)
    // The 17 commands of the table that need no capability, and the three of
    // flow control toward the Host.
    test.assert_eq(answered, 20)

@test
fn test_every_listed_opcode_lies_in_the_group_scan()
    // The bit field is built by scanning OCF 0 to 0xFF of five groups.
    for opcode in 0..0x10000
        if ctl_hci.command_bit(opcode) >= 0
            let ogf = hci_frame.opcode_ogf(opcode)
            test.assert(ogf == 0x01 or ogf == 0x03 or ogf == 0x04 or ogf == 0x05 or ogf == 0x08)
            test.assert(hci_frame.opcode_ocf(opcode) < 0x100)

@test
fn test_every_answered_command_has_its_parameter_length()
    for opcode in 0..0x10000
        let known = ctl_hci.command_bit(opcode) >= 0 or opcode == ctl_hci.OP_READ_LOCAL_SUPPORTED_COMMANDS
        let want = ctl_hci.command_params(opcode)
        test.assert_eq(want >= 0 or want == -2, known)

@test
fn test_an_unknown_command_is_answered_with_unknown_hci_command()
    var c = fresh()
    // LE Set Advertising Parameters: a Link Layer command.
    let got = run(var c, 0x2006, zeros(15))
    test.assert_eq(got, bytes_of(0x2006, ctl_hci.STATUS_UNKNOWN_COMMAND))
    test.assert_eq(c.unknown, 1)
    // The stream is intact: the next command is read.
    test.assert_eq(run(var c, ctl_hci.OP_RESET, []), bytes_of(ctl_hci.OP_RESET, 0))

@test
fn test_a_vendor_command_is_unknown()
    var c = fresh()
    test.assert_eq(run(var c, 0xFC01, []), bytes_of(0xFC01, ctl_hci.STATUS_UNKNOWN_COMMAND))

@test
fn test_a_command_with_the_wrong_parameter_length_is_refused()
    var c = fresh()
    test.assert_eq(run(var c, ctl_hci.OP_SET_EVENT_MASK, zeros(7)),
        bytes_of(ctl_hci.OP_SET_EVENT_MASK, ctl_hci.STATUS_INVALID_PARAMETERS))
    test.assert_eq(run(var c, ctl_hci.OP_RESET, [0]),
        bytes_of(ctl_hci.OP_RESET, ctl_hci.STATUS_INVALID_PARAMETERS))
    test.assert_eq(run(var c, ctl_hci.OP_LE_SET_RANDOM_ADDRESS, zeros(7)),
        bytes_of(ctl_hci.OP_LE_SET_RANDOM_ADDRESS, ctl_hci.STATUS_INVALID_PARAMETERS))
    // A refused command changes nothing.
    test.assert(ctl_hci.event_enabled(var c, hci_frame.EVT_HARDWARE_ERROR))
    test.assert_eq(c.resets, 0)

@test
fn test_the_filter_accept_list_reports_its_size()
    var c = fresh()
    test.assert_eq(run(var c, ctl_hci.OP_LE_READ_FILTER_ACCEPT_LIST_SIZE, []),
        [0x04, 0x0E, 0x05, 0x01, 0x0F, 0x20, 0x00, ctl_hci.FILTER_ACCEPT_LIST_SIZE])

@test
fn test_the_filter_accept_list_takes_its_size_in_devices_and_no_more()
    var c = fresh()
    for n in 0..FILTER_ACCEPT_LIST_SIZE
        test.assert_eq(run(var c, ctl_hci.OP_LE_ADD_DEVICE_TO_FILTER_ACCEPT_LIST, list.concat([0], test_address(n))),
            bytes_of(ctl_hci.OP_LE_ADD_DEVICE_TO_FILTER_ACCEPT_LIST, 0))
    test.assert_eq(ctl_hci.fal_count(var c), ctl_hci.FILTER_ACCEPT_LIST_SIZE)
    test.assert_eq(run(var c, ctl_hci.OP_LE_ADD_DEVICE_TO_FILTER_ACCEPT_LIST, list.concat([0], test_address(99))),
        bytes_of(ctl_hci.OP_LE_ADD_DEVICE_TO_FILTER_ACCEPT_LIST, ctl_hci.STATUS_MEMORY_CAPACITY_EXCEEDED))
    test.assert_eq(ctl_hci.fal_count(var c), ctl_hci.FILTER_ACCEPT_LIST_SIZE)

@test
fn test_the_filter_accept_list_does_not_add_a_device_twice()
    var c = fresh()
    let add = list.concat([1], test_address(7))
    let _a = run(var c, ctl_hci.OP_LE_ADD_DEVICE_TO_FILTER_ACCEPT_LIST, add)
    test.assert_eq(run(var c, ctl_hci.OP_LE_ADD_DEVICE_TO_FILTER_ACCEPT_LIST, add),
        bytes_of(ctl_hci.OP_LE_ADD_DEVICE_TO_FILTER_ACCEPT_LIST, 0))
    test.assert_eq(ctl_hci.fal_count(var c), 1)

@test
fn test_the_filter_accept_list_tells_a_public_from_a_random_address()
    var c = fresh()
    let _a = run(var c, ctl_hci.OP_LE_ADD_DEVICE_TO_FILTER_ACCEPT_LIST, list.concat([0], test_address(7)))
    let _b = run(var c, ctl_hci.OP_LE_ADD_DEVICE_TO_FILTER_ACCEPT_LIST, list.concat([1], test_address(7)))
    test.assert_eq(ctl_hci.fal_count(var c), 2)

@test
fn test_the_filter_accept_list_removes_a_device_and_frees_its_entry()
    var c = fresh()
    for n in 0..FILTER_ACCEPT_LIST_SIZE
        let _a = run(var c, ctl_hci.OP_LE_ADD_DEVICE_TO_FILTER_ACCEPT_LIST, list.concat([0], test_address(n)))
    let remove = list.concat([0], test_address(3))
    test.assert_eq(run(var c, ctl_hci.OP_LE_REMOVE_DEVICE_FROM_FILTER_ACCEPT_LIST, remove),
        bytes_of(ctl_hci.OP_LE_REMOVE_DEVICE_FROM_FILTER_ACCEPT_LIST, 0))
    test.assert_eq(ctl_hci.fal_count(var c), ctl_hci.FILTER_ACCEPT_LIST_SIZE - 1)
    test.assert_eq(run(var c, ctl_hci.OP_LE_ADD_DEVICE_TO_FILTER_ACCEPT_LIST, list.concat([0], test_address(99))),
        bytes_of(ctl_hci.OP_LE_ADD_DEVICE_TO_FILTER_ACCEPT_LIST, 0))
    test.assert_eq(ctl_hci.fal_count(var c), ctl_hci.FILTER_ACCEPT_LIST_SIZE)

@test
