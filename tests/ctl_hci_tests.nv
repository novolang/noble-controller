@test
fn test_a_command_that_waits_for_the_hardware_blocks_the_next_one()
    var c = fresh()
    send(var c, ctl_hci.OP_LE_RAND, [])
    let _a = ctl_hci.ctl_step(var c)
    test.assert(not ctl_hci.ctl_accepts(var c))
    test.assert(not ctl_hci.ctl_step(var c))
    ctl_hci.ctl_async_complete(var c)
    test.assert_eq(run(var c, ctl_hci.OP_RESET, []), bytes_of(ctl_hci.OP_RESET, 0))

// ── The Host's port holds an octet ──────────────────────────────────

// A port that takes `room` more octets and then holds, as a UART does while the Host's flow control stops it.
@value
struct HeldPort
    room: Int
    asked: Int
    got: Vec[Int; 64]

fn held_port(room: Int) -> HeldPort
    HeldPort { room: room, asked: 0, got: Vec.new() }

impl HeldPort
    // The Host reads again: the port takes `n` more octets.
    fn open_for(var self, n: Int)
        self.room = n

impl HostTx[] for HeldPort
    fn ready(var self) -> Bool
        self.asked = self.asked + 1
        self.room > 0

    fn send(var self, b: Int)
        self.room = self.room - 1
        let _p = self.got.push(b)

fn heard(p: HeldPort) -> [Int]
    var got: [Int] = []
    for i in 0..p.got.len()
        list.push(got, p.got[i])
    got

@test
fn test_a_port_that_holds_gets_no_octet_and_the_event_waits()
    var c = fresh()
    send(var c, ctl_hci.OP_RESET, [])
    let _a = ctl_hci.ctl_step(var c)
    var port = held_port(0)
    test.assert_eq(ctl_hci.ctl_tx_drain(var c, var port, 64), 0)
    test.assert_eq(port.got.len(), 0)
    // The event is still whole in the queue, for the turn the Host reads again.
    test.assert(ctl_hci.ctl_tx_pending(var c))
    port.open_for(64)
    test.assert_eq(ctl_hci.ctl_tx_drain(var c, var port, 64), 7)
    test.assert_eq(heard(port), bytes_of(ctl_hci.OP_RESET, 0))
    test.assert(not ctl_hci.ctl_tx_pending(var c))

@test
fn test_a_port_that_takes_part_of_an_event_gets_the_rest_later_in_order()
    var c = fresh()
    send(var c, ctl_hci.OP_RESET, [])
    let _a = ctl_hci.ctl_step(var c)
    var port = held_port(3)
    test.assert_eq(ctl_hci.ctl_tx_drain(var c, var port, 64), 3)
    // The port was asked once for each octet and once for the one it held: not again and again.
    test.assert_eq(port.asked, 4)
    port.open_for(64)
    test.assert_eq(ctl_hci.ctl_tx_drain(var c, var port, 64), 4)
    test.assert_eq(heard(port), bytes_of(ctl_hci.OP_RESET, 0))

@test
fn test_the_drain_stops_at_its_bound_and_an_empty_queue_asks_the_port_nothing()
    var c = fresh()
    var idle = held_port(64)
    test.assert_eq(ctl_hci.ctl_tx_drain(var c, var idle, 64), 0)
    test.assert_eq(idle.asked, 0)
    send(var c, ctl_hci.OP_RESET, [])
    let _a = ctl_hci.ctl_step(var c)
    var port = held_port(64)
    test.assert_eq(ctl_hci.ctl_tx_drain(var c, var port, 2), 2)
    test.assert(ctl_hci.ctl_tx_pending(var c))

// ── Flow control toward the Host ────────────────────────────────────
//
// The mock Hosts here are the commands a Host would send: Host Buffer Size,
// Set Controller To Host Flow Control and Host Number Of Completed Packets.
// The ACL Data packets the Link Layer would hand over are put in the pool
// the way `forward_acl` does.

// Host Buffer Size with `length` octets of ACL data and `total` packets.
fn host_buffer_size(var c: ctl_hci.Controller, length: Int, total: Int) -> [Int]
    run(var c,
        0x0C33,
        [length & 0xFF, (length >>> 8) & 0xFF, 0, total & 0xFF, (total >>> 8) & 0xFF, 0, 0])

// An HCI ACL Data packet of `n` octets for handle 0x0040, the first piece
// of a PDU (flag 2) when `start`, in the pool of `c`.
fn queue_acl(var c: ctl_hci.Controller, start: Bool, n: Int) -> Bool
    let slot = ctl_pool.acl_begin(var c.pool, 0x0040, (if start then 2 else 1))
    if slot == ctl_pool.NO_SLOT
        return false
    for i in 0..n
        let _ = ctl_pool.pool_put(var c.pool, slot, i & 0x7F)
    ctl_pool.acl_send(var c.pool, slot)

// The packets of a stream of octets the Controller sent, each as a list.
fn packets_of(out: [Int]) -> [[Int]]
    var all: [[Int]] = []
    var at = 0
    for _ in 0..64
        if at < list.len(out)
            let n = if out[at] == 0x02
                5 + out[at + 3] + (out[at + 4] << 8)
            else
                3 + out[at + 2]
            var one: [Int] = []
            for i in 0..n
                list.push(one, out[at + i])
            list.push(all, one)
            at = at + n
    all

// The Packet_Boundary_Flag of an ACL packet.
fn pb_of(pkt: [Int]) -> Int
    (pkt[2] >>> 4) & 3

@test
@satisfies("REQ-BLE-HCI-059")
fn test_supported_commands_lists_the_three_commands_of_flow_control_toward_the_host()
    var c = fresh()
    let got = run(var c, ctl_hci.OP_READ_LOCAL_SUPPORTED_COMMANDS, [])
    // Octet 10 bits 5, 6 and 7.
    test.assert_eq(got[7 + 10] & 0xE0, 0xE0)

@test
@satisfies("REQ-BLE-HCI-059")
fn test_host_buffer_size_is_answered_and_a_zero_is_refused()
    var c = fresh()
    test.assert_eq(host_buffer_size(var c, 27, 2), bytes_of(0x0C33, 0))
    test.assert_eq(host_buffer_size(var c, 0, 2), bytes_of(0x0C33, 0x12))
    test.assert_eq(host_buffer_size(var c, 27, 0), bytes_of(0x0C33, 0x12))
    // A command of the wrong length is refused like any other.
    test.assert_eq(run(var c, 0x0C33, [27, 0, 0]), bytes_of(0x0C33, 0x12))

@test
@satisfies("REQ-BLE-HCI-059")
fn test_flow_control_is_accepted_before_the_host_buffer_size()
    var c = fresh()
    // Section 7.3.38 sets no order: the enable is accepted, a bad value is not.
    test.assert_eq(run(var c, 0x0C31, [1]), bytes_of(0x0C31, 0x00))
    test.assert_eq(run(var c, 0x0C31, [4]), bytes_of(0x0C31, 0x12))
    test.assert_eq(run(var c, 0x0C31, [0]), bytes_of(0x0C31, 0x00))
    test.assert_eq(run(var c, 0x0C31, [1]), bytes_of(0x0C31, 0x00))
    test.assert_eq(host_buffer_size(var c, 251, 3), bytes_of(0x0C33, 0))

@test
@satisfies("REQ-BLE-HCI-059")
fn test_flow_control_on_without_a_buffer_size_counts_nothing_until_the_size_arrives()
    var c = fresh()
    test.assert_eq(run(var c, 0x0C31, [1]), bytes_of(0x0C31, 0x00))
    for _ in 0..3
        test.assert(queue_acl(var c, true, 10))
    test.assert_eq(list.len(packets_of(drain(var c))), 3)
    for _ in 0..3
        test.assert(queue_acl(var c, true, 10))
    test.assert_eq(list.len(packets_of(drain(var c))), 3)
    test.assert_eq(ctl_pool.pool_host_free(var c.pool), 0)
    // The size arrives: the count starts with every buffer free.
    test.assert_eq(host_buffer_size(var c, 251, 2), bytes_of(0x0C33, 0))
    test.assert_eq(ctl_pool.pool_host_free(var c.pool), 2)
    test.assert(queue_acl(var c, true, 10))
    test.assert(queue_acl(var c, true, 10))
    test.assert(queue_acl(var c, true, 10))
    test.assert_eq(list.len(packets_of(drain(var c))), 2)
    test.assert_eq(ctl_pool.pool_host_free(var c.pool), 0)

@test
@satisfies("REQ-BLE-HCI-059")
fn test_flow_control_cannot_change_while_a_connection_exists()
    var c = fresh()
    test.assert_eq(run(var c, 0x0C31, [1]), bytes_of(0x0C31, 0x00))
    c.links[0].live = true
    // A change is Command Disallowed, the same value is accepted.
    test.assert_eq(run(var c, 0x0C31, [0]), bytes_of(0x0C31, 0x0C))
    test.assert_eq(run(var c, 0x0C31, [1]), bytes_of(0x0C31, 0x00))
    c.links[0].live = false
    test.assert_eq(run(var c, 0x0C31, [0]), bytes_of(0x0C31, 0x00))
    c.links[0].live = true
    test.assert_eq(run(var c, 0x0C31, [1]), bytes_of(0x0C31, 0x0C))

@test
@satisfies("REQ-BLE-HCI-059")
fn test_host_number_of_completed_packets_is_ignored_with_flow_control_off_or_no_size_or_no_connection()
    var c = fresh()
    // Flow control off: nothing happens, no event.
    test.assert_eq(host_buffer_size(var c, 251, 2), bytes_of(0x0C33, 0))
    test.assert_eq(run(var c, 0x0C35, [1, 0x40, 0x00, 0x01, 0x00]), [])
    // Flow control on, no connection: ignored, the count of sent packets stays.
    test.assert_eq(run(var c, 0x0C31, [1]), bytes_of(0x0C31, 0))
    test.assert(queue_acl(var c, true, 10))
    let _sent = drain(var c)
    test.assert_eq(ctl_pool.pool_host_free(var c.pool), 1)
    test.assert_eq(run(var c, 0x0C35, [1, 0x40, 0x00, 0x01, 0x00]), [])
    test.assert_eq(ctl_pool.pool_host_free(var c.pool), 1)
    // No Host Buffer Size seen: ignored.
    var d = fresh()
    test.assert_eq(run(var d, 0x0C31, [1]), bytes_of(0x0C31, 0))
    d.links[0].live = true
    test.assert_eq(run(var d, 0x0C35, [1, 0x40, 0x00, 0x01, 0x00]), [])
    test.assert_eq(ctl_pool.pool_host_free(var d.pool), 0)

@test
@satisfies("REQ-BLE-HCI-059")
fn test_a_host_that_sends_no_size_is_sent_the_packet_whole()
    var c = fresh()
    test.assert(queue_acl(var c, true, 251))
    let pkts = packets_of(drain(var c))
    test.assert_eq(list.len(pkts), 1)
    test.assert_eq(list.len(pkts[0]), 5 + 251)
    test.assert_eq(pb_of(pkts[0]), 2)

@test
@satisfies("REQ-BLE-HCI-059")
fn test_a_mock_host_with_27_octet_buffers_is_sent_pieces_of_27()
    var c = fresh()
    test.assert_eq(host_buffer_size(var c, 27, 2), bytes_of(0x0C33, 0))
    test.assert(queue_acl(var c, true, 100))
    let pkts = packets_of(drain(var c))
    // 27 + 27 + 27 + 19 octets: the first starts the PDU, the rest continue it.
    test.assert_eq(list.len(pkts), 4)
    test.assert_eq(list.len(pkts[0]), 5 + 27)
    test.assert_eq(list.len(pkts[1]), 5 + 27)
    test.assert_eq(list.len(pkts[2]), 5 + 27)
    test.assert_eq(list.len(pkts[3]), 5 + 19)
    test.assert_eq(pb_of(pkts[0]), 2)
    test.assert_eq(pb_of(pkts[1]), 1)
    test.assert_eq(pb_of(pkts[3]), 1)
    // The handle stays, the length field says what each piece holds, and the
    // data runs on without a gap.
    var at = 0
    for pkt in pkts
        test.assert_eq(pkt[1], 0x40)
        test.assert_eq(pkt[2] & 0x0F, 0)
        test.assert_eq(pkt[3] + (pkt[4] << 8), list.len(pkt) - 5)
        for i in 5..list.len(pkt)
            test.assert_eq(pkt[i], at & 0x7F)
            at = at + 1
    test.assert_eq(at, 100)
    // A packet that fits goes whole.
    test.assert(queue_acl(var c, true, 27))
    test.assert_eq(list.len(packets_of(drain(var c))), 1)

@test
@satisfies("REQ-BLE-HCI-059")
fn test_a_mock_host_with_a_buffer_longer_than_the_data_gets_the_packet_whole()
    var c = fresh()
    test.assert_eq(host_buffer_size(var c, 0xFFFF, 1), bytes_of(0x0C33, 0))
    test.assert(queue_acl(var c, true, 251))
    let pkts = packets_of(drain(var c))
    test.assert_eq(list.len(pkts), 1)
    test.assert_eq(list.len(pkts[0]), 5 + 251)

@test
@satisfies("REQ-BLE-HCI-059")
fn test_a_mock_host_with_two_buffers_is_sent_two_packets_until_it_returns_one()
    var c = fresh()
    test.assert_eq(host_buffer_size(var c, 251, 2), bytes_of(0x0C33, 0))
    test.assert_eq(run(var c, 0x0C31, [1]), bytes_of(0x0C31, 0))
    test.assert(queue_acl(var c, true, 10))
    test.assert(queue_acl(var c, true, 11))
    test.assert(queue_acl(var c, true, 12))
    // An event queued behind the three passes the one that waits.
    send(var c, ctl_hci.OP_READ_BD_ADDR, [])
    let _ran = ctl_hci.ctl_step(var c)
    let first = packets_of(drain(var c))
    test.assert_eq(list.len(first), 3)
    test.assert_eq(list.len(first[0]), 5 + 10)
    test.assert_eq(list.len(first[1]), 5 + 11)
    test.assert_eq(first[2][0], 0x04)
    test.assert(not ctl_hci.ctl_tx_pending(var c))
    test.assert_eq(ctl_pool.pool_host_free(var c.pool), 0)
    // Host Number Of Completed Packets has no event in answer, and a buffer
    // back sends the packet that waited.
    c.links[0].live = true
    send(var c, 0x0C35, [1, 0x40, 0x00, 0x01, 0x00])
    let _ret = ctl_hci.ctl_step(var c)
    test.assert_eq(ctl_pool.pool_host_free(var c.pool), 1)
    let second = packets_of(drain(var c))
    test.assert_eq(list.len(second), 1)
    test.assert_eq(list.len(second[0]), 5 + 12)
    test.assert_eq(ctl_pool.pool_host_free(var c.pool), 0)

@test
@satisfies("REQ-BLE-HCI-059")
fn test_host_number_of_completed_packets_is_ignored_when_malformed_and_not_believed_when_too_big()
    var c = fresh()
    test.assert_eq(host_buffer_size(var c, 251, 2), bytes_of(0x0C33, 0))
    test.assert_eq(run(var c, 0x0C31, [1]), bytes_of(0x0C31, 0))
    c.links[0].live = true
    test.assert(queue_acl(var c, true, 10))
    let _sent = drain(var c)
    test.assert_eq(ctl_pool.pool_host_free(var c.pool), 1)
    // No handle count, a count that disagrees with the length: nothing returned, no event.
    test.assert_eq(run(var c, 0x0C35, []), [])
    test.assert_eq(run(var c, 0x0C35, [2, 0x40, 0x00, 0x01, 0x00]), [])
    test.assert_eq(ctl_pool.pool_host_free(var c.pool), 1)
    // A Host that returns more than it holds frees what was sent, no more.
    test.assert_eq(run(var c, 0x0C35, [1, 0x40, 0x00, 0x09, 0x00]), [])
    test.assert_eq(ctl_pool.pool_host_free(var c.pool), 2)
    // Two handles in one command add up.
    test.assert(queue_acl(var c, true, 10))
    test.assert(queue_acl(var c, true, 10))
    let _more = drain(var c)
    test.assert_eq(ctl_pool.pool_host_free(var c.pool), 0)
    test.assert_eq(run(var c, 0x0C35, [2, 0x40, 0x00, 0x01, 0x00, 0x41, 0x00, 0x01, 0x00]), [])
    test.assert_eq(ctl_pool.pool_host_free(var c.pool), 2)

@test
@satisfies("REQ-BLE-HCI-059")
fn test_flow_control_off_stops_counting_and_reset_forgets_the_hosts_sizes()
    var c = fresh()
    test.assert_eq(host_buffer_size(var c, 27, 1), bytes_of(0x0C33, 0))
    test.assert_eq(run(var c, 0x0C31, [1]), bytes_of(0x0C31, 0))
    test.assert(queue_acl(var c, true, 40))
    test.assert_eq(list.len(packets_of(drain(var c))), 1)
    // Off: the second piece, which waited for a buffer, goes out beside the answer,
    // and further packets are not held back by the count.
    let released = packets_of(run(var c, 0x0C31, [0]))
    test.assert_eq(list.len(released), 2)
    test.assert_eq(list.len(released[0]), 5 + 13)
    test.assert_eq(pb_of(released[0]), 1)
    test.assert_eq(released[1], bytes_of(0x0C31, 0))
    test.assert(queue_acl(var c, true, 40))
    test.assert_eq(list.len(packets_of(drain(var c))), 2)
    // Reset: the Host's size is forgotten and the packet goes whole.
    test.assert_eq(run(var c, 0x0C03, []), bytes_of(0x0C03, 0))
    test.assert(queue_acl(var c, true, 100))
    test.assert_eq(list.len(packets_of(drain(var c))), 1)
    // Reset cleared the flow control too: it can be turned on again, and counts nothing without a size.
    test.assert_eq(run(var c, 0x0C31, [1]), bytes_of(0x0C31, 0))
    test.assert_eq(ctl_pool.pool_host_free(var c.pool), 0)
