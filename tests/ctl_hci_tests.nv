@test
fn test_a_lost_stream_is_silent_until_reset_and_reset_is_answered()
    var c = fresh()
    ctl_hci.ctl_rx(var c, 0x00)
    let _a = drain(var c)
    // A command in the lost stream is not run.
    for b in [0x01, 0x09, 0x10, 0x00, 0x55, 0x66]
        ctl_hci.ctl_rx(var c, b)
    test.assert(not ctl_hci.ctl_step(var c))
    test.assert(not ctl_hci.ctl_tx_pending(var c))
    // The Reset command is.
    for b in [0x01, 0x03, 0x0C, 0x00]
        ctl_hci.ctl_rx(var c, b)
    test.assert(ctl_hci.ctl_step(var c))
    test.assert_eq(drain(var c), bytes_of(ctl_hci.OP_RESET, 0))
    test.assert(not h4_rx.h4_is_lost(var c.rx))
    test.assert_eq(run(var c, ctl_hci.OP_READ_BD_ADDR, [])[2], 10)

