    air.peer_count = -1
    sim_run(var c, var air, 200000)
    test.assert_eq(count_tx(var air, ll_pdu.SCAN_RSP), 0)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_the_filter_policy_gates_scan_requests_by_the_accept_list()
    var c = fresh()
    advertise(var c, 0, 7, 1)
    var air = air_new()
    air.peer_ch = 37
    air.peer_req = peer_pdu(ll_pdu.SCAN_REQ, 0)
    air.peer_count = -1
    sim_run(var c, var air, 200000)
    test.assert_eq(count_tx(var air, ll_pdu.SCAN_RSP), 0)
    // The peer is added to the list, with advertising off while the list changes:
    // it is answered.
    test_off(var c)
    fal_add(var c, 0, 0x40)
    test.assert_eq(status_of(var c, 0x200A, [1]), 0)
    sim_run(var c, var air, 600000)
    test.assert(count_tx(var air, ll_pdu.SCAN_RSP) > 0)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_a_connection_request_is_counted_and_advertising_goes_on()
    var c = fresh()
    advertise(var c, 0, 7, 0)
    var air = air_new()
    air.peer_ch = 38
    air.peer_req = peer_pdu(ll_pdu.CONNECT_IND, 0)
    air.peer_count = 1
    sim_run(var c, var air, 200000)
    test.assert_eq(c.adv.connect_inds, 1)
    test.assert_eq(count_tx(var air, ll_pdu.SCAN_RSP), 0)
    test.assert(c.adv.enabled)
    test.assert(list.len(air.tx_t) > 6)
    // No event reports a connection.
    test.assert_eq(list.len(events_of(heard(var c, var air))), 0)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_high_duty_directed_advertising_times_out_and_tells_the_host()
    var c = fresh()
    test.assert_eq(status_of(var c, 0x2006, adv_params(0, 0, 1, 0, 0, 7, 0)), 0)
    test.assert_eq(status_of(var c, 0x200A, [1]), 0)
    var air = air_new()
    sim_run(var c, var air, 2000000)
    test.assert(not c.adv.enabled)
    // Events ran back to back until 1.28 s: no PDU on a channel is more than
    // 3.75 ms after the last on that channel.
    var last37 = -1
    for i in 0..list.len(air.tx_t)
        test.assert_eq(air.tx_ty[i], ll_pdu.ADV_DIRECT_IND)
        if air.tx_ch[i] == 37
            if last37 >= 0
                test.assert(air.tx_t[i] - last37 <= 3750)
            last37 = air.tx_t[i]
    let end = air.tx_t[list.len(air.tx_t) - 1]
    test.assert(end >= 1280000 - 4000)
    test.assert(end <= 1280000 + 4000)
    // LE Connection Complete with Advertising Timeout.
    let evs = events_of(heard(var c, var air))
    test.assert_eq(list.len(evs), 1)
    test.assert_eq(evs[0][1], 0x3E)
    test.assert_eq(evs[0][2], 19)
    test.assert_eq(evs[0][3], 0x01)
    test.assert_eq(evs[0][4], 0x3C)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_low_duty_directed_advertising_names_the_target_and_has_no_timeout()
    var c = fresh()
    test.assert_eq(status_of(var c, 0x2006, adv_params(0x20, 0x20, 4, 0, 1, 7, 0)), 0)
    test.assert_eq(status_of(var c, 0x200A, [1]), 0)
    var air = air_new()
    sim_run(var c, var air, 3000000)
    test.assert(c.adv.enabled)
    var p = c.adv.pdu
    test.assert_eq(ll_pdu.pdu_type(var p), ll_pdu.ADV_DIRECT_IND)
    test.assert_eq(ll_pdu.pdu_rx_add(var p), 1)
    test.assert_eq(ll_pdu.pdu_get(var p, 8), 0x70)
    test.assert_eq(ll_pdu.pdu_get(var p, 13), 0x75)

@test
fn test_disabling_stops_the_events()
    var c = fresh()
    advertise(var c, 3, 7, 0)
    var air = air_new()
    sim_run(var c, var air, 100000)
    let before = list.len(air.tx_t)
    test.assert(before > 0)
    test.assert_eq(status_of(var c, 0x200A, [0]), 0)
    sim_run(var c, var air, 1000000)
    test.assert_eq(list.len(air.tx_t), before)

// ── Scanning on the air ─────────────────────────────────────────────

@test
fn test_a_passive_scanner_reports_the_advertisements_it_hears()
    var c = fresh()
    scan_on(var c, 0, 16, 16, 0, 0)
    var air = air_new()
    // Continuous scanning: 10 ms windows rotate 37, 38, 39.
    var p1 = pdu_addr(ll_pdu.ADV_IND, 1, 0x30, 5)
    var p2 = pdu_addr(ll_pdu.ADV_NONCONN_IND, 0, 0x50, 0)
    air_hear(var air, 2000, 37, p1, no_pdu(), -61)
    air_hear(var air, 12000, 38, p2, no_pdu(), -72)
    sim_run(var c, var air, 30000)
    let r = reports_of(heard(var c, var air))
    test.assert_eq(list.len(r), 2)
    // Num_Reports 1, Event_Type, Address_Type, Address, Data_Length, Data, RSSI.
    test.assert_eq(r[0][4], 1)
    test.assert_eq(r[0][5], 0)
    test.assert_eq(r[0][6], 1)
    test.assert_eq(r[0][7], 0x30)
    test.assert_eq(r[0][12], 0x35)
    test.assert_eq(r[0][13], 5)
    test.assert_eq(r[0][14], 0xD0)
    test.assert_eq(r[0][19], 0xC3)
    test.assert_eq(r[0][2], 17)
    test.assert_eq(r[1][5], 3)
    test.assert_eq(r[1][6], 0)
    test.assert_eq(r[1][13], 0)
    test.assert_eq(r[1][14], 0xB8)

@test
fn test_a_pdu_is_judged_by_ctl_scan_decide_and_reported_by_ctl_scan_note()
    var c = fresh()
    scan_on(var c, 0, 16, 16, 0, 0)
    var air = air_new()
    var p = pdu_addr(ll_pdu.ADV_IND, 1, 0x30, 5)
    ctl_hci.ctl_set_time(var c, 2000)
    // The judgement takes the PDU in and asks for no SCAN_REQ of a passive scanner; nothing is reported until the second part.
    let act = ctl_hci.ctl_scan_decide(var c, var p, p.n)
    test.assert((act & ll_scan.ACT_ACCEPTED) != 0)
    test.assert_eq(act & ll_scan.ACT_REQUEST, 0)
    test.assert_eq(list.len(reports_of(heard(var c, var air))), 0)
    ctl_hci.ctl_scan_note(var c, var p, -61)
    let r = reports_of(heard(var c, var air))
    test.assert_eq(list.len(r), 1)
    test.assert_eq(r[0][6], 1)
    test.assert_eq(r[0][7], 0x30)
    test.assert_eq(r[0][19], 0xC3)

@test
fn test_a_scanner_hears_only_the_channel_of_the_window()
    var c = fresh()
    scan_on(var c, 0, 16, 16, 0, 0)
    var air = air_new()
    var p = pdu_addr(ll_pdu.ADV_IND, 0, 0x30, 0)
    // The window at 0 is on 37, the window at 10 ms on 38.
    air_hear(var air, 2000, 38, p, no_pdu(), -50)
    air_hear(var air, 4000, 39, p, no_pdu(), -50)
    sim_run(var c, var air, 9000)
    test.assert_eq(list.len(reports_of(heard(var c, var air))), 0)

@test
fn test_duplicates_are_filtered_when_the_host_asks()
    var c = fresh()
    scan_on(var c, 0, 16, 16, 0, 1)
    var air = air_new()
    var p = pdu_addr(ll_pdu.ADV_IND, 0, 0x30, 0)
    for k in 0..6
        air_hear(var air, 1000 + k * 30000, 37 + k * 3 % 3, p, no_pdu(), -50)
    // All on 37 at 1, 31, 61... ms: only those inside a window on 37 are
    // heard; the windows on 37 are at 0, 30, 60, ... ms.
    sim_run(var c, var air, 200000)
    test.assert_eq(list.len(reports_of(heard(var c, var air))), 1)
    test.assert(c.scan.duplicates >= 1)

@test
fn test_every_advertisement_is_reported_without_the_filter()
    var c = fresh()
    scan_on(var c, 0, 16, 16, 0, 0)
    var air = air_new()
    var p = pdu_addr(ll_pdu.ADV_IND, 0, 0x30, 0)
    for k in 0..4
        air_hear(var air, 1000 + k * 30000, 37, p, no_pdu(), -50)
    sim_run(var c, var air, 200000)
    test.assert_eq(list.len(reports_of(heard(var c, var air))), 4)

@test
fn test_the_scan_window_bounds_what_is_heard()
    var c = fresh()
    // Interval 100 ms, window 20 ms.
    scan_on(var c, 0, 160, 32, 0, 0)
    var air = air_new()
    var p = pdu_addr(ll_pdu.ADV_IND, 0, 0x30, 0)
    // On 37 in the first window (0 to 20 ms), after it, and in the window on
    // 37 again at 300 ms.
    air_hear(var air, 5000, 37, p, no_pdu(), -50)
    air_hear(var air, 40000, 37, p, no_pdu(), -50)
    air_hear(var air, 305000, 37, p, no_pdu(), -50)
    air_hear(var air, 325000, 37, p, no_pdu(), -50)
    sim_run(var c, var air, 400000)
    test.assert_eq(list.len(reports_of(heard(var c, var air))), 2)

@test
fn test_filtered_scanning_reports_only_listed_devices()
    var c = fresh()
    fal_add(var c, 1, 0x50)
    scan_on(var c, 0, 16, 16, 1, 0)
    var air = air_new()
    var listed = pdu_addr(ll_pdu.ADV_IND, 1, 0x50, 0)
    var other = pdu_addr(ll_pdu.ADV_IND, 1, 0x60, 0)
    var wrong_type = pdu_addr(ll_pdu.ADV_IND, 0, 0x50, 0)
    air_hear(var air, 1000, 37, other, no_pdu(), -50)
    air_hear(var air, 3000, 37, listed, no_pdu(), -50)
    air_hear(var air, 5000, 37, wrong_type, no_pdu(), -50)
    sim_run(var c, var air, 9000)
    let r = reports_of(heard(var c, var air))
    test.assert_eq(list.len(r), 1)
    test.assert_eq(r[0][7], 0x50)
    test.assert_eq(r[0][6], 1)

@test
fn test_an_active_scanner_asks_t_ifs_after_the_advertisement_and_reports_the_answer()
    var c = fresh()
    scan_on(var c, 1, 16, 16, 0, 0)
    var air = air_new()
    var adv = pdu_addr(ll_pdu.ADV_IND, 0, 0x30, 2)
    var rsp = pdu_addr(ll_pdu.SCAN_RSP, 0, 0x30, 4)
    air_hear(var air, 2000, 37, adv, rsp, -55)
    sim_run(var c, var air, 9000)
    test.assert_eq(count_tx(var air, ll_pdu.SCAN_REQ), 1)
    let end = 2000 + ll_pdu.airtime_us(adv.n)
    test.assert_eq(air.tx_t[0], end + 150)
    test.assert_eq(air.tx_ch[0], 37)
    // ScanA is the public address, AdvA the advertiser's.
    var req = c.scan.req
    test.assert_eq(ll_pdu.pdu_get(var req, 2), 0x10)
    test.assert_eq(ll_pdu.pdu_get(var req, 8), 0x30)
    let r = reports_of(heard(var c, var air))
    test.assert_eq(list.len(r), 2)
    test.assert_eq(r[0][5], 0)
    test.assert_eq(r[1][5], 4)
    test.assert_eq(r[1][13], 4)

@test
fn test_a_passive_scanner_sends_nothing()
    var c = fresh()
    scan_on(var c, 0, 16, 16, 0, 0)
    var air = air_new()
    var adv = pdu_addr(ll_pdu.ADV_IND, 0, 0x30, 2)
    var rsp = pdu_addr(ll_pdu.SCAN_RSP, 0, 0x30, 4)
    air_hear(var air, 2000, 37, adv, rsp, -55)
    sim_run(var c, var air, 9000)
    test.assert_eq(list.len(air.tx_t), 0)

@test
fn test_an_active_scanner_does_not_ask_a_device_that_has_answered()
    var c = fresh()
    scan_on(var c, 1, 16, 16, 0, 0)
    var air = air_new()
    var adv = pdu_addr(ll_pdu.ADV_IND, 0, 0x30, 2)
    var rsp = pdu_addr(ll_pdu.SCAN_RSP, 0, 0x30, 4)
    for k in 0..4
        air_hear(var air, 2000 + k * 30000, 37, adv, rsp, -55)
    sim_run(var c, var air, 200000)
    test.assert_eq(count_tx(var air, ll_pdu.SCAN_REQ), 1)

@test
fn test_a_missing_scan_response_is_a_failure_and_the_scanner_asks_again()
    var c = fresh()
    scan_on(var c, 1, 16, 16, 0, 0)
    var air = air_new()
    var adv = pdu_addr(ll_pdu.ADV_IND, 0, 0x30, 2)
    air_hear(var air, 2000, 37, adv, no_pdu(), -55)
    air_hear(var air, 32000, 37, adv, no_pdu(), -55)
    sim_run(var c, var air, 100000)
    test.assert_eq(c.scan.misses, 2)
    test.assert_eq(count_tx(var air, ll_pdu.SCAN_REQ), 2)
    // Two failures in a row double the backoff limit.
    test.assert_eq(c.scan.upper, 2)

@test
fn test_an_event_mask_without_the_report_event_keeps_the_host_quiet()
    var c = fresh()
    // LE Set Event Mask with every bit but the advertising report's.
    test.assert_eq(status_of(var c, 0x2001, [0x1D, 0, 0, 0, 0, 0, 0, 0]), 0)
    scan_on(var c, 0, 16, 16, 0, 0)
    var air = air_new()
    var p = pdu_addr(ll_pdu.ADV_IND, 0, 0x30, 0)
    air_hear(var air, 1000, 37, p, no_pdu(), -50)
    sim_run(var c, var air, 9000)
    test.assert_eq(list.len(events_of(heard(var c, var air))), 0)
    test.assert_eq(c.scan.reports, 1)

@test
fn test_reports_leave_a_slot_for_the_next_commands_answer()
    var c = fresh()
    scan_on(var c, 0, 16, 16, 0, 0)
    var air = air_new()
    air.host_reads = false
    for k in 0..8
        var p = pdu_addr(ll_pdu.ADV_IND, 0, 0x30 + k * 8, 0)
        air_hear(var air, 1000 + k * 500, 37, p, no_pdu(), -50)
    // The Host reads nothing while the events pile up.
    sim_run(var c, var air, 9000)
    test.assert_eq(ctl_pool.pool_free(var c.pool), 1)
    test.assert(c.dropped_events > 0)
    // The Host can still send a command and get its answer.
    let r = heard(var c, var air)
    test.assert(list.len(r) > 0)
    test.assert_eq(status_of(var c, 0x200C, [0, 0]), 0)

// ── Advertising and scanning together ───────────────────────────────

@test
fn test_advertising_events_keep_their_time_while_scanning()
    var c = fresh()
    advertise(var c, 3, 7, 0)
    scan_on(var c, 0, 16, 16, 0, 0)
    var air = air_new()
    // A peer that advertises every 7 ms on all three channels.
    var p = pdu_addr(ll_pdu.ADV_IND, 0, 0x30, 0)
    for k in 0..300
        air_hear(var air, 3000 + k * 7000, 37 + k % 3, p, no_pdu(), -50)
    sim_run(var c, var air, 2000000)
    let starts = event_starts(var air, 37)
    test.assert(list.len(starts) > 10)
    // The interval of 20 ms plus the delay is kept between events.
    for i in 1..list.len(starts)
        let d = starts[i] - starts[i - 1]
        test.assert(d >= 20000)
        test.assert(d <= 30000)
    test.assert(c.scan.reports > 20)
    // Every event is whole.
    test.assert_eq(count_tx(var air, ll_pdu.ADV_NONCONN_IND) % 3, 0)

@test
fn test_a_scan_window_too_short_to_use_before_an_event_is_skipped()
    var c = fresh()
    advertise(var c, 3, 7, 0)
    scan_on(var c, 0, 16, 16, 0, 0)
    var air = air_new()
    sim_run(var c, var air, 1000000)
    // No scan slice overlapped an advertising PDU: nothing was sent while the
    // arbiter held the radio for the scanner.
    test.assert(list.len(air.tx_t) > 30)
    for i in 1..list.len(air.tx_t)
        test.assert(air.tx_t[i] > air.tx_t[i - 1])

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_the_filter_accept_list_cannot_change_while_advertising_uses_it()
    var c = fresh()
    fal_add(var c, 0, 0x40)
    // Advertising that ignores the list leaves it free.
    advertise(var c, 0, 7, 0)
    test.assert_eq(status_of(var c, 0x2011, [0, 1, 2, 3, 4, 5, 6]), 0)
    test_off(var c)
    // A policy that reads the list locks it while advertising is on.
    advertise(var c, 0, 7, 1)
    test.assert_eq(status_of(var c, 0x2011, [0, 1, 2, 3, 4, 5, 6]), 0x0C)
    test.assert_eq(status_of(var c, 0x2012, [0, 1, 2, 3, 4, 5, 6]), 0x0C)
    test.assert_eq(status_of(var c, 0x2010, []), 0x0C)
    test_off(var c)
    test.assert_eq(status_of(var c, 0x2012, [0, 1, 2, 3, 4, 5, 6]), 0)
    test.assert_eq(status_of(var c, 0x2010, []), 0)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_directed_advertising_ignores_the_policy_so_the_list_stays_free()
    var c = fresh()
    advertise(var c, 4, 7, 3)
    test.assert_eq(status_of(var c, 0x2011, [0, 1, 2, 3, 4, 5, 6]), 0)

@test
fn test_the_filter_accept_list_cannot_change_while_scanning_uses_it()
    var c = fresh()
    scan_on(var c, 0, 16, 16, 0, 0)
    test.assert_eq(status_of(var c, 0x2011, [0, 1, 2, 3, 4, 5, 6]), 0)
    test.assert_eq(status_of(var c, 0x200C, [0, 0]), 0)
    scan_on(var c, 0, 16, 16, 1, 0)
    test.assert_eq(status_of(var c, 0x2011, [1, 1, 2, 3, 4, 5, 6]), 0x0C)
    test.assert_eq(status_of(var c, 0x2010, []), 0x0C)
    test.assert_eq(status_of(var c, 0x200C, [0, 0]), 0)
    test.assert_eq(status_of(var c, 0x2010, []), 0)

@when(noble_controller.CONFIG.CTL_PERIPHERAL > 0)
@test
fn test_a_scan_request_the_policy_refused_is_counted_with_its_sender()
    var c = fresh()
    advertise(var c, 0, 7, 1)
    var air = air_new()
    air.peer_ch = 38
    air.peer_req = peer_pdu(ll_pdu.SCAN_REQ, 0)
    air.peer_count = -1
    sim_run(var c, var air, 300000)
    test.assert(c.adv.filtered > 3)
    test.assert_eq(c.adv.filt_type as Int, 0)
    test.assert_eq(c.adv.filt_addr[0] as Int, 0x40)
    test.assert_eq(c.adv.filt_addr[5] as Int, 0x45)
    test.assert_eq(count_tx(var air, ll_pdu.SCAN_RSP), 0)
