// src/ll_cs_drbg.nv — the random bit generator of Channel Sounding: the AES-based generator whose output both devices of a procedure draw
// the channels, the access addresses, the sequences, the tone extension slots and the antenna paths from.
//
// [Vol 6] Part E, Section 3 and Part H, Section 4.8.  The two devices hold the same key and nonce, which they derive from the values of the
// Security Start procedure (`drbg_instantiate`: CS_IV, CS_IN and CS_PV, 16, 8 and 16 octets).  A block of 128 bits is the AES-128
// encryption (`Cipher.block`) of the key `K` over the nonce `V` with three counters added: the step counter (octets 12 and 13 of `V`, most
// significant first), the transaction identifier (octet 14) and the transaction counter (octet 15), each added without a carry into the
// next.  A transaction draws its bits from the most significant end of a block; the bits it leaves stay for the next transaction of the
// same identifier, and a transaction that needs more than are left discards them and takes a new block.  `drbg_backtrack` ratchets the key
// and the nonce at the start of every procedure after the first.
//
// A range of 1 to 255 is drawn with `drbg_hr1`, the function of Part H, Section 4.8.1.
//
// Every 128-bit value is held most significant octet first, the order of [Vol 6] Part C, Section 7 and of `Cipher.block`.  A failure of
// the cipher sets `fault` and leaves the draws zero.  No function here allocates.

use ll_cipher

// The transaction identifiers of Part H, Table 4.16.
const TID_HOP_NON0 = 0
const TID_HOP_MODE0 = 1
const TID_SUBMODE = 2
const TID_TONE_EXT = 3
const TID_ANTENNA = 4
const TID_ACCESS_ADDRESS = 5
const TID_MARKER_POSITION = 6
const TID_MARKER_SIGNAL = 7
const TID_RANDOM_SEQUENCE = 8
const TID_BACKTRACKING = 9

// The identifiers that draw bits and so keep a buffer of the bits they have left: 0 to 8.
const TIDS = 9

// The octets of a block.
const BLOCK = 16

// The generator of one connection: the key and the nonce, the procedure it is in, and for each transaction identifier the block it
// draws from, the bits left in it, the transaction counter of that block and the step it was made at (-1 before the first).
@value
struct CsDrbg
    k: Vec[u8; 16]
    v: Vec[u8; 16]
    bits: Vec[u8; 144]
    left: Vec[u8; 9]
    tc: Vec[u8; 9]
    at: Vec[Int; 9]
    count: Int
    fault: Bool

// A generator with no key, which draws zeros until `drbg_instantiate` has run.
@tier(embedded)
@no_alloc
fn drbg_new() -> CsDrbg
    var d = CsDrbg { k: Vec.new(),
        v: Vec.new(),
        bits: Vec.new(),
        left: Vec.new(),
        tc: Vec.new(),
        at: Vec.new(),
        count: 0,
        fault: false }
    for _ in 0..16
        let _a = d.k.push(0)
        let _b = d.v.push(0)
    for _ in 0..144
        let _c = d.bits.push(0)
    for _ in 0..9
        let _d = d.left.push(0)
        let _e = d.tc.push(0)
        let _f = d.at.push(-1)
    d

// Forget the bits left in every buffer, as at the start of a procedure.
@tier(embedded)
@no_alloc
fn drbg_forget(var d: CsDrbg)
    for t in 0..9
        d.left[t] = 0
        d.tc[t] = 0
        d.at[t] = -1

// ── The AES toolbox ─────────────────────────────────────────────────

// The block `blk` encrypted in place under `key`; false when the cipher failed.
@tier(embedded)
fn enc<C: Cipher[e]>(var cc: C, var key: Vec[u8; 16], var blk: Vec[u8; 16]) -> Bool [e]
    var k: Vec[u8; 16] = Vec.new()
    for i in 0..16
        let _a = k.push(key[i])
    cc.block(var k, var blk)

// f7 ([Vol 6] Part E, Section 3.1.2): the 128-bit chain of the `n` blocks of `msg` under `key`: each block is added (exclusive or) to
// the result of the one before and encrypted.
@tier(embedded)
fn f7<C: Cipher[e]>(var cc: C, var key: Vec[u8; 16], var msg: Vec[u8; 80], n: Int,
                    var out: Vec[u8; 16]) -> Bool [e]
    for i in 0..16
        out[i] = 0
    for b in 0..n
        for i in 0..16
            out[i] = out[i] ^ msg[b * 16 + i]
        if not enc(var cc, var key, var out)
            return false
    true

// f8 ([Vol 6] Part E, Section 3.1.3): the 32 octets of seed material from the 40 octets `iv`, `nc` and `pv`.
@tier(embedded)
fn f8<C: Cipher[e]>(var cc: C, var iv: Vec[u8; 16], var nc: Vec[u8; 8], var pv: Vec[u8; 16],
                    var sm: Vec[u8; 32]) -> Bool [e]
    var key: Vec[u8; 16] = Vec.new()
    var msg: Vec[u8; 80] = Vec.new()
    var k2: Vec[u8; 16] = Vec.new()
    var x: Vec[u8; 16] = Vec.new()
    for i in 0..16
        let _a = key.push(i as u8)
        let _b = k2.push(0)
        let _c = x.push(0)
    for _ in 0..80
        let _d = msg.push(0)
    msg[19] = 0x28
    msg[23] = 0x20
    for i in 0..16
        msg[24 + i] = iv[i]
        msg[48 + i] = pv[i]
    for i in 0..8
        msg[40 + i] = nc[i]
    msg[64] = 0x80
    if not f7(var cc, var key, var msg, 5, var k2)
        return false
    msg[3] = 1
    if not f7(var cc, var key, var msg, 5, var x)
        return false
    if not enc(var cc, var k2, var x)
        return false
    for i in 0..16
        sm[i] = x[i]
    if not enc(var cc, var k2, var x)
        return false
    for i in 0..16
        sm[16 + i] = x[i]
    true

// Add one to octet 15 of `v`, without a carry.
@tier(embedded)
@no_alloc
fn v_next(var v: Vec[u8; 16])
    v[15] = ((v[15] as Int + 1) & 0xFF) as u8

// f9 ([Vol 6] Part E, Section 3.1.4): the key and the nonce advanced two blocks and mixed with the 32 octets `sm`.
@tier(embedded)
fn f9<C: Cipher[e]>(var cc: C, var sm: Vec[u8; 32], var k: Vec[u8; 16],
                    var v: Vec[u8; 16]) -> Bool [e]
    var x: Vec[u8; 32] = Vec.new()
    var b: Vec[u8; 16] = Vec.new()
    for i in 0..32
        let _a = x.push(0)
    for _ in 0..16
        let _b = b.push(0)
    for half in 0..2
        v_next(var v)
        for i in 0..16
            b[i] = v[i]
        if not enc(var cc, var k, var b)
            return false
        for i in 0..16
            x[half * 16 + i] = b[i]
    for i in 0..16
        k[i] = x[i] ^ sm[i]
        v[i] = x[16 + i] ^ sm[16 + i]
    true

// ── The generator ───────────────────────────────────────────────────

// h9 ([Vol 6] Part E, Section 3.1.5): key and nonce of a procedure series from the values the Security Start procedure produced, `iv` the
// Peripheral's 8 octets then the Central's, `nc` the Peripheral's 4 then the Central's, `pv` the Peripheral's 8 then the Central's.  The
// procedure counter is 0 and no bits are left.
@tier(embedded)
fn drbg_instantiate<C: Cipher[e]>(var cc: C, var d: CsDrbg, var iv: Vec[u8; 16], var nc: Vec[u8; 8],
                                  var pv: Vec[u8; 16]) -> Bool [e]
    var sm: Vec[u8; 32] = Vec.new()
    for _ in 0..32
        let _a = sm.push(0)
    d.fault = false
    d.count = 0
    drbg_forget(var d)
    if not f8(var cc, var iv, var nc, var pv, var sm)
        d.fault = true
        return false
    for i in 0..16
        d.k[i] = 0
        d.v[i] = 0
    if not f9(var cc, var sm, var d.k, var d.v)
        d.fault = true
        return false
    true

// The key and the nonce LE CS Test sets ([Vol 4] Part E, Section 7.8.142, DRBG_Nonce): a key of zeros, and a nonce of zeros except octets 14 and
// 15, which hold the 16 bits of `nonce`, the most significant bit in the most significant bit of octet 14.  The procedure counter is 0 and no
// bits are left.
@tier(embedded)
@no_alloc
fn drbg_load_test(var d: CsDrbg, nonce: Int)
    for i in 0..16
        d.k[i] = 0
        d.v[i] = 0
    d.v[14] = ((nonce >>> 8) & 0xFF) as u8
    d.v[15] = (nonce & 0xFF) as u8
    d.fault = false
    d.count = 0
    drbg_forget(var d)

// The backtracking resistance of [Vol 6] Part E, Section 3.1.7, at the start of the procedure after the one the generator was in: the key
// and the nonce advance with the transaction identifier 9 added to the nonce and no seed material, and no bits are left.
@tier(embedded)
fn drbg_backtrack<C: Cipher[e]>(var cc: C, var d: CsDrbg) -> Bool [e]
    var sm: Vec[u8; 32] = Vec.new()
    for _ in 0..32
        let _a = sm.push(0)
    d.v[14] = ((d.v[14] as Int + TID_BACKTRACKING) & 0xFF) as u8
    d.count = d.count + 1
    drbg_forget(var d)
    if not f9(var cc, var sm, var d.k, var d.v)
        d.fault = true
        return false
    true

// Make the block of the identifier `tid` at `step` and keep it as that identifier's bits.  The counter of the block starts at 0 for the
// first block of an identifier at a step and counts up for each further block at the same step.
@tier(embedded)
fn drbg_refill<C: Cipher[e]>(var cc: C, var d: CsDrbg, tid: Int, step: Int) [e]
    var tcv = 0
    if d.at[tid] == step
        tcv = (d.tc[tid] as Int + 1) & 0xFF
    d.tc[tid] = tcv as u8
    d.at[tid] = step
    var blk: Vec[u8; 16] = Vec.new()
    for i in 0..16
        let _a = blk.push(d.v[i])
    let s = (((d.v[12] as Int << 8) | d.v[13] as Int) + step) & 0xFFFF
    blk[12] = (s >>> 8) as u8
    blk[13] = (s & 0xFF) as u8
    blk[14] = ((d.v[14] as Int + tid) & 0xFF) as u8
    blk[15] = ((d.v[15] as Int + tcv) & 0xFF) as u8
    if not enc(var cc, var d.k, var blk)
        d.fault = true
    for i in 0..16
        d.bits[tid * 16 + i] = blk[i]
    d.left[tid] = 128

// Make sure the buffer of `tid` holds at least `n` bits, 1 to 128, taking a new block when it does not.
@tier(embedded)
fn drbg_need<C: Cipher[e]>(var cc: C, var d: CsDrbg, tid: Int, step: Int, n: Int) [e]
    if (d.left[tid] as Int) < n
        drbg_refill(var cc, var d, tid, step)

// Take `n` bits, 1 to 32, from the buffer of `tid`, the first bit the most significant.  The caller has made sure they are there.
@tier(embedded)
@no_alloc
fn drbg_take(var d: CsDrbg, tid: Int, n: Int) -> Int
    let at = 128 - d.left[tid] as Int
    var v = 0
    for i in 0..n
        let pos = at + i
        let octet = d.bits[tid * 16 + pos / 8] as Int
        v = (v << 1) | ((octet >>> (7 - pos % 8)) & 1)
    d.left[tid] = (d.left[tid] as Int - n) as u8
    v

// `n` bits, 1 to 32, for `tid` at `step`: CS_DRBG ([Vol 6] Part E, Section 3.1.6).
@tier(embedded)
fn drbg_bits<C: Cipher[e]>(var cc: C, var d: CsDrbg, tid: Int, step: Int, n: Int) -> Int [e]
    drbg_need(var cc, var d, tid, step, n)
    drbg_take(var d, tid, n)

// A number from 0 to `r` - 1, `r` from 1 to 255, for `tid` at `step`: hr1 ([Vol 6] Part H, Section 4.8.1).  The first 8 bits give
// `t = r * x`; unless the low octet of `t` is below 256 modulo `r`, the answer is the high octet.  Otherwise a second octet `y` extends
// it to the 16 bits `y * 256 + x` scaled by `r` over 65536, which the text writes as `(256 * y * r + t) / 65536`.
@tier(embedded)
fn drbg_hr1<C: Cipher[e]>(var cc: C, var d: CsDrbg, tid: Int, step: Int, r: Int) -> Int [e]
    if r == 1
        return 0
    let t = r * drbg_bits(var cc, var d, tid, step, 8)
    if (t & 0xFF) < 256 % r
        let y = drbg_bits(var cc, var d, tid, step, 8)
        return (256 * y * r + t) >>> 16
    t >>> 8
