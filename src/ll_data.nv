// src/ll_data.nv — the Link Layer data channel PDUs: the header
// bits of a connection event's packet, and the LL Control PDUs the
// Peripheral role sends and reads.
//
// [Vol 6] Part B, Section 2.4: a data channel PDU is a 2-octet header and a
// payload.  Octet 0 holds the LLID in bits 0 and 1, NESN in bit 2, SN in
// bit 3, MD in bit 4 and CP in bit 5; octet 1 holds the payload length.
// Without the Data Length Extension the payload is 0 to 27 octets.  An LLID
// of 1 is a continuation fragment or an empty PDU, 2 the start of an L2CAP
// message or a complete one, 3 an LL Control PDU, whose first payload octet is
// the opcode (Section 2.4.2).
//
// A data channel PDU is held in the `Pdu` of `ll_pdu.nv`, which is big enough,
// and the functions here read and write the data header on it.
//
// No function here allocates.

use ll_pdu

// The functions below take the PDU as a `var` parameter even where they only read
// it, which passes its address.  A plain parameter is a copy, and a copy of a
// struct of this size on every call costs time and stack.

// The LLID values.
const LLID_CONTINUE = 1
const LLID_START = 2
const LLID_CONTROL = 3

// The bits of header octet 0.
const NESN_BIT = 0x04
const SN_BIT = 0x08
const MD_BIT = 0x10

// The longest payload without the Data Length Extension, and the octets of a
// PDU of that length with its header.
const DATA_PAYLOAD_MAX = 27
const DATA_PDU_OCTETS = 29

// The longest payload with the Data Length Extension (251 octets, [Vol 6] Part B,
// Section 4.5.10), and the octets of a PDU with that payload, its header and the MIC
// of an encrypted one.
const PAYLOAD_EXT_MAX = 251
const DATA_PDU_EXT_OCTETS = 257

// The opcodes of the LL Control PDUs this Link Layer sends or answers
// ([Vol 6] Part B, Table 2.22).
const OP_CONNECTION_UPDATE_IND = 0x00
const OP_CHANNEL_MAP_IND = 0x01
const OP_TERMINATE_IND = 0x02
const OP_ENC_REQ = 0x03
const OP_ENC_RSP = 0x04
const OP_START_ENC_REQ = 0x05
const OP_START_ENC_RSP = 0x06
const OP_UNKNOWN_RSP = 0x07
const OP_FEATURE_REQ = 0x08
const OP_FEATURE_RSP = 0x09
const OP_PAUSE_ENC_REQ = 0x0A
const OP_PAUSE_ENC_RSP = 0x0B
const OP_VERSION_IND = 0x0C
const OP_REJECT_IND = 0x0D
const OP_PERIPHERAL_FEATURE_REQ = 0x0E
const OP_CONNECTION_PARAM_REQ = 0x0F
const OP_CONNECTION_PARAM_RSP = 0x10
const OP_REJECT_EXT_IND = 0x11
const OP_PING_REQ = 0x12
const OP_PING_RSP = 0x13
const OP_LENGTH_REQ = 0x14
const OP_LENGTH_RSP = 0x15
const OP_PHY_REQ = 0x16
const OP_PHY_RSP = 0x17
const OP_PHY_UPDATE_IND = 0x18
const OP_MIN_USED_CHANNELS_IND = 0x19
const OP_CIS_REQ = 0x1F
const OP_CIS_RSP = 0x20
const OP_CIS_IND = 0x21
const OP_CIS_TERMINATE_IND = 0x22
const OP_CLOCK_ACCURACY_REQ = 0x1D
const OP_CLOCK_ACCURACY_RSP = 0x1E
const OP_POWER_CONTROL_REQ = 0x23
const OP_POWER_CONTROL_RSP = 0x24
const OP_POWER_CHANGE_IND = 0x25
const OP_SUBRATE_REQ = 0x26
const OP_SUBRATE_IND = 0x27
const OP_PERIODIC_SYNC_IND = 0x1C
const OP_PERIODIC_SYNC_WR_IND = 0x2A
const OP_FEATURE_EXT_REQ = 0x2B
const OP_FEATURE_EXT_RSP = 0x2C
const OP_FRAME_SPACE_REQ = 0x3B
const OP_FRAME_SPACE_RSP = 0x3C
const OP_CONNECTION_RATE_REQ = 0x3E
const OP_CONNECTION_RATE_IND = 0x3F

// The payload length of each LL Control PDU this Link Layer reads, the opcode
// included, -1 for an opcode it does not read.  The two PDUs of Connection Rate (27 and 15
// octets) are read by `ll_link.rate_rx`, in a build that has the feature, and are unknown to one without; the two of Frame Space Update (8 and 6
// octets) likewise by `ll_link.fs_rx`.
@tier(embedded)
fn ctrl_payload_len(opcode: Int) -> Int
    match opcode
        0x0  => 12
        0x1  => 8
        0x2  => 2
        0x3  => 23
        0x4  => 13
        0x5  => 1
        0x6  => 1
        0x7  => 2
        0x8  => 9
        0x9  => 9
        0xa  => 1
        0xb  => 1
        0xc  => 6
        0xd  => 2
        0xe  => 9
        0xf  => 24
        0x10 => 24
        0x11 => 3
        0x12 => 1
        0x13 => 1
        0x14 => 9
        0x15 => 9
        0x16 => 3
        0x17 => 3
        0x18 => 5
        0x19 => 3
        0x1f => 36
        0x20 => 9
        0x21 => 16
        0x22 => 4
        0x1d => 2
        0x1e => 2
        0x23 => 4
        0x24 => 5
        0x25 => 5
        0x26 => 11
        0x27 => 11
        0x1c => 35
        0x2a => 43
        0x2b => 27
        0x2c => 27
        _    => -1

// The LLID of a data PDU.
@tier(embedded)
fn dpdu_llid(var p: Pdu) -> Int
    p.b[0] as Int & 0x03

// The payload length the header claims.
@tier(embedded)
fn dpdu_len(var p: Pdu) -> Int
    p.b[1] as Int

// The opcode of an LL Control PDU, -1 for a PDU with no payload.
@tier(embedded)
fn dpdu_opcode(var p: Pdu) -> Int
    if dpdu_len(var p) < 1
        -1
    else
        p.b[2] as Int

// Payload octet `i` of the PDU.
@tier(embedded)
fn dpdu_byte(var p: Pdu, i: Int) -> Int
    p.b[2 + i] as Int

// Payload octets `i` and `i + 1` as a 16-bit value, least significant first.
@tier(embedded)
fn dpdu_u16(var p: Pdu, i: Int) -> Int
    p.b[2 + i] as Int | (p.b[3 + i] as Int << 8)

// Start a data PDU of `llid` with an empty payload.
@tier(embedded)
fn dpdu_begin(var p: Pdu, llid: Int)
    p.n = 0
    let _a = ll_pdu.pdu_put(var p, llid)
    let _b = ll_pdu.pdu_put(var p, 0)

// An empty PDU: LLID 1, no payload.  It is what a connection event sends when
// nothing is waiting.
@tier(embedded)
fn dpdu_empty(var p: Pdu)
    dpdu_begin(var p, LLID_CONTINUE)

// Append a payload octet.  False when the PDU is full: the header, 251 octets and the MIC.
@tier(embedded)
fn dpdu_put(var p: Pdu, v: Int) -> Bool
    if p.n >= DATA_PDU_EXT_OCTETS
        return false
    ll_pdu.pdu_put_data(var p, v)

// Write the payload length into the header.
@tier(embedded)
fn dpdu_finish(var p: Pdu)
    ll_pdu.pdu_finish(var p)

// Start an LL Control PDU with `opcode`.
@tier(embedded)
fn ctrl_begin(var p: Pdu, opcode: Int)
    dpdu_begin(var p, LLID_CONTROL)
    let _a = ll_pdu.pdu_put(var p, opcode)

// LL_TERMINATE_IND with the error code `reason`.
@tier(embedded)
fn ctrl_terminate(var p: Pdu, reason: Int)
    ctrl_begin(var p, OP_TERMINATE_IND)
    let _a = ll_pdu.pdu_put(var p, reason)
    dpdu_finish(var p)

// LL_UNKNOWN_RSP naming the opcode that was not understood.
@tier(embedded)
fn ctrl_unknown_rsp(var p: Pdu, unknown: Int)
    ctrl_begin(var p, OP_UNKNOWN_RSP)
    let _a = ll_pdu.pdu_put(var p, unknown)
    dpdu_finish(var p)

// LL_FEATURE_RSP, or LL_PERIPHERAL_FEATURE_REQ, or LL_FEATURE_REQ, by
// `opcode`, with the eight octets of the feature set.
@tier(embedded)
fn ctrl_features(var p: Pdu, opcode: Int, var features: Vec[u8; 8])
    ctrl_begin(var p, opcode)
    for i in 0..8
        let _a = ll_pdu.pdu_put(var p, features[i] as Int)
    dpdu_finish(var p)

// LL_VERSION_IND with the version number, the company identifier and the
// sub-version number.
@tier(embedded)
fn ctrl_version(var p: Pdu, version: Int, company: Int, sub: Int)
    ctrl_begin(var p, OP_VERSION_IND)
    let _a = ll_pdu.pdu_put(var p, version)
    let _b = ll_pdu.pdu_put(var p, company & 0xFF)
    let _c = ll_pdu.pdu_put(var p, (company >>> 8) & 0xFF)
    let _d = ll_pdu.pdu_put(var p, sub & 0xFF)
    let _e = ll_pdu.pdu_put(var p, (sub >>> 8) & 0xFF)
    dpdu_finish(var p)

// LL_PING_RSP.
@tier(embedded)
fn ctrl_ping_rsp(var p: Pdu)
    ctrl_begin(var p, OP_PING_RSP)
    dpdu_finish(var p)

// LL_PING_REQ.
@tier(embedded)
fn ctrl_ping_req(var p: Pdu)
    ctrl_begin(var p, OP_PING_REQ)
    dpdu_finish(var p)

// Append `v` as two octets, least significant first.
@tier(embedded)
fn put_u16(var p: Pdu, v: Int)
    let _a = ll_pdu.pdu_put(var p, v & 0xFF)
    let _b = ll_pdu.pdu_put(var p, (v >>> 8) & 0xFF)

// LL_CONNECTION_UPDATE_IND ([Vol 6] Part B, Section 2.4.2.1): the transmit
// window, the interval, latency and timeout in the units of the PDU, and the
// instant.
@tier(embedded)
fn ctrl_connection_update(var p: Pdu, win_size: Int, win_offset: Int, interval: Int, latency: Int,
                          timeout: Int, instant: Int)
    ctrl_begin(var p, OP_CONNECTION_UPDATE_IND)
    let _a = ll_pdu.pdu_put(var p, win_size)
    put_u16(var p, win_offset)
    put_u16(var p, interval)
    put_u16(var p, latency)
    put_u16(var p, timeout)
    put_u16(var p, instant)
    dpdu_finish(var p)

// LL_CHANNEL_MAP_IND (Section 2.4.2.2): the five octets of the 37-bit map and
// the instant.
@tier(embedded)
fn ctrl_channel_map(var p: Pdu, map: Int, instant: Int)
    ctrl_begin(var p, OP_CHANNEL_MAP_IND)
    for k in 0..5
        let _a = ll_pdu.pdu_put(var p, (map >>> (8 * k)) & 0xFF)
    put_u16(var p, instant)
    dpdu_finish(var p)

// LL_CONNECTION_PARAM_REQ or LL_CONNECTION_PARAM_RSP, by `opcode`
// (Section 2.4.2.16): the interval range, latency, timeout, the preferred
// periodicity and the reference event count; the six offsets are 0xFFFF, which
// says the sender has no preference.
@tier(embedded)
fn ctrl_param(var p: Pdu, opcode: Int, i_min: Int, i_max: Int, latency: Int, timeout: Int,
              periodicity: Int, reference: Int)
    ctrl_begin(var p, opcode)
    put_u16(var p, i_min)
    put_u16(var p, i_max)
    put_u16(var p, latency)
    put_u16(var p, timeout)
    let _a = ll_pdu.pdu_put(var p, periodicity)
    put_u16(var p, reference)
    for _ in 0..6
        put_u16(var p, 0xFFFF)
    dpdu_finish(var p)

// LL_REJECT_EXT_IND naming the rejected opcode and the error code
// (Section 2.4.2.18).
@tier(embedded)
fn ctrl_reject_ext(var p: Pdu, rejected: Int, code: Int)
    ctrl_begin(var p, OP_REJECT_EXT_IND)
    let _a = ll_pdu.pdu_put(var p, rejected)
    let _b = ll_pdu.pdu_put(var p, code)
    dpdu_finish(var p)

// LL_REJECT_IND with the error code (Section 2.4.2.14), for a peer without
// Extended Reject Indication.
@tier(embedded)
fn ctrl_reject(var p: Pdu, code: Int)
    ctrl_begin(var p, OP_REJECT_IND)
    let _a = ll_pdu.pdu_put(var p, code)
    dpdu_finish(var p)

// LL_MIN_USED_CHANNELS_IND (Section 2.4.2.24): the PHYs it concerns, as the
// bits of Table 2.23, and the least number of channels.
@tier(embedded)
fn ctrl_min_used(var p: Pdu, phys: Int, channels: Int)
    ctrl_begin(var p, OP_MIN_USED_CHANNELS_IND)
    let _a = ll_pdu.pdu_put(var p, phys)
    let _b = ll_pdu.pdu_put(var p, channels)
    dpdu_finish(var p)

// LL_ENC_REQ ([Vol 6] Part B, Section 2.4.2.4): Rand, EDIV, SKD_C and IV_C.
// `rand` has 8 octets, `skd` the 8 octets of SKD_C and `iv` the 4 of IV_C, all
// in the order they are on air.
@tier(embedded)
fn ctrl_enc_req(var p: Pdu, var rand: Vec[u8; 8], ediv: Int, var skd: Vec[u8; 16],
                var iv: Vec[u8; 8])
    ctrl_begin(var p, OP_ENC_REQ)
    for i in 0..8
        let _a = ll_pdu.pdu_put(var p, rand[i] as Int)
    put_u16(var p, ediv)
    for i in 0..8
        let _b = ll_pdu.pdu_put(var p, skd[i] as Int)
    for i in 0..4
        let _c = ll_pdu.pdu_put(var p, iv[i] as Int)
    dpdu_finish(var p)

// LL_ENC_RSP (Section 2.4.2.5): SKD_P and IV_P.
@tier(embedded)
fn ctrl_enc_rsp(var p: Pdu, var skd: Vec[u8; 16], var iv: Vec[u8; 8])
    ctrl_begin(var p, OP_ENC_RSP)
    for i in 0..8
        let _a = ll_pdu.pdu_put(var p, skd[8 + i] as Int)
    for i in 0..4
        let _b = ll_pdu.pdu_put(var p, iv[4 + i] as Int)
    dpdu_finish(var p)

// LL_LENGTH_REQ or LL_LENGTH_RSP, by `opcode` ([Vol 6] Part B, Section 2.4.2.21): the
// local MaxRxOctets, MaxRxTime, MaxTxOctets and MaxTxTime.
@tier(embedded)
fn ctrl_length(var p: Pdu, opcode: Int, rx_octets: Int, rx_time: Int, tx_octets: Int, tx_time: Int)
    ctrl_begin(var p, opcode)
    put_u16(var p, rx_octets)
    put_u16(var p, rx_time)
    put_u16(var p, tx_octets)
    put_u16(var p, tx_time)
    dpdu_finish(var p)

// LL_PHY_REQ or LL_PHY_RSP, by `opcode` (Section 2.4.2.22): the PHYs the sender prefers
// to transmit on and to receive on, as masks (bit 0 LE 1M, bit 1 LE 2M, bit 2 LE Coded).
@tier(embedded)
fn ctrl_phy(var p: Pdu, opcode: Int, tx_phys: Int, rx_phys: Int)
    ctrl_begin(var p, opcode)
    let _a = ll_pdu.pdu_put(var p, tx_phys)
    let _b = ll_pdu.pdu_put(var p, rx_phys)
    dpdu_finish(var p)

// LL_PHY_UPDATE_IND (Section 2.4.2.23): the PHYs after the instant, from the Central to the
// Peripheral and back, as masks of one bit or 0 for no change, and the instant.
@tier(embedded)
fn ctrl_phy_update(var p: Pdu, c_to_p: Int, p_to_c: Int, instant: Int)
    ctrl_begin(var p, OP_PHY_UPDATE_IND)
    let _a = ll_pdu.pdu_put(var p, c_to_p)
    let _b = ll_pdu.pdu_put(var p, p_to_c)
    put_u16(var p, instant)
    dpdu_finish(var p)

// An LL Control PDU of `opcode` with no payload: LL_START_ENC_REQ,
// LL_START_ENC_RSP, LL_PAUSE_ENC_REQ or LL_PAUSE_ENC_RSP.
@tier(embedded)
fn ctrl_bare(var p: Pdu, opcode: Int)
    ctrl_begin(var p, opcode)
    dpdu_finish(var p)
