// src/ll_link.nv — the Connection state of the Link Layer, in the
// Peripheral role and in the Central role: the connection's parameters, the
// timing of its events, the acknowledgement of its packets, its queues, and the
// LL Control procedures an end takes part in.
//
// [Vol 6] Part B, Section 4.5.  A connection is a series of connection events.
// The Central sends the first packet of an event at its anchor point, the
// Peripheral answers T_IFS after it, and the two go on as long as either sets
// MD.  The anchor points are the connection interval apart; the Peripheral
// finds the first in the transmit window after the CONNECT_IND (Section 4.5.3)
// and takes each later one from the packet it received in the event before,
// opening its receiver early by the window widening (Section 4.5.7).  The
// events use the channel selection algorithm #1 (Section 4.5.8.2).  Every
// packet carries SN and NESN, and the Peripheral sends a PDU again until its
// NESN says the Central has it (Section 4.5.9).
//
// This module holds no radio and no clock: the program that owns the radio
// gives the times in microseconds.  It drives a connection with the calls in
// the order an event runs:
//
//   link_open            a CONNECT_IND was taken; the first event is due
//   link_listen_start    the time the receiver must be listening from
//   link_listen_end      and until, when no packet has arrived
//   link_event_begin     the event starts; the answer is its channel
//   link_note_rx         a packet with a good CRC arrived, first or later
//   link_rx_fast         the header of that packet; the answer is the header of
//                        the packet to send, and which buffer holds it
//   link_rx_slow         the rest of the work for the packet
//   link_event_done      the event ended
//
// The PDU in flight is `cur` and the one to send when it is acknowledged is
// `nxt`; the program holds both in radio memory so that the answer to a packet
// only has to point the radio at one of them and patch the header octet.
//
// The Central role (`central`).  The Central owns the schedule: it sends the
// first packet of every event at an anchor point it fixes itself, the connection
// interval after the one before (Section 4.5.7), so its window is a point and it
// widens nothing.  `link_open_central` opens the link from the CONNECT_IND it
// sent; the first event is due at the start of the transmit window, 1.25 ms plus
// WinOffset after the end of the CONNECT_IND, and `link_first_header` gives the
// header of its first packet.  The Peripheral's answer goes through the same
// `link_rx_fast` and `link_rx_slow` as the Central's packet does on the other end,
// since the rules of SN, NESN and MD are the same (Section 4.5.9).  A Central
// closes the event at the first packet with a CRC error (Section 4.5.6), and the
// Host is told the connection is made when the first good packet of the
// Peripheral arrives, or that it failed to establish (Section 4.5.2).
//
// The LL Control procedures ([Vol 6] Part B, Section 5).  Each procedure is a
// request that goes out as an LL Control PDU and an answer that comes back, kept
// in the fields of the link:
//
//   Connection Update (5.1.1)        the Central sends LL_CONNECTION_UPDATE_IND with
//                                    an instant (`central_update`), both ends apply
//                                    it at the instant (`link_event_begin`)
//   Channel Map Update (5.1.2)       the same with LL_CHANNEL_MAP_IND; the Central
//                                    sends it when the Host's classification or the
//                                    peer's minimum number of used channels changes
//                                    the map it should use (`central_map_try`)
//   Feature, Version (5.1.4, 5.1.5)  one request and one response, started by the Host
//   Termination (5.1.6)              LL_TERMINATE_IND until it is acknowledged
//   Connection Parameters Request    the Peripheral sends LL_CONNECTION_PARAM_REQ and
//   (5.1.7)                          waits for LL_CONNECTION_UPDATE_IND, a reject or
//                                    LL_UNKNOWN_RSP; the Central answers one it
//                                    receives after asking the Host
//   LE Ping (5.1.8, 5.4)             LL_PING_REQ before the authenticated payload
//                                    timeout runs out, and the event when it does
//   Minimum Used Channels (5.1.11)   the Central keeps its map at or above the count
//
// A procedure the Controller started and waits on is `proc`; it ends the
// connection if the answer takes 40 seconds (Section 5.2).  Two procedures with an
// instant cannot run together (Section 5.3), which `ctrl_param_received` and the
// Host commands enforce.
//
// Two simultaneous links are the design target ([BLE-CONTROLLER-PLAN] D10):
// every function here takes the link as a parameter and none reads a
// module-level value.  The Controller holds two links, one of each role at most
// at once.
//
// The state is a value with inline storage; no function here allocates.

use ctl_limits
use std.test
use ll_pdu
use ll_data
use ll_policy
use ll_cipher
use ll_phy
use ll_sub
use ll_rate
use ll_fs
use ll_feat
use ll_sca

// The functions below take the link as a `var` parameter even where they only read
// it, which passes its address.  A plain parameter is a copy, and a copy of a
// struct of this size on every call costs time and stack.

// ── Timing, [Vol 6] Part B, Section 4.5 ──────────────────────────────

// The channel map of all 37 data channels.
const ALL_CHANNELS = 0x1FFFFFFFFF

// The unit of the interval and the transmit window, and of the supervision
// timeout, in microseconds.
const UNIT_US = 1250
const TIMEOUT_UNIT_US = 10000

// The transmit window starts this long after the end of the CONNECT_IND, plus
// WinOffset (Section 4.5.3).
const TX_WINDOW_DELAY_US = 1250

// The delay of the transmit window after an AUX_CONNECT_REQ on LE 1M or LE 2M.
const AUX_WINDOW_DELAY_US = 2500

// The same on LE Coded, where the packets are longer: 3.75 ms ([Vol 6] Part B, Section 4.5.3).
const AUX_WINDOW_DELAY_CODED_US = 3750

// The interframe space.
const T_IFS_US = 150

// The sleep clock accuracy, in parts per million, of the Central the
// CONNECT_IND names in its SCA field (Table 2.1 of Section 2.3.3.1), and of
// this Controller, whose time is the 32 MHz crystal.
const OWN_PPM = 50

// The widening every window carries for the jitter of the Central's transmit
// time and of this receiver's start, in microseconds.
const JITTER_US = 32

// The connection establishes within this many intervals of the first
// transmit window, or it fails (Section 4.5.2).
const ESTABLISH_EVENTS = 6

// The longest transmit window a CONNECT_IND asks for: 8 units.
const MAX_WINDOW_US = 10000

// A procedure the Controller started, and has no answer to, ends the
// connection after this long (Section 5.1.3 of Vol 6 Part B, the procedure
// response timeout), in microseconds.
const PROC_TIMEOUT_US = 40000000

// ── Reasons and the other numbers of the HCI ──────────────────────────

const REASON_REMOTE_TERMINATED = 0x13
const REASON_TIMEOUT = 0x08
const REASON_LOCAL_HOST = 0x16
const REASON_FAILED_TO_ESTABLISH = 0x3E
const REASON_INSTANT_PASSED = 0x28
const REASON_RESPONSE_TIMEOUT = 0x22

const STATUS_SUCCESS = 0x00
const STATUS_UNKNOWN_CONNECTION = 0x02
const STATUS_COMMAND_DISALLOWED = 0x0C
const STATUS_INVALID_PARAMETERS = 0x12
const STATUS_UNSUPPORTED_FEATURE = 0x11
const STATUS_UNSUPPORTED_REMOTE = 0x1A

// The error codes LL_REJECT_EXT_IND carries.
const CODE_INVALID_LL_PARAMETERS = 0x1E
const CODE_COLLISION = 0x23
const CODE_DIFFERENT_COLLISION = 0x2A
const CODE_BUSY = 0x3A

// The LL version number the Controller reports in LL_VERSION_IND (0x11 is
// Core 6.3), its company identifier (0xFFFF is the one the Assigned Numbers
// reserve for tests) and its sub-version number.
const LL_VERSION = 0x11
const LL_COMPANY = 0xFFFF
const LL_SUBVERSION = 0x0001

// The LE features this Link Layer has ([Vol 6] Part B, Section 4.6): in octet 0
// bit 0, LE Encryption, bit 1, Connection Parameters Request, bit 2, Extended
// Reject Indication, bit 3, Peripheral-initiated Features Exchange, bit 4, LE Ping,
// bit 5, LE Data Packet Length Extension and bit 6, LL Privacy; in octet 1 bit 0
// (feature 8), LE 2M PHY, bit 3 (feature 11), LE Coded PHY and bit 6 (feature 14),
// Channel Selection Algorithm #2, and bit 4 (feature 12), LE Extended Advertising, when the
// build has advertising sets (`ctl_limits.xadv_on()`); in octet 2 bit 0 (feature 16), Minimum Number of
// Used Channels.
const FEATURES_OCTET0 = 0x7F
const FEATURES_OCTET2 = 0x01

// The features of the isochronous channels, which a build with `ctl_limits.iso_on()` has: octet 3 bit 2 (feature
// 26), Sleep Clock Accuracy Updates, bit 4 (feature 28), Connected Isochronous Stream - Central, and bit 5
// (feature 29), Connected Isochronous Stream - Peripheral (`FEAT3_ISO`); and octet 4 bit 0 (feature 32),
// Connected Isochronous Stream (Host Support), which the Host sets.  The features of Periodic Advertising Sync
// Transfer, which a build with `ctl_limits.past_on()` has: octet 3 bit 0 (feature 24), Sender, and bit 1 (feature 25),
// Recipient (`FEAT3_PAST`).  The octet a build answers is `ctl_limits.features_octet3()`: the bits of the groups the
// configuration has.
const FEAT3_ISO = 0x34
const FEAT3_PAST = 0x03
const FEAT4_ISO_HOST = 0x01

// LE Power Control Request (feature 33, octet 4 bit 1) and LE Power Change Indication (feature 34, bit 2), which a build with `ctl_limits.pcl_on()`
// has; the octet is `ctl_limits.features_octet4()`.
const FEAT4_PCL = 0x06

// Connection Subrating (feature 37, octet 4 bit 5), which a build with `ctl_limits.sub_on()` has; bit 6 (feature 38) is the Host Support bit, which
// the Host sets with LE Set Host Feature and which goes to the peer in the feature set.
const FEAT4_SUB = 0x20
const FEAT4_SUB_HOST = 0x40

// The feature of Unsegmented mode for framed PDUs, which a build with isochronous channels has: octet 5 bit 5 (feature 45), ISOAL Unsegmented
// Framed Mode; and the features of Periodic Advertising with Responses: octet 5 bit 3 (feature 43), Advertiser (`ctl_limits.pawr_adv_on()`), and bit 4
// (feature 44), Scanner (`ctl_limits.pawr_sync_on()`); the octet is `ctl_limits.features_octet5()`.
const FEAT0_PARAM_REQUEST = 0x02
const FEAT0_EXT_REJECT = 0x04
const FEAT0_DLE = 0x20
const FEAT1_2M = 0x01
const FEAT1_CODED = 0x08

// The instant of a procedure is at least this many events of the Peripheral's
// listening away, and a few events more for the PDU to wait behind the one in
// flight (Section 5.5); the transmit window of an update the Central makes.
const INSTANT_LEAD = 6
const INSTANT_SLACK = 4
const UPDATE_WIN_SIZE = 2

// The default authenticated payload timeout, 30 s in units of 10 ms
// (Section 5.4).
const APTO_DEFAULT = 3000

// ── The state of the link ────────────────────────────────────────────

// What the PDU in flight, or the next, is.
const K_EMPTY = 0
const K_ACL = 1
const K_CTRL = 2
// A fragment of an ACL packet of the Host that is not its last: the Host's buffer is
// not free until the last one is acknowledged.
const K_ACL_PART = 3

// The events the Host is owed.
const EV_CONNECTED = 1
const EV_DISCONNECTED = 2
const EV_COMPLETED = 4
const EV_VERSION = 8
const EV_FEATURES = 16
const EV_UPDATED = 32
const EV_PARAM_REQUEST = 64
const EV_APTO = 128
const EV_LTK_REQUEST = 256
const EV_ENC_CHANGE = 512
const EV_KEY_REFRESH = 1024
const EV_DATA_LENGTH = 2048
const EV_PHY = 4096
const EV_CHSEL = 8192
const EV_SUBRATE = 16384
const EV_FEATEXT = 32768

// What `link_rx_slow` found in the packet.
const RX_NOTHING = 0
const RX_TO_HOST = 1

// The procedures the Controller starts, `proc`.
const PROC_NONE = 0
const PROC_VERSION = 1
const PROC_FEATURES = 2
const PROC_PARAM = 3
const PROC_PING = 4
const PROC_ENC = 5
const PROC_FEATEXT = 6
const PROC_SCA = 7

// What the PHY Update procedure of this end waits for (`phy_state`): nothing, the
// peer's LL_PHY_RSP (the Central that asked), or LL_PHY_UPDATE_IND (the Peripheral
// that asked, or `PHY_RESPONDED`, that answered the Central's request).  `PHY_DEFERRED` is
// a request that waits for this end's own LL_LENGTH_REQ to be answered, or for an encryption
// procedure to end: a Controller that is in the middle of one procedure may end the connection at
// the request for another (the SoftDevice Controller does, with Different Transaction Collision,
// 0x2A).  `enc_wait` is the same for the Central's Encryption Start or Pause, which waits for a
// PHY Update of its own to end.
const PHY_IDLE = 0
const PHY_WAIT_RSP = 1
const PHY_WAIT_IND = 2
const PHY_RESPONDED = 3
const PHY_DEFERRED = 4

// The events of a connection that pass before it asks for a PHY by itself.
const AUTO_PHY_EVENTS = 4

// The PHYs this Link Layer supports, as a mask (LE 1M, LE 2M and LE Coded), and the
// default data length parameters of a connection ([Vol 6] Part B, Section 4.5.10): the
// octets and the time of the longest packet this end can receive, and the time that
// is sent in LL_LENGTH_REQ when the peer is not known to have the LE Coded PHY.
const PHYS_SUPPORTED = 7
const DLE_RX_OCTETS = 251
const DLE_RX_TIME = 2120
const DLE_TIME_UNCODED_PEER = 2128

// The queues of PDUs.  An LL Control PDU waits in a slot of `CTRL_SLOT_OCTETS`
// octets, the header and at most 38 of CtrData (LL_CIS_REQ has 35).  The Host gets `ACL_SLOTS` buffers,
// each of `SLOT_OCTETS` octets: the header octets and an HCI ACL Data packet of at
// most 251 octets, which goes out as one data PDU or, when the data length in force
// is shorter, as several.
const SLOT_OCTETS = 260
const CTRL_SLOT_OCTETS = 40
const ACL_SLOTS = 3
const CTRL_SLOTS = 4

// The most connection events a catch-up skips in one call.
const CATCH_UP_MAX = 64

// `live` says the connection is on; `closing` says it has ended and `reason`
// is why, until the Controller has taken it off (`link_released`).  `handle`
// is the connection handle.  `peer_type`, `peer` and `own_type`, `own` are the
// addresses of the two ends.  `aa` and `crc_init` are the access address and CRC
// seed, `interval`, `latency` and `timeout` the parameters in the units of the
// PDU, `chmap` the channel map as a 37-bit value with `n_used` bits set, `hop`
// the hop increment and `sca` the Central's clock accuracy class.
//
// `central` says this end is the Central of the link and `conn_status` the status
// of the LE Connection Complete event the Host is owed: 0, or 0x3E when the
// Central's connection failed to establish.  `csa2` says the events use channel
// selection algorithm #2, whose input from the access address is `chan_id`.
//
// Timing, in microseconds: `t_ref` is the time of the last anchor, or the end
// of the CONNECT_IND before there was one, and `due` the time of the anchor
// the next event expects, with `win_len` of transmit window after it.
// `ev_count` is the connection event counter of the event under way, or the
// next one, and `unmapped` the channel selection's last unmapped channel.
// `anchor` is the anchor point of the event under way once its first packet
// arrived (`ev_anchor`).  `synced` says some packet arrived, `last_rx` is the
// time of the last good packet, `first_due` the time the first anchor was
// expected, `now` the last time the program gave.
//
// Sequence: `sn` and `nesn` are transmitSeqNum and nextExpectedSeqNum.
// `room` says a new packet can be taken; `cur` and `nxt` are the PDU in flight
// and the next, `cur_kind` and `nxt_kind` what they are, `cur_md` and `nxt_md`
// whether more waits behind each, and `dirty` says a program that mirrors them
// has to read them again.  `acked`, `rx_new`, `use_nxt` and `cont` are the
// verdicts of `link_rx_fast`.  The queues follow: ACL data from the Host and
// LL Control PDUs.  `completed` counts the Host's buffers the Central has
// acknowledged since the Host was told.
//
// The procedures: a pending Connection Update (`upd_*`) and Channel Map
// (`chm_*`), the Host's request for a disconnect (`term_sent`, `term_reason`),
// the feature sets (`peer_feat`, `have_feat`), the versions (`ver_sent`,
// `ver_rcvd`, `peer_ver`, `peer_company`, `peer_sub`), the procedure the Host
// waits on (`proc`, `proc_t0`), and `owed`, the events the Host is owed, as
// `EV_` bits, with `feat_status` the status of the features event.
//
// The parameter procedures: `upd_host` says the pending update answers a Host
// command, so the Host gets LE Connection Update Complete even when nothing
// changed, and `upd_status` is the status of that event.  `rq_*` is a request of
// the peer that waits for the Host (`rq_wait`, with `rq_op` the PDU it came in);
// `ind_ok` says the Host has the event for it enabled.  `h_*` is the range the
// Host gave the Central in LE Create Connection (`h_set`), the request inside
// which needs no asking.  `cpr_no` says the peer answered the Connection
// Parameters Request with LL_UNKNOWN_RSP.  `min_used` is the count the peer
// asked the Central to keep, and `host_map` the map the Host classified, from
// which the Central derives the map it uses.  `apto` is the authenticated
// payload timeout in units of 10 ms; while `auth_on` the time of the last
// packet with a good MIC is `auth_t0`, `ping_ok` says LL_PING_REQ is worth
// sending and `pinged` that one went out in this period of the timer.
//
// The data length ([Vol 6] Part B, Section 4.5.10): `dl_tx_octets`, `dl_tx_time`,
// `dl_rx_octets` and `dl_rx_time` are connMaxTxOctets, connMaxTxTime, connMaxRxOctets and
// connMaxRxTime, the `dl_rem_` values connRemoteMax*, and `dl_ev_` the effective values the
// Host was last told.  `dl_wait` says an LL_LENGTH_REQ of this end is out (since `dl_t0`),
// `dl_unsup` that the peer answered with LL_UNKNOWN_RSP, `dl_started` that the request a
// new connection makes by itself went out, and `dl_resend` that the values changed while a
// request was out, so another follows.  `txq_off` is the octets of the packet at the head of
// the ACL queue already sent in earlier fragments.
//
// The PHY ([Vol 6] Part B, Section 5.1.10): `phy` is the PHY in force, in both directions,
// and `phy_opt` the Host's coding preference for the LE Coded PHY.  `phy_pref_tx` and
// `phy_pref_rx` are the PHYs the Host prefers as masks (all of them when it has no
// preference, `phy_pref_set` false), `phy_off` the single PHY this end offered in the request
// or the answer under way.  `phy_state` is what the procedure waits for (since `phy_t0`).  A
// change is applied at the instant `phy_instant` (`phy_pending`) to `phy_new`.  `phy_host`
// says the Host asked, so it hears of the result even when nothing changed, `phy_status` is
// the status the event carries, `phy_unsup` that the peer lacks the procedure and `phy_auto`
// that the request a connection makes by itself has been made.
//
// The procedures the Controller layer carries out ([Vol 6] Part B, Sections 5.1.13 and 5.1.15): `ctl_in` says the PDU
// the link last read was one of the CIS procedures (LL_CIS_REQ, LL_CIS_RSP, LL_CIS_IND or LL_CIS_TERMINATE_IND) or
// a periodic advertising sync transfer (LL_PERIODIC_SYNC_IND), which the Controller reads from the same buffer
// (`ctl_hci.ctl_iso_ctrl`) before the next packet; `host_iso` says the Host set the Connected Isochronous
// Stream (Host Support) feature bit (LE Set Host Feature).
@value
struct Link
    live: Bool
    closing: Bool
    reason: Int
    handle: Int
    peer_type: Int
    peer: Vec[u8; 6]
    own_type: Int
    own: Vec[u8; 6]
    aa: Int
    crc_init: Int
    interval: Int
    latency: Int
    timeout: Int
    chmap: Int
    n_used: Int
    hop: Int
    sca: Int
    t_ref: Int
    due: Int
    win_len: Int
    ev_count: Int
    unmapped: Int
    anchor: Int
    ev_anchor: Bool
    ev_open: Bool
    synced: Bool
    last_rx: Int
    first_due: Int
    now: Int
    sn: Int
    nesn: Int
    room: Bool
    cur: Pdu
    nxt: Pdu
    cur_kind: Int
    nxt_kind: Int
    cur_md: Int
    nxt_md: Int
    dirty: Bool
    acked: Bool
    rx_new: Bool
    use_nxt: Bool
    cont: Bool
    txq0: Vec[u8; 260]
    txq1: Vec[u8; 260]
    txq2: Vec[u8; 260]
    txq_head: Int
    txq_count: Int
    cq: Vec[u8; 160]
    cq_head: Int
    cq_count: Int
    completed: Int
    upd_pending: Bool
    upd_instant: Int
    upd_win_size: Int
    upd_win_offset: Int
    upd_interval: Int
    upd_latency: Int
    upd_timeout: Int
    chm_pending: Bool
    chm_instant: Int
    chm_map: Int
    term_sent: Bool
    term_reason: Int
    peer_feat: Vec[u8; 8]
    have_feat: Bool
    ver_sent: Bool
    ver_rcvd: Bool
    peer_ver: Int
    peer_company: Int
    peer_sub: Int
    proc: Int
    proc_t0: Int
    owed: Int
    feat_status: Int
    ver_status: Int
    tmp: Pdu
    bad_run: Int
    term_t0: Int
    ping_rsps: Int
    held: Int
    data_in: Int
    data_out: Int
    central: Bool
    conn_status: Int
    csa2: Bool
    chan_id: Int
    upd_host: Bool
    upd_status: Int
    rq_wait: Bool
    rq_op: Int
    rq_min: Int
    rq_max: Int
    rq_latency: Int
    rq_timeout: Int
    rq_period: Int
    ind_ok: Bool
    h_set: Bool
    h_min: Int
    h_max: Int
    h_latency: Int
    h_timeout: Int
    cpr_no: Bool
    cpr_min: Int
    cpr_max: Int
    cpr_latency: Int
    cpr_timeout: Int
    rq_ref: Int
    rq_off: Int
    rssi: Int
    min_used: Int
    host_map: Int
    apto: Int
    auth_on: Bool
    auth_t0: Int
    ping_ok: Bool
    pinged: Bool
    enc_ph: Int
    enc_refresh: Bool
    enc_tx: Bool
    enc_rx: Bool
    tx_ctr: Int
    rx_ctr: Int
    enc_status: Int
    enc_ediv: Int
    enc_rand: Vec[u8; 8]
    skd: Vec[u8; 16]
    ltk: Vec[u8; 16]
    ek: EncKey
    peer_rpa: Vec[u8; 6]
    local_rpa: Vec[u8; 6]
    rpa_peer: Bool
    rpa_local: Bool
    id_kind: Int
    res_wait: Bool
    start_early: Bool
    txq_off: Int
    dl_tx_octets: Int
    dl_tx_time: Int
    dl_rx_octets: Int
    dl_rx_time: Int
    dl_rem_tx_octets: Int
    dl_rem_tx_time: Int
    dl_rem_rx_octets: Int
    dl_rem_rx_time: Int
    dl_ev_tx_octets: Int
    dl_ev_tx_time: Int
    dl_ev_rx_octets: Int
    dl_ev_rx_time: Int
    dl_wait: Bool
    dl_t0: Int
    dl_unsup: Bool
    dl_started: Bool
    dl_resend: Bool
    phy: Int
    phy_opt: Int
    txp: [i8; 4]
    phy_pref_tx: Int
    phy_pref_rx: Int
    phy_pref_set: Bool
    phy_state: Int
    phy_t0: Int
    phy_off: Int
    phy_pending: Bool
    phy_instant: Int
    phy_new: Int
    phy_host: Bool
    phy_status: Int
    phy_unsup: Bool
    phy_auto: Bool
    enc_wait: Bool
    ctl_in: Bool
    cis_dropped: Int
    host_iso: Bool
    no_coded: Bool
    host_sub: Bool
    sub_factor: u16
    sub_res: u16
    sub_cont: u16
    sub_left: u16
    sub_busy: Bool
    sub_gap: u16
    sub_tr: Bool
    sub_nf: u16
    sub_nres: u16
    sub_ncont: u16
    sub_nlat: u16
    sub_nto: u16
    sub_owed: Bool
    sub_host: Bool
    sub_status: u8
    fx: Int

// A link with no connection.
@tier(embedded)
fn link_new() -> Link
    var l = Link {
        live: false, closing: false, reason: 0, handle: 0, peer_type: 0, peer: Vec.new(),
        own_type: 0, own: Vec.new(), aa: 0, crc_init: 0, interval: 0, latency: 0, timeout: 0,
        chmap: 0, n_used: 0, hop: 0, sca: 0, t_ref: 0, due: 0, win_len: 0, ev_count: 0,
        unmapped: 0, anchor: 0, ev_anchor: false, ev_open: false, synced: false, last_rx: 0,
        first_due: 0, now: 0, sn: 0, nesn: 0, room: true, cur: ll_pdu.pdu_new(),
        nxt: ll_pdu.pdu_new(), cur_kind: K_EMPTY, nxt_kind: K_EMPTY, cur_md: 0, nxt_md: 0,
        dirty: false, acked: false, rx_new: false, use_nxt: false, cont: false,
        txq0: Vec.new(), txq1: Vec.new(), txq2: Vec.new(), txq_head: 0, txq_count: 0, cq: Vec.new(), cq_head: 0, cq_count: 0,
        completed: 0, upd_pending: false, upd_instant: 0, upd_win_size: 0, upd_win_offset: 0,
        upd_interval: 0, upd_latency: 0, upd_timeout: 0, chm_pending: false, chm_instant: 0,
        chm_map: 0, term_sent: false, term_reason: 0, peer_feat: Vec.new(), have_feat: false,
        ver_sent: false, ver_rcvd: false, peer_ver: 0, peer_company: 0, peer_sub: 0,
        proc: PROC_NONE, proc_t0: 0, owed: 0, feat_status: 0, ver_status: 0, tmp: ll_pdu.pdu_new(),
        bad_run: 0, term_t0: 0, ping_rsps: 0, held: 0, data_in: 0, data_out: 0,
        central: false, conn_status: 0, csa2: false, chan_id: 0, upd_host: false,
        upd_status: 0, rq_wait: false, rq_op: 0, rq_min: 0, rq_max: 0, rq_latency: 0,
        rq_timeout: 0, rq_period: 0, ind_ok: false, h_set: false, h_min: 0, h_max: 0,
        h_latency: 0, h_timeout: 0, cpr_no: false, cpr_min: 0, cpr_max: 0, cpr_latency: 0,
        cpr_timeout: 0, rq_ref: 0, rq_off: -1, rssi: 127, min_used: 0, host_map: 0,
        apto: APTO_DEFAULT, auth_on: false, auth_t0: 0, ping_ok: true, pinged: false,
        enc_ph: ENC_IDLE, enc_refresh: false, enc_tx: false, enc_rx: false, tx_ctr: 0, rx_ctr: 0,
        enc_status: 0, enc_ediv: 0, enc_rand: Vec.new(), skd: Vec.new(), ltk: Vec.new(),
        ek: ll_cipher.enc_key_new(), peer_rpa: Vec.new(), local_rpa: Vec.new(), rpa_peer: false,
        rpa_local: false, id_kind: -1, res_wait: false, start_early: false,
        txq_off: 0, dl_tx_octets: 0, dl_tx_time: 0, dl_rx_octets: 0, dl_rx_time: 0,
        dl_rem_tx_octets: 0, dl_rem_tx_time: 0, dl_rem_rx_octets: 0, dl_rem_rx_time: 0,
        dl_ev_tx_octets: 0, dl_ev_tx_time: 0, dl_ev_rx_octets: 0, dl_ev_rx_time: 0,
        dl_wait: false, dl_t0: 0, dl_unsup: false, dl_started: false, dl_resend: false,
        phy: 1, phy_opt: 0, txp: [0, 0, 0, 0], phy_pref_tx: 0, phy_pref_rx: 0, phy_pref_set: false,
        phy_state: PHY_IDLE, phy_t0: 0, phy_off: 0, phy_pending: false, phy_instant: 0,
        phy_new: 0, phy_host: false, phy_status: 0, phy_unsup: false, phy_auto: false, enc_wait: false,
        ctl_in: false, cis_dropped: 0, host_iso: false, no_coded: false,
        host_sub: false, sub_factor: 1, sub_res: 0, sub_cont: 0, sub_left: 0, sub_busy: false, sub_gap: 1, sub_tr: false, sub_nf: 1, sub_nres: 0,
        sub_ncont: 0, sub_nlat: 0, sub_nto: 0, sub_owed: false, sub_host: false, sub_status: 0,
        fx: (ctl_limits.page1_bits() & 0xFFFF) << FX_LOCAL }
    link_reset_data(var l)
    for _ in 0..6
        let _u = l.peer_rpa.push(0)
        let _v = l.local_rpa.push(0)
    for _ in 0..8
        let _r = l.enc_rand.push(0)
    for _ in 0..16
        let _s = l.skd.push(0)
        let _t = l.ltk.push(0)
    for _ in 0..6
        let _a = l.peer.push(0)
        let _b = l.own.push(0)
    for _ in 0..8
        let _c = l.peer_feat.push(0)
    for _ in 0..SLOT_OCTETS
        let _d = l.txq0.push(0)
        let _d1 = l.txq1.push(0)
        let _d2 = l.txq2.push(0)
    for _ in 0..(CTRL_SLOTS * CTRL_SLOT_OCTETS)
        let _e = l.cq.push(0)
    l

// The data length and PHY state of a connection that has just begun: this end can send
// and receive 251 octets in packets of 2120 microseconds, the peer is taken to do 27 in
// 328 until it says otherwise, the PHY is LE 1M, and the Host has no preference.  The link
// starts no procedure by itself until the Controller gives it the Host's defaults
// (`link_set_defaults`), which also lets it send LL_LENGTH_REQ once and ask for the PHY the
// Host prefers.
@tier(embedded)
fn link_reset_data(var l: Link)
    l.txq_off = 0
    l.dl_tx_octets = ll_phy.PAYLOAD_MAX
    l.dl_tx_time = DLE_RX_TIME
    l.dl_rx_octets = DLE_RX_OCTETS
    l.dl_rx_time = DLE_RX_TIME
    l.dl_rem_tx_octets = ll_phy.PAYLOAD_MIN
    l.dl_rem_tx_time = ll_phy.TIME_MIN
    l.dl_rem_rx_octets = ll_phy.PAYLOAD_MIN
    l.dl_rem_rx_time = ll_phy.TIME_MIN
    l.dl_ev_tx_octets = ll_phy.PAYLOAD_MIN
    l.dl_ev_tx_time = ll_phy.TIME_MIN
    l.dl_ev_rx_octets = ll_phy.PAYLOAD_MIN
    l.dl_ev_rx_time = ll_phy.TIME_MIN
    l.dl_wait = false
    l.dl_t0 = 0
    l.dl_unsup = false
    l.dl_started = true
    l.dl_resend = false
    l.phy = ll_phy.PHY_1M
    l.phy_opt = ll_phy.OPT_NONE
    l.phy_pref_tx = PHYS_SUPPORTED
    l.phy_pref_rx = PHYS_SUPPORTED
    l.phy_pref_set = false
    l.phy_state = PHY_IDLE
    l.phy_t0 = 0
    l.phy_off = 0
    l.phy_pending = false
    l.phy_instant = 0
    l.phy_new = 0
    l.phy_host = false
    l.phy_status = 0
    l.phy_unsup = false
    l.phy_auto = true
    l.enc_wait = false

// Back to no connection, and no event owed.
@tier(embedded)
fn link_reset(var l: Link)
    l.live = false
    l.closing = false
    l.reason = 0
    l.ev_open = false
    l.ev_anchor = false
    l.synced = false
    l.room = true
    l.sn = 0
    l.nesn = 0
    l.cur_kind = K_EMPTY
    l.nxt_kind = K_EMPTY
    l.cur_md = 0
    l.nxt_md = 0
    ll_data.dpdu_empty(var l.cur)
    ll_data.dpdu_empty(var l.nxt)
    l.dirty = true
    l.acked = false
    l.rx_new = false
    l.use_nxt = false
    l.cont = false
    l.txq_head = 0
    l.txq_count = 0
    l.cq_head = 0
    l.cq_count = 0
    l.completed = 0
    l.upd_pending = false
    l.chm_pending = false
    l.term_sent = false
    l.term_reason = 0
    l.have_feat = false
    for i in 0..8
        l.peer_feat[i] = 0
    l.ver_sent = false
    l.ver_rcvd = false
    l.peer_ver = 0
    l.peer_company = 0
    l.peer_sub = 0
    l.proc = PROC_NONE
    l.proc_t0 = 0
    l.owed = 0
    l.feat_status = 0
    l.ver_status = 0
    l.fx = l.fx & (0xFFFF << FX_LOCAL)
    l.win_len = 0
    l.ev_count = 0
    l.unmapped = 0
    l.central = false
    l.conn_status = 0
    l.csa2 = false
    l.chan_id = 0
    l.upd_host = false
    l.upd_status = 0
    l.rq_wait = false
    l.ind_ok = false
    l.h_set = false
    l.cpr_no = false
    l.rq_off = -1
    l.rssi = 127
    l.min_used = 0
    l.host_map = ALL_CHANNELS
    l.apto = APTO_DEFAULT
    l.auth_on = false
    l.ping_ok = true
    l.pinged = false
    l.ctl_in = false
    enc_wipe(var l)
    l.rpa_peer = false
    l.rpa_local = false
    l.id_kind = -1
    l.res_wait = false
    link_reset_data(var l)
    for i in 0..6
        l.peer_rpa[i] = 0
        l.local_rpa[i] = 0

// The addresses of the connection that privacy changed: the Resolvable Private Address
// the peer used (`peer_used`) and the one this end used (`local_used`), for the Host's
// LE Enhanced Connection Complete.
@tier(embedded)
fn link_set_rpa(var l: Link, var peer: Vec[u8; 6], peer_used: Bool, var local: Vec[u8; 6], local_used: Bool)
    for i in 0..6
        l.peer_rpa[i] = peer[i]
        l.local_rpa[i] = local[i]
    l.rpa_peer = peer_used
    l.rpa_local = local_used

// The peer's Resolvable Private Address was resolved to the identity address `a` of
// `kind` (0 public, 1 random).
@tier(embedded)
fn link_set_identity(var l: Link, kind: Int, var a: Vec[u8; 6])
    for i in 0..6
        l.peer[i] = a[i]
    l.peer_type = kind
    l.id_kind = kind
    l.res_wait = false

// Everything privacy set for a connection in one call: `peer` is the RPA the peer
// used and `local` the one this end used (`peer_used`, `local_used`); `id_kind` is the kind
// of the identity address `ident` the peer's RPA resolved to, or -1 when it did not;
// `wait` says the resolution is still to be done (the Host hears of the connection after).
@tier(embedded)
fn link_set_privacy(var l: Link, var peer: Vec[u8; 6], peer_used: Bool, var local: Vec[u8; 6], local_used: Bool, id_kind: Int, var ident: Vec[u8; 6], wait: Bool)
    link_set_rpa(var l, var peer, peer_used, var local, local_used)
    if id_kind >= 0
        link_set_identity(var l, id_kind, var ident)
    else
        l.res_wait = wait

// ── The numbers of a CONNECT_IND ─────────────────────────────────────

// Octet `i` of the CONNECT_IND payload, after the 2-octet header.
@tier(embedded)
fn rb(var rx: Pdu, i: Int) -> Int
    rx.b[2 + i] as Int

@tier(embedded)
fn rb16(var rx: Pdu, i: Int) -> Int
    (rx.b[2 + i] as Int) | ((rx.b[3 + i] as Int) << 8)

// The sleep clock accuracy, in ppm, of the class (0 to 7) of the SCA field
// ([Vol 6] Part B, Table 2.1).
@tier(embedded)
fn sca_ppm(class: Int) -> Int
    match class
        0 => 500
        1 => 250
        2 => 150
        3 => 100
        4 => 75
        5 => 50
        6 => 30
        _ => 20

// The number of channels in the 37-bit map.
@tier(embedded)
fn popcount(map: Int) -> Int
    var n = 0
    for i in 0..37
        n = n + ((map >>> i) & 1)
    n

// The channel index of the `k`-th used channel of the map, counted from 0 in
// ascending order.
@tier(embedded)
fn nth_used(map: Int, k: Int) -> Int
    var seen = 0
    for ch in 0..37
        if ((map >>> ch) & 1) == 1
            if seen == k
                return ch
            seen = seen + 1
    0

// The five octets of ChM at payload offset `i`, as a 40-bit value.
@tier(embedded)
fn rb_map(var rx: Pdu, i: Int) -> Int
    var v = 0
    for k in 0..5
        v = v | ((rx.b[2 + i + k] as Int) << (8 * k))
    v

// The values of the CONNECT_IND in `rx`, in the form the policy reads.
@tier(embedded)
fn connect_request(var rx: Pdu, var out: ConnRequest)
    out.peer_type = ll_pdu.pdu_tx_add(var rx)
    ll_pdu.pdu_addr_get(var rx, 0, var out.peer)
    out.win_size = rb(var rx, 19)
    out.win_offset = rb16(var rx, 20)
    out.interval = rb16(var rx, 22)
    out.latency = rb16(var rx, 24)
    out.timeout = rb16(var rx, 26)
    out.chmap = rb_map(var rx, 28)
    out.hop = rb(var rx, 33) & 0x1F
    out.sca = (rb(var rx, 33) >>> 5) & 7

// Whether the LLData of a CONNECT_IND is one a Link Layer takes
// ([Vol 6] Part B, Section 2.3.3.1): an interval of 6 to 3200, a transmit
// window of at most 8 and shorter than the interval, an offset within the
// interval, a latency of at most 499, a timeout of 10 to 3200 that is longer
// than twice the interval of the longest latency, a channel map of at least
// two channels of the 37, a hop of 5 to 16 (which channel selection algorithm
// #2 does not use, so a CONNECT_IND with ChSel set may carry any), and an access
// address that is not the advertising one.
@satisfies("REQ-BLE-CTL-014")
@tier(embedded)
fn connect_valid(var rx: Pdu) -> Bool
    let interval = rb16(var rx, 22)
    let latency = rb16(var rx, 24)
    let timeout = rb16(var rx, 26)
    let win_size = rb(var rx, 19)
    let win_offset = rb16(var rx, 20)
    let hop = rb(var rx, 33) & 0x1F
    let map = rb_map(var rx, 28)
    let aa = rb16(var rx, 12) | (rb16(var rx, 14) << 16)
    let chsel = ((rx.b[0] as Int) & 0x20) != 0
    if interval < 6 or interval > 3200
        return false
    if win_size < 1 or win_size > 8 or win_size >= interval
        return false
    if win_offset > interval
        return false
    if latency > 499
        return false
    if timeout < 10 or timeout > 3200
        return false
    if timeout * 4 <= (1 + latency) * interval
        return false
    if (map >>> 37) != 0 or popcount(map) < 2
        return false
    if (hop < 5 or hop > 16) and not chsel
        return false
    if aa == 0x8E89BED6
        return false
    true

// ── Opening and closing ──────────────────────────────────────────────

// The connection interval in microseconds.
@tier(embedded)
fn interval_us(var l: Link) -> Int
    l.interval * UNIT_US

// The channel selection of the connection the CONNECT_IND in `rx` makes: the
// algorithm #2 when its ChSel is set, with the identifier of the access address
// (Section 4.5.8.3.2).
@tier(embedded)
fn open_channels(var l: Link, var rx: Pdu)
    l.csa2 = ((rx.b[0] as Int) & 0x20) != 0
    l.chan_id = (l.aa >>> 16) ^ (l.aa & 0xFFFF)

// Take the CONNECT_IND in `rx`, which ended at `end_us`, as connection
// `handle`.  The caller has checked `connect_valid`.  The first anchor is
// expected in the transmit window.  The Host is owed LE Connection Complete.
@satisfies("REQ-BLE-CTL-014")
@tier(embedded)
fn link_open(var l: Link, handle: Int, var rx: Pdu, end_us: Int)
    link_reset(var l)
    l.live = true
    l.handle = handle
    l.peer_type = ll_pdu.pdu_tx_add(var rx)
    ll_pdu.pdu_addr_get(var rx, 0, var l.peer)
    l.own_type = ll_pdu.pdu_rx_add(var rx)
    ll_pdu.pdu_addr_get(var rx, 6, var l.own)
    l.aa = rb16(var rx, 12) | (rb16(var rx, 14) << 16)
    l.crc_init = rb16(var rx, 16) | (rb(var rx, 18) << 16)
    l.interval = rb16(var rx, 22)
    l.latency = rb16(var rx, 24)
    l.timeout = rb16(var rx, 26)
    l.chmap = rb_map(var rx, 28)
    l.n_used = popcount(l.chmap)
    l.hop = rb(var rx, 33) & 0x1F
    l.sca = (rb(var rx, 33) >>> 5) & 7
    open_channels(var l, var rx)
    l.t_ref = end_us
    l.due = end_us + TX_WINDOW_DELAY_US + rb16(var rx, 20) * UNIT_US
    l.first_due = l.due
    l.win_len = rb(var rx, 19) * UNIT_US
    l.last_rx = end_us
    l.now = end_us
    l.owed = EV_CONNECTED
    link_prepare(var l)

// The range the Host gave LE Create Connection, which a request of the peer
// inside needs no asking about (Section 5.1.7.2).
@tier(embedded)
fn link_host_range(var l: Link, i_min: Int, i_max: Int, latency: Int, timeout: Int)
    l.h_set = true
    l.h_min = i_min
    l.h_max = i_max
    l.h_latency = latency
    l.h_timeout = timeout

// The Central's side of a connection: the CONNECT_IND `req` this end sent, which
// ended at `end_us`, opens link `handle`.  The peer is the AdvA of the PDU and the
// own address its InitA.  The first event is due at the start of the transmit
// window, the anchor point of a Central being the time it chooses to send at
// (Section 4.5.3); the Host is owed nothing until the Peripheral has answered.
@satisfies("REQ-BLE-CTL-022")
@tier(embedded)
fn link_open_central(var l: Link, handle: Int, var req: Pdu, end_us: Int)
    link_reset(var l)
    l.live = true
    l.central = true
    l.handle = handle
    l.peer_type = ll_pdu.pdu_rx_add(var req)
    ll_pdu.pdu_addr_get(var req, 6, var l.peer)
    l.own_type = ll_pdu.pdu_tx_add(var req)
    ll_pdu.pdu_addr_get(var req, 0, var l.own)
    l.aa = rb16(var req, 12) | (rb16(var req, 14) << 16)
    l.crc_init = rb16(var req, 16) | (rb(var req, 18) << 16)
    l.interval = rb16(var req, 22)
    l.latency = rb16(var req, 24)
    l.timeout = rb16(var req, 26)
    l.chmap = rb_map(var req, 28)
    l.n_used = popcount(l.chmap)
    l.hop = rb(var req, 33) & 0x1F
    l.sca = 0
    open_channels(var l, var req)
    l.host_map = l.chmap
    l.t_ref = end_us
    l.due = end_us + TX_WINDOW_DELAY_US + rb16(var req, 20) * UNIT_US
    l.first_due = l.due
    l.win_len = 0
    l.last_rx = end_us
    l.now = end_us
    l.owed = 0
    link_prepare(var l)

// The connection `link_open_central` opened was made with an AUX_CONNECT_REQ sent on `phy`
// (`ll_phy.PHY_1M` or `PHY_2M`): the transmit window starts 2.5 ms after the end of the request
// instead of 1.25 ms ([Vol 6] Part B, Section 4.5.3), the connection starts on the PHY of the
// request, and it uses channel selection algorithm #2 (the ChSel bit of an AUX_CONNECT_REQ is
// reserved, so the header does not say it).
@satisfies("REQ-BLE-CTL-080")
@satisfies("REQ-BLE-CTL-092")
@tier(embedded)
fn link_aux_start(var l: Link, phy: Int)
    var delay = AUX_WINDOW_DELAY_US
    if phy == ll_phy.PHY_CODED
        delay = AUX_WINDOW_DELAY_CODED_US
    l.due = l.due + (delay - TX_WINDOW_DELAY_US)
    l.first_due = l.due
    l.phy = phy
    l.csa2 = true

// Whether this end is the Central of the link.
@tier(embedded)
fn link_is_central(var l: Link) -> Bool
    l.central

// Whether a connection is on.
@tier(embedded)
fn link_live(var l: Link) -> Bool
    l.live

// End the connection with `reason`, the first reason standing.
@tier(embedded)
fn link_close(var l: Link, reason: Int)
    if not l.closing
        l.closing = true
        l.reason = reason

// Whether the connection has ended and the Controller has not yet taken it
// off.
@tier(embedded)
fn link_ended(var l: Link) -> Bool
    l.live and l.closing

// The Controller has seen the end: the Host is owed the Disconnection Complete
// event, and the link is off.
@satisfies("REQ-BLE-CTL-018")
@tier(embedded)
fn link_released(var l: Link)
    l.live = false
    l.closing = false
    l.ev_open = false
    if l.central and not l.synced
        // The Central's connection was never made: the Host gets the LE Connection
        // Complete event it waits for, with the status that says why.
        l.owed = EV_CONNECTED
        l.conn_status = l.reason
    else
        l.owed = EV_DISCONNECTED

// ── The queues ───────────────────────────────────────────────────────

// Copy the `n` octets of `p` into the slot `slot` of the LL Control queue.
@tier(embedded)
fn slot_put_cq(var l: Link, slot: Int, var p: Pdu)
    for i in 0..p.n
        l.cq[slot * CTRL_SLOT_OCTETS + i] = p.b[i]

// Read slot `slot` of the LL Control queue into `p`.
@tier(embedded)
fn slot_get_cq(var l: Link, slot: Int, var p: Pdu)
    let n = (l.cq[slot * CTRL_SLOT_OCTETS + 1] as Int) + 2
    p.n = n
    for i in 0..n
        p.b[i] = l.cq[slot * CTRL_SLOT_OCTETS + i]

// Queue an LL Control PDU for the link.  False when the queue is full.  A
// procedure that waits for the peer starts its response timer again with every
// PDU queued (Section 5.2).
@tier(embedded)
fn ctrl_queue(var l: Link, var p: Pdu) -> Bool
    if l.cq_count >= CTRL_SLOTS
        return false
    slot_put_cq(var l, (l.cq_head + l.cq_count) % CTRL_SLOTS, var p)
    l.cq_count = l.cq_count + 1
    if l.proc != PROC_NONE
        l.proc_t0 = l.now
    true

// Queue the `n` payload octets of an HCI ACL Data packet from the Host:
// `start` says the first fragment of an L2CAP message (LLID 2), otherwise a
// continuation (LLID 1).  False when the Host's buffers are all taken or the
// payload is longer than the 251 octets of a data PDU.  A packet longer than the data
// length in force goes out in several PDUs (`take_acl`).
@satisfies("REQ-BLE-CTL-015")
@tier(embedded)
fn link_queue_acl(var l: Link, start: Bool, var data: Vec[u8; 260], n: Int) -> Bool
    if not l.live or l.closing or n > ll_data.PAYLOAD_EXT_MAX or l.txq_count >= ACL_SLOTS
        return false
    let slot = (l.txq_head + l.txq_count) % ACL_SLOTS
    var llid = ll_data.LLID_CONTINUE
    if start
        llid = ll_data.LLID_START
    l.data_out = l.data_out + 1
    // The payload is in `data` from octet 2, where the data PDU has it: the header goes in front
    // and the whole buffer is the slot, one copy.
    data[0] = llid as u8
    data[1] = n as u8
    if slot == 0
        l.txq0 = data
    else if slot == 1
        l.txq1 = data
    else
        l.txq2 = data
    l.txq_count = l.txq_count + 1
    link_prepare(var l)
    true

// Octet `i` of the data PDU in slot `slot` of the ACL queue: the header, then the payload.
@tier(embedded)
fn slot_octet(var l: Link, slot: Int, i: Int) -> Int
    match slot
        0 => l.txq0[i] as Int
        1 => l.txq1[i] as Int
        _ => l.txq2[i] as Int

// The whole PDU of slot `slot` into `nxt`.
@tier(embedded)
fn slot_to_nxt(var l: Link, slot: Int)
    if slot == 0
        l.nxt.b = l.txq0
    else if slot == 1
        l.nxt.b = l.txq1
    else
        l.nxt.b = l.txq2

// Set whether a new packet can be taken: there are buffers for it to go to
// (`pool_free` is the Controller's free packet slots) and room to answer it.
@tier(embedded)
fn link_set_room(var l: Link, pool_free: Int)
    l.room = pool_free >= 2 and l.cq_count <= CTRL_SLOTS - 2

// Copy a PDU.
@tier(embedded)
fn pdu_copy(var dst: Pdu, var src: Pdu)
    dst.n = src.n
    dst.b = src.b

// Fill `nxt` with the next PDU of the packet at the head of the ACL queue: the whole of
// the rest of it when the data length in force allows (`tx_limit`), otherwise the next
// piece of that length, an LLID 1 fragment after the first.  The packet leaves the
// queue with its last piece, which is the one that frees the Host's buffer.
@tier(embedded)
fn take_acl(var l: Link)
    let slot = l.txq_head
    let total = slot_octet(var l, slot, 1)
    let off = l.txq_off
    var piece = total - off
    var last = true
    let lim = tx_limit(var l)
    if piece > lim
        piece = lim
        last = false
    if off == 0 and last
        // The whole packet in one PDU, as the Host sent it: one copy.
        slot_to_nxt(var l, slot)
    else
        // A piece of it: the header, and the octets from where the last piece stopped.
        var llid = slot_octet(var l, slot, 0)
        if off > 0
            llid = ll_data.LLID_CONTINUE
        l.nxt.b[0] = llid as u8
        l.nxt.b[1] = piece as u8
        for i in 0..piece
            l.nxt.b[2 + i] = slot_octet(var l, slot, 2 + off + i) as u8
    l.nxt.n = piece + 2
    if last
        l.txq_head = (l.txq_head + 1) % ACL_SLOTS
        l.txq_count = l.txq_count - 1
        l.txq_off = 0
        l.nxt_kind = K_ACL
    else
        l.txq_off = off + piece
        l.nxt_kind = K_ACL_PART
    l.dirty = true

// Fill `nxt` from the queues when it holds nothing, LL Control PDUs first, and
// set the MD bit it carries: more waits behind it.
@tier(embedded)
fn link_prepare(var l: Link)
    if l.nxt_kind == K_EMPTY
        if l.cq_count > 0
            slot_get_cq(var l, l.cq_head, var l.nxt)
            l.cq_head = (l.cq_head + 1) % CTRL_SLOTS
            l.cq_count = l.cq_count - 1
            l.nxt_kind = K_CTRL
            l.dirty = true
        else if l.txq_count > 0 and l.enc_ph == ENC_IDLE
            take_acl(var l)
    var md = 0
    if l.cq_count > 0 or (l.txq_count > 0 and l.enc_ph == ENC_IDLE)
        md = 1
    if md != l.nxt_md
        l.nxt_md = md
        l.dirty = true

// ── Channel selection algorithm #2, Section 4.5.8.3 ──────────────────

// The octet `v` with its bits in the opposite order.
@tier(embedded)
fn reverse_octet(v: Int) -> Int
    var r = 0
    for k in 0..8
        r = (r << 1) | ((v >>> k) & 1)
    r

// The permutation: the bits of each octet of the 16-bit `x` reversed in place.
@tier(embedded)
fn csa2_permute(x: Int) -> Int
    (reverse_octet((x >>> 8) & 0xFF) << 8) | reverse_octet(x & 0xFF)

// The pseudo-random number of an event: three rounds of permutation and the
// multiply, add and modulo block, then the identifier again (Figure 4.56).
@tier(embedded)
fn csa2_prn(id: Int, counter: Int) -> Int
    var s = (counter ^ id) & 0xFFFF
    for _ in 0..3
        s = (17 * csa2_permute(s) + id) & 0xFFFF
    s ^ id

// The data channel of the event with `counter` on a connection with the
// channelIdentifier `id`: the pseudo-random number modulo 37 when that channel is
// used, otherwise the used channel the number scales to (Section 4.5.8.3.4).
@satisfies("REQ-BLE-CTL-025")
@tier(embedded)
fn csa2_channel(id: Int, counter: Int, map: Int, n_used: Int) -> Int
    let prn = csa2_prn(id, counter)
    let unmapped = prn % 37
    if ((map >>> unmapped) & 1) == 1
        return unmapped
    nth_used(map, (n_used * prn) >>> 16)

// ── Channel selection algorithm #1, Section 4.5.8.2 ──────────────────

// The data channel of the next event.
@satisfies("REQ-BLE-CTL-016")
@tier(embedded)
fn chan_next(var l: Link) -> Int
    if l.csa2
        return csa2_channel(l.chan_id, l.ev_count, l.chmap, l.n_used)
    l.unmapped = (l.unmapped + l.hop) % 37
    if ((l.chmap >>> l.unmapped) & 1) == 1
        return l.unmapped
    nth_used(l.chmap, l.unmapped % l.n_used)

// ── The window ───────────────────────────────────────────────────────

// The window widening of the next event, [Vol 6] Part B, Section 4.5.7:
// the clock accuracies of the two ends over the time since the last anchor,
// and the jitter.  It never exceeds half the interval less T_IFS, so the
// windows of two events cannot meet.
@satisfies("REQ-BLE-CTL-016")
@tier(embedded)
fn widening(var l: Link) -> Int
    if l.central
        return 0
    let elapsed = l.due - l.t_ref
    var w = ((sca_ppm(l.sca) + OWN_PPM) * elapsed) / 1000000 + JITTER_US
    let cap = (l.sub_gap as Int) * interval_us(l) / 2 - T_IFS_US
    if w > cap
        w = cap
    w

// The time the receiver must be listening from.
@tier(embedded)
fn link_listen_start(var l: Link) -> Int
    l.due - widening(var l)

// The time the receiver gives up, when no packet has started.
@tier(embedded)
fn link_listen_end(var l: Link) -> Int
    l.due + l.win_len + widening(var l)

// The Connected Isochronous Stream (Host Support) feature bit, as the Host set it with LE Set Host
// Feature: it goes to the peer in the feature set.
@tier(embedded)
fn link_set_host_iso(var l: Link, on: Bool)
    l.host_iso = on

// The anchor point of the connection event with the counter `evc` (a CIS offset is measured from
// it, Section 2.4.2.31), as the schedule stands while the event under way is `ev_count`: the anchor
// of this event and whole intervals on.  -1 when the event is behind this one, -2 when a Connection Update
// has its instant between the two, which moves the anchors in a way the caller cannot know.
@satisfies("REQ-BLE-CTL-055")
@tier(embedded)
fn link_event_time(var l: Link, evc: Int) -> Int
    let ahead = (evc - l.ev_count) & 0xFFFF
    if ahead >= 0x8000
        return -1
    if l.upd_pending and ((l.upd_instant - l.ev_count) & 0xFFFF) <= ahead
        return -2
    var base = l.due
    if l.ev_anchor
        base = l.anchor
    base + ahead * interval_us(l)

// The time a booking of the radio for a connection event covers beyond its window: two
// exchanges of the longest packets in force on the PHY in force, each a packet of this end,
// T_IFS, a packet of the peer and T_IFS, but never less than `base` (the booking of a
// connection of 27 octets at LE 1M) and never into the last millisecond of the interval.
@satisfies("REQ-BLE-CTL-044")
@tier(embedded)
fn link_book_us(var l: Link, base: Int) -> Int
    let tx = ll_phy.air_us(l.phy, l.phy_opt != ll_phy.OPT_S2, 2 + tx_limit(var l) + ll_phy.MIC_OCTETS)
    let rx_octets = ll_phy.lesser(eff_rx_octets(var l), ll_phy.greater(ll_phy.PAYLOAD_MIN, ll_phy.fit_octets(l.phy, true, eff_rx_time(var l, l.phy))))
    let rx = ll_phy.air_us(l.phy, true, 2 + rx_octets + ll_phy.MIC_OCTETS)
    var b = 2 * (tx + rx + 2 * T_IFS_US)
    let cap = interval_us(l) - 1000
    if b > cap
        b = cap
    ll_phy.greater(base, b)

// ── The event ────────────────────────────────────────────────────────

// Whether the instant of a procedure has passed: the connection event counter
// has reached it or is past it, modulo 65536 (Section 5.1.1).
@tier(embedded)
fn instant_passed(var l: Link, instant: Int) -> Bool
    let ahead = (instant - l.ev_count) & 0xFFFF
    ahead == 0 or ahead >= 0x8000

// The event starts.  The procedures whose instant is this event take effect:
// the new channel map from this event on, and the new parameters, whose
// transmit window `link_event_done` already put in `due`; the Host is told of
// parameters that changed, or of any update it asked for.  The answer is the
// channel of the event.
@satisfies("REQ-BLE-CTL-016")
@tier(embedded)
fn link_event_begin(var l: Link) -> Int
    if l.chm_pending and (l.ev_count & 0xFFFF) == l.chm_instant
        l.chmap = l.chm_map
        l.n_used = popcount(l.chmap)
        l.chm_pending = false
    if l.upd_pending and (l.ev_count & 0xFFFF) == l.upd_instant
        let changed = l.interval != l.upd_interval or l.latency != l.upd_latency or l.timeout != l.upd_timeout
        l.interval = l.upd_interval
        l.latency = l.upd_latency
        l.timeout = l.upd_timeout
        l.upd_pending = false
        if ctl_limits.rate_on() and fx_get(l, FX_RATE, 1) == 1
            rate_apply(var l, changed)
        else if changed or l.upd_host
            l.upd_status = STATUS_SUCCESS
            l.owed = l.owed | EV_UPDATED
        l.upd_host = false
        l.last_rx = l.due
        dle_refresh(var l)
    if l.phy_pending and (l.ev_count & 0xFFFF) == l.phy_instant
        phy_apply(var l)
    l.ev_open = true
    l.ev_anchor = false
    l.bad_run = 0
    if l.central
        // The Central's anchor point is the time it sends at.
        l.ev_anchor = true
        l.anchor = l.due
    chan_next(var l)

// A packet arrived at `start_us`, the time its preamble began.  The first of an
// event is the anchor point, whatever its CRC said: only the access address has
// to match (Section 4.5.5 and Section 4.5.7).  The supervision timer is reset
// by a packet with a good CRC (`good`) alone.
@tier(embedded)
fn link_note_rx(var l: Link, start_us: Int, good: Bool)
    if not l.ev_anchor
        l.ev_anchor = true
        l.anchor = start_us
    if l.central
        // A packet with a CRC error does not make a Central's connection.
        if good and not l.synced
            l.synced = true
            l.owed = l.owed | EV_CONNECTED
    else
        l.synced = true
    if good
        l.last_rx = start_us
        l.bad_run = 0
    else
        l.bad_run = l.bad_run + 1

// The event ended at `now`.  The next one is due the interval after the
// anchor, or after where the anchor was expected when none arrived, which
// keeps the window wide for the transmit window of the first event and of a
// connection update.  The supervision timers are read: a link that never saw a
// packet fails to establish after six intervals, one that has heard none for
// the supervision timeout is lost, and a procedure that waits for the peer
// longer than the response timeout ends the connection.
@satisfies("REQ-BLE-CTL-017")
@tier(embedded)
fn link_event_done(var l: Link, now: Int)
    l.now = now
    var base = l.due
    var miss = true
    if l.ev_anchor
        base = l.anchor
        miss = false
        l.t_ref = l.anchor
    l.ev_open = false
    if (ctl_limits.features_octet4() & FEAT4_SUB) != 0
        sub_event_end(var l)
    l.ev_count = (l.ev_count + 1) & 0xFFFF
    if (ctl_limits.features_octet4() & FEAT4_SUB) != 0
        sub_wrap(var l)
    if l.upd_pending and l.ev_count == l.upd_instant
        l.due = base + interval_us(l) + l.upd_win_offset * UNIT_US
        l.win_len = l.upd_win_size * UNIT_US
    else
        l.due = base + interval_us(l)
        if not miss
            l.win_len = 0
    if (ctl_limits.features_octet4() & FEAT4_SUB) != 0
        sub_skip(var l)
    if not l.synced
        if now > l.first_due + MAX_WINDOW_US + ESTABLISH_EVENTS * interval_us(l)
            link_close(var l, REASON_FAILED_TO_ESTABLISH)
    else if now - l.last_rx > l.timeout * TIMEOUT_UNIT_US
        if l.term_sent
            link_close(var l, REASON_LOCAL_HOST)
        else
            link_close(var l, REASON_TIMEOUT)
    if l.term_sent and now - l.term_t0 > l.timeout * TIMEOUT_UNIT_US
        link_close(var l, REASON_LOCAL_HOST)
    if l.proc != PROC_NONE and now - l.proc_t0 > PROC_TIMEOUT_US
        link_close(var l, REASON_RESPONSE_TIMEOUT)
    if l.dl_wait and now - l.dl_t0 > PROC_TIMEOUT_US
        link_close(var l, REASON_RESPONSE_TIMEOUT)
    if l.phy_state != PHY_IDLE and now - l.phy_t0 > PROC_TIMEOUT_US
        link_close(var l, REASON_RESPONSE_TIMEOUT)
    if l.live and not l.closing
        link_tasks(var l)

// ── The packet ───────────────────────────────────────────────────────

// The Controller's own feature set, eight octets.
@tier(embedded)
fn own_features(var f: Vec[u8; 8], host_iso: Bool, host_sub: Bool)
    for i in 0..8
        f[i] = 0
    f[0] = FEATURES_OCTET0 as u8
    f[1] = ctl_limits.features_octet1() as u8
    f[2] = FEATURES_OCTET2 as u8
    f[3] = ctl_limits.features_octet3() as u8
    f[5] = ctl_limits.features_octet5() as u8
    if ctl_limits.feat_on()
        f[7] = ll_feat.OCTET7_EXT as u8
    var o4 = ctl_limits.features_octet4()
    if host_sub and (ctl_limits.features_octet4() & FEAT4_SUB) != 0
        o4 = o4 | FEAT4_SUB_HOST
    if host_iso and (ctl_limits.features_octet3() & FEAT3_ISO) != 0
        o4 = o4 | FEAT4_ISO_HOST
    f[4] = o4 as u8

// The feature set of a Controller whose radio lacks LE Coded: bit 11 (octet 1 bit 3) is clear.
@tier(embedded)
fn clear_coded(var f: Vec[u8; 8])
    f[1] = ((f[1] as Int) & 0xF7) as u8

// The radio under this link lacks LE Coded: the features sent to the peer say so.
@tier(embedded)
fn link_set_no_coded(var l: Link, on: Bool)
    l.no_coded = on

// The header of the packet that was just received decides what goes back, in
// the time T_IFS leaves, so this is the only work done between the packets.  It
// reads SN, NESN and MD of the Central's header octet `hdr0` and answers the
// header octet to send (Section 4.5.9): the LLID, MD and SN of the PDU the
// Central's NESN selects, and this end's NESN.  A new packet is taken when its
// SN is the NESN expected and there is `room`; the NESN does not move
// otherwise, which asks the Central to send it again.  The verdicts are kept in
// `acked` (the PDU in flight is acknowledged, so `nxt` is sent), `rx_new`,
// `use_nxt` and `cont` (either end set MD, so the event goes on).
@satisfies("REQ-BLE-CTL-017")
@no_alloc
@tier(embedded)
fn link_rx_fast(var l: Link, hdr0: Int) -> Int
    let sn_r = (hdr0 >>> 3) & 1
    let nesn_r = (hdr0 >>> 2) & 1
    let md_r = (hdr0 >>> 4) & 1
    l.acked = nesn_r != l.sn
    l.rx_new = false
    if sn_r == l.nesn and l.room
        l.rx_new = true
        l.nesn = l.nesn ^ 1
    else if sn_r == l.nesn
        l.held = l.held + 1
    var out_sn = l.sn
    var llid = ll_data.dpdu_llid(var l.cur)
    var md = l.cur_md
    l.use_nxt = false
    if l.acked
        out_sn = l.sn ^ 1
        llid = ll_data.dpdu_llid(var l.nxt)
        md = l.nxt_md
        l.use_nxt = true
    l.cont = md == 1 or md_r == 1
    if (ctl_limits.features_octet4() & FEAT4_SUB) != 0 and (l.sub_factor > 1 or l.sub_tr)
        if (l.acked and ll_data.dpdu_len(var l.nxt) > 0) or (not l.acked and ll_data.dpdu_len(var l.cur) > 0)
            l.sub_busy = true
    llid | (l.nesn << 2) | (out_sn << 3) | (md << 4)

// The header to send after a packet whose CRC was wrong: its SN, NESN and MD
// cannot be trusted, so nothing is acknowledged and the PDU in flight goes
// again with this end's NESN as it was (Section 4.5.9).  The event goes on.
@satisfies("REQ-BLE-CTL-017")
@no_alloc
@tier(embedded)
fn link_rx_bad(var l: Link) -> Int
    l.acked = false
    l.rx_new = false
    l.use_nxt = false
    l.cont = true
    ll_data.dpdu_llid(var l.cur) | (l.nesn << 2) | (l.sn << 3) | (l.cur_md << 4)

// Whether the Peripheral answers a packet whose CRC was wrong: not after two
// in a row in one event, which close it (Section 4.5.6).
@tier(embedded)
fn link_answers_bad(var l: Link) -> Bool
    l.bad_run < 2 and not l.central

// The header octet of the first packet of a Central's event: the LLID and MD of
// the PDU in flight with this end's SN and NESN (Section 4.5.9).  The radio sends
// the PDU in flight again until the Peripheral acknowledges it.
@satisfies("REQ-BLE-CTL-022")
@no_alloc
@tier(embedded)
fn link_first_header(var l: Link) -> Int
    if (ctl_limits.features_octet4() & FEAT4_SUB) != 0 and (l.sub_factor > 1 or l.sub_tr) and ll_data.dpdu_len(var l.cur) > 0
        l.sub_busy = true
    ll_data.dpdu_llid(var l.cur) | (l.nesn << 2) | (l.sn << 3) | (l.cur_md << 4)

// The PDU in flight was acknowledged.  A Host buffer is free again and the
// Host is owed the count; the LL_TERMINATE_IND that was sent ends the link.
@tier(embedded)
fn acked_done(var l: Link)
    if l.cur_kind == K_ACL
        l.completed = l.completed + 1
        l.owed = l.owed | EV_COMPLETED
    else if l.cur_kind == K_CTRL
        if ll_data.dpdu_opcode(var l.cur) == ll_data.OP_TERMINATE_IND
            link_close(var l, REASON_LOCAL_HOST)
        else if l.sub_tr and ll_data.dpdu_opcode(var l.cur) == ll_data.OP_SUBRATE_IND
            sub_central_done(var l)

// Move `nxt` to `cur` once the Central has acknowledged `cur`.
@tier(embedded)
fn promote(var l: Link)
    acked_done(var l)
    if l.enc_tx and ll_data.dpdu_len(var l.cur) > 0
        l.tx_ctr = l.tx_ctr + 1
    l.sn = l.sn ^ 1
    pdu_copy(var l.cur, var l.nxt)
    l.cur_kind = l.nxt_kind
    l.cur_md = l.nxt_md
    l.nxt_kind = K_EMPTY
    ll_data.dpdu_empty(var l.nxt)
    l.dirty = true

// Queue the PDU in `tmp` or note that the queue was full.  A full queue drops
// the answer, which the room check before each packet makes unreachable.
@tier(embedded)
fn send_tmp(var l: Link)
    let _q = ctrl_queue(var l, var l.tmp)

// Queue the PDU in `tmp`; false when the control queue is full.
@tier(embedded)
fn link_send_tmp(var l: Link) -> Bool
    ctrl_queue(var l, var l.tmp)

// Answer a PDU of an opcode this Link Layer does not know.
@tier(embedded)
fn answer_unknown(var l: Link, op: Int)
    ll_data.ctrl_unknown_rsp(var l.tmp, op)
    send_tmp(var l)

// Keep the feature set of the Peripheral's peer, from the payload of `rx`.
@tier(embedded)
fn keep_features(var l: Link, var rx: Pdu)
    for i in 0..8
        l.peer_feat[i] = ll_data.dpdu_byte(var rx, 1 + i) as u8
    l.have_feat = true

// LL_CONNECTION_UPDATE_IND (Section 5.1.1).  The parameters are checked as the
// CONNECT_IND's are; a PDU whose instant has passed ends the connection with
// Instant Passed.  A Peripheral that asked for the update with
// LL_CONNECTION_PARAM_REQ has its answer, and the Host is told when it applies
// even if nothing changed.
@satisfies("REQ-BLE-CTL-019")
@tier(embedded)
fn ctrl_connection_update(var l: Link, var rx: Pdu)
    let win_size = ll_data.dpdu_byte(var rx, 1)
    let win_offset = ll_data.dpdu_u16(var rx, 2)
    let interval = ll_data.dpdu_u16(var rx, 4)
    let latency = ll_data.dpdu_u16(var rx, 6)
    let timeout = ll_data.dpdu_u16(var rx, 8)
    let instant = ll_data.dpdu_u16(var rx, 10)
    if interval < 6 or interval > 3200 or latency > 499
        return
    if timeout < 10 or timeout > 3200 or timeout * 4 <= (1 + latency) * interval
        return
    if instant_passed(var l, instant)
        link_close(var l, REASON_INSTANT_PASSED)
        return
    l.upd_host = l.proc == PROC_PARAM
    if l.upd_host
        l.proc = PROC_NONE
    l.upd_pending = true
    l.upd_instant = instant
    l.upd_win_size = win_size
    l.upd_win_offset = win_offset
    l.upd_interval = interval
    l.upd_latency = latency
    l.upd_timeout = timeout

// LL_CHANNEL_MAP_IND (Section 5.1.2).  A map with fewer than two channels, or
// with a bit past channel 36, is not one a Central may send and is ignored.
@satisfies("REQ-BLE-CTL-019")
@tier(embedded)
fn ctrl_channel_map(var l: Link, var rx: Pdu)
    var map = 0
    for k in 0..5
        map = map | (ll_data.dpdu_byte(var rx, 1 + k) << (8 * k))
    let instant = ll_data.dpdu_u16(var rx, 6)
    if (map >>> 37) != 0 or popcount(map) < 2
        return
    if instant_passed(var l, instant)
        link_close(var l, REASON_INSTANT_PASSED)
        return
    l.chm_pending = true
    l.chm_instant = instant
    l.chm_map = map

// The opcode of the feature exchange this end starts: the Central sends
// LL_FEATURE_REQ, the Peripheral LL_PERIPHERAL_FEATURE_REQ (Section 5.1.4).
@tier(embedded)
fn features_request_opcode(var l: Link) -> Int
    if l.central
        ll_data.OP_FEATURE_REQ
    else
        ll_data.OP_PERIPHERAL_FEATURE_REQ

// The procedure `proc` ended without the answer it waited for: the Host gets LE
// Connection Update Complete with `code`.
@tier(embedded)
fn param_failed(var l: Link, code: Int)
    if l.proc == PROC_PARAM
        l.proc = PROC_NONE
        l.upd_status = code
        l.owed = l.owed | EV_UPDATED

// The peer refused the Connection Parameters Request with `code`.  A Central whose peer
// answers Unsupported Remote Feature (a legacy Host, or one with the event masked) updates
// with LL_CONNECTION_UPDATE_IND instead; any other code is the Host's answer
// (Section 5.1.7.2).
@satisfies("REQ-BLE-CTL-067")
@tier(embedded)
fn param_rejected(var l: Link, code: Int)
    if l.central and l.proc == PROC_PARAM and code == STATUS_UNSUPPORTED_REMOTE
        central_fallback(var l)
    else
        param_failed(var l, code)

// LL_UNKNOWN_RSP: the peer does not know the procedure this end started.
@tier(embedded)
fn ctrl_unknown_received(var l: Link, var rx: Pdu)
    let op = ll_data.dpdu_byte(var rx, 1)
    enc_unknown(var l, op)
    if op == ll_data.OP_LENGTH_REQ
        dle_refused(var l, true)
    else if op == ll_data.OP_PHY_REQ
        phy_refused(var l, true, 0)
    if l.proc == PROC_FEATURES and op == features_request_opcode(var l)
        l.proc = PROC_NONE
        if ctl_limits.feat_on() and fx_all(l)
            fx_finish(var l, STATUS_UNSUPPORTED_REMOTE)
        else
            l.feat_status = STATUS_UNSUPPORTED_REMOTE
            l.owed = l.owed | EV_FEATURES
    else if ctl_limits.feat_on() and l.proc == PROC_FEATEXT and op == ll_data.OP_FEATURE_EXT_REQ
        fx_finish(var l, STATUS_UNSUPPORTED_REMOTE)
    else if ctl_limits.sca_on() and l.proc == PROC_SCA and op == ll_data.OP_CLOCK_ACCURACY_REQ
        sca_finish(var l, ll_sca.E_UNSUPPORTED)
    else if l.proc == PROC_PARAM and op == ll_data.OP_CONNECTION_PARAM_REQ
        l.cpr_no = true
        if l.central
            central_fallback(var l)
        else
            param_failed(var l, STATUS_UNSUPPORTED_REMOTE)
    else if l.proc == PROC_PING and op == ll_data.OP_PING_REQ
        l.proc = PROC_NONE
        l.ping_ok = false

// LL_REJECT_IND or LL_REJECT_EXT_IND (Section 5.1.7.2): the peer refused the
// Connection Parameters Request with `code`.
@satisfies("REQ-BLE-CTL-027")
@tier(embedded)
fn ctrl_reject_received(var l: Link, var rx: Pdu)
    if ll_data.dpdu_opcode(var rx) == ll_data.OP_REJECT_IND
        enc_rejected(var l, ll_data.dpdu_byte(var rx, 1))
        param_rejected(var l, ll_data.dpdu_byte(var rx, 1))
        phy_rejected(var l, ll_data.dpdu_byte(var rx, 1))
        dle_refused(var l, false)
    else if ll_data.dpdu_byte(var rx, 1) == ll_data.OP_ENC_REQ
        enc_rejected(var l, ll_data.dpdu_byte(var rx, 2))
    else if ctl_limits.feat_on() and ll_data.dpdu_byte(var rx, 1) == ll_data.OP_FEATURE_EXT_REQ
        if l.proc == PROC_FEATEXT
            fx_finish(var l, ll_data.dpdu_byte(var rx, 2))
    else if ctl_limits.sca_on() and ll_data.dpdu_byte(var rx, 1) == ll_data.OP_CLOCK_ACCURACY_REQ
        if l.proc == PROC_SCA
            sca_finish(var l, ll_data.dpdu_byte(var rx, 2))
    else if ll_data.dpdu_byte(var rx, 1) == ll_data.OP_CONNECTION_PARAM_REQ
        param_rejected(var l, ll_data.dpdu_byte(var rx, 2))
    else if ll_data.dpdu_byte(var rx, 1) == ll_data.OP_PHY_REQ
        phy_rejected(var l, ll_data.dpdu_byte(var rx, 2))
    else if ll_data.dpdu_byte(var rx, 1) == ll_data.OP_LENGTH_REQ
        dle_refused(var l, false)

// Refuse the PDU with opcode `rejected` for `code`: with LL_REJECT_EXT_IND, or
// with LL_REJECT_IND to a peer known to lack Extended Reject Indication
// (Section 2.4.2.18).
@satisfies("REQ-BLE-CTL-027")
@tier(embedded)
fn send_reject(var l: Link, rejected: Int, code: Int)
    if l.have_feat and ((l.peer_feat[0] as Int) & FEAT0_EXT_REJECT) == 0
        ll_data.ctrl_reject(var l.tmp, code)
    else
        ll_data.ctrl_reject_ext(var l.tmp, rejected, code)
    send_tmp(var l)

// LL_VERSION_IND (Section 5.2): the first of the peer is kept.  This end sends
// its own once, whoever began, and the Host is told when it asked.
@tier(embedded)
fn ctrl_version_received(var l: Link, var rx: Pdu)
    if l.ver_rcvd
        return
    l.ver_rcvd = true
    l.peer_ver = ll_data.dpdu_byte(var rx, 1)
    l.peer_company = ll_data.dpdu_u16(var rx, 2)
    l.peer_sub = ll_data.dpdu_u16(var rx, 4)
    if not l.ver_sent
        ll_data.ctrl_version(var l.tmp, LL_VERSION, LL_COMPANY, LL_SUBVERSION)
        send_tmp(var l)
        l.ver_sent = true
    if l.proc == PROC_VERSION
        l.proc = PROC_NONE
        l.ver_status = STATUS_SUCCESS
        l.owed = l.owed | EV_VERSION

// Act on the LL Control PDU in `rx`, which was taken as new data.  An opcode
// the Link Layer does not know is answered with LL_UNKNOWN_RSP; one it knows
// with a payload of the wrong length is ignored.
@satisfies("REQ-BLE-CTL-019")
@tier(embedded)
fn ctrl_rx(var l: Link, var rx: Pdu)
    let op = ll_data.dpdu_opcode(var rx)
    if ctl_limits.rate_on() and (op == ll_data.OP_CONNECTION_RATE_REQ or op == ll_data.OP_CONNECTION_RATE_IND)
        rate_rx(var l, var rx, op)
        return
    if ctl_limits.fs_on() and (op == ll_data.OP_FRAME_SPACE_REQ or op == ll_data.OP_FRAME_SPACE_RSP)
        fs_rx(var l, var rx, op)
        return
    let want = ll_data.ctrl_payload_len(op)
    if want < 0
        answer_unknown(var l, op)
        return
    if ll_data.dpdu_len(var rx) != want
        if op == ll_data.OP_CIS_REQ
            l.cis_dropped = l.cis_dropped + 1
        return
    // The updates and LL_FEATURE_REQ are the Central's to send, and
    // LL_PERIPHERAL_FEATURE_REQ the Peripheral's: an end that receives the other
    // role's PDU does not know it (Section 2.4.2).
    if l.central and (op == 0x00 or op == 0x01 or op == 0x08 or op == 0x18)
        answer_unknown(var l, op)
        return
    if not l.central and op == 0x17
        answer_unknown(var l, op)
        return
    if l.central and op == 0x0E
        ctrl_feature_request(var l, var rx)
        return
    // LL_PERIODIC_SYNC_IND belongs to a build with the Periodic Advertising Sync Transfer - Recipient feature (octet 3 bit 1).
    if op == 0x1C and (ctl_limits.features_octet3() & 0x02) == 0
        answer_unknown(var l, op)
        return
    // The procedures of the isochronous channels (Section 5.1.15 and 5.1.16) and the Sleep Clock
    // Accuracy update belong to a build that has them; the creation PDUs go the one way each.
    if (op >= 0x1F or op == 0x1D or op == 0x1E) and op < 0x23 and ((ctl_limits.features_octet3() & FEAT3_ISO) == 0 or (l.central and (op == 0x1F or op == 0x21)) or (not l.central and op == 0x20))
        if op == ll_data.OP_CIS_REQ
            l.cis_dropped = l.cis_dropped + 1
        answer_unknown(var l, op)
        return
    // The Power Control PDUs belong to a build with LE Power Control (features 33 and 34).
    if op >= 0x23 and op <= 0x25 and (ctl_limits.features_octet4() & FEAT4_PCL) == 0
        answer_unknown(var l, op)
        return
    // A refusal of LL_CIS_REQ, by LL_REJECT_EXT_IND or LL_UNKNOWN_RSP, ends the creation procedure of a Central.
    if (ctl_limits.features_octet3() & FEAT3_ISO) != 0 and l.central and (op == 0x11 or op == 0x07) and ll_data.dpdu_byte(var rx, 1) == ll_data.OP_CIS_REQ
        l.ctl_in = true
        return
    // The Feature Page Exchange PDUs belong to a build with the feature (feature 63).
    if (op == 0x2B or op == 0x2C) and not ctl_limits.feat_on()
        answer_unknown(var l, op)
        return
    // The Connection Subrating PDUs belong to a build with the feature (feature 37); LL_SUBRATE_IND goes from the Central to the Peripheral.
    if (op == 0x26 or op == 0x27) and ((ctl_limits.features_octet4() & FEAT4_SUB) == 0 or (op == 0x27 and l.central))
        answer_unknown(var l, op)
        return
    // A refusal of LL_SUBRATE_REQ ends the request this end sent.
    if (ctl_limits.features_octet4() & FEAT4_SUB) != 0 and (op == 0x11 or op == 0x07) and ll_data.dpdu_byte(var rx, 1) == ll_data.OP_SUBRATE_REQ
        l.ctl_in = true
        return
    // A refusal of LL_CONNECTION_RATE_REQ, or the answer that the Peripheral does not know LL_CONNECTION_RATE_IND, ends the request this end
    // sent; the Controller reports it.
    if ctl_limits.rate_on() and (op == 0x11 or op == 0x07) and (ll_data.dpdu_byte(var rx, 1) == ll_data.OP_CONNECTION_RATE_REQ or (op == 0x07 and ll_data.dpdu_byte(var rx, 1) == ll_data.OP_CONNECTION_RATE_IND))
        l.ctl_in = true
        return
    // A refusal of LL_FRAME_SPACE_REQ, by LL_REJECT_EXT_IND or LL_UNKNOWN_RSP, ends the request this end sent; the Controller reports it.
    if ctl_limits.fs_on() and (op == 0x11 or op == 0x07) and ll_data.dpdu_byte(var rx, 1) == ll_data.OP_FRAME_SPACE_REQ
        l.ctl_in = true
        return
    // A refusal of LL_POWER_CONTROL_REQ ends the request this end sent.
    if (ctl_limits.features_octet4() & FEAT4_PCL) != 0 and (op == 0x11 or op == 0x07) and ll_data.dpdu_byte(var rx, 1) == ll_data.OP_POWER_CONTROL_REQ
        l.ctl_in = true
        return
    match op
        0x00 => ctrl_connection_update(l, rx)
        0x01 => ctrl_channel_map(l, rx)
        0x02 => link_close(var l, ll_data.dpdu_byte(var rx, 1))
        0x03 => ctrl_enc_req(l, rx)
        0x04 => ctrl_enc_rsp(l, rx)
        0x05 => ctrl_start_enc_req(var l)
        0x06 => ctrl_start_enc_rsp(var l)
        0x07 => ctrl_unknown_received(var l, var rx)
        0x08 => ctrl_feature_request(var l, var rx)
        0x09 => ctrl_feature_response(var l, var rx)
        0x0A => ctrl_pause_enc_req(var l)
        0x0B => ctrl_pause_enc_rsp(var l)
        0x0C => ctrl_version_received(var l, var rx)
        0x0D => ctrl_reject_received(var l, var rx)
        0x0F => ctrl_param_received(var l, var rx)
        0x10 => ctrl_param_received(var l, var rx)
        0x11 => ctrl_reject_received(var l, var rx)
        0x12 => ctrl_ping_request(var l)
        0x13 => ctrl_ping_response(var l)
        0x14 => ctrl_length_request(var l, var rx)
        0x15 => ctrl_length_response(var l, var rx)
        0x16 => ctrl_phy_request(var l, var rx)
        0x17 => central_phy_response(var l, var rx)
        0x18 => peripheral_phy_update(var l, var rx)
        0x19 => ctrl_min_used_received(var l, var rx)
        0x1C => l.ctl_in = true
        0x1F => l.ctl_in = true
        0x20 => l.ctl_in = true
        0x21 => l.ctl_in = true
        0x22 => l.ctl_in = true
        0x1D => ctrl_clock_accuracy(var l, var rx, true)
        0x1E => ctrl_clock_accuracy(var l, var rx, false)
        0x23 => l.ctl_in = true
        0x24 => l.ctl_in = true
        0x25 => l.ctl_in = true
        0x26 => l.ctl_in = true
        0x27 => sub_ind_rx(var l, var rx)
        0x2B => ctrl_feature_ext_request(var l, var rx)
        0x2C => ctrl_feature_ext_response(var l, var rx)
        _ => answer_unknown(var l, op)

// The sleep clock accuracy class of this Controller's clock (Table 2.1 of Section 2.3.3.1): the 32 MHz
// crystal's `OWN_PPM` of 50 is class 5, 31 to 50 ppm.
const OWN_SCA = 5

// LL_CLOCK_ACCURACY_REQ and LL_CLOCK_ACCURACY_RSP (Section 5.1.14, 2.4.2.28): the peer's accuracy class is
// kept, the one the window widening of a Peripheral reads, and a request is answered with this end's.
@satisfies("REQ-BLE-CTL-054")
@tier(embedded)
fn ctrl_clock_accuracy(var l: Link, var rx: Pdu, request: Bool)
    let class = ll_data.dpdu_byte(var rx, 1)
    if class > 7
        return
    l.sca = class
    if ctl_limits.sca_on() and not request and l.proc == PROC_SCA
        sca_finish(var l, STATUS_SUCCESS)
    if request
        ll_data.ctrl_begin(var l.tmp, ll_data.OP_CLOCK_ACCURACY_RSP)
        let _a = ll_pdu.pdu_put(var l.tmp, OWN_SCA)
        ll_data.dpdu_finish(var l.tmp)
        send_tmp(var l)

// The request for the peer's accuracy class ended with `status`: the Host is owed LE Request Peer SCA Complete.  The status shares the field of the
// Feature Page Exchange, whose event is not owed while this one is (`link_request_sca`, `link_read_all_features`).
@tier(embedded)
fn sca_finish(var l: Link, status: Int)
    l.proc = PROC_NONE
    fx_put(var l, FX_STATUS, 0x7F, status)
    fx_put(var l, FX_SCA, 1, 1)

// HCI LE Request Peer SCA ([Vol 4] Part E, Section 7.8.108): LL_CLOCK_ACCURACY_REQ goes out with this end's class and the peer's answer completes the
// command.  The status is Success, Unknown Connection Identifier, Unsupported Remote Feature for a peer whose features are known to lack
// Sleep Clock Accuracy Updates, or Command Disallowed while another procedure runs or an event of this kind or of the Feature Page Exchange is owed.
@satisfies("REQ-BLE-CTL-121")
@tier(embedded)
fn link_request_sca(var l: Link) -> Int
    if not l.live or l.closing
        return STATUS_UNKNOWN_CONNECTION
    if l.have_feat and ll_sca.peer_lacks(l.peer_feat[3] as Int)
        return STATUS_UNSUPPORTED_REMOTE
    if l.proc != PROC_NONE or fx_get(l, FX_SCA, 1) == 1 or (l.owed & EV_FEATEXT) != 0
        return STATUS_COMMAND_DISALLOWED
    ll_data.ctrl_begin(var l.tmp, ll_data.OP_CLOCK_ACCURACY_REQ)
    let _a = ll_pdu.pdu_put(var l.tmp, OWN_SCA)
    ll_data.dpdu_finish(var l.tmp)
    if not ctrl_queue(var l, var l.tmp)
        return STATUS_COMMAND_DISALLOWED
    l.proc = PROC_SCA
    l.proc_t0 = l.now
    link_prepare(var l)
    STATUS_SUCCESS

// LL_PHY_REQ: the Central and the Peripheral answer it in different ways.
@tier(embedded)
fn ctrl_phy_request(var l: Link, var rx: Pdu)
    if l.central
        central_phy_request(var l, var rx)
    else
        peripheral_phy_request(var l, var rx)

// LL_FEATURE_REQ: the peer's set is kept and this end's sent back, with octet
// 0 the features both ends have (Section 5.1.4.1).
@tier(embedded)
fn ctrl_feature_request(var l: Link, var rx: Pdu)
    keep_features(var l, var rx)
    var f: Vec[u8; 8] = Vec.new()
    for _ in 0..8
        let _a = f.push(0)
    own_features(var f, l.host_iso, l.host_sub)
    if l.no_coded
        clear_coded(var f)
    f[0] = (FEATURES_OCTET0 & (l.peer_feat[0] as Int)) as u8
    ll_data.ctrl_features(var l.tmp, ll_data.OP_FEATURE_RSP, var f)
    send_tmp(var l)

// LL_FEATURE_RSP: the answer to the Peripheral-initiated procedure.
@tier(embedded)
fn ctrl_feature_response(var l: Link, var rx: Pdu)
    if l.proc != PROC_FEATURES
        return
    keep_features(var l, var rx)
    l.proc = PROC_NONE
    if ctl_limits.feat_on() and fx_all(l)
        fx_next(var l)
        return
    l.feat_status = STATUS_SUCCESS
    l.owed = l.owed | EV_FEATURES

// ── The Feature Page Exchange state of a link, packed in `Link.fx` ────────────────────────────────
// Ten values share one Int, because every Link field costs frame space in every build, whether or not the feature is on.  Bit offsets:
// octets 0 to 2 of the peer's page 1 (0), a page is held (24), a read of all features runs (25), the peer's highest page (26), the pages the
// Host asked for (30), the status of the last read (34) and octets 0 and 1 of this end's page 1 (41).  The three values of Connection Rate
// (a build with `ctl_limits.rate_on()`): the update that waits for its instant is a Connection Rate update (57), the event the link owes with
// `EV_SUBRATE` is LE Connection Rate Change (58), and the read that runs is the Controller's own, which the Host is not told of (59).
const FX_PEER = 0
const FX_HAVE = 24
const FX_ALL = 25
const FX_MAX = 26
const FX_PAGES = 30
const FX_STATUS = 34
const FX_LOCAL = 41
const FX_RATE = 57
const FX_RATEEV = 58
const FX_QUIET = 59
// The Host is owed LE Request Peer SCA Complete (bit 60; a build with `ctl_limits.sca_on()`).  The sixteen bits of `Link.owed` are all taken.
const FX_SCA = 60

// The value at bit `sh` under `mask`.
@tier(embedded)
fn fx_get(l: Link, sh: Int, mask: Int) -> Int
    (l.fx >>> sh) & mask

// Set the value at bit `sh` under `mask` to `v`.
@tier(embedded)
fn fx_put(var l: Link, sh: Int, mask: Int, v: Int)
    l.fx = (l.fx & ~(mask << sh)) | ((v & mask) << sh)

// Whether a read of all features is running.
@tier(embedded)
fn fx_all(l: Link) -> Bool
    fx_get(l, FX_ALL, 1) == 1

// ── The Feature Page Exchange ([Vol 6] Part B, Sections 2.4.2.41 and 5.1.4.3) ────────────────────

// Keep page 1 of the peer, from the payload of `rx` (LL_FEATURE_EXT_REQ and RSP carry the highest page, the page number and the page): the
// first three octets, feature bits 64 to 87, which hold the bits the Core Specification defines on page 1 today; octets 3 to 23 of the page
// are not kept.  The highest page is kept up to 15; the Host is told at most 10.
@tier(embedded)
fn fx_keep(var l: Link, var rx: Pdu)
    if ll_data.dpdu_byte(var rx, 2) != 1
        return
    var v = 0
    for i in 0..3
        v = v | (ll_data.dpdu_byte(var rx, 3 + i) << (8 * i))
    var m = ll_data.dpdu_byte(var rx, 1)
    if m > 15
        m = 15
    fx_put(var l, FX_PEER, 0xFFFFFF, v)
    fx_put(var l, FX_MAX, 0xF, m)
    fx_put(var l, FX_HAVE, 1, 1)

// LL_FEATURE_EXT_REQ: the peer's page is kept and the same page of this end sent back with this end's highest page (Section 5.1.4.3).  A page
// number outside 1 to 10 is refused.  The answer does not wait for a procedure of this end, so requests that cross are both answered.
@tier(embedded)
fn ctrl_feature_ext_request(var l: Link, var rx: Pdu)
    let page = ll_data.dpdu_byte(var rx, 2)
    if not ll_feat.page_ok(page)
        send_reject(var l, ll_data.OP_FEATURE_EXT_REQ, ll_feat.E_INVALID_PARAMS)
        return
    fx_keep(var l, var rx)
    ll_feat.put_ext(var l.tmp, ll_data.OP_FEATURE_EXT_RSP, ll_feat.max_page(fx_get(l, FX_LOCAL, 0xFFFF)), page, fx_get(l, FX_LOCAL, 0xFFFF))
    send_tmp(var l)

// LL_FEATURE_EXT_RSP: the answer to the request of this end.  A page other than the one asked for ends the read with Invalid LL Parameters.
@tier(embedded)
fn ctrl_feature_ext_response(var l: Link, var rx: Pdu)
    if l.proc != PROC_FEATEXT
        return
    if ll_data.dpdu_byte(var rx, 2) != 1
        fx_finish(var l, ll_feat.E_INVALID_PARAMS)
        return
    fx_keep(var l, var rx)
    fx_finish(var l, STATUS_SUCCESS)

// The read of all remote features ended with `status`: the Host is owed LE Read All Remote Features Complete.
@tier(embedded)
fn fx_finish(var l: Link, status: Int)
    if l.proc == PROC_FEATEXT
        l.proc = PROC_NONE
    fx_put(var l, FX_ALL, 1, 0)
    fx_put(var l, FX_STATUS, 0x7F, status)
    if ctl_limits.rate_on() and fx_get(l, FX_QUIET, 1) == 1
        fx_put(var l, FX_QUIET, 1, 0)
        return
    l.owed = l.owed | EV_FEATEXT

// The feature set of page 0 is known: the read ends when the Host asked for no more, the peer lacks feature 63 or page 1 is held, and
// otherwise LL_FEATURE_EXT_REQ asks for page 1 (the pages above it are not fetched).
@tier(embedded)
fn fx_next(var l: Link)
    if fx_get(l, FX_PAGES, 0xF) == 0 or ((l.peer_feat[7] as Int) & ll_feat.OCTET7_EXT) == 0 or fx_get(l, FX_HAVE, 1) == 1
        fx_finish(var l, STATUS_SUCCESS)
        return
    ll_feat.put_ext(var l.tmp, ll_data.OP_FEATURE_EXT_REQ, ll_feat.max_page(fx_get(l, FX_LOCAL, 0xFFFF)), 1, fx_get(l, FX_LOCAL, 0xFFFF))
    if not ctrl_queue(var l, var l.tmp)
        fx_finish(var l, STATUS_COMMAND_DISALLOWED)
        return
    l.proc = PROC_FEATEXT
    l.proc_t0 = l.now
    link_prepare(var l)

// HCI LE Read All Remote Features ([Vol 4] Part E, Section 7.8.129): page 0 first, as LE Read Remote Features does it, when it is not
// known, then page 1 when the peer has feature 63 and the Host asked for a page above 0.  The status is that of the Command Status event.
@satisfies("REQ-BLE-CTL-117")
@tier(embedded)
fn link_read_all_features(var l: Link, pages: Int) -> Int
    if not l.live or l.closing
        return STATUS_UNKNOWN_CONNECTION
    if pages > ll_feat.PAGE_MAX
        return STATUS_INVALID_PARAMETERS
    if fx_all(l) or (l.owed & EV_FEATEXT) != 0 or fx_get(l, FX_SCA, 1) == 1 or l.proc != PROC_NONE
        return STATUS_COMMAND_DISALLOWED
    fx_put(var l, FX_PAGES, 0xF, pages)
    if not l.have_feat
        var f: Vec[u8; 8] = Vec.new()
        for _ in 0..8
            let _a = f.push(0)
        own_features(var f, l.host_iso, l.host_sub)
        if l.no_coded
            clear_coded(var f)
        ll_data.ctrl_features(var l.tmp, features_request_opcode(var l), var f)
        if not ctrl_queue(var l, var l.tmp)
            return STATUS_COMMAND_DISALLOWED
        fx_put(var l, FX_ALL, 1, 1)
        l.proc = PROC_FEATURES
        l.proc_t0 = l.now
        link_prepare(var l)
        return STATUS_SUCCESS
    fx_put(var l, FX_ALL, 1, 1)
    fx_next(var l)
    STATUS_SUCCESS

// LL_PING_REQ is answered at once (Section 5.1.8).
@tier(embedded)
fn ctrl_ping_request(var l: Link)
    ll_data.ctrl_ping_rsp(var l.tmp)
    send_tmp(var l)

// LL_PING_RSP: counted, and the ping this end sent is answered.
@tier(embedded)
fn ctrl_ping_response(var l: Link)
    l.ping_rsps = l.ping_rsps + 1
    if l.proc == PROC_PING
        l.proc = PROC_NONE

// ── The parameter procedures ─────────────────────────────────────────

// The instant of a procedure the Central starts now: the least number of the
// Peripheral's events away that Section 5.5 asks for, counting the events it may
// skip with its latency.
@tier(embedded)
fn instant_next(var l: Link) -> Int
    (l.ev_count + INSTANT_LEAD * (1 + l.latency) * (l.sub_factor as Int) + INSTANT_SLACK) & 0xFFFF

// Whether a procedure with an instant is under way, which no other may start
// beside (Section 5.3).
@tier(embedded)
fn instant_busy(var l: Link) -> Bool
    l.upd_pending or l.chm_pending or l.phy_pending or l.phy_state != PHY_IDLE or l.sub_tr

// ── Connection Subrating ([Vol 6] Part B, Sections 4.5.1, 5.1.19 and 5.1.20) ──────────────────────

// The Connection Subrating (Host Support) bit, as the Host set it with LE Set Host Feature: it goes to the peer in the feature set.
@tier(embedded)
fn link_set_host_sub(var l: Link, on: Bool)
    l.host_sub = on

// Whether the event `evc` is a subrated event of the grid in force, or of the new grid while a Central's update is not yet acknowledged.
@tier(embedded)
fn sub_grid(var l: Link, evc: Int) -> Bool
    ll_sub.on_grid(evc, l.sub_res as Int, l.sub_factor as Int) or (l.sub_tr and ll_sub.on_grid(evc, l.sub_nres as Int, l.sub_nf as Int))

// Whether `evc` is the event of a pending procedure or the one before it: those are used whatever the grid says, because the procedure
// takes effect in `link_event_begin` of the event itself.
@tier(embedded)
fn sub_forced(var l: Link, evc: Int) -> Bool
    (l.chm_pending and (evc == l.chm_instant or evc == ((l.chm_instant - 1) & 0xFFFF)))
        or (l.upd_pending and (evc == l.upd_instant or evc == ((l.upd_instant - 1) & 0xFFFF)))
        or (l.phy_pending and (evc == l.phy_instant or evc == ((l.phy_instant - 1) & 0xFFFF)))

// Whether the event `evc` is used: a subrated event, a continuation event, or a forced one.
@tier(embedded)
fn sub_active(var l: Link, evc: Int) -> Bool
    l.sub_left > 0 or sub_grid(var l, evc) or sub_forced(var l, evc)

// The event under way ends: the continuation count follows the activity of the event (Section 4.5.1).  A subrated event starts it afresh, a
// continuation event uses one of it, and an event with data (a packet sent or received with a non-zero Length) sets it to the continuation number.
@tier(embedded)
fn sub_event_end(var l: Link)
    if l.sub_factor <= 1 and not l.sub_tr
        l.sub_busy = false
        l.sub_left = 0
        return
    if sub_grid(var l, l.ev_count)
        l.sub_left = 0
    else if l.sub_left > 0
        l.sub_left = l.sub_left - 1
    if l.sub_busy and l.ev_anchor
        l.sub_left = l.sub_cont
    l.sub_busy = false

// The event counter wrapped to 0: the residues of the grids follow (Section 4.5.1).
@tier(embedded)
fn sub_wrap(var l: Link)
    if l.ev_count == 0 and (l.sub_factor > 1 or l.sub_tr)
        l.sub_res = ll_sub.wrap(l.sub_res as Int, l.sub_factor as Int) as u16
        if l.sub_tr
            l.sub_nres = ll_sub.wrap(l.sub_nres as Int, l.sub_nf as Int) as u16

// The events the grid leaves unused after the one that ended are counted and given their channel, so that the next used event has the
// right counter, channel and time.  `sub_gap` is the number of intervals to the next used event, which the window widening is capped by.
@tier(embedded)
fn sub_skip(var l: Link)
    l.sub_gap = 1
    if (l.sub_factor <= 1 and not l.sub_tr) or not l.synced
        return
    var n = 0
    for _ in 0..ll_sub.FACTOR_MAX
        if sub_active(var l, l.ev_count)
            break
        let _c = chan_next(var l)
        l.ev_count = (l.ev_count + 1) & 0xFFFF
        sub_wrap(var l)
        l.due = l.due + interval_us(l)
        n = n + 1
    l.sub_gap = (1 + n) as u16

// Whether a Central may start the Connection Subrate Update now: no update is open, and no other procedure with an instant is.
@tier(embedded)
fn sub_can_start(var l: Link) -> Bool
    l.live and not l.closing and l.central and l.synced and not instant_busy(var l) and l.proc == PROC_NONE

// The Central starts the update (Section 5.1.19): LL_SUBRATE_IND is queued with the base event set to the event under way (or the next one),
// whose bits 15-14 it shares, and the Central enters subrate transition mode.  False when the queue is full.
@tier(embedded)
fn sub_central_start(var l: Link, factor: Int, lat: Int, cont: Int, to: Int) -> Bool
    let base = l.ev_count
    ll_sub.put_ind(var l.tmp, factor, base, lat, cont, to)
    if not link_send_tmp(var l)
        return false
    l.sub_tr = true
    l.sub_nf = factor as u16
    l.sub_nres = ll_sub.residue(base, factor, l.ev_count) as u16
    l.sub_ncont = cont as u16
    l.sub_nlat = lat as u16
    l.sub_nto = to as u16
    true

// The Central's LL_SUBRATE_IND was acknowledged: the new values are in force (Section 5.1.19).
@tier(embedded)
fn sub_central_done(var l: Link)
    l.sub_tr = false
    sub_set(var l, l.sub_nf as Int, l.sub_nres as Int, l.sub_ncont as Int, l.sub_nlat as Int, l.sub_nto as Int)

// Put the values in force and owe the Host the event when something changed or the Host asked.
@tier(embedded)
fn sub_set(var l: Link, factor: Int, res: Int, cont: Int, lat: Int, to: Int)
    let changed = factor != (l.sub_factor as Int) or cont != (l.sub_cont as Int) or lat != l.latency or to != l.timeout
    l.sub_factor = factor as u16
    l.sub_res = res as u16
    l.sub_cont = cont as u16
    l.latency = lat
    l.timeout = to
    if changed or l.sub_host
        l.sub_status = STATUS_SUCCESS
        l.sub_owed = true
        l.owed = l.owed | EV_SUBRATE
    l.sub_host = false

// LL_SUBRATE_IND received by a Peripheral (Section 5.1.19): the values apply at once.  A PDU whose values are none a connection may have
// is not acted on.
@tier(embedded)
fn sub_ind_rx(var l: Link, var rx: Pdu)
    let factor = ll_sub.get16(var rx, 1)
    let base = ll_sub.get16(var rx, 3)
    let lat = ll_sub.get16(var rx, 5)
    let cont = ll_sub.get16(var rx, 7)
    let to = ll_sub.get16(var rx, 9)
    if factor < 1 or factor > ll_sub.FACTOR_MAX or cont >= factor or factor * (lat + 1) > ll_sub.FACTOR_MAX or to < 10 or to > 3200
        return
    if l.interval * factor * (lat + 1) >= to * 4
        return
    sub_set(var l, factor, ll_sub.residue(base, factor, l.ev_count), cont, lat, to)

// ── Connection Rate ([Vol 6] Part B, Sections 4.5.1, 5.1.32 and 5.1.33) ──────────────────────────

// The Shorter Connection Intervals (Host Support) bit (feature 73, bit 9 of page 1), as the Host set it with LE Set Host Feature: it goes to the
// peer in page 1.
@tier(embedded)
fn link_set_host_rate(var l: Link, on: Bool)
    var v = 0
    if on
        v = 1
    fx_put(var l, FX_LOCAL + 9, 1, v)

// Whether the Host set the Shorter Connection Intervals (Host Support) bit.
@tier(embedded)
fn rate_host(l: Link) -> Bool
    fx_get(l, FX_LOCAL + 9, 1) == 1

// Whether the peer's page 1 is held and has features 72 and 73, Shorter Connection Intervals and its Host Support.
@tier(embedded)
fn rate_peer_ok(l: Link) -> Bool
    fx_get(l, FX_HAVE, 1) == 1 and (fx_get(l, FX_PEER, 0xFFFFFF) & 0x300) == 0x300

// The Controller reads the peer's page 1 for itself (the Host is not told of it): the read of all features runs with the Host's event off.
@tier(embedded)
fn rate_fetch(var l: Link) -> Int
    fx_put(var l, FX_QUIET, 1, 1)
    let s = link_read_all_features(var l, 1)
    if s != STATUS_SUCCESS
        fx_put(var l, FX_QUIET, 1, 0)
    s

// Whether that read has ended (the page is held or the read failed).
@tier(embedded)
fn rate_fetch_over(l: Link) -> Bool
    not fx_all(l) and fx_get(l, FX_QUIET, 1) == 0

// connIntervalRequired of the connection in microseconds (Section 4.5.10).
@tier(embedded)
fn rate_required(var l: Link) -> Int
    ll_rate.required_us(eff_rx_time(var l, l.phy), eff_rx_octets(var l))

// The least interval the Central may pick, in units of 125 us: connIntervalUncodedMin or connIntervalCodedMin (Section 5.1.32).
@tier(embedded)
fn rate_floor(var l: Link) -> Int
    ll_rate.floor_units(rate_required(var l), l.phy == ll_phy.PHY_CODED)

// The Central updates the connection to `interval` (1.25 ms), `factor`, `lat`, `cont` and `to`, at an instant it picks (Section 5.1.32):
// LL_CONNECTION_RATE_IND goes out and the values are kept to apply at the instant, as the Peripheral does.  `host` says the Host asked, so
// it hears of the result even when nothing changed.  `off` is the anchor offset the peer prefers in units of 1.25 ms, with `ref` the event it
// counts from, or -1 for none (offset 0).  The status is Success or Command Disallowed when the control queue is full.
@satisfies("REQ-BLE-CTL-118")
@tier(embedded)
fn rate_central_start(var l: Link, interval: Int, factor: Int, lat: Int, cont: Int, to: Int, host: Bool, ref: Int, off: Int) -> Int
    let instant = instant_next(var l)
    var win_offset = 0
    if off >= 0
        win_offset = anchor_offset(l.interval, interval, instant, ref, off)
    ll_rate.put_ind(var l.tmp, win_offset * ll_rate.RATE_STEP, interval * ll_rate.RATE_STEP, instant, factor, lat, cont, to)
    if not ctrl_queue(var l, var l.tmp)
        return STATUS_COMMAND_DISALLOWED
    l.upd_pending = true
    l.upd_instant = instant
    l.upd_win_size = 0
    l.upd_win_offset = win_offset
    l.upd_interval = interval
    l.upd_latency = lat
    l.upd_timeout = to
    l.upd_host = false
    l.sub_nf = factor as u16
    l.sub_ncont = cont as u16
    l.sub_host = host
    fx_put(var l, FX_RATE, 1, 1)
    link_prepare(var l)
    STATUS_SUCCESS

// The Peripheral answered LL_CONNECTION_RATE_IND with LL_UNKNOWN_RSP: the procedure ends and the update that waited for its instant does not happen
// (Section 5.1.32).
@tier(embedded)
fn rate_cancel(var l: Link)
    if l.upd_pending and fx_get(l, FX_RATE, 1) == 1
        l.upd_pending = false
        fx_put(var l, FX_RATE, 1, 0)
        l.sub_host = false

// The instant of a Connection Rate update arrived (`link_event_begin` has put the interval, latency and timeout in force; `changed` says one
// of them differs): the subrate factor and continuation number follow, with the base event at the instant (Section 5.1.32), and the Host is owed
// LE Connection Rate Change when something changed or it asked.
@tier(embedded)
fn rate_apply(var l: Link, changed: Bool)
    fx_put(var l, FX_RATE, 1, 0)
    let diff = changed or l.sub_nf != l.sub_factor or l.sub_ncont != l.sub_cont
    l.sub_factor = l.sub_nf
    l.sub_res = ll_sub.residue(l.upd_instant, l.sub_nf as Int, l.ev_count) as u16
    l.sub_cont = l.sub_ncont
    l.sub_left = 0
    if diff or l.sub_host
        l.sub_status = STATUS_SUCCESS
        l.sub_owed = true
        fx_put(var l, FX_RATEEV, 1, 1)
        l.owed = l.owed | EV_SUBRATE
    l.sub_host = false

// Whether the peer is known to lack Frame Space Update (feature 65): its page 0 shows no feature 63, or its page 1 is held and has no bit 65.
@tier(embedded)
fn fs_peer_lacks(l: Link) -> Bool
    (l.have_feat and ((l.peer_feat[7] as Int) & ll_feat.OCTET7_EXT) == 0) or (fx_get(l, FX_HAVE, 1) == 1 and (fx_get(l, FX_PEER, 0xFFFFFF) & 0x2) == 0)

// A Frame Space Update PDU arrived: LL_FRAME_SPACE_REQ (8 octets) and LL_FRAME_SPACE_RSP (6) go to the Controller, which answers a request and
// reports the answer to the Host (`ctl_in`), in either role.
@tier(embedded)
fn fs_rx(var l: Link, var rx: Pdu, op: Int)
    var want = 6
    if op == ll_data.OP_FRAME_SPACE_REQ
        want = 8
    if ll_data.dpdu_len(var rx) == want
        l.ctl_in = true

// A Connection Rate PDU arrived.  LL_CONNECTION_RATE_REQ is the Central's to answer, and the Controller does it (`ctl_in`); a Peripheral does not
// know it.  LL_CONNECTION_RATE_IND is the Peripheral's.
@tier(embedded)
fn rate_rx(var l: Link, var rx: Pdu, op: Int)
    if op == ll_data.OP_CONNECTION_RATE_REQ
        if ll_data.dpdu_len(var rx) != 27
            return
        if l.central
            l.ctl_in = true
        else
            answer_unknown(var l, op)
        return
    if ll_data.dpdu_len(var rx) != 15
        return
    if l.central
        answer_unknown(var l, op)
    else
        rate_ind_rx(var l, var rx)

// LL_CONNECTION_RATE_IND received by a Peripheral (Section 5.1.32): the values apply at the instant.  A PDU whose fields are out of range, or an
// interval or window offset that is not a multiple of 1.25 ms, which this Link Layer does not support, is answered with LL_UNKNOWN_RSP.  An
// instant that has passed ends the connection; a PDU that comes while another update waits is not acted on.
@tier(embedded)
fn rate_ind_rx(var l: Link, var rx: Pdu)
    let woff = ll_sub.get16(var rx, 1)
    let iv = ll_sub.get16(var rx, 3)
    let instant = ll_sub.get16(var rx, 5)
    let factor = ll_sub.get16(var rx, 7)
    let lat = ll_sub.get16(var rx, 9)
    let cont = ll_sub.get16(var rx, 11)
    let to = ll_sub.get16(var rx, 13)
    if not ll_rate.rcv(iv) or woff % ll_rate.RATE_STEP != 0 or woff > iv or factor < 1 or factor > ll_sub.FACTOR_MAX or cont >= factor
        answer_unknown(var l, ll_data.OP_CONNECTION_RATE_IND)
        return
    if lat > 499 or factor * (lat + 1) > ll_sub.FACTOR_MAX or to < 10 or to > 3200 or iv / ll_rate.RATE_STEP * factor * (lat + 1) >= to * 4
        answer_unknown(var l, ll_data.OP_CONNECTION_RATE_IND)
        return
    if instant_passed(var l, instant)
        link_close(var l, REASON_INSTANT_PASSED)
        return
    if l.upd_pending
        return
    l.upd_pending = true
    l.upd_instant = instant
    l.upd_win_size = 0
    l.upd_win_offset = woff / ll_rate.RATE_STEP
    l.upd_interval = iv / ll_rate.RATE_STEP
    l.upd_latency = lat
    l.upd_timeout = to
    l.upd_host = false
    l.sub_nf = factor as u16
    l.sub_ncont = cont as u16
    fx_put(var l, FX_RATE, 1, 1)

// Whether the values are ones a connection may have.
@tier(embedded)
fn params_valid(i_min: Int, i_max: Int, latency: Int, timeout: Int) -> Bool
    i_min >= 6 and i_max <= 3200 and i_min <= i_max and latency <= 499
        and timeout >= 10 and timeout <= 3200 and timeout * 4 > (1 + latency) * i_max

// The interval the Central picks from a range: the longest multiple of the
// preferred periodicity inside it when there is one, otherwise the maximum
// (Section 5.1.7.2).
@tier(embedded)
fn pick_interval(i_min: Int, i_max: Int, period: Int) -> Int
    if period > 0 and i_min < i_max
        let m = (i_max / period) * period
        if m >= i_min
            return m
    i_max

// The Transmit Window Offset, in units of 1.25 ms, that puts the first anchor point of the
// connection with the interval `new` at `off` units from the anchor point of the event
// `ref` of the old connection, whose interval is `old`; the Central's update has its
// Instant at `instant` (Section 5.1.7.3.2).  The first packet after the instant comes
// `(new - ((instant - ref) * old) mod new + off) mod new` units after the instant (the
// transmit window of LL_CONNECTION_UPDATE_IND has no delay), and the Central sends at
// the start of the window.  The event counts are 16 bits: a Reference on the other side
// of the wrap is taken as the shorter way round.
@satisfies("REQ-BLE-CTL-068")
@tier(embedded)
fn anchor_offset(old: Int, new: Int, instant: Int, ref: Int, off: Int) -> Int
    var d = (instant - ref) & 0xFFFF
    if d >= 0x8000
        d = d - 0x10000
    let m = (((d * old) % new) + new) % new
    (new - m + (off % new)) % new

// The first of the six offsets of the PDU `rx` (LL_CONNECTION_PARAM_REQ or _RSP) that is
// not 0xFFFF, which says the sender has no preference; -1 when there is none.
@satisfies("REQ-BLE-CTL-068")
@tier(embedded)
fn first_offset(var rx: Pdu) -> Int
    for k in 0..6
        let v = ll_data.dpdu_u16(var rx, 12 + 2 * k)
        if v != 0xFFFF
            return v
    -1

// The Central updates the connection to `interval`, `latency` and `timeout` at an
// instant it picks: LL_CONNECTION_UPDATE_IND goes out and the parameters are
// kept to apply at the instant, as the Peripheral does (Section 5.1.1).  `host`
// says the Host asked, so it hears of the result even when nothing changed.  `off` is
// the anchor offset the peer prefers, with `ref` the event it counts from, or -1 for
// none: the transmit window is then at offset 0 (`anchor_offset`).  The procedure the
// Central started with LL_CONNECTION_PARAM_REQ ends with this PDU.
@satisfies("REQ-BLE-CTL-026")
@satisfies("REQ-BLE-CTL-068")
@tier(embedded)
fn central_update(var l: Link, interval: Int, latency: Int, timeout: Int, host: Bool, ref: Int, off: Int) -> Int
    let instant = instant_next(var l)
    var win_offset = 0
    var win_size = UPDATE_WIN_SIZE
    if off >= 0
        win_offset = anchor_offset(l.interval, interval, instant, ref, off)
        if interval - win_offset < UPDATE_WIN_SIZE
            win_size = 1
    ll_data.ctrl_connection_update(var l.tmp, win_size, win_offset, interval, latency, timeout, instant)
    if not ctrl_queue(var l, var l.tmp)
        return STATUS_COMMAND_DISALLOWED
    if l.proc == PROC_PARAM
        l.proc = PROC_NONE
    l.upd_pending = true
    l.upd_instant = instant
    l.upd_win_size = win_size
    l.upd_win_offset = win_offset
    l.upd_interval = interval
    l.upd_latency = latency
    l.upd_timeout = timeout
    l.upd_host = host
    link_prepare(var l)
    STATUS_SUCCESS

// The Central's Connection Parameters Request ended without an update (the peer lacks the
// procedure, or refused it as a legacy Host does): the Central updates with
// LL_CONNECTION_UPDATE_IND to the longest interval of the Host's range, which `cpr_*` kept
// (Section 5.1.7.1).  A link that cannot take the PDU tells the Host so.
@satisfies("REQ-BLE-CTL-067")
@tier(embedded)
fn central_fallback(var l: Link)
    l.proc = PROC_NONE
    let s = central_update(var l, pick_interval(l.cpr_min, l.cpr_max, 0), l.cpr_latency, l.cpr_timeout, true, 0, -1)
    if s != STATUS_SUCCESS
        l.upd_status = s
        l.owed = l.owed | EV_UPDATED

// The peer's request is acceptable: the Central answers with the update, the
// Peripheral with LL_CONNECTION_PARAM_RSP of the same values (Section 5.1.7.2).  `ref` and
// `off` are the reference event and the first valid offset of the request, `off` -1 for
// none.
@satisfies("REQ-BLE-CTL-027")
@tier(embedded)
fn param_accept(var l: Link, i_min: Int, i_max: Int, latency: Int, timeout: Int, period: Int, ref: Int, off: Int)
    if l.central
        let _s = central_update(var l, pick_interval(i_min, i_max, period), latency, timeout, false, ref, off)
    else
        ll_data.ctrl_param(var l.tmp, ll_data.OP_CONNECTION_PARAM_RSP, i_min, i_max, latency, timeout, period, l.ev_count)
        send_tmp(var l)

// LL_CONNECTION_PARAM_REQ, or the Peripheral's LL_CONNECTION_PARAM_RSP at the Central
// (Section 5.1.7.2).  The RSP that answers the Central's own request is the end of that
// procedure: the Central updates with LL_CONNECTION_UPDATE_IND (`central_answer`).  A
// Central with an update, a channel map or a request of its own in progress refuses a
// request with a collision code (Section 5.3), values out of range are refused, a request
// that moves the anchor points alone is taken without asking the Host (Section 5.1.7.2), a
// request inside the range the Host gave is taken, and any other is the Host's to answer
// when it has the event enabled.  Without the event the Central refuses and the Peripheral
// takes it.
@satisfies("REQ-BLE-CTL-027")
@satisfies("REQ-BLE-CTL-029")
@satisfies("REQ-BLE-CTL-068")
@tier(embedded)
fn ctrl_param_received(var l: Link, var rx: Pdu)
    let op = ll_data.dpdu_opcode(var rx)
    if not l.central and op == ll_data.OP_CONNECTION_PARAM_RSP
        answer_unknown(var l, op)
        return
    var i_min = ll_data.dpdu_u16(var rx, 1)
    var i_max = ll_data.dpdu_u16(var rx, 3)
    let latency = ll_data.dpdu_u16(var rx, 5)
    let timeout = ll_data.dpdu_u16(var rx, 7)
    let period = ll_data.dpdu_byte(var rx, 9)
    let ref = ll_data.dpdu_u16(var rx, 10)
    let off = first_offset(var rx)
    if l.central and op == ll_data.OP_CONNECTION_PARAM_RSP and l.proc == PROC_PARAM
        central_answer(var l, i_min, i_max, latency, timeout, period, ref, off)
        return
    if l.central and (l.upd_pending or l.proc == PROC_PARAM)
        send_reject(var l, op, CODE_COLLISION)
        return
    if l.central and (l.chm_pending or l.phy_pending or l.phy_state != PHY_IDLE)
        send_reject(var l, op, CODE_DIFFERENT_COLLISION)
        return
    if not params_valid(i_min, i_max, latency, timeout)
        send_reject(var l, op, CODE_INVALID_LL_PARAMETERS)
        return
    if l.rq_wait
        send_reject(var l, op, CODE_BUSY)
        return
    let anchors_only = i_min == i_max and i_min == l.interval and latency == l.latency and timeout == l.timeout
    if anchors_only
        param_accept(var l, i_min, i_max, latency, timeout, period, ref, off)
    else if l.central and l.h_set and i_min <= l.h_max and i_max >= l.h_min and latency <= l.h_latency and timeout == l.h_timeout
        if i_min < l.h_min
            i_min = l.h_min
        if i_max > l.h_max
            i_max = l.h_max
        param_accept(var l, i_min, i_max, latency, timeout, period, ref, off)
    else if l.ind_ok
        l.rq_wait = true
        l.rq_op = op
        l.rq_min = i_min
        l.rq_max = i_max
        l.rq_latency = latency
        l.rq_timeout = timeout
        l.rq_period = period
        l.rq_ref = ref
        l.rq_off = off
        l.owed = l.owed | EV_PARAM_REQUEST
    else if l.central
        send_reject(var l, op, STATUS_UNSUPPORTED_REMOTE)
    else
        param_accept(var l, i_min, i_max, latency, timeout, period, ref, off)

// The Peripheral's LL_CONNECTION_PARAM_RSP to the Central's request (Section 5.1.7.2): the
// Central answers with LL_CONNECTION_UPDATE_IND, at an interval it picks from the range of
// the RSP (a multiple of the preferred periodicity when there is one) and an anchor offset
// from the RSP's offsets.  Values out of range, or a procedure with an instant that
// started meanwhile, end the procedure with LL_REJECT_EXT_IND and the Host is told the code.
@satisfies("REQ-BLE-CTL-067")
@tier(embedded)
fn central_answer(var l: Link, i_min: Int, i_max: Int, latency: Int, timeout: Int, period: Int, ref: Int, off: Int)
    if not params_valid(i_min, i_max, latency, timeout)
        send_reject(var l, ll_data.OP_CONNECTION_PARAM_RSP, CODE_INVALID_LL_PARAMETERS)
        param_failed(var l, CODE_INVALID_LL_PARAMETERS)
        return
    if instant_busy(var l)
        send_reject(var l, ll_data.OP_CONNECTION_PARAM_RSP, CODE_DIFFERENT_COLLISION)
        param_failed(var l, CODE_DIFFERENT_COLLISION)
        return
    let s = central_update(var l, pick_interval(i_min, i_max, period), latency, timeout, true, ref, off)
    if s != STATUS_SUCCESS
        param_failed(var l, s)

// LL_MIN_USED_CHANNELS_IND (Section 5.1.11): only a Peripheral sends it.  The
// count it asks of the LE 1M PHY is kept, and `central_map_try` keeps the map at
// or above it.
@satisfies("REQ-BLE-CTL-026")
@tier(embedded)
fn ctrl_min_used_received(var l: Link, var rx: Pdu)
    if not l.central
        answer_unknown(var l, ll_data.OP_MIN_USED_CHANNELS_IND)
        return
    let n = ll_data.dpdu_byte(var rx, 2)
    if (ll_data.dpdu_byte(var rx, 1) & 1) != 0 and n >= 2 and n <= 37
        l.min_used = n

// The map with the lowest unused channels added until it has `n` channels.
@tier(embedded)
fn pad_map(map: Int, n: Int) -> Int
    var m = map
    var count = popcount(m)
    for ch in 0..37
        if count < n and ((m >>> ch) & 1) == 0
            m = m | (1 << ch)
            count = count + 1
    m

// The map the Central should be using: the Host's classification, with channels
// added up to the peer's minimum and to the two every map has.
@tier(embedded)
fn wanted_map(var l: Link) -> Int
    var n = l.min_used
    if n < 2
        n = 2
    pad_map(l.host_map, n)

// The Central sends LL_CHANNEL_MAP_IND for `map`, the instant its own
// (Section 5.1.2), and applies it at the instant too.
@satisfies("REQ-BLE-CTL-026")
@tier(embedded)
fn central_map(var l: Link, map: Int) -> Bool
    let instant = instant_next(var l)
    ll_data.ctrl_channel_map(var l.tmp, map, instant)
    if not ctrl_queue(var l, var l.tmp)
        return false
    l.chm_pending = true
    l.chm_instant = instant
    l.chm_map = map
    link_prepare(var l)
    true

// A Central whose map differs from the one it wants sends it, unless a procedure
// with an instant is in progress (Section 5.3); the next event tries again.
@tier(embedded)
fn central_map_try(var l: Link)
    if not instant_busy(var l) and not l.rq_wait and l.proc != PROC_PARAM
        let want = wanted_map(var l)
        if want != l.chmap
            let _sent = central_map(var l, want)

// The Host classified the data channels: the Central moves to the map that
// follows from it.
@satisfies("REQ-BLE-CTL-026")
@tier(embedded)
fn link_set_host_map(var l: Link, map: Int)
    l.host_map = map

// Whether the Host has the event for a request of the peer enabled, which
// decides whether a request outside the Host's range is passed to it.
@tier(embedded)
fn link_set_indicate(var l: Link, on: Bool)
    l.ind_ok = on

// A Peripheral asks the Central for at least `n` channels on the LE 1M PHY
// (Section 5.1.11).  Success, Command Disallowed for a Central or a full queue.
@satisfies("REQ-BLE-CTL-026")
@tier(embedded)
fn link_request_min_used(var l: Link, n: Int) -> Int
    if not l.live or l.closing or l.central or n < 2 or n > 37
        return STATUS_COMMAND_DISALLOWED
    ll_data.ctrl_min_used(var l.tmp, 1, n)
    if not ctrl_queue(var l, var l.tmp)
        return STATUS_COMMAND_DISALLOWED
    link_prepare(var l)
    STATUS_SUCCESS

// ── LE Ping and the authenticated payload timeout, Sections 5.1.8 and 5.4 ──

// The timeout in microseconds.
@tier(embedded)
fn apto_us(var l: Link) -> Int
    l.apto * TIMEOUT_UNIT_US

// Start or stop the authenticated payload timer: it runs while the connection is
// encrypted, from `now`.
@satisfies("REQ-BLE-CTL-028")
@tier(embedded)
fn link_set_auth(var l: Link, on: Bool, now: Int)
    l.auth_on = on
    l.auth_t0 = now
    l.pinged = false

// A packet with a valid MIC arrived at `now`, which restarts the timer.
@satisfies("REQ-BLE-CTL-028")
@tier(embedded)
fn link_auth_rx(var l: Link, now: Int)
    l.auth_t0 = now
    l.pinged = false

// The timer, read at the end of an event: the Host is told when the timeout is
// reached and the timer restarts; before that LL_PING_REQ goes to the peer, early
// enough for it to answer, once no other procedure waits.
@satisfies("REQ-BLE-CTL-028")
@tier(embedded)
fn apto_tasks(var l: Link)
    let elapsed = l.now - l.auth_t0
    if elapsed >= apto_us(var l)
        l.owed = l.owed | EV_APTO
        l.auth_t0 = l.now
        l.pinged = false
        return
    var lead = 4 * (1 + l.latency) * interval_us(l)
    if lead > apto_us(var l) / 2
        lead = apto_us(var l) / 2
    if elapsed >= apto_us(var l) - lead and l.proc == PROC_NONE and l.ping_ok and not l.pinged
        ll_data.ctrl_ping_req(var l.tmp)
        if ctrl_queue(var l, var l.tmp)
            l.pinged = true
            l.proc = PROC_PING
            l.proc_t0 = l.now
            link_prepare(var l)

// The work after an event that no packet drives.
@tier(embedded)
fn link_tasks(var l: Link)
    if l.central
        central_map_try(var l)
    if l.auth_on
        apto_tasks(var l)
    auto_tasks(var l)

// ── The data length, [Vol 6] Part B, Sections 4.5.10 and 5.1.9 ───────
//
// Each end tells the other the longest PDU it sends and receives, in octets and in
// microseconds (LL_LENGTH_REQ and LL_LENGTH_RSP), and each sends no PDU longer than
// the lesser of its own limit and what the other can receive.  The effective values
// are those of the specification: connEffectiveMaxTxOctets and connEffectiveMaxRxOctets
// (the lesser of the local and the remote limit), and the two times, which on the LE
// Coded PHY are never below 2704 microseconds and are cut by the time the connection
// interval leaves after the packets of the other direction.  A packet that would take longer
// than the time on the PHY in force, or on the one about to be, is not sent: a packet of
// the Host's longer than the limit goes out in pieces (`take_acl`).

// connEffectiveMaxRxOctets and connEffectiveMaxTxOctets: the lesser of the local and the
// remote limit.
@tier(embedded)
fn eff_rx_octets(var l: Link) -> Int
    ll_phy.lesser(l.dl_rx_octets, l.dl_rem_tx_octets)

@tier(embedded)
fn eff_tx_octets(var l: Link) -> Int
    ll_phy.lesser(l.dl_tx_octets, l.dl_rem_rx_octets)

// connEffectiveMaxRxTime on `phy`: the lesser of the local receive time and the
// remote transmit time, and on the LE Coded PHY not below 2704 microseconds.
@tier(embedded)
fn eff_rx_time(var l: Link, phy: Int) -> Int
    let u = ll_phy.lesser(l.dl_rx_time, l.dl_rem_tx_time)
    if phy == ll_phy.PHY_CODED
        return ll_phy.greater(ll_phy.TIME_CODED_MIN, u)
    u

// connEffectiveMaxTxTime on `phy`: the lesser of the local transmit time and the
// remote receive time; on the LE Coded PHY the greater of 2704 microseconds and the
// lesser of that and the time the interval leaves after T_IFS_ACL_CP, T_MCES and the
// longest packet of the other direction (connEffectiveMaxTxTimeAvailable).
@tier(embedded)
fn eff_tx_time(var l: Link, phy: Int) -> Int
    let u = ll_phy.lesser(l.dl_tx_time, l.dl_rem_rx_time)
    if phy != ll_phy.PHY_CODED
        return u
    let required = 2 * T_IFS_US + ll_phy.lesser(eff_rx_time(var l, phy), eff_rx_octets(var l) * 64 + 976)
    ll_phy.greater(ll_phy.TIME_CODED_MIN, ll_phy.lesser(u, interval_us(l) - required))

// The most payload octets a PDU sent on `phy` may carry, by time alone.
@tier(embedded)
fn tx_limit_on(var l: Link, phy: Int) -> Int
    ll_phy.fit_octets(phy, l.phy_opt != ll_phy.OPT_S2, eff_tx_time(var l, phy))

// The most payload octets of a PDU about to be queued: connEffectiveMaxTxOctets, cut by
// the time on the PHY in force, on the one that applies after a pending instant, and on every
// PHY a request or answer of this end offers while the PHY Update procedure runs
// (Section 5.1.10.1).  Never below the 27 octets every connection has.
@satisfies("REQ-BLE-CTL-040")
@tier(embedded)
fn tx_limit(var l: Link) -> Int
    var lim = ll_phy.lesser(eff_tx_octets(var l), tx_limit_on(var l, l.phy))
    if l.phy_pending
        lim = ll_phy.lesser(lim, tx_limit_on(var l, l.phy_new))
    if l.phy_state != PHY_IDLE
        for ph in 1..4
            if (l.phy_off & ll_phy.mask_of(ph)) != 0
                lim = ll_phy.lesser(lim, tx_limit_on(var l, ph))
    ll_phy.greater(ll_phy.PAYLOAD_MIN, lim)

// Read the effective values again.  The Host is owed LE Data Length Change when one of the
// four differs from what it was told last.
@satisfies("REQ-BLE-CTL-040")
@tier(embedded)
fn dle_refresh(var l: Link)
    let a = eff_tx_octets(var l)
    let b = eff_tx_time(var l, l.phy)
    let c = eff_rx_octets(var l)
    let d = eff_rx_time(var l, l.phy)
    if a != l.dl_ev_tx_octets or b != l.dl_ev_tx_time or c != l.dl_ev_rx_octets or d != l.dl_ev_rx_time
        l.dl_ev_tx_octets = a
        l.dl_ev_tx_time = b
        l.dl_ev_rx_octets = c
        l.dl_ev_rx_time = d
        l.owed = l.owed | EV_DATA_LENGTH

// The time to put in LL_LENGTH_REQ or LL_LENGTH_RSP: a peer that is not known to have the LE
// Coded PHY is told 2128 microseconds at most (Section 5.1.9).
@tier(embedded)
fn dle_wire_time(var l: Link, t: Int) -> Int
    if l.have_feat and ((l.peer_feat[1] as Int) & FEAT1_CODED) != 0
        return t
    ll_phy.lesser(t, DLE_TIME_UNCODED_PEER)

// Queue LL_LENGTH_REQ (`rsp` false) or LL_LENGTH_RSP with this end's four values.  False
// when the queue is full.
@tier(embedded)
fn dle_queue(var l: Link, rsp: Bool) -> Bool
    var op = ll_data.OP_LENGTH_REQ
    if rsp
        op = ll_data.OP_LENGTH_RSP
    ll_data.ctrl_length(var l.tmp, op, l.dl_rx_octets, dle_wire_time(var l, l.dl_rx_time), l.dl_tx_octets, dle_wire_time(var l, l.dl_tx_time))
    ctrl_queue(var l, var l.tmp)

// Start the Data Length Update procedure: LL_LENGTH_REQ goes to the peer unless one is
// out already, in which case another follows its answer (the values changed under it).
// A peer known to lack the feature, or that answered with LL_UNKNOWN_RSP, is not asked.
@satisfies("REQ-BLE-CTL-040")
@tier(embedded)
fn dle_start(var l: Link)
    if l.dl_unsup or (l.have_feat and ((l.peer_feat[0] as Int) & FEAT0_DLE) == 0)
        l.dl_unsup = true
        return
    if l.dl_wait
        l.dl_resend = true
        return
    if dle_queue(var l, false)
        l.dl_wait = true
        l.dl_t0 = l.now
        link_prepare(var l)

// Whether the values of a PDU are ones the data length parameters may have (Table 4.8).
@tier(embedded)
fn dle_values_ok(rx_oct: Int, rx_time: Int, tx_oct: Int, tx_time: Int) -> Bool
    rx_oct >= ll_phy.PAYLOAD_MIN and rx_oct <= ll_phy.PAYLOAD_MAX
        and tx_oct >= ll_phy.PAYLOAD_MIN and tx_oct <= ll_phy.PAYLOAD_MAX
        and rx_time >= ll_phy.TIME_MIN and rx_time <= ll_phy.TIME_MAX
        and tx_time >= ll_phy.TIME_MIN and tx_time <= ll_phy.TIME_MAX

// The remote values from LL_LENGTH_REQ or LL_LENGTH_RSP: the peer's MaxRxOctets and MaxRxTime
// are what it can receive, its MaxTxOctets and MaxTxTime what it will send.
@tier(embedded)
fn dle_take(var l: Link, var rx: Pdu)
    l.dl_rem_rx_octets = ll_data.dpdu_u16(var rx, 1)
    l.dl_rem_rx_time = ll_data.dpdu_u16(var rx, 3)
    l.dl_rem_tx_octets = ll_data.dpdu_u16(var rx, 5)
    l.dl_rem_tx_time = ll_data.dpdu_u16(var rx, 7)
    dle_refresh(var l)

// LL_LENGTH_REQ: the peer's values are kept and this end's go back in LL_LENGTH_RSP.  Values out of
// range are refused with Invalid LL Parameters.  The answer is sent while a request of this
// end is out, too (Section 5.1.9): the two cross harmlessly.
@satisfies("REQ-BLE-CTL-040")
@tier(embedded)
fn ctrl_length_request(var l: Link, var rx: Pdu)
    if not dle_values_ok(ll_data.dpdu_u16(var rx, 1), ll_data.dpdu_u16(var rx, 3), ll_data.dpdu_u16(var rx, 5), ll_data.dpdu_u16(var rx, 7))
        send_reject(var l, ll_data.OP_LENGTH_REQ, CODE_INVALID_LL_PARAMETERS)
        return
    dle_take(var l, var rx)
    let _q = dle_queue(var l, true)

// LL_LENGTH_RSP: the answer to the request this end sent ends the procedure; another request
// follows when the values changed meanwhile.  A response nothing asked for is ignored.
@satisfies("REQ-BLE-CTL-040")
@tier(embedded)
fn ctrl_length_response(var l: Link, var rx: Pdu)
    if not l.dl_wait
        return
    if dle_values_ok(ll_data.dpdu_u16(var rx, 1), ll_data.dpdu_u16(var rx, 3), ll_data.dpdu_u16(var rx, 5), ll_data.dpdu_u16(var rx, 7))
        dle_take(var l, var rx)
    l.dl_wait = false
    if l.dl_resend
        l.dl_resend = false
        dle_start(var l)

// The refusal of LL_LENGTH_REQ, by LL_UNKNOWN_RSP (`unknown`) or LL_REJECT_EXT_IND, ends the
// procedure: the peer keeps its 27 octets.
@tier(embedded)
fn dle_refused(var l: Link, unknown: Bool)
    l.dl_wait = false
    l.dl_resend = false
    if unknown
        l.dl_unsup = true

// The Host's defaults for a connection that has just begun: the transmit octets and time to
// start from when it wrote them (`dl_set`), and the PHYs it prefers as masks, `pref_set` false
// for none.
@satisfies("REQ-BLE-CTL-041")
@satisfies("REQ-BLE-CTL-043")
@tier(embedded)
fn link_set_defaults(var l: Link, dl_set: Bool, tx_octets: Int, tx_time: Int, pref_set: Bool, pref_tx: Int, pref_rx: Int)
    if dl_set
        l.dl_tx_octets = tx_octets
        l.dl_tx_time = tx_time
    l.phy_pref_set = pref_set
    l.phy_pref_tx = pref_tx
    l.phy_pref_rx = pref_rx
    l.dl_started = false
    l.phy_auto = false
    dle_refresh(var l)

// HCI LE Set Data Length ([Vol 4] Part E, Section 7.8.33): the Host's preferred octets and time of
// a transmitted PDU become connMaxTxOctets and connMaxTxTime, and the peer is told.  Success,
// Unknown Connection Identifier, or Invalid HCI Command Parameters for values out of range.
@satisfies("REQ-BLE-CTL-041")
@tier(embedded)
fn link_set_data_length(var l: Link, tx_octets: Int, tx_time: Int) -> Int
    if not l.live or l.closing
        return STATUS_UNKNOWN_CONNECTION
    if tx_octets < ll_phy.PAYLOAD_MIN or tx_octets > ll_phy.PAYLOAD_MAX or tx_time < ll_phy.TIME_MIN or tx_time > ll_phy.TIME_MAX
        return STATUS_INVALID_PARAMETERS
    if tx_octets != l.dl_tx_octets or tx_time != l.dl_tx_time
        l.dl_tx_octets = tx_octets
        l.dl_tx_time = tx_time
        dle_start(var l)
        dle_refresh(var l)
    STATUS_SUCCESS

// ── The PHY Update procedure, [Vol 6] Part B, Section 5.1.10 ─────────
//
// A PHY is changed for both directions together: a Controller may leave asymmetric
// connections out (Section 4.6.9.1), and this one does, since its radio keeps the
// interframe space in hardware and cannot change its mode inside it.  So this end offers
// a single PHY in LL_PHY_REQ and in LL_PHY_RSP (the same in both fields), and the
// Central picks the same PHY for both directions or none.  The Central sends
// LL_PHY_UPDATE_IND with an instant; both ends change at it.  A Peripheral that is sent an
// LL_PHY_UPDATE_IND for two different PHYs ends the connection (Unsupported LL
// Parameter Value, 0x20), the only answer a link that cannot follow has.

const REASON_UNSUPPORTED_PARAMETER = 0x20

// The PHY of a mask to ask for, the fastest first: LE 2M, then LE 1M, then LE Coded;
// 0 for a mask with none of them.
@satisfies("REQ-BLE-CTL-042")
@tier(embedded)
fn phy_best(mask: Int) -> Int
    if (mask & ll_phy.MASK_2M) != 0
        return ll_phy.PHY_2M
    if (mask & ll_phy.MASK_1M) != 0
        return ll_phy.PHY_1M
    if (mask & ll_phy.MASK_CODED) != 0
        return ll_phy.PHY_CODED
    0

// The PHYs the Host would have, in both directions.
@tier(embedded)
fn phy_wanted(var l: Link) -> Int
    l.phy_pref_tx & l.phy_pref_rx & PHYS_SUPPORTED

// Whether a PHY Update of this end is under way: the request is out, or the answer is, or the change
// waits for its instant.  A request that has not gone out (`PHY_DEFERRED`) is not.
@tier(embedded)
fn phy_busy(var l: Link) -> Bool
    l.phy_pending or l.phy_state == PHY_WAIT_RSP or l.phy_state == PHY_WAIT_IND or l.phy_state == PHY_RESPONDED

// Whether a request for a PHY waits: this end's own LL_LENGTH_REQ is not answered, or an encryption
// procedure is under way or about to begin.
@tier(embedded)
fn phy_hold(var l: Link) -> Bool
    l.dl_wait or l.enc_ph != ENC_IDLE or l.enc_wait

// Whether the peer's feature set, when this end has it, shows `phy` is one it has.
@tier(embedded)
fn peer_has_phy(var l: Link, phy: Int) -> Bool
    if not l.have_feat or phy == ll_phy.PHY_1M
        return true
    if phy == ll_phy.PHY_2M
        return ((l.peer_feat[1] as Int) & FEAT1_2M) != 0
    ((l.peer_feat[1] as Int) & FEAT1_CODED) != 0

// The procedure is over: the event is owed with `status` when the Host asked.
@tier(embedded)
fn phy_done(var l: Link, status: Int)
    l.phy_state = PHY_IDLE
    l.phy_off = 0
    if l.phy_host
        l.phy_host = false
        l.phy_status = status
        l.owed = l.owed | EV_PHY

// Begin the PHY Update procedure, for the Host (`host`) or on this end's own account: the
// fastest PHY the Host would have goes out in LL_PHY_REQ, once, when the peer has it.
// The PHY already in force needs no request; the Host then hears the result at once.  Command
// Disallowed while a PHY Update is under way.
@satisfies("REQ-BLE-CTL-042")
@tier(embedded)
fn phy_begin(var l: Link, host: Bool) -> Int
    if l.phy_state != PHY_IDLE or l.phy_pending
        return STATUS_COMMAND_DISALLOWED
    let x = phy_best(phy_wanted(var l))
    if x == l.phy or x == 0
        if host
            l.phy_status = STATUS_SUCCESS
            l.owed = l.owed | EV_PHY
        return STATUS_SUCCESS
    if not peer_has_phy(var l, x) or l.phy_unsup
        if host
            l.phy_status = STATUS_UNSUPPORTED_REMOTE
            l.owed = l.owed | EV_PHY
        return STATUS_SUCCESS
    if phy_hold(var l)
        l.phy_state = PHY_DEFERRED
        l.phy_host = host
        return STATUS_SUCCESS
    phy_send(var l, x, host)

// Queue LL_PHY_REQ for `x` and wait for the answer.
@satisfies("REQ-BLE-CTL-042")
@tier(embedded)
fn phy_send(var l: Link, x: Int, host: Bool) -> Int
    ll_data.ctrl_phy(var l.tmp, ll_data.OP_PHY_REQ, ll_phy.mask_of(x), ll_phy.mask_of(x))
    if not ctrl_queue(var l, var l.tmp)
        l.phy_state = PHY_IDLE
        return STATUS_COMMAND_DISALLOWED
    l.phy_off = ll_phy.mask_of(x)
    l.phy_host = host
    l.phy_t0 = l.now
    if l.central
        l.phy_state = PHY_WAIT_RSP
    else
        l.phy_state = PHY_WAIT_IND
    link_prepare(var l)
    STATUS_SUCCESS

// The request that waited for the data length procedure goes out now, if the PHY still has to change.
@tier(embedded)
fn phy_resume(var l: Link)
    let x = phy_best(phy_wanted(var l))
    if x == l.phy or x == 0
        phy_done(var l, STATUS_SUCCESS)
    else
        let _s = phy_send(var l, x, l.phy_host)

// HCI LE Set PHY ([Vol 4] Part E, Section 7.8.49).  `all_phys` bit 0 and bit 1 say the Host has no
// preference for the transmitter and the receiver; otherwise `tx` and `rx` are the PHYs it
// prefers.  Unsupported Feature or Parameter Value for a bit that is no PHY of this Controller
// or two different sets (an asymmetric connection); Unknown Connection Identifier; Command
// Disallowed while a PHY Update is under way.  The Host hears the result in LE PHY Update
// Complete.
@satisfies("REQ-BLE-CTL-043")
@tier(embedded)
fn link_set_phy(var l: Link, all_phys: Int, tx: Int, rx: Int, opts: Int) -> Int
    if not l.live or l.closing
        return STATUS_UNKNOWN_CONNECTION
    var t = tx
    var r = rx
    if (all_phys & 1) != 0
        t = PHYS_SUPPORTED
    if (all_phys & 2) != 0
        r = PHYS_SUPPORTED
    if t == 0 or r == 0
        return STATUS_INVALID_PARAMETERS
    if (t & (0xFF ^ PHYS_SUPPORTED)) != 0 or (r & (0xFF ^ PHYS_SUPPORTED)) != 0
        return STATUS_UNSUPPORTED_FEATURE
    if (all_phys == 0 and t != r) or (t & r) == 0
        return STATUS_UNSUPPORTED_FEATURE
    if l.phy_state != PHY_IDLE or l.phy_pending
        return STATUS_COMMAND_DISALLOWED
    l.phy_pref_tx = t
    l.phy_pref_rx = r
    l.phy_pref_set = true
    l.phy_opt = opts & 3
    phy_begin(var l, true)

// LL_PHY_REQ at the Central: the Peripheral asks for PHYs.  The Central takes the fastest PHY
// that the request names for both directions and that the Host would have, and sends
// LL_PHY_UPDATE_IND with an instant, or one with no change.  A request that collides with a
// procedure of this end is refused (Section 5.3).
@satisfies("REQ-BLE-CTL-042")
@tier(embedded)
fn central_phy_request(var l: Link, var rx: Pdu)
    if l.phy_state != PHY_IDLE or l.phy_pending
        send_reject(var l, ll_data.OP_PHY_REQ, CODE_COLLISION)
        return
    if l.upd_pending or l.chm_pending or l.rq_wait or l.proc == PROC_PARAM
        send_reject(var l, ll_data.OP_PHY_REQ, CODE_DIFFERENT_COLLISION)
        return
    let both = ll_data.dpdu_byte(var rx, 1) & ll_data.dpdu_byte(var rx, 2) & phy_wanted(var l)
    phy_decide(var l, phy_best(both))

// The Central has chosen `x`, 0 for none: LL_PHY_UPDATE_IND with the instant when it differs
// from the PHY in force, and one that changes nothing otherwise.
@satisfies("REQ-BLE-CTL-042")
@tier(embedded)
fn phy_decide(var l: Link, x: Int)
    if x == 0 or x == l.phy
        ll_data.ctrl_phy_update(var l.tmp, 0, 0, 0)
        let _q = ctrl_queue(var l, var l.tmp)
        phy_done(var l, STATUS_SUCCESS)
        link_prepare(var l)
        return
    let instant = instant_next(var l)
    ll_data.ctrl_phy_update(var l.tmp, ll_phy.mask_of(x), ll_phy.mask_of(x), instant)
    if ctrl_queue(var l, var l.tmp)
        l.phy_pending = true
        l.phy_instant = instant
        l.phy_new = x
        l.phy_state = PHY_IDLE
        l.phy_off = 0
    else
        phy_done(var l, STATUS_COMMAND_DISALLOWED)
    link_prepare(var l)

// LL_PHY_REQ at the Peripheral: the Central starts the procedure.  The answer is
// LL_PHY_RSP with the single PHY this end would use out of those the request names for both
// directions and the Host would have, or the PHY in force when there is none; the
// Central's procedure wins over a request of this end that is out.
@satisfies("REQ-BLE-CTL-042")
@tier(embedded)
fn peripheral_phy_request(var l: Link, var rx: Pdu)
    if l.phy_pending
        send_reject(var l, ll_data.OP_PHY_REQ, CODE_COLLISION)
        return
    var x = phy_best(ll_data.dpdu_byte(var rx, 1) & ll_data.dpdu_byte(var rx, 2) & phy_wanted(var l))
    if x == 0
        x = l.phy
    ll_data.ctrl_phy(var l.tmp, ll_data.OP_PHY_RSP, ll_phy.mask_of(x), ll_phy.mask_of(x))
    send_tmp(var l)
    l.phy_off = ll_phy.mask_of(x)
    l.phy_state = PHY_RESPONDED
    l.phy_t0 = l.now

// LL_PHY_RSP at the Central that asked: the PHY it offered is used when the Peripheral takes
// it in both directions, otherwise nothing changes.  A response nothing asked for is ignored.
@satisfies("REQ-BLE-CTL-042")
@tier(embedded)
fn central_phy_response(var l: Link, var rx: Pdu)
    if l.phy_state != PHY_WAIT_RSP
        return
    let offered = l.phy_off
    let tx_ok = (ll_data.dpdu_byte(var rx, 1) & offered) != 0
    let rx_ok = (ll_data.dpdu_byte(var rx, 2) & offered) != 0
    if tx_ok and rx_ok
        phy_decide(var l, ll_phy.phy_of_mask(offered))
    else
        phy_decide(var l, 0)

// LL_PHY_UPDATE_IND at the Peripheral.  Neither field set: the procedure is over and nothing
// changes.  Otherwise the PHYs after the instant: one for both directions is taken, two
// that differ end the connection; an instant in the past ends it with Instant Passed.  A
// field that names no PHY of this Controller changes nothing in its direction.
@satisfies("REQ-BLE-CTL-042")
@tier(embedded)
fn peripheral_phy_update(var l: Link, var rx: Pdu)
    let c2p = ll_data.dpdu_byte(var rx, 1)
    let p2c = ll_data.dpdu_byte(var rx, 2)
    let instant = ll_data.dpdu_u16(var rx, 3)
    if c2p == 0 and p2c == 0
        phy_done(var l, STATUS_SUCCESS)
        return
    var rx_phy = l.phy
    var tx_phy = l.phy
    if ll_phy.phy_of_mask(c2p & PHYS_SUPPORTED) != 0
        rx_phy = ll_phy.phy_of_mask(c2p & PHYS_SUPPORTED)
    if ll_phy.phy_of_mask(p2c & PHYS_SUPPORTED) != 0
        tx_phy = ll_phy.phy_of_mask(p2c & PHYS_SUPPORTED)
    if rx_phy != tx_phy
        link_close(var l, REASON_UNSUPPORTED_PARAMETER)
        return
    if instant_passed(var l, instant)
        link_close(var l, REASON_INSTANT_PASSED)
        return
    if rx_phy == l.phy
        phy_done(var l, STATUS_SUCCESS)
        return
    l.phy_pending = true
    l.phy_instant = instant
    l.phy_new = rx_phy
    l.phy_state = PHY_IDLE
    l.phy_off = 0

// The instant of the PHY change has come: both directions use the new PHY from this event, the
// Host is told, and the effective data length is read again.
@satisfies("REQ-BLE-CTL-042")
@tier(embedded)
fn phy_apply(var l: Link)
    l.phy = l.phy_new
    l.phy_pending = false
    l.phy_instant = 0
    l.phy_host = false
    l.phy_status = STATUS_SUCCESS
    l.owed = l.owed | EV_PHY
    dle_refresh(var l)

// The peer refuses the PHY Update with LL_UNKNOWN_RSP (`unknown`, it lacks the procedure) or with
// the reject `code`; the Host that asked hears of it.
@tier(embedded)
fn phy_refused(var l: Link, unknown: Bool, code: Int)
    if unknown
        l.phy_unsup = true
        phy_done(var l, STATUS_UNSUPPORTED_REMOTE)
    else
        phy_done(var l, code)

// LL_REJECT_IND or LL_REJECT_EXT_IND with `code` while the PHY Update of this end waits for the
// peer.  A Peripheral that answered the Central's request takes no notice: the reject is
// the Central's answer to a request of the Peripheral's that the Central's own crossed.
@tier(embedded)
fn phy_rejected(var l: Link, code: Int)
    if l.phy_state == PHY_WAIT_RSP or l.phy_state == PHY_WAIT_IND
        phy_refused(var l, false, code)

// The work after an event that no packet drives, for the procedures a connection starts
// by itself: LL_LENGTH_REQ once, as soon as the peer has been heard, and a PHY Update
// when the Host's defaults name a PHY other than the one in force.
@tier(embedded)
fn auto_tasks(var l: Link)
    if not l.synced or l.cq_count > CTRL_SLOTS - 2
        return
    if l.enc_wait and not phy_busy(var l)
        // The PHY Update is over: the Encryption Start or Pause the Host asked for goes now, or at the next work
        // when the queue has no room.
        if enc_begin(var l) == STATUS_SUCCESS
            l.enc_wait = false
    if l.phy_state == PHY_DEFERRED and not phy_hold(var l)
        phy_resume(var l)
    if not l.dl_started
        l.dl_started = true
        dle_start(var l)
    else if not l.phy_auto and l.phy_pref_set and l.ev_count >= AUTO_PHY_EVENTS and not phy_hold(var l) and (not l.central or not instant_busy(var l))
        l.phy_auto = true
        let _s = phy_begin(var l, false)

// ── Encryption, [Vol 6] Part B, Section 5.1.3 ────────────────────────
//
// The Encryption Start and Encryption Pause procedures, and the sealing and
// opening of the Data Physical Channel PDUs once a session key is in force.
// The Link Layer never runs an AES block itself: the program that owns the
// radio asks a `Cipher` (`ll_cipher.nv`) to seal the PDUs it sends and to open
// the ones it receives, and `link_secure_poll` runs the work of the procedure
// that needs the cipher or a random number.
//
// The procedure.  The Central's Host gives LE Start Encryption
// (`link_start_encryption`); the Central draws SKD_C and IV_C and sends
// LL_ENC_REQ; the Peripheral draws SKD_P and IV_P, answers LL_ENC_RSP and tells
// its Host with LE Long Term Key Request.  The Host's reply gives the key; both
// ends derive SK = AES(LTK, SKD).  The Peripheral sends LL_START_ENC_REQ in the
// clear and expects encrypted PDUs from then on; the Central answers
// LL_START_ENC_RSP encrypted and the Peripheral does too, and the Hosts hear
// Encryption Change.  A link already encrypted is paused first (LL_PAUSE_ENC_REQ
// and LL_PAUSE_ENC_RSP both ways) and started again with a new key; the Hosts
// then hear Encryption Key Refresh Complete.
//
// `enc_ph` is the phase, `enc_tx` and `enc_rx` say the PDUs this end sends and
// receives are encrypted, `tx_ctr` and `rx_ctr` are the packetCounters of the two
// directions, and `ek` the session key and the IV.  While a procedure runs only
// LL Control PDUs go out (Section 5.1.3.1), and an LL Data PDU from the peer ends
// the connection with MIC Failure (0x3D).
//
// The packetCounter counts new encrypted PDUs with a payload.  The PDU in flight
// (`cur`) is sealed with `tx_ctr` and the one behind it (`nxt`) with the next
// number when `cur` has a payload; `promote` counts `cur` once it is
// acknowledged, so a PDU sent again has the same octets on air.

const ENC_IDLE = 0
const ENC_NEED_RANDOM = 1
const ENC_C_WAIT_RSP = 2
const ENC_P_WAIT_LTK = 3
const ENC_NEED_SK = 4
const ENC_P_WAIT_START_RSP = 5
const ENC_C_WAIT_START_REQ = 6
const ENC_C_WAIT_START_RSP = 7
const ENC_C_PAUSE_WAIT_RSP = 8
const ENC_P_PAUSE_WAIT_RSP = 9
const ENC_P_PAUSED = 10

// The error codes the procedure uses, [Vol 1] Part F.
const CODE_PIN_OR_KEY_MISSING = 0x06
const REASON_MIC_FAILURE = 0x3D
const REASON_HARDWARE_FAILURE = 0x03

// Forget the keys and the state of the procedure.
@tier(embedded)
fn enc_wipe(var l: Link)
    l.enc_ph = ENC_IDLE
    l.enc_refresh = false
    l.enc_tx = false
    l.enc_rx = false
    l.tx_ctr = 0
    l.rx_ctr = 0
    l.enc_status = 0
    l.start_early = false
    l.enc_ediv = 0
    for i in 0..8
        l.enc_rand[i] = 0
        l.ek.iv[i] = 0
    for i in 0..16
        l.skd[i] = 0
        l.ltk[i] = 0
        l.ek.sk[i] = 0

// Whether the connection is encrypted in both directions.
@tier(embedded)
fn link_encrypted(var l: Link) -> Bool
    l.enc_tx and l.enc_rx

// The directionBit of the PDUs this end sends.
@tier(embedded)
fn tx_dir(var l: Link) -> Int
    if l.central
        ll_cipher.DIR_CENTRAL
    else
        ll_cipher.DIR_PERIPHERAL

// Whether an LL Data PDU from the peer is unexpected: the procedure has gone far
// enough that only the PDUs it needs are due (Section 5.1.3.1 and 5.1.3.2).
@satisfies("REQ-BLE-CTL-033")
@tier(embedded)
fn enc_strict(var l: Link) -> Bool
    let ph = l.enc_ph
    if ph == ENC_IDLE or ph == ENC_C_WAIT_RSP or ph == ENC_C_PAUSE_WAIT_RSP
        return false
    if ph == ENC_NEED_RANDOM
        return not l.central or l.enc_refresh
    true

// The procedure ended with `status`; the Host is owed the event.
@tier(embedded)
fn enc_done(var l: Link, status: Int)
    l.enc_ph = ENC_IDLE
    if l.proc == PROC_ENC
        l.proc = PROC_NONE
    l.enc_status = status
    if l.enc_refresh and status == STATUS_SUCCESS
        l.owed = l.owed | EV_KEY_REFRESH
    else
        l.owed = l.owed | EV_ENC_CHANGE
    l.enc_refresh = false
    if status == STATUS_SUCCESS
        link_set_auth(var l, true, l.now)
    link_prepare(var l)

// The procedure failed: the link is not encrypted.
@tier(embedded)
fn enc_failed(var l: Link, code: Int)
    l.enc_tx = false
    l.enc_rx = false
    link_set_auth(var l, false, l.now)
    enc_done(var l, code)

// The PDU in `tmp` goes out, and the program that mirrors the PDUs reads them
// again.
@tier(embedded)
fn enc_send(var l: Link)
    send_tmp(var l)
    l.dirty = true

// LL_ENC_REQ (Peripheral).  The procedure starts when the Link Layer is idle or
// has just paused; any other time the request collides with a procedure under
// way (Section 5.3).
@satisfies("REQ-BLE-CTL-031")
@tier(embedded)
fn ctrl_enc_req(var l: Link, var rx: Pdu)
    if l.central
        answer_unknown(var l, ll_data.OP_ENC_REQ)
        return
    var ok = l.enc_ph == ENC_IDLE or l.enc_ph == ENC_P_PAUSED
    if l.enc_tx or l.enc_rx
        ok = false
    if not ok
        send_reject(var l, ll_data.OP_ENC_REQ, CODE_COLLISION)
        return
    for i in 0..8
        l.enc_rand[i] = ll_data.dpdu_byte(var rx, 1 + i) as u8
        l.skd[i] = ll_data.dpdu_byte(var rx, 11 + i) as u8
    l.enc_ediv = ll_data.dpdu_u16(var rx, 9)
    for i in 0..4
        l.ek.iv[i] = ll_data.dpdu_byte(var rx, 19 + i) as u8
    l.enc_ph = ENC_NEED_RANDOM

// LL_ENC_RSP (Central): SKD_P and IV_P complete the diversifier; the key is
// derived by the program next.
@satisfies("REQ-BLE-CTL-031")
@tier(embedded)
fn ctrl_enc_rsp(var l: Link, var rx: Pdu)
    if l.central and l.enc_ph == ENC_C_WAIT_RSP
        for i in 0..8
            l.skd[8 + i] = ll_data.dpdu_byte(var rx, 1 + i) as u8
        for i in 0..4
            l.ek.iv[4 + i] = ll_data.dpdu_byte(var rx, 9 + i) as u8
        l.enc_ph = ENC_NEED_SK

// LL_START_ENC_REQ (Central): from here this end sends and receives encrypted,
// and answers LL_START_ENC_RSP.
@satisfies("REQ-BLE-CTL-031")
@tier(embedded)
fn ctrl_start_enc_req(var l: Link)
    // The Peripheral can send it in the event of its LL_ENC_RSP, before the program has
    // derived the session key between the events: it is taken when the key is there.
    if l.central and l.enc_ph == ENC_NEED_SK
        l.start_early = true
        return
    if l.central and l.enc_ph == ENC_C_WAIT_START_REQ
        l.enc_tx = true
        l.enc_rx = true
        l.tx_ctr = 0
        l.rx_ctr = 0
        l.enc_ph = ENC_C_WAIT_START_RSP
        ll_data.ctrl_bare(var l.tmp, ll_data.OP_START_ENC_RSP)
        enc_send(var l)

// LL_START_ENC_RSP: the Central's procedure ends with the Peripheral's response, the
// Peripheral's with the Central's after it has sent its own, encrypted.
@satisfies("REQ-BLE-CTL-031")
@tier(embedded)
fn ctrl_start_enc_rsp(var l: Link)
    if l.central and l.enc_ph == ENC_C_WAIT_START_RSP
        enc_done(var l, STATUS_SUCCESS)
    else if not l.central and l.enc_ph == ENC_P_WAIT_START_RSP
        l.enc_tx = true
        l.tx_ctr = 0
        ll_data.ctrl_bare(var l.tmp, ll_data.OP_START_ENC_RSP)
        enc_send(var l)
        enc_done(var l, STATUS_SUCCESS)

// LL_PAUSE_ENC_REQ (Peripheral): the response goes out encrypted, and the
// Peripheral expects the Central's in the clear.
@satisfies("REQ-BLE-CTL-032")
@tier(embedded)
fn ctrl_pause_enc_req(var l: Link)
    if not l.central and l.enc_ph == ENC_IDLE and link_encrypted(var l)
        l.enc_ph = ENC_P_PAUSE_WAIT_RSP
        l.enc_refresh = true
        l.proc = PROC_ENC
        l.proc_t0 = l.now
        ll_data.ctrl_bare(var l.tmp, ll_data.OP_PAUSE_ENC_RSP)
        enc_send(var l)
        l.enc_rx = false

// LL_PAUSE_ENC_RSP: the Central's end of the pause is the Peripheral's response;
// it answers in the clear and starts the encryption again.  The Peripheral's end
// is the Central's response: it sends in the clear and waits for LL_ENC_REQ.
@satisfies("REQ-BLE-CTL-032")
@tier(embedded)
fn ctrl_pause_enc_rsp(var l: Link)
    if l.central and l.enc_ph == ENC_C_PAUSE_WAIT_RSP
        l.enc_tx = false
        l.enc_rx = false
        link_set_auth(var l, false, l.now)
        ll_data.ctrl_bare(var l.tmp, ll_data.OP_PAUSE_ENC_RSP)
        enc_send(var l)
        l.enc_ph = ENC_NEED_RANDOM
    else if not l.central and l.enc_ph == ENC_P_PAUSE_WAIT_RSP
        l.enc_tx = false
        link_set_auth(var l, false, l.now)
        l.enc_ph = ENC_P_PAUSED
        l.dirty = true

// Whether the Central has sent LL_ENC_REQ and waits for the Peripheral's word on
// the key: its LL_ENC_RSP comes first, and the reject after it.
@tier(embedded)
fn enc_waits_for_key(var l: Link) -> Bool
    l.central and (l.enc_ph == ENC_C_WAIT_RSP or l.enc_ph == ENC_NEED_SK or l.enc_ph == ENC_C_WAIT_START_REQ)

// LL_REJECT_IND or LL_REJECT_EXT_IND naming LL_ENC_REQ (Central): the Peripheral
// has no key, or no encryption.
@satisfies("REQ-BLE-CTL-031")
@tier(embedded)
fn enc_rejected(var l: Link, code: Int)
    if enc_waits_for_key(var l)
        for i in 0..16
            l.ltk[i] = 0
            l.skd[i] = 0
        enc_failed(var l, code)

// The peer does not know the PDU that began the procedure.
@tier(embedded)
fn enc_unknown(var l: Link, op: Int)
    if enc_waits_for_key(var l) and op == ll_data.OP_ENC_REQ
        enc_failed(var l, STATUS_UNSUPPORTED_REMOTE)

// Whether the program has to give `link_secure_poll` twelve random octets.
@tier(embedded)
fn link_wants_random(var l: Link) -> Bool
    l.live and not l.closing and l.enc_ph == ENC_NEED_RANDOM

// Whether the program has to give `link_secure_poll` a cipher.
@tier(embedded)
fn link_wants_cipher(var l: Link) -> Bool
    l.live and not l.closing and l.enc_ph == ENC_NEED_SK

// The work of the procedure that needs the program: with twelve random octets, the
// Central sends LL_ENC_REQ and the Peripheral LL_ENC_RSP, whose SKD (8 octets) and IV
// (4 octets) they are, when the program has them (`have`); with a cipher, the session
// key is derived and the procedure goes on.  True when the random octets were used.
@satisfies("REQ-BLE-CTL-031")
@tier(embedded)
fn link_secure_poll<C: Cipher[e]>(var l: Link, var cc: C, var rnd: Vec[u8; 12], have: Bool) -> Bool [e]
    var used = false
    if have and l.live and not l.closing and l.enc_ph == ENC_NEED_RANDOM
        used = true
        if l.central
            for i in 0..8
                l.skd[i] = rnd[i]
            for i in 0..4
                l.ek.iv[i] = rnd[8 + i]
            ll_data.ctrl_enc_req(var l.tmp, var l.enc_rand, l.enc_ediv, var l.skd, var l.ek.iv)
            send_tmp(var l)
            l.enc_ph = ENC_C_WAIT_RSP
            l.proc = PROC_ENC
            l.proc_t0 = l.now
        else
            for i in 0..8
                l.skd[8 + i] = rnd[i]
            for i in 0..4
                l.ek.iv[4 + i] = rnd[8 + i]
            ll_data.ctrl_enc_rsp(var l.tmp, var l.skd, var l.ek.iv)
            send_tmp(var l)
            l.enc_ph = ENC_P_WAIT_LTK
            l.owed = l.owed | EV_LTK_REQUEST
        link_prepare(var l)
    if l.live and not l.closing and l.enc_ph == ENC_NEED_SK
        derive_key(var l, var cc)
    used

// SK = AES(LTK, SKD) (Section 5.1.3.1): both are held least significant octet
// first and the cipher takes them most significant first.
@satisfies("REQ-BLE-CTL-031")
@tier(embedded)
fn derive_key<C: Cipher[e]>(var l: Link, var cc: C) [e]
    var key: Vec[u8; 16] = Vec.new()
    var blk: Vec[u8; 16] = Vec.new()
    for i in 0..16
        let _a = key.push(l.ltk[15 - i])
        let _b = blk.push(l.skd[15 - i])
    let ok = cc.block(var key, var blk)
    for i in 0..16
        l.ltk[i] = 0
        l.skd[i] = 0
    if not ok
        link_close(var l, REASON_HARDWARE_FAILURE)
        return
    for i in 0..16
        l.ek.sk[15 - i] = blk[i]
    if l.central
        l.enc_ph = ENC_C_WAIT_START_REQ
        if l.start_early
            l.start_early = false
            ctrl_start_enc_req(var l)
    else
        l.rx_ctr = 0
        l.enc_rx = true
        l.enc_ph = ENC_P_WAIT_START_RSP
        l.proc = PROC_ENC
        l.proc_t0 = l.now
        ll_data.ctrl_bare(var l.tmp, ll_data.OP_START_ENC_REQ)
        enc_send(var l)
        link_prepare(var l)

// ── The Host's commands ──

// Octet `i` of the Rand (`which` 0) or the long term key (`which` 1) the Host gave.
@tier(embedded)
fn link_enc_put(var l: Link, which: Int, i: Int, v: Int)
    if which == 0
        l.enc_rand[i] = (v & 0xFF) as u8
    else
        l.ltk[i] = (v & 0xFF) as u8

// LE Start Encryption (Section 7.8.24), Central: begins the Encryption Start
// procedure, or the Encryption Pause procedure on a link that is encrypted.  The
// Rand and the key were stored with `link_enc_put`.
@satisfies("REQ-BLE-CTL-031")
@satisfies("REQ-BLE-CTL-032")
@tier(embedded)
fn link_start_encryption(var l: Link, ediv: Int) -> Int
    if not l.live or l.closing
        return STATUS_UNKNOWN_CONNECTION
    if not l.central or l.enc_ph != ENC_IDLE or l.enc_wait
        return STATUS_COMMAND_DISALLOWED
    l.enc_ediv = ediv
    if phy_busy(var l)
        // The PHY Update of this end is not over: the procedure starts when it is.
        l.enc_wait = true
        return STATUS_SUCCESS
    enc_begin(var l)

// Begin the Encryption Start procedure, or the Encryption Pause procedure on a link that is
// encrypted, after the Host's LE Start Encryption.  Command Disallowed when the queue has no room
// for the pause.
@satisfies("REQ-BLE-CTL-031")
@satisfies("REQ-BLE-CTL-032")
@tier(embedded)
fn enc_begin(var l: Link) -> Int
    if link_encrypted(var l)
        ll_data.ctrl_bare(var l.tmp, ll_data.OP_PAUSE_ENC_REQ)
        if not ctrl_queue(var l, var l.tmp)
            return STATUS_COMMAND_DISALLOWED
        l.enc_ph = ENC_C_PAUSE_WAIT_RSP
        l.enc_refresh = true
        l.proc = PROC_ENC
        l.proc_t0 = l.now
        link_prepare(var l)
    else
        l.enc_ph = ENC_NEED_RANDOM
        l.enc_refresh = false
    STATUS_SUCCESS

// LE Long Term Key Request Reply (Section 7.8.25), Peripheral: the key was stored
// with `link_enc_put`.
@satisfies("REQ-BLE-CTL-035")
@tier(embedded)
fn link_ltk_reply(var l: Link) -> Int
    if not l.live or l.closing
        return STATUS_UNKNOWN_CONNECTION
    if l.central or l.enc_ph != ENC_P_WAIT_LTK
        return STATUS_COMMAND_DISALLOWED
    l.enc_ph = ENC_NEED_SK
    STATUS_SUCCESS

// LE Long Term Key Request Negative Reply (Section 7.8.26): the Central is told
// the key is missing, or, after a pause, the connection ends with PIN or Key
// Missing (Section 5.1.3.1).
@satisfies("REQ-BLE-CTL-035")
@tier(embedded)
fn link_ltk_negative(var l: Link) -> Int
    if not l.live or l.closing
        return STATUS_UNKNOWN_CONNECTION
    if l.central or l.enc_ph != ENC_P_WAIT_LTK
        return STATUS_COMMAND_DISALLOWED
    for i in 0..16
        l.ltk[i] = 0
        l.skd[i] = 0
    l.enc_ph = ENC_IDLE
    if l.enc_refresh
        l.enc_refresh = false
        if l.proc == PROC_ENC
            l.proc = PROC_NONE
        let _s = link_disconnect(var l, CODE_PIN_OR_KEY_MISSING)
    else
        send_reject(var l, ll_data.OP_ENC_REQ, CODE_PIN_OR_KEY_MISSING)
        link_prepare(var l)
    STATUS_SUCCESS

// ── The PDUs on air ──

// The PDU `p` is a copy of `l.cur`, or of `l.nxt`, sealed as the link sends it.
@satisfies("REQ-BLE-CTL-030")
@satisfies("REQ-BLE-CTL-034")
@tier(embedded)
fn link_air_cur<C: Cipher[e]>(var l: Link, var cc: C, var p: Pdu) [e]
    pdu_copy(var p, var l.cur)
    if l.enc_tx
        cc.seal(var l.ek, l.tx_ctr, tx_dir(var l), var p)

@satisfies("REQ-BLE-CTL-030")
@satisfies("REQ-BLE-CTL-034")
@tier(embedded)
fn link_air_nxt<C: Cipher[e]>(var l: Link, var cc: C, var p: Pdu) [e]
    pdu_copy(var p, var l.nxt)
    if l.enc_tx
        var ctr = l.tx_ctr
        if ll_data.dpdu_len(var l.cur) > 0
            ctr = ctr + 1
        cc.seal(var l.ek, ctr, tx_dir(var l), var p)

// A packet with a good CRC was taken by `link_rx_fast`: open the PDU `rx` when the
// link receives encrypted and the PDU is new and has a payload.  A MIC that does not
// match ends the connection with MIC Failure, and the PDU is not read.  A valid MIC
// restarts the authenticated payload timer.
@satisfies("REQ-BLE-CTL-033")
@tier(embedded)
fn link_rx_open<C: Cipher[e]>(var l: Link, var cc: C, var rx: Pdu) [e]
    if not l.rx_new or not l.enc_rx or ll_data.dpdu_len(var rx) == 0
        return
    let dir = ll_cipher.DIR_CENTRAL - tx_dir(var l)
    if cc.open(var l.ek, l.rx_ctr, dir, var rx)
        l.rx_ctr = l.rx_ctr + 1
        link_auth_rx(var l, l.last_rx)
    else
        l.rx_new = false
        link_close(var l, REASON_MIC_FAILURE)

// The rest of the work for a packet with a good CRC, after `link_rx_fast`
// answered it: if the Central acknowledged the PDU in flight, the next one
// takes its place; a packet taken as new is read, an LL Control PDU acted on
// and data left for the Host (`RX_TO_HOST`, the payload in `rx`).  The
// next PDU is prepared last.
@satisfies("REQ-BLE-CTL-017")
@tier(embedded)
fn link_rx_slow(var l: Link, var rx: Pdu) -> Int
    if (ctl_limits.features_octet4() & FEAT4_SUB) != 0 and (l.sub_factor > 1 or l.sub_tr) and ll_data.dpdu_len(var rx) > 0
        l.sub_busy = true
    if l.acked
        promote(var l)
    var found = RX_NOTHING
    if l.rx_new
        let llid = ll_data.dpdu_llid(var rx)
        if llid == ll_data.LLID_CONTROL
            ctrl_rx(l, rx)
        else if llid != 0 and ll_data.dpdu_len(var rx) > 0
            if enc_strict(var l)
                link_close(var l, REASON_MIC_FAILURE)
            else
                found = RX_TO_HOST
                l.data_in = l.data_in + 1
    link_prepare(var l)
    found

// ── Skipping events the program was too late for ─────────────────────

// Whether the window of the next event has already closed at `now`.
@tier(embedded)
fn link_event_late(var l: Link, now: Int) -> Bool
    l.live and not l.closing and now > link_listen_end(var l)

// The events whose windows closed before `now` are missed: each takes its
// channel and moves the schedule on.  At most `CATCH_UP_MAX` are skipped in one
// call.  The answer is the number skipped.
@satisfies("REQ-BLE-CTL-017")
@tier(embedded)
fn link_catch_up(var l: Link, now: Int) -> Int
    var n = 0
    for _ in 0..CATCH_UP_MAX
        if not link_event_late(var l, now)
            break
        let _ch = link_event_begin(var l)
        link_event_done(var l, now)
        n = n + 1
    n

// ── The Host's commands ──────────────────────────────────────────────

// HCI Disconnect: LL_TERMINATE_IND with the Host's `reason` goes to the peer,
// and the link ends when it is acknowledged (Section 5.1.3).  The status is
// Success, Unknown Connection Identifier for a handle not in use, or Command
// Disallowed for a link that is ending already.
@satisfies("REQ-BLE-CTL-018")
@tier(embedded)
fn link_disconnect(var l: Link, reason: Int) -> Int
    if not l.live
        return STATUS_UNKNOWN_CONNECTION
    if l.term_sent or l.closing
        return STATUS_COMMAND_DISALLOWED
    ll_data.ctrl_terminate(var l.tmp, reason)
    if not ctrl_queue(var l, var l.tmp)
        return STATUS_COMMAND_DISALLOWED
    l.term_sent = true
    l.term_reason = reason
    l.term_t0 = l.now
    link_prepare(var l)
    STATUS_SUCCESS

// HCI Read Remote Version Information.  The answer is at once when the peer's
// LL_VERSION_IND is known; otherwise this end sends its own (once) and waits for
// the peer's.
@satisfies("REQ-BLE-CTL-020")
@tier(embedded)
fn link_read_version(var l: Link) -> Int
    if not l.live or l.closing
        return STATUS_UNKNOWN_CONNECTION
    if l.proc != PROC_NONE
        return STATUS_COMMAND_DISALLOWED
    if l.ver_rcvd
        l.ver_status = STATUS_SUCCESS
        l.owed = l.owed | EV_VERSION
        return STATUS_SUCCESS
    if not l.ver_sent
        ll_data.ctrl_version(var l.tmp, LL_VERSION, LL_COMPANY, LL_SUBVERSION)
        if not ctrl_queue(var l, var l.tmp)
            return STATUS_COMMAND_DISALLOWED
        l.ver_sent = true
        link_prepare(var l)
    l.proc = PROC_VERSION
    l.proc_t0 = l.now
    STATUS_SUCCESS

// HCI LE Read Remote Features: the answer is at once when the peer's set is
// known, otherwise LL_PERIPHERAL_FEATURE_REQ goes out (Section 5.1.4).
@satisfies("REQ-BLE-CTL-020")
@tier(embedded)
fn link_read_features(var l: Link) -> Int
    if not l.live or l.closing
        return STATUS_UNKNOWN_CONNECTION
    if l.proc != PROC_NONE
        return STATUS_COMMAND_DISALLOWED
    if l.have_feat
        l.feat_status = STATUS_SUCCESS
        l.owed = l.owed | EV_FEATURES
        return STATUS_SUCCESS
    var f: Vec[u8; 8] = Vec.new()
    for _ in 0..8
        let _a = f.push(0)
    own_features(var f, l.host_iso, l.host_sub)
    if l.no_coded
        clear_coded(var f)
    ll_data.ctrl_features(var l.tmp, features_request_opcode(var l), var f)
    if not ctrl_queue(var l, var l.tmp)
        return STATUS_COMMAND_DISALLOWED
    l.proc = PROC_FEATURES
    l.proc_t0 = l.now
    link_prepare(var l)
    STATUS_SUCCESS

// HCI LE Connection Update ([Vol 4] Part E, Section 7.8.18).  The Central updates
// the connection at once, to the longest interval of the range; the Peripheral
// asks the Central with LL_CONNECTION_PARAM_REQ, and the Host hears the result in
// LE Connection Update Complete.  The status is Success, Unknown Connection
// Identifier, Invalid HCI Command Parameters, Command Disallowed while an
// update, a channel map or a request of the peer is under way (Section 5.3), or
// Unsupported Remote Feature for a peer known not to have the procedure.
@satisfies("REQ-BLE-CTL-026")
@satisfies("REQ-BLE-CTL-027")
@tier(embedded)
fn link_connection_update(var l: Link, i_min: Int, i_max: Int, latency: Int, timeout: Int) -> Int
    if not l.live or l.closing
        return STATUS_UNKNOWN_CONNECTION
    if not params_valid(i_min, i_max, latency, timeout)
        return STATUS_INVALID_PARAMETERS
    if instant_busy(var l) or l.rq_wait
        return STATUS_COMMAND_DISALLOWED
    if l.proc != PROC_NONE
        return STATUS_COMMAND_DISALLOWED
    let lacks = l.cpr_no or (l.have_feat and ((l.peer_feat[0] as Int) & FEAT0_PARAM_REQUEST) == 0)
    if l.central and lacks
        return central_update(var l, pick_interval(i_min, i_max, 0), latency, timeout, true, 0, -1)
    if lacks
        return STATUS_UNSUPPORTED_REMOTE
    var period = 0
    if i_min != i_max
        period = i_min
    ll_data.ctrl_param(var l.tmp, ll_data.OP_CONNECTION_PARAM_REQ, i_min, i_max, latency, timeout, period, l.ev_count)
    if not ctrl_queue(var l, var l.tmp)
        return STATUS_COMMAND_DISALLOWED
    l.cpr_min = i_min
    l.cpr_max = i_max
    l.cpr_latency = latency
    l.cpr_timeout = timeout
    l.proc = PROC_PARAM
    l.proc_t0 = l.now
    link_prepare(var l)
    STATUS_SUCCESS

// HCI LE Remote Connection Parameter Request Reply (Section 7.8.31): the Host
// accepts the request of the peer, with the range it gives.  Command Disallowed
// when no request waits for the Host.
@satisfies("REQ-BLE-CTL-027")
@tier(embedded)
fn link_param_reply(var l: Link, i_min: Int, i_max: Int, latency: Int, timeout: Int) -> Int
    if not l.live or l.closing
        return STATUS_UNKNOWN_CONNECTION
    if not l.rq_wait
        return STATUS_COMMAND_DISALLOWED
    if not params_valid(i_min, i_max, latency, timeout)
        return STATUS_INVALID_PARAMETERS
    l.rq_wait = false
    param_accept(var l, i_min, i_max, latency, timeout, l.rq_period, l.rq_ref, l.rq_off)
    link_prepare(var l)
    STATUS_SUCCESS

// HCI LE Remote Connection Parameter Request Negative Reply (Section 7.8.32): the
// peer is told the request is refused for `reason`.
@satisfies("REQ-BLE-CTL-027")
@tier(embedded)
fn link_param_negative(var l: Link, reason: Int) -> Int
    if not l.live or l.closing
        return STATUS_UNKNOWN_CONNECTION
    if not l.rq_wait
        return STATUS_COMMAND_DISALLOWED
    l.rq_wait = false
    send_reject(var l, l.rq_op, reason)
    link_prepare(var l)
    STATUS_SUCCESS

// HCI Write Authenticated Payload Timeout ([Vol 4] Part E, Section 7.3.94): the
// timeout in units of 10 ms, at least the time of one connection interval and its
// latency; the timer starts again.
@satisfies("REQ-BLE-CTL-028")
@tier(embedded)
fn link_set_apto(var l: Link, apto: Int) -> Int
    if not l.live or l.closing
        return STATUS_UNKNOWN_CONNECTION
    if apto < 1 or apto > 0xFFFF or apto * TIMEOUT_UNIT_US < interval_us(l) * (1 + l.latency)
        return STATUS_INVALID_PARAMETERS
    l.apto = apto
    l.auth_t0 = l.now
    l.pinged = false
    STATUS_SUCCESS

// The Host's buffers freed since it was told, and the count cleared.
@tier(embedded)
fn link_take_completed(var l: Link) -> Int
    let n = l.completed
    l.completed = 0
    l.owed = l.owed & (0xFFFF ^ EV_COMPLETED)
    n

// The event `bit` was sent.
@tier(embedded)
fn link_sent(var l: Link, bit: Int)
    l.owed = l.owed & (0xFFFF ^ bit)

// Whether the Host is owed the event `bit`.
@tier(embedded)
fn link_owes(var l: Link, bit: Int) -> Bool
    (l.owed & bit) != 0

// ── Tests ───────────────────────────────────────────────────────────

// Two octets of a test PDU, least significant first.
fn t_put16(var p: Pdu, v: Int)
    let _a = ll_pdu.pdu_put(var p, v & 0xFF)
    let _b = ll_pdu.pdu_put(var p, (v >>> 8) & 0xFF)

// A CONNECT_IND from the random address 0x40..0x45 to the public address
// 0x10..0x15: the access address 0x50655A12, CRC seed 0x332211, an interval
// of `interval` units, a latency, a timeout, a transmit window of `win_size`
// at `win_offset`, the channel map `map`, hop `hop` and SCA class `sca`.
fn t_connect(interval: Int, latency: Int, timeout: Int, win_size: Int, win_offset: Int, map: Int, hop: Int, sca: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_pdu.pdu_begin(var p, ll_pdu.CONNECT_IND, 1, 0)
    for i in 0..6
        let _a = ll_pdu.pdu_put(var p, 0x40 + i)
    for i in 0..6
        let _b = ll_pdu.pdu_put(var p, 0x10 + i)
    t_put16(var p, 0x5A12)
    t_put16(var p, 0x5065)
    t_put16(var p, 0x2211)
    let _c = ll_pdu.pdu_put(var p, 0x33)
    let _d = ll_pdu.pdu_put(var p, win_size)
    t_put16(var p, win_offset)
    t_put16(var p, interval)
    t_put16(var p, latency)
    t_put16(var p, timeout)
    for k in 0..5
        let _g = ll_pdu.pdu_put(var p, (map >>> (8 * k)) & 0xFF)
    let _h = ll_pdu.pdu_put(var p, hop | (sca << 5))
    ll_pdu.pdu_finish(var p)
    p

// The usual request: 7.5 ms interval, no latency, 2 s timeout, a transmit
// window of 2.5 ms at offset 0, all 37 channels, hop 7, SCA class 0.
fn t_usual() -> Pdu
    t_connect(6, 0, 200, 2, 0, 0x1FFFFFFFFF, 7, 0)

// A link opened on the usual request, which ended at time 1000.
fn t_link() -> Link
    var l = link_new()
    var p = t_usual()
    link_open(var l, 1, var p, 1000)
    l

// An LL Control PDU from the peer: the opcode and the payload octets after it.
fn t_ctrl(op: Int, rest: [Int]) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_data.ctrl_begin(var p, op)
    for b in rest
        let _a = ll_pdu.pdu_put(var p, b)
    ll_data.dpdu_finish(var p)
    p

// A data PDU from the peer.
fn t_data(llid: Int, n: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_data.dpdu_begin(var p, llid)
    for i in 0..n
        let _a = ll_pdu.pdu_put(var p, 0xA0 + i)
    ll_data.dpdu_finish(var p)
    p

// The header octet of a Central's packet.
fn t_hdr(sn: Int, nesn: Int, md: Int) -> Int
    1 | (nesn << 2) | (sn << 3) | (md << 4)

// Run the Central's PDU `rx`, with the header bits `sn`, `nesn`, `md`, through
// the two steps a packet takes; the answer is the verdict of the slow step.
fn t_packet(var l: Link, var rx: Pdu, sn: Int, nesn: Int, md: Int) -> Int
    let _h = link_rx_fast(var l, (rx.b[0] as Int) | (nesn << 2) | (sn << 3) | (md << 4))
    link_rx_slow(var l, var rx)

// Set a field of the link for a test: the link is the callee's `var`.
fn t_due(var l: Link, v: Int)
    l.due = v

fn t_ev_count(var l: Link, v: Int)
    l.ev_count = v

fn t_now(var l: Link, v: Int)
    l.now = v

fn t_proc(var l: Link, v: Int)
    l.proc = v

fn t_alive(var l: Link, timeout: Int, last_rx: Int)
    l.timeout = timeout
    l.synced = true
    l.last_rx = last_rx

// The slow step on a data PDU the Central sent: LLID `llid`, `n` octets.
fn t_slow(var l: Link, llid: Int, n: Int) -> Int
    var rx = t_data(llid, n)
    link_rx_slow(var l, var rx)

// An ACL fragment of `n` octets queued for the Peripheral.
fn t_queue(var l: Link, start: Bool, n: Int) -> Bool
    var d: Vec[u8; 260] = Vec.new()
    for i in 0..260
        // The payload is from octet 2, as the H4 reader leaves it; octet 0x60 first.
        let _a = d.push((0x60 + ((i + 30) & 0x1F)) as u8)
    link_queue_acl(var l, start, var d, n)

@test
fn test_connect_ind_checks_each_field()
    var ok = t_usual()
    test.assert(connect_valid(var ok))
    var a = t_connect(5, 0, 200, 2, 0, 0x1FFFFFFFFF, 7, 0)
    test.assert(not connect_valid(var a))
    var b = t_connect(3201, 0, 3200, 2, 0, 0x1FFFFFFFFF, 7, 0)
    test.assert(not connect_valid(var b))
    var c = t_connect(6, 0, 200, 0, 0, 0x1FFFFFFFFF, 7, 0)
    test.assert(not connect_valid(var c))
    var d = t_connect(40, 0, 200, 9, 0, 0x1FFFFFFFFF, 7, 0)
    test.assert(not connect_valid(var d))
    var e = t_connect(6, 0, 200, 6, 0, 0x1FFFFFFFFF, 7, 0)
    test.assert(not connect_valid(var e))
    var f = t_connect(6, 0, 200, 2, 7, 0x1FFFFFFFFF, 7, 0)
    test.assert(not connect_valid(var f))
    var g = t_connect(6, 500, 3200, 2, 0, 0x1FFFFFFFFF, 7, 0)
    test.assert(not connect_valid(var g))
    var h = t_connect(6, 0, 9, 2, 0, 0x1FFFFFFFFF, 7, 0)
    test.assert(not connect_valid(var h))
    var i = t_connect(6, 0, 3201, 2, 0, 0x1FFFFFFFFF, 7, 0)
    test.assert(not connect_valid(var i))
    // A timeout of 100 ms is not longer than twice the 7.5 ms interval of 11 events.
    var j = t_connect(6, 10, 10, 2, 0, 0x1FFFFFFFFF, 7, 0)
    test.assert(not connect_valid(var j))
    var k = t_connect(6, 0, 200, 2, 0, 0x0000000001, 7, 0)
    test.assert(not connect_valid(var k))
    var m = t_connect(6, 0, 200, 2, 0, 0x2000000003, 7, 0)
    test.assert(not connect_valid(var m))
    var n = t_connect(6, 0, 200, 2, 0, 0x1FFFFFFFFF, 4, 0)
    test.assert(not connect_valid(var n))
    var o = t_connect(6, 0, 200, 2, 0, 0x1FFFFFFFFF, 17, 0)
    test.assert(not connect_valid(var o))
    var p = t_usual()
    p.b[2 + 12] = 0xD6
    p.b[2 + 13] = 0xBE
    p.b[2 + 14] = 0x89
    p.b[2 + 15] = 0x8E
    test.assert(not connect_valid(var p))
    // The limits themselves are valid.
    var q = t_connect(3200, 0, 3200, 8, 3200, 0x0000000003, 16, 7)
    test.assert(connect_valid(var q))
    var r = t_connect(9, 499, 1200, 1, 0, 0x0000000003, 5, 0)
    test.assert(connect_valid(var r))

@test
fn test_request_reads_the_connect_ind()
    var p = t_connect(24, 3, 400, 2, 5, 0x1F00FF00FF, 9, 5)
    var r = ll_policy.conn_request_new()
    connect_request(var p, var r)
    test.assert_eq(r.peer_type, 1)
    test.assert_eq(r.peer[0] as Int, 0x40)
    test.assert_eq(r.peer[5] as Int, 0x45)
    test.assert_eq(r.interval, 24)
    test.assert_eq(r.latency, 3)
    test.assert_eq(r.timeout, 400)
    test.assert_eq(r.win_size, 2)
    test.assert_eq(r.win_offset, 5)
    test.assert_eq(r.hop, 9)
    test.assert_eq(r.sca, 5)
    test.assert_eq(r.chmap, 0x1F00FF00FF)

@test
fn test_open_takes_the_parameters_and_expects_the_first_anchor()
    var l = t_link()
    test.assert(link_live(var l))
    test.assert_eq(l.handle, 1)
    test.assert_eq(l.aa, 0x50655A12)
    test.assert_eq(l.crc_init, 0x332211)
    test.assert_eq(l.interval, 6)
    test.assert_eq(l.timeout, 200)
    test.assert_eq(l.n_used, 37)
    test.assert_eq(l.hop, 7)
    test.assert_eq(l.sca, 0)
    test.assert_eq(l.peer_type, 1)
    test.assert_eq(l.own_type, 0)
    test.assert_eq(l.peer[0] as Int, 0x40)
    test.assert_eq(l.own[5] as Int, 0x15)
    // The transmit window starts 1.25 ms after the end of the CONNECT_IND, plus
    // WinOffset, and is WinSize long.
    test.assert_eq(l.due, 1000 + 1250)
    test.assert_eq(l.win_len, 2500)
    test.assert_eq(l.first_due, l.due)
    test.assert_eq(l.owed, EV_CONNECTED)
    test.assert_eq(interval_us(l), 7500)
    var p = t_connect(24, 0, 400, 2, 3, 0x1FFFFFFFFF, 7, 0)
    link_open(var l, 2, var p, 5000)
    test.assert_eq(l.due, 5000 + 1250 + 3 * 1250)
    test.assert_eq(l.handle, 2)

@test
fn test_clock_accuracy_classes_follow_the_table()
    test.assert_eq(sca_ppm(0), 500)
    test.assert_eq(sca_ppm(1), 250)
    test.assert_eq(sca_ppm(2), 150)
    test.assert_eq(sca_ppm(3), 100)
    test.assert_eq(sca_ppm(4), 75)
    test.assert_eq(sca_ppm(5), 50)
    test.assert_eq(sca_ppm(6), 30)
    test.assert_eq(sca_ppm(7), 20)

@test
fn test_channel_map_helpers()
    test.assert_eq(popcount(0x1FFFFFFFFF), 37)
    test.assert_eq(popcount(0), 0)
    test.assert_eq(popcount(0b1010), 2)
    test.assert_eq(nth_used(0b1010, 0), 1)
    test.assert_eq(nth_used(0b1010, 1), 3)
    test.assert_eq(nth_used(0b1010, 5), 0)

@test
fn test_channel_selection_hops_by_the_increment()
    var l = t_link()
    test.assert_eq(chan_next(var l), 7)
    test.assert_eq(chan_next(var l), 14)
    test.assert_eq(chan_next(var l), 21)
    test.assert_eq(chan_next(var l), 28)
    test.assert_eq(chan_next(var l), 35)
    // 35 + 7 = 42, modulo 37 is 5.
    test.assert_eq(chan_next(var l), 5)

@test
fn test_channel_selection_remaps_an_unused_channel()
    // Channels 0 to 9 and 20 to 36 are used: 27 channels.
    var l = link_new()
    var p = t_connect(6, 0, 200, 2, 0, 0x1FFFF003FF, 7, 0)
    link_open(var l, 1, var p, 0)
    test.assert_eq(l.n_used, 27)
    test.assert_eq(chan_next(var l), 7)
    // 14 is unused: remapped to usedChannels[14 % 27], the 15th used channel,
    // which is channel 24 (0 to 9, then 20 is the 11th, so 24 is the 15th).
    test.assert_eq(chan_next(var l), 24)

@test
fn test_widening_grows_with_the_time_since_the_anchor()
    var l = t_link()
    // First window: 1250 us since the end of the CONNECT_IND, the Central
    // 500 ppm and this end 50: 550 * 1250 / 1e6 = 0, plus 32 us of jitter.
    test.assert_eq(widening(var l), 32)
    test.assert_eq(link_listen_start(var l), 1000 + 1250 - 32)
    test.assert_eq(link_listen_end(var l), 1000 + 1250 + 2500 + 32)
    t_due(var l, l.t_ref + 1000000)
    test.assert_eq(widening(var l), 550 + 32)
    // Over 20 s the accuracy alone is 11 ms; the cap is half the interval less T_IFS.
    t_due(var l, l.t_ref + 20000000)
    test.assert_eq(widening(var l), 3750 - 150)

@test
fn test_an_event_with_an_anchor_moves_the_schedule_on_from_it()
    var l = t_link()
    test.assert_eq(link_event_begin(var l), 7)
    test.assert(l.ev_open)
    link_note_rx(var l, 3100, true)
    link_note_rx(var l, 3500, true)
    test.assert_eq(l.anchor, 3100)
    test.assert(l.synced)
    test.assert_eq(l.last_rx, 3500)
    link_event_done(var l, 4000)
    test.assert(not l.ev_open)
    test.assert_eq(l.ev_count, 1)
    test.assert_eq(l.due, 3100 + 7500)
    test.assert_eq(l.t_ref, 3100)
    test.assert_eq(l.win_len, 0)
    test.assert(not l.closing)

@test
fn test_a_missed_event_keeps_the_window_and_the_last_anchor()
    var l = t_link()
    let _c = link_event_begin(var l)
    link_event_done(var l, 5000)
    test.assert_eq(l.ev_count, 1)
    test.assert_eq(l.due, 2250 + 7500)
    test.assert_eq(l.t_ref, 1000)
    // The transmit window is still asked for.
    test.assert_eq(l.win_len, 2500)
    // The widening reckons from the end of the CONNECT_IND.
    test.assert_eq(widening(var l), (550 * (2250 + 7500 - 1000)) / 1000000 + 32)

@test
fn test_a_packet_with_a_bad_crc_still_fixes_the_anchor()
    var l = t_link()
    let _c = link_event_begin(var l)
    link_note_rx(var l, 3200, false)
    test.assert(l.ev_anchor)
    test.assert(l.synced)
    // The supervision timer is not reset by it.
    test.assert_eq(l.last_rx, 1000)
    test.assert_eq(l.bad_run, 1)
    test.assert(link_answers_bad(var l))
    link_note_rx(var l, 3300, false)
    test.assert(not link_answers_bad(var l))
    link_note_rx(var l, 3400, true)
    test.assert(link_answers_bad(var l))
    test.assert_eq(l.last_rx, 3400)
    test.assert_eq(l.anchor, 3200)

@test
fn test_the_event_counter_wraps_at_65536()
    var l = t_link()
    t_ev_count(var l, 0xFFFF)
    let _c = link_event_begin(var l)
    link_event_done(var l, 3000)
    test.assert_eq(l.ev_count, 0)

@test
fn test_a_connection_that_never_hears_the_central_fails_to_establish()
    var l = t_link()
    var t = 1000
    var n = 0
    while not l.closing and n < 40
        let _c = link_event_begin(var l)
        t = l.due + 7500
        link_event_done(var l, t)
        n = n + 1
    test.assert(l.closing)
    test.assert_eq(l.reason, REASON_FAILED_TO_ESTABLISH)
    test.assert(n >= 6)
    test.assert(n <= 9)
    test.assert(link_ended(var l))

@test
fn test_supervision_timeout_ends_the_connection()
    var l = t_link()
    let _c = link_event_begin(var l)
    link_note_rx(var l, 3000, true)
    link_event_done(var l, 4000)
    test.assert(not l.closing)
    let _d = link_event_begin(var l)
    // 200 units of 10 ms is 2 s after the last good packet.
    link_event_done(var l, 3000 + 2000000)
    test.assert(not l.closing)
    let _e = link_event_begin(var l)
    link_event_done(var l, 3000 + 2000001)
    test.assert(l.closing)
    test.assert_eq(l.reason, REASON_TIMEOUT)
    // The first reason stands.
    link_close(var l, 0x13)
    test.assert_eq(l.reason, REASON_TIMEOUT)

@test
fn test_supervision_timeout_after_a_disconnect_is_local_termination()
    var l = t_link()
    let _c = link_event_begin(var l)
    link_note_rx(var l, 3000, true)
    link_event_done(var l, 3500)
    test.assert_eq(link_disconnect(var l, 0x13), 0)
    let _d = link_event_begin(var l)
    link_event_done(var l, 3000 + 2000001)
    test.assert(l.closing)
    test.assert_eq(l.reason, REASON_LOCAL_HOST)

@test
fn test_termination_timer_runs_without_the_supervision_timer()
    var l = t_link()
    t_now(var l, 100)
    let _c = link_event_begin(var l)
    link_note_rx(var l, 3000, true)
    link_event_done(var l, 3500)
    test.assert_eq(link_disconnect(var l, 0x13), 0)
    // The packets keep coming, the PDU is never acknowledged.
    let _d = link_event_begin(var l)
    link_note_rx(var l, 2200000, true)
    link_event_done(var l, 2200001)
    test.assert(l.closing)
    test.assert_eq(l.reason, REASON_LOCAL_HOST)

@test
fn test_a_procedure_that_gets_no_answer_in_forty_seconds_ends_the_connection()
    var l = t_link()
    let _c = link_event_begin(var l)
    link_note_rx(var l, 3000, true)
    link_event_done(var l, 3500)
    test.assert_eq(link_read_version(var l), 0)
    let _d = link_event_begin(var l)
    link_note_rx(var l, 30000000, true)
    link_event_done(var l, 30000001)
    test.assert(not l.closing)
    let _e = link_event_begin(var l)
    link_note_rx(var l, 41000000, true)
    link_event_done(var l, 41000001)
    test.assert(l.closing)
    test.assert_eq(l.reason, REASON_RESPONSE_TIMEOUT)

@test
fn test_the_first_packet_is_new_data_and_is_acknowledged()
    var l = t_link()
    // The Central's first packet: SN 0, NESN 0, no MD.  Nothing of ours is
    // acknowledged; its data is new, so NESN becomes 1; this end sends the PDU
    // in flight, SN 0, an empty one.
    let h = link_rx_fast(var l, t_hdr(0, 0, 0))
    test.assert_eq(h, 1 | (1 << 2))
    test.assert(not l.acked)
    test.assert(l.rx_new)
    test.assert(not l.use_nxt)
    test.assert(not l.cont)
    test.assert_eq(l.nesn, 1)

@test
fn test_a_resent_packet_is_not_taken_again()
    var l = t_link()
    let _a = link_rx_fast(var l, t_hdr(0, 0, 0))
    // The Central sends SN 0 again, since it did not hear this end: old data.
    let h = link_rx_fast(var l, t_hdr(0, 0, 0))
    test.assert(not l.rx_new)
    test.assert_eq(l.nesn, 1)
    test.assert_eq(h, 1 | (1 << 2))
    // SN 1 is the next new one.
    let _b = link_rx_fast(var l, t_hdr(1, 0, 0))
    test.assert(l.rx_new)
    test.assert_eq(l.nesn, 0)

@test
fn test_the_central_acknowledging_selects_the_next_pdu()
    var l = t_link()
    test.assert(t_queue(var l, true, 5))
    // The PDU in flight is still the empty one; the data waits in `nxt`.
    test.assert_eq(l.nxt_kind, K_ACL)
    let _a = link_rx_fast(var l, t_hdr(0, 0, 0))
    let _b = t_slow(var l, 0, 0)
    // NESN 1: the empty PDU is acknowledged and the data goes, with SN 1.
    var rx = t_data(1, 0)
    let h = link_rx_fast(var l, t_hdr(1, 1, 0))
    test.assert(l.acked)
    test.assert(l.use_nxt)
    test.assert_eq(h & 3, ll_data.LLID_START)
    test.assert_eq((h >>> 3) & 1, 1)
    test.assert_eq((h >>> 2) & 1, 0)
    let r = link_rx_slow(var l, var rx)
    test.assert_eq(r, RX_NOTHING)
    test.assert_eq(l.sn, 1)
    test.assert_eq(l.cur_kind, K_ACL)
    test.assert_eq(ll_data.dpdu_len(var l.cur), 5)
    test.assert_eq(ll_data.dpdu_byte(var l.cur, 0), 0x60)
    test.assert_eq(l.nxt_kind, K_EMPTY)
    test.assert(l.dirty)

@test
fn test_a_packet_that_does_not_acknowledge_sends_the_pdu_again()
    var l = t_link()
    let _a = link_rx_fast(var l, t_hdr(0, 0, 0))
    let _b = t_slow(var l, 0, 0)
    let h = link_rx_fast(var l, t_hdr(1, 0, 0))
    test.assert(not l.acked)
    test.assert(not l.use_nxt)
    test.assert_eq((h >>> 3) & 1, 0)

@test
fn test_md_on_either_side_keeps_the_event_open()
    var l = t_link()
    let _a = link_rx_fast(var l, t_hdr(0, 0, 1))
    test.assert(l.cont)
    let _b = t_slow(var l, 0, 0)
    let _c = link_rx_fast(var l, t_hdr(1, 0, 0))
    test.assert(not l.cont)
    // Two PDUs queued: the first sent carries MD.
    test.assert(t_queue(var l, true, 3))
    test.assert(t_queue(var l, false, 3))
    test.assert_eq(l.nxt_md, 1)
    let _d = link_rx_fast(var l, t_hdr(0, 1, 0))
    test.assert(l.acked)
    test.assert(l.cont)

@test
fn test_a_packet_without_room_is_not_acknowledged()
    var l = t_link()
    link_set_room(var l, 1)
    test.assert(not l.room)
    let h = link_rx_fast(var l, t_hdr(0, 0, 0))
    test.assert(not l.rx_new)
    test.assert_eq(l.nesn, 0)
    test.assert_eq((h >>> 2) & 1, 0)
    link_set_room(var l, 2)
    test.assert(l.room)
    let _x = link_rx_fast(var l, t_hdr(0, 0, 0))
    test.assert(l.rx_new)
    // A full queue of LL Control PDUs also holds the Central back.
    for _ in 0..3
        var p = t_ctrl(ll_data.OP_PING_RSP, [])
        test.assert(ctrl_queue(var l, var p))
    link_set_room(var l, 4)
    test.assert(not l.room)

@test
fn test_a_bad_packet_is_answered_with_the_pdu_in_flight_and_nothing_acknowledged()
    var l = t_link()
    let _a = link_rx_fast(var l, t_hdr(0, 0, 0))
    let _b = t_slow(var l, 0, 0)
    let h = link_rx_bad(var l)
    test.assert_eq(h, 1 | (1 << 2))
    test.assert(not l.acked)
    test.assert(not l.rx_new)
    test.assert(l.cont)
    test.assert(not l.use_nxt)

@test
fn test_acknowledged_acl_data_frees_a_host_buffer()
    var l = t_link()
    test.assert(t_queue(var l, true, 4))
    let _a = link_rx_fast(var l, t_hdr(0, 0, 0))
    let _b = t_slow(var l, 0, 0)
    let _c = link_rx_fast(var l, t_hdr(1, 1, 0))
    let _d = t_slow(var l, 1, 0)
    test.assert_eq(l.completed, 0)
    // The data PDU is acknowledged by the next packet.
    let _e = link_rx_fast(var l, t_hdr(0, 0, 0))
    test.assert(l.acked)
    let _f = t_slow(var l, 1, 0)
    test.assert_eq(l.completed, 1)
    test.assert(link_owes(var l, EV_COMPLETED))
    test.assert_eq(link_take_completed(var l), 1)
    test.assert(not link_owes(var l, EV_COMPLETED))
    test.assert_eq(link_take_completed(var l), 0)

@test
fn test_received_data_goes_to_the_host_and_empty_pdus_do_not()
    var l = t_link()
    var d = t_data(2, 6)
    test.assert_eq(t_packet(var l, var d, 0, 0, 0), RX_TO_HOST)
    var c = t_data(1, 3)
    test.assert_eq(t_packet(var l, var c, 1, 0, 0), RX_TO_HOST)
    var e = t_data(1, 0)
    test.assert_eq(t_packet(var l, var e, 0, 0, 0), RX_NOTHING)
    var z = t_data(0, 4)
    test.assert_eq(t_packet(var l, var z, 1, 0, 0), RX_NOTHING)
    // A resent PDU is not delivered twice.
    var again = t_data(2, 6)
    test.assert_eq(t_packet(var l, var again, 1, 0, 0), RX_NOTHING)

@test
fn test_acl_queue_takes_three_fragments_behind_the_next_pdu_and_checks_them()
    var l = t_link()
    // The first goes straight to `nxt`; three more fit the Host's buffers.
    test.assert(t_queue(var l, true, 27))
    test.assert(t_queue(var l, false, 1))
    test.assert(t_queue(var l, true, 2))
    test.assert(t_queue(var l, true, 2))
    test.assert(not t_queue(var l, true, 2))
    var m = t_link()
    test.assert(t_queue(var m, true, 28))
    var big = t_link()
    test.assert(t_queue(var big, true, 251))
    test.assert(not t_queue(var big, true, 252))
    test.assert(t_queue(var m, false, 0))
    // Not on a link that is not live, nor on one that is ending.
    var n = link_new()
    test.assert(not t_queue(var n, true, 2))
    link_close(var m, 0x08)
    test.assert(not t_queue(var m, true, 2))

@test
fn test_queued_data_reaches_the_flight_in_order_with_its_llid()
    var l = t_link()
    test.assert(t_queue(var l, true, 2))
    test.assert(t_queue(var l, false, 3))
    test.assert_eq(l.nxt_kind, K_ACL)
    test.assert_eq(ll_data.dpdu_llid(var l.nxt), ll_data.LLID_START)
    let _a = link_rx_fast(var l, t_hdr(0, 0, 0))
    let _b = t_slow(var l, 0, 0)
    let _c = link_rx_fast(var l, t_hdr(1, 1, 0))
    let _d = t_slow(var l, 1, 0)
    test.assert_eq(ll_data.dpdu_len(var l.cur), 2)
    test.assert_eq(l.nxt_kind, K_ACL)
    test.assert_eq(ll_data.dpdu_llid(var l.nxt), ll_data.LLID_CONTINUE)
    test.assert_eq(ll_data.dpdu_len(var l.nxt), 3)
    test.assert_eq(l.nxt_md, 0)

@test
fn test_ll_control_goes_before_queued_acl_data()
    var l = t_link()
    test.assert(t_queue(var l, true, 2))
    test.assert(t_queue(var l, false, 3))
    test.assert_eq(l.nxt_kind, K_ACL)
    // The request is queued while one fragment is next and one waits.
    test.assert_eq(link_read_features(var l), 0)
    test.assert_eq(l.nxt_kind, K_ACL)
    let _a = link_rx_fast(var l, t_hdr(0, 0, 0))
    let _b = t_slow(var l, 0, 0)
    let _c = link_rx_fast(var l, t_hdr(1, 1, 0))
    let _d = t_slow(var l, 1, 0)
    // The first fragment is in flight; the request takes the place before the second.
    test.assert_eq(l.cur_kind, K_ACL)
    test.assert_eq(l.nxt_kind, K_CTRL)
    test.assert_eq(ll_data.dpdu_opcode(var l.nxt), ll_data.OP_PERIPHERAL_FEATURE_REQ)
    test.assert_eq(l.txq_count, 1)
    test.assert_eq(l.nxt_md, 1)

@test
fn test_unknown_opcode_is_answered_with_unknown_response()
    var l = t_link()
    var p = t_ctrl(0x1A, [1, 2, 3])
    let _r = t_packet(var l, var p, 0, 0, 0)
    test.assert_eq(l.nxt_kind, K_CTRL)
    test.assert_eq(ll_data.dpdu_opcode(var l.nxt), ll_data.OP_UNKNOWN_RSP)
    test.assert_eq(ll_data.dpdu_byte(var l.nxt, 1), 0x1A)
    // So is an opcode this end knows only as the Central's (it is the
    // Peripheral).
    var m = t_link()
    var q = t_ctrl(ll_data.OP_PERIPHERAL_FEATURE_REQ, [0, 0, 0, 0, 0, 0, 0, 0])
    let _s = t_packet(var m, var q, 0, 0, 0)
    test.assert_eq(ll_data.dpdu_opcode(var m.nxt), ll_data.OP_UNKNOWN_RSP)
    test.assert_eq(ll_data.dpdu_byte(var m.nxt, 1), 0x0E)

@test
fn test_a_control_pdu_of_the_wrong_length_is_ignored()
    var l = t_link()
    var p = t_ctrl(ll_data.OP_PING_REQ, [1])
    let _r = t_packet(var l, var p, 0, 0, 0)
    test.assert_eq(l.nxt_kind, K_EMPTY)
    test.assert_eq(l.cq_count, 0)

@test
fn test_ping_is_answered_and_its_response_counted()
    var l = t_link()
    var p = t_ctrl(ll_data.OP_PING_REQ, [])
    let _r = t_packet(var l, var p, 0, 0, 0)
    test.assert_eq(ll_data.dpdu_opcode(var l.nxt), ll_data.OP_PING_RSP)
    var q = t_ctrl(ll_data.OP_PING_RSP, [])
    let _s = t_packet(var l, var q, 1, 0, 0)
    test.assert_eq(l.ping_rsps, 1)

@test
fn test_a_periodic_sync_ind_is_left_to_the_controller_in_a_build_with_the_transfer_and_unknown_to_one_without()
    var zeros: [Int] = []
    for _ in 0..34
        list.push(zeros, 0)
    var l = t_link()
    var p = t_ctrl(ll_data.OP_PERIODIC_SYNC_IND, zeros)
    let _r = t_packet(var l, var p, 0, 0, 0)
    if (ctl_limits.features_octet3() & FEAT3_PAST) != 0
        test.assert(l.ctl_in)
    else
        test.assert(not l.ctl_in)
        test.assert_eq(ll_data.dpdu_opcode(var l.nxt), ll_data.OP_UNKNOWN_RSP)
        test.assert_eq(ll_data.dpdu_byte(var l.nxt, 1), ll_data.OP_PERIODIC_SYNC_IND)
    // A PDU with another length is none of the procedure's, whatever the build.
    var m = t_link()
    var short: [Int] = []
    for _ in 0..33
        list.push(short, 0)
    var q = t_ctrl(ll_data.OP_PERIODIC_SYNC_IND, short)
    let _s = t_packet(var m, var q, 0, 0, 0)
    test.assert(not m.ctl_in)

@test
fn test_feature_request_is_answered_with_the_common_features()
    var l = t_link()
    var p = t_ctrl(ll_data.OP_FEATURE_REQ, [0x1F, 1, 2, 3, 4, 5, 6, 7])
    let _r = t_packet(var l, var p, 0, 0, 0)
    test.assert(l.have_feat)
    test.assert_eq(l.peer_feat[0] as Int, 0x1F)
    test.assert_eq(l.peer_feat[7] as Int, 7)
    test.assert_eq(ll_data.dpdu_opcode(var l.nxt), ll_data.OP_FEATURE_RSP)
    // Octet 0 is the AND of the two ends' octet 0, the rest this end's.
    test.assert_eq(ll_data.dpdu_byte(var l.nxt, 1), 0x1F)
    test.assert_eq(ll_data.dpdu_byte(var l.nxt, 2), ctl_limits.features_octet1())
    test.assert_eq(ll_data.dpdu_byte(var l.nxt, 3), FEATURES_OCTET2)
    test.assert_eq(ll_data.dpdu_byte(var l.nxt, 4), ctl_limits.features_octet3())
    test.assert_eq(ll_data.dpdu_byte(var l.nxt, 5), ctl_limits.features_octet4())
    var m = t_link()
    var q = t_ctrl(ll_data.OP_FEATURE_REQ, [0x80, 0, 0, 0, 0, 0, 0, 0])
    let _s = t_packet(var m, var q, 0, 0, 0)
    test.assert_eq(ll_data.dpdu_byte(var m.nxt, 1), 0)

@test
fn test_read_remote_features_runs_the_peripheral_initiated_procedure()
    var l = t_link()
    test.assert_eq(link_read_features(var l), 0)
    test.assert_eq(l.proc, PROC_FEATURES)
    test.assert_eq(ll_data.dpdu_opcode(var l.nxt), ll_data.OP_PERIPHERAL_FEATURE_REQ)
    test.assert_eq(ll_data.dpdu_byte(var l.nxt, 1), FEATURES_OCTET0)
    // One procedure at a time.
    test.assert_eq(link_read_features(var l), STATUS_COMMAND_DISALLOWED)
    test.assert_eq(link_read_version(var l), STATUS_COMMAND_DISALLOWED)
    var r = t_ctrl(ll_data.OP_FEATURE_RSP, [0x08, 9, 8, 7, 6, 5, 4, 3])
    let _x = t_packet(var l, var r, 0, 0, 0)
    test.assert_eq(l.proc, PROC_NONE)
    test.assert(link_owes(var l, EV_FEATURES))
    test.assert_eq(l.feat_status, 0)
    test.assert_eq(l.peer_feat[0] as Int, 8)
    // The set is known now: a second read answers at once.
    link_sent(var l, EV_FEATURES)
    test.assert_eq(link_read_features(var l), 0)
    test.assert(link_owes(var l, EV_FEATURES))
    test.assert_eq(l.proc, PROC_NONE)

@test
fn test_a_central_that_does_not_know_the_features_request_is_reported()
    var l = t_link()
    test.assert_eq(link_read_features(var l), 0)
    var r = t_ctrl(ll_data.OP_UNKNOWN_RSP, [ll_data.OP_PERIPHERAL_FEATURE_REQ])
    let _x = t_packet(var l, var r, 0, 0, 0)
    test.assert_eq(l.proc, PROC_NONE)
    test.assert_eq(l.feat_status, STATUS_UNSUPPORTED_REMOTE)
    test.assert(link_owes(var l, EV_FEATURES))
    // An unknown response to something else, or with no procedure, is ignored.
    var m = t_link()
    var s = t_ctrl(ll_data.OP_UNKNOWN_RSP, [ll_data.OP_PERIPHERAL_FEATURE_REQ])
    let _y = t_packet(var m, var s, 0, 0, 0)
    test.assert(not link_owes(var m, EV_FEATURES))
    test.assert_eq(link_read_features(var m), 0)
    var u = t_ctrl(ll_data.OP_UNKNOWN_RSP, [0x20])
    let _z = t_packet(var m, var u, 1, 0, 0)
    test.assert_eq(m.proc, PROC_FEATURES)

@test
fn test_a_feature_response_nobody_asked_for_is_ignored()
    var l = t_link()
    var r = t_ctrl(ll_data.OP_FEATURE_RSP, [0x08, 0, 0, 0, 0, 0, 0, 0])
    let _x = t_packet(var l, var r, 0, 0, 0)
    test.assert(not l.have_feat)
    test.assert(not link_owes(var l, EV_FEATURES))

@test
fn test_version_exchange_sends_one_version_and_reads_the_peers()
    var l = t_link()
    // The peer begins: this end answers with its own, once.
    var v = t_ctrl(ll_data.OP_VERSION_IND, [0x0E, 0x59, 0x00, 0x34, 0x12])
    let _a = t_packet(var l, var v, 0, 0, 0)
    test.assert(l.ver_rcvd)
    test.assert(l.ver_sent)
    test.assert_eq(l.peer_ver, 0x0E)
    test.assert_eq(l.peer_company, 0x59)
    test.assert_eq(l.peer_sub, 0x1234)
    test.assert_eq(ll_data.dpdu_opcode(var l.nxt), ll_data.OP_VERSION_IND)
    test.assert_eq(ll_data.dpdu_byte(var l.nxt, 1), LL_VERSION)
    test.assert_eq(ll_data.dpdu_u16(var l.nxt, 2), LL_COMPANY)
    test.assert_eq(ll_data.dpdu_u16(var l.nxt, 4), LL_SUBVERSION)
    // A second one is ignored.
    var w = t_ctrl(ll_data.OP_VERSION_IND, [0x01, 0x01, 0x00, 0x01, 0x00])
    let _b = t_packet(var l, var w, 1, 0, 0)
    test.assert_eq(l.peer_ver, 0x0E)
    test.assert_eq(l.cq_count, 0)
    // The Host asks now: the answer is at once.
    test.assert_eq(link_read_version(var l), 0)
    test.assert(link_owes(var l, EV_VERSION))
    test.assert_eq(l.ver_status, 0)

@test
fn test_read_remote_version_sends_ours_and_waits_for_the_peers()
    var l = t_link()
    test.assert_eq(link_read_version(var l), 0)
    test.assert_eq(l.proc, PROC_VERSION)
    test.assert(l.ver_sent)
    test.assert_eq(ll_data.dpdu_opcode(var l.nxt), ll_data.OP_VERSION_IND)
    var v = t_ctrl(ll_data.OP_VERSION_IND, [0x0E, 0x59, 0x00, 0x34, 0x12])
    let _a = t_packet(var l, var v, 0, 0, 0)
    test.assert_eq(l.proc, PROC_NONE)
    test.assert(link_owes(var l, EV_VERSION))
    // Ours went once only: nothing more is queued.
    test.assert_eq(l.cq_count, 0)

@test
fn test_read_remote_version_waits_when_ours_is_already_out()
    var l = t_link()
    test.assert_eq(link_read_version(var l), 0)
    t_proc(var l, PROC_NONE)
    // Ours is sent, theirs not here: the procedure waits again without a second PDU.
    test.assert_eq(link_read_version(var l), 0)
    test.assert_eq(l.proc, PROC_VERSION)
    test.assert_eq(l.cq_count, 0)

@test
fn test_host_commands_refuse_a_link_that_is_not_there()
    var l = link_new()
    test.assert_eq(link_disconnect(var l, 0x13), STATUS_UNKNOWN_CONNECTION)
    test.assert_eq(link_read_version(var l), STATUS_UNKNOWN_CONNECTION)
    test.assert_eq(link_read_features(var l), STATUS_UNKNOWN_CONNECTION)
    var m = t_link()
    link_close(var m, 0x08)
    test.assert_eq(link_read_version(var m), STATUS_UNKNOWN_CONNECTION)
    test.assert_eq(link_read_features(var m), STATUS_UNKNOWN_CONNECTION)
    test.assert_eq(link_disconnect(var m, 0x13), STATUS_COMMAND_DISALLOWED)

@test
fn test_host_commands_fail_when_the_control_queue_is_full()
    var l = t_link()
    for _ in 0..CTRL_SLOTS
        var p = t_ctrl(ll_data.OP_PING_RSP, [])
        test.assert(ctrl_queue(var l, var p))
    var q = t_ctrl(ll_data.OP_PING_RSP, [])
    test.assert(not ctrl_queue(var l, var q))
    test.assert_eq(link_disconnect(var l, 0x13), STATUS_COMMAND_DISALLOWED)
    test.assert_eq(link_read_version(var l), STATUS_COMMAND_DISALLOWED)
    test.assert_eq(link_read_features(var l), STATUS_COMMAND_DISALLOWED)
    test.assert(not l.term_sent)
    test.assert_eq(l.proc, PROC_NONE)

@test
fn test_disconnect_sends_terminate_and_ends_when_it_is_acknowledged()
    var l = t_link()
    test.assert_eq(link_disconnect(var l, 0x13), 0)
    test.assert_eq(link_disconnect(var l, 0x13), STATUS_COMMAND_DISALLOWED)
    test.assert_eq(l.nxt_kind, K_CTRL)
    test.assert_eq(ll_data.dpdu_opcode(var l.nxt), ll_data.OP_TERMINATE_IND)
    test.assert_eq(ll_data.dpdu_byte(var l.nxt, 1), 0x13)
    let _a = link_rx_fast(var l, t_hdr(0, 0, 0))
    let _b = t_slow(var l, 1, 0)
    test.assert(not l.closing)
    // The empty PDU in flight is acknowledged: the terminate goes out.
    let _c = link_rx_fast(var l, t_hdr(1, 1, 0))
    let _d = t_slow(var l, 1, 0)
    test.assert(not l.closing)
    test.assert_eq(l.cur_kind, K_CTRL)
    // And is acknowledged.
    let _e = link_rx_fast(var l, t_hdr(0, 0, 0))
    let _f = t_slow(var l, 1, 0)
    test.assert(l.closing)
    test.assert_eq(l.reason, REASON_LOCAL_HOST)

@test
fn test_terminate_from_the_central_ends_the_connection_with_its_reason()
    var l = t_link()
    var p = t_ctrl(ll_data.OP_TERMINATE_IND, [0x13])
    let _r = t_packet(var l, var p, 0, 0, 0)
    test.assert(l.closing)
    test.assert_eq(l.reason, 0x13)
    // The packet was acknowledged all the same.
    test.assert_eq(l.nesn, 1)

@test
fn test_release_leaves_the_disconnection_to_tell_the_host()
    var l = t_link()
    link_close(var l, 0x08)
    test.assert(link_ended(var l))
    link_released(var l)
    test.assert(not link_live(var l))
    test.assert(not link_ended(var l))
    test.assert(link_owes(var l, EV_DISCONNECTED))
    test.assert(not link_owes(var l, EV_CONNECTED))
    link_sent(var l, EV_DISCONNECTED)
    test.assert_eq(l.owed, 0)
    test.assert_eq(l.reason, 0x08)

@test
fn test_connection_update_changes_the_parameters_at_its_instant()
    var l = t_link()
    // Event 0 heard at 3100.
    let _c0 = link_event_begin(var l)
    link_note_rx(var l, 3100, true)
    link_event_done(var l, 3600)
    // Interval 24 (30 ms), latency 2, timeout 300, window 3 units at offset 4,
    // instant 6.
    var u = t_ctrl(ll_data.OP_CONNECTION_UPDATE_IND, [3, 4, 0, 24, 0, 2, 0, 44, 1, 6, 0])
    let _r = t_packet(var l, var u, 0, 0, 0)
    test.assert(l.upd_pending)
    test.assert_eq(l.upd_instant, 6)
    // Events 1 to 4 run on the old interval.
    for _ in 1..5
        let _ch = link_event_begin(var l)
        test.assert_eq(l.interval, 6)
        link_note_rx(var l, l.due, true)
        link_event_done(var l, l.due + 500)
    // The next event is 5, due one old interval later; the instant is 6.
    let _c5 = link_event_begin(var l)
    link_note_rx(var l, l.due, true)
    let a5 = l.anchor
    link_event_done(var l, a5 + 500)
    // Event 6 is the instant: its window starts one old interval and the offset
    // after event 5's anchor and is 3 units long.
    test.assert_eq(l.due, a5 + 7500 + 4 * 1250)
    test.assert_eq(l.win_len, 3 * 1250)
    test.assert_eq(link_listen_end(var l) - link_listen_start(var l), 3 * 1250 + 2 * widening(var l))
    let due6 = l.due
    let _c6 = link_event_begin(var l)
    test.assert_eq(l.interval, 24)
    test.assert_eq(l.latency, 2)
    test.assert_eq(l.timeout, 300)
    test.assert(not l.upd_pending)
    test.assert(link_owes(var l, EV_UPDATED))
    // The supervision timer restarts at the instant.
    test.assert_eq(l.last_rx, due6)
    link_note_rx(var l, due6 + 1000, true)
    link_event_done(var l, due6 + 1500)
    // The next anchor is one new interval after the first of the instant.
    test.assert_eq(l.due, due6 + 1000 + 30000)
    test.assert_eq(l.win_len, 0)

@test
fn test_a_missed_instant_event_keeps_the_new_window_open()
    var l = t_link()
    var u = t_ctrl(ll_data.OP_CONNECTION_UPDATE_IND, [2, 0, 0, 24, 0, 0, 0, 200, 0, 1, 0])
    // Instant 1 is the next event, and the PDU arrived in event 0.
    let _c0 = link_event_begin(var l)
    link_note_rx(var l, 3100, true)
    let _r = t_packet(var l, var u, 0, 0, 0)
    link_event_done(var l, 3600)
    test.assert_eq(l.win_len, 2 * 1250)
    let d1 = l.due
    let _c1 = link_event_begin(var l)
    link_event_done(var l, d1 + 5000)
    // The instant event heard nothing: the next window is a new interval after
    // the start of this one, and still as wide.
    test.assert_eq(l.due, d1 + 30000)
    test.assert_eq(l.win_len, 2 * 1250)

@test
fn test_connection_update_with_bad_values_or_a_passed_instant()
    var l = t_link()
    var bad_interval = t_ctrl(ll_data.OP_CONNECTION_UPDATE_IND, [2, 0, 0, 5, 0, 0, 0, 200, 0, 9, 0])
    let _a = t_packet(var l, var bad_interval, 0, 0, 0)
    test.assert(not l.upd_pending)
    var bad_latency = t_ctrl(ll_data.OP_CONNECTION_UPDATE_IND, [2, 0, 0, 24, 0, 0xF4, 1, 200, 0, 9, 0])
    let _b = t_packet(var l, var bad_latency, 1, 0, 0)
    test.assert(not l.upd_pending)
    var bad_timeout = t_ctrl(ll_data.OP_CONNECTION_UPDATE_IND, [2, 0, 0, 24, 0, 0, 0, 9, 0, 9, 0])
    let _c = t_packet(var l, var bad_timeout, 0, 0, 0)
    test.assert(not l.upd_pending)
    var short_timeout = t_ctrl(ll_data.OP_CONNECTION_UPDATE_IND, [2, 0, 0, 24, 0, 2, 0, 18, 0, 9, 0])
    let _d = t_packet(var l, var short_timeout, 1, 0, 0)
    test.assert(not l.upd_pending)
    var too_big = t_ctrl(ll_data.OP_CONNECTION_UPDATE_IND, [2, 0, 0, 0x81, 0x0C, 0, 0, 200, 0, 9, 0])
    let _e = t_packet(var l, var too_big, 0, 0, 0)
    test.assert(not l.upd_pending)
    test.assert(not l.closing)
    // The instant is this event, or in the past: Instant Passed.
    var now_event = t_ctrl(ll_data.OP_CONNECTION_UPDATE_IND, [2, 0, 0, 24, 0, 0, 0, 200, 0, 0, 0])
    let _f = t_packet(var l, var now_event, 1, 0, 0)
    test.assert(l.closing)
    test.assert_eq(l.reason, REASON_INSTANT_PASSED)
    var m = t_link()
    t_ev_count(var m, 10)
    var past = t_ctrl(ll_data.OP_CONNECTION_UPDATE_IND, [2, 0, 0, 24, 0, 0, 0, 200, 0, 4, 0])
    let _g = t_packet(var m, var past, 0, 0, 0)
    test.assert_eq(m.reason, REASON_INSTANT_PASSED)
    // 32767 ahead is still in the future, 32768 is the past.
    var n = t_link()
    var far = t_ctrl(ll_data.OP_CONNECTION_UPDATE_IND, [2, 0, 0, 24, 0, 0, 0, 200, 0, 0xFF, 0x7F])
    let _h = t_packet(var n, var far, 0, 0, 0)
    test.assert(n.upd_pending)
    var o = t_link()
    var gone = t_ctrl(ll_data.OP_CONNECTION_UPDATE_IND, [2, 0, 0, 24, 0, 0, 0, 200, 0, 0x00, 0x80])
    let _i = t_packet(var o, var gone, 0, 0, 0)
    test.assert_eq(o.reason, REASON_INSTANT_PASSED)

@test
fn test_channel_map_update_takes_effect_at_its_instant()
    var l = t_link()
    // Channels 0 to 4 only, instant 3.
    var m = t_ctrl(ll_data.OP_CHANNEL_MAP_IND, [0x1F, 0, 0, 0, 0, 3, 0])
    let _r = t_packet(var l, var m, 0, 0, 0)
    test.assert(l.chm_pending)
    test.assert_eq(l.chm_instant, 3)
    test.assert_eq(l.chm_map, 0x1F)
    // Events 0 to 2 use all channels: 7, 14, 21.
    test.assert_eq(link_event_begin(var l), 7)
    link_event_done(var l, 3000)
    test.assert_eq(link_event_begin(var l), 14)
    link_event_done(var l, 3000)
    test.assert_eq(link_event_begin(var l), 21)
    link_event_done(var l, 3000)
    test.assert_eq(l.n_used, 37)
    // Event 3: unmapped 28, remapped into the five channels: 28 % 5 = 3.
    test.assert_eq(link_event_begin(var l), 3)
    test.assert_eq(l.n_used, 5)
    test.assert(not l.chm_pending)

@test
fn test_channel_map_update_with_a_bad_map_or_instant()
    var l = t_link()
    var one = t_ctrl(ll_data.OP_CHANNEL_MAP_IND, [0x01, 0, 0, 0, 0, 3, 0])
    let _a = t_packet(var l, var one, 0, 0, 0)
    test.assert(not l.chm_pending)
    var high = t_ctrl(ll_data.OP_CHANNEL_MAP_IND, [0x03, 0, 0, 0, 0x20, 3, 0])
    let _b = t_packet(var l, var high, 1, 0, 0)
    test.assert(not l.chm_pending)
    test.assert(not l.closing)
    var late = t_ctrl(ll_data.OP_CHANNEL_MAP_IND, [0x03, 0, 0, 0, 0, 0, 0])
    let _c = t_packet(var l, var late, 0, 0, 0)
    test.assert(l.closing)
    test.assert_eq(l.reason, REASON_INSTANT_PASSED)

@test
fn test_catch_up_skips_the_events_whose_windows_have_closed()
    var l = t_link()
    test.assert(not link_event_late(var l, 2000))
    test.assert_eq(link_catch_up(var l, 2000), 0)
    // 40 ms after the first window: the events at 2250, 9750, 17250, 24750
    // and 32250 are over, the one due at 39750 is not.
    test.assert_eq(link_catch_up(var l, 40000), 5)
    test.assert_eq(l.ev_count, 5)
    test.assert_eq(l.due, 2250 + 5 * 7500)
    test.assert(not link_event_late(var l, 40000))
    // A link that has ended skips nothing.
    link_close(var l, 0x08)
    test.assert(not link_event_late(var l, 4000000))
    var m = link_new()
    test.assert(not link_event_late(var m, 4000000))

// On a subrated link the events the grid leaves unused are not late events: the catch-up misses the used ones (0 and 4 of a factor of 4) and the schedule
// moves to the next used event.
@test
fn test_catch_up_follows_the_subrate_grid()
    if not ctl_limits.sub_on()
        return
    var l = t_link()
    t_alive(var l, 3200, 1000 + 70 * 7500)
    sub_set(var l, 4, 0, 0, 0, 3200)
    test.assert_eq(link_catch_up(var l, 40000), 2)
    test.assert_eq(l.ev_count, 8)
    test.assert_eq(l.due, 2250 + 8 * 7500)
    test.assert(not link_event_late(var l, 40000))

@test
fn test_catch_up_stops_at_its_limit()
    var l = t_link()
    t_alive(var l, 3200, 1000 + 70 * 7500)
    let n = link_catch_up(var l, 1000 + 70 * 7500)
    test.assert_eq(n, CATCH_UP_MAX)

@test
fn test_room_needs_pool_slots_and_control_queue_space()
    var l = t_link()
    link_set_room(var l, 4)
    test.assert(l.room)
    link_set_room(var l, 2)
    test.assert(l.room)
    link_set_room(var l, 1)
    test.assert(not l.room)
    link_set_room(var l, 0)
    test.assert(not l.room)

@test
fn test_reset_clears_everything_the_connection_held()
    var l = t_link()
    test.assert(t_queue(var l, true, 3))
    test.assert_eq(link_disconnect(var l, 0x13), 0)
    link_reset(var l)
    test.assert(not link_live(var l))
    test.assert_eq(l.owed, 0)
    test.assert_eq(l.txq_count, 0)
    test.assert_eq(l.cq_count, 0)
    test.assert(not l.term_sent)
    test.assert_eq(l.nxt_kind, K_EMPTY)
    test.assert_eq(l.proc, PROC_NONE)

// ── The Central role ────────────────────────────────────────────────

// A link opened as Central on the usual request, the CONNECT_IND having ended at
// time 1000: the initiator is the random address 0x40..0x45, the advertiser the
// public address 0x10..0x15.
fn t_central() -> Link
    var l = link_new()
    var p = t_usual()
    link_open_central(var l, 2, var p, 1000)
    l

@test
fn test_open_central_takes_the_parameters_and_fixes_the_first_anchor()
    var l = t_central()
    test.assert(link_live(var l))
    test.assert(link_is_central(var l))
    test.assert_eq(l.handle, 2)
    test.assert_eq(l.aa, 0x50655A12)
    test.assert_eq(l.crc_init, 0x332211)
    test.assert_eq(l.interval, 6)
    test.assert_eq(l.n_used, 37)
    test.assert_eq(l.hop, 7)
    // The initiator's address is own, the advertiser's the peer's.
    test.assert_eq(l.own_type, 1)
    test.assert_eq(l.own[0] as Int, 0x40)
    test.assert_eq(l.peer_type, 0)
    test.assert_eq(l.peer[0] as Int, 0x10)
    test.assert_eq(l.peer[5] as Int, 0x15)
    // The anchor is the start of the transmit window, and nothing is owed yet.
    test.assert_eq(l.due, 1000 + 1250)
    test.assert_eq(l.win_len, 0)
    test.assert_eq(l.owed, 0)
    var q = t_connect(24, 0, 400, 2, 3, 0x1FFFFFFFFF, 7, 0)
    link_open_central(var l, 1, var q, 5000)
    test.assert_eq(l.due, 5000 + 1250 + 3 * 1250)
    // A link opened as Peripheral is not a Central, and a reset clears the role.
    var m = t_link()
    test.assert(not link_is_central(var m))
    link_reset(var l)
    test.assert(not link_is_central(var l))

@test
fn test_a_central_listens_at_a_point_without_widening()
    var l = t_central()
    test.assert_eq(widening(var l), 0)
    test.assert_eq(link_listen_start(var l), l.due)
    test.assert_eq(link_listen_end(var l), l.due)
    t_due(var l, l.t_ref + 20000000)
    test.assert_eq(widening(var l), 0)

@test
fn test_a_central_event_is_anchored_at_the_time_it_sends()
    var l = t_central()
    test.assert_eq(link_event_begin(var l), 7)
    test.assert(l.ev_anchor)
    test.assert_eq(l.anchor, 2250)
    // The Peripheral's packet does not move the anchor.
    link_note_rx(var l, 2250 + 500, true)
    test.assert_eq(l.anchor, 2250)
    link_event_done(var l, 3500)
    test.assert_eq(l.due, 2250 + 7500)
    test.assert_eq(l.t_ref, 2250)
    // An event the Peripheral does not answer keeps the schedule as well.
    let _c = link_event_begin(var l)
    link_event_done(var l, 10000)
    test.assert_eq(l.due, 2250 + 15000)
    test.assert_eq(l.ev_count, 2)

@test
fn test_a_central_connection_is_made_by_the_first_good_packet()
    var l = t_central()
    let _c = link_event_begin(var l)
    // A packet with a CRC error does not make it, nor does it count as synchronised.
    link_note_rx(var l, 2500, false)
    test.assert(not l.synced)
    test.assert_eq(l.owed, 0)
    test.assert_eq(l.bad_run, 1)
    link_note_rx(var l, 2600, true)
    test.assert(l.synced)
    test.assert(link_owes(var l, EV_CONNECTED))
    test.assert_eq(l.conn_status, 0)
    link_sent(var l, EV_CONNECTED)
    // A second good packet owes nothing more.
    link_note_rx(var l, 2700, true)
    test.assert_eq(l.owed, 0)
    test.assert_eq(l.last_rx, 2700)

@test
fn test_a_central_ends_the_event_at_a_packet_with_a_crc_error()
    var l = t_central()
    test.assert(not link_answers_bad(var l))
    var p = t_link()
    test.assert(link_answers_bad(var p))

@test
fn test_a_central_connection_that_hears_nothing_fails_to_establish_and_reports_it()
    var l = t_central()
    var n = 0
    while not l.closing and n < 40
        let _c = link_event_begin(var l)
        link_event_done(var l, l.due + 7500)
        n = n + 1
    test.assert(l.closing)
    test.assert_eq(l.reason, REASON_FAILED_TO_ESTABLISH)
    test.assert(n >= 6)
    test.assert(n <= 9)
    link_released(var l)
    // The Host is owed the LE Connection Complete event with the status, not a
    // Disconnection Complete.
    test.assert(link_owes(var l, EV_CONNECTED))
    test.assert(not link_owes(var l, EV_DISCONNECTED))
    test.assert_eq(l.conn_status, REASON_FAILED_TO_ESTABLISH)
    // A Central that was made and then lost reports Disconnection Complete.
    var m = t_central()
    let _d = link_event_begin(var m)
    link_note_rx(var m, 2300, true)
    link_sent(var m, EV_CONNECTED)
    link_event_done(var m, 3000)
    link_close(var m, REASON_TIMEOUT)
    link_released(var m)
    test.assert(link_owes(var m, EV_DISCONNECTED))
    test.assert(not link_owes(var m, EV_CONNECTED))

@test
fn test_a_central_supervises_from_the_last_good_packet()
    var l = t_central()
    let _c = link_event_begin(var l)
    link_note_rx(var l, 2300, true)
    link_event_done(var l, 3000)
    let _d = link_event_begin(var l)
    link_event_done(var l, 2300 + 2000000)
    test.assert(not l.closing)
    let _e = link_event_begin(var l)
    link_event_done(var l, 2300 + 2000001)
    test.assert(l.closing)
    test.assert_eq(l.reason, REASON_TIMEOUT)

@test
fn test_the_first_header_of_a_central_event_carries_its_sequence_numbers()
    var l = t_central()
    // The empty PDU in flight, SN 0 and NESN 0, no more data.
    test.assert_eq(link_first_header(var l), 1)
    test.assert(t_queue(var l, true, 4))
    // The data waits behind the PDU in flight; the header is still the empty one,
    // but MD says more waits.
    test.assert_eq(link_first_header(var l), 1)
    // The Peripheral acknowledged the empty PDU (NESN 1) and sent a new one (SN 0).
    let _a = link_rx_fast(var l, t_hdr(0, 1, 0))
    test.assert(l.acked)
    var dd = t_data(1, 0)
    let r = link_rx_slow(var l, var dd)
    test.assert_eq(r, RX_NOTHING)
    // The data PDU is in flight, SN 1; the Peripheral's SN 0 was taken, NESN 1.
    test.assert_eq(link_first_header(var l), ll_data.LLID_START | (1 << 2) | (1 << 3))

@test
fn test_a_central_starts_the_feature_exchange_with_the_central_request()
    var l = t_central()
    test.assert_eq(features_request_opcode(var l), ll_data.OP_FEATURE_REQ)
    test.assert_eq(link_read_features(var l), 0)
    test.assert_eq(ll_data.dpdu_opcode(var l.nxt), ll_data.OP_FEATURE_REQ)
    // The Peripheral's answer completes it.
    var rsp = t_ctrl(ll_data.OP_FEATURE_RSP, [0x10, 0, 0, 0, 0, 0, 0, 0])
    let _r = t_packet(var l, var rsp, 0, 0, 0)
    test.assert_eq(l.proc, PROC_NONE)
    test.assert(link_owes(var l, EV_FEATURES))
    test.assert_eq(l.feat_status, STATUS_SUCCESS)
    // A peer that does not know the request answers LL_UNKNOWN_RSP with its opcode.
    var m = t_central()
    test.assert_eq(link_read_features(var m), 0)
    var unk = t_ctrl(ll_data.OP_UNKNOWN_RSP, [ll_data.OP_FEATURE_REQ])
    let _s = t_packet(var m, var unk, 0, 0, 0)
    test.assert_eq(m.feat_status, STATUS_UNSUPPORTED_REMOTE)
    // The Peripheral's request opcode in an answer is not the one this end sent.
    var n = t_central()
    test.assert_eq(link_read_features(var n), 0)
    var other = t_ctrl(ll_data.OP_UNKNOWN_RSP, [ll_data.OP_PERIPHERAL_FEATURE_REQ])
    let _t = t_packet(var n, var other, 0, 0, 0)
    test.assert_eq(n.proc, PROC_FEATURES)

@test
fn test_a_central_answers_the_peripheral_initiated_feature_request()
    var l = t_central()
    var req = t_ctrl(ll_data.OP_PERIPHERAL_FEATURE_REQ, [0x18, 0, 0, 0, 0, 0, 0, 0])
    let _r = t_packet(var l, var req, 0, 0, 0)
    test.assert(l.have_feat)
    test.assert_eq(l.peer_feat[0] as Int, 0x18)
    test.assert_eq(l.nxt_kind, K_CTRL)
    test.assert_eq(ll_data.dpdu_opcode(var l.nxt), ll_data.OP_FEATURE_RSP)
    // The octet the Central answers is the features both ends have.
    test.assert_eq(ll_data.dpdu_byte(var l.nxt, 1), FEATURES_OCTET0 & 0x18)

@test
fn test_a_central_does_not_know_the_updates_and_feature_request_of_a_central()
    var l = t_central()
    var upd = t_ctrl(ll_data.OP_CONNECTION_UPDATE_IND, [2, 2, 0, 24, 0, 0, 0, 0x90, 0x01, 9, 0])
    let _a = t_packet(var l, var upd, 0, 0, 0)
    test.assert_eq(ll_data.dpdu_opcode(var l.nxt), ll_data.OP_UNKNOWN_RSP)
    test.assert_eq(ll_data.dpdu_byte(var l.nxt, 1), 0x00)
    test.assert(not l.upd_pending)
    var m = t_central()
    var map = t_ctrl(ll_data.OP_CHANNEL_MAP_IND, [0xFF, 0xFF, 0xFF, 0xFF, 0x1F, 9, 0])
    let _b = t_packet(var m, var map, 0, 0, 0)
    test.assert_eq(ll_data.dpdu_byte(var m.nxt, 1), 0x01)
    test.assert(not m.chm_pending)
    var n = t_central()
    var fr = t_ctrl(ll_data.OP_FEATURE_REQ, [0, 0, 0, 0, 0, 0, 0, 0])
    let _c = t_packet(var n, var fr, 0, 0, 0)
    test.assert_eq(ll_data.dpdu_byte(var n.nxt, 1), 0x08)

@test
fn test_a_central_takes_termination_and_version_like_a_peripheral()
    var l = t_central()
    var term = t_ctrl(ll_data.OP_TERMINATE_IND, [0x13])
    let _a = t_packet(var l, var term, 0, 0, 0)
    test.assert(l.closing)
    test.assert_eq(l.reason, 0x13)
    var m = t_central()
    test.assert_eq(link_read_version(var m), 0)
    var ver = t_ctrl(ll_data.OP_VERSION_IND, [0x0E, 0x59, 0x00, 0x34, 0x12])
    let _b = t_packet(var m, var ver, 0, 0, 0)
    test.assert(link_owes(var m, EV_VERSION))
    test.assert_eq(m.peer_ver, 0x0E)

// ── The LL Control procedures of Section 5 ──────────────────────────

fn t_chsel(var p: Pdu)
    p.b[0] = ((p.b[0] as Int) | ll_pdu.CHSEL) as u8

fn t_have_features(var l: Link, b0: Int)
    l.have_feat = true
    l.peer_feat[0] = b0 as u8

fn t_fill_cq(var l: Link)
    for _ in 0..CTRL_SLOTS
        var p = ll_pdu.pdu_new()
        ll_data.ctrl_begin(var p, ll_data.OP_PING_RSP)
        ll_data.dpdu_finish(var p)
        let _a = ctrl_queue(var l, var p)

fn t_pop_cq(var l: Link)
    var scratch = ll_pdu.pdu_new()
    slot_get_cq(var l, l.cq_head, var scratch)
    l.cq_head = (l.cq_head + 1) % CTRL_SLOTS
    l.cq_count = l.cq_count - 1

fn t_rq_wait(var l: Link, v: Bool)
    l.rq_wait = v

fn t_upd_pending(var l: Link)
    l.upd_pending = true

// LL_CONNECTION_PARAM_REQ or _RSP from the peer.
fn t_param_pdu(op: Int, i_min: Int, i_max: Int, latency: Int, timeout: Int, period: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_data.ctrl_param(var p, op, i_min, i_max, latency, timeout, period, 0)
    p

fn t_set_phase(var l: Link, ping_ok: Bool, pinged: Bool)
    l.ping_ok = ping_ok
    l.pinged = pinged

fn t_central_with(var l: Link, min_used: Int)
    l.min_used = min_used

// The PDU the link sends next, the opcode and one payload octet.
fn t_next_op(var l: Link) -> Int
    ll_data.dpdu_opcode(var l.nxt)

fn t_next_byte(var l: Link, i: Int) -> Int
    ll_data.dpdu_byte(var l.nxt, i)

@test
fn test_a_connect_ind_with_chsel_may_carry_any_hop_and_selects_algorithm_2()
    var p = t_connect(6, 0, 200, 2, 0, 0x1FFFFFFFFF, 0, 0)
    test.assert(not connect_valid(var p))
    t_chsel(var p)
    test.assert(connect_valid(var p))
    var l = link_new()
    link_open(var l, 1, var p, 1000)
    test.assert(l.csa2)
    test.assert_eq(l.chan_id, (0x50655A12 >>> 16) ^ (0x50655A12 & 0xFFFF))
    var q = t_central()
    test.assert(not q.csa2)
    var r = t_usual()
    t_chsel(var r)
    link_open_central(var q, 1, var r, 1000)
    test.assert(q.csa2)
    // A reset forgets it.
    link_reset(var q)
    test.assert(not q.csa2)

@test
fn test_algorithm_2_follows_the_sample_data_of_the_specification()
    // Sample data 1: 37 used channels.
    let all = 0x1FFFFFFFFF
    test.assert_eq(csa2_prn(0x305F, 0), 56857)
    test.assert_eq(csa2_prn(0x305F, 1), 1685)
    test.assert_eq(csa2_channel(0x305F, 0, all, 37), 25)
    test.assert_eq(csa2_channel(0x305F, 1, all, 37), 20)
    test.assert_eq(csa2_channel(0x305F, 2, all, 37), 6)
    test.assert_eq(csa2_channel(0x305F, 3, all, 37), 21)
    // Sample data 2: 9 used channels, an unused channel remapped.
    let nine = 0x1E00E00600
    test.assert_eq(popcount(nine), 9)
    test.assert_eq(csa2_channel(0x305F, 6, nine, 9), 23)
    test.assert_eq(csa2_channel(0x305F, 7, nine, 9), 9)
    test.assert_eq(csa2_channel(0x305F, 8, nine, 9), 34)
    // Sample data 3: 3 used channels.
    test.assert_eq(csa2_channel(0x305F, 11, 0x106, 3), 1)
    test.assert_eq(csa2_channel(0x305F, 12, 0x106, 3), 2)
    test.assert_eq(csa2_channel(0x305F, 13, 0x106, 3), 2)
    test.assert_eq(reverse_octet(0x01), 0x80)
    test.assert_eq(csa2_permute(0x0102), 0x8040)

@test
fn test_a_link_with_algorithm_2_takes_its_channel_from_the_event_counter()
    var p = t_connect(6, 0, 200, 2, 0, 0x1FFFFFFFFF, 7, 0)
    t_chsel(var p)
    var l = link_new()
    link_open(var l, 1, var p, 1000)
    let id = l.chan_id
    for k in 0..6
        test.assert_eq(link_event_begin(var l), csa2_channel(id, k, l.chmap, l.n_used))
        link_event_done(var l, 2000 + 8000 * k)

@test
fn test_an_unknown_response_ends_the_procedures_that_asked()
    // The Connection Parameters Request: Unsupported Remote Feature, and the peer is
    // remembered as without the procedure.
    var l = t_link()
    test.assert_eq(link_connection_update(var l, 24, 24, 0, 400), STATUS_SUCCESS)
    test.assert_eq(l.proc, PROC_PARAM)
    var u = t_ctrl(ll_data.OP_UNKNOWN_RSP, [ll_data.OP_CONNECTION_PARAM_REQ])
    let _a = t_packet(var l, var u, 0, 0, 0)
    test.assert_eq(l.proc, PROC_NONE)
    test.assert(l.cpr_no)
    test.assert(link_owes(var l, EV_UPDATED))
    test.assert_eq(l.upd_status, STATUS_UNSUPPORTED_REMOTE)
    test.assert_eq(link_connection_update(var l, 24, 24, 0, 400), STATUS_UNSUPPORTED_REMOTE)
    // The ping: the peer is not asked again.
    var m = t_link()
    t_proc(var m, PROC_PING)
    var v = t_ctrl(ll_data.OP_UNKNOWN_RSP, [ll_data.OP_PING_REQ])
    let _b = t_packet(var m, var v, 0, 0, 0)
    test.assert_eq(m.proc, PROC_NONE)
    test.assert(not m.ping_ok)
    // An unknown response to something else leaves a procedure alone.
    var n = t_link()
    t_proc(var n, PROC_PARAM)
    var w = t_ctrl(ll_data.OP_UNKNOWN_RSP, [ll_data.OP_PING_REQ])
    let _c = t_packet(var n, var w, 0, 0, 0)
    test.assert_eq(n.proc, PROC_PARAM)

@test
fn test_a_reject_ends_the_parameter_request_with_its_code()
    var l = t_link()
    test.assert_eq(link_connection_update(var l, 24, 24, 0, 400), STATUS_SUCCESS)
    var r = t_ctrl(ll_data.OP_REJECT_EXT_IND, [ll_data.OP_CONNECTION_PARAM_REQ, 0x20])
    let _a = t_packet(var l, var r, 0, 0, 0)
    test.assert_eq(l.proc, PROC_NONE)
    test.assert_eq(l.upd_status, 0x20)
    test.assert(link_owes(var l, EV_UPDATED))
    // LL_REJECT_IND is the same without the opcode.
    var m = t_link()
    test.assert_eq(link_connection_update(var m, 24, 24, 0, 400), STATUS_SUCCESS)
    var s = t_ctrl(ll_data.OP_REJECT_IND, [0x3B])
    let _b = t_packet(var m, var s, 0, 0, 0)
    test.assert_eq(m.upd_status, 0x3B)
    // A reject of another PDU, or with no request, is ignored.
    var n = t_link()
    test.assert_eq(link_connection_update(var n, 24, 24, 0, 400), STATUS_SUCCESS)
    var o = t_ctrl(ll_data.OP_REJECT_EXT_IND, [0x03, 0x06])
    let _c = t_packet(var n, var o, 0, 0, 0)
    test.assert_eq(n.proc, PROC_PARAM)
    var q = t_link()
    var p = t_ctrl(ll_data.OP_REJECT_EXT_IND, [ll_data.OP_CONNECTION_PARAM_REQ, 0x20])
    let _d = t_packet(var q, var p, 0, 0, 0)
    test.assert(not link_owes(var q, EV_UPDATED))

@test
fn test_a_peer_without_extended_reject_is_refused_with_a_plain_reject()
    var l = t_central()
    t_have_features(var l, 0x02)
    t_upd_pending(var l)
    var r = t_param_pdu(ll_data.OP_CONNECTION_PARAM_REQ, 6, 6, 0, 200, 0)
    let _a = t_packet(var l, var r, 0, 0, 0)
    test.assert_eq(t_next_op(var l), ll_data.OP_REJECT_IND)
    test.assert_eq(t_next_byte(var l, 1), CODE_COLLISION)

@test
fn test_a_peripheral_does_not_know_the_response_to_a_request_it_never_made()
    var l = t_link()
    var r = t_param_pdu(ll_data.OP_CONNECTION_PARAM_RSP, 6, 6, 0, 200, 0)
    let _a = t_packet(var l, var r, 0, 0, 0)
    test.assert_eq(t_next_op(var l), ll_data.OP_UNKNOWN_RSP)
    test.assert_eq(t_next_byte(var l, 1), ll_data.OP_CONNECTION_PARAM_RSP)

@test
fn test_a_request_out_of_range_or_while_the_host_is_asked_is_refused()
    var l = t_central()
    // An interval below 6.
    var r = t_param_pdu(ll_data.OP_CONNECTION_PARAM_REQ, 4, 6, 0, 200, 0)
    let _a = t_packet(var l, var r, 0, 0, 0)
    test.assert_eq(t_next_op(var l), ll_data.OP_REJECT_EXT_IND)
    test.assert_eq(t_next_byte(var l, 1), ll_data.OP_CONNECTION_PARAM_REQ)
    test.assert_eq(t_next_byte(var l, 2), CODE_INVALID_LL_PARAMETERS)
    // A request the Host has not answered yet holds the next off.
    var m = t_central()
    link_set_indicate(var m, true)
    var s = t_param_pdu(ll_data.OP_CONNECTION_PARAM_REQ, 6, 6, 0, 300, 0)
    let _b = t_packet(var m, var s, 0, 0, 0)
    test.assert(m.rq_wait)
    test.assert(link_owes(var m, EV_PARAM_REQUEST))
    test.assert_eq(m.rq_min, 6)
    test.assert_eq(m.rq_timeout, 300)
    var s2 = t_param_pdu(ll_data.OP_CONNECTION_PARAM_REQ, 6, 6, 0, 300, 0)
    let _c = t_packet(var m, var s2, 1, 0, 0)
    test.assert_eq(t_next_op(var m), ll_data.OP_REJECT_EXT_IND)
    test.assert_eq(t_next_byte(var m, 2), CODE_BUSY)

@test
fn test_the_central_picks_a_multiple_of_the_preferred_periodicity()
    test.assert_eq(pick_interval(10, 100, 0), 100)
    test.assert_eq(pick_interval(10, 100, 30), 90)
    test.assert_eq(pick_interval(10, 100, 120), 100)
    test.assert_eq(pick_interval(50, 50, 30), 50)
    test.assert_eq(pick_interval(40, 50, 30), 50)
    test.assert(params_valid(6, 6, 0, 10))
    test.assert(not params_valid(5, 6, 0, 100))
    test.assert(not params_valid(6, 3201, 0, 3200))
    test.assert(not params_valid(8, 6, 0, 100))
    test.assert(not params_valid(6, 6, 500, 3200))
    test.assert(not params_valid(6, 6, 0, 9))
    test.assert(not params_valid(6, 6, 0, 3201))
    test.assert(not params_valid(100, 100, 0, 25))

@test
fn test_the_minimum_of_used_channels_is_heard_by_a_central_alone()
    var l = t_central()
    var m = t_ctrl(ll_data.OP_MIN_USED_CHANNELS_IND, [1, 20])
    let _a = t_packet(var l, var m, 0, 0, 0)
    test.assert_eq(l.min_used, 20)
    // Another PHY, a count out of range: not noted.
    var n = t_central()
    var m2 = t_ctrl(ll_data.OP_MIN_USED_CHANNELS_IND, [2, 20])
    let _b = t_packet(var n, var m2, 0, 0, 0)
    test.assert_eq(n.min_used, 0)
    var m3 = t_ctrl(ll_data.OP_MIN_USED_CHANNELS_IND, [1, 1])
    let _c = t_packet(var n, var m3, 1, 0, 0)
    test.assert_eq(n.min_used, 0)
    var m4 = t_ctrl(ll_data.OP_MIN_USED_CHANNELS_IND, [1, 38])
    let _d = t_packet(var n, var m4, 0, 0, 0)
    test.assert_eq(n.min_used, 0)
    // A Peripheral does not know it.
    var p = t_link()
    var m5 = t_ctrl(ll_data.OP_MIN_USED_CHANNELS_IND, [1, 20])
    let _e = t_packet(var p, var m5, 0, 0, 0)
    test.assert_eq(t_next_op(var p), ll_data.OP_UNKNOWN_RSP)
    test.assert_eq(t_next_byte(var p, 1), ll_data.OP_MIN_USED_CHANNELS_IND)

@test
fn test_the_map_the_central_wants_is_the_hosts_with_channels_added()
    test.assert_eq(pad_map(0x3FF, 12), 0xFFF)
    test.assert_eq(pad_map(0x3FF, 5), 0x3FF)
    test.assert_eq(pad_map(0x1000, 3), 0x1003)
    var l = t_central()
    test.assert_eq(wanted_map(var l), 0x1FFFFFFFFF)
    link_set_host_map(var l, 0x1000000001)
    test.assert_eq(wanted_map(var l), 0x1000000001)
    link_set_host_map(var l, 0x400)
    test.assert_eq(wanted_map(var l), 0x401)
    t_central_with(var l, 5)
    test.assert_eq(wanted_map(var l), 0x40F)

@test
fn test_a_central_sends_the_map_when_it_can_and_a_full_queue_waits()
    var l = t_central()
    link_set_host_map(var l, 0x3FF)
    t_fill_cq(var l)
    link_event_done(var l, 1500)
    test.assert(not l.chm_pending)
    // The queue has room again: the next event sends it.
    t_pop_cq(var l)
    link_event_done(var l, 9000)
    test.assert(l.chm_pending)
    test.assert_eq(l.chm_map, 0x3FF)
    // Nothing more is sent while it is under way.
    let count = l.cq_count
    link_event_done(var l, 16500)
    test.assert_eq(l.cq_count, count)
    // A Central that waits for its Host does not start one.
    var m = t_central()
    link_set_host_map(var m, 0x3FF)
    t_rq_wait(var m, true)
    link_event_done(var m, 1500)
    test.assert(not m.chm_pending)

@test
fn test_the_host_commands_of_the_parameter_procedures_check_the_link()
    var l = t_link()
    link_close(var l, REASON_TIMEOUT)
    test.assert_eq(link_connection_update(var l, 24, 24, 0, 400), STATUS_UNKNOWN_CONNECTION)
    test.assert_eq(link_param_reply(var l, 24, 24, 0, 400), STATUS_UNKNOWN_CONNECTION)
    test.assert_eq(link_param_negative(var l, 0x3B), STATUS_UNKNOWN_CONNECTION)
    test.assert_eq(link_set_apto(var l, 100), STATUS_UNKNOWN_CONNECTION)
    test.assert_eq(link_request_min_used(var l, 20), STATUS_COMMAND_DISALLOWED)
    var m = t_link()
    test.assert_eq(link_connection_update(var m, 5, 5, 0, 400), STATUS_INVALID_PARAMETERS)
    t_fill_cq(var m)
    test.assert_eq(link_connection_update(var m, 24, 24, 0, 400), STATUS_COMMAND_DISALLOWED)
    test.assert_eq(m.proc, PROC_NONE)
    test.assert_eq(link_request_min_used(var m, 20), STATUS_COMMAND_DISALLOWED)
    var c = t_central()
    t_fill_cq(var c)
    test.assert_eq(link_connection_update(var c, 24, 24, 0, 400), STATUS_COMMAND_DISALLOWED)
    test.assert(not c.upd_pending)
    // Replies need a request waiting.
    var r = t_link()
    test.assert_eq(link_param_reply(var r, 24, 24, 0, 400), STATUS_COMMAND_DISALLOWED)
    test.assert_eq(link_param_negative(var r, 0x3B), STATUS_COMMAND_DISALLOWED)
    t_rq_wait(var r, true)
    test.assert_eq(link_param_reply(var r, 5, 5, 0, 400), STATUS_INVALID_PARAMETERS)
    test.assert_eq(link_param_negative(var r, 0x3B), STATUS_SUCCESS)
    test.assert(not r.rq_wait)
    test.assert_eq(t_next_op(var r), ll_data.OP_REJECT_EXT_IND)

@test
fn test_an_update_that_changes_nothing_and_was_not_asked_for_is_not_reported()
    var l = t_link()
    var u = t_ctrl(ll_data.OP_CONNECTION_UPDATE_IND, [2, 0, 0, 6, 0, 0, 0, 200, 0, 3, 0])
    let _a = t_packet(var l, var u, 0, 0, 0)
    test.assert(l.upd_pending)
    for _ in 0..4
        let _c = link_event_begin(var l)
        link_event_done(var l, 9000)
    test.assert(not l.upd_pending)
    test.assert(not link_owes(var l, EV_UPDATED))

@test
fn test_a_response_timeout_applies_to_every_procedure_and_a_queued_pdu_restarts_it()
    var l = t_link()
    test.assert_eq(link_connection_update(var l, 24, 24, 0, 400), STATUS_SUCCESS)
    t_alive(var l, 3200, 41000000)
    link_event_done(var l, 40000001)
    test.assert(not l.closing)
    link_event_done(var l, 41000001)
    test.assert(l.closing)
    test.assert_eq(l.reason, REASON_RESPONSE_TIMEOUT)
    // A PDU queued meanwhile starts the timer again.
    var m = t_link()
    test.assert_eq(link_connection_update(var m, 24, 24, 0, 400), STATUS_SUCCESS)
    t_now(var m, 30000000)
    var p = t_ctrl(ll_data.OP_PING_RSP, [])
    test.assert(ctrl_queue(var m, var p))
    test.assert_eq(m.proc_t0, 30000000)
    t_alive(var m, 3200, 69000000)
    link_event_done(var m, 69000000)
    test.assert(not m.closing)
    // The ping that is not answered ends the connection too.
    var n = t_link()
    t_proc(var n, PROC_PING)
    t_alive(var n, 3200, 41000000)
    link_event_done(var n, 41000000)
    test.assert(n.closing)

@test
fn test_the_authenticated_payload_timer_pings_early_expires_and_restarts()
    var l = t_link()
    t_alive(var l, 3200, 0)
    // 7.5 ms events and a timeout of 1 s: the ping goes 30 ms before it.
    test.assert_eq(link_set_apto(var l, 100), STATUS_SUCCESS)
    link_set_auth(var l, true, 0)
    link_event_done(var l, 900000)
    test.assert_eq(l.proc, PROC_NONE)
    link_event_done(var l, 970000)
    test.assert_eq(l.proc, PROC_PING)
    test.assert(l.pinged)
    test.assert_eq(t_next_op(var l), ll_data.OP_PING_REQ)
    // The answer ends the procedure; no second ping in the period.
    var r = t_ctrl(ll_data.OP_PING_RSP, [])
    let _a = t_packet(var l, var r, 0, 0, 0)
    test.assert_eq(l.proc, PROC_NONE)
    link_event_done(var l, 980000)
    test.assert_eq(l.proc, PROC_NONE)
    test.assert(not link_owes(var l, EV_APTO))
    link_event_done(var l, 1000000)
    test.assert(link_owes(var l, EV_APTO))
    test.assert_eq(l.auth_t0, 1000000)
    test.assert(not l.pinged)
    // Off, the timer does nothing.
    var m = t_link()
    t_alive(var m, 3200, 40000000)
    link_event_done(var m, 40000000)
    test.assert(not link_owes(var m, EV_APTO))

@test
fn test_a_short_timeout_pings_at_half_and_a_ping_waits_for_a_free_procedure()
    // A timeout of 40 ms: the lead of four intervals is more than half of it.
    var l = t_link()
    t_alive(var l, 3200, 0)
    test.assert_eq(link_set_apto(var l, 4), STATUS_SUCCESS)
    link_set_auth(var l, true, 0)
    link_event_done(var l, 15000)
    test.assert_eq(l.proc, PROC_NONE)
    link_event_done(var l, 21000)
    test.assert_eq(l.proc, PROC_PING)
    // Another procedure under way: the ping waits.
    var m = t_link()
    t_alive(var m, 3200, 0)
    test.assert_eq(link_set_apto(var m, 4), STATUS_SUCCESS)
    link_set_auth(var m, true, 0)
    t_proc(var m, PROC_VERSION)
    link_event_done(var m, 21000)
    test.assert_eq(m.proc, PROC_VERSION)
    test.assert(not m.pinged)
    // A peer that does not know the ping is not sent one.
    var n = t_link()
    t_alive(var n, 3200, 0)
    test.assert_eq(link_set_apto(var n, 4), STATUS_SUCCESS)
    link_set_auth(var n, true, 0)
    t_set_phase(var n, false, false)
    link_event_done(var n, 21000)
    test.assert_eq(n.proc, PROC_NONE)
    // A full queue: the next event tries again.
    var o = t_link()
    t_alive(var o, 3200, 0)
    test.assert_eq(link_set_apto(var o, 4), STATUS_SUCCESS)
    link_set_auth(var o, true, 0)
    t_fill_cq(var o)
    link_event_done(var o, 21000)
    test.assert_eq(o.proc, PROC_NONE)
    test.assert(not o.pinged)

@test
fn test_the_timeout_is_checked_against_the_interval_and_a_valid_mic_restarts_the_timer()
    var l = t_link()
    // 7.5 ms with no latency: 1 unit of 10 ms is enough, 0 is not.
    test.assert_eq(link_set_apto(var l, 1), STATUS_SUCCESS)
    test.assert_eq(link_set_apto(var l, 0), STATUS_INVALID_PARAMETERS)
    test.assert_eq(link_set_apto(var l, 0x10000), STATUS_INVALID_PARAMETERS)
    var m = t_central()
    test.assert_eq(link_set_apto(var m, 100), STATUS_SUCCESS)
    link_set_auth(var m, true, 0)
    link_auth_rx(var m, 5000)
    test.assert_eq(m.auth_t0, 5000)

@test
fn test_a_peripheral_asks_the_central_for_a_minimum_of_channels()
    var l = t_link()
    test.assert_eq(link_request_min_used(var l, 20), STATUS_SUCCESS)
    test.assert_eq(t_next_op(var l), ll_data.OP_MIN_USED_CHANNELS_IND)
    test.assert_eq(t_next_byte(var l, 1), 1)
    test.assert_eq(t_next_byte(var l, 2), 20)
    var c = t_central()
    test.assert_eq(link_request_min_used(var c, 20), STATUS_COMMAND_DISALLOWED)

@test
fn test_a_request_wider_than_the_hosts_range_is_cut_to_it()
    var l = t_central()
    link_host_range(var l, 40, 60, 2, 200)
    var r = t_param_pdu(ll_data.OP_CONNECTION_PARAM_REQ, 30, 80, 0, 200, 0)
    let _a = t_packet(var l, var r, 0, 0, 0)
    test.assert(not l.rq_wait)
    test.assert(l.upd_pending)
    test.assert_eq(l.upd_interval, 60)
    test.assert_eq(l.upd_timeout, 200)
    // A request below the range, or with another timeout, is the Host's to answer.
    var m = t_central()
    link_host_range(var m, 40, 60, 2, 200)
    link_set_indicate(var m, true)
    var s = t_param_pdu(ll_data.OP_CONNECTION_PARAM_REQ, 10, 30, 0, 200, 0)
    let _b = t_packet(var m, var s, 0, 0, 0)
    test.assert(m.rq_wait)
    test.assert(not m.upd_pending)
    var n = t_central()
    link_host_range(var n, 40, 60, 2, 200)
    link_set_indicate(var n, true)
    var u = t_param_pdu(ll_data.OP_CONNECTION_PARAM_REQ, 40, 60, 0, 300, 0)
    let _c = t_packet(var n, var u, 0, 0, 0)
    test.assert(n.rq_wait)
    var o = t_central()
    link_host_range(var o, 40, 60, 2, 200)
    link_set_indicate(var o, true)
    var v = t_param_pdu(ll_data.OP_CONNECTION_PARAM_REQ, 40, 60, 3, 200, 0)
    let _d = t_packet(var o, var v, 0, 0, 0)
    test.assert(o.rq_wait)

// ── The data length and the PHY ──────────────────────────────────────

// The peer's limits, for a test: it receives and sends `oct` octets in `us` microseconds.
// Setters of the fields a test moves: a test cannot assign to the field of a link it holds.
fn t_set_chm_pending(var l: Link, v: Bool)
    l.chm_pending = v

fn t_set_cq_count(var l: Link, v: Int)
    l.cq_count = v

fn t_set_dl_rem_rx_octets(var l: Link, v: Int)
    l.dl_rem_rx_octets = v

fn t_set_dl_rem_rx_time(var l: Link, v: Int)
    l.dl_rem_rx_time = v

fn t_set_dl_rem_tx_octets(var l: Link, v: Int)
    l.dl_rem_tx_octets = v

fn t_set_dl_rem_tx_time(var l: Link, v: Int)
    l.dl_rem_tx_time = v

fn t_set_dl_rx_octets(var l: Link, v: Int)
    l.dl_rx_octets = v

fn t_set_dl_rx_time(var l: Link, v: Int)
    l.dl_rx_time = v

fn t_set_dl_started(var l: Link, v: Bool)
    l.dl_started = v

fn t_set_dl_tx_octets(var l: Link, v: Int)
    l.dl_tx_octets = v

fn t_set_dl_tx_time(var l: Link, v: Int)
    l.dl_tx_time = v

fn t_set_dl_wait(var l: Link, v: Bool)
    l.dl_wait = v

fn t_set_ev_count(var l: Link, v: Int)
    l.ev_count = v

fn t_set_have_feat(var l: Link, v: Bool)
    l.have_feat = v

fn t_set_interval(var l: Link, v: Int)
    l.interval = v

fn t_set_nxt_kind(var l: Link, v: Int)
    l.nxt_kind = v

fn t_set_phy(var l: Link, v: Int)
    l.phy = v

fn t_set_phy_host(var l: Link, v: Bool)
    l.phy_host = v

fn t_set_phy_new(var l: Link, v: Int)
    l.phy_new = v

fn t_set_phy_off(var l: Link, v: Int)
    l.phy_off = v

// The peer told its feature octet `i` is `v` (a test sets what LL_FEATURE_RSP would).
fn t_peer_features(var l: Link, i: Int, v: Int)
    l.have_feat = true
    l.peer_feat[i] = v as u8

fn t_set_phy_opt(var l: Link, v: Int)
    l.phy_opt = v

fn t_set_phy_pending(var l: Link, v: Bool)
    l.phy_pending = v

fn t_set_phy_pref_rx(var l: Link, v: Int)
    l.phy_pref_rx = v

fn t_set_phy_pref_set(var l: Link, v: Bool)
    l.phy_pref_set = v

fn t_set_phy_pref_tx(var l: Link, v: Int)
    l.phy_pref_tx = v

fn t_set_phy_state(var l: Link, v: Int)
    l.phy_state = v

fn t_set_phy_t0(var l: Link, v: Int)
    l.phy_t0 = v

fn t_set_phy_unsup(var l: Link, v: Bool)
    l.phy_unsup = v

fn t_set_room(var l: Link, v: Bool)
    l.room = v

fn t_set_rq_wait(var l: Link, v: Bool)
    l.rq_wait = v

fn t_set_upd_pending(var l: Link, v: Bool)
    l.upd_pending = v

fn t_set_enc_tx(var l: Link, v: Bool)
    l.enc_tx = v

fn t_set_enc_rx(var l: Link, v: Bool)
    l.enc_rx = v

fn t_set_enc_ph(var l: Link, v: Int)
    l.enc_ph = v

fn t_set_enc_wait(var l: Link, v: Bool)
    l.enc_wait = v

fn t_set_feat1(var l: Link, v: Int)
    l.peer_feat[1] = v as u8


fn t_remote(var l: Link, oct: Int, us: Int)
    l.dl_rem_rx_octets = oct
    l.dl_rem_tx_octets = oct
    l.dl_rem_rx_time = us
    l.dl_rem_tx_time = us
    dle_refresh(var l)

// Both ends have the full length, 251 octets and 2120 microseconds.
fn t_full(var l: Link)
    t_remote(var l, 251, 2120)

// Take what the link sends: the PDU in `nxt` goes, and the next waiting moves up.
fn t_take(var l: Link)
    l.nxt_kind = K_EMPTY
    ll_data.dpdu_empty(var l.nxt)
    link_prepare(var l)

fn t_length_pdu(op: Int, rx_oct: Int, rx_time: Int, tx_oct: Int, tx_time: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_data.ctrl_length(var p, op, rx_oct, rx_time, tx_oct, tx_time)
    p

fn t_phy_pdu(op: Int, tx: Int, rx: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_data.ctrl_phy(var p, op, tx, rx)
    p

fn t_update_pdu(c2p: Int, p2c: Int, instant: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_data.ctrl_phy_update(var p, c2p, p2c, instant)
    p

@test
fn test_a_new_connection_has_the_initial_length_and_phy()
    var l = t_link()
    test.assert_eq(l.dl_tx_octets, 251)
    test.assert_eq(l.dl_rx_octets, 251)
    test.assert_eq(l.dl_rem_tx_octets, 27)
    test.assert_eq(l.dl_rem_rx_time, 328)
    test.assert_eq(l.phy, ll_phy.PHY_1M)
    test.assert_eq(l.phy_pref_tx, PHYS_SUPPORTED)
    // The link starts nothing by itself until the Controller gives it the Host's defaults.
    test.assert(l.dl_started)
    test.assert(l.phy_auto)
    // The peer's 27 octets and 328 microseconds are the limits until it says otherwise.
    test.assert_eq(eff_tx_octets(var l), 27)
    test.assert_eq(eff_rx_octets(var l), 27)
    test.assert_eq(eff_tx_time(var l, ll_phy.PHY_1M), 328)
    test.assert_eq(eff_rx_time(var l, ll_phy.PHY_2M), 328)
    test.assert_eq(l.dl_ev_tx_octets, 27)
    test.assert(not link_owes(var l, EV_DATA_LENGTH))

@test
fn test_the_effective_values_are_the_lesser_of_the_local_and_the_remote_limit()
    var l = t_link()
    t_set_dl_tx_octets(var l, 200)
    t_set_dl_tx_time(var l, 1700)
    t_set_dl_rx_octets(var l, 100)
    t_set_dl_rx_time(var l, 900)
    t_set_dl_rem_rx_octets(var l, 251)
    t_set_dl_rem_rx_time(var l, 2120)
    t_set_dl_rem_tx_octets(var l, 60)
    t_set_dl_rem_tx_time(var l, 700)
    test.assert_eq(eff_tx_octets(var l), 200)
    test.assert_eq(eff_rx_octets(var l), 60)
    test.assert_eq(eff_tx_time(var l, ll_phy.PHY_1M), 1700)
    test.assert_eq(eff_tx_time(var l, ll_phy.PHY_2M), 1700)
    test.assert_eq(eff_rx_time(var l, ll_phy.PHY_1M), 700)

@test
fn test_on_the_coded_phy_the_times_are_never_below_2704_and_the_interval_cuts_the_transmit_time()
    var l = t_link()
    t_full(var l)
    // The receive time of 2120 is under 2704 on the LE Coded PHY, which makes it 2704.
    test.assert_eq(eff_rx_time(var l, ll_phy.PHY_CODED), 2704)
    // The transmit time is cut by the interval (7500 us) less T_IFS twice and the packet of the other direction, but
    // never goes below 2704: here 2120.
    test.assert_eq(eff_tx_time(var l, ll_phy.PHY_CODED), 2704)
    // The Host sets the longest time on both sides: the interval leaves 7500 - 300 - 2704 = 4496.
    t_set_dl_tx_time(var l, 17040)
    t_set_dl_rem_rx_time(var l, 17040)
    test.assert_eq(eff_tx_time(var l, ll_phy.PHY_CODED), 4496)
    test.assert_eq(eff_tx_time(var l, ll_phy.PHY_1M), 17040)
    // A long interval leaves all of it.
    t_set_interval(var l, 800)
    test.assert_eq(eff_tx_time(var l, ll_phy.PHY_CODED), 17040)

@test
fn test_the_payload_limit_follows_the_octets_the_time_and_the_phys_of_a_procedure()
    var l = t_link()
    test.assert_eq(tx_limit(var l), 27)
    t_full(var l)
    test.assert_eq(tx_limit(var l), 251)
    // 100 octets and 1000 us: 1000 us is 117 octets at LE 1M after the header and the MIC.
    t_set_dl_tx_octets(var l, 100)
    test.assert_eq(tx_limit(var l), 100)
    t_set_dl_tx_octets(var l, 251)
    t_set_dl_tx_time(var l, 700)
    test.assert_eq(tx_limit(var l), 73)
    // On LE Coded S=8 with 2704 us: 27 octets; the LE Coded PHY pending cuts the PDUs queued before the instant.
    t_set_dl_tx_time(var l, 2120)
    t_set_phy_pending(var l, true)
    t_set_phy_new(var l, ll_phy.PHY_CODED)
    test.assert_eq(tx_limit(var l), 27)
    t_set_phy_new(var l, ll_phy.PHY_2M)
    test.assert_eq(tx_limit(var l), 251)
    t_set_phy_pending(var l, false)
    // A request this end made offers the PHYs it names: the PDUs wait for none of them to be longer than the time.
    t_set_phy_state(var l, PHY_WAIT_IND)
    t_set_phy_off(var l, ll_phy.MASK_CODED)
    test.assert_eq(tx_limit(var l), 27)
    t_set_phy_off(var l, ll_phy.MASK_1M | ll_phy.MASK_2M)
    test.assert_eq(tx_limit(var l), 251)
    t_set_phy_state(var l, PHY_IDLE)
    // The S=2 coding of the LE Coded PHY fits more octets in the same time.
    t_set_phy(var l, ll_phy.PHY_CODED)
    t_set_phy_opt(var l, ll_phy.OPT_S2)
    test.assert(tx_limit(var l) > 100)
    t_set_phy_opt(var l, ll_phy.OPT_S8)
    test.assert_eq(tx_limit(var l), 27)

@test
fn test_the_host_is_owed_a_data_length_change_when_an_effective_value_moves()
    var l = t_link()
    dle_refresh(var l)
    test.assert(not link_owes(var l, EV_DATA_LENGTH))
    t_full(var l)
    test.assert(link_owes(var l, EV_DATA_LENGTH))
    test.assert_eq(l.dl_ev_tx_octets, 251)
    test.assert_eq(l.dl_ev_tx_time, 2120)
    test.assert_eq(l.dl_ev_rx_octets, 251)
    test.assert_eq(l.dl_ev_rx_time, 2120)
    link_sent(var l, EV_DATA_LENGTH)
    dle_refresh(var l)
    test.assert(not link_owes(var l, EV_DATA_LENGTH))
    // Each of the four moves it.
    t_set_dl_rem_tx_time(var l, 1500)
    dle_refresh(var l)
    test.assert(link_owes(var l, EV_DATA_LENGTH))
    link_sent(var l, EV_DATA_LENGTH)
    t_set_dl_rem_rx_time(var l, 1500)
    dle_refresh(var l)
    test.assert(link_owes(var l, EV_DATA_LENGTH))
    link_sent(var l, EV_DATA_LENGTH)
    t_set_dl_rem_tx_octets(var l, 100)
    dle_refresh(var l)
    test.assert(link_owes(var l, EV_DATA_LENGTH))
    link_sent(var l, EV_DATA_LENGTH)
    t_set_dl_rem_rx_octets(var l, 100)
    dle_refresh(var l)
    test.assert(link_owes(var l, EV_DATA_LENGTH))

@test
fn test_the_times_on_the_wire_are_cut_to_2128_for_a_peer_without_the_coded_phy()
    var l = t_link()
    t_set_dl_tx_time(var l, 17040)
    test.assert_eq(dle_wire_time(var l, l.dl_tx_time), 2128)
    // The peer's features show the LE Coded PHY: the whole time goes.
    t_set_have_feat(var l, true)
    t_set_feat1(var l, FEAT1_CODED)
    test.assert_eq(dle_wire_time(var l, l.dl_tx_time), 17040)
    // Features without it: 2128 again.
    t_set_feat1(var l, FEAT1_2M)
    test.assert_eq(dle_wire_time(var l, l.dl_tx_time), 2128)
    test.assert_eq(dle_wire_time(var l, 1000), 1000)

@test
fn test_the_data_length_update_procedure_sends_a_request_and_ends_with_the_response()
    var l = t_link()
    dle_start(var l)
    test.assert(l.dl_wait)
    test.assert_eq(t_next_op(var l), ll_data.OP_LENGTH_REQ)
    // Max RX octets and time, then max TX octets and time: 251 and 2120 both ways.
    test.assert_eq(ll_data.dpdu_u16(var l.nxt, 1), 251)
    test.assert_eq(ll_data.dpdu_u16(var l.nxt, 3), 2120)
    test.assert_eq(ll_data.dpdu_u16(var l.nxt, 5), 251)
    test.assert_eq(ll_data.dpdu_u16(var l.nxt, 7), 2120)
    // A second start while the request is out asks again after the answer.
    t_set_dl_tx_octets(var l, 100)
    dle_start(var l)
    test.assert(l.dl_resend)
    test.assert_eq(l.cq_count, 0)
    var r = t_length_pdu(ll_data.OP_LENGTH_RSP, 251, 2120, 251, 2120)
    let _a = t_packet(var l, var r, 0, 0, 0)
    test.assert_eq(l.dl_rem_rx_octets, 251)
    test.assert_eq(l.dl_rem_tx_time, 2120)
    test.assert(link_owes(var l, EV_DATA_LENGTH))
    // The second request went out with the new values.
    test.assert(l.dl_wait)
    test.assert(not l.dl_resend)
    test.assert_eq(l.cq_count, 1)
    var scratch = ll_pdu.pdu_new()
    slot_get_cq(var l, l.cq_head, var scratch)
    test.assert_eq(ll_data.dpdu_u16(var scratch, 5), 100)
    var r2 = t_length_pdu(ll_data.OP_LENGTH_RSP, 251, 2120, 251, 2120)
    let _b = t_packet(var l, var r2, 1, 1, 0)
    test.assert(not l.dl_wait)

@test
fn test_a_length_response_nobody_asked_for_is_ignored_and_bad_values_are_not_kept()
    var l = t_link()
    var r = t_length_pdu(ll_data.OP_LENGTH_RSP, 251, 2120, 251, 2120)
    let _a = t_packet(var l, var r, 0, 0, 0)
    test.assert_eq(l.dl_rem_rx_octets, 27)
    dle_start(var l)
    var bad = t_length_pdu(ll_data.OP_LENGTH_RSP, 20, 2120, 251, 2120)
    let _b = t_packet(var l, var bad, 1, 0, 0)
    // The procedure ends, the values stay.
    test.assert(not l.dl_wait)
    test.assert_eq(l.dl_rem_rx_octets, 27)

@test
fn test_a_length_request_is_answered_with_this_ends_values_and_a_bad_one_is_refused()
    var l = t_link()
    var q = t_length_pdu(ll_data.OP_LENGTH_REQ, 251, 2120, 180, 1600)
    let _a = t_packet(var l, var q, 0, 0, 0)
    test.assert_eq(l.dl_rem_rx_octets, 251)
    test.assert_eq(l.dl_rem_tx_octets, 180)
    test.assert_eq(l.dl_rem_tx_time, 1600)
    test.assert_eq(t_next_op(var l), ll_data.OP_LENGTH_RSP)
    test.assert_eq(ll_data.dpdu_u16(var l.nxt, 1), 251)
    test.assert_eq(ll_data.dpdu_u16(var l.nxt, 5), 251)
    test.assert(link_owes(var l, EV_DATA_LENGTH))
    // Values out of range: LL_REJECT_EXT_IND with Invalid LL Parameters, nothing kept.
    var m = t_link()
    for k in 0..4
        var bad_rx = t_length_pdu(ll_data.OP_LENGTH_REQ, if k == 0 then 26 else 251, if k == 1 then 327 else 2120, if k == 2 then 252 else 251, if k == 3 then 17041 else 2120)
        t_set_dl_rem_rx_octets(var m, 27)
        t_set_nxt_kind(var m, K_EMPTY)
        ll_data.dpdu_empty(var m.nxt)
        let _b = t_packet(var m, var bad_rx, k % 2, 0, 0)
        test.assert_eq(t_next_op(var m), ll_data.OP_REJECT_EXT_IND)
        test.assert_eq(t_next_byte(var m, 1), ll_data.OP_LENGTH_REQ)
        test.assert_eq(t_next_byte(var m, 2), CODE_INVALID_LL_PARAMETERS)
        test.assert_eq(m.dl_rem_rx_octets, 27)

@test
fn test_the_procedure_is_refused_or_not_known_and_a_peer_without_it_is_not_asked()
    var l = t_link()
    dle_start(var l)
    var u = t_ctrl(ll_data.OP_UNKNOWN_RSP, [ll_data.OP_LENGTH_REQ])
    let _a = t_packet(var l, var u, 0, 0, 0)
    test.assert(not l.dl_wait)
    test.assert(l.dl_unsup)
    dle_start(var l)
    test.assert(not l.dl_wait)
    // A reject names the request and ends it, the peer stays a peer that has the procedure.
    var m = t_link()
    dle_start(var m)
    var r = t_ctrl(ll_data.OP_REJECT_EXT_IND, [ll_data.OP_LENGTH_REQ, 0x23])
    let _b = t_packet(var m, var r, 0, 0, 0)
    test.assert(not m.dl_wait)
    test.assert(not m.dl_unsup)
    var n = t_link()
    dle_start(var n)
    var r2 = t_ctrl(ll_data.OP_REJECT_IND, [0x23])
    let _c = t_packet(var n, var r2, 0, 0, 0)
    test.assert(not n.dl_wait)
    // A peer whose features lack it is never asked.
    var o = t_link()
    t_have_features(var o, 0x1F)
    dle_start(var o)
    test.assert(o.dl_unsup)
    test.assert(not o.dl_wait)
    test.assert_eq(o.cq_count + (if o.nxt_kind == K_EMPTY then 0 else 1), 0)
    // And a full queue leaves no request out.
    var p = t_link()
    t_fill_cq(var p)
    dle_start(var p)
    test.assert(not p.dl_wait)

@test
fn test_the_host_sets_the_data_length_and_the_peer_is_told()
    var l = t_link()
    test.assert_eq(link_set_data_length(var l, 100, 1000), STATUS_SUCCESS)
    test.assert_eq(l.dl_tx_octets, 100)
    test.assert_eq(l.dl_tx_time, 1000)
    test.assert_eq(t_next_op(var l), ll_data.OP_LENGTH_REQ)
    test.assert_eq(ll_data.dpdu_u16(var l.nxt, 5), 100)
    test.assert_eq(ll_data.dpdu_u16(var l.nxt, 7), 1000)
    // The same values again change nothing and send nothing more.
    t_set_cq_count(var l, 0)
    test.assert_eq(link_set_data_length(var l, 100, 1000), STATUS_SUCCESS)
    test.assert_eq(l.cq_count, 0)
    test.assert_eq(link_set_data_length(var l, 26, 1000), STATUS_INVALID_PARAMETERS)
    test.assert_eq(link_set_data_length(var l, 252, 1000), STATUS_INVALID_PARAMETERS)
    test.assert_eq(link_set_data_length(var l, 100, 327), STATUS_INVALID_PARAMETERS)
    test.assert_eq(link_set_data_length(var l, 100, 17041), STATUS_INVALID_PARAMETERS)
    var dead = link_new()
    test.assert_eq(link_set_data_length(var dead, 100, 1000), STATUS_UNKNOWN_CONNECTION)
    link_close(var l, 0x08)
    test.assert_eq(link_set_data_length(var l, 100, 1100), STATUS_UNKNOWN_CONNECTION)

@test
fn test_the_defaults_of_the_host_are_taken_for_a_new_connection()
    var l = t_link()
    link_set_defaults(var l, true, 120, 1200, true, 2, 3)
    test.assert_eq(l.dl_tx_octets, 120)
    test.assert_eq(l.dl_tx_time, 1200)
    test.assert(l.phy_pref_set)
    test.assert_eq(l.phy_pref_tx, 2)
    test.assert_eq(l.phy_pref_rx, 3)
    // The connection starts the procedures itself from now on.
    test.assert(not l.dl_started)
    test.assert(not l.phy_auto)
    var m = t_link()
    link_set_defaults(var m, false, 27, 328, false, 7, 7)
    test.assert_eq(m.dl_tx_octets, 251)
    test.assert(not m.phy_pref_set)

@test
fn test_a_packet_longer_than_the_data_length_goes_out_in_pieces_and_frees_the_buffer_with_the_last()
    var l = t_link()
    test.assert(t_queue(var l, true, 100))
    // The first piece: 27 octets, LLID start, and the packet stays at the head of the queue.
    test.assert_eq(l.nxt_kind, K_ACL_PART)
    test.assert_eq(ll_data.dpdu_llid(var l.nxt), ll_data.LLID_START)
    test.assert_eq(ll_data.dpdu_len(var l.nxt), 27)
    test.assert_eq(ll_data.dpdu_byte(var l.nxt, 0), 0x60)
    test.assert_eq(l.txq_off, 27)
    test.assert_eq(l.txq_count, 1)
    t_take(var l)
    test.assert_eq(l.nxt_kind, K_ACL_PART)
    test.assert_eq(ll_data.dpdu_llid(var l.nxt), ll_data.LLID_CONTINUE)
    test.assert_eq(ll_data.dpdu_len(var l.nxt), 27)
    test.assert_eq(ll_data.dpdu_byte(var l.nxt, 0), 0x60 + (27 & 0x1F))
    t_take(var l)
    t_take(var l)
    // The last piece is the 19 octets left, and it is the one that returns the Host's buffer.
    test.assert_eq(l.nxt_kind, K_ACL)
    test.assert_eq(ll_data.dpdu_llid(var l.nxt), ll_data.LLID_CONTINUE)
    test.assert_eq(ll_data.dpdu_len(var l.nxt), 19)
    test.assert_eq(ll_data.dpdu_byte(var l.nxt, 18), 0x60 + (99 & 0x1F))
    test.assert_eq(l.txq_count, 0)
    test.assert_eq(l.txq_off, 0)
    // A piece that is acknowledged returns nothing, the last one returns the buffer.
    var m = t_link()
    test.assert(t_queue(var m, true, 60))
    test.assert_eq(m.nxt_kind, K_ACL_PART)
    let _a = t_slow(var m, ll_data.LLID_CONTINUE, 0)
    var e = t_data(ll_data.LLID_CONTINUE, 0)
    let _b = t_packet(var m, var e, 0, 1, 0)
    test.assert_eq(m.completed, 0)
    test.assert_eq(m.cur_kind, K_ACL_PART)
    var e2 = t_data(ll_data.LLID_CONTINUE, 0)
    let _c = t_packet(var m, var e2, 1, 0, 0)
    test.assert_eq(m.completed, 0)

@test
fn test_the_whole_packet_goes_as_one_pdu_when_the_length_allows_it()
    var l = t_link()
    t_full(var l)
    test.assert(t_queue(var l, true, 251))
    test.assert_eq(l.nxt_kind, K_ACL)
    test.assert_eq(ll_data.dpdu_len(var l.nxt), 251)
    test.assert_eq(l.nxt.n, 253)
    test.assert_eq(ll_data.dpdu_byte(var l.nxt, 250), 0x60 + (250 & 0x1F))
    test.assert_eq(l.txq_count, 0)
    // All three slots hold a packet each.
    var m = t_link()
    t_full(var m)
    test.assert(t_queue(var m, true, 10))
    test.assert(t_queue(var m, true, 11))
    test.assert(t_queue(var m, false, 12))
    test.assert(t_queue(var m, false, 13))
    test.assert(not t_queue(var m, false, 14))
    test.assert_eq(ll_data.dpdu_len(var m.nxt), 10)
    t_take(var m)
    test.assert_eq(ll_data.dpdu_len(var m.nxt), 11)
    t_take(var m)
    test.assert_eq(ll_data.dpdu_len(var m.nxt), 12)
    test.assert_eq(ll_data.dpdu_llid(var m.nxt), ll_data.LLID_CONTINUE)
    t_take(var m)
    test.assert_eq(ll_data.dpdu_len(var m.nxt), 13)

@test
fn test_the_phy_to_ask_for_is_the_fastest_of_those_the_host_prefers()
    test.assert_eq(phy_best(7), ll_phy.PHY_2M)
    test.assert_eq(phy_best(6), ll_phy.PHY_2M)
    test.assert_eq(phy_best(5), ll_phy.PHY_1M)
    test.assert_eq(phy_best(1), ll_phy.PHY_1M)
    test.assert_eq(phy_best(4), ll_phy.PHY_CODED)
    test.assert_eq(phy_best(0), 0)
    test.assert_eq(phy_best(8), 0)
    var l = t_link()
    test.assert_eq(phy_wanted(var l), 7)
    t_set_phy_pref_tx(var l, 6)
    t_set_phy_pref_rx(var l, 3)
    test.assert_eq(phy_wanted(var l), 2)
    test.assert(peer_has_phy(var l, ll_phy.PHY_2M))
    t_set_have_feat(var l, true)
    test.assert(peer_has_phy(var l, ll_phy.PHY_1M))
    test.assert(not peer_has_phy(var l, ll_phy.PHY_2M))
    test.assert(not peer_has_phy(var l, ll_phy.PHY_CODED))
    t_set_feat1(var l, FEAT1_2M | FEAT1_CODED)
    test.assert(peer_has_phy(var l, ll_phy.PHY_2M))
    test.assert(peer_has_phy(var l, ll_phy.PHY_CODED))

@test
fn test_set_phy_checks_what_the_host_asks_and_asks_the_peer_for_the_fastest()
    var l = t_link()
    // The Host prefers LE 2M both ways: the request names it in both fields.
    test.assert_eq(link_set_phy(var l, 0, 2, 2, 0), STATUS_SUCCESS)
    test.assert_eq(l.phy_state, PHY_WAIT_IND)
    test.assert(l.phy_host)
    test.assert_eq(l.phy_off, 2)
    test.assert_eq(t_next_op(var l), ll_data.OP_PHY_REQ)
    test.assert_eq(t_next_byte(var l, 1), 2)
    test.assert_eq(t_next_byte(var l, 2), 2)
    // One procedure at a time.
    test.assert_eq(link_set_phy(var l, 0, 1, 1, 0), STATUS_COMMAND_DISALLOWED)
    var c = t_central()
    test.assert_eq(link_set_phy(var c, 3, 0, 0, 0), STATUS_SUCCESS)
    test.assert_eq(c.phy_state, PHY_WAIT_RSP)
    test.assert_eq(c.phy_pref_tx, 7)
    // The options are kept as the Host gave them.
    var o = t_link()
    test.assert_eq(link_set_phy(var o, 0, 4, 4, 3), STATUS_SUCCESS)
    test.assert_eq(o.phy_opt, 3)
    var o2 = t_link()
    test.assert_eq(link_set_phy(var o2, 0, 4, 4, 0xFE), STATUS_SUCCESS)
    test.assert_eq(o2.phy_opt, 2)

@test
fn test_set_phy_refuses_what_a_symmetric_controller_cannot_do()
    var l = t_link()
    test.assert_eq(link_set_phy(var l, 0, 1, 2, 0), STATUS_UNSUPPORTED_FEATURE)
    test.assert_eq(link_set_phy(var l, 0, 8, 8, 0), STATUS_UNSUPPORTED_FEATURE)
    test.assert_eq(link_set_phy(var l, 0, 0, 0, 0), STATUS_INVALID_PARAMETERS)
    test.assert_eq(link_set_phy(var l, 1, 0, 2, 0), STATUS_SUCCESS)
    var m = t_link()
    test.assert_eq(link_set_phy(var m, 2, 2, 0, 0), STATUS_SUCCESS)
    // No preference for the transmitter and LE 1M only for the receiver: the PHYs both name are LE 1M.
    var n = t_link()
    test.assert_eq(link_set_phy(var n, 1, 0, 1, 0), STATUS_SUCCESS)
    test.assert_eq(n.phy_pref_tx, 7)
    test.assert_eq(n.phy_pref_rx, 1)
    var dead = link_new()
    test.assert_eq(link_set_phy(var dead, 0, 2, 2, 0), STATUS_UNKNOWN_CONNECTION)
    // No PHY in common between the two fields.
    var q = t_link()
    test.assert_eq(link_set_phy(var q, 1, 0, 4, 0), STATUS_SUCCESS)
    var r = t_link()
    t_set_phy_state(var r, PHY_WAIT_IND)
    test.assert_eq(link_set_phy(var r, 0, 2, 2, 0), STATUS_COMMAND_DISALLOWED)
    var s = t_link()
    t_set_phy_pending(var s, true)
    test.assert_eq(link_set_phy(var s, 0, 2, 2, 0), STATUS_COMMAND_DISALLOWED)

@test
fn test_the_controllers_own_start_waits_for_a_procedure_under_way()
    var l = t_link()
    t_set_phy_state(var l, PHY_RESPONDED)
    test.assert_eq(phy_begin(var l, false), STATUS_COMMAND_DISALLOWED)
    var m = t_link()
    t_set_phy_pending(var m, true)
    test.assert_eq(phy_begin(var m, false), STATUS_COMMAND_DISALLOWED)

@test
fn test_a_request_for_the_phy_in_force_is_answered_at_once_to_the_host()
    var l = t_link()
    test.assert_eq(link_set_phy(var l, 0, 1, 1, 0), STATUS_SUCCESS)
    test.assert(link_owes(var l, EV_PHY))
    test.assert_eq(l.phy_status, STATUS_SUCCESS)
    test.assert_eq(l.cq_count, 0)
    test.assert_eq(l.nxt_kind, K_EMPTY)
    test.assert_eq(l.phy_state, PHY_IDLE)
    // The Controller's own start for the same needs no answer to anyone.
    var m = t_link()
    t_set_phy_pref_set(var m, true)
    t_set_phy_pref_tx(var m, 1)
    t_set_phy_pref_rx(var m, 1)
    test.assert_eq(phy_begin(var m, false), STATUS_SUCCESS)
    test.assert(not link_owes(var m, EV_PHY))
    // No PHY wanted at all.
    var n = t_link()
    t_set_phy_pref_tx(var n, 1)
    t_set_phy_pref_rx(var n, 2)
    test.assert_eq(phy_begin(var n, true), STATUS_SUCCESS)
    test.assert(link_owes(var n, EV_PHY))

@test
fn test_a_peer_without_the_phy_is_not_asked_and_the_host_hears_unsupported_remote_feature()
    var l = t_link()
    t_have_features(var l, 0x1F)
    test.assert_eq(link_set_phy(var l, 0, 2, 2, 0), STATUS_SUCCESS)
    test.assert(link_owes(var l, EV_PHY))
    test.assert_eq(l.phy_status, STATUS_UNSUPPORTED_REMOTE)
    test.assert_eq(l.phy_state, PHY_IDLE)
    test.assert_eq(l.cq_count, 0)
    // The same for a peer that answered LL_UNKNOWN_RSP, and nothing for the Controller's own start.
    var m = t_link()
    t_set_phy_unsup(var m, true)
    test.assert_eq(link_set_phy(var m, 0, 2, 2, 0), STATUS_SUCCESS)
    test.assert_eq(m.phy_status, STATUS_UNSUPPORTED_REMOTE)
    var n = t_link()
    t_set_phy_unsup(var n, true)
    t_set_phy_pref_set(var n, true)
    t_set_phy_pref_tx(var n, 2)
    t_set_phy_pref_rx(var n, 2)
    test.assert_eq(phy_begin(var n, false), STATUS_SUCCESS)
    test.assert(not link_owes(var n, EV_PHY))

@test
fn test_a_request_waits_for_the_data_length_procedure_and_a_full_queue_refuses_it()
    var l = t_link()
    dle_start(var l)
    test.assert_eq(link_set_phy(var l, 0, 2, 2, 0), STATUS_SUCCESS)
    test.assert_eq(l.phy_state, PHY_DEFERRED)
    test.assert_eq(l.cq_count, 0)
    test.assert(l.phy_host)
    // The response comes; the request goes out at the next work after an event.
    var r = t_length_pdu(ll_data.OP_LENGTH_RSP, 251, 2120, 251, 2120)
    let _a = t_packet(var l, var r, 0, 0, 0)
    t_alive(var l, 3200, 5000)
    auto_tasks(var l)
    test.assert_eq(l.phy_state, PHY_WAIT_IND)
    test.assert_eq(l.phy_off, 2)
    test.assert(l.cq_count + (if l.nxt_kind == K_CTRL then 1 else 0) >= 1)
    // The Host changed its mind meanwhile: the PHY in force is the one it wants, and it hears so.
    var m = t_link()
    dle_start(var m)
    test.assert_eq(link_set_phy(var m, 0, 2, 2, 0), STATUS_SUCCESS)
    t_set_phy_pref_tx(var m, 1)
    t_set_phy_pref_rx(var m, 1)
    t_set_dl_wait(var m, false)
    t_alive(var m, 3200, 5000)
    auto_tasks(var m)
    test.assert_eq(m.phy_state, PHY_IDLE)
    test.assert(link_owes(var m, EV_PHY))
    test.assert_eq(m.phy_status, STATUS_SUCCESS)
    // A queue without room leaves nothing out.
    var n = t_link()
    t_fill_cq(var n)
    test.assert_eq(link_set_phy(var n, 0, 2, 2, 0), STATUS_COMMAND_DISALLOWED)
    test.assert_eq(n.phy_state, PHY_IDLE)
    var o = t_link()
    dle_start(var o)
    test.assert_eq(link_set_phy(var o, 0, 2, 2, 0), STATUS_SUCCESS)
    t_set_dl_wait(var o, false)
    t_fill_cq(var o)
    t_alive(var o, 3200, 5000)
    auto_tasks(var o)
    // The queue is crowded: it waits for the next work.
    test.assert_eq(o.phy_state, PHY_DEFERRED)

@test
fn test_the_central_picks_the_fastest_phy_the_request_and_the_host_share_and_sends_the_update()
    var c = t_central()
    t_set_ev_count(var c, 10)
    var q = t_phy_pdu(ll_data.OP_PHY_REQ, 7, 7)
    let _a = t_packet(var c, var q, 0, 0, 0)
    test.assert_eq(t_next_op(var c), ll_data.OP_PHY_UPDATE_IND)
    test.assert_eq(t_next_byte(var c, 1), 2)
    test.assert_eq(t_next_byte(var c, 2), 2)
    test.assert(c.phy_pending)
    test.assert_eq(c.phy_new, ll_phy.PHY_2M)
    test.assert_eq(ll_data.dpdu_u16(var c.nxt, 3), c.phy_instant)
    test.assert_eq(c.phy_instant, (10 + INSTANT_LEAD * (1 + c.latency) + INSTANT_SLACK) & 0xFFFF)
    test.assert_eq(c.phy_state, PHY_IDLE)
    // The Host prefers LE 1M and Coded: LE 1M is the PHY in force, so nothing changes.
    var d = t_central()
    t_set_phy_pref_tx(var d, 5)
    t_set_phy_pref_rx(var d, 5)
    var q2 = t_phy_pdu(ll_data.OP_PHY_REQ, 7, 7)
    let _b = t_packet(var d, var q2, 0, 0, 0)
    test.assert_eq(t_next_op(var d), ll_data.OP_PHY_UPDATE_IND)
    test.assert_eq(t_next_byte(var d, 1), 0)
    test.assert_eq(t_next_byte(var d, 2), 0)
    test.assert(not d.phy_pending)
    // A request that names an asymmetric pair shares no PHY, and nothing changes.
    var e = t_central()
    var q3 = t_phy_pdu(ll_data.OP_PHY_REQ, 2, 1)
    let _c = t_packet(var e, var q3, 0, 0, 0)
    test.assert_eq(t_next_byte(var e, 1), 0)
    test.assert(not e.phy_pending)

@test
fn test_the_central_refuses_a_request_that_collides_with_a_procedure_of_its_own()
    var c = t_central()
    t_set_phy_state(var c, PHY_WAIT_RSP)
    var q = t_phy_pdu(ll_data.OP_PHY_REQ, 2, 2)
    let _a = t_packet(var c, var q, 0, 0, 0)
    test.assert_eq(t_next_op(var c), ll_data.OP_REJECT_EXT_IND)
    test.assert_eq(t_next_byte(var c, 1), ll_data.OP_PHY_REQ)
    test.assert_eq(t_next_byte(var c, 2), CODE_COLLISION)
    var d = t_central()
    t_set_phy_pending(var d, true)
    var q2 = t_phy_pdu(ll_data.OP_PHY_REQ, 2, 2)
    let _b = t_packet(var d, var q2, 0, 0, 0)
    test.assert_eq(t_next_byte(var d, 2), CODE_COLLISION)
    // A different procedure with an instant: Different Transaction Collision.
    var e = t_central()
    t_set_upd_pending(var e, true)
    var q3 = t_phy_pdu(ll_data.OP_PHY_REQ, 2, 2)
    let _c = t_packet(var e, var q3, 0, 0, 0)
    test.assert_eq(t_next_byte(var e, 2), CODE_DIFFERENT_COLLISION)
    var f = t_central()
    t_set_chm_pending(var f, true)
    var q4 = t_phy_pdu(ll_data.OP_PHY_REQ, 2, 2)
    let _d = t_packet(var f, var q4, 0, 0, 0)
    test.assert_eq(t_next_byte(var f, 2), CODE_DIFFERENT_COLLISION)
    var g = t_central()
    t_set_rq_wait(var g, true)
    var q5 = t_phy_pdu(ll_data.OP_PHY_REQ, 2, 2)
    let _e = t_packet(var g, var q5, 0, 0, 0)
    test.assert_eq(t_next_byte(var g, 2), CODE_DIFFERENT_COLLISION)
    // And the other way: a request for a connection parameter meets a PHY update of this end.
    var h = t_central()
    t_set_phy_pending(var h, true)
    var p = t_param_pdu(ll_data.OP_CONNECTION_PARAM_REQ, 24, 24, 0, 300, 0)
    let _f = t_packet(var h, var p, 0, 0, 0)
    test.assert_eq(t_next_byte(var h, 2), CODE_DIFFERENT_COLLISION)
    var i = t_central()
    t_set_phy_state(var i, PHY_WAIT_RSP)
    var p2 = t_param_pdu(ll_data.OP_CONNECTION_PARAM_REQ, 24, 24, 0, 300, 0)
    let _g = t_packet(var i, var p2, 0, 0, 0)
    test.assert_eq(t_next_byte(var i, 2), CODE_DIFFERENT_COLLISION)

@test
fn test_the_central_that_asked_decides_from_the_response()
    var c = t_central()
    test.assert_eq(link_set_phy(var c, 0, 2, 2, 0), STATUS_SUCCESS)
    t_take(var c)
    var r = t_phy_pdu(ll_data.OP_PHY_RSP, 3, 3)
    let _a = t_packet(var c, var r, 0, 0, 0)
    test.assert(c.phy_pending)
    test.assert_eq(c.phy_new, ll_phy.PHY_2M)
    test.assert_eq(c.phy_state, PHY_IDLE)
    test.assert_eq(t_next_op(var c), ll_data.OP_PHY_UPDATE_IND)
    test.assert_eq(t_next_byte(var c, 1), 2)
    // The Peripheral takes the PHY for one direction only: nothing changes, and the Host hears so.
    var d = t_central()
    test.assert_eq(link_set_phy(var d, 0, 2, 2, 0), STATUS_SUCCESS)
    t_take(var d)
    var r2 = t_phy_pdu(ll_data.OP_PHY_RSP, 2, 1)
    let _b = t_packet(var d, var r2, 0, 0, 0)
    test.assert(not d.phy_pending)
    test.assert_eq(t_next_byte(var d, 1), 0)
    test.assert_eq(d.phy_state, PHY_IDLE)
    test.assert(link_owes(var d, EV_PHY))
    var e = t_central()
    test.assert_eq(link_set_phy(var e, 0, 2, 2, 0), STATUS_SUCCESS)
    t_take(var e)
    var r3 = t_phy_pdu(ll_data.OP_PHY_RSP, 1, 2)
    let _c = t_packet(var e, var r3, 0, 0, 0)
    test.assert(not e.phy_pending)
    // A response nothing asked for is ignored.
    var f = t_central()
    var r4 = t_phy_pdu(ll_data.OP_PHY_RSP, 2, 2)
    let _d = t_packet(var f, var r4, 0, 0, 0)
    test.assert(not f.phy_pending)
    test.assert_eq(f.nxt_kind, K_EMPTY)
    // The update could not be queued: the Host hears Command Disallowed.
    var g = t_central()
    test.assert_eq(link_set_phy(var g, 0, 2, 2, 0), STATUS_SUCCESS)
    t_take(var g)
    t_fill_cq(var g)
    t_set_cq_count(var g, CTRL_SLOTS)
    var r5 = t_phy_pdu(ll_data.OP_PHY_RSP, 2, 2)
    t_set_room(var g, true)
    ctrl_rx(g, r5)
    test.assert(not g.phy_pending)
    test.assert_eq(g.phy_status, STATUS_COMMAND_DISALLOWED)

@test
fn test_the_peripheral_answers_the_request_with_one_phy_and_waits_for_the_update()
    var l = t_link()
    var q = t_phy_pdu(ll_data.OP_PHY_REQ, 7, 7)
    let _a = t_packet(var l, var q, 0, 0, 0)
    test.assert_eq(t_next_op(var l), ll_data.OP_PHY_RSP)
    test.assert_eq(t_next_byte(var l, 1), 2)
    test.assert_eq(t_next_byte(var l, 2), 2)
    test.assert_eq(l.phy_state, PHY_RESPONDED)
    test.assert_eq(l.phy_off, 2)
    // Its own request that crossed the Central's is given up for the Central's procedure.
    var m = t_link()
    test.assert_eq(link_set_phy(var m, 0, 4, 4, 0), STATUS_SUCCESS)
    var q2 = t_phy_pdu(ll_data.OP_PHY_REQ, 7, 7)
    let _b = t_packet(var m, var q2, 0, 0, 0)
    test.assert_eq(m.phy_state, PHY_RESPONDED)
    test.assert(m.phy_host)
    // With no PHY the Host and the request share, the answer is the PHY in force.
    var n = t_link()
    t_set_phy_pref_tx(var n, 4)
    t_set_phy_pref_rx(var n, 4)
    var q3 = t_phy_pdu(ll_data.OP_PHY_REQ, 3, 3)
    let _c = t_packet(var n, var q3, 0, 0, 0)
    test.assert_eq(t_next_byte(var n, 1), 1)
    test.assert_eq(t_next_byte(var n, 2), 1)
    // An update is under way: Procedure Collision.
    var o = t_link()
    t_set_phy_pending(var o, true)
    var q4 = t_phy_pdu(ll_data.OP_PHY_REQ, 2, 2)
    let _d = t_packet(var o, var q4, 0, 0, 0)
    test.assert_eq(t_next_op(var o), ll_data.OP_REJECT_EXT_IND)
    test.assert_eq(t_next_byte(var o, 2), CODE_COLLISION)

@test
fn test_the_update_indication_sets_the_phy_for_the_instant_and_the_host_hears_it_then()
    var l = t_link()
    t_set_phy_state(var l, PHY_RESPONDED)
    t_set_phy_host(var l, true)
    var u = t_update_pdu(2, 2, 30)
    let _a = t_packet(var l, var u, 0, 0, 0)
    test.assert(l.phy_pending)
    test.assert_eq(l.phy_new, 2)
    test.assert_eq(l.phy_instant, 30)
    test.assert_eq(l.phy_state, PHY_IDLE)
    test.assert_eq(l.phy, 1)
    // Events up to the instant keep the PHY; the event of the instant changes it.
    t_ev_count(var l, 29)
    let _b = link_event_begin(var l)
    test.assert_eq(l.phy, 1)
    test.assert(not link_owes(var l, EV_PHY))
    link_event_done(var l, 5000)
    let _c = link_event_begin(var l)
    test.assert_eq(l.phy, 2)
    test.assert(not l.phy_pending)
    test.assert(link_owes(var l, EV_PHY))
    test.assert_eq(l.phy_status, STATUS_SUCCESS)
    test.assert(not l.phy_host)

@test
fn test_the_update_indication_with_nothing_to_change_ends_the_procedure()
    var l = t_link()
    t_set_phy_state(var l, PHY_WAIT_IND)
    t_set_phy_host(var l, true)
    var u = t_update_pdu(0, 0, 0)
    let _a = t_packet(var l, var u, 0, 0, 0)
    test.assert_eq(l.phy_state, PHY_IDLE)
    test.assert(link_owes(var l, EV_PHY))
    test.assert(not l.phy_pending)
    // The Controller's own start for it: no event.
    var m = t_link()
    t_set_phy_state(var m, PHY_WAIT_IND)
    var u2 = t_update_pdu(0, 0, 0)
    let _b = t_packet(var m, var u2, 0, 0, 0)
    test.assert(not link_owes(var m, EV_PHY))
    // The PHY in force named again changes nothing either.
    var n = t_link()
    var u3 = t_update_pdu(1, 1, 30)
    let _c = t_packet(var n, var u3, 0, 0, 0)
    test.assert(not n.phy_pending)
    test.assert(not n.closing)

@test
fn test_an_update_for_two_phys_or_an_instant_in_the_past_ends_the_connection()
    var l = t_link()
    var u = t_update_pdu(2, 4, 30)
    let _a = t_packet(var l, var u, 0, 0, 0)
    test.assert(l.closing)
    test.assert_eq(l.reason, REASON_UNSUPPORTED_PARAMETER)
    // One direction changing alone is an asymmetric connection too.
    var m = t_link()
    var u2 = t_update_pdu(2, 0, 30)
    let _b = t_packet(var m, var u2, 0, 0, 0)
    test.assert_eq(m.reason, REASON_UNSUPPORTED_PARAMETER)
    var n = t_link()
    var u3 = t_update_pdu(0, 2, 30)
    let _c = t_packet(var n, var u3, 0, 0, 0)
    test.assert_eq(n.reason, REASON_UNSUPPORTED_PARAMETER)
    // An instant already passed.
    var o = t_link()
    t_ev_count(var o, 40)
    var u4 = t_update_pdu(2, 2, 30)
    let _d = t_packet(var o, var u4, 0, 0, 0)
    test.assert(o.closing)
    test.assert_eq(o.reason, REASON_INSTANT_PASSED)
    // A field with a bit set that is no PHY changes nothing in its direction, and a reserved bit is no PHY.
    var p = t_link()
    var u5 = t_update_pdu(0x82, 0x82, 30)
    let _e = t_packet(var p, var u5, 0, 0, 0)
    test.assert(p.phy_pending)
    test.assert_eq(p.phy_new, 2)

@test
fn test_the_roles_that_do_not_send_an_opcode_do_not_know_it()
    var c = t_central()
    var u = t_update_pdu(2, 2, 30)
    let _a = t_packet(var c, var u, 0, 0, 0)
    test.assert_eq(t_next_op(var c), ll_data.OP_UNKNOWN_RSP)
    test.assert_eq(t_next_byte(var c, 1), ll_data.OP_PHY_UPDATE_IND)
    var p = t_link()
    var r = t_phy_pdu(ll_data.OP_PHY_RSP, 2, 2)
    let _b = t_packet(var p, var r, 0, 0, 0)
    test.assert_eq(t_next_op(var p), ll_data.OP_UNKNOWN_RSP)
    test.assert_eq(t_next_byte(var p, 1), ll_data.OP_PHY_RSP)

@test
fn test_a_refused_phy_update_ends_with_the_code_for_the_host_that_asked()
    var l = t_link()
    test.assert_eq(link_set_phy(var l, 0, 2, 2, 0), STATUS_SUCCESS)
    var u = t_ctrl(ll_data.OP_UNKNOWN_RSP, [ll_data.OP_PHY_REQ])
    let _a = t_packet(var l, var u, 0, 0, 0)
    test.assert_eq(l.phy_state, PHY_IDLE)
    test.assert(l.phy_unsup)
    test.assert_eq(l.phy_status, STATUS_UNSUPPORTED_REMOTE)
    test.assert(link_owes(var l, EV_PHY))
    var m = t_link()
    test.assert_eq(link_set_phy(var m, 0, 2, 2, 0), STATUS_SUCCESS)
    var r = t_ctrl(ll_data.OP_REJECT_EXT_IND, [ll_data.OP_PHY_REQ, CODE_COLLISION])
    let _b = t_packet(var m, var r, 0, 0, 0)
    test.assert_eq(m.phy_state, PHY_IDLE)
    test.assert(not m.phy_unsup)
    test.assert_eq(m.phy_status, CODE_COLLISION)
    var n = t_link()
    test.assert_eq(link_set_phy(var n, 0, 2, 2, 0), STATUS_SUCCESS)
    var r2 = t_ctrl(ll_data.OP_REJECT_IND, [CODE_BUSY])
    let _c = t_packet(var n, var r2, 0, 0, 0)
    test.assert_eq(n.phy_state, PHY_IDLE)
    test.assert_eq(n.phy_status, CODE_BUSY)
    // The Peripheral that gave its own request up for the Central's takes no notice of the Central's reject of it.
    var o = t_link()
    t_set_phy_state(var o, PHY_RESPONDED)
    var r3 = t_ctrl(ll_data.OP_REJECT_EXT_IND, [ll_data.OP_PHY_REQ, CODE_COLLISION])
    let _d = t_packet(var o, var r3, 0, 0, 0)
    test.assert_eq(o.phy_state, PHY_RESPONDED)
    // A reject of another opcode is not about it.
    var q = t_link()
    test.assert_eq(link_set_phy(var q, 0, 2, 2, 0), STATUS_SUCCESS)
    var r4 = t_ctrl(ll_data.OP_REJECT_EXT_IND, [ll_data.OP_PING_REQ, CODE_COLLISION])
    let _e = t_packet(var q, var r4, 0, 0, 0)
    test.assert_eq(q.phy_state, PHY_WAIT_IND)

@test
fn test_the_connection_asks_for_the_data_length_once_and_for_the_phy_the_host_prefers()
    var l = t_link()
    link_set_defaults(var l, false, 27, 328, true, 2, 2)
    // Not before the peer has been heard, and not with the queue crowded.
    auto_tasks(var l)
    test.assert(not l.dl_wait)
    t_alive(var l, 3200, 5000)
    t_fill_cq(var l)
    auto_tasks(var l)
    test.assert(not l.dl_started)
    var m = t_link()
    link_set_defaults(var m, false, 27, 328, true, 2, 2)
    t_alive(var m, 3200, 5000)
    auto_tasks(var m)
    test.assert(m.dl_started)
    test.assert(m.dl_wait)
    test.assert_eq(t_next_op(var m), ll_data.OP_LENGTH_REQ)
    // The PHY request waits for the length procedure and for a few events, then goes.
    auto_tasks(var m)
    test.assert(not m.phy_auto)
    t_set_dl_wait(var m, false)
    auto_tasks(var m)
    test.assert(not m.phy_auto)
    t_ev_count(var m, AUTO_PHY_EVENTS)
    auto_tasks(var m)
    test.assert(m.phy_auto)
    test.assert_eq(m.phy_state, PHY_WAIT_IND)
    test.assert(not m.phy_host)
    // A Central with a procedure with an instant under way waits.
    var c = t_central()
    link_set_defaults(var c, false, 27, 328, true, 2, 2)
    t_alive(var c, 3200, 5000)
    t_set_dl_started(var c, true)
    t_ev_count(var c, 10)
    t_set_upd_pending(var c, true)
    auto_tasks(var c)
    test.assert(not c.phy_auto)
    t_set_upd_pending(var c, false)
    auto_tasks(var c)
    test.assert(c.phy_auto)
    test.assert_eq(c.phy_state, PHY_WAIT_RSP)
    // No preference of the Host: no request.
    var d = t_link()
    link_set_defaults(var d, false, 27, 328, false, 7, 7)
    t_alive(var d, 3200, 5000)
    t_set_dl_started(var d, true)
    t_ev_count(var d, 10)
    auto_tasks(var d)
    test.assert(not d.phy_auto)

@test
fn test_a_procedure_the_peer_does_not_answer_ends_the_connection_after_40_seconds()
    var l = t_link()
    dle_start(var l)
    t_alive(var l, 3200, 41000000)
    link_event_done(var l, 39000000)
    test.assert(not l.closing)
    link_event_done(var l, 41000001)
    test.assert(l.closing)
    test.assert_eq(l.reason, REASON_RESPONSE_TIMEOUT)
    var m = t_link()
    test.assert_eq(link_set_phy(var m, 0, 2, 2, 0), STATUS_SUCCESS)
    t_alive(var m, 3200, 41000000)
    link_event_done(var m, 39000000)
    test.assert(not m.closing)
    link_event_done(var m, 41000001)
    test.assert(m.closing)
    test.assert_eq(m.reason, REASON_RESPONSE_TIMEOUT)
    var n = t_link()
    t_set_phy_state(var n, PHY_RESPONDED)
    t_set_phy_t0(var n, 0)
    t_alive(var n, 3200, 41000000)
    link_event_done(var n, 41000001)
    test.assert(n.closing)

@test
fn test_the_connection_update_applies_the_new_interval_to_the_coded_transmit_time()
    var l = t_link()
    t_full(var l)
    t_set_dl_tx_time(var l, 17040)
    t_set_dl_rem_rx_time(var l, 17040)
    t_set_phy(var l, ll_phy.PHY_CODED)
    dle_refresh(var l)
    let before = l.dl_ev_tx_time
    test.assert_eq(before, 4496)
    link_sent(var l, EV_DATA_LENGTH)
    // An update to a 100 ms interval at the next instant: the Host is told the time grew.
    var u = t_ctrl(ll_data.OP_CONNECTION_UPDATE_IND, [2, 0, 0, 80, 0, 0, 0, 200, 0, 3, 0])
    let _a = t_packet(var l, var u, 0, 0, 0)
    t_ev_count(var l, 3)
    let _b = link_event_begin(var l)
    test.assert_eq(l.interval, 80)
    test.assert_eq(l.dl_ev_tx_time, 17040)
    test.assert(link_owes(var l, EV_DATA_LENGTH))

@test
fn test_the_booking_of_a_connection_event_grows_with_the_packets_in_force()
    var l = t_link()
    // 27 octets at LE 1M fit the base.
    test.assert_eq(link_book_us(var l, 3000), 3000)
    t_full(var l)
    // Two exchanges of 2120 us packets and 80 us acknowledgements: not more than the interval less a millisecond.
    test.assert_eq(link_book_us(var l, 3000), 6500)
    t_set_interval(var l, 80)
    test.assert_eq(link_book_us(var l, 3000), 2 * (2120 + 2120 + 300))
    // LE 2M halves the packets.
    t_set_phy(var l, ll_phy.PHY_2M)
    test.assert_eq(link_book_us(var l, 3000), 2 * (1064 + 1064 + 300))
    // LE Coded at 2704 us: 27 octets each way.
    t_set_phy(var l, ll_phy.PHY_CODED)
    test.assert_eq(link_book_us(var l, 3000), 2 * (2704 + 2704 + 300))

@test
fn test_the_central_starts_encryption_after_its_own_phy_update_is_over()
    var l = t_central()
    t_alive(var l, 3200, 5000)
    t_set_phy_pending(var l, true)
    // The Host's LE Start Encryption is taken, and the procedure waits for the instant.
    test.assert_eq(link_start_encryption(var l, 0x1234), STATUS_SUCCESS)
    test.assert(l.enc_wait)
    test.assert_eq(l.enc_ph, ENC_IDLE)
    test.assert_eq(l.cq_count, 0)
    test.assert_eq(link_start_encryption(var l, 0x1234), STATUS_COMMAND_DISALLOWED)
    auto_tasks(var l)
    test.assert(l.enc_wait)
    t_set_phy_pending(var l, false)
    auto_tasks(var l)
    test.assert(not l.enc_wait)
    test.assert_eq(l.enc_ph, ENC_NEED_RANDOM)
    test.assert_eq(l.enc_ediv, 0x1234)
    // On an encrypted link it is the pause that waits, and a crowded queue makes it wait once more.
    var m = t_central()
    t_alive(var m, 3200, 5000)
    t_set_enc_tx(var m, true)
    t_set_enc_rx(var m, true)
    t_set_phy_state(var m, PHY_WAIT_RSP)
    test.assert_eq(link_start_encryption(var m, 0x4321), STATUS_SUCCESS)
    test.assert(m.enc_wait)
    t_set_phy_state(var m, PHY_IDLE)
    t_fill_cq(var m)
    test.assert_eq(enc_begin(var m), STATUS_COMMAND_DISALLOWED)
    t_pop_cq(var m)
    t_pop_cq(var m)
    t_pop_cq(var m)
    t_pop_cq(var m)
    auto_tasks(var m)
    test.assert(not m.enc_wait)
    test.assert_eq(m.enc_ph, ENC_C_PAUSE_WAIT_RSP)
    test.assert_eq(t_next_op(var m), ll_data.OP_PAUSE_ENC_REQ)
    // A request for a PHY that is only deferred does not hold the encryption back.
    var n = t_central()
    t_alive(var n, 3200, 5000)
    t_set_phy_state(var n, PHY_DEFERRED)
    test.assert_eq(link_start_encryption(var n, 0x1111), STATUS_SUCCESS)
    test.assert(not n.enc_wait)
    test.assert_eq(n.enc_ph, ENC_NEED_RANDOM)

@test
fn test_a_request_for_a_phy_waits_for_an_encryption_procedure_and_goes_after_it()
    var l = t_link()
    t_set_enc_ph(var l, ENC_P_WAIT_LTK)
    test.assert_eq(link_set_phy(var l, 0, 2, 2, 0), STATUS_SUCCESS)
    test.assert_eq(l.phy_state, PHY_DEFERRED)
    t_alive(var l, 3200, 5000)
    auto_tasks(var l)
    test.assert_eq(l.phy_state, PHY_DEFERRED)
    t_set_enc_ph(var l, ENC_IDLE)
    auto_tasks(var l)
    test.assert_eq(l.phy_state, PHY_WAIT_IND)
    // The same while the Central's start of encryption waits.
    var m = t_central()
    t_set_enc_wait(var m, true)
    test.assert_eq(link_set_phy(var m, 0, 2, 2, 0), STATUS_SUCCESS)
    test.assert_eq(m.phy_state, PHY_DEFERRED)
    // The Controller's own start for the Host's preference waits too.
    var o = t_link()
    link_set_defaults(var o, false, 27, 328, true, 2, 2)
    t_set_enc_ph(var o, ENC_P_WAIT_START_RSP)
    t_alive(var o, 3200, 5000)
    t_set_dl_started(var o, true)
    t_ev_count(var o, 10)
    auto_tasks(var o)
    test.assert(not o.phy_auto)

// The opcode and a byte of the PDU at the head of the control queue, behind the one in
// flight.
fn t_cq_op(var l: Link) -> Int
    var p = ll_pdu.pdu_new()
    slot_get_cq(var l, l.cq_head, var p)
    ll_data.dpdu_opcode(var p)

fn t_cq_byte(var l: Link, i: Int) -> Int
    var p = ll_pdu.pdu_new()
    slot_get_cq(var l, l.cq_head, var p)
    ll_data.dpdu_byte(var p, i)

// ── The Central's Connection Parameters Request and the anchor offsets ──────

@test
fn test_the_central_asks_the_peer_with_a_connection_parameters_request()
    var l = t_central()
    test.assert_eq(link_connection_update(var l, 24, 40, 0, 400), STATUS_SUCCESS)
    test.assert_eq(l.proc, PROC_PARAM)
    test.assert(not l.upd_pending)
    test.assert_eq(t_next_op(var l), ll_data.OP_CONNECTION_PARAM_REQ)
    // A range names a preferred periodicity (the minimum), a single interval needs none.
    test.assert_eq(t_next_byte(var l, 9), 24)
    var m = t_central()
    test.assert_eq(link_connection_update(var m, 24, 24, 0, 400), STATUS_SUCCESS)
    test.assert_eq(t_next_byte(var m, 9), 0)
    // A second update waits for the first.
    test.assert_eq(link_connection_update(var l, 30, 30, 0, 400), STATUS_COMMAND_DISALLOWED)

@test
fn test_the_central_updates_with_the_peripherals_response()
    var l = t_central()
    test.assert_eq(link_connection_update(var l, 24, 40, 0, 400), STATUS_SUCCESS)
    var r = t_param_pdu(ll_data.OP_CONNECTION_PARAM_RSP, 24, 40, 0, 400, 24)
    let _a = t_packet(var l, var r, 0, 0, 0)
    test.assert_eq(l.proc, PROC_NONE)
    test.assert(l.upd_pending)
    test.assert(l.upd_host)
    test.assert_eq(l.upd_interval, 24)
    test.assert_eq(t_cq_op(var l), ll_data.OP_CONNECTION_UPDATE_IND)
    // Values out of range end the procedure with a reject, and the Host is told.
    var m = t_central()
    test.assert_eq(link_connection_update(var m, 24, 40, 0, 400), STATUS_SUCCESS)
    var bad = t_param_pdu(ll_data.OP_CONNECTION_PARAM_RSP, 4, 6, 0, 400, 0)
    let _b = t_packet(var m, var bad, 0, 0, 0)
    test.assert_eq(m.proc, PROC_NONE)
    test.assert(not m.upd_pending)
    test.assert_eq(t_cq_op(var m), ll_data.OP_REJECT_EXT_IND)
    test.assert_eq(t_cq_byte(var m, 2), CODE_INVALID_LL_PARAMETERS)
    test.assert_eq(m.upd_status, CODE_INVALID_LL_PARAMETERS)
    test.assert(link_owes(var m, EV_UPDATED))

@test
fn test_the_central_falls_back_to_the_update_when_the_peer_lacks_the_procedure()
    // LL_UNKNOWN_RSP (BV-81), and the peer is remembered.
    var l = t_central()
    test.assert_eq(link_connection_update(var l, 24, 40, 0, 400), STATUS_SUCCESS)
    var u = t_ctrl(ll_data.OP_UNKNOWN_RSP, [ll_data.OP_CONNECTION_PARAM_REQ])
    let _a = t_packet(var l, var u, 0, 0, 0)
    test.assert(l.cpr_no)
    test.assert_eq(l.proc, PROC_NONE)
    test.assert(l.upd_pending)
    test.assert_eq(l.upd_interval, 40)
    test.assert_eq(t_cq_op(var l), ll_data.OP_CONNECTION_UPDATE_IND)
    // A peer whose features lack the procedure is sent the update at once (BV-82).
    var n = t_central()
    t_have_features(var n, 0x00)
    test.assert_eq(link_connection_update(var n, 24, 40, 0, 400), STATUS_SUCCESS)
    test.assert(n.upd_pending)
    test.assert_eq(n.proc, PROC_NONE)
    // Unsupported Remote Feature from a legacy Host (BV-29) does the same.
    var o = t_central()
    test.assert_eq(link_connection_update(var o, 24, 40, 0, 400), STATUS_SUCCESS)
    var r = t_ctrl(ll_data.OP_REJECT_EXT_IND, [ll_data.OP_CONNECTION_PARAM_REQ, STATUS_UNSUPPORTED_REMOTE])
    let _b = t_packet(var o, var r, 0, 0, 0)
    test.assert(o.upd_pending)
    test.assert_eq(o.proc, PROC_NONE)
    test.assert_eq(t_cq_op(var o), ll_data.OP_CONNECTION_UPDATE_IND)
    // Any other code is the Host's answer (BV-25).
    var q = t_central()
    test.assert_eq(link_connection_update(var q, 24, 40, 0, 400), STATUS_SUCCESS)
    var s = t_ctrl(ll_data.OP_REJECT_EXT_IND, [ll_data.OP_CONNECTION_PARAM_REQ, 0x3B])
    let _c = t_packet(var q, var s, 0, 0, 0)
    test.assert(not q.upd_pending)
    test.assert_eq(q.upd_status, 0x3B)
    test.assert(link_owes(var q, EV_UPDATED))

@test
fn test_the_central_refuses_a_request_while_its_own_is_out()
    var l = t_central()
    test.assert_eq(link_connection_update(var l, 24, 40, 0, 400), STATUS_SUCCESS)
    var r = t_param_pdu(ll_data.OP_CONNECTION_PARAM_REQ, 30, 30, 0, 400, 0)
    let _a = t_packet(var l, var r, 0, 0, 0)
    test.assert_eq(t_cq_op(var l), ll_data.OP_REJECT_EXT_IND)
    test.assert_eq(t_cq_byte(var l, 2), CODE_COLLISION)
    test.assert_eq(l.proc, PROC_PARAM)

@test
fn test_the_anchor_offset_follows_the_specifications_example()
    // Section 5.1.7.3.3: old interval 12, new 30, Instant 0x1F06, Reference 0x1F00,
    // Offset0 3 units: 21 units after the instant.
    test.assert_eq(anchor_offset(12, 30, 0x1F06, 0x1F00, 3), 21)
    // The same interval: the offset itself, and an offset of the interval less one unit.
    test.assert_eq(anchor_offset(24, 24, 0x0100, 0x00F6, 1), 1)
    test.assert_eq(anchor_offset(24, 24, 0x0100, 0x00F6, 23), 23)
    // A Reference after the Instant, and across the wrap of the counter.
    test.assert_eq(anchor_offset(12, 30, 0x1F00, 0x1F06, 3), 15)
    test.assert_eq(anchor_offset(12, 30, 0x0002, 0xFFFC, 3), 21)

@test
fn test_the_first_valid_offset_is_the_one_used()
    var p = t_param_pdu(ll_data.OP_CONNECTION_PARAM_REQ, 24, 24, 0, 400, 0)
    test.assert_eq(first_offset(var p), -1)
    p.b[16] = 0x02
    p.b[17] = 0x00
    test.assert_eq(first_offset(var p), 2)
    p.b[14] = 0x07
    p.b[15] = 0x00
    test.assert_eq(first_offset(var p), 7)

@test
fn test_a_request_that_moves_the_anchor_points_alone_is_not_asked_of_the_host()
    // The Central sets the transmit window offset from Offset0 (BV-31): 1.25 ms.
    var l = t_central()
    link_set_indicate(var l, true)
    var r = t_param_pdu(ll_data.OP_CONNECTION_PARAM_REQ, l.interval, l.interval, l.latency, l.timeout, 0)
    r.b[14] = 0x01
    r.b[15] = 0x00
    let _a = t_packet(var l, var r, 0, 0, 0)
    test.assert(not l.rq_wait)
    test.assert(not link_owes(var l, EV_PARAM_REQUEST))
    test.assert(l.upd_pending)
    test.assert_eq(l.upd_win_offset, 1)
    test.assert_eq(l.upd_interval, l.interval)
    test.assert_eq(t_next_op(var l), ll_data.OP_CONNECTION_UPDATE_IND)
    // The Peripheral answers with LL_CONNECTION_PARAM_RSP.
    var m = t_link()
    link_set_indicate(var m, true)
    var s = t_param_pdu(ll_data.OP_CONNECTION_PARAM_REQ, m.interval, m.interval, m.latency, m.timeout, 0)
    s.b[14] = 0x01
    s.b[15] = 0x00
    let _b = t_packet(var m, var s, 0, 0, 0)
    test.assert(not m.rq_wait)
    test.assert_eq(t_next_op(var m), ll_data.OP_CONNECTION_PARAM_RSP)

@test
fn test_the_offset_of_a_request_the_host_accepted_reaches_the_update()
    // BV-33: a new interval with a preferred periodicity and Offset0, the Host accepts.
    var l = t_central()
    link_set_indicate(var l, true)
    var r = t_param_pdu(ll_data.OP_CONNECTION_PARAM_REQ, 24, 40, 0, 400, 24)
    r.b[14] = 0x01
    r.b[15] = 0x00
    let _a = t_packet(var l, var r, 0, 0, 0)
    test.assert(l.rq_wait)
    test.assert_eq(l.rq_off, 1)
    test.assert_eq(link_param_reply(var l, 24, 40, 0, 400), STATUS_SUCCESS)
    test.assert(l.upd_pending)
    test.assert_eq(l.upd_interval, 24)
    test.assert_eq(l.upd_win_offset, anchor_offset(l.interval, 24, l.upd_instant, l.rq_ref, 1))

// ── Connection Rate (a build with `ctl_limits.rate_on()`; a build without it answers the PDUs as unknown) ────────────

// LL_CONNECTION_RATE_IND from the Central: the window offset and interval (125 us), the instant, the factor, latency, continuation number and timeout.
fn t_rate_ind(woff: Int, iv: Int, instant: Int, factor: Int, lat: Int, cont: Int, to: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    ll_rate.put_ind(var p, woff, iv, instant, factor, lat, cont, to)
    p

// LL_CONNECTION_RATE_REQ from the Peripheral with a usual range.
fn t_rate_req() -> Pdu
    var p = ll_pdu.pdu_new()
    ll_rate.put_req(var p, 60, 400, 1, 4, 0, 0, 500, 0, 0, 0xFFFF)
    p

@test
fn test_a_build_without_connection_rate_answers_its_pdus_as_unknown()
    if ctl_limits.rate_on()
        return
    var l = t_link()
    var p = t_rate_ind(0, 240, 6, 4, 0, 1, 300)
    let _r = t_packet(var l, var p, 0, 0, 0)
    test.assert(not l.upd_pending)
    test.assert_eq(ll_data.dpdu_opcode(var l.nxt), ll_data.OP_UNKNOWN_RSP)
    test.assert_eq(ll_data.dpdu_byte(var l.nxt, 1), 0x3F)
    var m = t_central()
    var q = t_rate_req()
    let _s = t_packet(var m, var q, 0, 0, 0)
    test.assert_eq(ll_data.dpdu_opcode(var m.nxt), ll_data.OP_UNKNOWN_RSP)
    test.assert_eq(ll_data.dpdu_byte(var m.nxt, 1), 0x3E)

@test
fn test_a_peripheral_applies_the_rate_indication_at_its_instant()
    if not ctl_limits.rate_on()
        return
    var l = t_link()
    let _c0 = link_event_begin(var l)
    link_note_rx(var l, 3100, true)
    link_event_done(var l, 3600)
    // Window offset 40 (5 ms), interval 240 (30 ms), instant 6, factor 4, latency 0, continuation 1, timeout 300.
    var u = t_rate_ind(40, 240, 6, 4, 0, 1, 300)
    let _r = t_packet(var l, var u, 0, 0, 0)
    test.assert(l.upd_pending)
    test.assert_eq(l.upd_instant, 6)
    test.assert_eq(fx_get(l, FX_RATE, 1), 1)
    for _ in 1..5
        let _ch = link_event_begin(var l)
        test.assert_eq(l.interval, 6)
        link_note_rx(var l, l.due, true)
        link_event_done(var l, l.due + 500)
    let _c5 = link_event_begin(var l)
    link_note_rx(var l, l.due, true)
    let a5 = l.anchor
    link_event_done(var l, a5 + 500)
    // The instant event starts one old interval and the window offset after the last event of the old connection; no window is open.
    test.assert_eq(l.due, a5 + 7500 + 4 * 1250)
    test.assert_eq(l.win_len, 0)
    let due6 = l.due
    let _c6 = link_event_begin(var l)
    test.assert_eq(l.interval, 24)
    test.assert_eq(l.timeout, 300)
    test.assert_eq(l.sub_factor as Int, 4)
    test.assert_eq(l.sub_cont as Int, 1)
    test.assert_eq(l.sub_res as Int, 2)
    test.assert(not l.upd_pending)
    test.assert_eq(fx_get(l, FX_RATE, 1), 0)
    test.assert_eq(fx_get(l, FX_RATEEV, 1), 1)
    test.assert(link_owes(var l, EV_SUBRATE))
    test.assert(not link_owes(var l, EV_UPDATED))
    test.assert_eq(l.last_rx, due6)
    link_note_rx(var l, due6 + 1000, true)
    link_event_done(var l, due6 + 1500)
    // The events 7 to 9 are not used: the next used one is event 10, four new intervals after the first.
    test.assert_eq(l.ev_count, 10)
    test.assert_eq(l.due, due6 + 1000 + 4 * 30000)

@test
fn test_an_indication_with_a_value_this_link_layer_does_not_support_is_unknown()
    if not ctl_limits.rate_on()
        return
    // An interval or a window offset that is not a multiple of 1.25 ms, a window offset past the interval, a factor or continuation number
    // out of range, a timeout out of range or too short for the interval.
    let bad: [[Int]] = [[0, 245, 6, 4, 0, 1, 300], [15, 240, 6, 4, 0, 1, 300], [250, 240, 6, 4, 0, 1, 300], [0, 240, 6, 0, 0, 0, 300],
                        [0, 240, 6, 501, 0, 0, 300], [0, 240, 6, 4, 0, 4, 300], [0, 240, 6, 4, 125, 0, 300], [0, 240, 6, 4, 0, 1, 9],
                        [0, 240, 6, 4, 0, 1, 3201], [0, 240, 6, 100, 4, 0, 50], [0, 9, 6, 1, 0, 0, 300]]
    for v in bad
        var l = t_link()
        var u = t_rate_ind(v[0], v[1], v[2], v[3], v[4], v[5], v[6])
        let _r = t_packet(var l, var u, 0, 0, 0)
        test.assert(not l.upd_pending)
        test.assert_eq(ll_data.dpdu_opcode(var l.nxt), ll_data.OP_UNKNOWN_RSP)
        test.assert_eq(ll_data.dpdu_byte(var l.nxt, 1), 0x3F)

@test
fn test_an_indication_whose_instant_has_passed_ends_the_connection()
    if not ctl_limits.rate_on()
        return
    var l = t_link()
    var u = t_rate_ind(0, 240, 0, 4, 0, 1, 300)
    let _r = t_packet(var l, var u, 0, 0, 0)
    test.assert(not l.upd_pending)
    test.assert_eq(l.reason, REASON_INSTANT_PASSED)

@test
fn test_each_role_knows_only_the_connection_rate_pdu_it_receives()
    if not ctl_limits.rate_on()
        return
    // The Central does not read LL_CONNECTION_RATE_IND, the Peripheral does not read LL_CONNECTION_RATE_REQ.
    var c = t_central()
    var u = t_rate_ind(0, 240, 6, 4, 0, 1, 300)
    let _r = t_packet(var c, var u, 0, 0, 0)
    test.assert(not c.upd_pending)
    test.assert_eq(ll_data.dpdu_opcode(var c.nxt), ll_data.OP_UNKNOWN_RSP)
    var l = t_link()
    var q = t_rate_req()
    let _s = t_packet(var l, var q, 0, 0, 0)
    test.assert_eq(ll_data.dpdu_opcode(var l.nxt), ll_data.OP_UNKNOWN_RSP)
    test.assert_eq(ll_data.dpdu_byte(var l.nxt, 1), 0x3E)
    // A Central passes the request on to the Controller.
    var m = t_central()
    var p = t_rate_req()
    let _t = t_packet(var m, var p, 0, 0, 0)
    test.assert(m.ctl_in)

@test
fn test_a_central_sends_the_indication_and_applies_it_at_the_instant()
    if not ctl_limits.rate_on()
        return
    var l = t_central()
    let _c0 = link_event_begin(var l)
    link_note_rx(var l, 3100, true)
    link_event_done(var l, 3600)
    // The Host asked: 30 ms, factor 4, latency 0, continuation 1, timeout 300.
    test.assert_eq(rate_central_start(var l, 24, 4, 0, 1, 300, true, 0, -1), STATUS_SUCCESS)
    test.assert(l.upd_pending)
    test.assert_eq(fx_get(l, FX_RATE, 1), 1)
    test.assert_eq(t_next_op(var l), ll_data.OP_CONNECTION_RATE_IND)
    test.assert_eq(ll_sub.get16(var l.nxt, 1), 0)
    test.assert_eq(ll_sub.get16(var l.nxt, 3), 240)
    test.assert_eq(ll_sub.get16(var l.nxt, 5), l.upd_instant)
    test.assert_eq(ll_sub.get16(var l.nxt, 7), 4)
    test.assert_eq(ll_sub.get16(var l.nxt, 11), 1)
    test.assert_eq(ll_sub.get16(var l.nxt, 13), 300)
    // The instant is the least the Peripheral's events away that Section 5.5 asks for.
    test.assert_eq(l.upd_instant, (l.ev_count + INSTANT_LEAD + INSTANT_SLACK) & 0xFFFF)
    // Another update cannot start beside it.
    test.assert(not sub_can_start(var l))
    var guard = 0
    while l.ev_count != l.upd_instant and guard < 40
        let _e = link_event_begin(var l)
        link_note_rx(var l, l.due, true)
        link_event_done(var l, l.due + 500)
        guard = guard + 1
    let _ci = link_event_begin(var l)
    test.assert_eq(l.interval, 24)
    test.assert_eq(l.sub_factor as Int, 4)
    test.assert_eq(l.sub_cont as Int, 1)
    test.assert_eq(l.sub_res as Int, l.upd_instant % 4)
    test.assert(link_owes(var l, EV_SUBRATE))
    test.assert_eq(fx_get(l, FX_RATEEV, 1), 1)

@test
fn test_the_host_hears_of_a_rate_update_that_changed_nothing_when_it_asked()
    if not ctl_limits.rate_on()
        return
    var l = t_central()
    let _c0 = link_event_begin(var l)
    link_note_rx(var l, 3100, true)
    link_event_done(var l, 3600)
    // The values in force: interval 6, latency 0, timeout 200 (the usual request), factor 1.
    test.assert_eq(rate_central_start(var l, 6, 1, 0, 0, 200, false, 0, -1), STATUS_SUCCESS)
    var guard = 0
    while l.ev_count != l.upd_instant and guard < 40
        let _e = link_event_begin(var l)
        link_note_rx(var l, l.due, true)
        link_event_done(var l, l.due + 500)
        guard = guard + 1
    let _ci = link_event_begin(var l)
    test.assert(not link_owes(var l, EV_SUBRATE))
    // The same update at the Host's asking is reported.
    var m = t_central()
    let _m0 = link_event_begin(var m)
    link_note_rx(var m, 3100, true)
    link_event_done(var m, 3600)
    test.assert_eq(rate_central_start(var m, 6, 1, 0, 0, 200, true, 0, -1), STATUS_SUCCESS)
    guard = 0
    while m.ev_count != m.upd_instant and guard < 40
        let _e = link_event_begin(var m)
        link_note_rx(var m, m.due, true)
        link_event_done(var m, m.due + 500)
        guard = guard + 1
    let _mi = link_event_begin(var m)
    test.assert(link_owes(var m, EV_SUBRATE))
    test.assert_eq(m.sub_status as Int, STATUS_SUCCESS)

@test
fn test_the_anchor_offset_of_a_request_moves_the_first_event_of_the_new_rate()
    if not ctl_limits.rate_on()
        return
    var l = t_central()
    let _c0 = link_event_begin(var l)
    link_note_rx(var l, 3100, true)
    link_event_done(var l, 3600)
    // The peer prefers an anchor 2 units (2.5 ms) after its event `ref`.
    test.assert_eq(rate_central_start(var l, 24, 1, 0, 0, 300, false, l.ev_count, 2), STATUS_SUCCESS)
    test.assert_eq(l.upd_win_offset, anchor_offset(6, 24, l.upd_instant, l.ev_count, 2))
    test.assert_eq(ll_sub.get16(var l.nxt, 1), l.upd_win_offset * 10)

@test
fn test_page_1_bits_of_the_peer_and_the_host_support_bit()
    var l = t_link()
    // Features 72 and 73 are bits 8 and 9 of page 1; a peer's page is held once the exchange has run.
    test.assert(not rate_peer_ok(l))
    fx_put(var l, FX_PEER, 0xFFFFFF, 0x300)
    fx_put(var l, FX_HAVE, 1, 1)
    test.assert(rate_peer_ok(l))
    fx_put(var l, FX_PEER, 0xFFFFFF, 0x100)
    test.assert(not rate_peer_ok(l))
    // The Host support bit goes to the peer in page 1, and survives a reset of the link.
    test.assert(not rate_host(l))
    link_set_host_rate(var l, true)
    test.assert(rate_host(l))
    test.assert_eq(fx_get(l, FX_LOCAL, 0xFFFF) & 0x200, 0x200)
    link_reset(var l)
    test.assert(rate_host(l))
    link_set_host_rate(var l, false)
    test.assert(not rate_host(l))

@test
fn test_the_local_page_1_bit_72_follows_the_build()
    var l = link_new()
    var want = 0
    if ctl_limits.rate_on()
        want = 0x100
    // Bit 65, Frame Space Update, is bit 1 of page 1.
    if ctl_limits.fs_on()
        want = want | 0x2
    test.assert_eq(fx_get(l, FX_LOCAL, 0xFFFF), want)
    test.assert_eq(ctl_limits.page1_bits(), want)

@test
fn test_a_peer_is_known_to_lack_frame_space_update_from_either_page()
    var l = t_link()
    test.assert(not fs_peer_lacks(l))
    // Page 0 without feature 63: there is no page 1.
    t_peer_features(var l, 7, 0)
    test.assert(fs_peer_lacks(l))
    t_peer_features(var l, 7, ll_feat.OCTET7_EXT)
    test.assert(not fs_peer_lacks(l))
    // Page 1 held: bit 65 decides.
    fx_put(var l, FX_PEER, 0xFFFFFF, 0x100)
    fx_put(var l, FX_HAVE, 1, 1)
    test.assert(fs_peer_lacks(l))
    fx_put(var l, FX_PEER, 0xFFFFFF, 0x102)
    test.assert(not fs_peer_lacks(l))

@test
fn test_frame_space_pdus_reach_the_controller_in_either_role_when_the_build_has_the_feature()
    var l = t_link()
    var m = t_central()
    var q = ll_pdu.pdu_new()
    ll_fs.put_req(var q, 150, 150, 1, 1)
    var r = ll_pdu.pdu_new()
    ll_fs.put_rsp(var r, 150, 0, 0)
    var bad = ll_pdu.pdu_new()
    ll_data.ctrl_begin(var bad, ll_data.OP_FRAME_SPACE_REQ)
    ll_data.dpdu_finish(var bad)
    if not ctl_limits.fs_on()
        // A build without the feature answers both PDUs as unknown.
        let _a = t_packet(var l, var q, 0, 0, 0)
        test.assert(not l.ctl_in)
        test.assert_eq(ll_data.dpdu_opcode(var l.nxt), ll_data.OP_UNKNOWN_RSP)
        test.assert_eq(ll_data.dpdu_byte(var l.nxt, 1), 0x3B)
        let _b = t_packet(var m, var r, 0, 0, 0)
        test.assert_eq(ll_data.dpdu_byte(var m.nxt, 1), 0x3C)
        return
    let _c = t_packet(var l, var q, 0, 0, 0)
    test.assert(l.ctl_in)
    let _d = t_packet(var m, var r, 0, 0, 0)
    test.assert(m.ctl_in)
    // A PDU of the wrong length is dropped, as the others are.
    var n = t_link()
    let _e = t_packet(var n, var bad, 0, 0, 0)
    test.assert(not n.ctl_in)
    // A refusal of the request reaches the Controller.
    var k = t_link()
    var u = ll_pdu.pdu_new()
    ll_data.ctrl_unknown_rsp(var u, ll_data.OP_FRAME_SPACE_REQ)
    let _f = t_packet(var k, var u, 0, 0, 0)
    test.assert(k.ctl_in)

@test
fn test_the_controllers_own_page_fetch_is_not_told_to_the_host()
    if not ctl_limits.rate_on() or not ctl_limits.feat_on()
        return
    var l = t_central()
    t_peer_features(var l, 7, ll_feat.OCTET7_EXT)
    test.assert_eq(rate_fetch(var l), STATUS_SUCCESS)
    test.assert_eq(t_next_op(var l), ll_data.OP_FEATURE_EXT_REQ)
    test.assert(not rate_fetch_over(l))
    var r = ll_pdu.pdu_new()
    ll_feat.put_ext(var r, ll_data.OP_FEATURE_EXT_RSP, 1, 1, 0x300)
    let _a = t_packet(var l, var r, 0, 0, 0)
    test.assert(rate_fetch_over(l))
    test.assert(rate_peer_ok(l))
    test.assert(not link_owes(var l, EV_FEATEXT))
