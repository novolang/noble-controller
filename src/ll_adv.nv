// src/ll_adv.nv — the legacy Advertising state of the Link Layer:
// the parameters the Host set, the advertising event sequence, the timing
// between events, and the answer to a request that arrives after a PDU.
//
// [Vol 6] Part B, Section 4.4.2.  An advertising event sends one PDU on each
// used advertising channel, in ascending channel order.  After a PDU of a
// scannable or connectable type the advertiser listens for a request on the
// same channel, a T_IFS of 150 microseconds after the PDU.  The start of one
// event to the start of the next is advInterval plus advDelay, a pseudo-random
// 0 to 10 ms.  High duty cycle directed advertising sends events back to back
// for at most 1.28 s.
//
// This module holds no radio.  A caller that owns a radio drives it with the
// calls in the order the event runs:
//
//   adv_enable        enter the Advertising state; the first event is due soon
//   adv_due           the time the next PDU is to start
//   adv_pdu_start     the PDU on `adv_channel` starts at a time; the PDU to
//                     send is `pdu`, the scan response `rsp_pdu`
//   adv_rx            a request arrived after the PDU; the answer says whether
//                     to send the scan response
//   adv_pdu_end       the PDU and the exchange after it ended at a time
//
// Connection requests are received and counted.  No connection is made.
//
// The state is a value with inline storage; no function here allocates.

use ctl_limits
use std.test
use ll_pdu

// The functions below take the state as a `var` parameter even where they only read
// it, which passes its address.  A plain parameter is a copy, and a copy of a
// struct of this size on every call costs time and stack.

// Advertising_Type values as HCI numbers them.
const TYPE_IND = 0
const TYPE_DIRECT_HIGH = 1
const TYPE_SCAN = 2
const TYPE_NONCONN = 3
const TYPE_DIRECT_LOW = 4

// The engine's own type for a set of extended advertising PDUs that can be connected to and not scanned (`ll_xadv.nv`): an
// ADV_IND would also take a SCAN_REQ.  LE Set Advertising Parameters never accepts it.
const TYPE_CONN_ONLY = 5

// The limits of Advertising_Interval_Min and Advertising_Max, in units of
// 0.625 ms, [Vol 4] Part E, Section 7.8.5.
const INTERVAL_MIN = 0x0020
const INTERVAL_MAX = 0x4000

// The microseconds in one interval unit.
const UNIT_US = 625

// The defaults a Reset restores: an interval of 1.28 s.
const DEFAULT_INTERVAL = 0x0800

// advDelay is 0 to 10 ms ([Vol 6] Part B, Section 4.4.2.2.1).
const ADV_DELAY_MAX_US = 10000

// High duty cycle directed advertising ends 1.28 s after it began (Section
// 4.4.2.4.3).
const HIGH_DUTY_TIMEOUT_US = 1280000

// The pause the radio gets between the end of one PDU's exchange and the
// start of the next PDU of the same event.  It is the time the program needs
// to point the radio at the next channel; the PDUs of an event then start well
// within the 10 ms of Section 4.4.2.3, and within the 3.75 ms of Section
// 4.4.2.4.3 for three channels of the shortest exchange.
const PDU_GAP_US = 300

// The first event starts this long after advertising is enabled.
const FIRST_EVENT_US = 1000

// Advertising_Filter_Policy values.
const POLICY_ALL = 0
const POLICY_SCAN_LIST = 1
const POLICY_CONNECT_LIST = 2
const POLICY_BOTH_LIST = 3

// What `adv_rx` found in the PDU received after an advertisement.
const RX_NONE = 0
const RX_SCAN_REQ = 1
const RX_CONNECT_IND = 2

// `int_min` and `int_max` are the interval range, `ty` the Advertising_Type,
// `own` the Own_Address_Type, `peer_type` and `peer` the directed target,
// `chmap` the channel map and `policy` the filter policy.  `data` and `rsp`
// are the advertising data and scan response data with `data_len` and
// `rsp_len` significant octets.
//
// `enabled` says the Advertising state is on.  `entered` is the time it was
// entered and `due` the time the PDU of slot `idx` is to start; `idx` counts
// the used channels sent in the running event, and `anchor` is the start of
// the event's first PDU.  `addr` and `addr_type` are the advertiser's address
// of the running state, fixed at `adv_enable`.  `rng` is the generator
// advDelay draws from.  `pdu` and `rsp_pdu` are the PDUs of the running event.
// `timed_out` is set when high duty cycle directed advertising ran out.
// The counters follow; `filt_type` and `filt_addr` are the sender of the last
// request the filter policy refused.
@value
struct Adv
    int_min: Int
    int_max: Int
    ty: u8
    own: u8
    peer_type: u8
    peer: Vec[u8; 6]
    chmap: u8
    policy: u8
    data: Vec[u8; 31]
    data_len: u8
    rsp: Vec[u8; 31]
    rsp_len: u8
    enabled: Bool
    timed_out: Bool
    entered: Int
    due: Int
    anchor: Int
    idx: u8
    addr: Vec[u8; 6]
    addr_type: u8
    tgt: Vec[u8; 6]
    tgt_type: u8
    rng: Int
    pdu: Pdu
    rsp_pdu: Pdu
    events: Int
    pdus: Int
    scan_reqs: Int
    scan_rsps: Int
    connect_inds: Int
    filtered: Int
    filt_type: u8
    filt_addr: Vec[u8; 6]
    fam: u8

// The generator step: a 32-bit xorshift.  A zero state is replaced.
@tier(embedded)
fn rng_step(x: Int) -> Int
    var v = x & 0xFFFFFFFF
    if v == 0
        v = 0x9E3779B9
    v = v ^ ((v << 13) & 0xFFFFFFFF)
    v = v ^ (v >>> 17)
    v = v ^ ((v << 5) & 0xFFFFFFFF)
    v & 0xFFFFFFFF

// An advertiser in its power-on state: off, with the default parameters.
@tier(embedded)
fn adv_new() -> Adv
    var a = Adv {
        int_min: DEFAULT_INTERVAL, int_max: DEFAULT_INTERVAL, ty: 0, own: 0, peer_type: 0,
        peer: Vec.new(), chmap: 7, policy: 0, data: Vec.new(), data_len: 0,
        rsp: Vec.new(), rsp_len: 0, enabled: false, timed_out: false, entered: 0, due: 0,
        anchor: 0, idx: 0, addr: Vec.new(), addr_type: 0, tgt: Vec.new(), tgt_type: 0, rng: 0x2545F491,
        pdu: ll_pdu.pdu_new(), rsp_pdu: ll_pdu.pdu_new(),
        events: 0, pdus: 0, scan_reqs: 0, scan_rsps: 0, connect_inds: 0,
        filtered: 0, filt_type: 0, filt_addr: Vec.new(), fam: 0 }
    for _ in 0..6
        let _a = a.peer.push(0)
        let _b = a.addr.push(0)
        let _c = a.filt_addr.push(0)
        let _t = a.tgt.push(0)
    for _ in 0..31
        let _c = a.data.push(0)
        let _d = a.rsp.push(0)
    a

// The state a Reset restores: advertising off, the default parameters, no
// data.  The generator and the counters stay.
@tier(embedded)
fn adv_reset(var a: Adv)
    a.int_min = DEFAULT_INTERVAL
    a.int_max = DEFAULT_INTERVAL
    a.ty = 0
    a.own = 0
    a.peer_type = 0
    a.chmap = 7
    a.policy = 0
    a.data_len = 0
    a.rsp_len = 0
    a.enabled = false
    a.timed_out = false
    a.idx = 0
    a.fam = 0
    for i in 0..6
        a.peer[i] = 0
    for i in 0..31
        a.data[i] = 0
        a.rsp[i] = 0

// Seed the advDelay generator.
@tier(embedded)
fn adv_seed(var a: Adv, seed: Int)
    a.rng = rng_step(seed ^ 0x2545F491)

// The Status of LE Set Advertising Parameters for the values given: Success
// (0), Invalid HCI Command Parameters (0x12) for a value out of range, or
// Unsupported Feature or Parameter Value (0x11) for an Own_Address_Type that
// needs a resolving list.
@satisfies("REQ-BLE-CTL-007")
@tier(embedded)
fn params_status(int_min: Int, int_max: Int, ty: Int, own: Int, peer_type: Int, chmap: Int, policy: Int) -> Int
    if ty > TYPE_DIRECT_LOW
        return 0x12
    if own > 3
        return 0x12
    if peer_type > 1
        return 0x12
    if chmap == 0 or chmap > 7
        return 0x12
    if policy > 3
        return 0x12
    if ty != TYPE_DIRECT_HIGH
        if int_min < INTERVAL_MIN or int_max > INTERVAL_MAX or int_min > int_max
            return 0x12
    0

// Set the parameters.  The caller has checked `params_status`.
@tier(embedded)
fn adv_set_params(var a: Adv, int_min: Int, int_max: Int, ty: Int, own: Int, peer_type: Int, chmap: Int, policy: Int)
    a.int_min = int_min
    a.int_max = int_max
    a.ty = ty as u8
    a.own = own as u8
    a.peer_type = peer_type as u8
    a.chmap = chmap as u8
    a.policy = policy as u8

// Set the advertising data: `len` octets from `data` (the 31 octets the
// command carries).
@tier(embedded)
fn adv_set_data(var a: Adv, len: Int, var data: Vec[u8; 31])
    a.data_len = len as u8
    for i in 0..31
        a.data[i] = data[i]

// Set the scan response data.
@tier(embedded)
fn adv_set_scan_rsp(var a: Adv, len: Int, var data: Vec[u8; 31])
    a.rsp_len = len as u8
    for i in 0..31
        a.rsp[i] = data[i]

// Set only the number of significant octets of the data, or of the scan
// response data.
@tier(embedded)
fn adv_set_data_len(var a: Adv, len: Int)
    a.data_len = len as u8

@tier(embedded)
fn adv_set_rsp_len(var a: Adv, len: Int)
    a.rsp_len = len as u8

// Set the peer address of directed advertising.
@tier(embedded)
fn adv_set_peer(var a: Adv, var peer: Vec[u8; 6])
    for i in 0..6
        a.peer[i] = peer[i]

// Set the channel map and the filter policy.
@tier(embedded)
fn adv_set_map_policy(var a: Adv, chmap: Int, policy: Int)
    a.chmap = chmap as u8
    a.policy = policy as u8

// Whether the advertising type is directed.
@tier(embedded)
fn is_directed(ty: Int) -> Bool
    ty == TYPE_DIRECT_HIGH or ty == TYPE_DIRECT_LOW

// Whether a scan request may follow the advertising type's PDU.
@tier(embedded)
fn is_scannable(ty: Int) -> Bool
    ty == TYPE_IND or ty == TYPE_SCAN

// Whether a connection request may follow it.
@tier(embedded)
fn is_connectable(ty: Int) -> Bool
    ty == TYPE_IND or ty == TYPE_DIRECT_HIGH or ty == TYPE_DIRECT_LOW or ty == TYPE_CONN_ONLY

// The PDU Type the advertising type sends.
@tier(embedded)
fn pdu_type_of(ty: Int) -> Int
    match ty
        0 => ll_pdu.ADV_IND
        1 => ll_pdu.ADV_DIRECT_IND
        2 => ll_pdu.ADV_SCAN_IND
        3 => ll_pdu.ADV_NONCONN_IND
        _ => ll_pdu.ADV_DIRECT_IND

// The number of channels the map uses.
@tier(embedded)
fn chan_count(chmap: Int) -> Int
    (chmap & 1) + ((chmap >>> 1) & 1) + ((chmap >>> 2) & 1)

// The channel index of the `k`-th used channel of the map, counted from 0
// in ascending order; -1 past the last.
@tier(embedded)
fn chan_of_slot(chmap: Int, k: Int) -> Int
    var seen = 0
    for bit in 0..3
        if ((chmap >>> bit) & 1) == 1
            if seen == k
                return 37 + bit
            seen = seen + 1
    -1

// The advertising interval the Controller uses: the minimum of the range,
// in microseconds.
@tier(embedded)
fn interval_us(var a: Adv) -> Int
    a.int_min * UNIT_US

// Build the PDUs of the next event from the parameters and the data.
@tier(embedded)
fn adv_build(var a: Adv)
    let ty = a.ty as Int
    let ptype = pdu_type_of(ty)
    if is_directed(ty)
        ll_pdu.pdu_begin(var a.pdu, ptype, a.addr_type as Int, a.tgt_type as Int)
        ll_pdu.pdu_put_addr(var a.pdu, var a.addr)
        ll_pdu.pdu_put_addr(var a.pdu, var a.tgt)
    else
        ll_pdu.pdu_begin(var a.pdu, ptype, a.addr_type as Int, 0)
        ll_pdu.pdu_put_addr(var a.pdu, var a.addr)
        for i in 0..(a.data_len as Int)
            let _a = ll_pdu.pdu_put(var a.pdu, a.data[i] as Int)
    ll_pdu.pdu_finish(var a.pdu)
    if is_connectable(ty)
        a.pdu.b[0] = ((a.pdu.b[0] as Int) | ll_pdu.CHSEL) as u8
    if is_scannable(ty)
        ll_pdu.pdu_begin(var a.rsp_pdu, ll_pdu.SCAN_RSP, a.addr_type as Int, 0)
        ll_pdu.pdu_put_addr(var a.rsp_pdu, var a.addr)
        for i in 0..(a.rsp_len as Int)
            let _b = ll_pdu.pdu_put(var a.rsp_pdu, a.rsp[i] as Int)
        ll_pdu.pdu_finish(var a.rsp_pdu)

// Enter the Advertising state at `now`, with the advertiser's address
// `addr` of `addr_type`.  The first event is due `FIRST_EVENT_US` later.
@satisfies("REQ-BLE-CTL-008")
@tier(embedded)
fn adv_enable(var a: Adv, now: Int, var addr: Vec[u8; 6], addr_type: Int)
    for i in 0..6
        a.addr[i] = addr[i]
        a.tgt[i] = a.peer[i]
    a.addr_type = addr_type as u8
    a.tgt_type = a.peer_type
    a.enabled = true
    a.timed_out = false
    a.entered = now
    a.due = now + FIRST_EVENT_US
    a.idx = 0
    adv_build(var a)

// Change the advertiser's address while the state is on, as a new Resolvable Private
// Address does: the PDUs of the next event carry it.
@tier(embedded)
fn adv_set_addr(var a: Adv, var addr: Vec[u8; 6], addr_type: Int)
    for i in 0..6
        a.addr[i] = addr[i]
    a.addr_type = addr_type as u8
    adv_build(var a)

// Change the address directed advertising names, the TargetA: the peer's identity
// address, or an RPA made with the peer's IRK.
@tier(embedded)
fn adv_set_target(var a: Adv, var tgt: Vec[u8; 6], tgt_type: Int)
    for i in 0..6
        a.tgt[i] = tgt[i]
    a.tgt_type = tgt_type as u8
    adv_build(var a)

// Leave the Advertising state.
@tier(embedded)
fn adv_disable(var a: Adv)
    a.enabled = false
    a.idx = 0

// The time the next PDU is to start.
@tier(embedded)
fn adv_due(var a: Adv) -> Int
    a.due

// The channel the next PDU goes on.
@tier(embedded)
fn adv_channel(var a: Adv) -> Int
    chan_of_slot(a.chmap as Int, a.idx as Int)

// Whether the next PDU is the first of an event.
@tier(embedded)
fn adv_at_event_start(var a: Adv) -> Bool
    a.idx == 0

// Whether a request may follow the PDU.
@tier(embedded)
fn adv_listens(var a: Adv) -> Bool
    (a.ty as Int) != TYPE_NONCONN

// The next advDelay, 0 to 10 ms in microseconds.
@satisfies("REQ-BLE-CTL-008")
@tier(embedded)
fn adv_delay(var a: Adv) -> Int
    a.rng = rng_step(a.rng)
    a.rng % (ADV_DELAY_MAX_US + 1)

// The PDU on `adv_channel` starts at `start`.  The first PDU of an event
// takes the data as it is now, so a change the Host made between events is
// sent in the next event.
@tier(embedded)
fn adv_pdu_start(var a: Adv, start: Int)
    if a.idx == 0
        a.anchor = start
        a.events = a.events + 1
        adv_build(var a)
    a.pdus = a.pdus + 1

// The PDU and the exchange after it ended at `end`.  The state moves to the
// next channel, or closes the event and schedules the next one.
@satisfies("REQ-BLE-CTL-008")
@tier(embedded)
fn adv_pdu_end(var a: Adv, end: Int)
    let used = chan_count(a.chmap as Int)
    a.idx = a.idx + 1
    if (a.idx as Int) < used
        a.due = end + PDU_GAP_US
        return
    a.idx = 0
    let ty = a.ty as Int
    var next = end + PDU_GAP_US
    if ty == TYPE_DIRECT_HIGH
        if next - a.entered >= HIGH_DUTY_TIMEOUT_US
            a.timed_out = true
    else
        let wanted = a.anchor + interval_us(a) + adv_delay(a)
        if wanted > next
            next = wanted
    a.due = next

// Whether high duty cycle directed advertising has run its 1.28 s.
@tier(embedded)
fn adv_timed_out(var a: Adv) -> Bool
    a.timed_out

// Whether the filter policy lets the Controller process a scan request
// from a device in the Filter Accept List or not (`listed`).
@tier(embedded)
fn scan_allowed(var a: Adv, listed: Bool) -> Bool
    let p = a.policy as Int
    p == POLICY_ALL or p == POLICY_CONNECT_LIST or listed

// The same for a connection request.
@tier(embedded)
fn connect_allowed(var a: Adv, listed: Bool) -> Bool
    let p = a.policy as Int
    p == POLICY_ALL or p == POLICY_SCAN_LIST or listed

// Whether a request is expected to follow: the speculative start of the
// scan response transmission is worth making for a PDU with this header
// octet, which names a SCAN_REQ for an advertiser that is scannable.
@tier(embedded)
fn adv_arm_for(var a: Adv, header0: Int) -> Bool
    (header0 & 0x0F) == ll_pdu.SCAN_REQ and is_scannable(a.ty as Int)

// A request the filter policy refused: count it and keep its sender.
@tier(embedded)
fn note_filtered(var a: Adv, var rx: Pdu)
    a.filtered = a.filtered + 1
    a.filt_type = ll_pdu.pdu_tx_add(var rx) as u8
    ll_pdu.pdu_addr_get(var rx, 0, var a.filt_addr)

// Judge the PDU received after an advertisement.  `got` is the octets
// received including the header, `listed` whether the sender (ScanA or
// InitA, with the type TxAdd gives) is in the Filter Accept List.  The answer
// is `RX_SCAN_REQ` when a scan response is to follow, `RX_CONNECT_IND` for a
// connection request the filter policy lets through, `RX_NONE` for anything
// else, which is ignored.
@satisfies("REQ-BLE-CTL-011")
@tier(embedded)
fn adv_rx(var a: Adv, var rx: Pdu, got: Int, listed: Bool) -> Int
    if not ll_pdu.pdu_well_formed(var rx, got)
        return RX_NONE
    let ty = ll_pdu.pdu_type(var rx)
    let own_type = a.addr_type as Int
    if ty == ll_pdu.SCAN_REQ
        if not is_scannable(a.ty as Int)
            return RX_NONE
        if not ll_pdu.pdu_addr_is(var rx, 6, var a.addr) or ll_pdu.pdu_rx_add(var rx) != own_type
            return RX_NONE
        if not scan_allowed(var a, listed)
            note_filtered(var a, var rx)
            return RX_NONE
        a.scan_reqs = a.scan_reqs + 1
        return RX_SCAN_REQ
    if ty == ll_pdu.CONNECT_IND
        if not is_connectable(a.ty as Int)
            return RX_NONE
        if not ll_pdu.pdu_addr_is(var rx, 6, var a.addr) or ll_pdu.pdu_rx_add(var rx) != own_type
            return RX_NONE
        if is_directed(a.ty as Int)
            if not ll_pdu.pdu_addr_is(var rx, 0, var a.peer) or ll_pdu.pdu_tx_add(var rx) != (a.peer_type as Int)
                return RX_NONE
        else
            if not connect_allowed(var a, listed)
                note_filtered(var a, var rx)
                return RX_NONE
        a.connect_inds = a.connect_inds + 1
        return RX_CONNECT_IND
    RX_NONE

// The scan response went out.
@tier(embedded)
fn adv_scan_rsp_sent(var a: Adv)
    a.scan_rsps = a.scan_rsps + 1

// ── Tests ───────────────────────────────────────────────────────────

fn t_addr(first: Int) -> Vec[u8; 6]
    var x: Vec[u8; 6] = Vec.new()
    for i in 0..6
        let _a = x.push((first + i) as u8)
    x

// An advertiser enabled at time 0 with the address 0x10..0x15 of `kind`.
fn t_running(ty: Int, kind: Int) -> Adv
    var a = adv_new()
    adv_set_params(var a, 0x20, 0x20, ty, kind, 0, 7, 0)
    var ad = t_addr(0x10)
    adv_enable(var a, 0, var ad, kind)
    a

// A request PDU of `ty` from the sender 0x40..0x45 to the advertiser.
fn t_request(ty: Int, var target: Vec[u8; 6], rx_add: Int, tx_add: Int) -> Pdu
    var p = ll_pdu.pdu_new()
    var sender = t_addr(0x40)
    ll_pdu.pdu_begin(var p, ty, tx_add, rx_add)
    ll_pdu.pdu_put_addr(var p, var sender)
    ll_pdu.pdu_put_addr(var p, var target)
    if ty == ll_pdu.CONNECT_IND
        for _ in 0..22
            let _x = ll_pdu.pdu_put(var p, 0)
    ll_pdu.pdu_finish(var p)
    p

@test
fn test_capacities_match_the_constants()
    let a = adv_new()
    test.assert_eq(a.data.capacity(), ll_pdu.DATA_MAX)
    test.assert_eq(a.rsp.capacity(), ll_pdu.DATA_MAX)
    test.assert_eq(a.peer.capacity(), 6)
    test.assert_eq(a.addr.capacity(), 6)

@test
fn test_parameter_status_follows_the_command()
    test.assert_eq(params_status(0x20, 0x4000, 0, 0, 0, 7, 0), 0)
    test.assert_eq(params_status(0x1F, 0x20, 0, 0, 0, 7, 0), 0x12)
    test.assert_eq(params_status(0x20, 0x4001, 0, 0, 0, 7, 0), 0x12)
    test.assert_eq(params_status(0x30, 0x20, 0, 0, 0, 7, 0), 0x12)
    test.assert_eq(params_status(0x20, 0x20, 5, 0, 0, 7, 0), 0x12)
    test.assert_eq(params_status(0x20, 0x20, 0, 4, 0, 7, 0), 0x12)
    test.assert_eq(params_status(0x20, 0x20, 0, 0, 2, 7, 0), 0x12)
    test.assert_eq(params_status(0x20, 0x20, 0, 0, 0, 0, 0), 0x12)
    test.assert_eq(params_status(0x20, 0x20, 0, 0, 0, 8, 0), 0x12)
    test.assert_eq(params_status(0x20, 0x20, 0, 0, 0, 7, 4), 0x12)
    // The interval of high duty cycle directed advertising is not used.
    test.assert_eq(params_status(0, 0, 1, 0, 0, 7, 0), 0)
    test.assert_eq(params_status(0, 0, 4, 0, 0, 7, 0), 0x12)
    // The own address types 2 and 3 take the Resolvable Private Address of the resolving list.
    test.assert_eq(params_status(0x20, 0x20, 0, 2, 0, 7, 0), 0)
    test.assert_eq(params_status(0x20, 0x20, 0, 3, 0, 7, 0), 0)

@test
fn test_channel_slots_are_ascending_over_the_map()
    test.assert_eq(chan_count(7), 3)
    test.assert_eq(chan_count(5), 2)
    test.assert_eq(chan_count(2), 1)
    test.assert_eq(chan_of_slot(7, 0), 37)
    test.assert_eq(chan_of_slot(7, 1), 38)
    test.assert_eq(chan_of_slot(7, 2), 39)
    test.assert_eq(chan_of_slot(7, 3), -1)
    test.assert_eq(chan_of_slot(5, 0), 37)
    test.assert_eq(chan_of_slot(5, 1), 39)
    test.assert_eq(chan_of_slot(4, 0), 39)
    test.assert_eq(chan_of_slot(4, 1), -1)

@test
fn test_generator_draws_stay_in_the_delay_range()
    var a = adv_new()
    adv_seed(var a, 12345)
    var lo = ADV_DELAY_MAX_US
    var hi = 0
    for _ in 0..2000
        let d = adv_delay(a)
        test.assert(d >= 0 and d <= ADV_DELAY_MAX_US)
        if d < lo
            lo = d
        if d > hi
            hi = d
    // 2000 draws cover the range well enough to see both ends.
    test.assert(lo < 200)
    test.assert(hi > 9800)

@test
fn test_generator_never_sticks_at_zero()
    test.assert(rng_step(0) != 0)
    var x = 1
    for _ in 0..100
        x = rng_step(x)
        test.assert(x != 0)

@test
fn test_connectable_scannable_pdu_carries_the_address_and_data()
    var a = adv_new()
    adv_set_params(var a, 0x20, 0x20, TYPE_IND, 0, 0, 7, 0)
    a.data[0] = 2
    a.data[1] = 1
    a.data[2] = 6
    adv_set_data_len(var a, 3)
    a.rsp[0] = 4
    a.rsp[1] = 9
    a.rsp[2] = 0x41
    a.rsp[3] = 0x42
    adv_set_rsp_len(var a, 4)
    var ad = t_addr(0x10)
    adv_enable(var a, 1000, var ad, 1)
    test.assert_eq(a.pdu.n, 2 + 6 + 3)
    test.assert_eq(ll_pdu.pdu_type(var a.pdu), ll_pdu.ADV_IND)
    test.assert_eq(ll_pdu.pdu_tx_add(var a.pdu), 1)
    test.assert_eq(ll_pdu.pdu_len(var a.pdu), 9)
    test.assert_eq(ll_pdu.pdu_get(var a.pdu, 2), 0x10)
    test.assert_eq(ll_pdu.pdu_get(var a.pdu, 7), 0x15)
    test.assert_eq(ll_pdu.pdu_get(var a.pdu, 8), 2)
    test.assert_eq(ll_pdu.pdu_get(var a.pdu, 10), 6)
    test.assert_eq(ll_pdu.pdu_type(var a.rsp_pdu), ll_pdu.SCAN_RSP)
    test.assert_eq(ll_pdu.pdu_len(var a.rsp_pdu), 10)
    test.assert_eq(ll_pdu.pdu_get(var a.rsp_pdu, 8), 4)

@test
fn test_each_advertising_type_sends_its_pdu_type()
    test.assert_eq(pdu_type_of(TYPE_IND), ll_pdu.ADV_IND)
    test.assert_eq(pdu_type_of(TYPE_SCAN), ll_pdu.ADV_SCAN_IND)
    test.assert_eq(pdu_type_of(TYPE_NONCONN), ll_pdu.ADV_NONCONN_IND)
    test.assert_eq(pdu_type_of(TYPE_DIRECT_HIGH), ll_pdu.ADV_DIRECT_IND)
    test.assert_eq(pdu_type_of(TYPE_DIRECT_LOW), ll_pdu.ADV_DIRECT_IND)

@test
fn test_directed_pdu_names_the_target_and_its_type()
    var a = adv_new()
    adv_set_params(var a, 0x20, 0x20, TYPE_DIRECT_LOW, 0, 1, 7, 0)
    var peer = t_addr(0x70)
    for i in 0..6
        a.peer[i] = peer[i]
    var ad = t_addr(0x10)
    adv_enable(var a, 0, var ad, 0)
    test.assert_eq(ll_pdu.pdu_type(var a.pdu), ll_pdu.ADV_DIRECT_IND)
    test.assert_eq(ll_pdu.pdu_len(var a.pdu), 12)
    test.assert_eq(ll_pdu.pdu_tx_add(var a.pdu), 0)
    test.assert_eq(ll_pdu.pdu_rx_add(var a.pdu), 1)
    test.assert_eq(ll_pdu.pdu_get(var a.pdu, 8), 0x70)
    test.assert_eq(ll_pdu.pdu_get(var a.pdu, 13), 0x75)

@test
fn test_an_event_sends_one_pdu_per_channel_then_waits_the_interval()
    var a = t_running(TYPE_NONCONN, 0)
    test.assert_eq(adv_due(var a), FIRST_EVENT_US)
    test.assert(adv_at_event_start(var a))
    test.assert_eq(adv_channel(var a), 37)
    adv_pdu_start(var a, 1000)
    adv_pdu_end(var a, 1400)
    test.assert(not adv_at_event_start(var a))
    test.assert_eq(adv_channel(var a), 38)
    test.assert_eq(adv_due(var a), 1400 + PDU_GAP_US)
    adv_pdu_start(var a, 1700)
    adv_pdu_end(var a, 2100)
    test.assert_eq(adv_channel(var a), 39)
    adv_pdu_start(var a, 2400)
    adv_pdu_end(var a, 2800)
    // The event is closed: the next starts an interval and an advDelay after
    // the first PDU of this one began.
    test.assert(adv_at_event_start(var a))
    test.assert_eq(adv_channel(var a), 37)
    let gap = adv_due(var a) - 1000
    test.assert(gap >= 32 * UNIT_US)
    test.assert(gap <= 32 * UNIT_US + ADV_DELAY_MAX_US)
    test.assert_eq(a.events, 1)
    test.assert_eq(a.pdus, 3)

@test
fn test_the_event_spacing_stays_inside_the_delay_bound_over_many_events()
    var a = t_running(TYPE_NONCONN, 0)
    var prev = -1
    var lo = 1000000000
    var hi = 0
    for _ in 0..300
        let start = adv_due(var a)
        if prev >= 0
            let s = start - prev
            if s < lo
                lo = s
            if s > hi
                hi = s
        prev = start
        for k in 0..3
            adv_pdu_start(var a, adv_due(var a))
            adv_pdu_end(var a, adv_due(var a) + 300)
    test.assert(lo >= 32 * UNIT_US)
    test.assert(hi <= 32 * UNIT_US + ADV_DELAY_MAX_US)
    test.assert(hi - lo > 5000)
    test.assert_eq(a.events, 300)

@test
fn test_a_channel_map_of_two_makes_events_of_two_pdus()
    var a = t_running(TYPE_NONCONN, 0)
    adv_set_map_policy(var a, 5, a.policy as Int)
    adv_pdu_start(var a, 1000)
    test.assert_eq(adv_channel(var a), 37)
    adv_pdu_end(var a, 1400)
    test.assert_eq(adv_channel(var a), 39)
    adv_pdu_start(var a, 1700)
    adv_pdu_end(var a, 2100)
    test.assert(adv_at_event_start(var a))
    test.assert_eq(adv_channel(var a), 37)

@test
fn test_a_late_event_is_not_scheduled_in_the_past()
    var a = t_running(TYPE_NONCONN, 0)
    // The program was busy: the three PDUs ended long after the interval.
    adv_pdu_start(var a, 1000)
    adv_pdu_end(var a, 5000)
    adv_pdu_start(var a, 5300)
    adv_pdu_end(var a, 9000)
    adv_pdu_start(var a, 9300)
    adv_pdu_end(var a, 100000)
    test.assert(adv_due(var a) >= 100000 + PDU_GAP_US)

@test
fn test_data_set_between_events_goes_out_in_the_next_event()
    var a = t_running(TYPE_NONCONN, 0)
    adv_pdu_start(var a, 1000)
    test.assert_eq(ll_pdu.pdu_len(var a.pdu), 6)
    a.data[0] = 9
    adv_set_data_len(var a, 1)
    // Mid-event the PDU is the old one; the next event's first PDU is new.
    adv_pdu_end(var a, 1400)
    adv_pdu_start(var a, 1700)
    adv_pdu_end(var a, 2100)
    adv_pdu_start(var a, 2400)
    adv_pdu_end(var a, 2800)
    adv_pdu_start(var a, adv_due(var a))
    test.assert_eq(ll_pdu.pdu_len(var a.pdu), 7)

@test
fn test_high_duty_directed_events_run_back_to_back_and_time_out()
    var a = adv_new()
    adv_set_params(var a, 0, 0, TYPE_DIRECT_HIGH, 0, 0, 7, 0)
    var ad = t_addr(0x10)
    adv_enable(var a, 0, var ad, 0)
    var now = adv_due(var a)
    var events = 0
    var longest = 0
    var last_start = now
    while not adv_timed_out(var a) and events < 2000
        let start = adv_due(var a)
        // The shortest exchange: the PDU, then the listen window that ends
        // 150 + 40 + 24 microseconds after the PDU.
        for k in 0..3
            let s = adv_due(var a)
            adv_pdu_start(var a, s)
            adv_pdu_end(var a, s + ll_pdu.airtime_us(14) + 214)
            if k == 0
                if s - last_start > longest
                    longest = s - last_start
                last_start = s
        events = events + 1
    test.assert(adv_timed_out(var a))
    test.assert(events > 100)
    // The same channel is used again within 3.75 ms.
    test.assert(longest <= 3750)
    test.assert(adv_due(var a) - a.entered >= HIGH_DUTY_TIMEOUT_US)
    test.assert(adv_due(var a) - a.entered < HIGH_DUTY_TIMEOUT_US + 4000)

@test
fn test_scan_request_for_a_scannable_advertiser_gets_a_response()
    var a = t_running(TYPE_IND, 0)
    var mine = t_addr(0x10)
    var p = t_request(ll_pdu.SCAN_REQ, var mine, 0, 0)
    test.assert_eq(adv_rx(var a, var p, 14, false), RX_SCAN_REQ)
    test.assert_eq(a.scan_reqs, 1)

@test
fn test_scan_request_for_another_address_is_ignored()
    var a = t_running(TYPE_IND, 0)
    var other = t_addr(0x11)
    var p = t_request(ll_pdu.SCAN_REQ, var other, 0, 0)
    test.assert_eq(adv_rx(var a, var p, 14, false), RX_NONE)
    // The right address with the wrong type bit names another device.
    var mine = t_addr(0x10)
    var q = t_request(ll_pdu.SCAN_REQ, var mine, 1, 0)
    test.assert_eq(adv_rx(var a, var q, 14, false), RX_NONE)

@test
fn test_random_advertiser_answers_a_request_with_rxadd_set()
    var a = t_running(TYPE_SCAN, 1)
    var mine = t_addr(0x10)
    var p = t_request(ll_pdu.SCAN_REQ, var mine, 1, 1)
    test.assert_eq(adv_rx(var a, var p, 14, false), RX_SCAN_REQ)
    var q = t_request(ll_pdu.SCAN_REQ, var mine, 0, 1)
    test.assert_eq(adv_rx(var a, var q, 14, false), RX_NONE)

@test
fn test_a_truncated_request_is_ignored()
    var a = t_running(TYPE_IND, 0)
    var mine = t_addr(0x10)
    var p = t_request(ll_pdu.SCAN_REQ, var mine, 0, 0)
    test.assert_eq(adv_rx(var a, var p, 13, false), RX_NONE)
    test.assert_eq(adv_rx(var a, var p, 15, false), RX_NONE)

@test
fn test_non_scannable_types_ignore_a_scan_request()
    var mine = t_addr(0x10)
    var p = t_request(ll_pdu.SCAN_REQ, var mine, 0, 0)
    var a = t_running(TYPE_NONCONN, 0)
    test.assert_eq(adv_rx(var a, var p, 14, false), RX_NONE)
    var b = t_running(TYPE_DIRECT_LOW, 0)
    test.assert_eq(adv_rx(var b, var p, 14, false), RX_NONE)

@test
fn test_connect_request_is_counted_for_connectable_types()
    var mine = t_addr(0x10)
    var p = t_request(ll_pdu.CONNECT_IND, var mine, 0, 0)
    var a = t_running(TYPE_IND, 0)
    test.assert_eq(adv_rx(var a, var p, 36, false), RX_CONNECT_IND)
    test.assert_eq(a.connect_inds, 1)
    var s = t_running(TYPE_SCAN, 0)
    test.assert_eq(adv_rx(var s, var p, 36, false), RX_NONE)
    var n = t_running(TYPE_NONCONN, 0)
    test.assert_eq(adv_rx(var n, var p, 36, false), RX_NONE)

@test
fn test_directed_advertising_answers_only_the_named_initiator()
    var a = adv_new()
    adv_set_params(var a, 0x20, 0x20, TYPE_DIRECT_LOW, 0, 0, 7, 0)
    var peer = t_addr(0x40)
    for i in 0..6
        a.peer[i] = peer[i]
    var ad = t_addr(0x10)
    adv_enable(var a, 0, var ad, 0)
    var mine = t_addr(0x10)
    // The request is from 0x40..0x45 with the public type: the named one.
    var p = t_request(ll_pdu.CONNECT_IND, var mine, 0, 0)
    test.assert_eq(adv_rx(var a, var p, 36, false), RX_CONNECT_IND)
    // The same address with the random type is another device.
    var q = t_request(ll_pdu.CONNECT_IND, var mine, 0, 1)
    test.assert_eq(adv_rx(var a, var q, 36, false), RX_NONE)
    // The Filter Accept List does not matter for directed advertising.
    adv_set_map_policy(var a, a.chmap as Int, 3)
    test.assert_eq(adv_rx(var a, var p, 36, false), RX_CONNECT_IND)

@test
fn test_filter_policy_gates_scan_and_connect_requests()
    var mine = t_addr(0x10)
    var scan = t_request(ll_pdu.SCAN_REQ, var mine, 0, 0)
    var conn = t_request(ll_pdu.CONNECT_IND, var mine, 0, 0)
    var a = t_running(TYPE_IND, 0)
    // Policy 1: scan requests only from listed devices, connections from all.
    adv_set_map_policy(var a, a.chmap as Int, 1)
    test.assert_eq(adv_rx(var a, var scan, 14, false), RX_NONE)
    test.assert_eq(adv_rx(var a, var scan, 14, true), RX_SCAN_REQ)
    test.assert_eq(adv_rx(var a, var conn, 36, false), RX_CONNECT_IND)
    // Policy 2: the other way round.
    adv_set_map_policy(var a, a.chmap as Int, 2)
    test.assert_eq(adv_rx(var a, var scan, 14, false), RX_SCAN_REQ)
    test.assert_eq(adv_rx(var a, var conn, 36, false), RX_NONE)
    test.assert_eq(adv_rx(var a, var conn, 36, true), RX_CONNECT_IND)
    // Policy 3: listed devices only.
    adv_set_map_policy(var a, a.chmap as Int, 3)
    test.assert_eq(adv_rx(var a, var scan, 14, false), RX_NONE)
    test.assert_eq(adv_rx(var a, var conn, 36, false), RX_NONE)
    test.assert_eq(adv_rx(var a, var scan, 14, true), RX_SCAN_REQ)
    test.assert_eq(adv_rx(var a, var conn, 36, true), RX_CONNECT_IND)

@test
fn test_arm_for_a_scan_request_only_when_scannable()
    var a = t_running(TYPE_IND, 0)
    test.assert(adv_arm_for(var a, 0x03))
    test.assert(adv_arm_for(var a, 0x43))
    test.assert(not adv_arm_for(var a, 0x05))
    var n = t_running(TYPE_NONCONN, 0)
    test.assert(not adv_arm_for(var n, 0x03))

@test
fn test_reset_returns_to_the_defaults()
    var a = t_running(TYPE_SCAN, 1)
    adv_set_data_len(var a, 5)
    adv_reset(var a)
    test.assert(not a.enabled)
    test.assert_eq(a.ty as Int, 0)
    test.assert_eq(a.chmap as Int, 7)
    test.assert_eq(a.int_min, DEFAULT_INTERVAL)
    test.assert_eq(a.data_len as Int, 0)

@test
fn test_a_request_the_policy_refuses_is_counted_with_its_sender()
    var mine = t_addr(0x10)
    var scan = t_request(ll_pdu.SCAN_REQ, var mine, 0, 1)
    var a = t_running(TYPE_IND, 0)
    adv_set_map_policy(var a, 7, 1)
    test.assert_eq(adv_rx(var a, var scan, 14, false), RX_NONE)
    test.assert_eq(a.filtered, 1)
    test.assert_eq(a.filt_type as Int, 1)
    test.assert_eq(a.filt_addr[0] as Int, 0x40)
    test.assert_eq(a.filt_addr[5] as Int, 0x45)
    // A request for another advertiser is not counted.
    var other = t_addr(0x11)
    var q = t_request(ll_pdu.SCAN_REQ, var other, 0, 0)
    test.assert_eq(adv_rx(var a, var q, 14, false), RX_NONE)
    test.assert_eq(a.filtered, 1)

@test
fn test_connectable_advertisements_say_they_support_algorithm_2()
    // ChSel is set in ADV_IND and ADV_DIRECT_IND, and in no other PDU.
    var a = t_running(TYPE_IND, 0)
    test.assert_eq((a.pdu.b[0] as Int) & ll_pdu.CHSEL, ll_pdu.CHSEL)
    var d = t_running(TYPE_DIRECT_LOW, 0)
    test.assert_eq((d.pdu.b[0] as Int) & ll_pdu.CHSEL, ll_pdu.CHSEL)
    var h = t_running(TYPE_DIRECT_HIGH, 0)
    test.assert_eq((h.pdu.b[0] as Int) & ll_pdu.CHSEL, ll_pdu.CHSEL)
    var n = t_running(TYPE_NONCONN, 0)
    test.assert_eq((n.pdu.b[0] as Int) & ll_pdu.CHSEL, 0)
    var s = t_running(TYPE_SCAN, 0)
    test.assert_eq((s.pdu.b[0] as Int) & ll_pdu.CHSEL, 0)
    test.assert_eq((a.rsp_pdu.b[0] as Int) & ll_pdu.CHSEL, 0)
