// src/ll_aes.nv — AES-128 in software: the block cipher the
// Controller uses where the chip has none, and the reference the hardware
// backends are checked against.
//
// FIPS 197.  The key is expanded once into eleven round keys of four 32-bit
// words and a block is encrypted in place.  A block is four words, one per
// column of the state, the first octet of the column in the low byte; the
// round keeps the state in four integers, and SubBytes, ShiftRows and
// MixColumns are done on whole words (MixColumns doubles the four octets of a
// word at once).  Only encryption exists: CCM, the key derivation and LE
// Encrypt run the cipher forward.
//
// Key and block are octets in the order FIPS 197 writes them, the most
// significant first, which is the order of the HCI parameters of LE Encrypt
// once reversed (`ctl_async_key`).  No function here allocates.

// The S-box, FIPS 197 Figure 7.
const SBOX = [
    0x63, 0x7C, 0x77, 0x7B, 0xF2, 0x6B, 0x6F, 0xC5, 0x30, 0x01, 0x67, 0x2B, 0xFE, 0xD7, 0xAB, 0x76,
    0xCA, 0x82, 0xC9, 0x7D, 0xFA, 0x59, 0x47, 0xF0, 0xAD, 0xD4, 0xA2, 0xAF, 0x9C, 0xA4, 0x72, 0xC0,
    0xB7, 0xFD, 0x93, 0x26, 0x36, 0x3F, 0xF7, 0xCC, 0x34, 0xA5, 0xE5, 0xF1, 0x71, 0xD8, 0x31, 0x15,
    0x04, 0xC7, 0x23, 0xC3, 0x18, 0x96, 0x05, 0x9A, 0x07, 0x12, 0x80, 0xE2, 0xEB, 0x27, 0xB2, 0x75,
    0x09, 0x83, 0x2C, 0x1A, 0x1B, 0x6E, 0x5A, 0xA0, 0x52, 0x3B, 0xD6, 0xB3, 0x29, 0xE3, 0x2F, 0x84,
    0x53, 0xD1, 0x00, 0xED, 0x20, 0xFC, 0xB1, 0x5B, 0x6A, 0xCB, 0xBE, 0x39, 0x4A, 0x4C, 0x58, 0xCF,
    0xD0, 0xEF, 0xAA, 0xFB, 0x43, 0x4D, 0x33, 0x85, 0x45, 0xF9, 0x02, 0x7F, 0x50, 0x3C, 0x9F, 0xA8,
    0x51, 0xA3, 0x40, 0x8F, 0x92, 0x9D, 0x38, 0xF5, 0xBC, 0xB6, 0xDA, 0x21, 0x10, 0xFF, 0xF3, 0xD2,
    0xCD, 0x0C, 0x13, 0xEC, 0x5F, 0x97, 0x44, 0x17, 0xC4, 0xA7, 0x7E, 0x3D, 0x64, 0x5D, 0x19, 0x73,
    0x60, 0x81, 0x4F, 0xDC, 0x22, 0x2A, 0x90, 0x88, 0x46, 0xEE, 0xB8, 0x14, 0xDE, 0x5E, 0x0B, 0xDB,
    0xE0, 0x32, 0x3A, 0x0A, 0x49, 0x06, 0x24, 0x5C, 0xC2, 0xD3, 0xAC, 0x62, 0x91, 0x95, 0xE4, 0x79,
    0xE7, 0xC8, 0x37, 0x6D, 0x8D, 0xD5, 0x4E, 0xA9, 0x6C, 0x56, 0xF4, 0xEA, 0x65, 0x7A, 0xAE, 0x08,
    0xBA, 0x78, 0x25, 0x2E, 0x1C, 0xA6, 0xB4, 0xC6, 0xE8, 0xDD, 0x74, 0x1F, 0x4B, 0xBD, 0x8B, 0x8A,
    0x70, 0x3E, 0xB5, 0x66, 0x48, 0x03, 0xF6, 0x0E, 0x61, 0x35, 0x57, 0xB9, 0x86, 0xC1, 0x1D, 0x9E,
    0xE1, 0xF8, 0x98, 0x11, 0x69, 0xD9, 0x8E, 0x94, 0x9B, 0x1E, 0x87, 0xE9, 0xCE, 0x55, 0x28, 0xDF,
    0x8C, 0xA1, 0x89, 0x0D, 0xBF, 0xE6, 0x42, 0x68, 0x41, 0x99, 0x2D, 0x0F, 0xB0, 0x54, 0xBB, 0x16]

// The round constants of the key expansion.
const RCON = [0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1B, 0x36]

// The 44 words of the eleven round keys.
@value
struct AesKey
    w: Vec[Int; 44]

@no_alloc
@tier(embedded)
fn aes_key_new() -> AesKey
    var k = aes_key_empty()
    aes_key_fill(var k)
    k

// A key with no words: the table of a build that never expands a key (`aes_key_fill` makes it usable).
@no_alloc
@tier(embedded)
fn aes_key_empty() -> AesKey
    AesKey { w: Vec.new() }

@no_alloc
@tier(embedded)
fn aes_key_fill(var k: AesKey)
    for _ in 0..44
        let _a = k.w.push(0)

// The word of the four octets `a`, `b`, `c`, `d`, `a` in the low byte.
@no_alloc
@tier(embedded)
fn word(a: Int, b: Int, c: Int, d: Int) -> Int
    a | (b << 8) | (c << 16) | (d << 24)

// SubBytes of one word.
@no_alloc
@tier(embedded)
fn sub_word(w: Int) -> Int
    word(SBOX[w & 0xFF], SBOX[(w >>> 8) & 0xFF], SBOX[(w >>> 16) & 0xFF], SBOX[(w >>> 24) & 0xFF])

// The word rotated so that its second octet comes first.
@no_alloc
@tier(embedded)
fn rot8(w: Int) -> Int
    ((w >>> 8) | (w << 24)) & 0xFFFFFFFF

// Expand the 16 octets of `key` into the round keys of `k`.
@no_alloc
@tier(embedded)
fn aes_set_key(var k: AesKey, var key: Vec[u8; 16])
    for i in 0..4
        k.w[i] = word(key[4 * i] as Int, key[4 * i + 1] as Int, key[4 * i + 2] as Int, key[4 * i + 3] as Int)
    for i in 4..44
        var t = k.w[i - 1]
        if (i & 3) == 0
            t = sub_word(rot8(t)) ^ RCON[(i >>> 2) - 1]
        k.w[i] = (k.w[i - 4] ^ t) & 0xFFFFFFFF

// The four octets of `w` doubled in GF(2^8).
@no_alloc
@tier(embedded)
fn xtime4(w: Int) -> Int
    (((w & 0x7F7F7F7F) << 1) ^ (((w >>> 7) & 0x01010101) * 0x1B)) & 0xFFFFFFFF

// MixColumns of one column.
@no_alloc
@tier(embedded)
fn mix(w: Int) -> Int
    let d = xtime4(w)
    let e = rot8(w ^ d)
    let f = ((w >>> 16) | (w << 16)) & 0xFFFFFFFF
    let g = ((w >>> 24) | (w << 8)) & 0xFFFFFFFF
    (d ^ e ^ f ^ g) & 0xFFFFFFFF

// SubBytes and ShiftRows of the output column that takes row 0 from `a`, row 1
// from `b`, row 2 from `c` and row 3 from `d`.
@no_alloc
@tier(embedded)
fn sub_col(a: Int, b: Int, c: Int, d: Int) -> Int
    word(SBOX[a & 0xFF], SBOX[(b >>> 8) & 0xFF], SBOX[(c >>> 16) & 0xFF], SBOX[(d >>> 24) & 0xFF])

// Store the word `w` as octets `4 * i` to `4 * i + 3` of `blk`.
@no_alloc
@tier(embedded)
fn put_word(var blk: Vec[u8; 16], i: Int, w: Int)
    blk[4 * i] = (w & 0xFF) as u8
    blk[4 * i + 1] = ((w >>> 8) & 0xFF) as u8
    blk[4 * i + 2] = ((w >>> 16) & 0xFF) as u8
    blk[4 * i + 3] = ((w >>> 24) & 0xFF) as u8

// Encrypt the 16 octets of `blk` in place with the round keys of `k`.
@no_alloc
@tier(embedded)
fn aes_encrypt(var k: AesKey, var blk: Vec[u8; 16])
    var s0 = word(blk[0] as Int, blk[1] as Int, blk[2] as Int, blk[3] as Int) ^ k.w[0]
    var s1 = word(blk[4] as Int, blk[5] as Int, blk[6] as Int, blk[7] as Int) ^ k.w[1]
    var s2 = word(blk[8] as Int, blk[9] as Int, blk[10] as Int, blk[11] as Int) ^ k.w[2]
    var s3 = word(blk[12] as Int, blk[13] as Int, blk[14] as Int, blk[15] as Int) ^ k.w[3]
    for r in 1..10
        let t0 = mix(sub_col(s0, s1, s2, s3)) ^ k.w[4 * r]
        let t1 = mix(sub_col(s1, s2, s3, s0)) ^ k.w[4 * r + 1]
        let t2 = mix(sub_col(s2, s3, s0, s1)) ^ k.w[4 * r + 2]
        let t3 = mix(sub_col(s3, s0, s1, s2)) ^ k.w[4 * r + 3]
        s0 = t0
        s1 = t1
        s2 = t2
        s3 = t3
    let u0 = sub_col(s0, s1, s2, s3) ^ k.w[40]
    let u1 = sub_col(s1, s2, s3, s0) ^ k.w[41]
    let u2 = sub_col(s2, s3, s0, s1) ^ k.w[42]
    let u3 = sub_col(s3, s0, s1, s2) ^ k.w[43]
    put_word(var blk, 0, u0)
    put_word(var blk, 1, u1)
    put_word(var blk, 2, u2)
    put_word(var blk, 3, u3)
