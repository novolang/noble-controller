// src/ll_iso.nv — Connected Isochronous Streams of the Link Layer: the
// CIG and CIS tables, the LL Control PDUs that make and end a stream, the timing of
// CIS events and subevents, the channel of a subevent, the acknowledgement,
// retransmission and flush rules, and the unframed adaptation of SDUs to payloads.
//
// [Vol 6] Part B, Section 4.5.13 and 4.5.14, Section 2.6.1, Section 5.1.15 and 5.1.16;
// Part G, Section 2.1 and 3; Part E, Section 2.
//
// A CIS rides an ACL connection.  The Central creates it with LL_CIS_REQ; the
// Peripheral's Host accepts and the Peripheral answers LL_CIS_RSP; the Central ends the
// procedure with LL_CIS_IND, which fixes the access address, the offset of the first
// anchor point from the ACL's and the two synchronization delays.  From then on the stream
// is a series of CIS events ISO_Interval apart, each of NSE subevents Sub_Interval apart: the
// Central sends in each subevent and the Peripheral answers T_IFS_CIS after, in the same
// channel.  A stream is terminated by LL_CIS_TERMINATE_IND over the ACL.
//
// This module holds no radio, no clock and no link: the program that owns them gives the
// times in microseconds and the Controller (`ctl_hci.nv`) gives the ACL link's values.  It
// is the same code for both roles: `Cis.central` says which end this is, and the direction
// that this end transmits is the Central-to-Peripheral one for a Central.
//
// The data.  A payload has a number, the cisPayloadCounter (Section 4.5.13.3): the burst of CIS
// event E is the numbers E x BN to (E + 1) x BN - 1.  The Link Layer sends the payload
// `tx_num` in a subevent until the peer acknowledges it or its flush point passes
// (Section 4.5.13.5), and then the next; its SN is the lowest bit of its number
// (Section 4.5.9).  A payload that the Host did not supply for a burst is an empty padding PDU,
// so the numbers always run one burst for each event.  The numbers `tx_num` to `tx_wr - 1` are
// held in a ring of `PAYLOAD_SLOTS` (`txd`, `txl`, `txf`).  The receiving end counts the numbers
// it has taken in `rx_num`.  Unframed PDUs only (Part G, Section 2.1): an SDU is cut in
// UPPS payloads, a number of them that is the same for every SDU, and BN is UPPS x USPI.
//
// The state is a value with inline storage; no function here allocates.

use noble_controller_config
use ctl_limits
use std.test
use ll_pdu
use ll_data
use ll_phy
use ll_link
use ll_radio

// The functions below take the stream as a `var` parameter even where they only read it,
// which passes its address.  A plain parameter is a copy, and a copy of a struct of this
// size on every call costs time and stack.

// ── Capacities ───────────────────────────────────────────────────────

// The streams and groups the Controller holds (`ctl_cis` and `ctl_cigs`), and whether the build has isochronous
// channels at all (`ctl_limits.iso_on()`).  The size of `cis` and `cigs` in ctl_hci.nv follows the same keys, and so
// do the sizes of the three buffers of `Cis` (`txd`, `hbuf` and `outd`: 2048, 512 and 1024 octets, 8 in a build with
// none), written as the expression of `ctl_limits.iso_txd()` and its two neighbours.  A build with no isochronous
// channels still holds one stream and one group, since a `Vec` has no zero capacity, and answers no command that
// needs them; the buffers are what it spares.  `test_slots_match_the_profile` compares the capacities with `ctl_limits`.

// 1 when the build carries the ISO test mode (LE ISO Transmit Test and Receive Test), which it does with the broadcast groups: the hooks of `tx_fill`, `tx_retire` and
// `out_put` and the SDUs the test makes are linked then only (`ctl_limits.test_on()`: `ctl_bigs` above 0 with isochronous channels).

// The most payloads in flight in one direction of a stream: the ring of `txd`.
const PAYLOAD_SLOTS = 8

// The octets of one payload slot (a Data Channel PDU carries at most 251) and the longest SDU the
// Controller takes from the Host or hands to it.  An SDU is cut into the payloads of the stream
// (UPPS of them, Part G Section 2.1), so one over 251 octets takes several; the buffers that hold
// one whole (`hbuf` for the Host's fragments, a slot of `outd` for the recombination) are
// `SDU_MAX` octets, which three full payloads would not overrun.
const SLOT_OCTETS = 256
const SDU_MAX = 512

// The octets of one slot of `outd`: an SDU waiting for the Host.
const OUT_OCTETS = 512

// The longest ISO_Data_Load of an HCI ISO Data packet the Controller reports (LE Read Buffer Size [v2]) and
// sends: the 4-octet time stamp, the 4 octets of sequence number and length and 240 octets of SDU.  An SDU
// longer than what is left of the packet goes in fragments (Packet_Boundary_Flag 0, 1 and 3, [Vol 4] Part E,
// Section 5.4.5), in both directions.
const ISO_LOAD = 248

// The most HCI ISO Data packets one SDU takes: ceil(SDU_MAX / (ISO_LOAD - 8)) first and continuation fragments.
const SDU_FRAGS = 3

// The SDUs a stream holds for the Host: the ones recombined and not yet sent.
const OUT_SLOTS = 2

// Framed PDUs (Part G, Section 2.2): the octets of a Segmentation Header and of a Time_Offset, and the shortest PDU
// that can start an SDU (header, Time_Offset and an octet of the SDU) or carry an empty one (header and Time_Offset).
const FR_HEADER = 2
const FR_TOFF = 3
const FR_START_MIN = 6
const FR_EMPTY_MIN = 5

// The most whole SDUs that the loss of PDUs is made up with as lost SDUs in one step (see `fr_start`).
const FR_LOST_MAX = 4

// The fewest octets of an SDU that a continuation segment carries: a segment of one or two octets, which the cut at the end of a payload
// would leave when an SDU is a little over, is not read by the SoftDevice Controller (a stream of 60-octet SDUs in payloads of 64 lost
// every SDU, one of 59 or of 66 octets none), so the segment before it gives up octets to it.
const FR_TAIL_MIN = 5

// The Host's ISO buffers the Controller reports: SDUs it may have in flight on all streams.
const ISO_BUFFERS = 6

// The first connection handle of a CIS; the handle of the stream in slot `n` is `n` more.
const HANDLE_BASE = 0x0100

// The connection handles of broadcast isochronous streams start here (`ll_big.BIS_HANDLE_BASE`).
const HANDLE_BIS = 0x0200

// ── The timing constants of Section 4.1 ──────────────────────────────

const T_IFS_CIS_US = 150
const T_MSS_CIS_US = 150
const UNIT_US = 1250

// The microseconds the receiver of a subevent starts before the time it is due, beyond the
// window widening, for the ramp-up the backend reports and the program's own work.
const LISTEN_MARGIN_US = 0

// A stream that has not heard its peer in this many ISO intervals fails to establish
// (Section 4.5.2).
const ESTABLISH_INTERVALS = 6

// ── Status and reason codes, [Vol 1] Part F ──────────────────────────

const STATUS_SUCCESS = 0x00
const STATUS_UNKNOWN_CONNECTION = 0x02
const STATUS_MEMORY_CAPACITY = 0x07
const STATUS_CONNECTION_LIMIT = 0x09
const STATUS_ACCEPT_TIMEOUT = 0x10
const STATUS_COMMAND_DISALLOWED = 0x0C
const STATUS_UNSUPPORTED_FEATURE = 0x11
const STATUS_INVALID_PARAMETERS = 0x12
const STATUS_UNSUPPORTED_REMOTE = 0x1A
const STATUS_INVALID_LL_PARAMETERS = 0x1E
const STATUS_UNSUPPORTED_LL_PARAMETER = 0x20
const STATUS_CONNECTION_REJECTED_LIMITED = 0x0D
const STATUS_PARAMETER_OUT_OF_RANGE = 0x30
const STATUS_CONTROLLER_BUSY = 0x3A
const STATUS_FAILED_TO_ESTABLISH = 0x3E
const REASON_TIMEOUT = 0x08
const REASON_REMOTE_TERMINATED = 0x13
const REASON_LOCAL_HOST = 0x16
const REASON_MIC_FAILURE = 0x3D
const REASON_INSTANT_PASSED = 0x28
const REASON_RESPONSE_TIMEOUT = 0x22

// ── The states of a stream ───────────────────────────────────────────

// The slot is free, holds the configuration of a stream the Central's Host set with LE Set CIG
// Parameters, is a request the Peripheral's Host has not answered, a request it accepted (the
// LL_CIS_RSP is queued or sent, and LL_CIS_IND awaited), a stream the Central is creating
// (the LL_CIS_REQ is queued or sent; the LL_CIS_RSP awaited), a stream whose LL_CIS_IND is
// queued (Central), a stream scheduled that has not yet heard its peer, an established stream, or
// a stream that ended and owes the Host events.
const S_FREE = 0
const S_CONFIG = 1
const S_REQUESTED = 2
const S_ACCEPTED = 3
const S_CREATING = 4
const S_IND = 5
const S_WAIT = 6
const S_UP = 7
const S_CLOSING = 8

// The events a stream owes the Host (`Cis.owed`).
const EV_REQUEST = 1
const EV_ESTABLISHED = 2
const EV_DISCONNECTED = 4
const EV_COMPLETED = 8

// A debt the Controller owes the peer, not the Host: the LL_CIS_RSP of an accepted request is yet to be
// queued on the ACL.
const EV_SEND_RSP = 16

// The same for the Central: LL_CIS_REQ to send, LL_CIS_RSP to wait for, LL_CIS_IND to send, and the peer's feature set to wait for
// before the request goes out.
const EV_SEND_REQ = 32
const EV_WAIT_RSP = 64
const EV_SEND_IND = 128
const EV_WAIT_FEAT = 256

// The SDU status of an HCI ISO Data packet: valid, possibly invalid, lost.
const SDU_VALID = 0
const SDU_INVALID = 1
const SDU_LOST = 2

// The states of a group (Section 4.5.14.3).
const G_CONFIGURABLE = 0
const G_ACTIVE = 1
const G_INACTIVE = 2

// ── The tables ───────────────────────────────────────────────────────

// A group of the Central: `cig_id`, the Host's choices common to the streams (`packing`, `framing`,
// `sca`, the SDU intervals, the transport latencies in milliseconds), and, for LE Set CIG
// Parameters Test, the flush timeouts and ISO interval it gave (`test`).  `sync` is CIG_Sync_Delay
// once the streams are scheduled.
@value
struct Cig
    used: Bool
    state: Int
    cig_id: Int
    packing: Int
    framing: Int
    sca: Int
    sdu_int_c: Int
    sdu_int_p: Int
    lat_c: Int
    lat_p: Int
    test: Bool
    ft_c: Int
    ft_p: Int
    iso_int: Int
    sync: Int
    ref_t: Int
    ref_ok: Bool

// A stream.  `state`, `owed`, `status` (of the LE CIS Established event) and `reason` (of the
// Disconnection Complete), `cig_id`, `cis_id`, `handle`, `acl` (the slot of the ACL link; -1
// for none), `central`.  The parameters: `phy` (1, 2 or 3 as HCI numbers it, one for both
// directions), the SDU sizes and intervals, the PDU sizes, NSE, Sub_Interval in microseconds, BN,
// FT, ISO_Interval in units of 1.25 ms.  `cis_offset`, `cig_sync`, `cis_sync` (microseconds) and
// `aa`.  `off_min`, `off_max` and `off_ev` are the window of LL_CIS_REQ and LL_CIS_RSP, `ind_ev` the
// connEventCount of LL_CIS_IND.
//
// The schedule: the stream is at CIS event `ev`, whose anchor point is `anchor` (as far as this end
// knows it) and next subevent `sub` (1 to NSE; past NSE when the event is over).  `synced` says some
// CIS PDU of the peer arrived, `ev_synced` that one arrived in this event, `last_rx` is the time
// of the last good one, `closed` that the event was closed early, `first_us` the time of the first
// anchor.  `sup_us` is the supervision timeout.
//
// The data: `enc` says the ACL is encrypted.  `tx_num` is the number of the payload sent next,
// `tx_wr` the number the next payload gets, `sent_num` the number of the payload sent in this
// subevent (-1 for a Null PDU), `tx_hi` the number after the highest sent so far, `rx_num` the next
// number expected.  The ring: `txd` holds
// `PAYLOAD_SLOTS` slots of `SLOT_OCTETS`, `txl` the payload lengths and `txf` the flags (LLID in
// bits 0 and 1, bit 2 the last payload of an SDU the Host supplied, bit 3 padding, bits 8 to 15 on that payload the HCI packets the SDU
// came in: the credits the Host gets back).  `hbuf`, `h_n`, `h_exp`, `h_open` and `h_frags` are the fragments of an SDU the Host is
// sending in several HCI ISO Data packets, put together before the SDU is cut into payloads (`sdu_frag`).  The recombination: the SDU
// being put together from the payloads goes to the slot of `outd` after the last one queued, `asm_idx` is its index, `asm_n` its octets,
// `asm_ok` that the slot was free when the first octets came, `asm_got`, `asm_end` and `asm_bad` say a payload arrived, the end
// fragment arrived and a payload was missing.  With `defer` the octets of a received payload are not moved when it is noted but
// left for the radio program (`cp_n` octets for the place `cp_at`, the payload number `cp_num`, `rx_copy`).  `outd`, `outl`, `outs`,
// `outt` and `outq` hold the SDUs done and not yet sent to the Host (data, length, status, time stamp, sequence number), `out_head`
// and `out_n` the queue, `out_off` the octets of the oldest already sent in fragments.  `tx_credit` counts the SDUs the Host may
// send, `comp` the packets of those done since the Host was told.  `dp_in` and `dp_out` say the data paths are set.  The counters follow.
@value
struct Cis
    state: Int
    owed: Int
    status: Int
    reason: Int
    cig_id: Int
    cis_id: Int
    handle: Int
    acl: Int
    central: Bool
    phy: Int
    phy_p: Int
    framed: Bool
    max_sdu_c: Int
    max_sdu_p: Int
    sdu_int_c: Int
    sdu_int_p: Int
    max_pdu_c: Int
    max_pdu_p: Int
    nse: Int
    sub_int: Int
    bn_c: Int
    bn_p: Int
    ft_c: Int
    ft_p: Int
    iso_int: Int
    cis_offset: Int
    cig_sync: Int
    cis_sync: Int
    aa: Int
    rq_phy_c: Int
    rq_phy_p: Int
    rq_rtn_c: Int
    rq_rtn_p: Int
    off_cig: Int
    off_min: Int
    off_max: Int
    off_ev: Int
    ind_ev: Int
    anchor: Int
    ev: Int
    sub: Int
    synced: Bool
    ev_synced: Bool
    ev_open: Bool
    closed: Bool
    last_rx: Int
    first_us: Int
    sup_us: Int
    enc: Bool
    tx_num: Int
    tx_wr: Int
    sent_num: Int
    tx_hi: Int
    rx_num: Int
    txd: Vec[u8; if noble_controller_config.CTL_CIS > 0 then 2048 else 8]
    txl: Vec[Int; 8]
    txf: Vec[Int; 8]
    f_ack: Bool
    f_new: Bool
    f_cie: Bool
    f_npi: Bool
    use_nxt: Bool
    hbuf: Vec[u8; if noble_controller_config.CTL_CIS > 0 then 512 else 8]
    h_n: Int
    h_exp: Int
    h_open: Bool
    h_frags: Int
    h_ref: Int
    rs_base: Int
    rs_n: Int
    rs_seq: Int
    rs_ok: Bool
    unseg: Bool
    fo_open: Bool
    fo_num: Int
    fo_off: Int
    fa_open: Bool
    fa_gap: Bool
    fa_ts: Int
    fa_prev: Int
    fa_prev_ok: Bool
    asm_idx: Int
    asm_n: Int
    asm_ok: Bool
    defer: Bool
    cp_n: Int
    cp_at: Int
    cp_num: Int
    asm_got: Bool
    asm_end: Bool
    asm_bad: Bool
    outd: Vec[u8; if noble_controller_config.CTL_CIS > 0 then 1024 else 8]
    outl: Vec[Int; 2]
    outs: Vec[Int; 2]
    outt: Vec[Int; 2]
    outq: Vec[Int; 2]
    out_head: Int
    out_n: Int
    out_off: Int
    tx_credit: Int
    comp: Int
    sdu_in: Int
    dp_in: Bool
    dp_out: Bool
    n_tx: Int
    n_rx: Int
    n_null_tx: Int
    n_null_rx: Int
    n_retx: Int
    n_flush_tx: Int
    n_flush_rx: Int
    n_crc: Int
    n_dup: Int
    n_unack: Int
    n_sdu_ok: Int
    n_sdu_bad: Int
    n_sdu_lost: Int
    n_sdu_drop: Int
    n_host_drop: Int
    n_events: Int
    n_missed: Int
    n_good: Int
    n_bad: Int
    t_try: Int
    ph_try: Int
    e_ind: Int
    t_ind: Int
    e_try: Int
    a_try: Int
    err_n: Int
    err_first: Int
    err_min: Int
    err_max: Int
    late_mask: Int
    late_n: Int
    t_mode: Int
    t_nf: Int

// A free slot.
@tier(embedded)
fn cis_new() -> Cis
    var x = Cis {
        state: S_FREE, owed: 0, status: 0, reason: 0, cig_id: 0, cis_id: 0, handle: 0, acl: -1,
        central: false, phy: 1, phy_p: 0, framed: false, max_sdu_c: 0, max_sdu_p: 0, sdu_int_c: 0, sdu_int_p: 0,
        max_pdu_c: 0, max_pdu_p: 0, nse: 1, sub_int: 0, bn_c: 0, bn_p: 0, ft_c: 1, ft_p: 1,
        iso_int: 0, cis_offset: 0, cig_sync: 0, cis_sync: 0, aa: 0, rq_phy_c: 0, rq_phy_p: 0, rq_rtn_c: 0, rq_rtn_p: 0, off_cig: 0, off_min: 0, off_max: 0, off_ev: 0,
        ind_ev: 0, anchor: 0, ev: 0, sub: 1, synced: false, ev_synced: false, ev_open: false, closed: false,
        last_rx: 0, first_us: 0, sup_us: 0, enc: false, tx_num: 0, tx_wr: 0, sent_num: -1,
        tx_hi: 0, rx_num: 0, txd: Vec.new(), txl: Vec.new(), txf: Vec.new(), f_ack: false, f_new: false,
        f_cie: false, f_npi: false, use_nxt: false, hbuf: Vec.new(), h_n: 0, h_exp: 0, h_open: false, h_frags: 0, h_ref: 0, rs_base: 0, rs_n: 0, rs_seq: 0, rs_ok: false, unseg: false, fo_open: false, fo_num: 0, fo_off: 0,
        fa_open: false, fa_gap: false, fa_ts: 0, fa_prev: 0, fa_prev_ok: false, asm_idx: 0, asm_n: 0, asm_ok: false, defer: false, cp_n: 0, cp_at: 0, cp_num: 0,
        asm_got: false, asm_end: false, asm_bad: false, outd: Vec.new(), outl: Vec.new(),
        outs: Vec.new(), outt: Vec.new(), outq: Vec.new(), out_head: 0, out_n: 0, out_off: 0, tx_credit: 0,
        comp: 0, sdu_in: 0, dp_in: false, dp_out: false, n_tx: 0, n_rx: 0, n_null_tx: 0,
        n_null_rx: 0, n_retx: 0, n_flush_tx: 0, n_flush_rx: 0, n_crc: 0, n_dup: 0, n_unack: 0,
        n_sdu_ok: 0, n_sdu_bad: 0, n_sdu_lost: 0, n_sdu_drop: 0, n_host_drop: 0, n_events: 0,
        n_missed: 0, n_good: 0, n_bad: 0, t_try: 0, ph_try: 0, e_ind: 0, t_ind: 0, e_try: 0, a_try: 0, err_n: 0, err_first: 0, err_min: 1000000, err_max: -1000000, late_mask: 0, late_n: 0, t_mode: 0, t_nf: 0 }
    for _ in 0..x.txd.capacity()
        let _a = x.txd.push(0)
    for _ in 0..PAYLOAD_SLOTS
        let _b = x.txl.push(0)
        let _c = x.txf.push(0)
    for _ in 0..x.hbuf.capacity()
        let _j = x.hbuf.push(0)
    for _ in 0..x.outd.capacity()
        let _e = x.outd.push(0)
    for _ in 0..OUT_SLOTS
        let _f = x.outl.push(0)
        let _g = x.outs.push(0)
        let _h = x.outt.push(0)
        let _i = x.outq.push(0)
    x

// A group slot that holds nothing.
@tier(embedded)
fn cig_new() -> Cig
    Cig { used: false, state: G_CONFIGURABLE, cig_id: 0, packing: 0, framing: 0, sca: 0,
          sdu_int_c: 0, sdu_int_p: 0, lat_c: 0, lat_p: 0, test: false, ft_c: 1, ft_p: 1,
          iso_int: 0, sync: 0, ref_t: 0, ref_ok: false }

// Forget everything of a stream but its identity in the tables (its slot and handle): the stream
// goes to `state`.  The configuration of a stream that is only terminated stays (Section 4.5.14);
// `cis_free` takes it all.
@tier(embedded)
fn cis_reset_run(var x: Cis, state: Int)
    x.state = state
    x.owed = 0
    x.status = 0
    x.reason = 0
    x.acl = -1
    x.phy_p = 0
    x.synced = false
    x.ev_synced = false
    x.ev_open = false
    x.closed = false
    x.anchor = 0
    x.ev = 0
    x.sub = 1
    x.last_rx = 0
    x.first_us = 0
    x.enc = false
    x.tx_num = 0
    x.tx_wr = 0
    x.sent_num = -1
    x.tx_hi = 0
    x.rx_num = 0
    x.f_ack = false
    x.f_new = false
    x.f_cie = false
    x.f_npi = false
    x.use_nxt = false
    x.fo_open = false
    x.fo_num = 0
    x.fo_off = 0
    x.fa_open = false
    x.fa_gap = false
    x.fa_ts = 0
    x.fa_prev = 0
    x.fa_prev_ok = false
    x.asm_idx = 0
    x.asm_n = 0
    x.asm_ok = false
    x.defer = false
    x.cp_n = 0
    x.cp_at = 0
    x.cp_num = 0
    x.asm_got = false
    x.asm_end = false
    x.asm_bad = false
    x.out_head = 0
    x.out_n = 0
    x.out_off = 0
    x.h_n = 0
    x.h_exp = 0
    x.h_open = false
    x.h_frags = 0
    x.h_ref = 0
    x.rs_base = 0
    x.rs_n = 0
    x.rs_seq = 0
    x.rs_ok = false
    x.tx_credit = 0
    x.comp = 0
    x.sdu_in = 0
    x.n_tx = 0
    x.n_rx = 0
    x.n_null_tx = 0
    x.n_null_rx = 0
    x.n_retx = 0
    x.n_flush_tx = 0
    x.n_flush_rx = 0
    x.n_crc = 0
    x.n_dup = 0
    x.n_unack = 0
    x.n_sdu_ok = 0
    x.n_sdu_bad = 0
    x.n_sdu_lost = 0
    x.n_sdu_drop = 0
    x.n_host_drop = 0
    x.n_events = 0
    x.n_missed = 0
    x.n_good = 0
    x.n_bad = 0
    x.t_try = 0
    x.ph_try = 0
    x.e_ind = 0
    x.t_ind = 0
    x.e_try = 0
    x.a_try = 0
    x.err_n = 0
    x.err_first = 0
    x.err_min = 1000000
    x.err_max = -1000000
    x.late_mask = 0
    x.late_n = 0
    x.t_mode = 0
    x.t_nf = 0
    for k in 0..PAYLOAD_SLOTS
        x.txl[k] = 0
        x.txf[k] = 0

// ── The parameters of one direction ──────────────────────────────────

// The burst number, flush timeout, largest PDU and largest SDU of the direction this end
// transmits, and of the direction it receives.
@tier(embedded)
fn tx_bn(var x: Cis) -> Int
    if x.central
        x.bn_c
    else
        x.bn_p

@tier(embedded)
fn rx_bn(var x: Cis) -> Int
    if x.central
        x.bn_p
    else
        x.bn_c

@tier(embedded)
fn tx_ft(var x: Cis) -> Int
    if x.central
        x.ft_c
    else
        x.ft_p

@tier(embedded)
fn rx_ft(var x: Cis) -> Int
    if x.central
        x.ft_p
    else
        x.ft_c

@tier(embedded)
fn tx_pdu(var x: Cis) -> Int
    if x.central
        x.max_pdu_c
    else
        x.max_pdu_p

@tier(embedded)
fn rx_pdu(var x: Cis) -> Int
    if x.central
        x.max_pdu_p
    else
        x.max_pdu_c

@tier(embedded)
fn tx_sdu(var x: Cis) -> Int
    if x.central
        x.max_sdu_c
    else
        x.max_sdu_p

@tier(embedded)
fn rx_sdu(var x: Cis) -> Int
    if x.central
        x.max_sdu_p
    else
        x.max_sdu_c

@tier(embedded)
fn tx_sdu_int(var x: Cis) -> Int
    if x.central
        x.sdu_int_c
    else
        x.sdu_int_p

@tier(embedded)
fn rx_sdu_int(var x: Cis) -> Int
    if x.central
        x.sdu_int_p
    else
        x.sdu_int_c

// UPPS of a direction: the payloads of each SDU, ceil(Max_SDU / Max_PDU) (Part G, Section
// 2.1); 0 when the direction carries no data.
@tier(embedded)
fn upps(max_sdu: Int, max_pdu: Int, bn: Int) -> Int
    if bn == 0 or max_pdu == 0
        return 0
    if max_sdu <= 0
        return 1
    (max_sdu + max_pdu - 1) / max_pdu

@tier(embedded)
fn tx_upps(var x: Cis) -> Int
    upps(tx_sdu(var x), tx_pdu(var x), tx_bn(var x))

@tier(embedded)
fn rx_upps(var x: Cis) -> Int
    upps(rx_sdu(var x), rx_pdu(var x), rx_bn(var x))

// ISO_Interval in microseconds.
@tier(embedded)
fn iso_us(var x: Cis) -> Int
    x.iso_int * UNIT_US

// The microseconds of the longest packet of the stream's PHY with `pdu` octets of payload, the
// header and the MIC: MPT of Section 4.5.13.1 (the S=8 coding on the LE Coded PHY).
@tier(embedded)
fn mpt_us(phy: Int, pdu: Int) -> Int
    ll_phy.air_us(phy, true, 2 + pdu + ll_phy.MIC_OCTETS)

// SE_Length: MPT_C + T_IFS_CIS + MPT_P + T_MSS_CIS (Section 4.5.13.2).
@tier(embedded)
fn se_len_us(var x: Cis) -> Int
    mpt_us(x.phy, x.max_pdu_c) + T_IFS_CIS_US + mpt_us(phy_back(var x), x.max_pdu_p) + T_MSS_CIS_US

// The longest a CIS event takes: (NSE - 1) x Sub_Interval + MPT_C + T_IFS_CIS + MPT_P.
@tier(embedded)
fn event_len_us(var x: Cis) -> Int
    (x.nse - 1) * x.sub_int + mpt_us(x.phy, x.max_pdu_c) + T_IFS_CIS_US + mpt_us(phy_back(var x), x.max_pdu_p)

// The PHY of the Peripheral-to-Central direction: `phy` (the Central-to-Peripheral one) unless the request named another.  A
// Peripheral receives on `phy` and answers on this one.
@tier(embedded)
fn phy_back(var x: Cis) -> Int
    if x.phy_p == 0
        return x.phy
    x.phy_p

// ── Control PDUs, Section 2.4.2.29 to 2.4.2.32 ───────────────────────

// The PHY mask bit of the PDUs for an HCI PHY number, and the other way.
@tier(embedded)
fn phy_bit(phy: Int) -> Int
    ll_phy.mask_of(phy)

@tier(embedded)
fn put3(var p: Pdu, v: Int)
    let _a = ll_pdu.pdu_put(var p, v & 0xFF)
    let _b = ll_pdu.pdu_put(var p, (v >>> 8) & 0xFF)
    let _c = ll_pdu.pdu_put(var p, (v >>> 16) & 0xFF)

@tier(embedded)
fn put4(var p: Pdu, v: Int)
    put3(var p, v)
    let _a = ll_pdu.pdu_put(var p, (v >>> 24) & 0xFF)

// Octets `i` to `i + 2` and `i` to `i + 3` of the payload as little-endian values.
@tier(embedded)
fn get3(var p: Pdu, i: Int) -> Int
    ll_data.dpdu_byte(var p, i) | (ll_data.dpdu_byte(var p, i + 1) << 8) | (ll_data.dpdu_byte(var p, i + 2) << 16)

@tier(embedded)
fn get4(var p: Pdu, i: Int) -> Int
    get3(var p, i) | (ll_data.dpdu_byte(var p, i + 3) << 24)

// LL_CIS_REQ for the stream `x` (Central).  Max_SDU is 12 bits with the Framed flag in bit 15 of
// the Central-to-Peripheral value and the Framing_Mode flag (1 for Unsegmented mode) in bit 15 of the
// Peripheral-to-Central one; the BN of the two directions share an octet.
@satisfies("REQ-BLE-CTL-046")
@tier(embedded)
fn put_cis_req(var p: Pdu, var x: Cis)
    ll_data.ctrl_begin(var p, ll_data.OP_CIS_REQ)
    let _a = ll_pdu.pdu_put(var p, x.cig_id)
    let _b = ll_pdu.pdu_put(var p, x.cis_id)
    let _c = ll_pdu.pdu_put(var p, phy_bit(x.phy))
    let _d = ll_pdu.pdu_put(var p, phy_bit(phy_back(var x)))
    var framed = 0
    if x.framed
        framed = 0x8000
    ll_data.put_u16(var p, (x.max_sdu_c & 0x0FFF) | framed)
    var mode = 0
    if x.unseg
        mode = 0x8000
    ll_data.put_u16(var p, (x.max_sdu_p & 0x0FFF) | mode)
    put3(var p, x.sdu_int_c & 0xFFFFF)
    put3(var p, x.sdu_int_p & 0xFFFFF)
    ll_data.put_u16(var p, x.max_pdu_c)
    ll_data.put_u16(var p, x.max_pdu_p)
    let _e = ll_pdu.pdu_put(var p, x.nse)
    put3(var p, x.sub_int)
    let _f = ll_pdu.pdu_put(var p, (x.bn_c & 0x0F) | ((x.bn_p & 0x0F) << 4))
    let _g = ll_pdu.pdu_put(var p, x.ft_c)
    let _h = ll_pdu.pdu_put(var p, x.ft_p)
    ll_data.put_u16(var p, x.iso_int)
    put3(var p, x.off_min)
    put3(var p, x.off_max)
    ll_data.put_u16(var p, x.off_ev)
    ll_data.dpdu_finish(var p)

// The values of an LL_CIS_REQ in `p` into the stream `x` (Peripheral).  The caller has checked the
// length.  `phy` is the Central-to-Peripheral PHY and `phy_p` the Peripheral-to-Central one (the Peripheral answers each
// subevent on it, a direction with BN 0 included).  A field that names no single PHY is refused (`phy` 0), unless its direction
// carries nothing (BN 0), when it takes the other direction's PHY.
@satisfies("REQ-BLE-CTL-046")
@tier(embedded)
fn get_cis_req(var p: Pdu, var x: Cis)
    x.cig_id = ll_data.dpdu_byte(var p, 1)
    x.cis_id = ll_data.dpdu_byte(var p, 2)
    let pc = ll_phy.phy_of_mask(ll_data.dpdu_byte(var p, 3))
    let pp = ll_phy.phy_of_mask(ll_data.dpdu_byte(var p, 4))
    x.phy = pc
    x.phy_p = pp
    if pp == 0
        x.phy = 0
    let sc = ll_data.dpdu_u16(var p, 5)
    x.max_sdu_c = sc & 0x0FFF
    x.framed = (sc & 0x8000) != 0
    let sp = ll_data.dpdu_u16(var p, 7)
    x.max_sdu_p = sp & 0x0FFF
    x.unseg = (sp & 0x8000) != 0 and x.framed
    x.sdu_int_c = get3(var p, 9) & 0xFFFFF
    x.sdu_int_p = get3(var p, 12) & 0xFFFFF
    x.max_pdu_c = ll_data.dpdu_u16(var p, 15)
    x.max_pdu_p = ll_data.dpdu_u16(var p, 17)
    x.nse = ll_data.dpdu_byte(var p, 19)
    x.sub_int = get3(var p, 20)
    let bn = ll_data.dpdu_byte(var p, 23)
    x.bn_c = bn & 0x0F
    x.bn_p = bn >>> 4
    // A direction that carries nothing may leave its PHY field empty: its answers go on the Central's PHY.
    if pp == 0 and x.bn_p == 0
        x.phy = pc
        x.phy_p = pc
    if pc == 0 and x.bn_c == 0 and pp != 0
        x.phy = pp
    x.ft_c = ll_data.dpdu_byte(var p, 24)
    x.ft_p = ll_data.dpdu_byte(var p, 25)
    x.iso_int = ll_data.dpdu_u16(var p, 26)
    x.off_min = get3(var p, 28)
    x.off_max = get3(var p, 31)
    x.off_ev = ll_data.dpdu_u16(var p, 34)

// LL_CIS_RSP (Peripheral): the window of the first anchor the Peripheral accepts.
@satisfies("REQ-BLE-CTL-046")
@tier(embedded)
fn put_cis_rsp(var p: Pdu, var x: Cis)
    ll_data.ctrl_begin(var p, ll_data.OP_CIS_RSP)
    put3(var p, x.off_min)
    put3(var p, x.off_max)
    ll_data.put_u16(var p, x.off_ev)
    ll_data.dpdu_finish(var p)

@satisfies("REQ-BLE-CTL-046")
@tier(embedded)
fn get_cis_rsp(var p: Pdu, var x: Cis)
    x.off_min = get3(var p, 1)
    x.off_max = get3(var p, 4)
    x.off_ev = ll_data.dpdu_u16(var p, 7)

// LL_CIS_IND (Central): the access address, the offset of the first anchor from the ACL anchor of
// the event `ind_ev`, the two synchronization delays.
@satisfies("REQ-BLE-CTL-046")
@tier(embedded)
fn put_cis_ind(var p: Pdu, var x: Cis)
    ll_data.ctrl_begin(var p, ll_data.OP_CIS_IND)
    put4(var p, x.aa)
    put3(var p, x.cis_offset)
    put3(var p, x.cig_sync)
    put3(var p, x.cis_sync)
    ll_data.put_u16(var p, x.ind_ev)
    ll_data.dpdu_finish(var p)

@satisfies("REQ-BLE-CTL-046")
@tier(embedded)
fn get_cis_ind(var p: Pdu, var x: Cis)
    x.aa = get4(var p, 1)
    x.cis_offset = get3(var p, 5)
    x.cig_sync = get3(var p, 8)
    x.cis_sync = get3(var p, 11)
    x.ind_ev = ll_data.dpdu_u16(var p, 14)

// LL_CIS_TERMINATE_IND with the identifiers and the reason.
@satisfies("REQ-BLE-CTL-047")
@tier(embedded)
fn put_cis_terminate(var p: Pdu, cig_id: Int, cis_id: Int, reason: Int)
    ll_data.ctrl_begin(var p, ll_data.OP_CIS_TERMINATE_IND)
    let _a = ll_pdu.pdu_put(var p, cig_id)
    let _b = ll_pdu.pdu_put(var p, cis_id)
    let _c = ll_pdu.pdu_put(var p, reason)
    ll_data.dpdu_finish(var p)

// ── Checking a request, Section 5.1.15 ───────────────────────────────

// The error code to reject the request `x` that `get_cis_req` read with, 0 to take it.  `offset_max`
// is what the ACL connection interval allows (CIS_Offset_Max below connInterval).  The mandatory
// range of Section 4.5.13.1 is taken, less what this Controller does not do: rings smaller
// than the flush window needs.  A framed direction needs a PDU of 6 octets at least: a Segmentation Header, a Time_Offset
// and an octet of the SDU; in Unsegmented mode a PDU of either direction holds a whole SDU of Max_SDU with them (the Framing_Mode
// flag of an unframed request is reserved and was dropped by `get_cis_req`).
@satisfies("REQ-BLE-CTL-046")
@tier(embedded)
fn cis_req_check(var x: Cis, conn_interval_us: Int) -> Int
    cis_req_why(var x, conn_interval_us) & 0xFF

// `cis_req_check` with the branch that refused: the error code in the low octet and the number of the branch above it
// (`WHY_*`), 0 when the request is taken.  The codes follow [Vol 6] Part B, Section 5.1.15: a PHY pair that is not one single
// supported PHY, and any value the Controller does not do, are refused; a BN, FT or NSE it cannot hold (here also the
// ring) with Parameter Out of Mandatory Range (0x30).
@tier(embedded)
fn cis_req_why(var x: Cis, conn_interval_us: Int) -> Int
    if x.phy == 0
        return (WHY_PHY << 8) | STATUS_UNSUPPORTED_LL_PARAMETER
    if x.nse < 1 or x.nse > 31 or x.bn_c > 15 or x.bn_p > 15
        return (WHY_NSE_BN_RANGE << 8) | STATUS_PARAMETER_OUT_OF_RANGE
    if x.bn_c > x.nse or x.bn_p > x.nse or x.ft_c < 1 or x.ft_p < 1
        return (WHY_BN_NSE_FT << 8) | STATUS_PARAMETER_OUT_OF_RANGE
    if x.bn_c == 0 and x.bn_p == 0
        return (WHY_NO_DIRECTION << 8) | STATUS_PARAMETER_OUT_OF_RANGE
    if x.max_pdu_c > ll_data.PAYLOAD_EXT_MAX or x.max_pdu_p > ll_data.PAYLOAD_EXT_MAX
        return (WHY_PDU_RANGE << 8) | STATUS_PARAMETER_OUT_OF_RANGE
    if (x.bn_c == 0) != (x.max_pdu_c == 0) or (x.bn_p == 0) != (x.max_pdu_p == 0)
        return (WHY_PDU_BN << 8) | STATUS_PARAMETER_OUT_OF_RANGE
    if x.iso_int < 4 or x.iso_int > 3200
        return (WHY_ISO_INT << 8) | STATUS_PARAMETER_OUT_OF_RANGE
    if x.nse > 1 and (x.sub_int < 400 or x.sub_int >= x.iso_int * UNIT_US)
        return (WHY_SUB_INT << 8) | STATUS_PARAMETER_OUT_OF_RANGE
    if x.nse == 1 and x.sub_int != 0
        return (WHY_SUB_INT_NSE1 << 8) | STATUS_PARAMETER_OUT_OF_RANGE
    if x.nse * x.sub_int > x.iso_int * UNIT_US
        return (WHY_SUBEVENTS_LONG << 8) | STATUS_PARAMETER_OUT_OF_RANGE
    if x.off_min < 500 or x.off_max < x.off_min or x.off_max >= conn_interval_us
        return (WHY_OFFSET << 8) | STATUS_PARAMETER_OUT_OF_RANGE
    if x.sdu_int_c < 255 and x.bn_c > 0
        return (WHY_SDU_INT_C << 8) | STATUS_PARAMETER_OUT_OF_RANGE
    if x.sdu_int_p < 255 and x.bn_p > 0
        return (WHY_SDU_INT_P << 8) | STATUS_PARAMETER_OUT_OF_RANGE
    if x.max_sdu_c > SDU_MAX or x.max_sdu_p > SDU_MAX
        return (WHY_SDU_MAX << 8) | STATUS_PARAMETER_OUT_OF_RANGE
    if x.framed and ((x.bn_c > 0 and x.max_pdu_c < FR_START_MIN) or (x.bn_p > 0 and x.max_pdu_p < FR_START_MIN))
        return (WHY_FRAMED_PDU << 8) | STATUS_PARAMETER_OUT_OF_RANGE
    if x.unseg and ((x.bn_c > 0 and x.max_pdu_c < FR_HEADER + FR_TOFF + x.max_sdu_c) or (x.bn_p > 0 and x.max_pdu_p < FR_HEADER + FR_TOFF + x.max_sdu_p))
        return (WHY_UNSEG_PDU << 8) | STATUS_PARAMETER_OUT_OF_RANGE
    // A payload this end sends stays in the ring from its burst until its flush point: BN_P x (FT_P + 1) of them.  The
    // direction this end receives keeps nothing in the ring (the numbers are counted), only the flush of one event's burst
    // walks `PAYLOAD_SLOTS` numbers at most: a Central's FT of 9 for a sink stream is no reason to refuse it.
    if x.bn_p * (x.ft_p + 1) > PAYLOAD_SLOTS or x.bn_c > PAYLOAD_SLOTS
        return (WHY_RING << 8) | STATUS_PARAMETER_OUT_OF_RANGE
    0

// The branches of `cis_req_why`, `cis_req_gap` and `iso_req` that refuse a request (the high part of the value `cis_req_why` gives).
const WHY_PHY = 1
const WHY_NSE_BN_RANGE = 2
const WHY_BN_NSE_FT = 3
const WHY_NO_DIRECTION = 4
const WHY_PDU_RANGE = 5
const WHY_PDU_BN = 6
const WHY_ISO_INT = 7
const WHY_SUB_INT = 8
const WHY_SUB_INT_NSE1 = 9
const WHY_SUBEVENTS_LONG = 10
const WHY_OFFSET = 11
const WHY_SDU_INT_C = 12
const WHY_SDU_INT_P = 13
const WHY_SDU_MAX = 14
const WHY_FRAMED_PDU = 15
const WHY_UNSEG_PDU = 16
const WHY_RING = 17
const WHY_GAP = 18
const WHY_HOST_FEATURE = 19
const WHY_EVENT_MASK = 20
const WHY_NO_SLOT = 21
const WHY_DUPLICATE = 22
const WHY_ACCEPT_TIMEOUT = 23
const WHY_HOST_REJECT = 24

// What the Controller kept of the LL_CIS_REQ PDUs it saw: how many, how many it refused, how many the Link Layer dropped
// before the Controller (a payload of the wrong length), the code and the branch of the last refusal and the fields of
// that request (the PHY index, NSE, BN and FT of each direction, Max_PDU of each, ISO_Interval in 1.25 ms units, Sub_Interval, Max_SDU and SDU_Interval of each).
@value
struct CisLog
    seen: Int
    rejected: Int
    dropped: Int
    code: Int
    why: Int
    phy: Int
    nse: Int
    bn_c: Int
    bn_p: Int
    ft_c: Int
    ft_p: Int
    pdu_c: Int
    pdu_p: Int
    iso_int: Int
    sub_int: Int
    sdu_c: Int
    sdu_p: Int
    sdu_int_c: Int
    sdu_int_p: Int
    framed: Bool
    inds: Int
    ind_offset: Int
    ind_cig_sync: Int
    ind_cis_sync: Int
    ind_ev: Int
    acl_int: Int
    ind_phy_c: Int
    ind_phy_p: Int

@tier(embedded)
fn cis_log_new() -> CisLog
    CisLog { seen: 0, rejected: 0, dropped: 0, code: 0, why: 0, phy: 0, nse: 0, bn_c: 0, bn_p: 0, ft_c: 0, ft_p: 0, pdu_c: 0, pdu_p: 0, iso_int: 0, sub_int: 0, sdu_c: 0, sdu_p: 0, sdu_int_c: 0, sdu_int_p: 0, framed: false, inds: 0, ind_offset: 0, ind_cig_sync: 0, ind_cis_sync: 0, ind_ev: 0, acl_int: 0, ind_phy_c: 0, ind_phy_p: 0 }

// Note a refused request `x` with the error code `code` and the branch `why`.
@tier(embedded)
fn cis_log_reject(var l: CisLog, var x: Cis, code: Int, why: Int)
    l.rejected = l.rejected + 1
    l.code = code
    l.why = why
    l.phy = x.phy
    l.nse = x.nse
    l.bn_c = x.bn_c
    l.bn_p = x.bn_p
    l.ft_c = x.ft_c
    l.ft_p = x.ft_p
    l.pdu_c = x.max_pdu_c
    l.pdu_p = x.max_pdu_p
    l.iso_int = x.iso_int
    l.sub_int = x.sub_int
    l.sdu_c = x.max_sdu_c
    l.sdu_p = x.max_sdu_p
    l.sdu_int_c = x.sdu_int_c
    l.sdu_int_p = x.sdu_int_p
    l.framed = x.framed

// Note the LL_CIS_IND `x` (already read) that arrived on an ACL link of interval `acl_int` (1.25 ms units).
@tier(embedded)
fn cis_log_ind(var l: CisLog, var x: Cis, acl_int: Int)
    l.inds = l.inds + 1
    l.ind_offset = x.cis_offset
    l.ind_cig_sync = x.cig_sync
    l.ind_cis_sync = x.cis_sync
    l.ind_ev = x.ind_ev
    l.acl_int = acl_int
    l.ind_phy_c = x.phy
    l.ind_phy_p = phy_back(var x)

// The microseconds the two packets of one subevent and the interframe space between them take (MPT_C + T_IFS_CIS + MPT_P).
@tier(embedded)
fn exchange_us(phy: Int, pdu_c: Int, pdu_p: Int) -> Int
    mpt_us(phy, pdu_c) + T_IFS_CIS_US + mpt_us(phy, pdu_p)

// The status of a stream whose subevents follow each other closer than this radio can start them, 0 when the gap from
// the end of one subevent to the start of the next holds the ramp-up, its margin and the program's work
// (`ll_radio.subevent_gap_us`).  A stream of one subevent has no next one.  The status is Unsupported Feature or Parameter
// Value (0x11) in the HCI commands, since the Sub_Interval is a value this Controller cannot support and it is not out of
// range; the LL Control PDU of a Central's request is refused with Unsupported LL Parameter Value (0x20).  A radio not asked
// yet (`known` false) refuses nothing.
@tier(embedded)
fn sub_gap_status(prof: ll_radio.RadioProfile, phy: Int, nse: Int, sub_int: Int, pdu_c: Int, pdu_p: Int, status: Int) -> Int
    if not prof.known or nse < 2
        return 0
    if sub_int - exchange_us(phy, pdu_c, pdu_p) < ll_radio.subevent_gap_us(prof, phy)
        return status
    0

// A Central's request seen from the Peripheral: its own stream's subevents against the radio.
// The packets are timed without the MIC: a Central may leave it out of MPT (the specification says "should include", and a
// Sub_Interval of SE_Length without it is the least the specification allows), so a request at that least is not refused for it.
@tier(embedded)
fn cis_req_gap(var x: Cis, prof: ll_radio.RadioProfile) -> Int
    if not prof.known or x.nse < 2
        return 0
    let exchange = ll_phy.air_us(x.phy, true, 2 + x.max_pdu_c) + T_IFS_CIS_US + ll_phy.air_us(phy_back(var x), true, 2 + x.max_pdu_p)
    if x.sub_int - exchange < ll_radio.subevent_gap_us(prof, x.phy)
        return STATUS_UNSUPPORTED_LL_PARAMETER
    0

// ── Time ─────────────────────────────────────────────────────────────

// The anchor point of CIS event `e` as this end knows it: the anchor of the event under way
// moved by whole ISO intervals.
@tier(embedded)
fn event_anchor(var x: Cis, e: Int) -> Int
    x.anchor + (e - x.ev) * iso_us(x)

// The start of subevent `s` (1 to NSE) of the event under way.
@tier(embedded)
fn sub_start(var x: Cis, s: Int) -> Int
    x.anchor + (s - 1) * x.sub_int

// The window widening of a receiver that last heard the Central `elapsed` microseconds before
// the time it listens for, Section 4.5.7: both clocks' accuracies over the time, and the jitter.
// `central_ppm` is the Central's, the Peripheral's own is `ll_link.OWN_PPM`.
@tier(embedded)
fn widening_us(central_ppm: Int, elapsed: Int, cap: Int) -> Int
    var w = ((central_ppm + ll_link.OWN_PPM) * elapsed) / 1000000 + ll_link.JITTER_US
    if w > cap
        w = cap
    w

// ── Channel selection algorithm #2 for subevents, Section 4.5.8.3 ────

// One round of the generator of the subevent numbers: the permutation of the number with the
// channel identifier, the multiply, add and modulo block, and the identifier again.
@tier(embedded)
fn prn_next(id: Int, x: Int) -> Int
    ((17 * ll_link.csa2_permute((x ^ id) & 0xFFFF) + id) & 0xFFFF) ^ id

// The minimum distance between the channels of consecutive subevents for `n` used channels.
@tier(embedded)
fn sub_distance(n: Int) -> Int
    ll_phy.greater(1, ll_phy.greater(ll_phy.lesser(3, n - 5), ll_phy.lesser(11, (n - 10) / 2)))

// The index in the table of used channels of the channel of `prn_e` ([Vol 6] Part B, Section
// 4.5.8.3.4): the unmapped channel's own index, or the one the number scales to.
@tier(embedded)
fn event_index(prn_e: Int, map: Int, n_used: Int) -> Int
    let unmapped = prn_e % 37
    if ((map >>> unmapped) & 1) == 1
        var idx = 0
        for ch in 0..unmapped
            idx = idx + ((map >>> ch) & 1)
        return idx
    (n_used * prn_e) >>> 16

// The channel of subevent `s` (1 to NSE) of CIS event `ev` of the stream with the access address `aa`,
// on the data channels of `map` (`n_used` of them).  The first subevent takes the event's channel
// and the next ones the chain of Section 4.5.8.3.5 and 4.5.8.3.6.
@satisfies("REQ-BLE-CTL-048")
@tier(embedded)
fn sub_channel(aa: Int, ev: Int, s: Int, map: Int, n_used: Int) -> Int
    let id = (aa >>> 16) ^ (aa & 0xFFFF)
    let prn_e = ll_link.csa2_prn(id, ev & 0xFFFF)
    var idx = event_index(prn_e, map, n_used)
    if s <= 1
        return ll_link.nth_used(map, idx)
    var prn = prn_e
    let d = sub_distance(n_used)
    for _ in 2..(s + 1)
        prn = prn_next(id, prn)
        idx = (idx + d + ((prn * (n_used - 2 * d + 1)) >>> 16)) % n_used
    ll_link.nth_used(map, idx)

// ── Flush points, Section 4.5.13.5 ───────────────────────────────────

// The CIS event and the subevent count after which payload `num` is flushed: it is discarded
// after U subevents of the event E + FT - 1, E = floor(num / BN), U = NSE - floor(NSE / BN) x (BN
// - 1 - num mod BN).
@tier(embedded)
fn flush_event(num: Int, bn: Int, ft: Int) -> Int
    num / bn + ft - 1

@tier(embedded)
fn flush_subs(num: Int, bn: Int, nse: Int) -> Int
    nse - (nse / bn) * (bn - 1 - num % bn)

// Whether payload `num` has reached its flush point by the time subevent `s` of event `e` begins.
@satisfies("REQ-BLE-CTL-049")
@tier(embedded)
fn flushed(num: Int, bn: Int, ft: Int, nse: Int, e: Int, s: Int) -> Bool
    let fe = flush_event(num, bn, ft)
    if e > fe
        return true
    e == fe and s > flush_subs(num, bn, nse)

// ── The transmit side ────────────────────────────────────────────────

@tier(embedded)
fn slot_of(num: Int) -> Int
    num % PAYLOAD_SLOTS

// The payload slots free in the ring.
@tier(embedded)
fn tx_room(var x: Cis) -> Int
    PAYLOAD_SLOTS - (x.tx_wr - x.tx_num)

// Write one payload at the next number: `n` octets of `hbuf` from `off` (the whole SDU is cut by the caller)
// with the flags `f`.
@tier(embedded)
fn tx_push(var x: Cis, off: Int, n: Int, f: Int)
    let sl = slot_of(x.tx_wr)
    for i in 0..n
        x.txd[sl * SLOT_OCTETS + i] = x.hbuf[off + i]
    x.txl[sl] = n
    x.txf[sl] = f
    x.tx_wr = x.tx_wr + 1

// Padding: an empty PDU of LLID 1 (Part G, Section 2.1), of LLID 2 and no segment on a framed stream (Section 2.2).
@tier(embedded)
fn tx_pad(var x: Cis)
    let sl = slot_of(x.tx_wr)
    x.txl[sl] = 0
    if x.framed
        x.txf[sl] = 2 | 8
    else
        x.txf[sl] = 1 | 8
    x.tx_wr = x.tx_wr + 1

// Take the SDU of `len` octets that is in `hbuf` for transmission: it becomes UPPS payloads, the real
// fragments LLID 1 (start or continuation) and the last LLID 0, the rest padding (Part G, Section
// 2.1); a zero-length SDU is one empty payload of LLID 0.  `frags` is the number of HCI ISO Data packets the
// Host sent it in: the last payload carries it (bits 8 to 15 of its flags), and the Host is given that many
// credits when the payload is acknowledged or flushed.  False when the Host's SDU is too long or the ring has
// not the room, nothing written.
@satisfies("REQ-BLE-CTL-050")
@tier(embedded)
fn sdu_put_held(var x: Cis, len: Int, frags: Int) -> Bool
    if x.framed
        return fsdu_put_held(var x, len, frags, x.h_ref)
    let up = tx_upps(var x)
    let mp = tx_pdu(var x)
    if up == 0 or len > tx_sdu(var x) or len > SDU_MAX or tx_room(var x) < up
        return false
    var cuts = 1
    if len > 0
        cuts = (len + mp - 1) / mp
    for k in 0..up
        if k < cuts
            var n = len - k * mp
            if n > mp
                n = mp
            if n < 0
                n = 0
            var llid = 1
            if k == cuts - 1
                llid = 0
            tx_push(var x, k * mp, n, llid)
        else
            tx_pad(var x)
    // The last payload of the SDU carries the end flag, whether it is a fragment or padding.
    let last = slot_of(x.tx_wr - 1)
    x.txf[last] = x.txf[last] | 4 | (frags << 8)
    x.sdu_in = x.sdu_in + 1
    true

// A complete SDU in an HCI packet: `len` octets at `off` of `d`, held in `hbuf` and taken as above, one credit.
@satisfies("REQ-BLE-CTL-050")
@tier(embedded)
fn sdu_put(var x: Cis, var d: Vec[u8; 260], off: Int, len: Int) -> Bool
    if len > x.hbuf.capacity()
        return false
    for i in 0..len
        x.hbuf[i] = d[off + i]
    sdu_put_held(var x, len, 1)

// The Host's credit for `k` HCI ISO Data packets that came to nothing, with the SDU they were part of: the Host counts a packet as
// its own until the Controller says it is done with it.
@tier(embedded)
fn sdu_credit(var x: Cis, k: Int)
    if k > 0
        x.comp = x.comp + k
        x.owed = x.owed | EV_COMPLETED

// The SDU the Host is sending in fragments is given up: the packets taken so far are credited back and nothing is held.
@tier(embedded)
fn sdu_abandon(var x: Cis)
    if x.h_open
        sdu_credit(var x, x.h_frags)
    x.h_open = false
    x.h_frags = 0

// A packet that cannot be used: the SDU under way is given up with it, and `k` credits go back (the packets of that SDU and this one).
@tier(embedded)
fn sdu_refuse(var x: Cis, k: Int) -> Bool
    x.h_open = false
    x.h_frags = 0
    sdu_credit(var x, k)
    false

// An HCI ISO Data packet of the Host with `n` octets of SDU at `off` of `d`, in the Packet_Boundary_Flag `pb` it came
// with (0 first fragment, 1 continuation, 2 complete SDU, 3 last fragment), `sdu_len` the length the first fragment
// (or the complete SDU) declared.  A first fragment begins the SDU, the others add to it, and the last hands it to the
// payloads.  False for a packet that does not follow the one before (a continuation with no first, more octets than
// the first declared, a last short of them) or finds no room: the SDU under way is dropped with it, and the credits of
// its packets go back to the Host.  A first fragment while one is open gives the open one up and begins its own.
@satisfies("REQ-BLE-CTL-050")
@satisfies("REQ-BLE-CTL-076")
@tier(embedded)
fn sdu_frag(var x: Cis, var d: Vec[u8; 260], off: Int, n: Int, pb: Int, sdu_len: Int) -> Bool
    var held = 0
    if x.h_open
        held = x.h_frags
    if pb == 2
        sdu_abandon(var x)
        if n != sdu_len or not sdu_put(var x, var d, off, n)
            return sdu_refuse(var x, 1)
        return true
    if pb == 0
        sdu_abandon(var x)
        if n >= sdu_len or sdu_len > SDU_MAX
            return sdu_refuse(var x, 1)
        x.h_n = 0
        x.h_exp = sdu_len
        x.h_frags = 0
        x.h_open = true
    else if not x.h_open
        return sdu_refuse(var x, 1)
    if x.h_n + n > x.h_exp
        return sdu_refuse(var x, held + 1)
    for i in 0..n
        x.hbuf[x.h_n + i] = d[off + i]
    x.h_n = x.h_n + n
    x.h_frags = x.h_frags + 1
    if pb != 3
        return true
    let packets = x.h_frags
    x.h_open = false
    x.h_frags = 0
    if x.h_n != x.h_exp or not sdu_put_held(var x, x.h_exp, packets)
        return sdu_refuse(var x, packets)
    true

// A complete SDU in an HCI packet for a framed stream: `len` octets at `off` of `d`, held in `hbuf` and taken as above, one credit.
@satisfies("REQ-BLE-CTL-097")
@tier(embedded)
fn fsdu_put(var x: Cis, var d: Vec[u8; 260], off: Int, len: Int, ref: Int) -> Bool
    if len > x.hbuf.capacity()
        return false
    for i in 0..len
        x.hbuf[i] = d[off + i]
    fsdu_put_held(var x, len, 1, ref)

// The reference time of an SDU that came in an HCI ISO Data packet with no Time_Stamp, from the time it `arrival` and the
// Packet_Sequence_Number `seq` (Part G, Section 3.1: a time stamp computed from a sequence counter the higher layer provides).  The
// Host's SDUs are one SDU interval apart, to its clock, but reach the Controller with the jitter of the Host and the HCI: taking each
// arrival for the time its SDU was made would make the Time_Offsets, and the time stamps the peer reconstructs from them, jump by the
// jitter, and a peer that counts SDUs by the time between them (the SoftDevice Controller does) would report SDUs lost that were not.
// The reference is on the clock of the sequence instead: SDU number n is due at `rs_base` + n x SDU interval, where `rs_base` falls to the
// earliest arrival seen (an SDU never arrives before it is made, so the clock is not later than that) and rises a thirty-second of the
// way to a later one (the Host's clock may run slower than this one).  A sequence that does not run (the same number again, a jump of
// over 255) or a reference more than two SDU intervals behind the arrival starts the clock again at the arrival.
@satisfies("REQ-BLE-CTL-097")
@tier(embedded)
fn fr_ref(var x: Cis, arrival: Int, seq: Int) -> Int
    let si = tx_sdu_int(var x)
    var step = 1
    if x.rs_ok
        step = (seq - x.rs_seq) & 0xFFFF
    if si <= 0 or not x.rs_ok or step == 0 or step > 255
        x.rs_base = arrival
        x.rs_n = 0
        x.rs_seq = seq
        x.rs_ok = true
        return arrival
    x.rs_n = x.rs_n + step
    x.rs_seq = seq
    let cand = arrival - x.rs_n * si
    if cand < x.rs_base
        x.rs_base = cand
    else
        x.rs_base = x.rs_base + (cand - x.rs_base) / 32
    var ref = x.rs_base + x.rs_n * si
    if arrival - ref > 2 * si
        x.rs_base = cand
        ref = arrival
    ref

// The octets of an SDU that go in a segment with `room` octets for data when `remaining` of the SDU are left: all of them if they fit; else
// as many as fit that leave a continuation of FR_TAIL_MIN octets at least, which is none when `room` is that little.
@tier(embedded)
fn fr_take(room: Int, remaining: Int) -> Int
    if remaining <= room
        return remaining
    var t = room
    if remaining - t < FR_TAIL_MIN
        t = remaining - FR_TAIL_MIN
    if t < 0
        t = 0
    t

// The CIG reference point of CIS event `e`: the anchor of the stream's event less the stream's offset in the group
// (CIG_Sync_Delay less CIS_Sync_Delay).  The Time_Offset of an SDU is measured to it (Part G, Section 3.1).
@tier(embedded)
fn cig_ref(var x: Cis, e: Int) -> Int
    event_anchor(var x, e) - (x.cig_sync - x.cis_sync)

// Take the SDU of `len` octets in `hbuf` for transmission on a framed stream (Part G, Section 2.2).  `ref` is the
// SDU's reference time (the Host's Time_Stamp, or the time it arrived put on the clock of its sequence, `fr_ref`), in the
// Controller's clock.  `frags` is the number of HCI ISO Data packets the Host sent it in.  The SDU is carried by segments: the first has a Segmentation Header with SC 0 and a Time_Offset, the CIG reference point of the
// event of the payload it is in less `ref`, so the payload goes in the first event whose reference point is not before `ref`
// (the payloads between are padding: a framed PDU of no octets).  A segment goes in the PDU that was last written when
// that has the room for a Segmentation Header, a Time_Offset and an octet (or for the 5 octets of an empty SDU); otherwise
// in a new payload; what does not fit continues in the next payload with SC 1 and no Time_Offset, the segment before it giving
// up octets if the continuation would be under FR_TAIL_MIN.  The credits of the SDUs that end in a payload (`frags` of each)
// are in bits 8 and up of its flags, which `tx_retire` returns to the Host.  False when the SDU is too long or the ring
// has not the room; nothing is then changed.
@satisfies("REQ-BLE-CTL-097")
@tier(embedded)
fn fsdu_put_held(var x: Cis, len: Int, frags: Int, ref: Int) -> Bool
    if x.unseg
        return usdu_put_held(var x, len, frags, ref)
    let bn = tx_bn(var x)
    let pdu = tx_pdu(var x)
    var need = FR_START_MIN
    if len == 0
        need = FR_EMPTY_MIN
    if bn == 0 or pdu < need or len > tx_sdu(var x) or len > SDU_MAX
        return false
    let wr0 = x.tx_wr
    let open0 = x.fo_open
    var sl0 = 0
    var len0 = 0
    var fl0 = 0
    if open0
        sl0 = slot_of(wr0 - 1)
        len0 = x.txl[sl0]
        fl0 = x.txf[sl0]
    var placed = 0
    var first = true
    var done = false
    var toff = 0
    var first_num = 0
    for _ in 0..32
        var use_open = false
        if x.fo_open and first
            let n = x.tx_wr - 1
            let free = pdu - x.txl[slot_of(n)]
            use_open = cig_ref(var x, n / bn) >= ref and free >= need and (len == 0 or fr_take(free - FR_HEADER - FR_TOFF, len) >= 1)
        if not use_open
            x.fo_open = false
            if first
                for _ in 0..PAYLOAD_SLOTS
                    if cig_ref(var x, x.tx_wr / bn) >= ref or tx_room(var x) < 2
                        break
                    tx_pad(var x)
                if cig_ref(var x, x.tx_wr / bn) < ref
                    break
            if tx_room(var x) < 1
                break
            let nsl = slot_of(x.tx_wr)
            x.txl[nsl] = 0
            x.txf[nsl] = 2
            x.tx_wr = x.tx_wr + 1
        let n = x.tx_wr - 1
        let sl = slot_of(n)
        let used = x.txl[sl]
        var hdr = FR_HEADER
        if first
            hdr = hdr + FR_TOFF
        var take = len - placed
        let room = pdu - used - hdr
        let last = take <= room
        if not last
            take = ll_phy.greater(fr_take(room, take), 1)
        var at = sl * SLOT_OCTETS + used
        var sc = 1
        if first
            sc = 0
        var cm = 0
        if last
            cm = 2
        x.txd[at] = (sc | cm) as u8
        if first
            x.txd[at + 1] = (take + FR_TOFF) as u8
            var t = cig_ref(var x, n / bn) - ref
            if t < 0
                t = 0
            if t > 0xFFFFFF
                t = 0xFFFFFF
            x.txd[at + 2] = (t & 0xFF) as u8
            x.txd[at + 3] = ((t >>> 8) & 0xFF) as u8
            x.txd[at + 4] = ((t >>> 16) & 0xFF) as u8
            toff = t
            first_num = n
            at = at + FR_TOFF
        else
            x.txd[at + 1] = take as u8
        for i in 0..take
            x.txd[at + 2 + i] = x.hbuf[placed + i]
        x.txl[sl] = used + hdr + take
        placed = placed + take
        first = false
        if last
            x.txf[sl] = x.txf[sl] + (frags << 8)
            x.fo_open = pdu - x.txl[sl] >= FR_EMPTY_MIN
            done = true
            break
        x.fo_open = false
    if not done
        x.tx_wr = wr0
        x.fo_open = open0
        if open0
            x.txl[sl0] = len0
            x.txf[sl0] = fl0
        return false
    x.sdu_in = x.sdu_in + 1
    x.fo_num = first_num
    x.fo_off = toff
    true

// Take the SDU of `len` octets in `hbuf` for transmission on a stream in Unsegmented mode (Part G, Section 2.2): the SDU is one segment of one
// payload, with its Segmentation Header (SC 0, CMPLT 1) and Time_Offset, and a payload may hold several SDUs but never a part of one.  The
// payload goes in the first event whose CIG reference point is not before `ref` (the payloads between are padding), in the payload that was
// last written when that has the room for the whole segment, in a new one otherwise.  False when the SDU is too long, does not fit
// a payload or the ring has not the room; nothing is then changed.
@satisfies("REQ-BLE-CTL-096")
@tier(embedded)
fn usdu_put_held(var x: Cis, len: Int, frags: Int, ref: Int) -> Bool
    let bn = tx_bn(var x)
    let pdu = tx_pdu(var x)
    let need = FR_HEADER + FR_TOFF + len
    if bn == 0 or pdu < need or len > tx_sdu(var x) or len > SDU_MAX
        return false
    let wr0 = x.tx_wr
    let open0 = x.fo_open
    var use_open = false
    if x.fo_open
        let n = x.tx_wr - 1
        use_open = cig_ref(var x, n / bn) >= ref and pdu - x.txl[slot_of(n)] >= need
    if not use_open
        x.fo_open = false
        for _ in 0..PAYLOAD_SLOTS
            if cig_ref(var x, x.tx_wr / bn) >= ref or tx_room(var x) < 2
                break
            tx_pad(var x)
        if cig_ref(var x, x.tx_wr / bn) < ref or tx_room(var x) < 1
            x.tx_wr = wr0
            x.fo_open = open0
            return false
        let nsl = slot_of(x.tx_wr)
        x.txl[nsl] = 0
        x.txf[nsl] = 2
        x.tx_wr = x.tx_wr + 1
    let n = x.tx_wr - 1
    let sl = slot_of(n)
    let used = x.txl[sl]
    var t = cig_ref(var x, n / bn) - ref
    if t < 0
        t = 0
    if t > 0xFFFFFF
        t = 0xFFFFFF
    let at = sl * SLOT_OCTETS + used
    x.txd[at] = 2
    x.txd[at + 1] = (len + FR_TOFF) as u8
    x.txd[at + 2] = (t & 0xFF) as u8
    x.txd[at + 3] = ((t >>> 8) & 0xFF) as u8
    x.txd[at + 4] = ((t >>> 16) & 0xFF) as u8
    for i in 0..len
        x.txd[at + 5 + i] = x.hbuf[i]
    x.txl[sl] = used + need
    x.txf[sl] = x.txf[sl] + (frags << 8)
    x.fo_open = pdu - x.txl[sl] >= FR_EMPTY_MIN
    x.sdu_in = x.sdu_in + 1
    x.fo_num = n
    x.fo_off = t
    true

// ── ISO test mode ([Vol 6] Part B, Section 7) ────────────────────────
//
// LE ISO Transmit Test makes the stream's Link Layer generate its SDUs, and LE ISO Receive Test has it count the SDUs it receives, in place of a Host.  `t_mode`
// holds the two modes: bits 0 and 1 the Payload_Type of the transmit test plus one (0 when it is off), bits 4 and 5 that of the receive test.  A test SDU is
// the 4-octet SDU counter (least significant octet first) and a pattern, 0 octets when Payload_Type is 0, 4 to Max_SDU octets when it is 1 and Max_SDU octets when it is 2.
// The counter of an unframed stream is the payload counter of the SDU's first payload divided by UPPS, that of a framed stream counts the SDUs from 0.  The
// receive counters are made of the SDUs the recombination finished (`out_put`, `test_rx_sdu`).

const TEST_TX = 3
const TEST_RX_SHIFT = 4

// The Payload_Type of the transmit test, -1 when it is off.
@tier(embedded)
fn test_tx_type(var x: Cis) -> Int
    (x.t_mode & TEST_TX) - 1

// The Payload_Type of the receive test, -1 when it is off.
@tier(embedded)
fn test_rx_type(var x: Cis) -> Int
    ((x.t_mode >>> TEST_RX_SHIFT) & TEST_TX) - 1

// The octets of the test SDU with the counter `counter` on the stream `x`: the length of the Payload_Type, in 4 to Max_SDU for the variable one.
@tier(embedded)
fn test_len(var x: Cis, counter: Int) -> Int
    let kind = test_tx_type(var x)
    var top = tx_sdu(var x)
    if top > x.hbuf.capacity()
        top = x.hbuf.capacity()
    if kind == 0
        return 0
    if kind == 2 or top <= 4
        return top
    4 + (counter * 13 + 7) % (top - 3)

// Make the test SDU with the counter `counter` and give it to the payloads; `ref` is its reference time on a framed stream.  False when the ring has no room.
@tier(embedded)
fn test_put(var x: Cis, counter: Int, ref: Int) -> Bool
    let len = test_len(var x, counter)
    for i in 0..len
        if i < 4
            x.hbuf[i] = ((counter >>> (8 * i)) & 0xFF) as u8
        else
            x.hbuf[i] = ((counter + i) & 0xFF) as u8
    x.h_ref = ref
    sdu_put_held(var x, len, 0)

// Fill the ring with test SDUs up to the payload number `want` (the end of the burst of the event under way).
@tier(embedded)
fn test_fill(var x: Cis, want: Int)
    let up = tx_upps(var x)
    let bn = tx_bn(var x)
    if up == 0 or bn == 0
        return
    for _ in 0..PAYLOAD_SLOTS
        if x.tx_wr >= want
            break
        var counter = x.tx_wr / up
        var ref = 0
        if x.framed
            counter = x.sdu_in
            ref = cig_ref(var x, x.tx_wr / bn)
        if not test_put(var x, counter, ref)
            break

// The SDU the recombination finished is counted.  The stream's counters of SDUs by status (`n_sdu_ok`, `n_sdu_bad`, `n_sdu_lost`, zero at the start of the test) hold the
// valid ones, those of an invalid payload and those of a missing one; the test adds `t_nf` (the Failed_SDU_Count in bits 32 to 63 and, in bits 0 to 31, the expected SDU
// counter plus one, 0 while the first valid SDU has not come): a valid SDU whose size is not in the range of the Payload_Type, or whose counter is not the expected one,
// is failed.  The expected counter starts at that of the first valid SDU, goes on by one for each SDU, and a missed SDU takes its counter with it.
//
//   Received_SDU_Count  valid and as expected   (`test_received`)
//   Missed_SDU_Count    lost, or of an invalid payload   (`test_missed`)
//   Failed_SDU_Count    valid and not as expected   (`test_failed`)
@tier(embedded)
fn test_rx_sdu(var x: Cis, status: Int)
    let kind = test_rx_type(var x)
    let n = x.asm_n
    var next = (x.t_nf & 0xFFFFFFFF) - 1
    var fail = x.t_nf >>> 32
    if status != SDU_VALID
        if next >= 0
            next = next + 1
    else if kind == 0
        if n != 0
            fail = fail + 1
    else
        let at = ((x.out_head + x.out_n) % OUT_SLOTS) * OUT_OCTETS
        if n < 4 or (kind == 2 and n != rx_sdu(var x)) or n > rx_sdu(var x)
            fail = fail + 1
        else
            let counter = (x.outd[at] as Int) | ((x.outd[at + 1] as Int) << 8) | ((x.outd[at + 2] as Int) << 16) | ((x.outd[at + 3] as Int) << 24)
            if next >= 0 and counter != next
                fail = fail + 1
            next = counter + 1
    x.t_nf = ((fail & 0xFFFFFFFF) << 32) | ((next + 1) & 0xFFFFFFFF)

@tier(embedded)
fn test_failed(var x: Cis) -> Int
    x.t_nf >>> 32

@tier(embedded)
fn test_received(var x: Cis) -> Int
    (x.n_sdu_ok - test_failed(var x)) & 0xFFFFFFFF

@tier(embedded)
fn test_missed(var x: Cis) -> Int
    (x.n_sdu_lost + x.n_sdu_bad) & 0xFFFFFFFF

// Begin the transmit test of Payload_Type `kind` (the SDUs are counted from 0), or the receive test (the counters from 0).
@tier(embedded)
fn test_tx_start(var x: Cis, kind: Int)
    x.t_mode = (x.t_mode & 0x30) | (kind + 1)
    x.sdu_in = 0

@tier(embedded)
fn test_rx_start(var x: Cis, kind: Int)
    x.t_mode = (x.t_mode & TEST_TX) | ((kind + 1) << TEST_RX_SHIFT)
    x.n_sdu_ok = 0
    x.n_sdu_bad = 0
    x.n_sdu_lost = 0
    x.t_nf = 0

// The first payloads of a CIS event: the burst of event `e` is numbers E x BN to (E + 1) x BN - 1, and
// the numbers the Host did not fill are padding.  A ring without the room leaves the burst short, which
// the flush rule makes up for.
@satisfies("REQ-BLE-CTL-050")
@tier(embedded)
fn tx_fill(var x: Cis, e: Int)
    let bn = tx_bn(var x)
    if bn == 0
        return
    let want = (e + 1) * bn
    // A framed PDU the burst of this event holds takes no more segments.
    if x.framed and x.fo_open and x.tx_wr - 1 < want
        x.fo_open = false
    if ctl_limits.test_on() and (x.t_mode & 3) != 0
        test_fill(var x, want)
    for _ in 0..PAYLOAD_SLOTS
        if x.tx_wr >= want or tx_room(var x) < 1
            break
        tx_pad(var x)

// Whether payload `num` may be sent in event `e`: it exists and its burst has begun.
@tier(embedded)
fn tx_eligible(var x: Cis, num: Int, e: Int) -> Bool
    let bn = tx_bn(var x)
    bn > 0 and num >= x.tx_num and num < x.tx_wr and num < (e + 1) * bn

// Retire payload `num`, the oldest one: it was acknowledged or flushed.  The Host's credit comes back for
// the last payload of a real SDU.
@tier(embedded)
fn tx_retire(var x: Cis, flush: Bool)
    let sl = slot_of(x.tx_num)
    var done = 0
    if x.framed
        done = x.txf[sl] >>> 8
    else if (x.txf[sl] & 4) != 0 and (not ctl_limits.test_on() or (x.t_mode & 3) == 0)
        done = ll_phy.greater(1, x.txf[sl] >>> 8)
    if done > 0
        x.comp = x.comp + done
        x.owed = x.owed | EV_COMPLETED
    if flush
        x.n_flush_tx = x.n_flush_tx + 1
        if x.tx_num < x.tx_hi
            x.n_unack = x.n_unack + 1
    x.tx_num = x.tx_num + 1

// Retire the payloads whose flush points have passed by the start of subevent `s` of event `e`.
@satisfies("REQ-BLE-CTL-049")
@tier(embedded)
fn tx_flush(var x: Cis, e: Int, s: Int)
    let bn = tx_bn(var x)
    if bn == 0
        return
    for _ in 0..PAYLOAD_SLOTS
        if x.tx_num >= x.tx_wr
            break
        if not flushed(x.tx_num, bn, tx_ft(var x), x.nse, e, s)
            break
        tx_retire(var x, true)

// The header octet of the PDU for payload `num`, or of a Null PDU when `num` is -1: the LLID, this end's
// NESN, the SN (the lowest bit of the number) and the NPI of a Null PDU.
@tier(embedded)
fn tx_header(var x: Cis, num: Int) -> Int
    let nesn = x.rx_num & 1
    if num < 0
        return 1 | (nesn << 2) | 0x40
    (x.txf[slot_of(num)] & 3) | (nesn << 2) | ((num & 1) << 3)

// Build the CIS PDU for payload `num` into `p` (a Null PDU for -1), with the payload not yet sealed.
@satisfies("REQ-BLE-CTL-051")
@tier(embedded)
fn tx_build(var x: Cis, num: Int, var p: Pdu)
    p.n = 0
    let _a = ll_pdu.pdu_put(var p, tx_header(var x, num))
    if num < 0
        let _b = ll_pdu.pdu_put(var p, 0)
        return
    let sl = slot_of(num)
    let n = x.txl[sl]
    let _c = ll_pdu.pdu_put(var p, n)
    // The octets go straight to the PDU: this runs in the time between two subevents, and a call for each octet costs more than
    // the copy (0.5 microseconds against one).
    let base = sl * SLOT_OCTETS
    for i in 0..n
        p.b[2 + i] = x.txd[base + i]
    p.n = 2 + n

// The PDU of payload `num` (-1 for a Null PDU) is on air: it is counted, and a payload sent again is a
// retransmission.
@tier(embedded)
fn tx_sent(var x: Cis, num: Int)
    x.sent_num = num
    if num < 0
        x.n_null_tx = x.n_null_tx + 1
        return
    x.n_tx = x.n_tx + 1
    if num < x.tx_hi
        x.n_retx = x.n_retx + 1
    else
        x.tx_hi = num + 1

// The number of the payload to send in subevent `s` of event `e`: the oldest unacknowledged one when its
// burst has begun, -1 for a Null PDU.  The flush rule has run before.
@tier(embedded)
fn tx_pick(var x: Cis, e: Int) -> Int
    if tx_eligible(var x, x.tx_num, e)
        x.tx_num
    else
        -1

// The number of the payload that follows the one in flight, if the peer's NESN acknowledges that one: -1 when
// there is none to send.
@tier(embedded)
fn tx_pick_next(var x: Cis, e: Int, s: Int) -> Int
    let n = x.tx_num + 1
    if x.tx_num < x.tx_wr and tx_eligible(var x, n, e) and not flushed(n, tx_bn(var x), tx_ft(var x), x.nse, e, s)
        n
    else
        -1

// ── The receive side ─────────────────────────────────────────────────

// The decision of the header of a received CIS PDU, in the time T_IFS_CIS leaves (the Peripheral's
// answer is picked from it): the peer's NESN against this end's SN says whether the payload in
// flight is acknowledged (`f_ack`), its SN against this end's NESN whether the payload is new
// (`f_new`), and the CIE and NPI bits.  The answer is the header octet of the PDU to send: the
// next payload's when the one in flight was acknowledged and the number `nxt` (from `tx_pick_next`)
// exists, the one in flight (`cur`) otherwise; `use_nxt` says which.  This end's NESN counts the new
// payload.
@satisfies("REQ-BLE-CTL-051")
@no_alloc
@tier(embedded)
fn rx_fast(var x: Cis, hdr0: Int, cur: Int, nxt: Int) -> Int
    let sn_r = (hdr0 >>> 3) & 1
    let nesn_r = (hdr0 >>> 2) & 1
    x.f_cie = ((hdr0 >>> 4) & 1) == 1
    x.f_npi = ((hdr0 >>> 6) & 1) == 1
    x.f_ack = x.tx_num < x.tx_wr and nesn_r != (x.tx_num & 1)
    x.f_new = not x.f_npi and rx_bn(var x) > 0 and sn_r == (x.rx_num & 1)
    x.use_nxt = x.f_ack
    var num = cur
    if x.f_ack
        num = nxt
    var nesn = x.rx_num & 1
    if x.f_new
        nesn = nesn ^ 1
    if num < 0
        return 1 | (nesn << 2) | 0x40
    (x.txf[slot_of(num)] & 3) | (nesn << 2) | ((num & 1) << 3)

// The SDU the recombination finished is queued for the Host, with its time stamp and sequence number.  Its octets are in the
// slot of `outd` the recombination wrote them to (`rx_note`), the next free one, so queueing it moves none.  An SDU whose octets
// found no slot, or none free when its first octets came, is dropped and counted; a lost one carries none.
@tier(embedded)
fn out_put(var x: Cis, status: Int, ts: Int)
    if ctl_limits.test_on() and (x.t_mode >>> 4) != 0
        test_rx_sdu(var x, status)
        return
    var n = x.asm_n
    if status == SDU_LOST
        n = 0
    if x.out_n >= OUT_SLOTS or (n > 0 and not x.asm_ok)
        x.n_sdu_drop = x.n_sdu_drop + 1
        return
    let at = (x.out_head + x.out_n) % OUT_SLOTS
    x.outl[at] = n
    x.outs[at] = status
    x.outt[at] = ts
    x.outq[at] = x.asm_idx & 0xFFFF
    x.out_n = x.out_n + 1

// The time stamp of the SDU with the index `idx` (Part G, Section 3.2.2 and 3.3): the CIS reference
// anchor of the event of its first payload plus the synchronization delay and the transport,
// by the direction.
@tier(embedded)
fn sdu_stamp(var x: Cis, idx: Int) -> Int
    let up = rx_upps(var x)
    let bn = rx_bn(var x)
    if up == 0 or bn == 0
        return 0
    let first = idx * up
    let e = first / bn
    let ref = event_anchor(var x, e)
    let uspi = bn / up
    var j = 0
    if uspi > 0
        j = idx % uspi
    var t = 0
    if x.central
        t = ref + x.cis_sync - x.cig_sync + rx_sdu_int(var x) - iso_us(x) + j * rx_sdu_int(var x)
    else
        t = ref + x.cis_sync + (rx_ft(var x) - 1) * iso_us(x) + j * rx_sdu_int(var x)
    t & 0xFFFFFFFF

// Finish the SDU in the recombination: valid when its end fragment arrived and nothing was missing,
// lost when a payload of it was flushed and none arrived, possibly invalid otherwise.
@tier(embedded)
fn asm_finish(var x: Cis)
    // A group of padding alone is no SDU: the peer had none to send.
    if x.asm_got or x.asm_bad
        var st = SDU_LOST
        if x.asm_got
            if x.asm_end and not x.asm_bad
                st = SDU_VALID
            else
                st = SDU_INVALID
        if st == SDU_VALID
            x.n_sdu_ok = x.n_sdu_ok + 1
        else if st == SDU_INVALID
            x.n_sdu_bad = x.n_sdu_bad + 1
        else
            x.n_sdu_lost = x.n_sdu_lost + 1
        out_put(var x, st, sdu_stamp(var x, x.asm_idx))
    x.asm_idx = x.asm_idx + 1
    x.asm_n = 0
    x.asm_got = false
    x.asm_end = false
    x.asm_bad = false

// The counter of a finished SDU by its status.
@tier(embedded)
fn sdu_count(var x: Cis, st: Int)
    if st == SDU_VALID
        x.n_sdu_ok = x.n_sdu_ok + 1
    else if st == SDU_INVALID
        x.n_sdu_bad = x.n_sdu_bad + 1
    else
        x.n_sdu_lost = x.n_sdu_lost + 1

// The time stamp of a received SDU on a framed stream (Part G, Section 3.2.1) whose first segment is in payload `num` with
// the Time_Offset `toff`: the CIG reference point of the event the payload belongs to (ignoring retransmissions) less
// the Time_Offset is the SDU's reference time at the source.  The Central has it as it is (Peripheral to Central); the
// Peripheral adds CIG_Sync_Delay, the framing delay (one SDU interval in Segmentable mode, none in Unsegmented mode) and the flush
// timeouts, which gives the time the SDU is due (Central to Peripheral).
@tier(embedded)
fn fr_stamp(var x: Cis, num: Int, toff: Int) -> Int
    let bn = rx_bn(var x)
    var t = 0
    if bn > 0
        t = cig_ref(var x, num / bn) - toff
    if not x.central
        var delay = x.sdu_int_c
        if x.unseg
            delay = 0
        var ft = x.ft_c
        // A BIS (it has no ACL): BIG anchor point + BIG_Sync_Delay + ISO_Interval + Framing_Delay_B - Time_Offset (Part G, Section 3.2.2).
        if x.acl < 0 and x.handle >= HANDLE_BIS
            ft = 1
        t = t + x.cig_sync + delay + ft * iso_us(x)
    t & 0xFFFFFFFF

// A framed SDU is done: it is queued for the Host with its status, and the next one is begun.
@tier(embedded)
fn fr_emit(var x: Cis, st: Int, ts: Int)
    sdu_count(var x, st)
    out_put(var x, st, ts)
    x.asm_idx = x.asm_idx + 1
    x.asm_n = 0
    x.asm_bad = false
    x.fa_open = false

// A payload of a framed stream never came (its flush point passed): the SDU under way, whose end cannot come now, is
// lost, and the SDUs that were in the payload are not known, which `fr_start` makes up from the next Time_Offset.
@satisfies("REQ-BLE-CTL-098")
@tier(embedded)
fn fr_lost(var x: Cis)
    if x.fa_open
        fr_emit(var x, SDU_LOST, x.fa_ts)
    x.fa_gap = true

// A segment with SC 0 begins a new SDU whose time stamp is `ts`.  A previous SDU without its end is lost.  When payloads were
// flushed since the last start, the SDUs that lay wholly in them left no trace but the time: the interval to the last start,
// less the one SDU interval it should have been, counts them (up to FR_LOST_MAX), each reported lost with the time it was due.
@satisfies("REQ-BLE-CTL-098")
@tier(embedded)
fn fr_start(var x: Cis, ts: Int)
    if x.fa_open
        fr_emit(var x, SDU_LOST, x.fa_ts)
    let si = rx_sdu_int(var x)
    if x.fa_gap and x.fa_prev_ok and si > 0
        var d = (ts - x.fa_prev) & 0xFFFFFFFF
        if d >= 0x80000000
            d = 0
        var miss = (d + si / 2) / si - 1
        if miss > FR_LOST_MAX
            miss = FR_LOST_MAX
        for k in 1..(miss + 1)
            fr_emit(var x, SDU_LOST, (x.fa_prev + k * si) & 0xFFFFFFFF)
    x.fa_gap = false
    x.fa_prev = ts
    x.fa_prev_ok = true
    x.fa_ts = ts
    x.fa_open = true
    x.asm_n = 0
    x.asm_bad = false

// The segments of the framed payload `num` in `p` (Part G, Section 2.2).  A segment with SC 0 starts an SDU (its first 3 octets
// are the Time_Offset), one with SC 1 continues the SDU under way (and is dropped when there is none: its start was lost);
// CMPLT 1 ends the SDU, which is valid unless a segment overran Max_SDU.  A payload that is not LLID 2 or whose lengths
// disagree with its own cannot be read: the SDU under way is lost and the rest of the payload is dropped.
@satisfies("REQ-BLE-CTL-098")
@tier(embedded)
fn rx_framed(var x: Cis, num: Int, var p: Pdu)
    let n = ll_data.dpdu_len(var p)
    if ll_data.dpdu_llid(var p) != 2 and n > 0
        fr_lost(var x)
        return
    var i = 0
    for _ in 0..64
        if i + FR_HEADER > n
            break
        let h = p.b[2 + i] as Int
        let l = p.b[3 + i] as Int
        i = i + FR_HEADER
        if l == 0 or i + l > n
            fr_lost(var x)
            break
        var src = 2 + i
        var cnt = l
        if (h & 1) == 0
            if l < FR_TOFF
                fr_lost(var x)
                break
            let toff = (p.b[src] as Int) | ((p.b[src + 1] as Int) << 8) | ((p.b[src + 2] as Int) << 16)
            fr_start(var x, fr_stamp(var x, num, toff))
            src = src + FR_TOFF
            cnt = l - FR_TOFF
        else if not x.fa_open
            i = i + l
            continue
        // The octets go to the slot after the last SDU queued, as an unframed SDU's do (`rx_note`).  A stream that takes framed
        // PDUs does not defer the copy: the segments of one payload are several places to put octets.
        if x.asm_n + cnt <= rx_sdu(var x) and x.asm_n + cnt <= SDU_MAX
            if x.asm_n == 0
                x.asm_ok = x.out_n < OUT_SLOTS
            if x.asm_ok
                let base = ((x.out_head + x.out_n) % OUT_SLOTS) * OUT_OCTETS + x.asm_n
                for k in 0..cnt
                    x.outd[base + k] = p.b[src + k]
            x.asm_n = x.asm_n + cnt
        else
            x.asm_bad = true
        if (h & 2) != 0
            var st = SDU_VALID
            if x.asm_bad
                st = SDU_INVALID
            fr_emit(var x, st, x.fa_ts)
        i = i + l

// Payload number `num` was taken (`got`, the fragment in `p` with its LLID) or lost to its flush point.
// The SDUs of Part G, Section 2.1 are UPPS payloads each, so the index of the SDU is `num` / UPPS
// and a group ends at its last payload or at an end fragment.
@satisfies("REQ-BLE-CTL-052")
@tier(embedded)
fn rx_note(var x: Cis, num: Int, got: Bool, var p: Pdu)
    if x.framed
        if got
            rx_framed(var x, num, var p)
        else
            fr_lost(var x)
        return
    let up = rx_upps(var x)
    if up == 0
        return
    let idx = num / up
    let frag = num % up
    for _ in 0..PAYLOAD_SLOTS
        if x.asm_idx >= idx
            break
        asm_finish(var x)
    if idx < x.asm_idx
        return
    var end = false
    if got
        let llid = ll_data.dpdu_llid(var p)
        var n = ll_data.dpdu_len(var p)
        // A payload of an encrypted stream that is opened later (`defer`) still has its MIC on.
        if x.defer and x.enc and n > ll_phy.MIC_OCTETS
            n = n - ll_phy.MIC_OCTETS
        if n > 0 and x.asm_n + n <= SDU_MAX
            // The octets go to the slot after the last SDU queued, where the finished SDU stays: nothing is copied again when it is
            // queued.  A slot that is not free when the first octets come drops the SDU (`out_put`).
            if x.asm_n == 0
                x.asm_ok = x.out_n < OUT_SLOTS
            if x.asm_ok
                let base = ((x.out_head + x.out_n) % OUT_SLOTS) * OUT_OCTETS + x.asm_n
                if x.defer
                    // The program that holds the radio puts the octets in place when it has the time (`rx_copy`), which is not
                    // between two subevents; at most one payload waits, and a second would find the first unplaced.
                    if x.cp_n > 0
                        x.asm_bad = true
                    else
                        x.cp_at = base
                        x.cp_n = n
                        x.cp_num = num
                else
                    for i in 0..n
                        x.outd[base + i] = p.b[2 + i]
            x.asm_n = x.asm_n + n
            x.asm_got = true
        else if n > 0
            x.asm_bad = true
        if llid == 0
            x.asm_got = true
            x.asm_end = true
            end = true
    else
        x.asm_bad = true
    if end or frag == up - 1
        asm_finish(var x)

// The payload that `rx_note` left waiting (`defer`) was not authentic, so the SDU it was put in is not valid: marked possibly invalid
// in the queue when it was finished, in the recombination when it was not.  The slot is the one the octets were to go to.
@tier(embedded)
fn rx_spoil(var x: Cis)
    let slot = x.cp_at / OUT_OCTETS
    x.cp_n = 0
    for k in 0..x.out_n
        if (x.out_head + k) % OUT_SLOTS == slot
            x.outs[slot] = SDU_INVALID
            return
    x.asm_bad = true

// Put the octets of the payload that `rx_note` left waiting (`defer`) in the slot of the SDU, from the PDU `p` it came in.  False
// when none waited.
@tier(embedded)
fn rx_copy(var x: Cis, var p: Pdu) -> Bool
    if x.cp_n <= 0
        return false
    for i in 0..x.cp_n
        x.outd[x.cp_at + i] = p.b[2 + i]
    x.cp_n = 0
    true

// Take the PDU `p` the peer sent, its payload opened, in subevent `s` of event `e`: the verdicts of
// `rx_fast` are applied.  The payload in flight is retired when acknowledged, a new payload goes to the
// recombination, and a CIE closes the event.  `good` is the CRC verdict; a PDU with a bad CRC is
// counted and nothing else.
@satisfies("REQ-BLE-CTL-051")
@tier(embedded)
fn rx_apply(var x: Cis, e: Int, s: Int, var p: Pdu, good: Bool, now: Int)
    if not good
        x.n_crc = x.n_crc + 1
        return
    x.n_rx = x.n_rx + 1
    if x.f_npi
        x.n_null_rx = x.n_null_rx + 1
    if x.f_ack
        tx_retire(var x, false)
    if x.f_new
        rx_note(var x, x.rx_num, true, var p)
        x.rx_num = x.rx_num + 1
    else if not x.f_npi and rx_bn(var x) > 0
        x.n_dup = x.n_dup + 1
    if x.f_cie
        x.closed = true
    x.last_rx = now
    x.synced = true
    x.f_ack = false
    x.f_new = false

// Move the receive side past the payloads whose flush points have passed unreceived at the start of
// subevent `s` of event `e`: the next number expected goes up, and the SDU they belong to is finished.
@satisfies("REQ-BLE-CTL-049")
@tier(embedded)
fn rx_flush(var x: Cis, e: Int, s: Int, var scratch: Pdu)
    let bn = rx_bn(var x)
    if bn == 0
        return
    for _ in 0..PAYLOAD_SLOTS
        if not flushed(x.rx_num, bn, rx_ft(var x), x.nse, e, s)
            break
        rx_note(var x, x.rx_num, false, var scratch)
        x.rx_num = x.rx_num + 1
        x.n_flush_rx = x.n_flush_rx + 1

// ── The Host's side of the data ──────────────────────────────────────

// The oldest SDU waiting for the Host, as an HCI ISO Data packet needs it.
@tier(embedded)
fn out_ready(var x: Cis) -> Bool
    x.out_n > 0

@tier(embedded)
fn out_take(var x: Cis)
    x.out_head = (x.out_head + 1) % OUT_SLOTS
    x.out_n = x.out_n - 1

// The SDUs the Host sent that the peer has acknowledged or that were flushed since the Host was told:
// the Number Of Completed Packets of the stream.
@tier(embedded)
fn comp_take(var x: Cis) -> Int
    let n = x.comp
    x.comp = 0
    x.owed = x.owed & (0xFFFF ^ EV_COMPLETED)
    n

// ── Events and supervision ───────────────────────────────────────────

// A CIS event begins: the payloads of its burst are made (padding for what the Host did not supply), the
// flags of the event are cleared and the first subevent is next.
@satisfies("REQ-BLE-CTL-050")
@tier(embedded)
fn event_begin(var x: Cis)
    tx_fill(var x, x.ev)
    x.ev_synced = false
    x.ev_open = true
    x.closed = false
    x.sub = 1
    x.n_events = x.n_events + 1

// The event ended: the next one follows ISO_Interval after this one's anchor point.  A stream whose peer has
// not been heard in the supervision timeout, or in six ISO intervals from the first anchor when it is not
// established, is lost.  Answers the reason when it is (0 for not).
@satisfies("REQ-BLE-CTL-053")
@tier(embedded)
fn event_end(var x: Cis, now: Int) -> Int
    if not x.ev_synced
        x.n_missed = x.n_missed + 1
    x.anchor = x.anchor + iso_us(x)
    x.ev = x.ev + 1
    x.sub = 1
    x.ev_open = false
    if not x.synced
        if now - x.first_us > ESTABLISH_INTERVALS * iso_us(x)
            return STATUS_FAILED_TO_ESTABLISH
    else if now - x.last_rx > x.sup_us
        return REASON_TIMEOUT
    0

// A packet arrived in subevent `s` of the event under way, at `start_us` (its preamble): the first
// of an event fixes the anchor point (Section 4.5.13.2).  A Peripheral takes the anchor from it; the
// Central's is its own.
@tier(embedded)
fn sync_anchor(var x: Cis, s: Int, start_us: Int)
    if not x.central and not x.ev_synced
        x.anchor = start_us - (s - 1) * x.sub_int
    x.ev_synced = true

// The subevent `s` is done: the next is `s + 1`, and the event is over after the last or a CIE.
@tier(embedded)
fn sub_done(var x: Cis, s: Int)
    x.sub = s + 1

@tier(embedded)
fn event_over(var x: Cis) -> Bool
    x.closed or x.sub > x.nse

// How late a subevent may start and still be run is `ll_radio.late_tol_us` of the radio: the peer listens for it at its
// own time with only the widening around that, so a subevent started much later is not heard, and the time it takes
// goes from the subevent after it.

// The skipped subevents: the program woke at `now`, `tol` is the lateness a subevent is run with, and the subevent `sub` of the event under way began
// `late` microseconds ago and cannot be run; answers how many whole subevents and events have gone by.  The
// flush rule and the counters of the events carry on from the next one run.
@tier(embedded)
fn skip_late(var x: Cis, now: Int, tol: Int) -> Int
    var skipped = 0
    for _ in 0..4096
        if x.sub > x.nse
            let r = event_end(var x, now)
            if r != 0
                return -r
            event_begin(var x)
            skipped = skipped + 1
        if sub_start(var x, x.sub) + tol > now
            break
        x.sub = x.sub + 1
        skipped = skipped + 1
    skipped

// ── The Central's derivation of a group's parameters, LE Set CIG Parameters ──

// What the Host asked for one stream (`max_sdu_c`, `max_sdu_p`, the PHY masks, the retransmission numbers) and what
// the Controller derives from it: the PHY, the PDU sizes, BN, NSE, Sub_Interval, the offset of the stream's first
// anchor from the CIG reference point and its CIS_Sync_Delay.  `slot` is the stream's slot in the Controller,
// -1 for one that is new.
@value
struct CisPlan
    slot: Int
    cis_id: Int
    max_sdu_c: Int
    max_sdu_p: Int
    phy_c: Int
    phy_p: Int
    rtn_c: Int
    rtn_p: Int
    phy: Int
    pdu_c: Int
    pdu_p: Int
    bn_c: Int
    bn_p: Int
    nse: Int
    sub_int: Int
    off: Int
    cis_sync: Int

// What the derivation settled for the group: the ISO interval in microseconds, the flush timeouts every stream
// shares, and CIG_Sync_Delay; and the Host's choice of Framing (0 unframed, 1 framed in Segmentable mode, 2 framed in Unsegmented
// mode), which the caller sets before `plan_cig` runs.
@value
struct GroupPlan
    iso_us: Int
    ft_c: Int
    ft_p: Int
    sync: Int
    framing: Int

@tier(embedded)
fn plan_new() -> CisPlan
    CisPlan { slot: -1, cis_id: 0, max_sdu_c: 0, max_sdu_p: 0, phy_c: 0, phy_p: 0, rtn_c: 0, rtn_p: 0, phy: 0,
           pdu_c: 0, pdu_p: 0, bn_c: 0, bn_p: 0, nse: 1, sub_int: 0, off: 0, cis_sync: 0 }

@tier(embedded)
fn group_plan_new() -> GroupPlan
    GroupPlan { iso_us: 0, ft_c: 1, ft_p: 1, sync: 0, framing: 0 }

@tier(embedded)
fn gcd(a: Int, b: Int) -> Int
    var x = a
    var y = b
    for _ in 0..64
        if y == 0
            break
        let t = x % y
        x = y
        y = t
    x

// The ISO interval in microseconds that unframed PDUs can use for SDU intervals `sc` and `sp` (0 for a direction no
// stream uses): a multiple of both and of 1.25 ms (Part G, Section 2), at least 5 ms; 0 when none is under 4 s.
@satisfies("REQ-BLE-CTL-074")
@tier(embedded)
fn iso_interval_for(sc: Int, sp: Int) -> Int
    var l = UNIT_US
    if sc > 0
        l = l / gcd(l, sc) * sc
    if sp > 0
        l = l / gcd(l, sp) * sp
    for _ in 0..64
        if l >= 5000
            break
        l = l * 2
    if l > 4000000
        return 0
    l

// The ISO interval in microseconds for framed PDUs and SDU intervals `sc` and `sp` (0 for a direction no stream uses): the
// shortest multiple of 1.25 ms that is not under the shorter SDU interval and not under 5 ms.  Framed PDUs have no
// need for an interval that is a multiple of the SDU interval (Part G, Section 2.2), so an SDU interval of 8 ms gets 8.75 ms
// and 2.5 ms gets 5 ms.
@satisfies("REQ-BLE-CTL-099")
@tier(embedded)
fn framed_interval_for(sc: Int, sp: Int) -> Int
    var m = sc
    if sc == 0 or (sp > 0 and sp < sc)
        m = sp
    var l = (m + UNIT_US - 1) / UNIT_US * UNIT_US
    if l < 5000
        l = 5000
    if l > 4000000
        l = 4000000
    l

// The octets one ISO interval of a framed direction is given: F x (5 + Max_SDU) of Part G, Section 2.2, with F = (1 + 100 ppm) x
// ISO_Interval / SDU_Interval, where 5 is a Segmentation Header and a Time_Offset, and a quarter more.  The rule is the least
// that carries the SDUs when they come at the SDU interval to the microsecond; a Host's SDUs come with jitter, an interval
// with two of them or with none, and a capacity equal to the demand never drains the queue that one such interval leaves.  A quarter
// more does, in a few events.  0 for a direction no data flows in.
@tier(embedded)
fn framed_octets(sdu: Int, sdu_int: Int, iso: Int) -> Int
    if sdu <= 0 or sdu_int <= 0
        return 0
    (iso * 10001 * 5 * (FR_HEADER + FR_TOFF + sdu) + 40000 * sdu_int - 1) / (40000 * sdu_int)

// The PDU size of a framed direction: as long as the octets of one interval need and their Segmentation Header, up to the 251 a
// PDU can be, and never under the 6 that start an SDU.  0 for a direction no data flows in.
@satisfies("REQ-BLE-CTL-099")
@tier(embedded)
fn framed_pdu(sdu: Int, sdu_int: Int, iso: Int) -> Int
    let per = framed_octets(sdu, sdu_int, iso)
    if per == 0
        return 0
    ll_phy.greater(ll_phy.lesser(per + FR_HEADER, ll_data.PAYLOAD_EXT_MAX), FR_START_MIN)

// BN of a framed direction: the PDUs of `pdu` octets (less the header of each) that the octets of one interval fill, so that
// BN x (Max_PDU - 2) is at least F x (5 + Max_SDU).
@satisfies("REQ-BLE-CTL-099")
@tier(embedded)
fn framed_bn(sdu: Int, sdu_int: Int, iso: Int, pdu: Int) -> Int
    if pdu <= FR_HEADER
        return 0
    (framed_octets(sdu, sdu_int, iso) + pdu - FR_HEADER - 1) / (pdu - FR_HEADER)

// The SDUs one ISO interval holds in Unsegmented mode: F = (1 + 100 ppm) x ISO_Interval / SDU_Interval, rounded up (Part G, Section 2.2).  0
// for a direction no data flows in.
@tier(embedded)
fn unseg_sdus(sdu: Int, sdu_int: Int, iso: Int) -> Int
    if sdu <= 0 or sdu_int <= 0
        return 0
    (iso * 10001 + 10000 * sdu_int - 1) / (10000 * sdu_int)

// The SDUs of Max_SDU a PDU holds, each with its Segmentation Header and Time_Offset: 0 when one does not fit the 251 octets of a PDU.
@tier(embedded)
fn unseg_per_pdu(sdu: Int) -> Int
    ll_data.PAYLOAD_EXT_MAX / (FR_HEADER + FR_TOFF + sdu)

// BN of a direction in Unsegmented mode: the PDUs that hold the SDUs of an interval, as many whole SDUs as fit a PDU in each.  0 for a
// direction no data flows in and for an SDU that does not fit a PDU.
@satisfies("REQ-BLE-CTL-096")
@tier(embedded)
fn unseg_bn(sdu: Int, sdu_int: Int, iso: Int) -> Int
    let k = unseg_per_pdu(sdu)
    if sdu <= 0 or sdu_int <= 0 or k < 1
        return 0
    (unseg_sdus(sdu, sdu_int, iso) + k - 1) / k

// The PDU size of a direction in Unsegmented mode: as many SDUs (each Max_SDU and its 5 octets) as the SDUs of an interval share among
// the BN PDUs, rounded up (Part G, Section 2.2: ISO_Interval / SDU_Interval x (1 + MaxDrift) / BN x (5 + Max_SDU)).
@satisfies("REQ-BLE-CTL-096")
@tier(embedded)
fn unseg_pdu(sdu: Int, sdu_int: Int, iso: Int) -> Int
    let bn = unseg_bn(sdu, sdu_int, iso)
    if bn == 0
        return 0
    ((unseg_sdus(sdu, sdu_int, iso) + bn - 1) / bn) * (FR_HEADER + FR_TOFF + sdu)

// The transmission opportunities a payload has in a direction with these numbers (Part B, Section 7.8.97):
// NSE x FT - (NSE / BN) x (BN - 1).
@tier(embedded)
fn opportunities(nse: Int, ft: Int, bn: Int) -> Int
    nse * ft - (nse / bn) * (bn - 1)

// The PDU size of a direction with SDUs of `sdu` octets: the SDU itself up to 251 octets (UPPS 1), 251 beyond; 0
// for a direction no data flows in.
@tier(embedded)
fn plan_pdu(sdu: Int) -> Int
    ll_phy.lesser(sdu, ll_data.PAYLOAD_EXT_MAX)

// BN of a direction: UPPS payloads for each of the USPI SDUs of an ISO interval (Part G, Section 2.1).
@tier(embedded)
fn plan_bn(sdu: Int, pdu: Int, sdu_int: Int, iso: Int) -> Int
    if sdu <= 0 or pdu <= 0
        return 0
    upps(sdu, pdu, 1) * (iso / sdu_int)

// The status of a group whose subevents follow each other closer than the radio can start them, 0 when every pair on
// the radio has the gap `ll_radio.subevent_gap_us` asks (`sub_gap_status` says which status and why).  The pairs: the
// subevents of one stream, `Sub_Interval` apart; and in an interleaved group the subevents of consecutive streams,
// `se_all` apart; in a sequential one the last subevent of a stream and the first of the next.
@tier(embedded)
fn plan_gap_check(var p: Vec[CisPlan; 8], n: Int, packing: Int, se_all: Int, prof: ll_radio.RadioProfile) -> Int
    if not prof.known
        return 0
    var need = 0
    for i in 0..n
        need = ll_phy.greater(need, ll_radio.subevent_gap_us(prof, p[i].phy))
    for i in 0..n
        let ex = exchange_us(p[i].phy, p[i].pdu_c, p[i].pdu_p)
        if packing == 1 and n > 1
            if se_all - ex < need
                return STATUS_UNSUPPORTED_FEATURE
        else
            if p[i].nse > 1 and p[i].sub_int - ex < need
                return STATUS_UNSUPPORTED_FEATURE
            if i < n - 1
                let slot = ll_phy.greater(p[i].nse * p[i].sub_int, plan_slot_us(prof, p[i].phy, p[i].pdu_c, p[i].pdu_p))
                if slot - ((p[i].nse - 1) * p[i].sub_int + ex) < need
                    return STATUS_UNSUPPORTED_FEATURE
    0

// The offsets of the streams from the CIG reference point and the delays, for streams whose NSE, Sub_Interval, PHY and PDU
// sizes are set: sequential (`packing` 0), one event after the other, a stream's slot being NSE x Sub_Interval, at least
// SE_Length; interleaved, the streams starting one `se_all` (the longest SE_Length) apart.  The status 0x12 when the
// group does not end before the next begins (the last event, with T_MSS_CIS, within `iso`).
@satisfies("REQ-BLE-CTL-074")
@tier(embedded)
fn plan_arrange(var p: Vec[CisPlan; 8], n: Int, packing: Int, iso: Int, se_all: Int, prof: ll_radio.RadioProfile, var g: GroupPlan) -> Int
    let gap = plan_gap_check(var p, n, packing, se_all, prof)
    if gap != 0
        return gap
    var off = 0
    var sync = 0
    for i in 0..n
        let se = plan_slot_us(prof, p[i].phy, p[i].pdu_c, p[i].pdu_p)
        let elen = (p[i].nse - 1) * p[i].sub_int + mpt_us(p[i].phy, p[i].pdu_c) + T_IFS_CIS_US + mpt_us(p[i].phy, p[i].pdu_p)
        p[i].off = off
        if off + elen > sync
            sync = off + elen
        if packing == 1 and n > 1
            off = off + se_all
        else
            off = off + ll_phy.greater(p[i].nse * p[i].sub_int, se)
    if sync + T_MSS_CIS_US > iso
        return STATUS_INVALID_PARAMETERS
    g.sync = sync
    for i in 0..n
        p[i].cis_sync = sync - p[i].off
    0

// Derive the parameters of the `n` streams in `p` from the Host's request (unframed PDUs, or framed ones in Segmentable mode
// when `g.framing` is 1, or in Unsegmented mode when it is 2): the ISO interval,
// PHY, PDU sizes, BN, NSE and FT that give each payload the opportunities the retransmission numbers ask for, the
// Sub_Interval and offsets of the arrangement (`packing` 0 sequential, 1 interleaved), and the delays the Peripherals
// are told.  The status of the failure, 0 for success; `g` is the group's result.  Nothing but `p` and `g` is
// written.
@satisfies("REQ-BLE-CTL-074")
@tier(embedded)
fn plan_cig(var p: Vec[CisPlan; 8], n: Int, sdu_int_c: Int, sdu_int_p: Int, lat_c: Int, lat_p: Int, packing: Int, prof: ll_radio.RadioProfile, var g: GroupPlan) -> Int
    var use_c = false
    var use_p = false
    for i in 0..n
        if p[i].max_sdu_c > 0
            use_c = true
        if p[i].max_sdu_p > 0
            use_p = true
    if not use_c and not use_p
        return STATUS_INVALID_PARAMETERS
    var sc = 0
    var sp = 0
    if use_c
        sc = sdu_int_c
    if use_p
        sp = sdu_int_p
    let framed = g.framing >= 1
    let unseg = g.framing == 2
    var iso = 0
    if framed
        iso = framed_interval_for(sc, sp)
    else
        iso = iso_interval_for(sc, sp)
    if iso == 0
        return STATUS_UNSUPPORTED_FEATURE
    g.iso_us = iso
    var se_all = 0
    for i in 0..n
        let phy = pick_phy(p[i].phy_c, p[i].phy_p)
        if phy == 0
            return STATUS_UNSUPPORTED_FEATURE
        if p[i].max_sdu_c > SDU_MAX or p[i].max_sdu_p > SDU_MAX
            return STATUS_MEMORY_CAPACITY
        p[i].phy = phy
        if unseg
            // An SDU that does not fit a PDU with its 5 octets is not for this mode.
            if (p[i].max_sdu_c > 0 and unseg_per_pdu(p[i].max_sdu_c) < 1) or (p[i].max_sdu_p > 0 and unseg_per_pdu(p[i].max_sdu_p) < 1)
                return STATUS_UNSUPPORTED_FEATURE
            p[i].pdu_c = unseg_pdu(p[i].max_sdu_c, sdu_int_c, iso)
            p[i].pdu_p = unseg_pdu(p[i].max_sdu_p, sdu_int_p, iso)
            p[i].bn_c = unseg_bn(p[i].max_sdu_c, sdu_int_c, iso)
            p[i].bn_p = unseg_bn(p[i].max_sdu_p, sdu_int_p, iso)
        else if framed
            p[i].pdu_c = framed_pdu(p[i].max_sdu_c, sdu_int_c, iso)
            p[i].pdu_p = framed_pdu(p[i].max_sdu_p, sdu_int_p, iso)
            p[i].bn_c = framed_bn(p[i].max_sdu_c, sdu_int_c, iso, p[i].pdu_c)
            p[i].bn_p = framed_bn(p[i].max_sdu_p, sdu_int_p, iso, p[i].pdu_p)
        else
            p[i].pdu_c = plan_pdu(p[i].max_sdu_c)
            p[i].pdu_p = plan_pdu(p[i].max_sdu_p)
            p[i].bn_c = plan_bn(p[i].max_sdu_c, p[i].pdu_c, sdu_int_c, iso)
            p[i].bn_p = plan_bn(p[i].max_sdu_p, p[i].pdu_p, sdu_int_p, iso)
        if p[i].bn_c > 15 or p[i].bn_p > 15
            return STATUS_MEMORY_CAPACITY
        let se = plan_slot_us(prof, phy, p[i].pdu_c, p[i].pdu_p)
        if se > se_all
            se_all = se
    // The Sub_Interval, and how many subevents of a stream fit the interval in the arrangement.
    var sub = ll_phy.greater(400, se_all)
    if packing == 1 and n > 1
        sub = ll_phy.greater(400, n * se_all)
    var ft_c = 1
    var ft_p = 1
    for i in 0..n
        let se = plan_slot_us(prof, p[i].phy, p[i].pdu_c, p[i].pdu_p)
        var fit = 0
        if packing == 1 and n > 1
            if iso >= (n - 1) * se_all + se
                fit = (iso - (n - 1) * se_all - se) / sub + 1
        else if iso / n >= se
            fit = (iso / n - se) / sub + 1
        if fit > 31
            fit = 31
        let need = ll_phy.greater(p[i].bn_c, p[i].bn_p)
        if fit < need
            return STATUS_INVALID_PARAMETERS
        // The fewest subevents that give both directions their opportunities at FT 1; when the interval is too short for
        // them, all that fit and the flush timeout that makes up the rest.
        var nse = need
        var found = false
        for k in need..(fit + 1)
            if (p[i].bn_c == 0 or opportunities(k, 1, p[i].bn_c) >= p[i].rtn_c + 1) and (p[i].bn_p == 0 or opportunities(k, 1, p[i].bn_p) >= p[i].rtn_p + 1)
                nse = k
                found = true
                break
        var fc = 1
        var fp = 1
        if not found
            nse = fit
            for f in 1..16
                fc = f
                if p[i].bn_c == 0 or opportunities(nse, f, p[i].bn_c) >= p[i].rtn_c + 1
                    break
            for f in 1..16
                fp = f
                if p[i].bn_p == 0 or opportunities(nse, f, p[i].bn_p) >= p[i].rtn_p + 1
                    break
        p[i].nse = nse
        if nse > 1
            p[i].sub_int = sub
        else
            p[i].sub_int = 0
        if fc > ft_c
            ft_c = fc
        if fp > ft_p
            ft_p = fp
    // The payloads in flight must fit the ring: BN x (FT + 1).
    for i in 0..n
        if p[i].bn_c * (ft_c + 1) > PAYLOAD_SLOTS or p[i].bn_p * (ft_p + 1) > PAYLOAD_SLOTS
            return STATUS_MEMORY_CAPACITY
    g.ft_c = ft_c
    g.ft_p = ft_p
    let st = plan_arrange(var p, n, packing, iso, se_all, prof, var g)
    if st != 0
        return st
    // The transport latency the Host allows (Part G, Section 3.2.2: CIG_Sync_Delay + FT x ISO_Interval - SDU_Interval; Section
    // 3.2.1 for framed PDUs: the same with the framing delay of one SDU interval added).
    var framing_c = 0 - sdu_int_c
    var framing_p = 0 - sdu_int_p
    if framed
        framing_c = sdu_int_c
        framing_p = sdu_int_p
    if unseg
        framing_c = 0
        framing_p = 0
    if use_c and g.sync + ft_c * iso + framing_c > lat_c * 1000
        return STATUS_INVALID_PARAMETERS
    if use_p and g.sync + ft_p * iso + framing_p > lat_p * 1000
        return STATUS_INVALID_PARAMETERS
    0

// ── The Host's configuration, LE Set CIG Parameters Test ─────────────

// The PHY a stream takes of the sets the Host allows in each direction, as HCI numbers it: the LE 2M PHY when
// both allow it (the shortest packets), else LE 1M, else LE Coded; 0 when no PHY is common (this
// Controller takes one PHY for both directions).
@tier(embedded)
fn pick_phy(mask_c: Int, mask_p: Int) -> Int
    let m = mask_c & mask_p & ll_phy.MASK_ALL
    if (m & ll_phy.MASK_2M) != 0
        return ll_phy.PHY_2M
    if (m & ll_phy.MASK_1M) != 0
        return ll_phy.PHY_1M
    if (m & ll_phy.MASK_CODED) != 0
        return ll_phy.PHY_CODED
    0

// SE_Length of a stream with these parameters (Section 4.5.13.2), and the Sub_Interval this Controller gives
// it: SE_Length, never less than the 400 microseconds of Section 2.4.2.29; 0 for one subevent.
@tier(embedded)
fn plan_se_len(phy: Int, pdu_c: Int, pdu_p: Int) -> Int
    mpt_us(phy, pdu_c) + T_IFS_CIS_US + mpt_us(phy, pdu_p) + T_MSS_CIS_US

// The spacing the Controller plans for the subevents of a stream it creates: SE_Length, and beyond it the time of the program's work
// on the octets of both payloads (`ll_radio.payload_gap_us`), which the T_MSS_CIS of the specification does not cover when the
// payloads are long: 251 octets each way take the program 500 microseconds on the nRF54LM20 to move between two subevents, and the
// peer listens for the next one only around the time it planned.  The Controller of a radio that was not asked adds nothing.
@satisfies("REQ-BLE-CTL-077")
@tier(embedded)
fn plan_slot_us(prof: ll_radio.RadioProfile, phy: Int, pdu_c: Int, pdu_p: Int) -> Int
    plan_se_len(phy, pdu_c, pdu_p) + ll_radio.payload_gap_us(prof, pdu_c + pdu_p)

@tier(embedded)
fn plan_sub_interval(nse: Int, se_len: Int) -> Int
    if nse <= 1
        return 0
    ll_phy.greater(400, se_len)

// The status to answer with for the parameters of one stream (LE Set CIG Parameters Test), 0 when this Controller
// takes them: the ranges of Section 4.5.13, the PHYs, the ring a flush window needs, and the time the event takes
// against the ISO interval (`iso_int` in units of 1.25 ms).
@satisfies("REQ-BLE-CTL-056")
@tier(embedded)
fn cfg_check(nse: Int, bn_c: Int, bn_p: Int, pdu_c: Int, pdu_p: Int, sdu_c: Int, sdu_p: Int, ft_c: Int, ft_p: Int, phy_c: Int, phy_p: Int, iso_int: Int, prof: ll_radio.RadioProfile) -> Int
    if nse < 1 or nse > 31 or bn_c > 15 or bn_p > 15 or bn_c > nse or bn_p > nse
        return STATUS_INVALID_PARAMETERS
    if bn_c == 0 and bn_p == 0
        return STATUS_INVALID_PARAMETERS
    if (bn_c == 0) != (pdu_c == 0) or (bn_p == 0) != (pdu_p == 0)
        return STATUS_INVALID_PARAMETERS
    if pdu_c > ll_data.PAYLOAD_EXT_MAX or pdu_p > ll_data.PAYLOAD_EXT_MAX
        return STATUS_INVALID_PARAMETERS
    if ((phy_c | phy_p) & (0xFF ^ ll_phy.MASK_ALL)) != 0 or pick_phy(phy_c, phy_p) == 0
        return STATUS_UNSUPPORTED_FEATURE
    if sdu_c > SDU_MAX or sdu_p > SDU_MAX
        return STATUS_MEMORY_CAPACITY
    if bn_c * (ft_c + 1) > PAYLOAD_SLOTS or bn_p * (ft_p + 1) > PAYLOAD_SLOTS
        return STATUS_MEMORY_CAPACITY
    let phy = pick_phy(phy_c, phy_p)
    let se = plan_se_len(phy, pdu_c, pdu_p)
    let sub = plan_sub_interval(nse, plan_slot_us(prof, phy, pdu_c, pdu_p))
    if (nse - 1) * sub + se > iso_int * UNIT_US
        return STATUS_INVALID_PARAMETERS
    sub_gap_status(prof, phy, nse, sub, pdu_c, pdu_p, STATUS_UNSUPPORTED_FEATURE)

// ── Tests ────────────────────────────────────────────────────────────

// A @value struct is changed through a `var` parameter, so the tests set fields through this
// function, by name.
fn t_set(var x: Cis, f: Str, v: Int)
    if f == "central"
        x.central = v != 0
    else if f == "defer"
        x.defer = v != 0
    else if f == "state"
        x.state = v
    else if f == "phy"
        x.phy = v
    else if f == "phy_p"
        x.phy_p = v
    else if f == "framed"
        x.framed = v != 0
    else if f == "unseg"
        x.unseg = v != 0
    else if f == "max_sdu_c"
        x.max_sdu_c = v
    else if f == "max_sdu_p"
        x.max_sdu_p = v
    else if f == "sdu_int_c"
        x.sdu_int_c = v
    else if f == "sdu_int_p"
        x.sdu_int_p = v
    else if f == "max_pdu_c"
        x.max_pdu_c = v
    else if f == "max_pdu_p"
        x.max_pdu_p = v
    else if f == "nse"
        x.nse = v
    else if f == "sub_int"
        x.sub_int = v
    else if f == "bn_c"
        x.bn_c = v
    else if f == "bn_p"
        x.bn_p = v
    else if f == "ft_c"
        x.ft_c = v
    else if f == "ft_p"
        x.ft_p = v
    else if f == "iso_int"
        x.iso_int = v
    else if f == "aa"
        x.aa = v
    else if f == "cis_sync"
        x.cis_sync = v
    else if f == "cig_sync"
        x.cig_sync = v
    else if f == "cis_offset"
        x.cis_offset = v
    else if f == "sup_us"
        x.sup_us = v
    else if f == "cig_id"
        x.cig_id = v
    else if f == "cis_id"
        x.cis_id = v
    else if f == "off_min"
        x.off_min = v
    else if f == "off_max"
        x.off_max = v
    else if f == "off_ev"
        x.off_ev = v
    else if f == "ind_ev"
        x.ind_ev = v
    else if f == "anchor"
        x.anchor = v
    else if f == "ev"
        x.ev = v
    else if f == "synced"
        x.synced = v != 0
    else if f == "last_rx"
        x.last_rx = v
    else if f == "first_us"
        x.first_us = v
    else if f == "rx_num"
        x.rx_num = v
    else if f == "sent_num"
        x.sent_num = v
    else if f == "tx_num"
        x.tx_num = v
    else if f == "f_new"
        x.f_new = v != 0
    else if f == "enc"
        x.enc = v != 0

// A stream with the parameters of a typical unicast: an ISO interval of 8 units (10 ms), two
// subevents 1.5 ms apart, BN 1, FT 1, SDUs of 100 octets on the 2M PHY.
fn t_cis(central: Bool) -> Cis
    var x = cis_new()
    var c = 0
    if central
        c = 1
    t_set(x, "central", c)
    t_set(x, "state", S_UP)
    t_set(x, "phy", 2)
    t_set(x, "max_sdu_c", 100)
    t_set(x, "max_sdu_p", 100)
    t_set(x, "sdu_int_c", 10000)
    t_set(x, "sdu_int_p", 10000)
    t_set(x, "max_pdu_c", 100)
    t_set(x, "max_pdu_p", 100)
    t_set(x, "nse", 2)
    t_set(x, "sub_int", 1500)
    t_set(x, "bn_c", 1)
    t_set(x, "bn_p", 1)
    t_set(x, "ft_c", 1)
    t_set(x, "ft_p", 1)
    t_set(x, "iso_int", 8)
    t_set(x, "aa", 0x8E89BED6)
    t_set(x, "cis_sync", 4000)
    t_set(x, "cig_sync", 4000)
    t_set(x, "sup_us", 1000000)
    x

fn t_sdu(fill: Int) -> Vec[u8; 260]
    var d: Vec[u8; 260] = Vec.new()
    for i in 0..260
        let _a = d.push(((fill + i) & 0xFF) as u8)
    d

@test
fn test_slots_hold_what_the_tables_say()
    let x = cis_new()
    test.assert_eq(x.txl.capacity(), PAYLOAD_SLOTS)
    test.assert_eq(x.txf.capacity(), PAYLOAD_SLOTS)
    test.assert_eq(x.outl.capacity(), OUT_SLOTS)
    test.assert(ISO_LOAD <= 250)
    test.assert_eq(SDU_FRAGS, (SDU_MAX + ISO_LOAD - 9) / (ISO_LOAD - 8))
    test.assert(OUT_OCTETS >= SDU_MAX)
    // The three buffers are the size of the build: the full rings of a build with isochronous channels, 8 octets without.
    if ctl_limits.iso_on()
        test.assert_eq(x.txd.capacity(), PAYLOAD_SLOTS * SLOT_OCTETS)
        test.assert_eq(x.hbuf.capacity(), SDU_MAX)
        test.assert_eq(x.outd.capacity(), OUT_SLOTS * OUT_OCTETS)
    else
        test.assert_eq(x.txd.capacity(), 8)
        test.assert_eq(x.hbuf.capacity(), 8)
        test.assert_eq(x.outd.capacity(), 8)

@test
fn test_the_request_round_trips_through_its_pdu()
    var x = t_cis(true)
    t_set(x, "cig_id", 5)
    t_set(x, "cis_id", 2)
    t_set(x, "max_sdu_c", 0x0ABC)
    t_set(x, "max_sdu_p", 0x0123)
    t_set(x, "sdu_int_c", 0xFFFFF)
    t_set(x, "sdu_int_p", 7500)
    t_set(x, "max_pdu_c", 251)
    t_set(x, "max_pdu_p", 0)
    t_set(x, "bn_c", 3)
    t_set(x, "bn_p", 0)
    t_set(x, "nse", 6)
    t_set(x, "sub_int", 1234)
    t_set(x, "ft_c", 4)
    t_set(x, "ft_p", 9)
    t_set(x, "iso_int", 3200)
    t_set(x, "off_min", 0x123456)
    t_set(x, "off_max", 0x234567)
    t_set(x, "off_ev", 0xBEEF)
    var p = ll_pdu.pdu_new()
    put_cis_req(var p, var x)
    test.assert_eq(ll_data.dpdu_len(var p), 36)
    test.assert_eq(ll_data.dpdu_opcode(var p), ll_data.OP_CIS_REQ)
    test.assert_eq(ll_data.ctrl_payload_len(ll_data.OP_CIS_REQ), 36)
    var y = cis_new()
    get_cis_req(var p, var y)
    test.assert_eq(y.cig_id, 5)
    test.assert_eq(y.cis_id, 2)
    test.assert_eq(y.phy, 2)
    test.assert_eq(y.max_sdu_c, 0x0ABC)
    test.assert_eq(y.max_sdu_p, 0x0123)
    test.assert_eq(y.sdu_int_c, 0xFFFFF)
    test.assert_eq(y.sdu_int_p, 7500)
    test.assert_eq(y.max_pdu_c, 251)
    test.assert_eq(y.max_pdu_p, 0)
    test.assert_eq(y.bn_c, 3)
    test.assert_eq(y.bn_p, 0)
    test.assert_eq(y.nse, 6)
    test.assert_eq(y.sub_int, 1234)
    test.assert_eq(y.ft_c, 4)
    test.assert_eq(y.ft_p, 9)
    test.assert_eq(y.iso_int, 3200)
    test.assert_eq(y.off_min, 0x123456)
    test.assert_eq(y.off_max, 0x234567)
    test.assert_eq(y.off_ev, 0xBEEF)
    test.assert(not y.framed)

@test
fn test_the_framed_flag_is_bit_15_of_the_central_sdu_size()
    var x = t_cis(true)
    t_set(x, "framed", 1)
    var p = ll_pdu.pdu_new()
    put_cis_req(var p, var x)
    test.assert_eq(ll_data.dpdu_byte(var p, 6) & 0x80, 0x80)
    var y = cis_new()
    get_cis_req(var p, var y)
    test.assert(y.framed)
    test.assert_eq(y.max_sdu_c, 100)

@test
fn test_response_indication_and_terminate_round_trip()
    var x = t_cis(true)
    t_set(x, "off_min", 600)
    t_set(x, "off_max", 4000)
    t_set(x, "off_ev", 77)
    var p = ll_pdu.pdu_new()
    put_cis_rsp(var p, var x)
    test.assert_eq(ll_data.dpdu_len(var p), 9)
    test.assert_eq(ll_data.ctrl_payload_len(ll_data.OP_CIS_RSP), 9)
    var y = cis_new()
    get_cis_rsp(var p, var y)
    test.assert_eq(y.off_min, 600)
    test.assert_eq(y.off_max, 4000)
    test.assert_eq(y.off_ev, 77)
    t_set(x, "aa", 0xA5A5C3C3)
    t_set(x, "cis_offset", 3500)
    t_set(x, "cig_sync", 0x7FFFFF)
    t_set(x, "cis_sync", 2222)
    t_set(x, "ind_ev", 0xFFFE)
    put_cis_ind(var p, var x)
    test.assert_eq(ll_data.dpdu_len(var p), 16)
    test.assert_eq(ll_data.ctrl_payload_len(ll_data.OP_CIS_IND), 16)
    get_cis_ind(var p, var y)
    test.assert_eq(y.aa, 0xA5A5C3C3)
    test.assert_eq(y.cis_offset, 3500)
    test.assert_eq(y.cig_sync, 0x7FFFFF)
    test.assert_eq(y.cis_sync, 2222)
    test.assert_eq(y.ind_ev, 0xFFFE)
    put_cis_terminate(var p, 3, 4, 0x13)
    test.assert_eq(ll_data.dpdu_len(var p), 4)
    test.assert_eq(ll_data.ctrl_payload_len(ll_data.OP_CIS_TERMINATE_IND), 4)
    test.assert_eq(ll_data.dpdu_byte(var p, 1), 3)
    test.assert_eq(ll_data.dpdu_byte(var p, 2), 4)
    test.assert_eq(ll_data.dpdu_byte(var p, 3), 0x13)

@test
fn test_a_request_is_checked_against_the_mandatory_ranges_and_this_controllers_limits()
    var x = t_cis(false)
    t_set(x, "off_min", 600)
    t_set(x, "off_max", 3000)
    test.assert_eq(cis_req_check(var x, 30000), 0)
    t_set(x, "off_max", 30000)
    test.assert_eq(cis_req_check(var x, 30000), STATUS_PARAMETER_OUT_OF_RANGE)
    t_set(x, "off_max", 3000)
    t_set(x, "off_min", 100)
    test.assert_eq(cis_req_check(var x, 30000), STATUS_PARAMETER_OUT_OF_RANGE)
    t_set(x, "off_min", 600)
    // Framed PDUs are taken in both modes; in Unsegmented mode a PDU holds a whole SDU with its 5 octets.
    t_set(x, "framed", 1)
    test.assert_eq(cis_req_check(var x, 30000), 0)
    t_set(x, "unseg", 1)
    t_set(x, "max_sdu_c", 95)
    t_set(x, "max_sdu_p", 95)
    test.assert_eq(cis_req_check(var x, 30000), 0)
    t_set(x, "max_sdu_c", 96)
    test.assert_eq(cis_req_check(var x, 30000), STATUS_PARAMETER_OUT_OF_RANGE)
    t_set(x, "max_sdu_c", 100)
    t_set(x, "max_sdu_p", 100)
    t_set(x, "unseg", 0)
    // A framed direction needs a PDU that can start an SDU.
    t_set(x, "max_pdu_c", 5)
    test.assert_eq(cis_req_check(var x, 30000), STATUS_PARAMETER_OUT_OF_RANGE)
    t_set(x, "max_pdu_c", 100)
    t_set(x, "framed", 0)
    t_set(x, "phy", 0)
    test.assert_eq(cis_req_check(var x, 30000), STATUS_UNSUPPORTED_LL_PARAMETER)
    t_set(x, "phy", 2)
    t_set(x, "nse", 6)
    // The direction this end sends needs BN x (FT + 1) slots of the ring (Parameter Out of Mandatory Range, the code of Section 5.1.15 for
    // a BN, FT or NSE not supported); the direction it receives needs none.
    t_set(x, "bn_p", 4)
    t_set(x, "ft_p", 3)
    test.assert_eq(cis_req_check(var x, 30000), STATUS_PARAMETER_OUT_OF_RANGE)
    test.assert_eq(cis_req_why(var x, 30000) >> 8, WHY_RING)
    t_set(x, "bn_p", 1)
    t_set(x, "ft_p", 1)
    t_set(x, "bn_c", 4)
    t_set(x, "ft_c", 9)
    test.assert_eq(cis_req_check(var x, 30000), 0)
    t_set(x, "bn_c", 1)
    t_set(x, "ft_c", 1)
    t_set(x, "nse", 40)
    test.assert_eq(cis_req_check(var x, 30000), STATUS_PARAMETER_OUT_OF_RANGE)
    t_set(x, "nse", 2)
    t_set(x, "max_pdu_p", 0)
    test.assert_eq(cis_req_check(var x, 30000), STATUS_PARAMETER_OUT_OF_RANGE)

// The sample data of [Vol 6] Part C, Section 3: the channels of the first subevents for 37, 9 and 3 used
// channels.
@test
fn test_subevent_channels_follow_the_sample_data_of_the_specification()
    let aa = 0x8E89BED6
    let full = 0x1FFFFFFFFF
    test.assert_eq(sub_channel(aa, 0, 1, full, 37), 25)
    test.assert_eq(sub_channel(aa, 0, 2, full, 37), 1)
    test.assert_eq(sub_channel(aa, 0, 3, full, 37), 16)
    test.assert_eq(sub_channel(aa, 0, 4, full, 37), 36)
    test.assert_eq(sub_channel(aa, 1, 1, full, 37), 20)
    test.assert_eq(sub_channel(aa, 1, 2, full, 37), 36)
    test.assert_eq(sub_channel(aa, 1, 3, full, 37), 12)
    test.assert_eq(sub_channel(aa, 1, 4, full, 37), 34)
    test.assert_eq(sub_channel(aa, 2, 4, full, 37), 21)
    test.assert_eq(sub_channel(aa, 3, 2, full, 37), 4)
    let m9 = 0x1E00E00600
    test.assert_eq(sub_channel(aa, 6, 1, m9, 9), 23)
    test.assert_eq(sub_channel(aa, 6, 2, m9, 9), 35)
    test.assert_eq(sub_channel(aa, 6, 3, m9, 9), 21)
    test.assert_eq(sub_channel(aa, 6, 4, m9, 9), 36)
    test.assert_eq(sub_channel(aa, 7, 1, m9, 9), 9)
    test.assert_eq(sub_channel(aa, 7, 2, m9, 9), 22)
    test.assert_eq(sub_channel(aa, 7, 3, m9, 9), 36)
    test.assert_eq(sub_channel(aa, 7, 4, m9, 9), 33)
    test.assert_eq(sub_channel(aa, 8, 1, m9, 9), 34)
    test.assert_eq(sub_channel(aa, 8, 4, m9, 9), 10)
    let m3 = 0x106
    test.assert_eq(sub_channel(aa, 11, 1, m3, 3), 1)
    test.assert_eq(sub_channel(aa, 11, 2, m3, 3), 2)
    test.assert_eq(sub_channel(aa, 11, 3, m3, 3), 1)
    test.assert_eq(sub_channel(aa, 11, 4, m3, 3), 8)
    test.assert_eq(sub_channel(aa, 13, 4, m3, 3), 1)

@test
fn test_the_minimum_channel_distance_follows_the_number_of_used_channels()
    test.assert_eq(sub_distance(37), 11)
    test.assert_eq(sub_distance(9), 3)
    test.assert_eq(sub_distance(3), 1)
    test.assert_eq(sub_distance(2), 1)

@test
fn test_flush_points_follow_the_figures_of_the_specification()
    // BN 2, FT 1, NSE 4 (Figure 4.64): payload 0 is flushed after 2 subevents, payload 1 after 4, of event 0.
    test.assert_eq(flush_event(0, 2, 1), 0)
    test.assert_eq(flush_subs(0, 2, 4), 2)
    test.assert_eq(flush_subs(1, 2, 4), 4)
    test.assert(not flushed(0, 2, 1, 4, 0, 2))
    test.assert(flushed(0, 2, 1, 4, 0, 3))
    test.assert(not flushed(1, 2, 1, 4, 0, 4))
    test.assert(flushed(1, 2, 1, 4, 1, 1))
    // BN 1, FT 2, NSE 4 (Figure 4.65): payload 0 is flushed after the 4 subevents of event 1.
    test.assert_eq(flush_event(0, 1, 2), 1)
    test.assert_eq(flush_subs(0, 1, 4), 4)
    test.assert(not flushed(0, 1, 2, 4, 1, 4))
    test.assert(flushed(0, 1, 2, 4, 2, 1))
    test.assert(flushed(3, 1, 2, 4, 5, 1))

@test
fn test_an_sdu_is_cut_into_upps_payloads_and_padded()
    if not ctl_limits.iso_on()
        return
    var x = t_cis(true)
    t_set(x, "max_sdu_c", 250)
    t_set(x, "max_pdu_c", 100)
    t_set(x, "bn_c", 3)
    t_set(x, "ft_c", 1)
    test.assert_eq(tx_upps(var x), 3)
    var d = t_sdu(1)
    // 250 octets: fragments of 100, 100 and 50.
    test.assert(sdu_put(var x, var d, 0, 250))
    test.assert_eq(x.tx_wr, 3)
    test.assert_eq(x.txl[0], 100)
    test.assert_eq(x.txf[0] & 3, 1)
    test.assert_eq(x.txl[1], 100)
    test.assert_eq(x.txf[1] & 3, 1)
    test.assert_eq(x.txl[2], 50)
    test.assert_eq(x.txf[2] & 3, 0)
    test.assert_eq(x.txf[2] & 4, 4)
    // 120 octets: two fragments and a padding payload.
    test.assert(sdu_put(var x, var d, 0, 120))
    test.assert_eq(x.txl[3], 100)
    test.assert_eq(x.txf[3] & 3, 1)
    test.assert_eq(x.txl[4], 20)
    test.assert_eq(x.txf[4] & 3, 0)
    test.assert_eq(x.txl[5], 0)
    test.assert_eq(x.txf[5] & 3, 1)
    test.assert_eq(x.txf[5] & 8, 8)
    test.assert_eq(x.txf[5] & 4, 4)
    // The first SDU is acknowledged, which frees its three slots.  A zero-length SDU: one empty payload
    // of LLID 0 and two of padding.
    t_set(x, "tx_num", 3)
    test.assert(sdu_put(var x, var d, 0, 0))
    test.assert_eq(x.txl[6], 0)
    test.assert_eq(x.txf[6] & 3, 0)
    test.assert_eq(x.txf[7] & 8, 8)
    // The ring is full: no room for the next, and an SDU over the maximum is refused.
    test.assert(not sdu_put(var x, var d, 0, 10))
    var y = t_cis(true)
    test.assert(not sdu_put(var y, var d, 0, 101))

@test
fn test_a_payload_the_radio_program_places_later_is_queued_now_and_its_octets_follow()
    if not ctl_limits.iso_on()
        return
    var x = t_cis(false)
    var p = ll_pdu.pdu_new()
    ll_data.dpdu_begin(var p, 0)
    for i in 0..40
        let _a = ll_pdu.pdu_put_data(var p, 0x30 + i)
    ll_data.dpdu_finish(var p)
    // With `defer` set the SDU is queued with its length and status, and the slot holds nothing yet: the octets wait in the PDU.
    t_set(x, "defer", 1)
    rx_note(var x, 0, true, var p)
    t_set(x, "defer", 0)
    test.assert_eq(x.out_n, 1)
    test.assert_eq(x.outl[0], 40)
    test.assert_eq(x.outs[0], SDU_VALID)
    test.assert_eq(x.cp_n, 40)
    test.assert_eq(x.outd[0] as Int, 0)
    test.assert(rx_copy(var x, var p))
    test.assert_eq(x.cp_n, 0)
    test.assert_eq(x.outd[0] as Int, 0x30)
    test.assert_eq(x.outd[39] as Int, 0x30 + 39)
    test.assert(not rx_copy(var x, var p))
    // The slot of the next SDU is the next one, so the first is not overwritten.
    t_set(x, "defer", 1)
    rx_note(var x, 1, true, var p)
    t_set(x, "defer", 0)
    test.assert_eq(x.out_n, 2)
    test.assert_eq(x.cp_at, OUT_OCTETS)
    test.assert(rx_copy(var x, var p))
    test.assert_eq(x.outd[OUT_OCTETS] as Int, 0x30)
    test.assert_eq(x.outd[0] as Int, 0x30)
    // A second payload while one waits is not placed: the SDU it belongs to is possibly invalid.
    out_take(var x)
    out_take(var x)
    t_set(x, "defer", 1)
    rx_note(var x, 2, true, var p)
    var q = ll_pdu.pdu_new()
    ll_data.dpdu_begin(var q, 0)
    for i in 0..5
        let _b = ll_pdu.pdu_put_data(var q, 0x50 + i)
    ll_data.dpdu_finish(var q)
    rx_note(var x, 3, true, var q)
    t_set(x, "defer", 0)
    test.assert_eq(x.out_n, 2)
    test.assert_eq(x.outs[(x.out_head + 1) % OUT_SLOTS], SDU_INVALID)
    test.assert_eq(x.cp_n, 40)

@test
fn test_a_burst_is_filled_with_padding_to_bn_payloads_an_event()
    if not ctl_limits.iso_on()
        return
    var x = t_cis(true)
    t_set(x, "bn_c", 2)
    t_set(x, "max_sdu_c", 100)
    t_set(x, "max_pdu_c", 100)
    t_set(x, "sdu_int_c", 5000)
    // BN 2 = UPPS 1 x USPI 2.
    test.assert_eq(tx_upps(var x), 1)
    var d = t_sdu(7)
    test.assert(sdu_put(var x, var d, 0, 60))
    tx_fill(var x, 0)
    test.assert_eq(x.tx_wr, 2)
    test.assert_eq(x.txf[1] & 8, 8)
    tx_fill(var x, 1)
    test.assert_eq(x.tx_wr, 4)
    // Eligible only for the events the burst belongs to.
    test.assert(tx_eligible(var x, 0, 0))
    test.assert(tx_eligible(var x, 1, 0))
    test.assert(not tx_eligible(var x, 2, 0))
    test.assert(tx_eligible(var x, 2, 1))

@test
fn test_header_octets_carry_the_llid_nesn_sn_and_npi()
    if not ctl_limits.iso_on()
        return
    var x = t_cis(true)
    var d = t_sdu(7)
    test.assert(sdu_put(var x, var d, 0, 60))
    // Payload 0: LLID 0, SN 0, NESN 0.
    test.assert_eq(tx_header(var x, 0), 0)
    t_set(x, "rx_num", 1)
    test.assert_eq(tx_header(var x, 0), 4)
    // The Null PDU: LLID 1, NPI 1.
    test.assert_eq(tx_header(var x, -1), 1 | 4 | 0x40)
    var p = ll_pdu.pdu_new()
    tx_build(x, 0, p)
    test.assert_eq(p.n, 62)
    test.assert_eq(ll_data.dpdu_len(var p), 60)
    test.assert_eq(p.b[2] as Int, 7)
    test.assert_eq(p.b[61] as Int, 66)
    tx_build(x, -1, p)
    test.assert_eq(p.n, 2)
    test.assert_eq(p.b[1] as Int, 0)

// One subevent `s` of CIS event `e` between the two ends, as the Controller drives them: the flush
// rules run, the Central sends, the Peripheral decides its answer from the header, applies the packet
// and answers, and the Central applies the answer.  `lose_c` drops the Central's packet, `lose_p` the
// Peripheral's answer.
fn pair_sub(var c: Cis, var p: Cis, e: Int, s: Int, lose_c: Bool, lose_p: Bool)
    var pc = ll_pdu.pdu_new()
    var pp = ll_pdu.pdu_new()
    var scr = ll_pdu.pdu_new()
    tx_flush(var c, e, s)
    rx_flush(var c, e, s, var scr)
    tx_flush(var p, e, s)
    rx_flush(var p, e, s, var scr)
    let cn = tx_pick(var c, e)
    tx_build(c, cn, pc)
    t_set(c, "sent_num", cn)
    if lose_c
        return
    // The Peripheral hears the Central.
    let pcur = tx_pick(var p, e)
    let pnxt = tx_pick_next(var p, e, s)
    let hdr = rx_fast(var p, pc.b[0] as Int, pcur, pnxt)
    var num = pcur
    if p.use_nxt
        num = pnxt
    tx_build(p, num, pp)
    pp.b[0] = hdr as u8
    t_set(p, "sent_num", num)
    rx_apply(var p, e, s, var pc, true, 0)
    if lose_p
        return
    // The Central hears the answer.
    let _h = rx_fast(var c, pp.b[0] as Int, -1, -1)
    rx_apply(var c, e, s, var pp, true, 0)

// One CIS event: `lose` is 0 for none lost, 1 for every Central packet, 2 for every answer, 3 for
// the Central's first packet only.
fn pair_event(var c: Cis, var p: Cis, e: Int, lose: Int)
    t_set(c, "ev", e)
    event_begin(var c)
    t_set(p, "ev", e)
    event_begin(var p)
    for s in 1..(c.nse + 1)
        var lc = false
        var lp = false
        if lose == 1 or (lose == 3 and s == 1)
            lc = true
        if lose == 2
            lp = true
        pair_sub(var c, var p, e, s, lc, lp)

fn pair_drain(var x: Cis) -> Int
    var n = 0
    for _ in 0..4
        if out_ready(var x)
            out_take(var x)
            n = n + 1
    n

@test
fn test_every_sdu_reaches_the_peer_on_a_clean_link_and_is_acknowledged()
    if not ctl_limits.iso_on()
        return
    var c = t_cis(true)
    var p = t_cis(false)
    var d = t_sdu(0)
    var got = 0
    var done = 0
    for e in 0..30
        d[0] = (e & 0xFF) as u8
        test.assert(sdu_put(var c, var d, 0, 60))
        pair_event(var c, var p, e, 0)
        if out_ready(var p)
            test.assert_eq(p.outl[p.out_head], 60)
            test.assert_eq(p.outs[p.out_head], SDU_VALID)
            test.assert_eq(p.outd[p.out_head * OUT_OCTETS] as Int, got)
            test.assert_eq(p.outq[p.out_head], got)
            got = got + 1
            out_take(var p)
        done = done + comp_take(var c)
    test.assert_eq(got, 30)
    test.assert_eq(done, 30)
    test.assert_eq(c.n_flush_tx, 0)
    test.assert_eq(p.n_dup, 0)

@test
fn test_a_lost_packet_is_sent_again_in_the_next_subevent_when_nse_allows()
    if not ctl_limits.iso_on()
        return
    var c = t_cis(true)
    var p = t_cis(false)
    var d = t_sdu(0)
    test.assert(sdu_put(var c, var d, 0, 60))
    // The first subevent of event 0 is lost; the second carries the payload again.
    pair_event(var c, var p, 0, 3)
    test.assert_eq(p.n_rx, 1)
    test.assert_eq(p.rx_num, 1)
    test.assert_eq(c.tx_num, 1)
    test.assert_eq(c.comp, 1)
    test.assert_eq(p.out_n, 1)
    test.assert_eq(p.outs[0], SDU_VALID)

@test
fn test_a_lost_answer_makes_the_central_send_again_and_the_peripheral_drop_the_duplicate()
    if not ctl_limits.iso_on()
        return
    var c = t_cis(true)
    var p = t_cis(false)
    var d = t_sdu(0)
    test.assert(sdu_put(var c, var d, 0, 60))
    pair_event(var c, var p, 0, 2)
    // Every answer was lost: the Central never saw an acknowledgement, its payload is flushed after FT 1.
    test.assert_eq(p.rx_num, 1)
    test.assert_eq(p.n_dup, 1)
    test.assert_eq(p.out_n, 1)
    test.assert_eq(c.tx_num, 0)
    pair_event(var c, var p, 1, 0)
    test.assert_eq(c.n_flush_tx, 1)
    test.assert_eq(c.comp, 1)

@test
fn test_a_payload_that_is_never_heard_is_flushed_and_its_sdu_reported_lost()
    if not ctl_limits.iso_on()
        return
    var c = t_cis(true)
    var p = t_cis(false)
    var d = t_sdu(0)
    var statuses: [Int] = []
    var lens: [Int] = []
    // Three SDUs; the second one's event is lost entirely.
    test.assert(sdu_put(var c, var d, 0, 40))
    pair_event(var c, var p, 0, 0)
    for _ in 0..2
        if out_ready(var p)
            list.push(statuses, p.outs[p.out_head])
            list.push(lens, p.outl[p.out_head])
            out_take(var p)
    test.assert(sdu_put(var c, var d, 0, 41))
    pair_event(var c, var p, 1, 1)
    test.assert(sdu_put(var c, var d, 0, 42))
    pair_event(var c, var p, 2, 0)
    pair_event(var c, var p, 3, 0)
    for _ in 0..3
        if out_ready(var p)
            list.push(statuses, p.outs[p.out_head])
            list.push(lens, p.outl[p.out_head])
            out_take(var p)
    // The peripheral got payload 0, missed 1 (flushed at the start of event 2), took payload 2.
    test.assert_eq(list.len(statuses), 3)
    test.assert_eq(statuses[0], SDU_VALID)
    test.assert_eq(lens[0], 40)
    test.assert_eq(statuses[1], SDU_LOST)
    test.assert_eq(lens[1], 0)
    test.assert_eq(statuses[2], SDU_VALID)
    test.assert_eq(lens[2], 42)
    test.assert_eq(p.n_flush_rx, 1)
    test.assert_eq(c.n_flush_tx, 1)

@test
fn test_both_directions_carry_data_at_once()
    if not ctl_limits.iso_on()
        return
    var c = t_cis(true)
    var p = t_cis(false)
    var d = t_sdu(0)
    var a = 0
    var b = 0
    for e in 0..20
        test.assert(sdu_put(var c, var d, 0, 30))
        test.assert(sdu_put(var p, var d, 0, 50))
        pair_event(var c, var p, e, 0)
        a = a + pair_drain(var p)
        b = b + pair_drain(var c)
    test.assert_eq(a, 20)
    test.assert_eq(b, 20)
    test.assert_eq(c.n_sdu_bad, 0)
    test.assert_eq(p.n_sdu_bad, 0)

@test
fn test_a_cis_event_closed_by_the_peer_ends()
    var x = t_cis(false)
    var p = ll_pdu.pdu_new()
    event_begin(var x)
    // A Null PDU from the Central with CIE set.
    let hdr = 1 | 0x40 | 0x10
    let _h = rx_fast(var x, hdr, -1, -1)
    rx_apply(var x, 0, 1, var p, true, 1000)
    test.assert(event_over(var x))
    test.assert_eq(x.n_null_rx, 1)

@test
fn test_a_peripheral_takes_the_anchor_from_the_first_packet_of_an_event()
    var x = t_cis(false)
    t_set(x, "anchor", 100000)
    t_set(x, "synced", 1)
    t_set(x, "last_rx", 100000)
    event_begin(var x)
    sync_anchor(x, 2, 101500 + 12)
    test.assert_eq(x.anchor, 100012)
    sync_anchor(x, 2, 105000)
    test.assert_eq(x.anchor, 100012)
    test.assert_eq(sub_start(var x, 2), 100012 + 1500)
    test.assert_eq(event_end(var x, 106000), 0)
    test.assert_eq(x.anchor, 100012 + 10000)
    test.assert_eq(x.ev, 1)

@test
fn test_a_stream_that_hears_nothing_fails_to_establish_after_six_intervals()
    var x = t_cis(false)
    t_set(x, "synced", 0)
    t_set(x, "first_us", 1000)
    t_set(x, "anchor", 1000)
    event_begin(var x)
    var r = 0
    for _ in 0..8
        r = event_end(var x, x.anchor + 5000)
        if r != 0
            break
    test.assert_eq(r, STATUS_FAILED_TO_ESTABLISH)

@test
fn test_an_established_stream_is_lost_at_the_supervision_timeout()
    var x = t_cis(false)
    t_set(x, "synced", 1)
    t_set(x, "sup_us", 100000)
    t_set(x, "last_rx", 0)
    t_set(x, "anchor", 0)
    event_begin(var x)
    test.assert_eq(event_end(var x, 50000), 0)
    test.assert_eq(event_end(var x, 100001), REASON_TIMEOUT)

@test
fn test_late_subevents_are_skipped_whole()
    var x = t_cis(false)
    t_set(x, "anchor", 10000)
    t_set(x, "synced", 1)
    t_set(x, "last_rx", 10000)
    event_begin(var x)
    // The program woke 25 ms later: subevents of three events passed.
    let n = skip_late(var x, 10000 + 25000, 150)
    test.assert(n >= 6)
    test.assert_eq(x.ev, 3)
    test.assert(sub_start(var x, x.sub) + se_len_us(var x) > 35000)

@test
fn test_widening_grows_with_the_time_since_the_last_anchor()
    test.assert_eq(widening_us(50, 10000, 4000), 1 + 32)
    test.assert(widening_us(500, 1000000, 100000) > widening_us(50, 1000000, 100000))
    test.assert_eq(widening_us(500, 100000000, 3000), 3000)

@test
fn test_slots_match_the_profile()
    test.assert(ctl_limits.cis_slots() >= 1)
    test.assert(ctl_limits.cig_slots() >= 1)
    test.assert(not ctl_limits.iso_on() or ctl_limits.iso_on())

// ── The derivation of a group ───────────────────────────────────────

fn t_plan_set(var p: Vec[CisPlan; 8], i: Int, sdu_c: Int, sdu_p: Int, rtn_c: Int, rtn_p: Int, masks: Int)
    p[i].cis_id = i
    p[i].max_sdu_c = sdu_c
    p[i].max_sdu_p = sdu_p
    p[i].phy_c = masks
    p[i].phy_p = masks
    p[i].rtn_c = rtn_c
    p[i].rtn_p = rtn_p

fn t_plan_framed(var g: GroupPlan)
    g.framing = 1

fn t_plan_mode(var g: GroupPlan, mode: Int)
    g.framing = mode

fn t_pdu_n(var p: Pdu, n: Int)
    p.n = n

fn t_plans() -> Vec[CisPlan; 8]
    var p: Vec[CisPlan; 8] = Vec.new()
    for _ in 0..8
        let _a = p.push(plan_new())
    p

@test
fn test_the_iso_interval_is_a_multiple_of_the_sdu_intervals_and_of_1250_microseconds()
    test.assert_eq(iso_interval_for(10000, 10000), 10000)
    test.assert_eq(iso_interval_for(7500, 0), 7500)
    test.assert_eq(iso_interval_for(0, 7500), 7500)
    test.assert_eq(iso_interval_for(7500, 10000), 30000)
    test.assert_eq(iso_interval_for(5000, 0), 5000)
    test.assert_eq(iso_interval_for(2500, 0), 5000)
    test.assert_eq(iso_interval_for(20000, 10000), 20000)
    // An SDU interval no multiple of 1.25 ms has no interval under 4 s: framed PDUs are needed.
    test.assert_eq(iso_interval_for(8163, 0), 0)

@test
fn test_one_stream_gets_the_subevents_its_retransmission_number_needs()
    var p = t_plans()
    t_plan_set(var p, 0, 100, 100, 2, 2, 3)
    var g = group_plan_new()
    test.assert_eq(plan_cig(var p, 1, 10000, 10000, 20, 20, 0, ll_radio.profile_assumed(), var g), 0)
    test.assert_eq(g.iso_us, 10000)
    // LE 2M (the shortest packets), one payload an event each way, three subevents for three opportunities at FT 1.
    test.assert_eq(p[0].phy, 2)
    test.assert_eq(p[0].pdu_c, 100)
    test.assert_eq(p[0].bn_c, 1)
    test.assert_eq(p[0].bn_p, 1)
    test.assert_eq(p[0].nse, 3)
    test.assert_eq(g.ft_c, 1)
    test.assert_eq(g.ft_p, 1)
    // SE_Length of two packets of 100 octets at 2M: 460 + 150 + 460 + 150.
    test.assert_eq(p[0].sub_int, 1220)
    test.assert_eq(p[0].off, 0)
    // The event: two sub-intervals and one exchange.
    test.assert_eq(g.sync, 2 * 1220 + 460 + 150 + 460)
    test.assert_eq(p[0].cis_sync, g.sync)

@test
fn test_two_streams_in_sequence_follow_one_another()
    var p = t_plans()
    t_plan_set(var p, 0, 100, 100, 2, 2, 3)
    t_plan_set(var p, 1, 100, 100, 2, 2, 3)
    var g = group_plan_new()
    test.assert_eq(plan_cig(var p, 2, 7500, 7500, 20, 20, 0, ll_radio.profile_assumed(), var g), 0)
    test.assert_eq(g.iso_us, 7500)
    test.assert_eq(p[0].nse, 3)
    test.assert_eq(p[1].nse, 3)
    // The second starts after the first's slot: NSE x Sub_Interval.
    test.assert_eq(p[0].off, 0)
    test.assert_eq(p[1].off, 3 * 1220)
    test.assert_eq(g.sync, 3 * 1220 + 2 * 1220 + 1070)
    test.assert_eq(p[0].cis_sync, g.sync)
    test.assert_eq(p[1].cis_sync, g.sync - 3 * 1220)

@test
fn test_two_streams_interleaved_share_the_sub_interval()
    var p = t_plans()
    t_plan_set(var p, 0, 100, 100, 2, 2, 3)
    t_plan_set(var p, 1, 100, 100, 2, 2, 3)
    var g = group_plan_new()
    test.assert_eq(plan_cig(var p, 2, 10000, 10000, 30, 30, 1, ll_radio.profile_assumed(), var g), 0)
    // Sub_Interval is the sum of the two SE_Length, the streams start one SE_Length apart.
    test.assert_eq(p[0].sub_int, 2 * 1220)
    test.assert_eq(p[1].sub_int, 2 * 1220)
    test.assert_eq(p[0].off, 0)
    test.assert_eq(p[1].off, 1220)
    test.assert_eq(g.sync, 1220 + 2 * 2440 + 1070)
    test.assert_eq(p[1].cis_sync, g.sync - 1220)

@test
fn test_a_radio_with_a_fast_ramp_up_takes_the_shortest_subevent_spacing()
    // The gap between two subevents is T_MSS_CIS (150) when Sub_Interval is SE_Length; a fast ramp-up of 45 with its margin
    // of 25 leaves 80 for the program's work, which is what `ll_radio.SUBEVENT_WORK_US` asks.
    let prof = ll_radio.profile_new(true, 145, 45)
    var p = t_plans()
    t_plan_set(var p, 0, 100, 100, 2, 2, 3)
    var g = group_plan_new()
    test.assert_eq(plan_cig(var p, 1, 10000, 10000, 20, 20, 0, prof, var g), 0)
    var q = t_plans()
    t_plan_set(var q, 0, 100, 100, 2, 2, 3)
    t_plan_set(var q, 1, 100, 100, 2, 2, 3)
    var h = group_plan_new()
    test.assert_eq(plan_cig(var q, 2, 10000, 10000, 30, 30, 1, prof, var h), 0)
    var r = t_plans()
    t_plan_set(var r, 0, 100, 100, 2, 2, 3)
    t_plan_set(var r, 1, 100, 100, 2, 2, 3)
    var k = group_plan_new()
    test.assert_eq(plan_cig(var r, 2, 7500, 7500, 20, 20, 0, prof, var k), 0)

@test
fn test_a_radio_without_a_fast_ramp_up_refuses_subevents_that_follow_too_close()
    // The legacy ramp-up of 145 with its margin and the program's work need a gap of 250, and the spacing of payloads of 10 octets
    // is 150 and the 20 microseconds the program takes for them (long payloads buy the gap, see the test after the next): a
    // stream of several subevents, and two streams one after the other or interleaved, are Unsupported Feature or Parameter
    // Value (0x11).  A single stream of one subevent has no next one and is taken.
    let prof = ll_radio.profile_new(false, 145, 0)
    var p = t_plans()
    t_plan_set(var p, 0, 10, 10, 2, 2, 3)
    var g = group_plan_new()
    test.assert_eq(plan_cig(var p, 1, 10000, 10000, 20, 20, 0, prof, var g), STATUS_UNSUPPORTED_FEATURE)
    var q = t_plans()
    t_plan_set(var q, 0, 10, 10, 2, 2, 3)
    t_plan_set(var q, 1, 10, 10, 2, 2, 3)
    var h = group_plan_new()
    test.assert_eq(plan_cig(var q, 2, 10000, 10000, 30, 30, 1, prof, var h), STATUS_UNSUPPORTED_FEATURE)
    var r = t_plans()
    t_plan_set(var r, 0, 10, 10, 0, 0, 3)
    var k = group_plan_new()
    test.assert_eq(plan_cig(var r, 1, 10000, 10000, 20, 20, 0, prof, var k), 0)
    test.assert_eq(r[0].nse, 1)
    var s2 = t_plans()
    t_plan_set(var s2, 0, 10, 10, 0, 0, 3)
    t_plan_set(var s2, 1, 10, 10, 0, 0, 3)
    var m = group_plan_new()
    test.assert_eq(plan_cig(var s2, 2, 10000, 10000, 20, 20, 0, prof, var m), STATUS_UNSUPPORTED_FEATURE)

@test
fn test_long_payloads_give_a_radio_without_a_fast_ramp_up_the_gap_it_needs()
    // The same radio with payloads of 100 octets each way: the spacing grows by the program's work on 200 octets (200 microseconds),
    // 350 against the 250 the radio needs, so the streams are taken.
    let prof = ll_radio.profile_new(false, 145, 0)
    var p = t_plans()
    t_plan_set(var p, 0, 100, 100, 2, 2, 3)
    var g = group_plan_new()
    test.assert_eq(plan_cig(var p, 1, 10000, 10000, 20, 20, 0, prof, var g), 0)
    var q = t_plans()
    t_plan_set(var q, 0, 100, 100, 2, 2, 3)
    t_plan_set(var q, 1, 100, 100, 2, 2, 3)
    var h = group_plan_new()
    test.assert_eq(plan_cig(var q, 2, 10000, 10000, 30, 30, 1, prof, var h), 0)

@test
fn test_the_gap_of_a_stream_is_checked_against_its_own_phy()
    let prof = ll_radio.RadioProfile { known: true, fast: true, octet_ns: 1000, slow_1m: 145, slow_2m: 145, slow_cod: 145,
                                      fast_1m: 45, fast_2m: 90, fast_cod: 45 }
    test.assert_eq(sub_gap_status(prof, ll_phy.PHY_2M, 3, 1220, 100, 100, 0x11), 0x11)
    test.assert_eq(sub_gap_status(prof, ll_phy.PHY_1M, 3, plan_se_len(ll_phy.PHY_1M, 100, 100), 100, 100, 0x11), 0)
    // Sub_Interval beyond SE_Length is slack: 150 + 100 = 250 is enough for the 2M ramp-up of 90.
    test.assert_eq(sub_gap_status(prof, ll_phy.PHY_2M, 3, 1320, 100, 100, 0x11), 0)
    test.assert_eq(sub_gap_status(prof, ll_phy.PHY_2M, 1, 0, 100, 100, 0x11), 0)
    test.assert_eq(sub_gap_status(ll_radio.profile_assumed(), ll_phy.PHY_2M, 3, 1220, 100, 100, 0x11), 0)

@test
fn test_a_request_with_subevents_too_close_is_refused_with_unsupported_ll_parameter_by_a_slow_radio()
    var x = cis_new()
    t_set(x, "phy", 2)
    t_set(x, "nse", 3)
    t_set(x, "max_pdu_c", 100)
    t_set(x, "max_pdu_p", 100)
    t_set(x, "sub_int", plan_se_len(ll_phy.PHY_2M, 100, 100))
    test.assert_eq(cis_req_gap(var x, ll_radio.profile_new(false, 145, 0)), STATUS_UNSUPPORTED_LL_PARAMETER)
    test.assert_eq(cis_req_gap(var x, ll_radio.profile_new(true, 145, 45)), 0)
    test.assert_eq(cis_req_gap(var x, ll_radio.profile_assumed()), 0)
    t_set(x, "sub_int", plan_se_len(ll_phy.PHY_2M, 100, 100) + 100)
    test.assert_eq(cis_req_gap(var x, ll_radio.profile_new(false, 145, 0)), 0)

@test
fn test_a_unidirectional_stream_has_no_pdu_and_no_burst_the_other_way()
    var p = t_plans()
    t_plan_set(var p, 0, 120, 0, 3, 0, 2)
    var g = group_plan_new()
    test.assert_eq(plan_cig(var p, 1, 10000, 10000, 20, 20, 0, ll_radio.profile_assumed(), var g), 0)
    test.assert_eq(p[0].phy, 2)
    test.assert_eq(p[0].pdu_p, 0)
    test.assert_eq(p[0].bn_p, 0)
    test.assert_eq(p[0].bn_c, 1)
    test.assert_eq(p[0].nse, 4)
    // SE_Length: the packet of 120 octets, an empty packet back, the spaces.
    test.assert_eq(p[0].sub_int, 540 + 150 + 60 + 150)

@test
fn test_an_sdu_over_251_octets_is_cut_into_several_payloads_and_a_burst_per_event()
    var p = t_plans()
    t_plan_set(var p, 0, 240, 0, 0, 0, 2)
    var g = group_plan_new()
    test.assert_eq(plan_cig(var p, 1, 10000, 10000, 20, 20, 0, ll_radio.profile_assumed(), var g), 0)
    test.assert_eq(p[0].pdu_c, 240)
    test.assert_eq(p[0].bn_c, 1)
    // 310 octets (two channels of an LC3 stream at 48 kHz) are two payloads of the longest PDU: BN 2, and the subevent
    // holds the 251 octets.
    var w = t_plans()
    t_plan_set(var w, 0, 310, 0, 0, 0, 2)
    var gw = group_plan_new()
    test.assert_eq(plan_cig(var w, 1, 10000, 10000, 20, 20, 0, ll_radio.profile_assumed(), var gw), 0)
    test.assert_eq(w[0].pdu_c, 251)
    test.assert_eq(w[0].bn_c, 2)
    test.assert(w[0].nse >= 2)
    // 503 octets are three payloads: BN 3.
    var v = t_plans()
    t_plan_set(var v, 0, 503, 0, 0, 0, 2)
    var gv = group_plan_new()
    test.assert_eq(plan_cig(var v, 1, 10000, 10000, 20, 20, 0, ll_radio.profile_assumed(), var gv), 0)
    test.assert_eq(v[0].bn_c, 3)
    // Two SDUs an interval make BN 2.
    var q = t_plans()
    t_plan_set(var q, 0, 100, 0, 0, 0, 2)
    var h = group_plan_new()
    test.assert_eq(plan_cig(var q, 1, 5000, 5000, 20, 20, 0, ll_radio.profile_assumed(), var h), 0)
    test.assert_eq(q[0].bn_c, 1)
    var r = t_plans()
    t_plan_set(var r, 0, 100, 0, 0, 0, 2)
    var k = group_plan_new()
    // 10 ms intervals of 5 ms SDUs: BN 2.
    test.assert_eq(plan_cig(var r, 1, 5000, 10000, 20, 20, 0, ll_radio.profile_assumed(), var k), 0)
    test.assert_eq(k.iso_us, 5000)

@test
fn test_a_radio_that_reports_its_work_on_octets_gets_the_spacing_the_payloads_need()
    // 251 octets each way: the program's work on 502 octets at 1 microsecond is 502, and the subevents of the stream are that
    // much further apart than SE_Length.
    let prof = ll_radio.profile_new(true, 145, 45)
    var p = t_plans()
    t_plan_set(var p, 0, 310, 310, 2, 2, 3)
    var g = group_plan_new()
    test.assert_eq(plan_cig(var p, 1, 10000, 10000, 40, 40, 0, prof, var g), 0)
    test.assert_eq(p[0].pdu_c, 251)
    test.assert_eq(p[0].sub_int, plan_se_len(2, 251, 251) + 502)
    // A radio not asked adds nothing, so the specification's SE_Length stays the spacing.
    var q = t_plans()
    t_plan_set(var q, 0, 310, 310, 2, 2, 3)
    var h = group_plan_new()
    test.assert_eq(plan_cig(var q, 1, 10000, 10000, 40, 40, 0, ll_radio.profile_assumed(), var h), 0)
    test.assert_eq(q[0].sub_int, plan_se_len(2, 251, 251))
    // A slower CPU, 2 microseconds an octet, doubles the extra.
    let slow = ll_radio.profile_for(true, 145, 45, 2000)
    var r = t_plans()
    t_plan_set(var r, 0, 310, 310, 2, 2, 3)
    var k = group_plan_new()
    test.assert_eq(plan_cig(var r, 1, 10000, 10000, 40, 40, 0, slow, var k), 0)
    test.assert_eq(r[0].sub_int, plan_se_len(2, 251, 251) + 1004)
    // Streams in sequence start one slot apart, the slot being the spacing of the stream and not SE_Length.
    var two = t_plans()
    t_plan_set(var two, 0, 100, 100, 1, 1, 3)
    t_plan_set(var two, 1, 100, 100, 1, 1, 3)
    var gt = group_plan_new()
    test.assert_eq(plan_cig(var two, 2, 10000, 10000, 40, 40, 0, prof, var gt), 0)
    test.assert_eq(two[1].off - two[0].off, two[0].nse * two[0].sub_int)
    test.assert_eq(two[0].sub_int, plan_se_len(2, 100, 100) + 200)

@test
fn test_a_retransmission_number_the_interval_cannot_hold_raises_the_flush_timeout()
    var p = t_plans()
    t_plan_set(var p, 0, 100, 100, 10, 10, 3)
    var g = group_plan_new()
    test.assert_eq(plan_cig(var p, 1, 10000, 10000, 40, 40, 0, ll_radio.profile_assumed(), var g), 0)
    // 8 subevents fit the interval, and 8 x FT opportunities with FT 2 are 16: 11 are asked for.
    test.assert_eq(p[0].nse, 8)
    test.assert_eq(g.ft_c, 2)
    test.assert_eq(g.ft_p, 2)

@test
fn test_a_request_the_controller_cannot_plan_is_refused_with_the_status_of_its_reason()
    var p = t_plans()
    t_plan_set(var p, 0, 100, 100, 2, 2, 3)
    var g = group_plan_new()
    // The latency allowed is shorter than the event.
    test.assert_eq(plan_cig(var p, 1, 10000, 10000, 3, 3, 0, ll_radio.profile_assumed(), var g), STATUS_INVALID_PARAMETERS)
    // An SDU interval that needs framed PDUs.
    var q = t_plans()
    t_plan_set(var q, 0, 100, 100, 2, 2, 3)
    test.assert_eq(plan_cig(var q, 1, 8163, 8163, 40, 40, 0, ll_radio.profile_assumed(), var g), STATUS_UNSUPPORTED_FEATURE)
    // No PHY in common.
    var r = t_plans()
    t_plan_set(var r, 0, 100, 100, 2, 2, 1)
    r[0].phy_p = 2
    test.assert_eq(plan_cig(var r, 1, 10000, 10000, 40, 40, 0, ll_radio.profile_assumed(), var g), STATUS_UNSUPPORTED_FEATURE)
    // An SDU over the Controller's maximum.
    var s2 = t_plans()
    t_plan_set(var s2, 0, SDU_MAX + 1, 0, 0, 0, 3)
    test.assert_eq(plan_cig(var s2, 1, 10000, 10000, 40, 40, 0, ll_radio.profile_assumed(), var g), STATUS_MEMORY_CAPACITY)
    // No data either way.
    var t = t_plans()
    t_plan_set(var t, 0, 0, 0, 0, 0, 3)
    test.assert_eq(plan_cig(var t, 1, 10000, 10000, 40, 40, 0, ll_radio.profile_assumed(), var g), STATUS_INVALID_PARAMETERS)
    // Streams that cannot all fit the interval: eight of 100 octets in 5 ms.
    var u = t_plans()
    for i in 0..8
        t_plan_set(var u, i, 100, 100, 0, 0, 3)
    test.assert_eq(plan_cig(var u, 8, 5000, 5000, 40, 40, 0, ll_radio.profile_assumed(), var g), STATUS_INVALID_PARAMETERS)

// ── Framed PDUs ──────────────────────────────────────────────────────

// A framed stream: ISO interval `iso` units of 1.25 ms, SDUs of `len` octets every `sdu_int` microseconds in both directions,
// PDUs of `pdu` octets and `bn` payloads an event, two subevents.  The group's reference point and the stream's anchor are
// the same (no offset in the group).
fn t_framed(central: Bool, iso: Int, sdu_int: Int, len: Int, pdu: Int, bn: Int) -> Cis
    var x = t_cis(central)
    t_set(x, "framed", 1)
    t_set(x, "iso_int", iso)
    t_set(x, "sdu_int_c", sdu_int)
    t_set(x, "sdu_int_p", sdu_int)
    t_set(x, "max_sdu_c", len)
    t_set(x, "max_sdu_p", len)
    t_set(x, "max_pdu_c", pdu)
    t_set(x, "max_pdu_p", pdu)
    t_set(x, "bn_c", bn)
    t_set(x, "bn_p", bn)
    x

// The SDU `k` of `len` octets: its number in the first two, then octets that follow from it.
fn t_fr_sdu(var d: Vec[u8; 260], k: Int, len: Int)
    d[0] = (k & 0xFF) as u8
    d[1] = ((k >>> 8) & 0xFF) as u8
    for i in 2..len
        d[i] = ((k * 7 + i) & 0xFF) as u8

// The SDUs of `x` that arrive by `now`: SDU `n` arrives at `phase` + n x `sdu_int`.  `n` is the number of the next one.
@tier(app)
fn t_fr_arrive(var x: Cis, n: Int, now: Int, len: Int, sdu_int: Int, phase: Int) -> Int
    var d = t_sdu(0)
    var k = n
    for _ in 0..8
        let at = phase + k * sdu_int
        if at > now
            break
        t_fr_sdu(var d, k, len)
        test.assert(fsdu_put(var x, var d, 0, len, at))
        k = k + 1
    k

// Take the SDUs `x` has for the Host and check them against what was sent: `st` holds the index the next SDU must have (0),
// the valid ones (1), the lost ones (2) and those with wrong data, a wrong index or a wrong time stamp (3).  The
// time stamp of SDU `k` is `phase` + k x `sdu_int` + `lat`.
fn t_fr_check(var x: Cis, var st: Vec[Int; 4], len: Int, sdu_int: Int, phase: Int, lat: Int)
    for _ in 0..4
        if not out_ready(var x)
            break
        let at = x.out_head
        let k = x.outq[at]
        if x.outs[at] == SDU_VALID
            st[1] = st[1] + 1
            var good = x.outl[at] == len and k == st[0]
            if good
                good = (x.outd[at * OUT_OCTETS] as Int) == (k & 0xFF) and (x.outd[at * OUT_OCTETS + 1] as Int) == ((k >>> 8) & 0xFF)
            if good
                for i in 2..len
                    if (x.outd[at * OUT_OCTETS + i] as Int) != ((k * 7 + i) & 0xFF)
                        good = false
            if good and x.outt[at] != ((phase + k * sdu_int + lat) & 0xFFFFFFFF)
                good = false
            if not good
                st[3] = st[3] + 1
        else
            st[2] = st[2] + 1
            if x.outs[at] != SDU_LOST or k != st[0]
                st[3] = st[3] + 1
        st[0] = k + 1
        out_take(var x)

fn t_fr_stats() -> Vec[Int; 4]
    var st: Vec[Int; 4] = Vec.new()
    for _ in 0..4
        let _a = st.push(0)
    st

// `events` CIS events of a framed pair whose first anchor is `first`.  The Central's SDUs arrive from `phase_c` and the
// Peripheral's from `phase_p`, each `sdu_int` apart.  Events `lose_from` to `lose_from + lose_n - 1` are lost to
// both ends.  `sc` and `sp` are the checks of the Central's and the Peripheral's received SDUs; the answer is the credits the
// Central got back for the SDUs it sent.
@tier(app)
fn t_fr_run(var c: Cis, var p: Cis, events: Int, first: Int, len: Int, sdu_int: Int, phase_c: Int, phase_p: Int, lose_from: Int, lose_n: Int, var sc: Vec[Int; 4], var sp: Vec[Int; 4]) -> Int
    var nc = 0
    var np = 0
    var credits = 0
    // What a receiver stamps: the origin on the Central's side, the origin plus the delays on the Peripheral's.
    var lat_p = c.cig_sync + c.sdu_int_c + c.ft_c * iso_us(c)
    if c.unseg
        lat_p = c.cig_sync + c.ft_c * iso_us(c)
    for e in 0..events
        let anchor = first + e * iso_us(c)
        t_set(c, "anchor", anchor)
        t_set(p, "anchor", anchor)
        t_set(c, "ev", e)
        t_set(p, "ev", e)
        nc = t_fr_arrive(var c, nc, anchor - 50, len, sdu_int, phase_c)
        np = t_fr_arrive(var p, np, anchor - 50, len, sdu_int, phase_p)
        var lose = 0
        if e >= lose_from and e < lose_from + lose_n
            lose = 1
        pair_event(var c, var p, e, lose)
        t_fr_check(var p, var sp, len, sdu_int, phase_c, lat_p)
        t_fr_check(var c, var sc, len, sdu_int, phase_p, 0)
        credits = credits + comp_take(var c)
    credits

@test
fn test_a_framed_sdu_is_one_segment_with_a_header_and_a_time_offset()
    if not ctl_limits.iso_on()
        return
    var x = t_framed(true, 8, 10000, 12, 37, 1)
    t_set(x, "anchor", 10000)
    var d = t_sdu(3)
    // The SDU was due 3 ms before the anchor of event 0.
    test.assert(fsdu_put(var x, var d, 0, 12, 7000))
    test.assert_eq(x.tx_wr, 1)
    test.assert_eq(x.txl[0], 17)
    test.assert_eq(x.txf[0] & 3, 2)
    test.assert_eq(x.txf[0] >>> 8, 1)
    // SC 0 and CMPLT 1; the length counts the Time_Offset; 3000 microseconds, least significant octet first.
    test.assert_eq(x.txd[0] as Int, 2)
    test.assert_eq(x.txd[1] as Int, 15)
    test.assert_eq(x.txd[2] as Int, 3000 & 0xFF)
    test.assert_eq(x.txd[3] as Int, 3000 >>> 8)
    test.assert_eq(x.txd[4] as Int, 0)
    test.assert_eq(x.txd[5] as Int, 3)
    test.assert_eq(x.txd[16] as Int, 14)
    test.assert_eq(x.fo_num, 0)
    test.assert_eq(x.fo_off, 3000)
    test.assert_eq(x.sdu_in, 1)
    var p = ll_pdu.pdu_new()
    tx_build(x, 0, p)
    test.assert_eq(ll_data.dpdu_llid(var p), 2)
    test.assert_eq(ll_data.dpdu_len(var p), 17)

@test
fn test_small_sdus_share_a_pdu_until_it_cannot_start_another()
    if not ctl_limits.iso_on()
        return
    var x = t_framed(true, 8, 5000, 12, 37, 1)
    t_set(x, "anchor", 10000)
    var d = t_sdu(3)
    test.assert(fsdu_put(var x, var d, 0, 12, 6000))
    test.assert(fsdu_put(var x, var d, 0, 12, 8000))
    // Two segments of 17 octets in one PDU, with their own Time_Offsets.
    test.assert_eq(x.tx_wr, 1)
    test.assert_eq(x.txl[0], 34)
    test.assert_eq(x.txf[0] >>> 8, 2)
    test.assert_eq(x.txd[17] as Int, 2)
    test.assert_eq(x.txd[18] as Int, 15)
    test.assert_eq(x.txd[19] as Int, 2000 & 0xFF)
    test.assert_eq(x.txd[20] as Int, 2000 >>> 8)
    // 3 octets are left, and the SDU is due after the anchor of event 0: it starts payload 1, which belongs to event 1.
    test.assert(fsdu_put(var x, var d, 0, 12, 12000))
    test.assert_eq(x.tx_wr, 2)
    test.assert_eq(x.txl[1], 17)
    test.assert_eq(x.fo_num, 1)
    test.assert_eq(x.fo_off, 20000 - 12000)

@test
fn test_an_sdu_over_a_pdu_continues_in_the_next_one_without_a_time_offset()
    if not ctl_limits.iso_on()
        return
    var x = t_framed(true, 8, 10000, 100, 40, 3)
    t_set(x, "anchor", 10000)
    var d = t_sdu(5)
    test.assert(fsdu_put(var x, var d, 0, 100, 9000))
    // 35 octets in the first segment, 38 and 27 in the next two; only the last has CMPLT.
    test.assert_eq(x.tx_wr, 3)
    test.assert_eq(x.txl[0], 40)
    test.assert_eq(x.txl[1], 40)
    test.assert_eq(x.txl[2], 29)
    test.assert_eq(x.txd[0] as Int, 0)
    test.assert_eq(x.txd[1] as Int, 38)
    test.assert_eq(x.txd[256] as Int, 1)
    test.assert_eq(x.txd[257] as Int, 38)
    test.assert_eq(x.txd[512] as Int, 3)
    test.assert_eq(x.txd[513] as Int, 27)
    // The credit comes back with the last payload alone.
    test.assert_eq(x.txf[0] >>> 8, 0)
    test.assert_eq(x.txf[1] >>> 8, 0)
    test.assert_eq(x.txf[2] >>> 8, 1)
    // The first payload carries the first octets of the SDU, the second the next.
    test.assert_eq(x.txd[5] as Int, 5)
    test.assert_eq(x.txd[256 + 2] as Int, (5 + 35) & 0xFF)

@test
fn test_an_empty_framed_sdu_is_a_header_and_a_time_offset_alone()
    if not ctl_limits.iso_on()
        return
    var x = t_framed(true, 8, 10000, 12, 37, 1)
    t_set(x, "anchor", 10000)
    var d = t_sdu(0)
    test.assert(fsdu_put(var x, var d, 0, 0, 9500))
    test.assert_eq(x.txl[0], 5)
    test.assert_eq(x.txd[0] as Int, 2)
    test.assert_eq(x.txd[1] as Int, 3)
    test.assert_eq(x.txd[2] as Int, 500 & 0xFF)
    test.assert_eq(x.txd[3] as Int, 500 >>> 8)

@test
fn test_an_sdu_due_after_the_anchor_waits_for_the_next_event_behind_padding()
    if not ctl_limits.iso_on()
        return
    var x = t_framed(true, 8, 10000, 12, 37, 1)
    t_set(x, "anchor", 10000)
    var d = t_sdu(0)
    // Due 500 microseconds after the anchor of event 0: payload 0 is padding (a framed PDU of no octets) and the SDU goes in
    // payload 1, whose reference point is a whole ISO interval after the first, 9500 microseconds after the SDU.
    test.assert(fsdu_put(var x, var d, 0, 12, 10500))
    test.assert_eq(x.tx_wr, 2)
    test.assert_eq(x.txl[0], 0)
    test.assert_eq(x.txf[0] & 3, 2)
    test.assert_eq(x.txf[0] & 8, 8)
    test.assert_eq(x.txl[1], 17)
    test.assert_eq(x.fo_off, 9500)
    var p = ll_pdu.pdu_new()
    tx_build(x, 0, p)
    test.assert_eq(ll_data.dpdu_llid(var p), 2)
    test.assert_eq(ll_data.dpdu_len(var p), 0)

@test
fn test_an_sdu_without_room_in_the_ring_changes_nothing()
    if not ctl_limits.iso_on()
        return
    var x = t_framed(true, 8, 10000, 100, 40, 3)
    t_set(x, "anchor", 10000)
    var d = t_sdu(5)
    test.assert(fsdu_put(var x, var d, 0, 100, 9000))
    test.assert(fsdu_put(var x, var d, 0, 100, 9000))
    // The second SDU began in the room the first left in its last payload, so 6 are in use; a third needs a seventh and an eighth,
    // and a ninth.
    let wr = x.tx_wr
    let n = x.sdu_in
    let last = x.txl[wr - 1]
    test.assert(not fsdu_put(var x, var d, 0, 100, 9000))
    test.assert_eq(x.tx_wr, wr)
    test.assert_eq(x.sdu_in, n)
    test.assert_eq(x.txl[wr - 1], last)
    // An SDU over Max_SDU is refused too.
    test.assert(not fsdu_put(var x, var d, 0, 101, 9000))

@test
fn test_a_burst_closes_the_open_pdu_and_pads_what_is_left()
    if not ctl_limits.iso_on()
        return
    var x = t_framed(true, 8, 10000, 12, 37, 2)
    t_set(x, "anchor", 10000)
    var d = t_sdu(0)
    test.assert(fsdu_put(var x, var d, 0, 12, 9000))
    test.assert(x.fo_open)
    // The burst of event 0 is payloads 0 and 1: the PDU is closed with what it has, the second is padding.
    tx_fill(var x, 0)
    test.assert(not x.fo_open)
    test.assert_eq(x.tx_wr, 2)
    test.assert_eq(x.txl[0], 17)
    test.assert_eq(x.txf[1] & 8, 8)
    // An SDU due in the interval after goes in event 1's burst.
    test.assert(fsdu_put(var x, var d, 0, 12, 17000))
    test.assert_eq(x.tx_wr, 3)
    test.assert_eq(x.fo_off, 20000 - 17000)

@test
fn test_credits_return_for_each_sdu_that_ends_in_a_payload()
    if not ctl_limits.iso_on()
        return
    var x = t_framed(true, 8, 5000, 12, 37, 1)
    t_set(x, "anchor", 10000)
    var d = t_sdu(0)
    test.assert(fsdu_put(var x, var d, 0, 12, 6000))
    test.assert(fsdu_put(var x, var d, 0, 12, 8000))
    t_set(x, "tx_num", 0)
    tx_retire(var x, false)
    test.assert_eq(comp_take(var x), 2)

@test
fn test_framed_sdus_at_an_interval_that_is_no_multiple_of_the_iso_interval_arrive_whole_and_in_order()
    if not ctl_limits.iso_on()
        return
    // SDUs of 30 octets every 10 ms on a 7.5 ms ISO interval with PDUs of 29: each SDU is cut over two payloads, and an
    // event with no SDU due carries padding.
    var c = t_framed(true, 6, 10000, 30, 29, 1)
    var p = t_framed(false, 6, 10000, 30, 29, 1)
    var sc = t_fr_stats()
    var sp = t_fr_stats()
    let credits = t_fr_run(var c, var p, 40, 100000, 30, 10000, 95000, 92000, 99, 0, var sc, var sp)
    test.assert(sp[1] >= 28)
    test.assert(sc[1] >= 28)
    test.assert_eq(sp[2], 0)
    test.assert_eq(sc[2], 0)
    test.assert_eq(sp[3], 0)
    test.assert_eq(sc[3], 0)
    test.assert(credits >= sp[1] - 1)
    test.assert_eq(c.n_flush_tx, 0)

@test
fn test_small_framed_sdus_on_a_longer_iso_interval_arrive_together_from_one_payload()
    if not ctl_limits.iso_on()
        return
    // 12-octet SDUs every 5 ms on a 10 ms ISO interval: two SDUs are in each payload.
    var c = t_framed(true, 8, 5000, 12, 37, 1)
    var p = t_framed(false, 8, 5000, 12, 37, 1)
    var sc = t_fr_stats()
    var sp = t_fr_stats()
    let credits = t_fr_run(var c, var p, 30, 100000, 12, 5000, 96000, 94000, 99, 0, var sc, var sp)
    test.assert(sp[1] >= 50)
    test.assert(sc[1] >= 50)
    test.assert_eq(sp[2] + sp[3] + sc[2] + sc[3], 0)
    test.assert(credits >= sp[1] - 2)

@test
fn test_large_framed_sdus_run_over_several_payloads_and_events()
    if not ctl_limits.iso_on()
        return
    // 200-octet SDUs every 10 ms on a 15 ms ISO interval, PDUs of 160 octets, two payloads an event: 2 x 158 octets an event
    // are over the F x 205 = 307.5 octets that 1.5 SDUs an event and their headers need.
    var c = t_framed(true, 12, 10000, 200, 160, 2)
    var p = t_framed(false, 12, 10000, 200, 160, 2)
    var sc = t_fr_stats()
    var sp = t_fr_stats()
    let credits = t_fr_run(var c, var p, 30, 100000, 200, 10000, 90000, 85000, 99, 0, var sc, var sp)
    test.assert(sp[1] >= 25)
    test.assert(sc[1] >= 25)
    test.assert_eq(sp[2] + sp[3] + sc[2] + sc[3], 0)
    test.assert(credits >= sp[1] - 2)

@test
fn test_a_lost_event_makes_lost_sdus_and_the_sequence_goes_on_without_a_gap()
    if not ctl_limits.iso_on()
        return
    var c = t_framed(true, 6, 10000, 30, 29, 1)
    var p = t_framed(false, 6, 10000, 30, 29, 1)
    var sc = t_fr_stats()
    var sp = t_fr_stats()
    // Events 10 and 11 are lost to both ends.  Every SDU that arrives is valid and has its own index, or is reported lost
    // with the index it would have had: a valid SDU after the gap has the index of the SDU sent, not one less.
    let credits = t_fr_run(var c, var p, 40, 100000, 30, 10000, 95000, 92000, 10, 2, var sc, var sp)
    test.assert(sp[2] >= 1)
    test.assert(sc[2] >= 1)
    test.assert_eq(sp[3], 0)
    test.assert_eq(sc[3], 0)
    test.assert(sp[1] + sp[2] >= 28)
    test.assert(sc[1] + sc[2] >= 28)
    test.assert(credits >= sp[1] + sp[2] - 3)

@test
fn test_a_framed_payload_that_cannot_be_read_loses_the_sdu_under_way()
    if not ctl_limits.iso_on()
        return
    var x = t_framed(false, 8, 10000, 30, 40, 1)
    t_set(x, "anchor", 10000)
    t_set(x, "rx_num", 0)
    var p = ll_pdu.pdu_new()
    // A start segment of 20 octets that does not end (SC 0, CMPLT 0, 23 octets with the Time_Offset), then a segment whose
    // length overruns the payload.
    p.b[0] = 2
    p.b[1] = 27
    p.b[2] = 0
    p.b[3] = 23
    p.b[4] = 0
    p.b[5] = 0
    p.b[6] = 0
    for i in 0..20
        p.b[7 + i] = i as u8
    p.b[27] = 1
    p.b[28] = 50
    t_pdu_n(var p, 29)
    rx_note(var x, 0, true, var p)
    // The first segment is read, then the second is found to overrun: the SDU under way is lost at once.
    test.assert_eq(x.out_n, 1)
    test.assert_eq(x.outs[x.out_head], SDU_LOST)
    test.assert(x.fa_gap)
    test.assert(not x.fa_open)

@test
fn test_a_continuation_without_its_start_is_dropped()
    if not ctl_limits.iso_on()
        return
    var x = t_framed(false, 8, 10000, 30, 40, 1)
    var p = ll_pdu.pdu_new()
    p.b[0] = 2
    p.b[1] = 6
    p.b[2] = 3
    p.b[3] = 4
    for i in 0..4
        p.b[4 + i] = 9
    t_pdu_n(var p, 8)
    rx_note(var x, 0, true, var p)
    test.assert_eq(x.out_n, 0)
    test.assert(not x.fa_open)

@test
fn test_framed_parameters_follow_the_bandwidth_rule_and_the_interval_need_not_divide()
    // The ISO interval is the SDU interval up to a multiple of 1.25 ms, never under 5 ms.
    test.assert_eq(framed_interval_for(10000, 10000), 10000)
    test.assert_eq(framed_interval_for(8000, 0), 8750)
    test.assert_eq(framed_interval_for(0, 8000), 8750)
    test.assert_eq(framed_interval_for(10000, 7500), 7500)
    test.assert_eq(framed_interval_for(2500, 0), 5000)
    // 30 octets every 10 ms in 10 ms: 36 octets with the 100 ppm allowance, 44 with the quarter more, in one PDU of 46.
    test.assert_eq(framed_octets(30, 10000, 10000), 44)
    test.assert_eq(framed_pdu(30, 10000, 10000), 46)
    test.assert_eq(framed_bn(30, 10000, 10000, 46), 1)
    // 240 octets every 8 ms in 8.75 ms: 335 octets, two PDUs of 251.
    test.assert_eq(framed_octets(240, 8000, 8750), 335)
    test.assert_eq(framed_pdu(240, 8000, 8750), 251)
    test.assert_eq(framed_bn(240, 8000, 8750, 251), 2)
    // Nothing flows in a direction without SDUs.
    test.assert_eq(framed_pdu(0, 10000, 10000), 0)
    test.assert_eq(framed_bn(0, 10000, 10000, 0), 0)

@test
fn test_a_framed_group_is_derived_with_an_interval_that_is_no_multiple_of_the_sdu_interval()
    var p = t_plans()
    t_plan_set(var p, 0, 100, 60, 2, 2, 3)
    var g = group_plan_new()
    t_plan_framed(var g)
    test.assert_eq(plan_cig(var p, 1, 8000, 8000, 40, 40, 0, ll_radio.profile_assumed(), var g), 0)
    test.assert_eq(g.iso_us, 8750)
    test.assert_eq(p[0].pdu_c, framed_pdu(100, 8000, 8750))
    test.assert_eq(p[0].pdu_p, framed_pdu(60, 8000, 8750))
    test.assert_eq(p[0].bn_c, 1)
    test.assert_eq(p[0].bn_p, 1)
    test.assert(p[0].nse >= 3)
    // Unframed, the interval would have to be a multiple of both 1.25 ms and 8 ms: 40 ms, with five SDUs in it.
    test.assert_eq(iso_interval_for(8000, 8000), 40000)

@test
fn test_a_framed_group_counts_the_framing_delay_in_the_transport_latency()
    var p = t_plans()
    t_plan_set(var p, 0, 30, 30, 2, 2, 3)
    var g = group_plan_new()
    t_plan_framed(var g)
    // CIG_Sync_Delay + FT x ISO_Interval + one SDU interval is over 20 ms; unframed it is not.
    test.assert_eq(plan_cig(var p, 1, 10000, 10000, 20, 20, 0, ll_radio.profile_assumed(), var g), STATUS_INVALID_PARAMETERS)
    var q = t_plans()
    t_plan_set(var q, 0, 30, 30, 2, 2, 3)
    var h = group_plan_new()
    test.assert_eq(plan_cig(var q, 1, 10000, 10000, 20, 20, 0, ll_radio.profile_assumed(), var h), 0)
    var r = t_plans()
    t_plan_set(var r, 0, 30, 30, 2, 2, 3)
    var k = group_plan_new()
    t_plan_framed(var k)
    test.assert_eq(plan_cig(var r, 1, 10000, 10000, 40, 40, 0, ll_radio.profile_assumed(), var k), 0)

// ── Unsegmented mode ─────────────────────────────────────────────────

// A stream in Unsegmented mode: as `t_framed`, with the flag.
fn t_unseg(central: Bool, iso: Int, sdu_int: Int, len: Int, pdu: Int, bn: Int) -> Cis
    var x = t_framed(central, iso, sdu_int, len, pdu, bn)
    t_set(x, "unseg", 1)
    x

@test
fn test_unsegmented_parameters_hold_whole_sdus_with_their_headers()
    // 30 octets every 10 ms in 10 ms: F = 1.0001, so two SDUs an interval for the 100 ppm allowance, in one PDU of 70.
    test.assert_eq(unseg_sdus(30, 10000, 10000), 2)
    test.assert_eq(unseg_per_pdu(30), 7)
    test.assert_eq(unseg_bn(30, 10000, 10000), 1)
    test.assert_eq(unseg_pdu(30, 10000, 10000), 70)
    // 100 octets every 10 ms in 20 ms: 2.0002 SDUs, so three of 105 octets, two in a PDU and two PDUs.
    test.assert_eq(unseg_sdus(100, 10000, 20000), 3)
    test.assert_eq(unseg_per_pdu(100), 2)
    test.assert_eq(unseg_bn(100, 10000, 20000), 2)
    // 200 octets every 10 ms in 20 ms: three SDUs, one a PDU.
    test.assert_eq(unseg_per_pdu(200), 1)
    test.assert_eq(unseg_bn(200, 10000, 20000), 3)
    test.assert_eq(unseg_pdu(200, 10000, 20000), 205)
    // An SDU that does not fit a PDU with its 5 octets, and a direction without data.
    test.assert_eq(unseg_per_pdu(247), 0)
    test.assert_eq(unseg_bn(247, 10000, 10000), 0)
    test.assert_eq(unseg_pdu(0, 10000, 10000), 0)
    test.assert_eq(unseg_bn(0, 10000, 10000), 0)

@test
fn test_an_unsegmented_group_is_derived_without_a_framing_delay()
    var p = t_plans()
    t_plan_set(var p, 0, 30, 30, 2, 2, 3)
    var g = group_plan_new()
    t_plan_mode(var g, 2)
    test.assert_eq(plan_cig(var p, 1, 10000, 10000, 20, 20, 0, ll_radio.profile_assumed(), var g), 0)
    test.assert_eq(g.iso_us, 10000)
    test.assert_eq(p[0].bn_c, unseg_bn(30, 10000, 10000))
    test.assert_eq(p[0].pdu_c, unseg_pdu(30, 10000, 10000))
    // The same bound fails with the framing delay of Segmentable mode.
    var q = t_plans()
    t_plan_set(var q, 0, 30, 30, 2, 2, 3)
    var h = group_plan_new()
    t_plan_mode(var h, 1)
    test.assert_eq(plan_cig(var q, 1, 10000, 10000, 20, 20, 0, ll_radio.profile_assumed(), var h), STATUS_INVALID_PARAMETERS)
    // An SDU over the 246 octets a PDU holds with its header.
    var r = t_plans()
    t_plan_set(var r, 0, 247, 247, 2, 2, 3)
    var k = group_plan_new()
    t_plan_mode(var k, 2)
    test.assert_eq(plan_cig(var r, 1, 10000, 10000, 40, 40, 0, ll_radio.profile_assumed(), var k), STATUS_UNSUPPORTED_FEATURE)

@test
fn test_an_unsegmented_sdu_is_one_whole_segment_and_several_share_a_pdu()
    if not ctl_limits.iso_on()
        return
    var x = t_unseg(true, 8, 5000, 12, 37, 1)
    t_set(x, "anchor", 10000)
    var d = t_sdu(3)
    test.assert(fsdu_put(var x, var d, 0, 12, 7000))
    test.assert(fsdu_put(var x, var d, 0, 12, 8000))
    test.assert_eq(x.tx_wr, 1)
    test.assert_eq(x.txl[0], 34)
    test.assert_eq(x.txf[0] >>> 8, 2)
    test.assert_eq(x.txd[0] as Int, 2)
    test.assert_eq(x.txd[1] as Int, 15)
    test.assert_eq(x.txd[17] as Int, 2)
    test.assert_eq(x.txd[19] as Int, 2000 & 0xFF)
    // 3 octets are left: a third SDU never starts there, it goes in the next payload whole.
    test.assert(fsdu_put(var x, var d, 0, 12, 9000))
    test.assert_eq(x.txl[0], 34)
    test.assert_eq(x.tx_wr, 2)
    test.assert_eq(x.txl[1], 17)
    // An SDU that does not fit a PDU is refused and changes nothing.
    var big = t_sdu(3)
    test.assert(not fsdu_put(var x, var big, 0, 33, 9000))
    test.assert_eq(x.tx_wr, 2)

@test
fn test_unsegmented_sdus_arrive_whole_and_in_order()
    if not ctl_limits.iso_on()
        return
    // 30-octet SDUs every 10 ms on a 10 ms ISO interval, two in a PDU of 70: no Time_Offset runs into a segment of a part.
    var c = t_unseg(true, 8, 10000, 30, 70, 1)
    var p = t_unseg(false, 8, 10000, 30, 70, 1)
    var sc = t_fr_stats()
    var sp = t_fr_stats()
    let credits = t_fr_run(var c, var p, 30, 100000, 30, 10000, 95000, 92000, 99, 0, var sc, var sp)
    test.assert(sp[1] >= 25)
    test.assert(sc[1] >= 25)
    test.assert_eq(sp[2] + sp[3] + sc[2] + sc[3], 0)
    test.assert(credits >= sp[1] - 2)

@test
fn test_unsegmented_sdus_at_half_the_iso_rate_arrive_whole()
    if not ctl_limits.iso_on()
        return
    // 130-octet SDUs every 10 ms on a 20 ms ISO interval, three payloads of 135 an event: two SDUs an event.
    var c = t_unseg(true, 16, 10000, 130, 135, 3)
    var p = t_unseg(false, 16, 10000, 130, 135, 3)
    var sc = t_fr_stats()
    var sp = t_fr_stats()
    let credits = t_fr_run(var c, var p, 20, 100000, 130, 10000, 90000, 85000, 99, 0, var sc, var sp)
    test.assert_eq(sp[2] + sp[3] + sc[2] + sc[3], 0)
    test.assert(sp[1] >= 25)
    test.assert(sc[1] >= 25)
    test.assert(credits >= sp[1] - 2)
    test.assert_eq(p.n_sdu_drop, 0)
    test.assert_eq(c.n_sdu_drop, 0)

@test
fn test_large_unsegmented_sdus_take_a_payload_each()
    if not ctl_limits.iso_on()
        return
    // 200-octet SDUs every 10 ms on a 20 ms interval: a PDU of 205 holds one, two payloads an event.
    var c = t_unseg(true, 16, 10000, 200, 205, 2)
    var p = t_unseg(false, 16, 10000, 200, 205, 2)
    var sc = t_fr_stats()
    var sp = t_fr_stats()
    let credits = t_fr_run(var c, var p, 20, 100000, 200, 10000, 90000, 85000, 99, 0, var sc, var sp)
    test.assert(sp[1] >= 15)
    test.assert(sc[1] >= 15)
    test.assert_eq(sp[2] + sp[3] + sc[2] + sc[3], 0)
    test.assert(credits >= sp[1] - 2)

@test
fn test_the_framing_mode_flag_is_bit_15_of_the_peripheral_sdu_size()
    var x = t_cis(true)
    t_set(x, "framed", 1)
    t_set(x, "unseg", 1)
    var p = ll_pdu.pdu_new()
    put_cis_req(var p, var x)
    test.assert_eq(ll_data.dpdu_byte(var p, 6) & 0x80, 0x80)
    test.assert_eq(ll_data.dpdu_byte(var p, 8) & 0x80, 0x80)
    var y = cis_new()
    get_cis_req(var p, var y)
    test.assert(y.framed)
    test.assert(y.unseg)
    test.assert_eq(y.max_sdu_p, 100)

@test
fn test_the_reference_of_an_sdu_follows_the_clock_of_its_sequence_and_not_the_jitter_of_its_arrival()
    var x = t_framed(true, 8, 10000, 30, 46, 1)
    // The first SDU is due when it arrives.
    test.assert_eq(fr_ref(var x, 1000000, 5), 1000000)
    // The second arrives 3 ms late: its reference is an SDU interval after the first, give or take the thirty-second of the lateness that
    // the clock follows.
    let r2 = fr_ref(var x, 1013000, 6)
    test.assert(r2 >= 1010000 and r2 <= 1010100)
    // The third arrives early (7 ms after the second): the clock was late, and the SDU is due when it arrived.
    test.assert_eq(fr_ref(var x, 1020000 - 1000, 7), 1019000)
    // The next arrives on time to the new clock.
    test.assert_eq(fr_ref(var x, 1029000, 8), 1029000)
    // A gap in the sequence (three numbers) is three intervals on the clock, whenever the packet arrives.
    let r5 = fr_ref(var x, 1062000, 11)
    test.assert(r5 >= 1059000 and r5 <= 1059200)

@test
fn test_a_sequence_that_does_not_run_or_a_reference_far_behind_starts_the_clock_again_at_the_arrival()
    var x = t_framed(true, 8, 10000, 30, 46, 1)
    test.assert_eq(fr_ref(var x, 1000000, 5), 1000000)
    // The same number again: no sequence to count by.
    test.assert_eq(fr_ref(var x, 1010400, 5), 1010400)
    // A jump of over 255.
    test.assert_eq(fr_ref(var x, 1020400, 400), 1020400)
    // An arrival 40 ms after the reference the clock gives (the Host stopped and went on with the next number): the clock starts again.
    test.assert_eq(fr_ref(var x, 1070400, 401), 1070400)

@test
fn test_a_stream_that_is_reset_forgets_the_clock_of_its_sequence()
    var x = t_framed(true, 8, 10000, 30, 46, 1)
    test.assert_eq(fr_ref(var x, 1000000, 5), 1000000)
    cis_reset_run(var x, S_CONFIG)
    test.assert(not x.rs_ok)
    test.assert_eq(fr_ref(var x, 2000000, 99), 2000000)

// The structure of the framed payloads in the ring of `x` (the numbers `tx_num` to `tx_wr - 1`): every payload is LLID 2; its
// segments tile it exactly (the octets of each header and its Length add up to the payload's length); a segment with SC 0 has at
// least the Time_Offset; a segment with SC 1 follows one with CMPLT 0 (the one before it in the stream of segments) and a
// segment with SC 0 follows one with CMPLT 1; the octets of an SDU are as many as Max_SDU allows.  Answers the number of faults.
fn t_fr_faults(var x: Cis, var open_cmplt: Vec[Int; 1]) -> Int
    var faults = 0
    var open = open_cmplt[0] - 1
    for num in x.tx_num..x.tx_wr
        let sl = slot_of(num)
        let n = x.txl[sl]
        if (x.txf[sl] & 3) != 2
            faults = faults + 1
        var i = 0
        for _ in 0..64
            if i >= n
                break
            if i + 2 > n
                faults = faults + 1
                break
            let h = x.txd[sl * SLOT_OCTETS + i] as Int
            let l = x.txd[sl * SLOT_OCTETS + i + 1] as Int
            if i + 2 + l > n or l == 0
                faults = faults + 1
                break
            let sc = h & 1
            let cm = (h >>> 1) & 1
            if sc == 0
                if l < 3 or open == 1
                    faults = faults + 1
            else if open == 0
                faults = faults + 1
            open = 1 - cm
            i = i + 2 + l
        if i != n
            faults = faults + 1
    faults

fn t_fr_check_all(var x: Cis, len: Int, sdu_int: Int, phase: Int, events: Int, first: Int) -> Int
    var faults = 0
    var shut: Vec[Int; 1] = Vec.new()
    let _s = shut.push(0)
    var d = t_sdu(0)
    var k = 0
    for e in 0..events
        t_set(x, "anchor", first + e * iso_us(x))
        t_set(x, "ev", e)
        for _ in 0..4
            let at = phase + k * sdu_int
            if at > first + e * iso_us(x) - 50
                break
            t_fr_sdu(var d, k, len)
            if fsdu_put(var x, var d, 0, len, at)
                k = k + 1
            else
                break
        shut[0] = 0
        faults = faults + t_fr_faults(var x, var shut)
        event_begin(var x)
        // The whole ring is acknowledged at the end of the event: the payloads are done with.
        for _ in 0..PAYLOAD_SLOTS
            if x.tx_num < x.tx_wr and x.tx_num < (e + 1) * tx_bn(var x)
                tx_retire(var x, false)
    faults

@test
fn test_every_framed_payload_is_well_formed_for_sdus_that_just_do_not_fit_a_payload()
    if not ctl_limits.iso_on()
        return
    // 60 octets every 8 ms, 7.5 ms ISO interval, PDUs of 64: an SDU needs 65, so it runs one octet over a payload.
    var x = t_framed(true, 6, 8000, 60, 64, 1)
    test.assert_eq(t_fr_check_all(var x, 60, 8000, 95000, 120, 100000), 0)
    // The same in 10 ms with a flush timeout of 2 and a stream of two payloads an event.
    var y = t_framed(true, 8, 10000, 100, 72, 2)
    test.assert_eq(t_fr_check_all(var y, 100, 10000, 95000, 120, 100000), 0)

@test
fn test_an_sdu_a_little_over_a_payload_does_not_leave_a_continuation_of_one_or_two_octets()
    if not ctl_limits.iso_on()
        return
    // 60 octets need 65 with the header and the Time_Offset; a payload of 64 would leave 1 for the next payload.  The first segment
    // gives up octets so that the continuation has FR_TAIL_MIN of them.
    test.assert_eq(fr_take(59, 60), 60 - FR_TAIL_MIN)
    test.assert_eq(fr_take(60, 61), 61 - FR_TAIL_MIN)
    test.assert_eq(fr_take(59, 65), 59)
    test.assert_eq(fr_take(59, 59), 59)
    test.assert_eq(fr_take(3, 6), 1)
    test.assert_eq(fr_take(3, 5), 0)
    var x = t_framed(true, 6, 8000, 60, 64, 1)
    t_set(x, "anchor", 100000)
    var d = t_sdu(0)
    test.assert(fsdu_put(var x, var d, 0, 60, 99000))
    test.assert_eq(x.tx_wr, 2)
    test.assert_eq(x.txl[0], 60)
    // A start segment of 55 octets (3 of Time_Offset), then a continuation of 5.
    test.assert_eq(x.txd[1] as Int, 55 + 3)
    test.assert_eq(x.txd[257] as Int, 5)
    test.assert_eq(x.txl[1], 7)
    // The next SDU starts behind the continuation, in the same payload, and is not cut again.
    test.assert(fsdu_put(var x, var d, 0, 60, 107000))
    test.assert_eq(x.txd[256 + 7 + 1] as Int, 64 - 7 - 2)

// A framed payload `num` of segments given as (sc, cmplt, length of the data) put together in `p`; the data of every segment is the
// octet `fill` + its index in the SDU, the Time_Offset of a start segment 1000.
fn t_fr_pdu(var p: Pdu, segs: [Int], fill: Int)
    var i = 2
    p.b[0] = 2
    for t in 0..(list.len(segs) / 3)
        let sc = segs[3 * t]
        let cm = segs[3 * t + 1]
        let n = segs[3 * t + 2]
        var len = n
        if sc == 0
            len = n + 3
        p.b[i] = (sc | (cm << 1)) as u8
        p.b[i + 1] = len as u8
        i = i + 2
        if sc == 0
            p.b[i] = 232 as u8
            p.b[i + 1] = 3 as u8
            p.b[i + 2] = 0 as u8
            i = i + 3
        for j in 0..n
            p.b[i + j] = ((fill + j) & 0xFF) as u8
        i = i + n
    p.b[1] = (i - 2) as u8
    p.n = i

@test
fn test_a_receiver_reads_a_continuation_of_one_octet_and_the_start_behind_it()
    if not ctl_limits.iso_on()
        return
    var x = t_framed(true, 6, 8000, 60, 64, 1)
    t_set(x, "anchor", 100000)
    t_set(x, "rx_num", 0)
    var p = ll_pdu.pdu_new()
    // The cut a peer makes at 64 octets: 59 octets of an SDU of 60 in the first payload, the 60th behind a header in the second, and
    // behind that the start of the next SDU, whose last 4 octets are the continuation of the third.
    t_fr_pdu(var p, [0, 0, 59], 10)
    rx_note(var x, 0, true, var p)
    t_fr_pdu(var p, [1, 1, 1, 0, 0, 56], 70)
    rx_note(var x, 1, true, var p)
    t_fr_pdu(var p, [1, 1, 4, 0, 0, 53], 120)
    rx_note(var x, 2, true, var p)
    test.assert_eq(x.out_n, 2)
    test.assert_eq(x.outs[x.out_head], SDU_VALID)
    test.assert_eq(x.outl[x.out_head], 60)
    test.assert_eq(x.outq[x.out_head], 0)
    test.assert_eq(x.outd[x.out_head * OUT_OCTETS] as Int, 10)
    test.assert_eq(x.outd[x.out_head * OUT_OCTETS + 58] as Int, 68)
    test.assert_eq(x.outd[x.out_head * OUT_OCTETS + 59] as Int, 70)
    let second = (x.out_head + 1) % OUT_SLOTS
    test.assert_eq(x.outs[second], SDU_VALID)
    test.assert_eq(x.outl[second], 60)
    test.assert_eq(x.outd[second * OUT_OCTETS] as Int, 70)
    test.assert_eq(x.outd[second * OUT_OCTETS + 55] as Int, 125)
    test.assert_eq(x.outd[second * OUT_OCTETS + 56] as Int, 120)
