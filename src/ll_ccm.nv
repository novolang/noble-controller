// src/ll_ccm.nv — AES-CCM of the Link Layer in software: the
// `SoftCipher` backend of `ll_cipher.nv`.
//
// [Vol 6] Part E, Section 2.  A Data Physical Channel PDU is protected with CCM,
// a 4-octet MIC, a 2-octet length field and one octet of additional
// authenticated data: the first octet of the header with NESN, SN and MD
// cleared.  The nonce is the 39-bit packetCounter and the directionBit in five
// octets and the 8 octets of the IV.  An empty PDU (no payload) is neither
// encrypted nor authenticated.
//
// The authentication runs CBC-MAC over B0 (flags, nonce, payload length), B1
// (additional data length and the data) and the payload in blocks of 16; the
// payload and the MIC are encrypted by counter mode, block A0 for the MIC and
// A1 onward for the payload.  Every block is one AES encryption, so a PDU of 27
// octets takes 2 + 2 + 2 + 1 = 7 and the key expansion.
//
// The scratch the work needs is in the backend, so a call allocates nothing.

use ll_pdu
use ll_cipher
use ll_aes

// The additional data mask of the header octet: NESN, SN and MD are bits 2 to 4 of a data channel PDU; a
// Connected Isochronous PDU masks NESN, SN, CIE (bit 4) and NPI (bit 6) (`ll_cipher.DIR_CIS`).
const HEADER_MASK = 0xE3
const HEADER_MASK_CIS = 0xA3
const HEADER_MASK_BIS = 0xC3

@value
struct SoftCipher
    k: AesKey
    nonce: Vec[u8; 13]
    x: Vec[u8; 16]
    s: Vec[u8; 16]
    mic: Vec[u8; 4]
    blocks: Int
    hmask: Int

// A software cipher with its buffers zeroed and no key loaded; the Link Layer loads the session key and the nonce for each PDU.
pub @no_alloc
@tier(embedded)
fn soft_cipher_new() -> SoftCipher
    var c = SoftCipher { k: ll_aes.aes_key_new(),
        nonce: Vec.new(),
        x: Vec.new(),
        s: Vec.new(),
        mic: Vec.new(),
        blocks: 0,
        hmask: HEADER_MASK }
    for _ in 0..13
        let _a = c.nonce.push(0)
    for _ in 0..16
        let _b = c.x.push(0)
        let _c = c.s.push(0)
    for _ in 0..4
        let _d = c.mic.push(0)
    c

// Load the session key and the nonce of a PDU.  The cipher takes the key most
// significant octet first, and `sk` is held least significant first.
@no_alloc
@tier(embedded)
fn set_up(var c: SoftCipher, var ek: EncKey, ctr: Int, dir: Int)
    for i in 0..16
        c.x[i] = ek.sk[15 - i]
    ll_aes.aes_set_key(var c.k, var c.x)
    for i in 0..4
        c.nonce[i] = ((ctr >>> (8 * i)) & 0xFF) as u8
    c.nonce[4] = (((ctr >>> 32) & 0x7F) | ((dir & 1) << 7)) as u8
    if (dir & ll_cipher.DIR_BIS) != 0
        c.hmask = HEADER_MASK_BIS
    else if (dir & ll_cipher.DIR_CIS) != 0
        c.hmask = HEADER_MASK_CIS
    else
        c.hmask = HEADER_MASK
    for i in 0..8
        c.nonce[5 + i] = ek.iv[i]

// One block encryption of `x`.
@no_alloc
@tier(embedded)
fn encrypt_x(var c: SoftCipher)
    c.blocks = c.blocks + 1
    ll_aes.aes_encrypt(var c.k, var c.x)

// Block A of counter `i`, in `s`, encrypted: the keystream.
@no_alloc
@tier(embedded)
fn keystream(var c: SoftCipher, i: Int)
    c.s[0] = 1
    for k in 0..13
        c.s[1 + k] = c.nonce[k]
    c.s[14] = ((i >>> 8) & 0xFF) as u8
    c.s[15] = (i & 0xFF) as u8
    c.blocks = c.blocks + 1
    ll_aes.aes_encrypt(var c.k, var c.s)

// The CBC-MAC of the PDU whose payload is at `p.b[2..2 + n]` in the clear and
// whose header octet is `hdr`, left in `x`.
@no_alloc
@tier(embedded)
fn authenticate(var c: SoftCipher, hdr: Int, var p: Pdu, n: Int)
    c.x[0] = 0x49
    for k in 0..13
        c.x[1 + k] = c.nonce[k]
    c.x[14] = 0
    c.x[15] = n as u8
    encrypt_x(var c)
    // B1: the length of the additional data and the data.
    c.x[1] = c.x[1] ^ 1
    c.x[2] = c.x[2] ^ (hdr & c.hmask) as u8
    encrypt_x(var c)
    var at = 0
    while at < n
        var m = n - at
        if m > 16
            m = 16
        for k in 0..m
            c.x[k] = c.x[k] ^ p.b[2 + at + k]
        encrypt_x(var c)
        at = at + 16

// Counter mode over the `n` octets at `p.b[2..]`: the same operation encrypts
// and decrypts.
@no_alloc
@tier(embedded)
fn counter_mode(var c: SoftCipher, var p: Pdu, n: Int)
    var at = 0
    var i = 1
    while at < n
        keystream(var c, i)
        var m = n - at
        if m > 16
            m = 16
        for k in 0..m
            p.b[2 + at + k] = p.b[2 + at + k] ^ c.s[k]
        at = at + 16
        i = i + 1

impl Cipher[] for SoftCipher
    fn seal(var self, var ek: EncKey, ctr: Int, dir: Int, var p: Pdu)
        let n = p.b[1] as Int
        if n == 0
            return
        set_up(var self, var ek, ctr, dir)
        let hdr = p.b[0] as Int
        authenticate(var self, hdr, var p, n)
        for k in 0..4
            self.mic[k] = self.x[k]
        counter_mode(var self, var p, n)
        keystream(var self, 0)
        for k in 0..4
            p.b[2 + n + k] = self.mic[k] ^ self.s[k]
        p.b[1] = (n + 4) as u8
        p.n = n + 6

    fn open(var self, var ek: EncKey, ctr: Int, dir: Int, var p: Pdu) -> Bool
        let m = p.b[1] as Int
        if m == 0
            return true
        if m < 5
            return false
        let n = m - 4
        set_up(var self, var ek, ctr, dir)
        counter_mode(var self, var p, n)
        let hdr = p.b[0] as Int
        authenticate(var self, hdr, var p, n)
        keystream(var self, 0)
        var diff = 0
        for k in 0..4
            diff = diff | (self.x[k] ^ self.s[k] ^ p.b[2 + n + k]) as Int
        p.b[1] = n as u8
        p.n = n + 2
        diff == 0

    fn block(var self, var key: Vec[u8; 16], var blk: Vec[u8; 16]) -> Bool
        ll_aes.aes_set_key(var self.k, var key)
        ll_aes.aes_encrypt(var self.k, var blk)
        true

    fn faults(var self) -> Int
        0
