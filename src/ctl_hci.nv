// A table of an absent feature keeps one record: a `Vec` holds at least one element.
const fn max1(n: Int) -> Int
    if n > 1
        n
    else
        1

// The functions below take the Controller as a `var` parameter even where they only read
// it, which passes its address.  A plain parameter is a copy, and a copy of a
// struct of this size on every call costs time and stack.

