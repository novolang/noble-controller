        0x2062 => 41 * 8 + 7
        0x2063 => 42 * 8 + 0
        0x2064 => 42 * 8 + 1
        0x2065 => 42 * 8 + 2
        0x2066 => 42 * 8 + 3
        0x2067 => 42 * 8 + 4
        0x2068 => 42 * 8 + 5
        0x2069 => 42 * 8 + 6
        0x206a => 42 * 8 + 7
        0x206b => 43 * 8 + 0
        0x206c => 43 * 8 + 1
        0x206e => 43 * 8 + 3
        0x206f => 43 * 8 + 4
        0x2074 => 44 * 8 + 1
