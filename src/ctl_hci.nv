        0x2060 => CAP_LL
        0x2061 => CAP_LL
        0x2062 => CAP_LL
        0x2063 => CAP_LL
        0x2064 => CAP_LL
        0x2065 => CAP_LL
        0x2066 => CAP_LL
        0x2067 => CAP_LL
        0x2068 => CAP_LL
        0x2069 => CAP_LL
        0x206a => CAP_LL
        0x206b => CAP_LL
        0x206c => CAP_LL
        0x206e => CAP_LL
        0x206f => CAP_LL
        0x2070 => CAP_LL
        0x2071 => CAP_LL
        0x2072 => CAP_LL
        0x2073 => CAP_LL
        0x2074 => CAP_LL
        0x2075 => CAP_LL
        _      => 0

// Whether the command with `opcode` is one of extended advertising, which a build with no advertising sets does not answer.
@tier(embedded)
fn xadv_command(opcode: Int) -> Bool
    opcode >= 0x2035 and opcode <= 0x203D or opcode == 0x207F

// Whether `opcode` is a command of periodic advertising or synchronization, which a build with no train and no
// synchronization does not answer.
@tier(embedded)
fn per_command(opcode: Int) -> Bool
    opcode >= 0x203E and opcode <= 0x2040 or opcode >= 0x2044 and opcode <= 0x204A or opcode == 0x2059 or opcode == 0x2086

// The tables of the three commands of periodic advertising with responses, which a build without either side of it does not carry: the bit in
// Supported Commands (-1 for none), the capabilities (0 for none) and the number of parameter octets (-2 when the length is the command's to check, -1 for none).
@tier(embedded)
fn pawr_bit(opcode: Int) -> Int
    if not ctl_limits.pawr_adv_on() and not ctl_limits.pawr_sync_on()
        return -1
    match opcode
        0x2082 => 46 * 8 + 5
        0x2083 => 46 * 8 + 6
        0x2084 => 46 * 8 + 7
        _      => -1

@tier(embedded)
fn pawr_needs(opcode: Int) -> Int
    if not ctl_limits.pawr_adv_on() and not ctl_limits.pawr_sync_on()
        return 0
    if opcode >= 0x2082 and opcode <= 0x2084
        return CAP_LL
    0

@tier(embedded)
fn pawr_params(opcode: Int) -> Int
    if not ctl_limits.pawr_adv_on() and not ctl_limits.pawr_sync_on()
        return -1
    match opcode
        0x2082 => -2
        0x2083 => 8
        0x2084 => 5
        _      => -1

// The same for the four commands of the ISO test mode (LE ISO Transmit Test 0x2070, Receive Test 0x2071, Read Test Counters 0x2072 and Test End 0x2073), which a
// build without broadcast groups does not carry.
@tier(embedded)
fn isotest_bit(opcode: Int) -> Int
    match opcode
        0x2070 => 43 * 8 + 5
        0x2071 => 43 * 8 + 6
        0x2072 => 43 * 8 + 7
        0x2073 => 44 * 8 + 0
        _      => -1

@tier(embedded)
fn isotest_params(opcode: Int) -> Int
    match opcode
        0x2070 => 3
        0x2071 => 3
        0x2072 => 2
        0x2073 => 2
        _      => -1

// The tables above with the commands of periodic advertising with responses, in a build that has either side of it, and the ISO test mode in one that has broadcast groups.
@tier(embedded)
fn command_bit(opcode: Int) -> Int
    if ctl_limits.sca_on() and opcode == OP_LE_REQUEST_PEER_SCA
        return 43 * 8 + 2
    if ctl_limits.ploss_on() and ploss_command(opcode)
        return 44 * 8 + (opcode - 0x2078) + 5
    if cs_command_on(opcode)
        return ll_cs.command_bit(opcode)
    if ctl_limits.rate_on()
        let r = rate_bit(opcode)
        if r >= 0
            return r
    if ctl_limits.fs_on() and fs_command(opcode)
        return 48 * 8 + 1
    if ctl_limits.pawr_adv_on() or ctl_limits.pawr_sync_on()
        let b = pawr_bit(opcode)
        if b >= 0
            return b
    if ctl_limits.big_on()
        let t = isotest_bit(opcode)
        if t >= 0
            return t
    command_bit_base(opcode)

@tier(embedded)
fn command_needs(opcode: Int) -> Int
    if ctl_limits.sca_on() and opcode == OP_LE_REQUEST_PEER_SCA
        return CAP_LL
    if ctl_limits.ploss_on() and ploss_command(opcode)
        return CAP_LL
    if cs_command_on(opcode)
        return CAP_LL
    if ctl_limits.rate_on() and rate_command(opcode)
        return CAP_LL
    if ctl_limits.fs_on() and fs_command(opcode)
        return CAP_LL
    if ctl_limits.pawr_adv_on() or ctl_limits.pawr_sync_on()
        let n = pawr_needs(opcode)
        if n != 0
            return n
    command_needs_base(opcode)

@tier(embedded)
fn command_params(opcode: Int) -> Int
    if ctl_limits.sca_on() and opcode == OP_LE_REQUEST_PEER_SCA
        return 2
    if ctl_limits.ploss_on() and ploss_command(opcode)
        return if opcode == OP_LE_SET_PATH_LOSS_REPORTING_PARAMETERS then 8 else 3
    if cs_command_on(opcode)
        return ll_cs.command_params(opcode)
    if ctl_limits.rate_on()
        let r = rate_params(opcode)
        if r != -1
            return r
    if ctl_limits.fs_on() and fs_command(opcode)
        return 9
    if ctl_limits.pawr_adv_on() or ctl_limits.pawr_sync_on()
        let w = pawr_params(opcode)
        if w != -1
            return w
    if ctl_limits.big_on()
        let t = isotest_params(opcode)
        if t != -1
            return t
    command_params_base(opcode)

// Whether `opcode` is a command of Periodic Advertising Sync Transfer, which a build without the feature does not answer.
@tier(embedded)
fn past_command(opcode: Int) -> Bool
    opcode >= 0x205A and opcode <= 0x205D

// Whether `opcode` is a command of LE Power Control: the two reads (0x2076, 0x2077) and the reporting switch (0x207A).
@tier(embedded)
fn pcl_command(opcode: Int) -> Bool
    opcode == 0x2076 or opcode == 0x2077 or opcode == 0x207A

// Whether `opcode` is a command of path loss monitoring: the parameters (0x2078) and the switch (0x2079).  Their bits in Supported Commands are
// octet 44 bits 5 and 6.
@tier(embedded)
fn ploss_command(opcode: Int) -> Bool
    opcode == 0x2078 or opcode == 0x2079

// Whether this build answers the Channel Sounding command with `opcode`: the build has the feature, and the option the command belongs to
// (Enhancement #1 and the security requirements, the test commands) when it has one.  The tables of those commands are in `ll_cs`.
@tier(embedded)
fn cs_command_on(opcode: Int) -> Bool
    ctl_limits.cs_on() and ll_cs.command_answered(opcode, ctl_limits.cs_ipt_on(), ctl_limits.cs_test_on())

// Whether `opcode` is a command of Connection Subrating: the default (0x207D) and the request (0x207E).
@tier(embedded)
fn sub_command(opcode: Int) -> Bool
    opcode == 0x207D or opcode == 0x207E

// Whether `opcode` is a command of Connection Rate: LE Set Host Feature [v2] (0x2097), LE Connection Rate Request (0x20A1), LE Set Default Rate
// Parameters (0x20A2) and LE Read Minimum Supported Connection Interval (0x20A3).
@tier(embedded)
fn rate_command(opcode: Int) -> Bool
    opcode == 0x2097 or opcode >= 0x20A1 and opcode <= 0x20A3

// The tables of those four commands, which a build without Connection Rate does not carry: the bit in Supported Commands (-1 for none) and the
// number of parameter octets (-1 for none).
@tier(embedded)
fn rate_bit(opcode: Int) -> Int
    match opcode
        0x2097 => 47 * 8 + 4
        0x20a1 => 48 * 8 + 5
        0x20a2 => 48 * 8 + 6
        0x20a3 => 48 * 8 + 7
        _      => -1

@tier(embedded)
fn rate_params(opcode: Int) -> Int
    match opcode
        0x2097 => 3
        0x20a1 => 20
        0x20a2 => 18
        0x20a3 => 0
        _      => -1

// Whether `opcode` is LE Frame Space Update (0x209D), which has bit 1 of octet 48 in Supported Commands and nine parameter octets.
@tier(embedded)
fn fs_command(opcode: Int) -> Bool
    opcode == 0x209D

// Whether `opcode` is a command of the Feature Page Exchange: LE Read All Local Supported Features (0x2087) and LE Read All Remote Features (0x2088).
@tier(embedded)
fn feat_command(opcode: Int) -> Bool
    opcode == 0x2087 or opcode == 0x2088

// Whether `opcode` is a command of periodic advertising with responses: the advertiser's (0x2082) and the synchronizer's (0x2083, 0x2084).
@tier(embedded)
fn pawr_command(opcode: Int) -> Bool
    opcode >= 0x2082 and opcode <= 0x2084

// Whether this build answers the command with `opcode`.
@tier(embedded)
fn command_answered(var c: Controller, opcode: Int) -> Bool
    if opcode == OP_READ_LOCAL_SUPPORTED_COMMANDS
        return true
    if command_bit(opcode) < 0
        return false
    // LE Set Host Feature [v1] lies in the range of the isochronous commands and is also the Host's way to set bit 47 (Channel Sounding, Host Support).
    if iso_command(opcode) and not ctl_limits.iso_on() and not (opcode == OP_LE_SET_HOST_FEATURE and ctl_limits.cs_on())
        return false
    if (big_command(opcode) or isotest_command(opcode)) and not ctl_limits.big_on()
        return false
    if xadv_command(opcode) and not ctl_limits.xadv_on()
        return false
    if per_command(opcode) and (not ctl_limits.per_on() or not ctl_limits.xadv_on())
        return false
    if past_command(opcode) and (not ctl_limits.past_on() or not ctl_limits.per_on() or not ctl_limits.xadv_on())
        return false
    if pcl_command(opcode) and not ctl_limits.pcl_on()
        return false
    if sub_command(opcode) and not ctl_limits.sub_on()
        return false
    if feat_command(opcode) and not ctl_limits.feat_on()
        return false
    if (ctl_limits.pawr_adv_on() or ctl_limits.pawr_sync_on()) and pawr_command(opcode)
        if not ctl_limits.per_on() or not ctl_limits.xadv_on()
            return false
        if opcode == OP_LE_SET_PERIODIC_ADVERTISING_SUBEVENT_DATA and not ctl_limits.pawr_adv_on()
            return false
        if opcode != OP_LE_SET_PERIODIC_ADVERTISING_SUBEVENT_DATA and not ctl_limits.pawr_sync_on()
            return false
    let need = command_needs(opcode)
    need == 0 or (c.caps as Int & need) != 0

// Set, in the 64 octets of Supported_Commands that start at index `base` of
// `slot`, a bit for each command this build answers.  The field is built from
// the opcodes of the five command groups the Controller answers (Link Control,
// the Controller and Baseband commands, the Informational Parameters, the Status
// Parameters and the LE Controller commands), the command field up to 0xFF, so it cannot list a
// command `command_bit` does not.
@satisfies("REQ-BLE-HCI-007")
@tier(embedded)
fn supported_commands_fill(var c: Controller, var p: PacketPool, slot: Int, base: Int)
    for group in 0..5
        let ogf = if group == 0
            0x01
        else
            if group == 1
                0x03
            else
                if group == 2
                    0x04
                else
                    if group == 3
                        0x05
                    else
                        0x08
        for ocf in 0..0x100
            let opcode = hci_frame.pack_opcode(ogf, ocf)
            let bit = command_bit(opcode)
            if bit >= 0 and command_answered(var c, opcode)
                let at = base + bit / 8
                ctl_pool.pool_patch(var p, slot, at, ctl_pool.pool_get(var p, slot, at) | (1 << (bit % 8)))

// The number of parameter octets the command with `opcode` takes, -1 for a
// command the Controller does not answer.
@tier(embedded)
fn command_params_base(opcode: Int) -> Int
    match opcode
        0x406  => 3
        0x41d  => 2
        0xc01  => 8
        0xc03  => 0
        0xc2d  => 3
        0xc31  => 1
        0xc33  => 7
        0xc35  => -2
        0xc63  => 8
        0xc7b  => 2
        0xc7c  => 4
        0x1001 => 0
        0x1002 => 0
        0x1003 => 0
        0x1009 => 0
        0x1405 => 2
        0x2001 => 8
        0x2002 => 0
        0x2003 => 0
        0x2005 => 6
        0x2006 => 15
        0x2007 => 0
        0x2008 => 32
        0x2009 => 32
        0x200a => 1
        0x200b => 7
        0x200c => 2
        0x200d => 25
        0x200e => 0
        0x200f => 0
        0x2010 => 0
        0x2011 => 7
        0x2012 => 7
        0x2013 => 14
        0x2014 => 5
        0x2015 => 2
        0x2016 => 2
        0x2017 => 32
        0x2018 => 0
        0x2019 => 28
        0x201a => 18
        0x201b => 2
        0x201c => 0
        0x2025 => 0
        0x2026 => 64
        0x205e => 65
        0x2027 => 39
        0x2028 => 7
        0x2029 => 0
        0x202a => 0
        0x202b => 7
        0x202c => 7
        0x202d => 1
        0x202e => 2
        0x204e => 8
        0x2020 => 14
        0x2021 => 3
        0x204b => 0
        0x207f => 27
        0x2035 => 7
        0x2036 => 25
        0x2037 => 4
        0x2038 => 4
        0x2039 => 2
        0x203a => 0
        0x203b => 0
        0x203c => 1
        0x203d => 0
        0x203e => 7
        0x203f => 3
        0x2040 => 2
        0x2044 => 14
        0x2045 => 0
        0x2046 => 2
        0x2047 => 8
        0x2048 => 8
        0x2049 => 0
        0x204a => 0
        0x2059 => 3
        0x205a => 6
        0x205b => 5
        0x205c => 8
        0x205d => 6
        0x2076 => 3
        0x2077 => 3
        0x207d => 10
        0x207e => 12
        0x2087 => 0
        0x2088 => 3
        0x207a => 4
        0x2086 => 12
        0x2041 => 3
        0x2042 => 6
        0x2043 => 10
        0x2085 => 12
        0x201d => 1
        0x201e => 3
        0x201f => 0
        0x2033 => 3
        0x2034 => 4
        0x204f => 7
        0x2050 => 7
        0x207b => 8
        0x2022 => 6
        0x2023 => 0
        0x2024 => 4
        0x202f => 0
        0x2030 => 2
        0x2031 => 3
        0x2032 => 7
        0x2060 => 0
        0x2061 => 2
        0x2062 => -2
        0x2063 => -2
        0x2064 => -2
        0x2065 => 1
        0x2066 => 2
        0x2067 => 3
        0x2068 => 31
        0x2069 => 36
        0x206a => 2
        0x206b => -2
        0x206c => 1
        0x206e => -2
        0x206f => 3
        0x2074 => 2
        0x2075 => 2
        _      => -1

// ── Events the Controller builds ────────────────────────────────────

// Start the Command Complete event for `opcode` in a free slot: the
// packet indicator, the event code, the length, Num_HCI_Command_Packets of
// 1, the opcode and `status`.  The return parameters that follow `status`
// are appended with `ctl_pool.pool_put`, and `complete_send` ends it.
// `NO_SLOT` when no slot is free.
@satisfies("REQ-BLE-HCI-003")
@tier(embedded)
fn complete_begin(var c: Controller, opcode: Int, status: Int) -> Int
    let slot = ctl_pool.evt_begin(var c.pool, hci_frame.EVT_COMMAND_COMPLETE)
    if slot == ctl_pool.NO_SLOT
        return slot
    let _a = ctl_pool.pool_put(var c.pool, slot, 1)
    let _b = ctl_pool.pool_put_u16(var c.pool, slot, opcode)
    let _c = ctl_pool.pool_put(var c.pool, slot, status)
    slot

// Queue the event in `slot`.
@tier(embedded)
fn complete_send(var c: Controller, slot: Int)
    if ctl_pool.evt_send(var c.pool, slot)
        c.answered = c.answered + 1

// Answer `opcode` with a Command Complete event that carries `status`
// alone.
@tier(embedded)
fn answer_status(var c: Controller, opcode: Int, status: Int)
    let slot = complete_begin(var c, opcode, status)
    if slot != ctl_pool.NO_SLOT
        complete_send(var c, slot)

// Queue the Hardware Error event with `code`.  False when no slot is free.
@satisfies("REQ-BLE-CTL-002")
@tier(embedded)
fn hardware_error(var c: Controller, code: Int) -> Bool
    let slot = ctl_pool.evt_begin(var c.pool, hci_frame.EVT_HARDWARE_ERROR)
    if slot == ctl_pool.NO_SLOT
        return false
    let _a = ctl_pool.pool_put(var c.pool, slot, code)
    let _b = ctl_pool.evt_send(var c.pool, slot)
    c.hw_errors = c.hw_errors + 1
    true

// ── The commands ────────────────────────────────────────────────────

// The Feature mask octets of Read Local Supported Features: bit 37 (BR/EDR
// Not Supported) and bit 38 (LE Supported (Controller)) of the LMP
// features, the two a Controller of LE alone sets.
@tier(embedded)
fn lmp_feature_octet(i: Int) -> Int
    if i == 4
        0x60
    else
        0

// Fill `slot` with `n` zero octets.
@tier(embedded)
fn put_zeros(var c: Controller, slot: Int, n: Int)
    for _ in 0..n
        let _a = ctl_pool.pool_put(var c.pool, slot, 0)

@satisfies("REQ-BLE-HCI-004")
@tier(embedded)
fn cmd_reset(var c: Controller)
    reset_parameters(var c)
    c.resets = c.resets + 1
    answer_status(var c, OP_RESET, STATUS_SUCCESS)

@satisfies("REQ-BLE-HCI-009")
@tier(embedded)
fn cmd_set_event_mask(var c: Controller)
    c.mask_low = param_u32(var c, 0)
    c.mask_high = param_u32(var c, 4)
    answer_status(var c, OP_SET_EVENT_MASK, STATUS_SUCCESS)

// ── Flow control toward the Host ────────────────────────────────────
//
// The Host tells the Controller what it can take, and the Controller works
// with whatever it says, or with nothing: a Host that sends none of the three
// commands is sent ACL Data packets as the Link Layer delivers them, with the
// port's back-pressure (`HostTx.ready`) the only brake.  A Host that sends
// Host Buffer Size gets ACL Data packets with at most that many octets of
// data (a longer one goes out in pieces, the later ones continuing the first),
// and one that also turns flow control on is sent no more packets than it has
// buffers: a packet waits in the pool, with the events passing it, until
// Host Number Of Completed Packets returns a buffer, and the pool's own limit
// then holds the Link Layer back (`ll_link.link_set_room`).  The Controller
// reads no configuration of the Host: the sizes are the ones on the wire.
// Reset forgets them. ([Vol 4] Part E, Sections 4.1.1, 7.3.38 to 7.3.40.)

// Set Controller To Host Flow Control ([Vol 4] Part E, Section 7.3.38):
// Flow_Control_Enable 0x00 off, 0x01 ACL on, 0x02 synchronous on, 0x03 both.
// This Controller has no synchronous data, so 0x02 leaves ACL off.  Turning
// ACL on needs no Host Buffer Size first: until it arrives the Host's buffers
// count as unlimited (Section 4.2).  A change of the value while a connection
// exists is Command Disallowed (Section 7.3.38).
@satisfies("REQ-BLE-HCI-059")
@tier(embedded)
fn cmd_set_controller_to_host_flow_control(var c: Controller)
    let enable = h4_rx.h4_param(var c.rx, 0)
    var status = STATUS_SUCCESS
    if enable > 3
        status = STATUS_INVALID_PARAMETERS
    else if links_live(var c) and ((enable & 1) == 1) != ctl_pool.pool_host_flow_on(var c.pool)
        status = STATUS_COMMAND_DISALLOWED
    if status == STATUS_SUCCESS
        ctl_pool.pool_host_flow(var c.pool, (enable & 1) == 1)
    answer_status(var c, OP_SET_CONTROLLER_TO_HOST_FLOW_CONTROL, status)

// Host Buffer Size ([Vol 4] Part E, Section 7.3.39): Host_ACL_Data_Packet_Length
// (2), Host_Synchronous_Data_Packet_Length (1), Host_Total_Num_ACL_Data_Packets
// (2) and Host_Total_Num_Synchronous_Data_Packets (2).  The ACL length and
// count are kept; the synchronous ones are accepted and ignored, since the
// Controller has no synchronous data.  A length or a count of 0 is Invalid HCI
// Command Parameters.
@satisfies("REQ-BLE-HCI-059")
@tier(embedded)
fn cmd_host_buffer_size(var c: Controller)
    let length = param_u16(var c, 0)
    let total = param_u16(var c, 3)
    var status = STATUS_SUCCESS
    if length < 1 or total < 1
        status = STATUS_INVALID_PARAMETERS
    else
        ctl_pool.pool_host_size(var c.pool, length, total)
    answer_status(var c, OP_HOST_BUFFER_SIZE, status)

// Host Number Of Completed Packets ([Vol 4] Part E, Section 7.3.40): Num_Handles
// and, for each, Connection_Handle and Host_Num_Of_Completed_Packets, which
// give back that many of the Host's buffers.  The command has no event in answer,
// so a malformed one is ignored, and so is one while flow control is off, no
// connection exists or no Host Buffer Size was seen (Section 7.3.40).
@satisfies("REQ-BLE-HCI-059")
@tier(embedded)
fn cmd_host_number_of_completed_packets(var c: Controller)
    if not links_live(var c)
        return
    let len = h4_rx.h4_param_len(var c.rx)
    if len < 1
        return
    let n = h4_rx.h4_param(var c.rx, 0)
    if len != 1 + 4 * n
        return
    var total = 0
    for i in 0..n
        total = total + param_u16(var c, 1 + 4 * i + 2)
    ctl_pool.pool_host_completed(var c.pool, total)

// Set Event Mask Page 2 ([Vol 4] Part E, Section 7.3.69): the second 64 events.
@satisfies("REQ-BLE-CTL-028")
@tier(embedded)
fn cmd_set_event_mask_page_2(var c: Controller)
    c.mask2 = param_u32(var c, 0) | (param_u32(var c, 4) << 32)
    answer_status(var c, OP_SET_EVENT_MASK_PAGE_2, STATUS_SUCCESS)

@satisfies("REQ-BLE-HCI-010")
@tier(embedded)
fn cmd_le_set_event_mask(var c: Controller)
    c.le_low = param_u32(var c, 0)
    c.le_high = param_u32(var c, 4)
    answer_status(var c, OP_LE_SET_EVENT_MASK, STATUS_SUCCESS)

@satisfies("REQ-BLE-HCI-006")
@tier(embedded)
fn cmd_read_local_version(var c: Controller)
    let slot = complete_begin(var c, OP_READ_LOCAL_VERSION, STATUS_SUCCESS)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put(var c.pool, slot, SPEC_VERSION)
    let _b = ctl_pool.pool_put_u16(var c.pool, slot, SUBVERSION)
    let _c = ctl_pool.pool_put(var c.pool, slot, SPEC_VERSION)
    let _d = ctl_pool.pool_put_u16(var c.pool, slot, MANUFACTURER)
    let _e = ctl_pool.pool_put_u16(var c.pool, slot, SUBVERSION)
    complete_send(var c, slot)

@satisfies("REQ-BLE-HCI-007")
@tier(embedded)
fn cmd_read_local_supported_commands(var c: Controller)
    let slot = complete_begin(var c, OP_READ_LOCAL_SUPPORTED_COMMANDS, STATUS_SUCCESS)
    if slot == ctl_pool.NO_SLOT
        return
    let base = ctl_pool.pool_len(var c.pool, slot)
    put_zeros(var c, slot, 64)
    supported_commands_fill(var c, var c.pool, slot, base)
    complete_send(var c, slot)

@satisfies("REQ-BLE-HCI-008")
@tier(embedded)
fn cmd_read_local_supported_features(var c: Controller)
    let slot = complete_begin(var c, OP_READ_LOCAL_SUPPORTED_FEATURES, STATUS_SUCCESS)
    if slot == ctl_pool.NO_SLOT
        return
    for i in 0..8
        let _a = ctl_pool.pool_put(var c.pool, slot, lmp_feature_octet(i))
    complete_send(var c, slot)

@satisfies("REQ-BLE-HCI-005")
@tier(embedded)
fn cmd_read_bd_addr(var c: Controller)
    let slot = complete_begin(var c, OP_READ_BD_ADDR, STATUS_SUCCESS)
    if slot == ctl_pool.NO_SLOT
        return
    for i in 0..6
        let _a = ctl_pool.pool_put(var c.pool, slot, c.public[i] as Int)
    complete_send(var c, slot)

@satisfies("REQ-BLE-HCI-011")
@tier(embedded)
fn cmd_le_read_buffer_size(var c: Controller)
    let slot = complete_begin(var c, OP_LE_READ_BUFFER_SIZE, STATUS_SUCCESS)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put_u16(var c.pool, slot, h4_rx.LL_ACL_OCTETS)
    let _b = ctl_pool.pool_put(var c.pool, slot, ACL_BUFFERS)
    complete_send(var c, slot)

// The LE Feature Set: the features the Link Layer has when the image has one
// (`LE_FEATURES_OCTET0`), none otherwise.
@satisfies("REQ-BLE-HCI-012")
@tier(embedded)
fn cmd_le_features(var c: Controller, opcode: Int)
    let slot = complete_begin(var c, opcode, STATUS_SUCCESS)
    if slot == ctl_pool.NO_SLOT
        return
    var f: Vec[u8; 8] = Vec.new()
    for _ in 0..8
        let _a = f.push(0)
    if (c.caps as Int & CAP_LL) != 0
        ll_link.own_features(var f, c.host_iso, c.host_sub, host_cs_bit(var c))
        if not c.coded
            ll_link.clear_coded(var f)
        if cs_tq_bit(var c)
            f[6] = (f[6] as Int | ll_cs.FEAT6_CS_TQ) as u8
    for i in 0..8
        let _b = ctl_pool.pool_put(var c.pool, slot, f[i] as Int)
    complete_send(var c, slot)

// LE Read All Local Supported Features ([Vol 4] Part E, Section 7.8.128): the highest page with a bit and the 248 octets of the feature
// set, page 0 as LE Read Local Supported Features gives it and page 1 with the bits of the build; the pages above are zero.
@satisfies("REQ-BLE-CTL-117")
@tier(embedded)
fn cmd_le_read_all_local(var c: Controller)
    let slot = complete_begin(var c, OP_LE_READ_ALL_LOCAL_SUPPORTED_FEATURES, STATUS_SUCCESS)
    if slot == ctl_pool.NO_SLOT
        return
    var f: Vec[u8; 8] = Vec.new()
    for _ in 0..8
        let _a = f.push(0)
    ll_link.own_features(var f, c.host_iso, c.host_sub, host_cs_bit(var c))
    if not c.coded
        ll_link.clear_coded(var f)
    if cs_tq_bit(var c)
        f[6] = (f[6] as Int | ll_cs.FEAT6_CS_TQ) as u8
    var p1 = ctl_limits.page1_bits()
    if ctl_limits.rate_on()
        p1 = ll_link.fx_get(c.links[0], ll_link.FX_LOCAL, 0xFFFF)
    let _m = ctl_pool.pool_put(var c.pool, slot, ll_feat.max_page(p1))
    for i in 0..8
        let _b = ctl_pool.pool_put(var c.pool, slot, f[i] as Int)
    for i in 0..8
        let _p = ctl_pool.pool_put(var c.pool, slot, (p1 >>> (8 * i)) & 0xFF)
    for _ in 0..ll_feat.PAGE_MAX * ll_feat.PAGE_OCTETS - 8
        let _z = ctl_pool.pool_put(var c.pool, slot, 0)
    complete_send(var c, slot)

// LE_States: the states of the legacy Link Layer when the image has one.
@satisfies("REQ-BLE-HCI-036")
@tier(embedded)
fn cmd_le_read_supported_states(var c: Controller)
    let slot = complete_begin(var c, OP_LE_READ_SUPPORTED_STATES, STATUS_SUCCESS)
    if slot == ctl_pool.NO_SLOT
        return
    var states = 0
    if (c.caps as Int & CAP_LL) != 0
        states = LE_STATES
    for i in 0..8
        let _a = ctl_pool.pool_put(var c.pool, slot, (states >>> (8 * i)) & 0xFF)
    complete_send(var c, slot)

// The address a Controller advertises or scans with is ready for the Own
// Address Type: a public address that is not all zeros, or a random address
// that LE Set Random Address gave.
@tier(embedded)
fn have_public(var c: Controller) -> Bool
    for i in 0..6
        if c.public[i] != 0
            return true
    false

@tier(embedded)
fn own_address_ready(var c: Controller, own: Int) -> Bool
    if own == 0
        have_public(var c)
    else
        c.random_set

@satisfies("REQ-BLE-HCI-013")
@tier(embedded)
fn cmd_le_set_random_address(var c: Controller)
    if adv_active(var c) or c.scan.enabled
        answer_status(var c, OP_LE_SET_RANDOM_ADDRESS, STATUS_COMMAND_DISALLOWED)
        return
    for i in 0..6
        c.random[i] = h4_rx.h4_param(var c.rx, i) as u8
    c.random_set = true
    answer_status(var c, OP_LE_SET_RANDOM_ADDRESS, STATUS_SUCCESS)

// ── The Broadcaster commands ────────────────────────────────────────

// The advertising parameters: the interval range, the type, the own and
// peer address types, the peer address, the channel map and the filter
// policy ([Vol 4] Part E, Section 7.8.5).
@satisfies("REQ-BLE-CTL-007")
@tier(embedded)
fn cmd_le_set_advertising_parameters(var c: Controller)
    let op = OP_LE_SET_ADVERTISING_PARAMETERS
    if c.adv.enabled or (c.adv.fam as Int) == 2
        answer_status(var c, op, STATUS_COMMAND_DISALLOWED)
        return
    let int_min = param_u16(var c, 0)
    let int_max = param_u16(var c, 2)
    let ty = h4_rx.h4_param(var c.rx, 4)
    let own = h4_rx.h4_param(var c.rx, 5)
    let peer_type = h4_rx.h4_param(var c.rx, 6)
    let chmap = h4_rx.h4_param(var c.rx, 13)
    let policy = h4_rx.h4_param(var c.rx, 14)
    let status = ll_adv.params_status(int_min, int_max, ty, own, peer_type, chmap, policy)
    if status != STATUS_SUCCESS
        answer_status(var c, op, status)
        return
    var peer: Vec[u8; 6] = Vec.new()
    for i in 0..6
        let _a = peer.push(h4_rx.h4_param(var c.rx, 7 + i) as u8)
    ll_adv.adv_set_params(var c.adv, int_min, int_max, ty, own, peer_type, chmap, policy)
    ll_adv.adv_set_peer(var c.adv, var peer)
    c.adv.fam = 1
    answer_status(var c, op, STATUS_SUCCESS)

// The power the radio sends advertising channel PDUs at.
@satisfies("REQ-BLE-CTL-007")
@tier(embedded)
fn cmd_le_read_advertising_channel_tx_power(var c: Controller)
    let slot = complete_begin(var c, OP_LE_READ_ADVERTISING_CHANNEL_TX_POWER, STATUS_SUCCESS)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put(var c.pool, slot, TX_POWER_DBM & 0xFF)
    complete_send(var c, slot)

// The minimum and maximum power the radio supports.
@tier(embedded)
fn cmd_le_read_transmit_power(var c: Controller)
    let slot = complete_begin(var c, OP_LE_READ_TRANSMIT_POWER, STATUS_SUCCESS)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put(var c.pool, slot, TX_POWER_MIN_DBM & 0xFF)
    let _b = ctl_pool.pool_put(var c.pool, slot, TX_POWER_MAX_DBM & 0xFF)
    complete_send(var c, slot)

// The advertising data or the scan response data: the significant length and
// 31 octets ([Vol 4] Part E, Sections 7.8.7 and 7.8.8).
@satisfies("REQ-BLE-CTL-007")
@tier(embedded)
fn cmd_le_set_advertising_data(var c: Controller, opcode: Int)
    if (c.adv.fam as Int) == 2
        answer_status(var c, opcode, STATUS_COMMAND_DISALLOWED)
        return
    let len = h4_rx.h4_param(var c.rx, 0)
    if len > ll_pdu.DATA_MAX
        answer_status(var c, opcode, STATUS_INVALID_PARAMETERS)
        return
    var data: Vec[u8; 31] = Vec.new()
    for i in 0..31
        let _a = data.push(h4_rx.h4_param(var c.rx, 1 + i) as u8)
    if opcode == OP_LE_SET_ADVERTISING_DATA
        ll_adv.adv_set_data(var c.adv, len, var data)
    else
        ll_adv.adv_set_scan_rsp(var c.adv, len, var data)
    c.adv.fam = 1
    answer_status(var c, opcode, STATUS_SUCCESS)

// Start or stop advertising ([Vol 4] Part E, Section 7.8.9).  Starting with
// an Own_Address_Type whose address the Controller does not have is refused.
@satisfies("REQ-BLE-CTL-008")
@tier(embedded)
fn cmd_le_set_advertising_enable(var c: Controller)
    let op = OP_LE_SET_ADVERTISING_ENABLE
    let on = h4_rx.h4_param(var c.rx, 0)
    if (c.adv.fam as Int) == 2
        answer_status(var c, op, STATUS_COMMAND_DISALLOWED)
        return
    if on > 1
        answer_status(var c, op, STATUS_INVALID_PARAMETERS)
        return
    c.adv.fam = 1
    if on == 0
        if c.adv.enabled
            ll_adv.adv_disable(var c.adv)
            ll_arb.arb_cancel(var c.arb, ll_arb.class_adv())
        answer_status(var c, op, STATUS_SUCCESS)
        return
    let own = c.adv.own as Int
    // The resolving list entry of the peer the Host named, for an Own_Address_Type
    // that asks for a Resolvable Private Address (Sections 6.2 of [Vol 6] Part B).
    var ent = -1
    if own >= 2 or ll_adv.is_directed(c.adv.ty as Int)
        var peer = adv_peer_vec(var c)
        ent = ll_privacy.rl_find(var c.rl, c.adv.peer_type as Int, var peer)
    let loc = ent >= 0 and ll_privacy.rl_local_has_irk(var c.rl, ent)
    if not loc and not own_address_ready(var c, own & 1)
        answer_status(var c, op, STATUS_INVALID_PARAMETERS)
        return
    // A connectable advertisement needs a link to be free for the Peripheral
    // role: not the one Peripheral link this Controller holds, nor the last slot
    // while the Initiating state is to take it.
    if ll_adv.is_connectable(c.adv.ty as Int) and not peripheral_room(var c)
        answer_status(var c, op, STATUS_CONNECTION_LIMIT)
        return
    if not c.adv.enabled
        start_advertising(var c, own, ent, loc)
    answer_status(var c, op, STATUS_SUCCESS)

// ── The extended Broadcaster commands ───────────────────────────────
//
// [Vol 4] Part E, Sections 7.8.52 to 7.8.59.  The Host defines advertising sets (`ll_xadv.XSet`, `xsets`) with LE Set
// Extended Advertising Parameters, gives each its data and scan response data in fragments, and enables them
// (`REQ-BLE-CTL-091`).  A set that sends legacy PDUs (property bit 4) is run by the legacy advertiser `adv`, one at a time:
// its parameters and data are copied into it when it is enabled, and the events it ends with are told as set events.  A
// set of extended PDUs is run by the radio program one event at a time (`ll_air.xadv_event`), with `adv` loaded with the
// set's addresses and type to judge the request that follows the AUX_ADV_IND.  The legacy and the extended commands refuse
// each other (Command Disallowed) from the first of either until a Reset (`Adv.fam`).

// The set with `handle`, -1 for none.
@tier(embedded)
fn xset_find(var c: Controller, handle: Int) -> Int
    for i in 0..ctl_limits.sets()
        if c.xsets[i].used and (c.xsets[i].handle as Int) == handle
            return i
    -1

// A slot no set uses, -1 for none.
@tier(embedded)
fn xset_free(var c: Controller) -> Int
    for i in 0..ctl_limits.sets()
        if not c.xsets[i].used
            return i
    -1

// Whether a set of extended PDUs is enabled.
@tier(embedded)
fn xsets_on(var c: Controller) -> Bool
    if not ctl_limits.xadv_on()
        return false
    for i in 0..ctl_limits.sets()
        if c.xsets[i].on and not ll_xadv.is_legacy(var c.xsets[i])
            return true
    false

// Whether any advertising is on: the legacy advertiser (which also runs the sets of legacy PDUs) or a set of extended PDUs.
pub @tier(embedded)
fn adv_active(var c: Controller) -> Bool
    c.adv.enabled or xsets_on(var c)

// Whether this Controller's radio can send and receive on LE Coded.
@tier(embedded)
fn xadv_coded(var c: Controller) -> Bool
    phy_supported(var c, ll_phy.PHY_CODED)

// The Tx Power the Controller selects for a request of `dbm` (0x7F: no preference, the signed octet otherwise).
@tier(embedded)
fn select_power(req: Int) -> Int
    if req == 0x7F
        return TX_POWER_DBM
    var v = req
    if v > 127
        v = v - 256
    if v < TX_POWER_MIN_DBM
        return TX_POWER_MIN_DBM
    if v > TX_POWER_MAX_DBM
        return TX_POWER_MAX_DBM
    v

// The three octets at parameter `at`, least significant first.
@tier(embedded)
fn param_u24(var c: Controller, at: Int) -> Int
    param_u16(var c, at) | (h4_rx.h4_param(var c.rx, at + 2) << 16)

// LE Set Advertising Set Random Address ([Vol 4] Part E, Section 7.8.52): the random address a set advertises with when its
// Own_Address_Type is random.  Unknown Advertising Identifier for a handle the Host has not defined, Command Disallowed
// while the set is enabled.
@satisfies("REQ-BLE-CTL-091")
@tier(embedded)
fn cmd_le_set_advertising_set_random_address(var c: Controller)
    let op = OP_LE_SET_ADVERTISING_SET_RANDOM_ADDRESS
    if (c.adv.fam as Int) == 1
        answer_status(var c, op, STATUS_COMMAND_DISALLOWED)
        return
    let i = xset_find(var c, h4_rx.h4_param(var c.rx, 0))
    if i < 0
        answer_status(var c, op, ll_xadv.E_UNKNOWN_SET)
        return
    if c.xsets[i].on
        answer_status(var c, op, STATUS_COMMAND_DISALLOWED)
        return
    for k in 0..6
        ll_xadv.xset_rand_put(var c.xsets[i], k, h4_rx.h4_param(var c.rx, 1 + k))
    c.xsets[i].rand_set = true
    c.adv.fam = 2
    answer_status(var c, op, STATUS_SUCCESS)

// LE Set Extended Advertising Parameters [v1] and [v2] ([Vol 4] Part E, Section 7.8.53): define or redefine a set.  The answer is a
// Command Complete event with the Tx Power the Controller selected.  A handle already enabled is Command Disallowed, a new one
// when every set is defined is Memory Capacity Exceeded.  [v2] adds the options of LE Coded for the primary and the secondary
// PHY (0 no preference, 1 S=2, 2 S=8; anything else is Invalid HCI Command Parameters); [v1] sends S=8.
@satisfies("REQ-BLE-CTL-091")
@satisfies("REQ-BLE-CTL-092")
@tier(embedded)
fn cmd_le_set_extended_advertising_parameters(var c: Controller, v2: Bool)
    var op = OP_LE_SET_EXTENDED_ADVERTISING_PARAMETERS
    var popt = 0
    var sopt = 0
    if v2
        op = OP_LE_SET_EXTENDED_ADVERTISING_PARAMETERS_V2
        popt = h4_rx.h4_param(var c.rx, 25)
        sopt = h4_rx.h4_param(var c.rx, 26)
    if (c.adv.fam as Int) == 1
        answer_status(var c, op, STATUS_COMMAND_DISALLOWED)
        return
    let handle = h4_rx.h4_param(var c.rx, 0)
    let props = param_u16(var c, 1)
    let int_min = param_u24(var c, 3)
    let int_max = param_u24(var c, 6)
    let chmap = h4_rx.h4_param(var c.rx, 9)
    let own = h4_rx.h4_param(var c.rx, 10)
    let peer_type = h4_rx.h4_param(var c.rx, 11)
    let policy = h4_rx.h4_param(var c.rx, 18)
    let txp = h4_rx.h4_param(var c.rx, 19)
    let pphy = h4_rx.h4_param(var c.rx, 20)
    let sphy = h4_rx.h4_param(var c.rx, 22)
    let sid = h4_rx.h4_param(var c.rx, 23)
    let notify = h4_rx.h4_param(var c.rx, 24)
    var status = ll_xadv.xset_status(handle,
        props,
        int_min,
        int_max,
        chmap,
        own,
        peer_type,
        policy,
        pphy,
        sphy,
        sid,
        xadv_coded(var c))
    if status == STATUS_SUCCESS and (notify > 1 or popt > 2 or sopt > 2)
        status = STATUS_INVALID_PARAMETERS
    var i = xset_find(var c, handle)
    if status == STATUS_SUCCESS and i >= 0 and c.xsets[i].on
        status = STATUS_COMMAND_DISALLOWED
    // A set whose periodic advertising is enabled keeps its parameters: the train runs on its secondary PHY.
    if status == STATUS_SUCCESS and i >= 0 and ctl_limits.per_on() and padv_on_handle(var c, handle)
        status = STATUS_COMMAND_DISALLOWED
    if status == STATUS_SUCCESS and i < 0
        i = xset_free(var c)
        if i < 0
            status = ll_xadv.E_MEMORY
    if status != STATUS_SUCCESS
        answer_status(var c, op, status)
        return
    var peer: Vec[u8; 6] = Vec.new()
    for k in 0..6
        let _p = peer.push(h4_rx.h4_param(var c.rx, 12 + k) as u8)
    let selected = select_power(txp)
    ll_xadv.xset_define(var c.xsets[i],
        handle,
        props,
        int_min,
        int_max,
        chmap,
        own,
        peer_type,
        var peer,
        policy,
        selected,
        pphy,
        sphy,
        popt,
        sopt,
        sid,
        notify == 1)
    c.adv.fam = 2
    let slot = complete_begin(var c, op, STATUS_SUCCESS)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put(var c.pool, slot, selected & 0xFF)
    complete_send(var c, slot)

// The data of a set of legacy PDUs, 31 octets, as the legacy advertiser holds it.
@tier(embedded)
fn legacy_copy(var s: ll_xadv.XSet, rsp: Bool) -> Vec[u8; 31]
    var d: Vec[u8; 31] = Vec.new()
    for k in 0..31
        if rsp
            if k < s.rlen
                let _a = d.push(s.rsp[k])
            else
                let _b = d.push(0)
        else
            if k < s.dlen
                let _c = d.push(s.data[k])
            else
                let _e = d.push(0)
    d

// Push the data and the scan response data of the set `i` into the legacy advertiser that runs it.
@tier(embedded)
fn legacy_sync(var c: Controller, i: Int)
    var d = legacy_copy(var c.xsets[i], false)
    ll_adv.adv_set_data(var c.adv, c.xsets[i].dlen, var d)
    var r = legacy_copy(var c.xsets[i], true)
    ll_adv.adv_set_scan_rsp(var c.adv, c.xsets[i].rlen, var r)

// LE Set Extended Advertising Data and LE Set Extended Scan Response Data ([Vol 4] Part E, Sections 7.8.54 and 7.8.55): a
// fragment of the data of the set with the Operation (first, middle, last, complete, unchanged).  The data takes effect from
// the next event of a set that is enabled.
@satisfies("REQ-BLE-CTL-091")
@tier(embedded)
fn cmd_le_set_extended_advertising_data(var c: Controller, rsp: Bool)
    var op_code = OP_LE_SET_EXTENDED_ADVERTISING_DATA
    if rsp
        op_code = OP_LE_SET_EXTENDED_SCAN_RESPONSE_DATA
    let len = h4_rx.h4_param(var c.rx, 3)
    if (c.adv.fam as Int) == 1
        answer_status(var c, op_code, STATUS_COMMAND_DISALLOWED)
        return
    if h4_rx.h4_param_len(var c.rx) != 4 + len
        answer_status(var c, op_code, STATUS_INVALID_PARAMETERS)
        return
    let i = xset_find(var c, h4_rx.h4_param(var c.rx, 0))
    if i < 0
        answer_status(var c, op_code, ll_xadv.E_UNKNOWN_SET)
        return
    let op = h4_rx.h4_param(var c.rx, 1)
    if h4_rx.h4_param(var c.rx, 2) > 1
        answer_status(var c, op_code, STATUS_INVALID_PARAMETERS)
        return
    let status = ll_xadv.data_status(var c.xsets[i], rsp, op, len)
    if status != STATUS_SUCCESS
        answer_status(var c, op_code, status)
        return
    ll_xadv.data_begin(var c.xsets[i], rsp, op)
    if op != ll_xadv.OP_UNCHANGED
        for k in 0..len
            ll_xadv.data_put(var c.xsets[i], rsp, h4_rx.h4_param(var c.rx, 4 + k))
    ll_xadv.data_end(var c.xsets[i], rsp, op)
    if c.xsets[i].on and ll_xadv.is_legacy(var c.xsets[i]) and c.adv_set == i
        legacy_sync(var c, i)
    c.adv.fam = 2
    answer_status(var c, op_code, STATUS_SUCCESS)

// Start the set `i` of legacy PDUs on the legacy advertiser: its parameters and data are copied in, and the advertiser starts
// as LE Set Advertising Enable starts it.  The status of the start.
@satisfies("REQ-BLE-CTL-091")
@tier(embedded)
fn legacy_set_start(var c: Controller, i: Int, dur: Int, max_ev: Int) -> Int
    if c.adv.enabled
        return ll_xadv.E_MEMORY
    let ty = ll_xadv.legacy_type(c.xsets[i].props)
    let own = c.xsets[i].own as Int
    ll_adv.adv_set_params(var c.adv,
        c.xsets[i].int_min,
        c.xsets[i].int_max,
        ty,
        own,
        c.xsets[i].peer_type as Int,
        c.xsets[i].chmap as Int,
        c.xsets[i].policy as Int)
    var peer: Vec[u8; 6] = Vec.new()
    for k in 0..6
        let _p = peer.push(c.xsets[i].peer[k])
    ll_adv.adv_set_peer(var c.adv, var peer)
    legacy_sync(var c, i)
    var ent = -1
    if own >= 2 or ll_adv.is_directed(ty)
        ent = ll_privacy.rl_find(var c.rl, c.xsets[i].peer_type as Int, var peer)
    let loc = ent >= 0 and ll_privacy.rl_local_has_irk(var c.rl, ent)
    var ready = loc
    if not loc
        if (own & 1) == 0
            ready = have_public(var c)
        else
            ready = c.xsets[i].rand_set or c.random_set
    if not ready
        return STATUS_INVALID_PARAMETERS
    if ll_adv.is_connectable(ty) and not peripheral_room(var c)
        return STATUS_CONNECTION_LIMIT
    start_advertising(var c, own, ent, loc)
    if not loc and (own & 1) == 1 and c.xsets[i].rand_set
        var a: Vec[u8; 6] = Vec.new()
        for k in 0..6
            let _a = a.push(c.xsets[i].rand[k])
        ll_adv.adv_set_addr(var c.adv, var a, 1)
    c.adv_set = i
    c.adv_base = c.adv.events
    c.xsets[i].on = true
    c.xsets[i].dur = dur
    c.xsets[i].max_ev = max_ev
    c.xsets[i].entered = c.now
    c.xsets[i].events = 0
    c.xsets[i].term_owed = false
    STATUS_SUCCESS

// Stop the set `i`, whichever advertiser runs it.
@tier(embedded)
fn xset_stop(var c: Controller, i: Int)
    if not c.xsets[i].on
        return
    c.xsets[i].on = false
    if ll_xadv.is_legacy(var c.xsets[i]) and c.adv_set == i
        ll_adv.adv_disable(var c.adv)
        ll_arb.arb_cancel(var c.arb, ll_arb.class_adv())
        c.adv_set = -1

// The resolving list entry of the peer of the set `i` and what the Own_Address_Type asks of it ([Vol 6] Part B, Section 6.2): the entry
// is looked up for an Own_Address_Type of a Resolvable Private Address and for a directed set; the set advertises with the local RPA
// of the entry (`loc`) when an Own_Address_Type 2 or 3 finds one with a local IRK, and a directed set names its peer with an RPA made with
// the peer's IRK (`tgt`) when the entry has one.  Own_Address_Type 2 without an entry is the public address and 3 the random one.
@satisfies("REQ-BLE-CTL-095")
@tier(embedded)
fn xset_privacy(var c: Controller, i: Int)
    var ent = -1
    c.xsets[i].loc = false
    c.xsets[i].tgt = false
    c.xsets[i].tgt_ok = false
    let own = c.xsets[i].own as Int
    let directed = ll_xadv.is_directed(var c.xsets[i])
    if own >= 2 or directed
        var peer: Vec[u8; 6] = Vec.new()
        for k in 0..6
            let _p = peer.push(c.xsets[i].peer[k])
        ent = ll_privacy.rl_find(var c.rl, c.xsets[i].peer_type as Int, var peer)
    c.xsets[i].ent = ent
    if ent >= 0
        c.xsets[i].loc = own >= 2 and ll_privacy.rl_local_has_irk(var c.rl, ent)
        c.xsets[i].tgt = directed and ll_privacy.rl_peer_has_irk(var c.rl, ent)

// Whether the set `i` waits for a Resolvable Private Address to be made: its local one, or the one that names its peer.
@tier(embedded)
fn xset_waits(var c: Controller, i: Int) -> Bool
    if c.xsets[i].loc and c.xsets[i].ent >= 0 and not c.rl.local_ok[c.xsets[i].ent]
        return true
    c.xsets[i].tgt and not c.xsets[i].tgt_ok

// The address a set of extended PDUs advertises with, in `a`; false when the Controller has none for it.
@tier(embedded)
fn xset_address(var c: Controller, i: Int, var a: Vec[u8; 6]) -> Int
    let own = c.xsets[i].own as Int
    xset_privacy(var c, i)
    if c.xsets[i].loc
        var l = rl_local_vec(var c, c.xsets[i].ent)
        for k in 0..6
            a[k] = l[k]
        return 1
    if (own & 1) == 0
        if not have_public(var c)
            return -1
        for k in 0..6
            a[k] = c.public[k]
        return 0
    if c.xsets[i].rand_set
        for k in 0..6
            a[k] = c.xsets[i].rand[k]
        return 1
    if c.random_set
        for k in 0..6
            a[k] = c.random[k]
        return 1
    -1

// LE Set Extended Advertising Enable ([Vol 4] Part E, Section 7.8.56): enable the sets of the list, or disable them (all of
// them when the list is empty).  Every entry is checked before any is started: an unknown handle is Unknown Advertising
// Identifier, a scannable set without its scan response data Command Disallowed, an address the Controller lacks Invalid
// HCI Command Parameters, a legacy set beside another or beside a set of extended PDUs Memory Capacity Exceeded.
@satisfies("REQ-BLE-CTL-091")
@tier(embedded)
fn cmd_le_set_extended_advertising_enable(var c: Controller)
    let op = OP_LE_SET_EXTENDED_ADVERTISING_ENABLE
    let on = h4_rx.h4_param(var c.rx, 0)
    let n = h4_rx.h4_param(var c.rx, 1)
    if (c.adv.fam as Int) == 1
        answer_status(var c, op, STATUS_COMMAND_DISALLOWED)
        return
    if on > 1 or on == 1 and n == 0 or h4_rx.h4_param_len(var c.rx) != 2 + 4 * n or n > ctl_limits.sets()
        answer_status(var c, op, STATUS_INVALID_PARAMETERS)
        return
    if on == 0 and n == 0
        for i in 0..ctl_limits.sets()
            xset_stop(var c, i)
        answer_status(var c, op, STATUS_SUCCESS)
        return
    var status = STATUS_SUCCESS
    var legacy_n = 0
    var ext_n = 0
    for e in 0..n
        let handle = h4_rx.h4_param(var c.rx, 2 + 4 * e)
        let i = xset_find(var c, handle)
        if i < 0
            status = ll_xadv.E_UNKNOWN_SET
            break
        for f in 0..e
            if h4_rx.h4_param(var c.rx, 2 + 4 * f) == handle
                status = STATUS_INVALID_PARAMETERS
        if on == 1 and status == STATUS_SUCCESS
            status = ll_xadv.enable_status(var c.xsets[i])
            if status == STATUS_SUCCESS and ll_xadv.is_legacy(var c.xsets[i])
                legacy_n = legacy_n + 1
            else if status == STATUS_SUCCESS
                ext_n = ext_n + 1
                var a: Vec[u8; 6] = Vec.new()
                for k in 0..6
                    let _a = a.push(0)
                if xset_address(var c, i, var a) < 0
                    status = STATUS_INVALID_PARAMETERS
                if status == STATUS_SUCCESS and ll_xadv.is_connectable(var c.xsets[i]) and not peripheral_room(var c)
                    status = STATUS_CONNECTION_LIMIT
        if status != STATUS_SUCCESS
            break
    if status == STATUS_SUCCESS and on == 1
        // One set of legacy PDUs runs at a time, and not beside a set of extended PDUs.
        if legacy_n > 1 or legacy_n > 0 and (ext_n > 0 or xsets_on(var c)) or ext_n > 0 and c.adv.enabled
            status = ll_xadv.E_MEMORY
    if status != STATUS_SUCCESS
        answer_status(var c, op, status)
        return
    for e in 0..n
        let i = xset_find(var c, h4_rx.h4_param(var c.rx, 2 + 4 * e))
        if on == 0
            xset_stop(var c, i)
        else
            let dur = param_u16(var c, 3 + 4 * e)
            let max_ev = h4_rx.h4_param(var c.rx, 5 + 4 * e)
            if ll_xadv.is_legacy(var c.xsets[i])
                // A set that is on already is started again.
                xset_stop(var c, i)
                let st = legacy_set_start(var c, i, dur, max_ev)
                if st != STATUS_SUCCESS
                    answer_status(var c, op, st)
                    return
            else
                var a: Vec[u8; 6] = Vec.new()
                for k in 0..6
                    let _a = a.push(0)
                let kind = xset_address(var c, i, var a)
                ll_xadv.xset_enable(var c.xsets[i], c.now, var a, kind, dur, max_ev)
    answer_status(var c, op, STATUS_SUCCESS)

// LE Read Maximum Advertising Data Length ([Vol 4] Part E, Section 7.8.57): the most octets of advertising data or scan
// response data a set holds.
@satisfies("REQ-BLE-CTL-091")
@tier(embedded)
fn cmd_le_read_maximum_advertising_data_length(var c: Controller)
    let slot = complete_begin(var c, OP_LE_READ_MAXIMUM_ADVERTISING_DATA_LENGTH, STATUS_SUCCESS)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put_u16(var c.pool, slot, ctl_limits.data_max())
    complete_send(var c, slot)

// LE Read Number of Supported Advertising Sets ([Vol 4] Part E, Section 7.8.58).
@satisfies("REQ-BLE-CTL-091")
@tier(embedded)
fn cmd_le_read_number_of_supported_advertising_sets(var c: Controller)
    let slot = complete_begin(var c, OP_LE_READ_NUMBER_OF_SUPPORTED_ADVERTISING_SETS, STATUS_SUCCESS)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put(var c.pool, slot, ctl_limits.sets())
    complete_send(var c, slot)

// LE Remove Advertising Set ([Vol 4] Part E, Section 7.8.59): Unknown Advertising Identifier for a handle that is not
// defined, Command Disallowed for a set that is enabled.
@satisfies("REQ-BLE-CTL-091")
@tier(embedded)
fn cmd_le_remove_advertising_set(var c: Controller)
    let op = OP_LE_REMOVE_ADVERTISING_SET
    if (c.adv.fam as Int) == 1
        answer_status(var c, op, STATUS_COMMAND_DISALLOWED)
        return
    let i = xset_find(var c, h4_rx.h4_param(var c.rx, 0))
    if i < 0
        answer_status(var c, op, ll_xadv.E_UNKNOWN_SET)
        return
    if c.xsets[i].on or padv_on_handle(var c, h4_rx.h4_param(var c.rx, 0))
        answer_status(var c, op, STATUS_COMMAND_DISALLOWED)
        return
    padv_drop(var c, h4_rx.h4_param(var c.rx, 0))
    ll_xadv.xset_clear(var c.xsets[i])
    c.adv.fam = 2
    answer_status(var c, op, STATUS_SUCCESS)

// LE Clear Advertising Sets ([Vol 4] Part E, Section 7.8.60): Command Disallowed while any set is enabled.
@satisfies("REQ-BLE-CTL-091")
@tier(embedded)
fn cmd_le_clear_advertising_sets(var c: Controller)
    let op = OP_LE_CLEAR_ADVERTISING_SETS
    if (c.adv.fam as Int) == 1
        answer_status(var c, op, STATUS_COMMAND_DISALLOWED)
        return
    for i in 0..ctl_limits.sets()
        if c.xsets[i].on
            answer_status(var c, op, STATUS_COMMAND_DISALLOWED)
            return
    if pads_on(var c)
        answer_status(var c, op, STATUS_COMMAND_DISALLOWED)
        return
    for k in 0..ctl_limits.padv_n()
        ll_per.padv_clear(var c.pads[k])
    for i in 0..ctl_limits.sets()
        ll_xadv.xset_clear(var c.xsets[i])
    c.adv.fam = 2
    answer_status(var c, op, STATUS_SUCCESS)

// LE Advertising Set Terminated ([Vol 4] Part E, Section 7.7.65.18): the set ended because its Duration ran out or its events
// were sent (Status Advertising Timeout, Limit Reached), or because a connection was made on it (Status Success, with the
// connection's handle).
@satisfies("REQ-BLE-CTL-091")
@tier(embedded)
fn ev_set_terminated(var c: Controller, i: Int) -> Bool
    if not le_event_enabled(var c, SUB_LE_ADVERTISING_SET_TERMINATED)
        c.xsets[i].term_owed = false
        return true
    let slot = meta_begin(var c, SUB_LE_ADVERTISING_SET_TERMINATED)
    if slot == ctl_pool.NO_SLOT
        return false
    let _a = ctl_pool.pool_put(var c.pool, slot, c.xsets[i].term)
    let _b = ctl_pool.pool_put(var c.pool, slot, c.xsets[i].handle as Int)
    let _c = ctl_pool.pool_put_u16(var c.pool, slot, c.xsets[i].term_conn)
    let _d = ctl_pool.pool_put(var c.pool, slot, c.xsets[i].events)
    event_send(var c, slot)
    c.xsets[i].term_owed = false
    true

// LE Scan Request Received ([Vol 4] Part E, Section 7.7.65.19): a scan request was answered by the set that asked for it
// to be told.
@satisfies("REQ-BLE-CTL-091")
@tier(embedded)
fn ev_scan_request(var c: Controller, i: Int, var rx: Pdu)
    if not c.xsets[i].notify or not le_event_enabled(var c, SUB_LE_SCAN_REQUEST_RECEIVED)
        return
    if ctl_pool.pool_free(var c.pool) < 2
        c.dropped_events = c.dropped_events + 1
        return
    let slot = meta_begin(var c, SUB_LE_SCAN_REQUEST_RECEIVED)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put(var c.pool, slot, c.xsets[i].handle as Int)
    let _b = ctl_pool.pool_put(var c.pool, slot, ll_pdu.pdu_tx_add(var rx))
    for k in 0..6
        let _c = ctl_pool.pool_put(var c.pool, slot, rx.b[2 + k] as Int)
    event_send(var c, slot)

// ── Periodic advertising and periodic advertising synchronization ───
//
// [Vol 4] Part E, Sections 7.8.61 to 7.8.63, 7.8.67 to 7.8.73 and 7.8.88; [Vol 6] Part B, Sections 4.4.2.2.3 and 4.4.5.1.  A
// train (`ll_per.PerAdv`) belongs to an advertising set of the same handle and sends its events beside the set's own: the
// Host defines it, fills it and enables it, and it starts with the first extended advertising event of the set after that, whose
// AUX_ADV_IND carries the SyncInfo.  The trains this device listens to (`ll_per.PerSync`) are found by LE Periodic Advertising
// Create Sync in the SyncInfo of an AUX_ADV_IND that the extended scan follows.  A build without a train and a
// synchronization (`ctl_limits.per_on()` 0) answers none of the commands.

// The train of the advertising set with the handle `handle`, -1 for none, and a train slot no set uses, -1 for none.
@tier(embedded)
fn padv_find(var c: Controller, handle: Int) -> Int
    for k in 0..ctl_limits.padv_n()
        if c.pads[k].used and c.pads[k].handle == handle
            return k
    -1

@tier(embedded)
fn padv_free(var c: Controller) -> Int
    for k in 0..ctl_limits.padv_n()
        if not c.pads[k].used
            return k
    -1

// Whether the train of the set `handle` is enabled, and the train of the set forgotten.
@tier(embedded)
fn padv_on_handle(var c: Controller, handle: Int) -> Bool
    let k = padv_find(var c, handle)
    k >= 0 and c.pads[k].on

@tier(embedded)
fn padv_drop(var c: Controller, handle: Int)
    let k = padv_find(var c, handle)
    if k >= 0
        ll_per.padv_clear(var c.pads[k])

// Whether a train is enabled.
@tier(embedded)
fn pads_on(var c: Controller) -> Bool
    for k in 0..ctl_limits.padv_n()
        if c.pads[k].used and c.pads[k].on
            return true
    false

// The train in slot `k` stops sending events, and its set stops announcing it.
@tier(embedded)
fn padv_stop(var c: Controller, k: Int)
    c.pads[k].on = false
    c.pads[k].run = false
    let i = xset_find(var c, c.pads[k].handle)
    if i >= 0
        c.xsets[i].si_on = false

// The Command Complete of a command that answers the Status and an Advertising_Handle.
@tier(embedded)
fn answer_status_handle(var c: Controller, opcode: Int, status: Int, handle: Int)
    let slot = complete_begin(var c, opcode, status)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put(var c.pool, slot, handle)
    complete_send(var c, slot)

// The Status of LE Set Periodic Advertising Parameters for the set `handle`, and the parameters taken when it is Success.  Command
// Disallowed once the legacy commands were used or while the train is enabled, Unknown Advertising Identifier for a set the Host
// has not defined, Invalid HCI Command Parameters for an interval range the specification forbids and for a set that is
// scannable, connectable, legacy or anonymous, Memory Capacity Exceeded for a train too many, Packet Too Long when the data the
// train holds does not fit an event of the longest interval of the range, and Unsupported Feature or Parameter Value for Periodic
// Advertising with Responses in a build without it (a Num_Subevents of the [v2] command above 0); in a build with it, the checks of
// `ll_pawr.params_status` for the subevents and the response slots.
@satisfies("REQ-BLE-CTL-093")
@satisfies("REQ-BLE-CTL-110")
@tier(embedded)
fn padv_parameters(var c: Controller, handle: Int, v2: Bool) -> Int
    if (c.adv.fam as Int) == 1
        return STATUS_COMMAND_DISALLOWED
    let i = xset_find(var c, handle)
    if i < 0
        return ll_xadv.E_UNKNOWN_SET
    let int_min = param_u16(var c, 1)
    let int_max = param_u16(var c, 3)
    let props = param_u16(var c, 5)
    var n_sub = 0
    if v2
        n_sub = h4_rx.h4_param(var c.rx, 7)
    if n_sub != 0 and not ctl_limits.pawr_adv_on()
        return STATUS_UNSUPPORTED_FEATURE
    let status = ll_per.padv_params_status(c.xsets[i].props, int_min, int_max)
    if status != STATUS_SUCCESS
        return status
    var si = 0
    if ctl_limits.pawr_adv_on() and n_sub != 0
        if (props & 0xFFBF) != 0
            return STATUS_INVALID_PARAMETERS
        let ps = ll_pawr.params_status(int_min,
            int_max,
            n_sub,
            h4_rx.h4_param(var c.rx, 8),
            h4_rx.h4_param(var c.rx, 9),
            h4_rx.h4_param(var c.rx, 10),
            h4_rx.h4_param(var c.rx, 11))
        if ps != STATUS_SUCCESS
            return ps
        // One subevent: the Subevent_Interval is ignored, and the subevent is as long as the interval allows (at most the 255 units its octet holds).
        si = h4_rx.h4_param(var c.rx, 8)
        if n_sub == 1
            si = int_min
            if si > ll_pawr.SI_MAX
                si = ll_pawr.SI_MAX
    var k = padv_find(var c, handle)
    if k >= 0 and c.pads[k].on
        return STATUS_COMMAND_DISALLOWED
    if k < 0
        k = padv_free(var c)
        if k < 0
            return ll_per.E_MEMORY
    let old_props = c.pads[k].props
    let old_min = c.pads[k].int_min
    let old_max = c.pads[k].int_max
    let old_used = c.pads[k].used
    let old_handle = c.pads[k].handle
    ll_per.padv_define(var c.pads[k], handle, props, int_min, int_max)
    if ctl_limits.pawr_adv_on() and n_sub != 0
        ll_pawr.pa_define(var c.pwa[k],
            n_sub,
            si,
            h4_rx.h4_param(var c.rx, 9),
            h4_rx.h4_param(var c.rx, 10),
            h4_rx.h4_param(var c.rx, 11))
        ll_per.padv_define_pawr(var c.pads[k], n_sub, c.pwa[k].si_us)
    if ll_per.pick_interval(var c.pads[k], c.xsets[i].sphy as Int) < 0
        c.pads[k].used = old_used
        c.pads[k].handle = old_handle
        c.pads[k].props = old_props
        c.pads[k].int_min = old_min
        c.pads[k].int_max = old_max
        return ll_per.E_TOO_LONG
    STATUS_SUCCESS

// LE Set Periodic Advertising Parameters [v1] and [v2] ([Vol 4] Part E, Section 7.8.61).
@satisfies("REQ-BLE-CTL-093")
@tier(embedded)
fn cmd_le_set_periodic_advertising_parameters(var c: Controller, v2: Bool)
    var op = OP_LE_SET_PERIODIC_ADVERTISING_PARAMETERS
    if v2
        op = OP_LE_SET_PERIODIC_ADVERTISING_PARAMETERS_V2
    let handle = h4_rx.h4_param(var c.rx, 0)
    let status = padv_parameters(var c, handle, v2)
    if status == STATUS_SUCCESS
        c.adv.fam = 2
    if v2
        answer_status_handle(var c, op, status, handle)
    else
        answer_status(var c, op, status)

// LE Set Periodic Advertising Data ([Vol 4] Part E, Section 7.8.62): a fragment of the data of the train with the Operation (first,
// middle, last, complete, unchanged).  The data takes effect from the next event of a train that is enabled.  Command Disallowed for a
// set that has no train, Packet Too Long for a data that does not fit an event within the interval (the train's, or the longest of
// its range while it is disabled).
@satisfies("REQ-BLE-CTL-093")
@tier(embedded)
fn cmd_le_set_periodic_advertising_data(var c: Controller)
    let op_code = OP_LE_SET_PERIODIC_ADVERTISING_DATA
    if (c.adv.fam as Int) == 1
        answer_status(var c, op_code, STATUS_COMMAND_DISALLOWED)
        return
    let handle = h4_rx.h4_param(var c.rx, 0)
    let i = xset_find(var c, handle)
    if i < 0
        answer_status(var c, op_code, ll_xadv.E_UNKNOWN_SET)
        return
    let k = padv_find(var c, handle)
    if k < 0 or ctl_limits.pawr_adv_on() and c.pads[k].pawr
        // A train with responses takes its data a subevent at a time (LE Set Periodic Advertising Subevent Data).
        answer_status(var c, op_code, STATUS_COMMAND_DISALLOWED)
        return
    let op = h4_rx.h4_param(var c.rx, 1)
    let len = h4_rx.h4_param(var c.rx, 2)
    var status = ll_per.pdata_status(var c.pads[k], op, len)
    if status == ll_per.E_MEMORY
        c.pads[k].dlen = 0
        c.pads[k].dhave = false
        c.pads[k].dasm = false
    if status == STATUS_SUCCESS and (op == ll_per.OP_COMPLETE or op == ll_xadv.OP_LAST)
        var total = len
        if op == ll_xadv.OP_LAST
            total = c.pads[k].dlen + len
        let phy = c.xsets[i].sphy as Int
        if ctl_limits.big_on() and c.pads[k].big >= 0 and total > BIG_DATA_MAX
            // The BIGInfo of the group on the train is in the ACAD of every AUX_SYNC_IND, which a PDU of this data cannot also hold.
            status = ll_per.E_TOO_LONG
        else if c.pads[k].on
            if ll_per.event_us_len(var c.pads[k], total, phy) + ll_per.TRAIN_GAP_US > ll_per.interval_us(var c.pads[k])
                status = ll_per.E_TOO_LONG
        else if ll_per.pick_interval_len(var c.pads[k], total, phy) < 0
            status = ll_per.E_TOO_LONG
    if status != STATUS_SUCCESS
        answer_status(var c, op_code, status)
        return
    if op != ll_per.OP_UNCHANGED
        ll_per.pdata_begin(var c.pads[k], op)
        for j in 0..len
            ll_per.pdata_put(var c.pads[k], h4_rx.h4_param(var c.rx, 3 + j))
    ll_per.pdata_end(var c.pads[k], op)
    c.adv.fam = 2
    answer_status(var c, op_code, STATUS_SUCCESS)

// LE Set Periodic Advertising Enable ([Vol 4] Part E, Section 7.8.63).  Enabling picks the interval and marks the set as announcing the
// train; the train starts with the first extended event of the set after that.  Disabling stops it, whatever the set does.  Command
// Disallowed for a set with no parameters given, with partial data or that has become scannable, connectable, legacy or
// anonymous; Packet Too Long for data that fits no interval of the range; Unsupported Feature or Parameter Value for the ADI bit.
@satisfies("REQ-BLE-CTL-093")
@tier(embedded)
fn cmd_le_set_periodic_advertising_enable(var c: Controller)
    let op = OP_LE_SET_PERIODIC_ADVERTISING_ENABLE
    let en = h4_rx.h4_param(var c.rx, 0)
    let handle = h4_rx.h4_param(var c.rx, 1)
    if (c.adv.fam as Int) == 1
        answer_status(var c, op, STATUS_COMMAND_DISALLOWED)
        return
    if (en & 0xFC) != 0
        answer_status(var c, op, STATUS_INVALID_PARAMETERS)
        return
    let i = xset_find(var c, handle)
    if i < 0
        answer_status(var c, op, ll_xadv.E_UNKNOWN_SET)
        return
    let k = padv_find(var c, handle)
    if (en & 1) == 0
        if k >= 0 and c.pads[k].on
            padv_stop(var c, k)
        answer_status(var c, op, STATUS_SUCCESS)
        return
    if (en & 2) != 0
        answer_status(var c, op, STATUS_UNSUPPORTED_FEATURE)
        return
    if k < 0 or c.pads[k].dasm
        answer_status(var c, op, STATUS_COMMAND_DISALLOWED)
        return
    if ll_per.padv_params_status(c.xsets[i].props, c.pads[k].int_min, c.pads[k].int_max) != STATUS_SUCCESS
        answer_status(var c, op, STATUS_COMMAND_DISALLOWED)
        return
    if c.pads[k].on
        answer_status(var c, op, STATUS_SUCCESS)
        return
    let iv = ll_per.pick_interval(var c.pads[k], c.xsets[i].sphy as Int)
    if iv < 0
        answer_status(var c, op, ll_per.E_TOO_LONG)
        return
    c.pads[k].interval = iv
    c.pads[k].on = true
    c.pads[k].run = false
    c.xsets[i].si_on = true
    answer_status(var c, op, STATUS_SUCCESS)

// The synchronization slot holding the train with the Sync_Handle `handle` that the Host knows (synchronized), -1 for none.
@tier(embedded)
fn psync_find_handle(var c: Controller, handle: Int) -> Int
    for j in 0..ctl_limits.psync_n()
        if c.psyncs[j].state == ll_per.PS_SYNCED and c.psyncs[j].handle == handle
            return j
    -1

// A slot no train holds and no event is owed from, -1 for none.
@tier(embedded)
fn psync_free_slot(var c: Controller) -> Int
    for j in 0..ctl_limits.psync_n()
        if not ll_per.psync_busy(var c.psyncs[j])
            return j
    -1

// Whether a slot is synchronizing or synchronized to the train of the advertiser `kind` (the low bit), `a` and `sid`.
@tier(embedded)
fn psync_is_synced(var c: Controller, sid: Int, kind: Int, var a: Vec[u8; 6]) -> Bool
    for j in 0..ctl_limits.psync_n()
        if c.psyncs[j].state != ll_per.PS_FREE and c.psyncs[j].sid == sid and (c.psyncs[j].kind & 1) == (kind & 1)
            var same = true
            for k in 0..6
                if c.psyncs[j].addr[k] != a[k]
                    same = false
            if same
                return true
    false

// LE Periodic Advertising Create Sync ([Vol 4] Part E, Section 7.8.67): the Command Status says whether the request is taken.  Command
// Disallowed while another is pending and for all the bits of Sync_CTE_Type set; Invalid HCI Command Parameters for a reserved bit
// of the Options, a SID, an address type, a Skip or a Sync_Timeout out of range; Connection Already Exists for a train this device
// is synchronized to; Memory Capacity Exceeded when no slot is free; Unsupported Feature or Parameter Value for duplicate filtering
// (no Periodic Advertising ADI) and for a Constant Tone Extension type (no Connectionless CTE Receiver).
@satisfies("REQ-BLE-CTL-094")
@tier(embedded)
fn cmd_le_periodic_advertising_create_sync(var c: Controller)
    let op = OP_LE_PERIODIC_ADVERTISING_CREATE_SYNC
    let options = h4_rx.h4_param(var c.rx, 0)
    let sid = h4_rx.h4_param(var c.rx, 1)
    let kind = h4_rx.h4_param(var c.rx, 2)
    var a = param_addr(var c, 3)
    let skip = param_u16(var c, 9)
    let timeout = param_u16(var c, 11)
    let cte = h4_rx.h4_param(var c.rx, 13)
    var status = STATUS_SUCCESS
    if c.preq.pending or (cte & 0x1F) == 0x1F
        status = STATUS_COMMAND_DISALLOWED
    else if (options & 0xF8) != 0 or (options & 1) == 0 and (sid > 15 or kind > 1) or skip > 0x1F3 or timeout < 0x0A or timeout > 0x4000
        status = STATUS_INVALID_PARAMETERS
    else if (options & 4) != 0 or cte != 0
        status = STATUS_UNSUPPORTED_FEATURE
    else if (options & 1) == 0 and psync_is_synced(var c, sid, kind, var a)
        status = STATUS_CONNECTION_EXISTS
    else if psync_free_slot(var c) < 0
        status = ll_per.E_MEMORY
    if status != STATUS_SUCCESS
        answer_command_status(var c, op, status)
        return
    c.preq.pending = true
    c.preq.slot = -1
    c.preq.cancel_owed = false
    c.preq.use_list = (options & 1) != 0
    c.preq.reports = (options & 2) == 0
    c.preq.sid = sid
    c.preq.kind = kind
    for k in 0..6
        c.preq.addr[k] = a[k]
    c.preq.skip = skip
    c.preq.timeout = timeout
    answer_command_status(var c, op, STATUS_SUCCESS)

// LE Periodic Advertising Create Sync Cancel ([Vol 4] Part E, Section 7.8.68): the pending request ends, and after the Command
// Complete the Host is told with LE Periodic Advertising Sync Established with the status Operation Cancelled by Host.
@satisfies("REQ-BLE-CTL-094")
@tier(embedded)
fn cmd_le_periodic_advertising_create_sync_cancel(var c: Controller)
    let op = OP_LE_PERIODIC_ADVERTISING_CREATE_SYNC_CANCEL
    if not c.preq.pending
        answer_status(var c, op, STATUS_COMMAND_DISALLOWED)
        return
    if c.preq.slot >= 0
        ll_per.psync_clear(var c.psyncs[c.preq.slot])
    c.preq.pending = false
    c.preq.slot = -1
    c.preq.cancel_owed = true
    answer_status(var c, op, STATUS_SUCCESS)

// LE Periodic Advertising Terminate Sync ([Vol 4] Part E, Section 7.8.69): the Sync_Handle is destroyed.
@satisfies("REQ-BLE-CTL-094")
@tier(embedded)
fn cmd_le_periodic_advertising_terminate_sync(var c: Controller)
    let op = OP_LE_PERIODIC_ADVERTISING_TERMINATE_SYNC
    let j = psync_find_handle(var c, param_u16(var c, 0) & 0x0FFF)
    if j < 0
        answer_status(var c, op, ll_xadv.E_UNKNOWN_SET)
        return
    ll_per.psync_clear(var c.psyncs[j])
    answer_status(var c, op, STATUS_SUCCESS)

// LE Add Device To Periodic Advertiser List, LE Remove Device From Periodic Advertiser List, LE Clear Periodic Advertiser List and LE
// Read Periodic Advertiser List Size ([Vol 4] Part E, Sections 7.8.70 to 7.8.73).  The list is not changed while a Create Sync is pending.
@satisfies("REQ-BLE-CTL-094")
@tier(embedded)
fn cmd_le_add_to_periodic_advertiser_list(var c: Controller)
    let op = OP_LE_ADD_DEVICE_TO_PERIODIC_ADVERTISER_LIST
    if c.preq.pending
        answer_status(var c, op, STATUS_COMMAND_DISALLOWED)
        return
    var a = param_addr(var c, 1)
    answer_status(var c,
        op,
        ll_per.pal_add(var c.pal, h4_rx.h4_param(var c.rx, 0), var a, h4_rx.h4_param(var c.rx, 7)))

@satisfies("REQ-BLE-CTL-094")
@tier(embedded)
fn cmd_le_remove_from_periodic_advertiser_list(var c: Controller)
    let op = OP_LE_REMOVE_DEVICE_FROM_PERIODIC_ADVERTISER_LIST
    if c.preq.pending
        answer_status(var c, op, STATUS_COMMAND_DISALLOWED)
        return
    var a = param_addr(var c, 1)
    answer_status(var c,
        op,
        ll_per.pal_remove(var c.pal, h4_rx.h4_param(var c.rx, 0), var a, h4_rx.h4_param(var c.rx, 7)))

@satisfies("REQ-BLE-CTL-094")
@tier(embedded)
fn cmd_le_clear_periodic_advertiser_list(var c: Controller)
    let op = OP_LE_CLEAR_PERIODIC_ADVERTISER_LIST
    if c.preq.pending
        answer_status(var c, op, STATUS_COMMAND_DISALLOWED)
        return
    ll_per.pal_clear(var c.pal)
    answer_status(var c, op, STATUS_SUCCESS)

@satisfies("REQ-BLE-CTL-094")
@tier(embedded)
fn cmd_le_read_periodic_advertiser_list_size(var c: Controller)
    let slot = complete_begin(var c, OP_LE_READ_PERIODIC_ADVERTISER_LIST_SIZE, STATUS_SUCCESS)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put(var c.pool, slot, ctl_limits.pal_n())
    complete_send(var c, slot)

// LE Set Periodic Advertising Receive Enable ([Vol 4] Part E, Section 7.8.88): the reports of one synchronization on or off.  Unknown
// Advertising Identifier for a Sync_Handle that is none; Unsupported Feature or Parameter Value for the duplicate filtering bit (no
// Periodic Advertising ADI).
@satisfies("REQ-BLE-CTL-094")
@tier(embedded)
fn cmd_le_set_periodic_advertising_receive_enable(var c: Controller)
    let op = OP_LE_SET_PERIODIC_ADVERTISING_RECEIVE_ENABLE
    let en = h4_rx.h4_param(var c.rx, 2)
    if (en & 0xFC) != 0
        answer_status(var c, op, STATUS_INVALID_PARAMETERS)
        return
    let j = psync_find_handle(var c, param_u16(var c, 0) & 0x0FFF)
    if j < 0
        answer_status(var c, op, ll_xadv.E_UNKNOWN_SET)
        return
    if (en & 2) != 0
        answer_status(var c, op, STATUS_UNSUPPORTED_FEATURE)
        return
    c.psyncs[j].reports = (en & 1) != 0
    answer_status(var c, op, STATUS_SUCCESS)

// ── Periodic Advertising Sync Transfer ──────────────────────────────

// [Vol 4] Part E, Sections 7.7.65.24 and 7.8.89 to 7.8.92; [Vol 6] Part B, Sections 2.4.2.27 and 5.1.13 (`ll_past.nv`).  The Host of the
// device that has a train, the one it advertises or one it is synchronized to, tells the Controller to send its description to a connected
// device (LE Periodic Advertising Sync Transfer, LE Periodic Advertising Set Info Transfer); the Controller of that device, if its Host
// asked for transfers on the connection (LE Set Periodic Advertising Sync Transfer Parameters, or LE Set Default Periodic Advertising Sync
// Transfer Parameters before the connection), synchronizes to the train and tells its Host (LE Periodic Advertising Sync Transfer Received).
// A build without the feature (`ctl_limits.past_on()` 0) answers none of the commands and answers LL_PERIODIC_SYNC_IND with LL_UNKNOWN_RSP.

// Whether the peer of the link in slot `ls` told its features and lacks the Periodic Advertising Sync Transfer - Recipient feature (octet 3 bit 1).
@tier(embedded)
fn past_peer_lacks(var c: Controller, ls: Int) -> Bool
    c.links[ls].have_feat and (c.links[ls].peer_feat[3] as Int & 0x02) == 0

// LE Periodic Advertising Sync Transfer ([Vol 4] Part E, Section 7.8.89): the synchronization with the Sync_Handle is described to the connected
// device with the Connection_Handle; the Command Complete says the description is queued.  Unknown Advertising Identifier for a Sync_Handle that is not
// synchronized, Unknown Connection Identifier for a handle that is not a connection, Unsupported Remote Feature for a peer that said it lacks
// the feature, Command Disallowed for a connection with a transfer still waiting.
@satisfies("REQ-BLE-CTL-109")
@tier(embedded)
fn cmd_le_periodic_advertising_sync_transfer(var c: Controller)
    let op = OP_LE_PERIODIC_ADVERTISING_SYNC_TRANSFER
    let raw = param_u16(var c, 0)
    let sdata = param_u16(var c, 2)
    let j = psync_find_handle(var c, param_u16(var c, 4) & 0x0FFF)
    let ls = handle_slot(var c, raw & 0x0FFF)
    var status = STATUS_SUCCESS
    if j < 0
        status = ll_xadv.E_UNKNOWN_SET
    else if ls < 0
        status = STATUS_UNKNOWN_CONNECTION
    else if past_peer_lacks(var c, ls)
        status = STATUS_UNSUPPORTED_REMOTE
    else if c.past_tx[ls].used
        status = STATUS_COMMAND_DISALLOWED
    else
        ll_past.tx_set(var c.past_tx[ls], false, j, sdata, c.now)
    answer_handle(var c, op, status, raw)

// LE Periodic Advertising Set Info Transfer ([Vol 4] Part E, Section 7.8.90): the train of the advertising set with the Advertising_Handle is
// described to the connected device.  Unknown Advertising Identifier for a set the Host did not define, Command Disallowed for a set whose train is not
// enabled, and the errors of the command above.
@satisfies("REQ-BLE-CTL-109")
@tier(embedded)
fn cmd_le_periodic_advertising_set_info_transfer(var c: Controller)
    let op = OP_LE_PERIODIC_ADVERTISING_SET_INFO_TRANSFER
    let raw = param_u16(var c, 0)
    let sdata = param_u16(var c, 2)
    let handle = h4_rx.h4_param(var c.rx, 4)
    let i = xset_find(var c, handle)
    let k = padv_find(var c, handle)
    let ls = handle_slot(var c, raw & 0x0FFF)
    var status = STATUS_SUCCESS
    if i < 0
        status = ll_xadv.E_UNKNOWN_SET
    else if k < 0 or not c.pads[k].on
        status = STATUS_COMMAND_DISALLOWED
    else if ls < 0
        status = STATUS_UNKNOWN_CONNECTION
    else if past_peer_lacks(var c, ls)
        status = STATUS_UNSUPPORTED_REMOTE
    else if c.past_tx[ls].used
        status = STATUS_COMMAND_DISALLOWED
    else
        ll_past.tx_set(var c.past_tx[ls], true, k, sdata, c.now)
    answer_handle(var c, op, status, raw)

// LE Set Periodic Advertising Sync Transfer Parameters ([Vol 4] Part E, Section 7.8.91): how the connection receives a transfer.  It does not
// affect a transfer already received.
@satisfies("REQ-BLE-CTL-109")
@tier(embedded)
fn cmd_le_set_periodic_advertising_sync_transfer_parameters(var c: Controller)
    let op = OP_LE_SET_PERIODIC_ADVERTISING_SYNC_TRANSFER_PARAMETERS
    let raw = param_u16(var c, 0)
    let ls = handle_slot(var c, raw & 0x0FFF)
    var status = STATUS_SUCCESS
    if ls < 0
        status = STATUS_UNKNOWN_CONNECTION
    else
        status = ll_past.cfg_status(h4_rx.h4_param(var c.rx, 2),
            param_u16(var c, 3),
            param_u16(var c, 5),
            h4_rx.h4_param(var c.rx, 7))
    if status == STATUS_SUCCESS
        ll_past.cfg_set(var c.past_cfg[ls],
            h4_rx.h4_param(var c.rx, 2),
            param_u16(var c, 3),
            param_u16(var c, 5),
            h4_rx.h4_param(var c.rx, 7))
    answer_handle(var c, op, status, raw)

// LE Set Default Periodic Advertising Sync Transfer Parameters ([Vol 4] Part E, Section 7.8.92): the parameters of every connection made from
// now on.
@satisfies("REQ-BLE-CTL-109")
@tier(embedded)
fn cmd_le_set_default_periodic_advertising_sync_transfer_parameters(var c: Controller)
    let op = OP_LE_SET_DEFAULT_PERIODIC_ADVERTISING_SYNC_TRANSFER_PARAMETERS
    let status = ll_past.cfg_status(h4_rx.h4_param(var c.rx, 0),
        param_u16(var c, 1),
        param_u16(var c, 3),
        h4_rx.h4_param(var c.rx, 5))
    if status == STATUS_SUCCESS
        ll_past.cfg_set(var c.past_def,
            h4_rx.h4_param(var c.rx, 0),
            param_u16(var c, 1),
            param_u16(var c, 3),
            h4_rx.h4_param(var c.rx, 5))
    answer_status(var c, op, status)

// Run the command of Periodic Advertising Sync Transfer with `opcode`.
@tier(embedded)
fn past_dispatch(var c: Controller, opcode: Int)
    match opcode
        0x205a => cmd_le_periodic_advertising_sync_transfer(var c)
        0x205b => cmd_le_periodic_advertising_set_info_transfer(var c)
        0x205c => cmd_le_set_periodic_advertising_sync_transfer_parameters(var c)
        _      => cmd_le_set_default_periodic_advertising_sync_transfer_parameters(var c)

// The connection just opened in slot `ls` takes the Host's default transfer parameters.
@tier(embedded)
fn past_defaults(var c: Controller, ls: Int)
    ll_past.cfg_copy(var c.past_cfg[ls], var c.past_def)
    c.past_tx[ls].used = false

// The microseconds ahead of the Controller's clock that the first window of a transferred train may not open before: the rest of the connection
// event the PDU came in, and the radio's turn-around.
const PAST_LEAD_US = 4000

// LL_PERIODIC_SYNC_IND on the link in slot `ls`, read from `rx` ([Vol 6] Part B, Section 5.1.13): the Host asked to be told of transfers
// (Mode not 0), the PHY names one supported PHY, the SyncInfo is one that can be listened to, and the train is not one this device has; a slot is
// taken, the first window is planned from the link's anchor point of this event, and the Host is told with LE Periodic Advertising Sync Transfer
// Received once the first AUX_SYNC_IND comes or six events pass.  Any other PDU is ignored.
@satisfies("REQ-BLE-CTL-109")
@tier(embedded)
fn past_rx(var c: Controller, ls: Int, var rx: Pdu)
    if not ctl_limits.past_on() or not ctl_limits.per_on() or c.past_cfg[ls].mode == ll_past.MODE_OFF
        return
    let at = 2 + ll_past.AT_SYNC_INFO
    let phy = ll_past.phy_of(ll_data.dpdu_byte(var rx, ll_past.AT_PHY))
    if phy == 0 or not phy_supported(var c, phy)
        return
    let pai = ll_per.si_interval(var rx, at)
    if pai < ll_per.INTERVAL_MIN or ll_link.popcount(ll_per.si_chmap(var rx, at)) < 2 or not ll_init.aa_valid(ll_per.si_aa(var rx, at))
        return
    let who = ll_data.dpdu_byte(var rx, ll_past.AT_SID)
    let sid = who & 0x0F
    let kind = (who >>> 4) & 1
    var a: Vec[u8; 6] = Vec.new()
    for k in 0..6
        let _p = a.push(ll_data.dpdu_byte(var rx, ll_past.AT_ADVA + k) as u8)
    if psync_is_synced(var c, sid, kind, var a)
        return
    let j = psync_free_slot(var c)
    if j < 0
        return
    let ppm_a = ll_link.sca_ppm(ll_per.si_sca(var rx, at))
    let ppm_b = ll_link.sca_ppm((who >>> 5) & 7)
    var pl = ll_past.plan_receive(ll_past.rx_offset_us(var rx, at), ll_past.rx_unit_us(var rx, at), ll_per.si_counter(var rx, at),
                                  ll_data.dpdu_u16(var rx, ll_past.AT_LAST_PE), ll_data.dpdu_u16(var rx, ll_past.AT_CE_REF), ll_data.dpdu_u16(var rx, ll_past.AT_CE_SYNC),
                                  pai * ll_per.INTERVAL_UNIT_US, ppm_a, ppm_b, c.links[ls].ev_count, c.links[ls].anchor, ll_link.interval_us(var c.links[ls]),
                                  c.now, PAST_LEAD_US)
    ll_past.psync_begin(var c.psyncs[j], j, var rx, at, kind, var a, sid, phy, var pl, c.past_cfg[ls].timeout, ll_past.cfg_reports(var c.past_cfg[ls]),
                        c.links[ls].handle, ll_data.dpdu_u16(var rx, ll_past.AT_ID), c.now)
    if ctl_limits.pawr_sync_on()
        ll_pawr.ps_clear(var c.pws[j])

// Send the transfer waiting on the link in slot `ls`, when the link has an anchor point to count the offset from: the event just ended had a
// packet from the peer, so its anchor point is the time of the first packet and the event before the one under way is its counter.  False when
// it waits (the link has no such event yet, or the train is not sending yet), true when it was sent or given up (the link or the train is gone,
// or the peer lacks the feature).
@satisfies("REQ-BLE-CTL-109")
@tier(embedded)
fn past_send(var c: Controller, ls: Int) -> Bool
    if not ctl_conn_active(var c, ls) or past_peer_lacks(var c, ls)
        c.past_tx[ls].used = false
        return true
    if c.now - c.past_tx[ls].t0 > ll_past.WAIT_US
        c.past_tx[ls].used = false
        return true
    if c.links[ls].ev_open or not c.links[ls].ev_anchor or c.links[ls].last_rx < c.links[ls].anchor or c.links[ls].upd_pending
        return false
    let a0 = c.links[ls].anchor
    let ces = (c.links[ls].ev_count - 1) & 0xFFFF
    let ci = ll_link.interval_us(var c.links[ls])
    let k = c.past_tx[ls].train
    var ok = false
    if c.past_tx[ls].own
        if k >= ctl_limits.padv_n() or not c.pads[k].used or not c.pads[k].on
            c.past_tx[ls].used = false
            return true
        let i = xset_find(var c, c.pads[k].handle)
        if i < 0
            c.past_tx[ls].used = false
            return true
        if not c.pads[k].run or not c.pads[k].sent
            return false
        // The SyncInfo names the start of an event (subevent 0 of a train with responses): `ev_due` and `ev_ctr` are the next such event.
        var o = ll_past.plan_offer(ll_per.ev_due(var c.pads[k]),
            ll_per.ev_ctr(var c.pads[k]),
            ll_per.interval_us(var c.pads[k]),
            a0,
            ces,
            ci,
            c.now)
        if o.ok
            if ctl_limits.pawr_adv_on() and c.pads[k].pawr
                // A train with responses is described by LL_PERIODIC_SYNC_WR_IND, which adds the timing of the subevents and the response slots.
                ll_past.put_sync_wr_ind(var c.links[ls].tmp, c.past_tx[ls].sdata, var o, c.pads[k].interval, c.pads[k].chmap, ll_link.OWN_SCA, c.pads[k].aa,
                                        c.pads[k].crc, c.pads[k].last_ctr, c.xsets[i].sid as Int, c.xsets[i].atype as Int, ll_link.OWN_SCA,
                                        c.xsets[i].sphy as Int, var c.xsets[i].addr, ces, var c.pads[k].acad)
            else
                ll_past.put_sync_ind(var c.links[ls].tmp, c.past_tx[ls].sdata, var o, c.pads[k].interval, c.pads[k].chmap, ll_link.OWN_SCA, c.pads[k].aa,
                                     c.pads[k].crc, c.pads[k].last_ctr, c.xsets[i].sid as Int, c.xsets[i].atype as Int, ll_link.OWN_SCA,
                                     c.xsets[i].sphy as Int, var c.xsets[i].addr, ces)
            ok = true
    else
        if k >= ctl_limits.psync_n() or c.psyncs[k].state != ll_per.PS_SYNCED
            c.past_tx[ls].used = false
            return true
        var o = ll_past.plan_offer(c.psyncs[k].last_ok,
            c.psyncs[k].cx_counter,
            ll_per.psync_interval_us(var c.psyncs[k]),
            a0,
            ces,
            ci,
            c.now)
        if o.ok
            ll_past.put_sync_ind(var c.links[ls].tmp, c.past_tx[ls].sdata, var o, c.psyncs[k].interval, c.psyncs[k].chmap, c.psyncs[k].sca, c.psyncs[k].aa,
                                 c.psyncs[k].crc, c.psyncs[k].cx_counter, c.psyncs[k].sid, c.psyncs[k].kind, ll_link.OWN_SCA,
                                 c.psyncs[k].phy, var c.psyncs[k].addr, ces)
            ok = true
    if not ok
        c.past_tx[ls].used = false
        return true
    if iso_send(c, ls)
        c.past_tx[ls].used = false
        return true
    false

// The transfers the Host asked for that can go now.  True when something was done.
@satisfies("REQ-BLE-CTL-109")
@tier(embedded)
fn ctl_past_poll(var c: Controller) -> Bool
    if not ctl_limits.past_on() or not ctl_limits.per_on()
        return false
    var did = false
    for ls in 0..noble_controller_config.CTL_LINKS
        if c.past_tx[ls].used and past_send(var c, ls)
            did = true
    did

// ── The Observer commands ───────────────────────────────────────────

// The scan parameters ([Vol 4] Part E, Section 7.8.10).
@satisfies("REQ-BLE-CTL-009")
@tier(embedded)
fn cmd_le_set_scan_parameters(var c: Controller)
    let op = OP_LE_SET_SCAN_PARAMETERS
    if c.scan.enabled or (c.scan.fam as Int) == 2
        answer_status(var c, op, STATUS_COMMAND_DISALLOWED)
        return
    let ty = h4_rx.h4_param(var c.rx, 0)
    let interval = param_u16(var c, 1)
    let window = param_u16(var c, 3)
    let own = h4_rx.h4_param(var c.rx, 5)
    let policy = h4_rx.h4_param(var c.rx, 6)
    let status = ll_scan.scan_params_status(ty, interval, window, own, policy)
    if status != STATUS_SUCCESS
        answer_status(var c, op, status)
        return
    ll_scan.scan_set_params(var c.scan, ty, interval, window, own, policy)
    c.scan.fam = 1
    answer_status(var c, op, STATUS_SUCCESS)

// Start or stop scanning ([Vol 4] Part E, Section 7.8.11).
@satisfies("REQ-BLE-CTL-009")
@tier(embedded)
fn cmd_le_set_scan_enable(var c: Controller)
    let op = OP_LE_SET_SCAN_ENABLE
    let on = h4_rx.h4_param(var c.rx, 0)
    let dup = h4_rx.h4_param(var c.rx, 1)
    if (c.scan.fam as Int) == 2
        answer_status(var c, op, STATUS_COMMAND_DISALLOWED)
        return
    if on > 1 or dup > 1
        answer_status(var c, op, STATUS_INVALID_PARAMETERS)
        return
    if on == 0
        if c.scan.enabled
            ll_scan.scan_disable(var c.scan)
            ll_arb.arb_cancel(var c.arb, ll_arb.class_scan())
        answer_status(var c, op, STATUS_SUCCESS)
        return
    let own = c.scan.own as Int
    if not own_address_ready(var c, own & 1)
        answer_status(var c, op, STATUS_INVALID_PARAMETERS)
        return
    // Scanning does not run beside the Initiating state (LE_States bits 22 and 23).
    if c.init.enabled and not c.scan.enabled
        answer_status(var c, op, STATUS_COMMAND_DISALLOWED)
        return
    if (own & 1) == 0
        ll_scan.scan_enable(var c.scan, c.now, dup == 1, var c.public, 0)
    else
        ll_scan.scan_enable(var c.scan, c.now, dup == 1, var c.random, 1)
    c.scan.fam = 1
    answer_status(var c, op, STATUS_SUCCESS)

// ── The extended Observer commands ─────────────────────────────────

// The octets of the parameters of one PHY in LE Set Extended Scan Parameters: Scan_Type, Scan_Interval and
// Scan_Window.
const XSCAN_SET_OCTETS = 5

// Whether this Controller's radio can send and receive on `phy`.  LE Coded needs the radio to say it has it
// (`ll_radio.Radio.supports_phy`, `ctl_set_coded`).
@tier(embedded)
fn phy_supported(var c: Controller, phy: Int) -> Bool
    if phy == ll_phy.PHY_CODED
        return c.coded
    true

// The radio under the Controller said whether it has LE Coded (`ll_air.air_profile`).  A Controller that was not told assumes
// it has, as the earlier Link Layer did.
@tier(embedded)
fn ctl_set_coded(var c: Controller, coded: Bool)
    c.coded = coded

// The mask of the PHYs the radio has, as LE Set PHY and the PHY preferences number them.
@tier(embedded)
fn phy_mask(var c: Controller) -> Int
    if c.coded
        return ll_phy.MASK_ALL
    ll_phy.MASK_1M | ll_phy.MASK_2M

// LE Set Extended Scan Parameters ([Vol 4] Part E, Section 7.8.64): the Own_Address_Type and the Scanning
// Filter Policy of the Controller, and for each PHY in Scanning_PHYs the Scan_Type, Scan_Interval and
// Scan_Window.  Command Disallowed while scanning is on, and once the Host has used the legacy scan commands
// (a Reset undoes that).  A PHY the radio lacks is Unsupported Feature or Parameter Value.
@satisfies("REQ-BLE-CTL-090")
@tier(embedded)
fn cmd_le_set_extended_scan_parameters(var c: Controller)
    let op = OP_LE_SET_EXTENDED_SCAN_PARAMETERS
    if c.scan.enabled or (c.scan.fam as Int) == 1
        answer_status(var c, op, STATUS_COMMAND_DISALLOWED)
        return
    let own = h4_rx.h4_param(var c.rx, 0)
    let policy = h4_rx.h4_param(var c.rx, 1)
    let phys = h4_rx.h4_param(var c.rx, 2)
    var status = ll_scan.xscan_status(own, policy, phys)
    var at = 3
    var ty = 0
    var interval = 0
    var window = 0
    var c_ty = 0
    var c_interval = 0
    var c_window = 0
    if status == STATUS_SUCCESS and (phys & ll_scan.XPHY_1M) != 0
        ty = h4_rx.h4_param(var c.rx, at)
        interval = param_u16(var c, at + 1)
        window = param_u16(var c, at + 3)
        status = ll_scan.xscan_set_status(ty, interval, window)
        at = at + XSCAN_SET_OCTETS
    if status == STATUS_SUCCESS and (phys & ll_scan.XPHY_CODED) != 0
        c_ty = h4_rx.h4_param(var c.rx, at)
        c_interval = param_u16(var c, at + 1)
        c_window = param_u16(var c, at + 3)
        status = ll_scan.xscan_set_status(c_ty, c_interval, c_window)
    if status == STATUS_SUCCESS and (phys & ll_scan.XPHY_CODED) != 0 and not phy_supported(var c, ll_phy.PHY_CODED)
        status = STATUS_UNSUPPORTED_FEATURE
    if status != STATUS_SUCCESS
        answer_status(var c, op, status)
        return
    ll_scan.xscan_set_params(var c.scan, own, policy, phys)
    if (phys & ll_scan.XPHY_1M) != 0
        c.scan.ty = ty as u8
        c.scan.interval = interval
        c.scan.window = window
    if (phys & ll_scan.XPHY_CODED) != 0
        c.scan.c_ty = c_ty as u8
        c.scan.c_interval = c_interval
        c.scan.c_window = c_window
        if (phys & ll_scan.XPHY_1M) == 0
            c.scan.ty = c_ty as u8
            c.scan.interval = c_interval
            c.scan.window = c_window
    c.scan.fam = 2
    answer_status(var c, op, STATUS_SUCCESS)

// LE Set Extended Scan Enable ([Vol 4] Part E, Section 7.8.65): start or stop scanning with the parameters of
// LE Set Extended Scan Parameters (the defaults, LE 1M passive at 10 ms, when the Host gave none), with the
// Filter_Duplicates mode (0 off, 1 on, 2 on and emptied at each period), a Duration in units of 10 ms
// (0: until disabled) and a Period in units of 1.28 s.  A Duration that runs out with no Period ends the
// state and is told with the LE Scan Timeout event.
@satisfies("REQ-BLE-CTL-090")
@tier(embedded)
fn cmd_le_set_extended_scan_enable(var c: Controller)
    let op = OP_LE_SET_EXTENDED_SCAN_ENABLE
    let on = h4_rx.h4_param(var c.rx, 0)
    let dup = h4_rx.h4_param(var c.rx, 1)
    let dur = param_u16(var c, 2)
    let period = param_u16(var c, 4)
    if (c.scan.fam as Int) == 1
        answer_status(var c, op, STATUS_COMMAND_DISALLOWED)
        return
    if on > 1 or dup > 2
        answer_status(var c, op, STATUS_INVALID_PARAMETERS)
        return
    if on == 0
        if c.scan.enabled
            ll_scan.scan_disable(var c.scan)
            ll_arb.arb_cancel(var c.arb, ll_arb.class_scan())
        c.scan.timeout_owed = false
        answer_status(var c, op, STATUS_SUCCESS)
        return
    if not ll_scan.xscan_timing_ok(dur, period)
        answer_status(var c, op, STATUS_INVALID_PARAMETERS)
        return
    let own = c.scan.own as Int
    if not own_address_ready(var c, own & 1)
        answer_status(var c, op, STATUS_INVALID_PARAMETERS)
        return
    if c.init.enabled and not c.scan.enabled
        answer_status(var c, op, STATUS_COMMAND_DISALLOWED)
        return
    c.scan.ext = true
    c.scan.fam = 2
    c.scan.timeout_owed = false
    if (own & 1) == 0
        ll_scan.xscan_enable(var c.scan, c.now, dup, dur, period, var c.public, 0)
    else
        ll_scan.xscan_enable(var c.scan, c.now, dup, dur, period, var c.random, 1)
    answer_status(var c, op, STATUS_SUCCESS)

// The Duration of an extended scan ran out with no Period: LE Scan Timeout ([Vol 4] Part E, Section 7.7.65.17).
@satisfies("REQ-BLE-CTL-090")
@tier(embedded)
fn ev_scan_timeout(var c: Controller)
    if not le_event_enabled(var c, SUB_LE_SCAN_TIMEOUT)
        c.scan.timeout_owed = false
        return
    if ctl_pool.pool_free(var c.pool) < 2
        return
    let slot = ctl_pool.evt_begin(var c.pool, hci_frame.EVT_LE_META_EVENT)
    let _a = ctl_pool.pool_put(var c.pool, slot, SUB_LE_SCAN_TIMEOUT)
    let _b = ctl_pool.evt_send(var c.pool, slot)
    c.scan.timeout_owed = false

// ── The Filter Accept List ──────────────────────────────────────────

// Empty the list.
@satisfies("REQ-BLE-CTL-006")
@tier(embedded)
fn fal_clear(var c: Controller)
    for i in 0..FILTER_ACCEPT_LIST_SIZE
        c.fal_used[i] = false
        c.fal_type[i] = 0
        for k in 0..6
            c.fal_addr[i * 6 + k] = 0

// The entries in the list.
@tier(embedded)
fn fal_count(var c: Controller) -> Int
    var n = 0
    for i in 0..FILTER_ACCEPT_LIST_SIZE
        if c.fal_used[i]
            n = n + 1
    n

// The entry holding the device (`kind`, the six octets the command carries
// from parameter `at`), -1 for none.  The Address_Type 0xFF stands for the
// devices that send anonymous advertisements and has no address to compare.
@tier(embedded)
fn fal_find(var c: Controller, kind: Int, at: Int) -> Int
    for i in 0..FILTER_ACCEPT_LIST_SIZE
        if c.fal_used[i] and (c.fal_type[i] as Int) == kind
            var same = true
            if kind != 0xFF
                for k in 0..6
                    if (c.fal_addr[i * 6 + k] as Int) != h4_rx.h4_param(var c.rx, at + k)
                        same = false
            if same
                return i
    -1

// The Address_Type values of the list: public, random, and anonymous.
@tier(embedded)
fn fal_type_valid(kind: Int) -> Bool
    kind == 0 or kind == 1 or kind == 0xFF

// Whether an activity that is on uses the Filter Accept List: advertising with
// a filter policy that reads it (directed advertising ignores the policy),
// scanning with the filtered policy, or initiating with it.  The list does not change meanwhile
// ([Vol 4] Part E, Sections 7.8.15 to 7.8.17).
@tier(embedded)
fn fal_in_use(var c: Controller) -> Bool
    if c.adv.enabled and (c.adv.policy as Int) != ll_adv.POLICY_ALL and not ll_adv.is_directed(c.adv.ty as Int)
        return true
    for i in 0..ctl_limits.sets()
        if c.xsets[i].on and (c.xsets[i].policy as Int) != 0 and (c.xsets[i].props & ll_xadv.P_DIRECT) == 0
            return true
    if c.init.enabled and (c.init.policy as Int) == ll_init.POLICY_LIST
        return true
    c.scan.enabled and (c.scan.policy as Int) == ll_scan.POLICY_LIST

@tier(embedded)
fn cmd_le_clear_fal(var c: Controller)
    if fal_in_use(var c)
        answer_status(var c, OP_LE_CLEAR_FILTER_ACCEPT_LIST, STATUS_COMMAND_DISALLOWED)
        return
    fal_clear(var c)
    answer_status(var c, OP_LE_CLEAR_FILTER_ACCEPT_LIST, STATUS_SUCCESS)

// Add the device to the first free entry.  A device that is in the list
// already is not added again ([Vol 4] Part E, Section 7.8.16).
@satisfies("REQ-BLE-CTL-006")
@tier(embedded)
fn cmd_le_add_to_fal(var c: Controller)
    if fal_in_use(var c)
        answer_status(var c, OP_LE_ADD_DEVICE_TO_FILTER_ACCEPT_LIST, STATUS_COMMAND_DISALLOWED)
        return
    let kind = h4_rx.h4_param(var c.rx, 0)
    if not fal_type_valid(kind)
        answer_status(var c, OP_LE_ADD_DEVICE_TO_FILTER_ACCEPT_LIST, STATUS_INVALID_PARAMETERS)
        return
    if fal_find(var c, kind, 1) >= 0
        answer_status(var c, OP_LE_ADD_DEVICE_TO_FILTER_ACCEPT_LIST, STATUS_SUCCESS)
        return
    for i in 0..FILTER_ACCEPT_LIST_SIZE
        if not c.fal_used[i]
            c.fal_used[i] = true
            c.fal_type[i] = kind as u8
            for k in 0..6
                c.fal_addr[i * 6 + k] = h4_rx.h4_param(var c.rx, 1 + k) as u8
            answer_status(var c, OP_LE_ADD_DEVICE_TO_FILTER_ACCEPT_LIST, STATUS_SUCCESS)
            return
    answer_status(var c, OP_LE_ADD_DEVICE_TO_FILTER_ACCEPT_LIST, STATUS_MEMORY_CAPACITY_EXCEEDED)

// Remove the device.  A device that is not in the list leaves it as it is
// and the command succeeds ([Vol 4] Part E, Section 7.8.17).
@satisfies("REQ-BLE-CTL-006")
@tier(embedded)
fn cmd_le_remove_from_fal(var c: Controller)
    if fal_in_use(var c)
        answer_status(var c, OP_LE_REMOVE_DEVICE_FROM_FILTER_ACCEPT_LIST, STATUS_COMMAND_DISALLOWED)
        return
    let kind = h4_rx.h4_param(var c.rx, 0)
    if not fal_type_valid(kind)
        answer_status(var c, OP_LE_REMOVE_DEVICE_FROM_FILTER_ACCEPT_LIST, STATUS_INVALID_PARAMETERS)
        return
    let i = fal_find(var c, kind, 1)
    if i >= 0
        c.fal_used[i] = false
        c.fal_type[i] = 0
        for k in 0..6
            c.fal_addr[i * 6 + k] = 0
    answer_status(var c, OP_LE_REMOVE_DEVICE_FROM_FILTER_ACCEPT_LIST, STATUS_SUCCESS)

@tier(embedded)
fn cmd_le_read_fal_size(var c: Controller)
    let slot = complete_begin(var c, OP_LE_READ_FILTER_ACCEPT_LIST_SIZE, STATUS_SUCCESS)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put(var c.pool, slot, FILTER_ACCEPT_LIST_SIZE)
    complete_send(var c, slot)

// ── Answers of the connection commands ──────────────────────────────

// Answer `opcode` with a Command Status event: the status, a
// Num_HCI_Command_Packets of 1 and the opcode.  The command's result follows
// as an event of its own.
@tier(embedded)
fn answer_command_status(var c: Controller, opcode: Int, status: Int)
    let slot = ctl_pool.evt_begin(var c.pool, hci_frame.EVT_COMMAND_STATUS)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put(var c.pool, slot, status)
    let _b = ctl_pool.pool_put(var c.pool, slot, 1)
    let _c = ctl_pool.pool_put_u16(var c.pool, slot, opcode)
    complete_send(var c, slot)

// The connection handle in the first two octets of the command's parameters.
@tier(embedded)
fn param_handle(var c: Controller) -> Int
    param_u16(var c, 0) & 0x0FFF

// ── The links ───────────────────────────────────────────────────────

// Whether the link in `slot` is a connection that is on.
@tier(embedded)
fn slot_live(var c: Controller, slot: Int) -> Bool
    ll_link.link_live(var c.links[slot])

// Whether the link in `slot` is the Central of its connection.
@tier(embedded)
fn slot_central(var c: Controller, slot: Int) -> Bool
    ll_link.link_live(var c.links[slot]) and c.links[slot].central

// Whether the slot is taken: a connection is on, or the Host is still owed an
// event of one that ended.
@tier(embedded)
fn slot_busy(var c: Controller, slot: Int) -> Bool
    ll_link.link_live(var c.links[slot]) or c.links[slot].owed != 0

// The lowest slot not taken, -1 for none.
@satisfies("REQ-BLE-CTL-024")
@tier(embedded)
fn free_slot(var c: Controller) -> Int
    for slot in 0..noble_controller_config.CTL_LINKS
        if not slot_busy(var c, slot)
            return slot
    -1

// The number of slots not taken.
@tier(embedded)
fn free_slots(var c: Controller) -> Int
    var n = 0
    for slot in 0..noble_controller_config.CTL_LINKS
        if not slot_busy(var c, slot)
            n = n + 1
    n

// The number of connections that are on as Central (`central`) or as Peripheral.
@tier(embedded)
fn role_count(var c: Controller, central: Bool) -> Int
    var n = 0
    for slot in 0..noble_controller_config.CTL_LINKS
        if slot_live(var c, slot) and slot_central(var c, slot) == central
            n = n + 1
    n

// Whether a connectable advertisement can be taken as a connection: a slot is
// free beside the one the Initiating state is to take, and the Peripheral limit
// is not reached.
@satisfies("REQ-BLE-CTL-024")
@tier(embedded)
fn peripheral_room(var c: Controller) -> Bool
    var reserved = 0
    if c.init.enabled
        reserved = 1
    role_count(var c, false) < noble_controller_config.CTL_PERIPHERAL and free_slots(var c) - reserved > 0

// The slot of the connection with `handle`, -1 for a handle that is not on.
@satisfies("REQ-BLE-CTL-024")
@tier(embedded)
fn handle_slot(var c: Controller, handle: Int) -> Int
    for slot in 0..noble_controller_config.CTL_LINKS
        if slot_live(var c, slot) and handle == slot + 1
            return slot
    -1

// The arbiter class that books the connection events of the link in `slot`.
@tier(embedded)
fn slot_class(slot: Int) -> Int
    ll_arb.class_acl() + slot

// The access address of the connection in `slot`, 0 for a link that is not on
// (which no connection has) and for a slot the build does not have: a build with
// `ctl_links = 1` asks for the second slot when it picks the address of a new connection.
@tier(embedded)
fn slot_aa(var c: Controller, slot: Int) -> Int
    if slot >= noble_controller_config.CTL_LINKS or not slot_live(var c, slot)
        return 0
    c.links[slot].aa

// ── The connection commands ─────────────────────────────────────────

// The Reason values a Host may give HCI Disconnect ([Vol 4] Part E, Section
// 7.1.6).
@tier(embedded)
fn disconnect_reason_ok(reason: Int) -> Bool
    reason == 0x05 or reason == 0x13 or reason == 0x14 or reason == 0x15
        or reason == 0x1A or reason == 0x29 or reason == 0x3B

// Disconnect ([Vol 4] Part E, Section 7.1.6): the answer is a Command Status
// event, and the Disconnection Complete event follows when the peer has
// acknowledged the termination.
@satisfies("REQ-BLE-CTL-018")
@tier(embedded)
fn cmd_disconnect(var c: Controller)
    let reason = h4_rx.h4_param(var c.rx, 2)
    if not disconnect_reason_ok(reason)
        answer_command_status(var c, OP_DISCONNECT, STATUS_INVALID_PARAMETERS)
        return
    var ci = -1
    if ctl_limits.iso_on()
        ci = cis_slot(var c, param_handle(var c))
    if ci >= 0 and iso_on(var c)
        let st = c.cis[ci].state
        if st == ll_iso.S_CONFIG
            answer_command_status(var c, OP_DISCONNECT, STATUS_UNKNOWN_CONNECTION)
        else if st == ll_iso.S_CLOSING
            answer_command_status(var c, OP_DISCONNECT, STATUS_COMMAND_DISALLOWED)
        else
            cis_disconnect(var c, ci, reason)
            answer_command_status(var c, OP_DISCONNECT, STATUS_SUCCESS)
        return
    let slot = handle_slot(var c, param_handle(var c))
    if slot < 0
        answer_command_status(var c, OP_DISCONNECT, STATUS_UNKNOWN_CONNECTION)
    else
        answer_command_status(var c, OP_DISCONNECT, ll_link.link_disconnect(var c.links[slot], reason))

// Read Remote Version Information ([Vol 4] Part E, Section 7.1.23).
@satisfies("REQ-BLE-CTL-020")
@tier(embedded)
fn cmd_read_remote_version(var c: Controller)
    let slot = handle_slot(var c, param_handle(var c))
    if slot < 0
        answer_command_status(var c, OP_READ_REMOTE_VERSION, STATUS_UNKNOWN_CONNECTION)
    else
        answer_command_status(var c, OP_READ_REMOTE_VERSION, ll_link.link_read_version(var c.links[slot]))

// LE Read Remote Features ([Vol 4] Part E, Section 7.8.21).
@satisfies("REQ-BLE-CTL-020")
@tier(embedded)
fn cmd_le_read_remote_features(var c: Controller)
    let slot = handle_slot(var c, param_handle(var c))
    if slot < 0
        answer_command_status(var c, OP_LE_READ_REMOTE_FEATURES, STATUS_UNKNOWN_CONNECTION)
    else
        answer_command_status(var c, OP_LE_READ_REMOTE_FEATURES, ll_link.link_read_features(var c.links[slot]))

// LE Read All Remote Features ([Vol 4] Part E, Section 7.8.129): Command Status now, LE Read All Remote Features Complete when the pages are in.
@satisfies("REQ-BLE-CTL-117")
@tier(embedded)
fn cmd_le_read_all_remote(var c: Controller)
    let slot = handle_slot(var c, param_handle(var c))
    if slot < 0
        answer_command_status(var c, OP_LE_READ_ALL_REMOTE_FEATURES, STATUS_UNKNOWN_CONNECTION)
    else
        answer_command_status(var c,
            OP_LE_READ_ALL_REMOTE_FEATURES,
            ll_link.link_read_all_features(var c.links[slot], h4_rx.h4_param(var c.rx, 2)))

// LE Read Channel Map ([Vol 4] Part E, Section 7.8.20): the handle and the five
// octets of the map in use.
@satisfies("REQ-BLE-CTL-020")
@tier(embedded)
fn cmd_le_read_channel_map(var c: Controller)
    let handle = param_handle(var c)
    let slot = complete_begin(var c, OP_LE_READ_CHANNEL_MAP, STATUS_SUCCESS)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put_u16(var c.pool, slot, handle)
    let at = handle_slot(var c, handle)
    if at < 0
        ctl_pool.pool_patch(var c.pool, slot, 6, STATUS_UNKNOWN_CONNECTION)
        put_zeros(var c, slot, 5)
    else
        let map = c.links[at].chmap
        for k in 0..5
            let _b = ctl_pool.pool_put(var c.pool, slot, (map >>> (8 * k)) & 0xFF)
    complete_send(var c, slot)

// The Command Complete event that returns a status and the connection handle.
@tier(embedded)
fn answer_handle(var c: Controller, opcode: Int, status: Int, handle: Int)
    let slot = complete_begin(var c, opcode, status)
    // cov: skip — ctl_step runs a command only with a free slot for its answer
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put_u16(var c.pool, slot, handle)
    complete_send(var c, slot)

// Read Transmit Power Level ([Vol 4] Part E, Section 7.3.35): the level the connection
// transmits at (Type 0) or the most the radio can (Type 1), in dBm.  The answer carries the
// handle whatever the status.
@satisfies("REQ-BLE-CTL-064")
@tier(embedded)
fn cmd_read_transmit_power_level(var c: Controller)
    let handle = param_handle(var c)
    let kind = h4_rx.h4_param(var c.rx, 2)
    var status = STATUS_SUCCESS
    if handle_slot(var c, handle) < 0
        status = STATUS_UNKNOWN_CONNECTION
    else if kind > 1
        status = STATUS_INVALID_PARAMETERS
    let slot = complete_begin(var c, OP_READ_TRANSMIT_POWER_LEVEL, status)
    if slot == ctl_pool.NO_SLOT
        return
    var level = 0
    if status == STATUS_SUCCESS
        level = TX_POWER_DBM
        if kind == 1
            level = TX_POWER_MAX_DBM
    let _a = ctl_pool.pool_put_u16(var c.pool, slot, handle)
    let _b = ctl_pool.pool_put(var c.pool, slot, level & 0xFF)
    complete_send(var c, slot)

// Read RSSI ([Vol 4] Part E, Section 7.5.4): the signal strength of the last packet the
// link received, in dBm, or 127 when it has received none or the radio gave no reading.
@satisfies("REQ-BLE-CTL-064")
@tier(embedded)
fn cmd_read_rssi(var c: Controller)
    let handle = param_handle(var c)
    let at = handle_slot(var c, handle)
    var status = STATUS_SUCCESS
    if at < 0
        status = STATUS_UNKNOWN_CONNECTION
    let slot = complete_begin(var c, OP_READ_RSSI, status)
    if slot == ctl_pool.NO_SLOT
        return
    var rssi = 0
    if at >= 0
        rssi = c.links[at].rssi
    let _a = ctl_pool.pool_put_u16(var c.pool, slot, handle)
    let _b = ctl_pool.pool_put(var c.pool, slot, rssi & 0xFF)
    complete_send(var c, slot)

// The radio program read `rssi` dBm from the last packet the link in `slot` received.
@tier(embedded)
fn lk_note_rssi(var c: Controller, slot: Int, rssi: Int)
    c.links[slot].rssi = rssi
    if ctl_limits.ploss_on()
        ploss_sample(var c, slot, rssi)

// LE Connection Update ([Vol 4] Part E, Section 7.8.18): the answer is a Command
// Status event, and LE Connection Update Complete follows when the parameters
// apply or the procedure fails.
@satisfies("REQ-BLE-CTL-026")
@satisfies("REQ-BLE-CTL-027")
@tier(embedded)
fn cmd_le_connection_update(var c: Controller)
    let op = OP_LE_CONNECTION_UPDATE
    let slot = handle_slot(var c, param_handle(var c))
    if slot < 0
        answer_command_status(var c, op, STATUS_UNKNOWN_CONNECTION)
    else if param_u16(var c, 10) > param_u16(var c, 12)
        answer_command_status(var c, op, STATUS_INVALID_PARAMETERS)
    else
        answer_command_status(var c, op, ll_link.link_connection_update(var c.links[slot],
            param_u16(var c, 2),
            param_u16(var c, 4),
            param_u16(var c, 6),
            param_u16(var c, 8)))

// ── The data length and PHY commands ────────────────────────────────

// LE Set Data Length ([Vol 4] Part E, Section 7.8.33): the Host's preferred octets and time
// of a transmitted PDU on the connection, which the peer is told of.  The answer is a Command
// Complete with the handle; LE Data Length Change follows when the effective values change.
@satisfies("REQ-BLE-CTL-041")
@tier(embedded)
fn cmd_le_set_data_length(var c: Controller)
    let handle = param_handle(var c)
    let at = handle_slot(var c, handle)
    var status = STATUS_UNKNOWN_CONNECTION
    if at >= 0
        status = ll_link.link_set_data_length(var c.links[at], param_u16(var c, 2), param_u16(var c, 4))
    answer_handle(var c, OP_LE_SET_DATA_LENGTH, status, handle)

// LE Read Suggested Default Data Length (Section 7.8.34).
@satisfies("REQ-BLE-CTL-041")
@tier(embedded)
fn cmd_le_read_suggested_default_data_length(var c: Controller)
    let slot = complete_begin(var c, OP_LE_READ_SUGGESTED_DEFAULT_DATA_LENGTH, STATUS_SUCCESS)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put_u16(var c.pool, slot, c.dl_sugg_octets)
    let _b = ctl_pool.pool_put_u16(var c.pool, slot, c.dl_sugg_time)
    complete_send(var c, slot)

// LE Write Suggested Default Data Length (Section 7.8.35): 27 to 251 octets and 328 to 17040
// microseconds, for the connections that begin after it.
@satisfies("REQ-BLE-CTL-041")
@tier(embedded)
fn cmd_le_write_suggested_default_data_length(var c: Controller)
    let octets = param_u16(var c, 0)
    let max_time = param_u16(var c, 2)
    if octets < ll_phy.PAYLOAD_MIN or octets > ll_phy.PAYLOAD_MAX or max_time < ll_phy.TIME_MIN or max_time > ll_phy.TIME_MAX
        answer_status(var c, OP_LE_WRITE_SUGGESTED_DEFAULT_DATA_LENGTH, STATUS_INVALID_PARAMETERS)
        return
    c.dl_sugg_octets = octets
    c.dl_sugg_time = max_time
    c.dl_sugg_set = true
    answer_status(var c, OP_LE_WRITE_SUGGESTED_DEFAULT_DATA_LENGTH, STATUS_SUCCESS)

// LE Read Maximum Data Length (Section 7.8.46): the octets and the time the Link Layer
// transmits and receives in the longest packet.
@satisfies("REQ-BLE-CTL-041")
@tier(embedded)
fn cmd_le_read_maximum_data_length(var c: Controller)
    let slot = complete_begin(var c, OP_LE_READ_MAXIMUM_DATA_LENGTH, STATUS_SUCCESS)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put_u16(var c.pool, slot, ll_phy.PAYLOAD_MAX)
    let _b = ctl_pool.pool_put_u16(var c.pool, slot, ll_phy.TIME_MAX)
    let _c = ctl_pool.pool_put_u16(var c.pool, slot, ll_phy.PAYLOAD_MAX)
    let _d = ctl_pool.pool_put_u16(var c.pool, slot, ll_phy.TIME_MAX)
    complete_send(var c, slot)

// LE Read PHY ([Vol 4] Part E, Section 7.8.47): the PHY in force, the same for both directions.
@satisfies("REQ-BLE-CTL-043")
@tier(embedded)
fn cmd_le_read_phy(var c: Controller)
    let handle = param_handle(var c)
    let slot = complete_begin(var c, OP_LE_READ_PHY, STATUS_SUCCESS)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put_u16(var c.pool, slot, handle)
    let at = handle_slot(var c, handle)
    var phy = 0
    if at >= 0
        phy = c.links[at].phy
    else
        ctl_pool.pool_patch(var c.pool, slot, 6, STATUS_UNKNOWN_CONNECTION)
    let _b = ctl_pool.pool_put(var c.pool, slot, phy)
    let _d = ctl_pool.pool_put(var c.pool, slot, phy)
    complete_send(var c, slot)

// LE Set Default PHY (Section 7.8.48): the PHYs the Host prefers for the connections that begin
// after it, or no preference.  Unsupported Feature or Parameter Value for a bit that is no PHY of
// this Controller or for two different sets, which would be an asymmetric connection.
@satisfies("REQ-BLE-CTL-043")
@tier(embedded)
fn cmd_le_set_default_phy(var c: Controller)
    let all = h4_rx.h4_param(var c.rx, 0)
    var t = h4_rx.h4_param(var c.rx, 1)
    var r = h4_rx.h4_param(var c.rx, 2)
    let have = phy_mask(var c)
    if (all & 1) != 0
        t = have
    if (all & 2) != 0
        r = have
    if t == 0 or r == 0
        answer_status(var c, OP_LE_SET_DEFAULT_PHY, STATUS_INVALID_PARAMETERS)
        return
    if (t & (0xFF ^ have)) != 0 or (r & (0xFF ^ have)) != 0 or all == 0 and t != r
        answer_status(var c, OP_LE_SET_DEFAULT_PHY, STATUS_UNSUPPORTED_FEATURE)
        return
    c.phy_def_tx = t
    c.phy_def_rx = r
    c.phy_def_set = (all & 3) != 3
    answer_status(var c, OP_LE_SET_DEFAULT_PHY, STATUS_SUCCESS)

// LE Set PHY (Section 7.8.49): the Command Status event is the answer, and LE PHY Update
// Complete follows with the PHY now in force.
@satisfies("REQ-BLE-CTL-043")
@tier(embedded)
fn cmd_le_set_phy(var c: Controller)
    let at = handle_slot(var c, param_handle(var c))
    let all = h4_rx.h4_param(var c.rx, 2)
    let t = h4_rx.h4_param(var c.rx, 3)
    let r = h4_rx.h4_param(var c.rx, 4)
    let opts = param_u16(var c, 5)
    var status = STATUS_UNKNOWN_CONNECTION
    // A PHY the radio lacks (LE Coded) is Unsupported Feature or Parameter Value, as one that is none is.
    let have = phy_mask(var c)
    if at >= 0 and ((all & 1) == 0 and (t & (0xFF ^ have)) != 0 or (all & 2) == 0 and (r & (0xFF ^ have)) != 0)
        status = STATUS_UNSUPPORTED_FEATURE
    else if at >= 0
        status = ll_link.link_set_phy(var c.links[at], all, t, r, opts)
    answer_command_status(var c, OP_LE_SET_PHY, status)

// ── The resolving list ──────────────────────────────────────────────

// Whether the Link Layer is in a state the resolving list may not change in
// ([Vol 4] Part E, Sections 7.8.38 to 7.8.44 and 7.8.77): advertising, scanning or a
// pending LE Create Connection, with address resolution on.
@tier(embedded)
fn rl_locked(var c: Controller) -> Bool
    c.rl.enable and (adv_active(var c) or c.scan.enabled or c.init.enabled)

// The six octets at parameter `at`.
@tier(embedded)
fn param_addr(var c: Controller, at: Int) -> Vec[u8; 6]
    var a: Vec[u8; 6] = Vec.new()
    for i in 0..6
        let _a = a.push(h4_rx.h4_param(var c.rx, at + i) as u8)
    a

// The 16 octets at parameter `at`.
@tier(embedded)
fn param_irk(var c: Controller, at: Int) -> Vec[u8; 16]
    var a: Vec[u8; 16] = Vec.new()
    for i in 0..16
        let _a = a.push(h4_rx.h4_param(var c.rx, at + i) as u8)
    a

// LE Add Device To Resolving List (Section 7.8.38).
@satisfies("REQ-BLE-CTL-036")
@tier(embedded)
fn cmd_le_add_to_resolving_list(var c: Controller)
    let op = OP_LE_ADD_DEVICE_TO_RESOLVING_LIST
    if rl_locked(var c)
        answer_status(var c, op, STATUS_COMMAND_DISALLOWED)
        return
    let kind = h4_rx.h4_param(var c.rx, 0)
    if kind > 1
        answer_status(var c, op, STATUS_INVALID_PARAMETERS)
        return
    var addr = param_addr(var c, 1)
    var peer_irk = param_irk(var c, 7)
    var local_irk = param_irk(var c, 23)
    answer_status(var c, op, ll_privacy.rl_add(var c.rl, kind, var addr, var peer_irk, var local_irk))

// LE Remove Device From Resolving List (Section 7.8.39).
@satisfies("REQ-BLE-CTL-036")
@tier(embedded)
fn cmd_le_remove_from_resolving_list(var c: Controller)
    let op = OP_LE_REMOVE_DEVICE_FROM_RESOLVING_LIST
    if rl_locked(var c)
        answer_status(var c, op, STATUS_COMMAND_DISALLOWED)
        return
    let kind = h4_rx.h4_param(var c.rx, 0)
    if kind > 1
        answer_status(var c, op, STATUS_INVALID_PARAMETERS)
        return
    var addr = param_addr(var c, 1)
    answer_status(var c, op, ll_privacy.rl_remove(var c.rl, kind, var addr))

// LE Clear Resolving List (Section 7.8.40).
@satisfies("REQ-BLE-CTL-036")
@tier(embedded)
fn cmd_le_clear_resolving_list(var c: Controller)
    if rl_locked(var c)
        answer_status(var c, OP_LE_CLEAR_RESOLVING_LIST, STATUS_COMMAND_DISALLOWED)
        return
    ll_privacy.rl_clear(var c.rl)
    answer_status(var c, OP_LE_CLEAR_RESOLVING_LIST, STATUS_SUCCESS)

// ── P-256 ───────────────────────────────────────────────────────────

// LE Read Local P-256 Public Key (Section 7.8.36): the Controller draws a private key,
// keeps it, and tells the Host the public key in an event when `ctl_ecdh_poll` has it.
@satisfies("REQ-BLE-CTL-038")
@tier(embedded)
fn cmd_le_read_local_p256(var c: Controller)
    if c.ecdh_op != 0
        answer_command_status(var c, OP_LE_READ_LOCAL_P256_PUBLIC_KEY, STATUS_COMMAND_DISALLOWED)
        return
    c.ecdh_op = 1
    answer_command_status(var c, OP_LE_READ_LOCAL_P256_PUBLIC_KEY, STATUS_SUCCESS)

// LE Generate DHKey [v1] and [v2] (Section 7.8.37): the shared secret of a private key and the
// public key of the command, in an event.  [v1] and a Key_Type of 0 use the private key that LE
// Read Local P-256 Public Key made, so that without one the command is disallowed; a Key_Type
// of 1 uses the private key of the Security Manager's Debug mode and needs none.
@satisfies("REQ-BLE-CTL-038")
@tier(embedded)
fn cmd_le_generate_dhkey(var c: Controller)
    generate_dhkey(var c, OP_LE_GENERATE_DHKEY, 0)

@satisfies("REQ-BLE-CTL-038")
@tier(embedded)
fn cmd_le_generate_dhkey_v2(var c: Controller)
    generate_dhkey(var c, OP_LE_GENERATE_DHKEY_V2, h4_rx.h4_param(var c.rx, 64))

// `ecdh_op` 2 is a DHKey over the private key the Controller made, 3 over the debug key.
@tier(embedded)
fn generate_dhkey(var c: Controller, opcode: Int, key_type: Int)
    if key_type > 1
        answer_command_status(var c, opcode, STATUS_INVALID_PARAMETERS)
        return
    if c.ecdh_op != 0 or key_type == 0 and not c.ecdh_have
        answer_command_status(var c, opcode, STATUS_COMMAND_DISALLOWED)
        return
    for k in 0..64
        c.ecdh_peer[k] = h4_rx.h4_param(var c.rx, k) as u8
    c.ecdh_op = 2 + key_type
    answer_command_status(var c, opcode, STATUS_SUCCESS)

// Whether the P-256 work waits for the program.
pub @tier(embedded)
fn ctl_ecdh_wanted(var c: Controller) -> Bool
    c.ecdh_op != 0

// Whether the work waits for 32 random octets for a private key.
pub @tier(embedded)
fn ctl_ecdh_wants_random(var c: Controller) -> Bool
    c.ecdh_op == 1

// The LE Read Local P-256 Public Key Complete event with `status` and the public key `pk`
// (zeros when the status is not success: the Host ignores the key then).
@tier(embedded)
fn send_public_key(var c: Controller, status: Int, var pk: Vec[u8; 64])
    if le_event_enabled(var c, SUB_LE_READ_LOCAL_P256_PUBLIC_KEY_COMPLETE)
        let slot = meta_begin(var c, SUB_LE_READ_LOCAL_P256_PUBLIC_KEY_COMPLETE)
        let _s = ctl_pool.pool_put(var c.pool, slot, status)
        for k in 0..64
            let _p = ctl_pool.pool_put(var c.pool, slot, pk[k] as Int)
        event_send(var c, slot)

// The LE Generate DHKey Complete event with `status` and the DHKey `key`.
@tier(embedded)
fn send_dhkey(var c: Controller, status: Int, var key: Vec[u8; 32])
    if le_event_enabled(var c, SUB_LE_GENERATE_DHKEY_COMPLETE)
        let slot = meta_begin(var c, SUB_LE_GENERATE_DHKEY_COMPLETE)
        let _s = ctl_pool.pool_put(var c.pool, slot, status)
        for k in 0..32
            let _p = ctl_pool.pool_put(var c.pool, slot, key[k] as Int)
        event_send(var c, slot)

// Run the P-256 work a command left: draw the private key from the 32 random octets `rnd`
// (when `have`) and report its public key, or compute the DHKey, and send the event of the
// command.  The work waits while the Host has not read the events already queued.  A private
// key the engine refuses is drawn again (false); an engine that failed to finish ends the
// command with Hardware Failure.  True when it finished a command.
pub @satisfies("REQ-BLE-CTL-038")
@tier(embedded)
fn ctl_ecdh_poll<E: Ecdh[e]>(var c: Controller, var ecdh: E, var rnd: Vec[u8; 32],
                             have: Bool) -> Bool [e]
    if c.ecdh_op == 0 or ctl_pool.pool_free(var c.pool) < 2
        return false
    let faults = ecdh.faults()
    if c.ecdh_op == 1
        if not have
            return false
        var pk: Vec[u8; 64] = Vec.new()
        for _ in 0..64
            let _z = pk.push(0)
        if not ecdh.public_key(var rnd, var pk)
            if ecdh.faults() == faults
                return false
            c.ecdh_op = 0
            send_public_key(var c, STATUS_HARDWARE_FAILURE, var pk)
            return true
        for k in 0..32
            c.ecdh_secret[k] = rnd[k]
        c.ecdh_have = true
        c.ecdh_op = 0
        send_public_key(var c, STATUS_SUCCESS, var pk)
        return true
    var key: Vec[u8; 32] = Vec.new()
    for _ in 0..32
        let _z = key.push(0)
    var secret = c.ecdh_secret
    if c.ecdh_op == 3
        secret = ll_ecdh.debug_private_key()
    var status = STATUS_SUCCESS
    if not ecdh.dhkey(var secret, var c.ecdh_peer, var key)
        status = if ecdh.faults() == faults
            STATUS_INVALID_PARAMETERS
        else
            STATUS_HARDWARE_FAILURE
    c.ecdh_op = 0
    send_dhkey(var c, status, var key)
    true

// LE Read Resolving List Size (Section 7.8.41).
pub @satisfies("REQ-BLE-CTL-036")
@tier(embedded)
fn cmd_le_read_resolving_list_size(var c: Controller)
    let slot = complete_begin(var c, OP_LE_READ_RESOLVING_LIST_SIZE, STATUS_SUCCESS)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put(var c.pool, slot, ll_privacy.RL_SIZE)
    complete_send(var c, slot)

// LE Read Peer Resolvable Address and LE Read Local Resolvable Address (Sections
// 7.8.42 and 7.8.43): the RPA in use with the device, or Unknown Connection
// Identifier when the list does not have the device or none is in use.
pub @satisfies("REQ-BLE-CTL-036")
@tier(embedded)
fn cmd_le_read_resolvable_address(var c: Controller, op: Int, local: Bool)
    let kind = h4_rx.h4_param(var c.rx, 0)
    var addr = param_addr(var c, 1)
    var status = STATUS_SUCCESS
    var at = -1
    if kind > 1
        status = STATUS_INVALID_PARAMETERS
    else
        at = ll_privacy.rl_find(var c.rl, kind, var addr)
        if at < 0
            status = STATUS_UNKNOWN_CONNECTION
        else if local and not c.rl.local_ok[at]
            status = STATUS_UNKNOWN_CONNECTION
        else if not local and not c.rl.peer_ok[at]
            status = STATUS_UNKNOWN_CONNECTION
    let slot = complete_begin(var c, op, status)
    if slot == ctl_pool.NO_SLOT
        return
    for k in 0..6
        var v = 0
        if status == STATUS_SUCCESS
            if local
                v = c.rl.local_rpa[at * 6 + k] as Int
            else
                v = c.rl.peer_rpa[at * 6 + k] as Int
        let _a = ctl_pool.pool_put(var c.pool, slot, v)
    complete_send(var c, slot)

// LE Set Address Resolution Enable (Section 7.8.44).
@satisfies("REQ-BLE-CTL-036")
@tier(embedded)
fn cmd_le_set_address_resolution_enable(var c: Controller)
    let op = OP_LE_SET_ADDRESS_RESOLUTION_ENABLE
    let on = h4_rx.h4_param(var c.rx, 0)
    if on > 1
        answer_status(var c, op, STATUS_INVALID_PARAMETERS)
        return
    if adv_active(var c) or c.scan.enabled or c.init.enabled
        answer_status(var c, op, STATUS_COMMAND_DISALLOWED)
        return
    c.rl.enable = on == 1
    answer_status(var c, op, STATUS_SUCCESS)

// LE Set Resolvable Private Address Timeout [v1] (Section 7.8.45): seconds, 1 to 3600.
@satisfies("REQ-BLE-CTL-036")
@tier(embedded)
fn cmd_le_set_rpa_timeout(var c: Controller)
    let op = OP_LE_SET_RESOLVABLE_PRIVATE_ADDRESS_TIMEOUT
    let t = param_u16(var c, 0)
    if t < 1 or t > 0x0E10
        answer_status(var c, op, STATUS_INVALID_PARAMETERS)
        return
    c.rl.timeout = t
    answer_status(var c, op, STATUS_SUCCESS)

// LE Set Privacy Mode (Section 7.8.77).
@satisfies("REQ-BLE-CTL-036")
@tier(embedded)
fn cmd_le_set_privacy_mode(var c: Controller)
    let op = OP_LE_SET_PRIVACY_MODE
    if rl_locked(var c)
        answer_status(var c, op, STATUS_COMMAND_DISALLOWED)
        return
    let kind = h4_rx.h4_param(var c.rx, 0)
    let mode = h4_rx.h4_param(var c.rx, 7)
    if kind > 1 or mode > 1
        answer_status(var c, op, STATUS_INVALID_PARAMETERS)
        return
    var addr = param_addr(var c, 1)
    let at = ll_privacy.rl_find(var c.rl, kind, var addr)
    if at < 0
        answer_status(var c, op, STATUS_UNKNOWN_CONNECTION)
        return
    c.rl.mode[at] = mode as u8
    answer_status(var c, op, STATUS_SUCCESS)

// Store the Rand (`which` 0, octets 2 to 9 of the parameters) or the long term key
// (`which` 1, from `at`) of the command in the link of `slot`.
@tier(embedded)
fn put_enc_param(var c: Controller, slot: Int, which: Int, at: Int, n: Int)
    for i in 0..n
        ll_link.link_enc_put(var c.links[slot], which, i, h4_rx.h4_param(var c.rx, at + i))

// LE Start Encryption ([Vol 4] Part E, Section 7.8.24): the answer is a Command
// Status event, and Encryption Change follows when the link is encrypted or the
// procedure fails (Encryption Key Refresh Complete on a link that was).
@satisfies("REQ-BLE-CTL-035")
@tier(embedded)
fn cmd_le_start_encryption(var c: Controller)
    let op = OP_LE_START_ENCRYPTION
    let slot = handle_slot(var c, param_handle(var c))
    if slot < 0
        answer_command_status(var c, op, STATUS_UNKNOWN_CONNECTION)
        return
    put_enc_param(var c, slot, 0, 2, 8)
    put_enc_param(var c, slot, 1, 12, 16)
    let ediv = param_u16(var c, 10)
    answer_command_status(var c, op, ll_link.link_start_encryption(var c.links[slot], ediv))

// LE Long Term Key Request Reply ([Vol 4] Part E, Section 7.8.25).
@satisfies("REQ-BLE-CTL-035")
@tier(embedded)
fn cmd_le_long_term_key_request_reply(var c: Controller)
    let op = OP_LE_LONG_TERM_KEY_REQUEST_REPLY
    let handle = param_handle(var c)
    let slot = handle_slot(var c, handle)
    var status = STATUS_UNKNOWN_CONNECTION
    if slot >= 0
        put_enc_param(var c, slot, 1, 2, 16)
    if slot >= 0
        status = ll_link.link_ltk_reply(var c.links[slot])
    answer_handle(var c, op, status, handle)

// LE Long Term Key Request Negative Reply (Section 7.8.26).
@satisfies("REQ-BLE-CTL-035")
@tier(embedded)
fn cmd_le_long_term_key_request_negative_reply(var c: Controller)
    let op = OP_LE_LONG_TERM_KEY_REQUEST_NEGATIVE_REPLY
    let handle = param_handle(var c)
    let slot = handle_slot(var c, handle)
    var status = STATUS_UNKNOWN_CONNECTION
    if slot >= 0
        status = ll_link.link_ltk_negative(var c.links[slot])
    answer_handle(var c, op, status, handle)

// LE Remote Connection Parameter Request Reply ([Vol 4] Part E, Section 7.8.31):
// the Host accepts the peer's request.
@satisfies("REQ-BLE-CTL-027")
@tier(embedded)
fn cmd_le_remote_connection_parameter_request_reply(var c: Controller)
    let op = OP_LE_REMOTE_CONNECTION_PARAMETER_REQUEST_REPLY
    let handle = param_handle(var c)
    let slot = handle_slot(var c, handle)
    var status = STATUS_UNKNOWN_CONNECTION
    if slot >= 0 and param_u16(var c, 10) > param_u16(var c, 12)
        status = STATUS_INVALID_PARAMETERS
    else if slot >= 0
        status = ll_link.link_param_reply(var c.links[slot],
            param_u16(var c, 2),
            param_u16(var c, 4),
            param_u16(var c, 6),
            param_u16(var c, 8))
    answer_handle(var c, op, status, handle)

// LE Remote Connection Parameter Request Negative Reply (Section 7.8.32).
@satisfies("REQ-BLE-CTL-027")
@tier(embedded)
fn cmd_le_remote_connection_parameter_request_negative_reply(var c: Controller)
    let op = OP_LE_REMOTE_CONNECTION_PARAMETER_REQUEST_NEGATIVE_REPLY
    let handle = param_handle(var c)
    let slot = handle_slot(var c, handle)
    let reason = h4_rx.h4_param(var c.rx, 2)
    var status = STATUS_UNKNOWN_CONNECTION
    if slot >= 0
        status = ll_link.link_param_negative(var c.links[slot], reason)
    answer_handle(var c, op, status, handle)

// Read Authenticated Payload Timeout ([Vol 4] Part E, Section 7.3.93): the status,
// the handle and the timeout in units of 10 ms.
@satisfies("REQ-BLE-CTL-028")
@tier(embedded)
fn cmd_read_authenticated_payload_timeout(var c: Controller)
    let handle = param_handle(var c)
    let at = handle_slot(var c, handle)
    let slot = complete_begin(var c, OP_READ_AUTHENTICATED_PAYLOAD_TIMEOUT, STATUS_SUCCESS)
    // cov: skip — ctl_step runs a command only with a free slot for its answer
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put_u16(var c.pool, slot, handle)
    if at < 0
        ctl_pool.pool_patch(var c.pool, slot, 6, STATUS_UNKNOWN_CONNECTION)
        let _b = ctl_pool.pool_put_u16(var c.pool, slot, 0)
    else
        let _c = ctl_pool.pool_put_u16(var c.pool, slot, c.links[at].apto)
    complete_send(var c, slot)

// Write Authenticated Payload Timeout (Section 7.3.94).
@satisfies("REQ-BLE-CTL-028")
@tier(embedded)
fn cmd_write_authenticated_payload_timeout(var c: Controller)
    let handle = param_handle(var c)
    let at = handle_slot(var c, handle)
    let timeout = param_u16(var c, 2)
    var status = STATUS_UNKNOWN_CONNECTION
    if at >= 0
        status = ll_link.link_set_apto(var c.links[at], timeout)
    answer_handle(var c, OP_WRITE_AUTHENTICATED_PAYLOAD_TIMEOUT, status, handle)

// ── The Central commands ────────────────────────────────────────────

// The channel map a new connection as Central asks for: the one the Host
// classified, or all 37 channels when it left fewer than two.
@tier(embedded)
fn connect_chmap(var c: Controller) -> Int
    if ll_link.popcount(c.chmap) < 2
        ll_init.CHMAP_ALL
    else
        c.chmap

// Whether a connection is on to the device `peer` of `peer_type` (bit 0 of the type is
// public or random; 2 and 3 name an identity address): the address of a link whose peer
// resolved to an identity is that identity.
@satisfies("REQ-BLE-CTL-069")
@tier(embedded)
fn connected_to(var c: Controller, peer_type: Int, var peer: Vec[u8; 6]) -> Bool
    for ls in 0..noble_controller_config.CTL_LINKS
        if ll_link.link_live(var c.links[ls]) and (c.links[ls].peer_type & 1) == (peer_type & 1)
            var same = true
            for k in 0..6
                if c.links[ls].peer[k] != peer[k]
                    same = false
                    break
            if same
                return true
    false

// LE Create Connection ([Vol 4] Part E, Section 7.8.12): the answer is a Command
// Status event, and the LE Connection Complete event follows when the Peripheral
// has answered the first packet of the Central or the connection has failed to
// establish.  Starting needs the Initiating state free of scanning, the address
// of the Own_Address_Type, and a free link beside the Central limit.
@satisfies("REQ-BLE-CTL-023")
@tier(embedded)
fn cmd_le_create_connection(var c: Controller)
    let op = OP_LE_CREATE_CONNECTION
    if c.init.enabled or c.scan.enabled
        answer_command_status(var c, op, STATUS_COMMAND_DISALLOWED)
        return
    let interval = param_u16(var c, 0)
    let window = param_u16(var c, 2)
    let policy = h4_rx.h4_param(var c.rx, 4)
    let peer_type = h4_rx.h4_param(var c.rx, 5)
    let own = h4_rx.h4_param(var c.rx, 12)
    let c_min = param_u16(var c, 13)
    let c_max = param_u16(var c, 15)
    let latency = param_u16(var c, 17)
    let timeout = param_u16(var c, 19)
    let ce_min = param_u16(var c, 21)
    let ce_max = param_u16(var c, 23)
    let status = ll_init.init_params_status(interval, window, policy, peer_type, own, c_min, c_max, latency, timeout, ce_min, ce_max)
    var peer: Vec[u8; 6] = Vec.new()
    for i in 0..6
        let _a = peer.push(h4_rx.h4_param(var c.rx, 6 + i) as u8)
    let _s = initiate(var c,
        op,
        status,
        interval,
        window,
        policy,
        peer_type,
        var peer,
        own,
        c_min,
        c_max,
        latency,
        timeout)

// The octets of the parameters of one PHY in LE Extended Create Connection: the scan interval and
// window, the connection interval range, the latency, the supervision timeout and the range of the
// connection event length.
const EXT_CONN_SET_OCTETS = 16

// The number of bits set in the low octet `v`.
@tier(embedded)
fn popcount8(v: Int) -> Int
    var n = 0
    for k in 0..8
        n = n + ((v >>> k) & 1)
    n

// LE Extended Create Connection [v1] ([Vol 4] Part E, Section 7.8.66): the Initiating state of
// LE Create Connection, with the Initiating_PHYs and a set of parameters for each PHY.  The
// answer is a Command Status event and the LE (Enhanced) Connection Complete event follows, as for
// LE Create Connection, and LE Create Connection Cancel ends it.  LE 1M scans the primary channels
// and answers a legacy advertisement or follows an extended one to its secondary channel; LE 2M
// has a set of connection parameters for a secondary channel that uses it (its scan interval and
// window are not read).  LE Coded is Unsupported Feature or Parameter Value: the receiver of the
// scan windows is LE 1M, and the secondary channel on LE Coded is not followed.
@satisfies("REQ-BLE-CTL-080")
@tier(embedded)
fn cmd_le_extended_create_connection(var c: Controller, v2: Bool)
    var op = OP_LE_EXTENDED_CREATE_CONNECTION
    // The [v2] command has the Advertising_Handle and the Subevent of Periodic Advertising with Responses before the parameters of [v1].
    var b = 0
    if v2
        op = OP_LE_EXTENDED_CREATE_CONNECTION_V2
        b = 2
    if c.init.enabled or c.scan.enabled
        answer_command_status(var c, op, STATUS_COMMAND_DISALLOWED)
        return
    // A handle and a subevent name a periodic train with responses, which this Controller does not run: both 0xFF is the [v1] command, one of them is
    // Invalid HCI Command Parameters.
    if v2
        let hnd = h4_rx.h4_param(var c.rx, 0)
        let sub = h4_rx.h4_param(var c.rx, 1)
        if (hnd == 0xFF) != (sub == 0xFF)
            answer_command_status(var c, op, STATUS_INVALID_PARAMETERS)
            return
        if hnd != 0xFF
            answer_command_status(var c, op, STATUS_UNSUPPORTED_FEATURE)
            return
    let policy = h4_rx.h4_param(var c.rx, b + 0)
    let own = h4_rx.h4_param(var c.rx, b + 1)
    let peer_type = h4_rx.h4_param(var c.rx, b + 2)
    let phys = h4_rx.h4_param(var c.rx, b + 9)
    var peer: Vec[u8; 6] = Vec.new()
    for i in 0..6
        let _a = peer.push(h4_rx.h4_param(var c.rx, b + 3 + i) as u8)
    // The sets of the PHYs that are set, in the order of the bits: LE 1M, LE 2M, LE Coded.
    var at = b + 10
    var interval = 0
    var window = 0
    var c_min = 0
    var c_max = 0
    var latency = 0
    var timeout = 0
    var ce_min = 0
    var ce_max = 0
    var x_min = 0
    var x_max = 0
    var x_latency = 0
    var x_timeout = 0
    var x_ce_min = 0
    var x_ce_max = 0
    var k_interval = 0
    var k_window = 0
    var z_min = 0
    var z_max = 0
    var z_latency = 0
    var z_timeout = 0
    var z_ce_min = 0
    var z_ce_max = 0
    if (phys & 1) != 0
        interval = param_u16(var c, at)
        window = param_u16(var c, at + 2)
        c_min = param_u16(var c, at + 4)
        c_max = param_u16(var c, at + 6)
        latency = param_u16(var c, at + 8)
        timeout = param_u16(var c, at + 10)
        ce_min = param_u16(var c, at + 12)
        ce_max = param_u16(var c, at + 14)
        at = at + EXT_CONN_SET_OCTETS
    if (phys & 2) != 0
        x_min = param_u16(var c, at + 4)
        x_max = param_u16(var c, at + 6)
        x_latency = param_u16(var c, at + 8)
        x_timeout = param_u16(var c, at + 10)
        x_ce_min = param_u16(var c, at + 12)
        x_ce_max = param_u16(var c, at + 14)
        at = at + EXT_CONN_SET_OCTETS
    if (phys & 4) != 0
        k_interval = param_u16(var c, at)
        k_window = param_u16(var c, at + 2)
        z_min = param_u16(var c, at + 4)
        z_max = param_u16(var c, at + 6)
        z_latency = param_u16(var c, at + 8)
        z_timeout = param_u16(var c, at + 10)
        z_ce_min = param_u16(var c, at + 12)
        z_ce_max = param_u16(var c, at + 14)
        if (phys & 1) == 0
            // LE Coded is the only PHY that scans: its set is the one the Initiating state starts from.
            interval = k_interval
            window = k_window
            c_min = z_min
            c_max = z_max
            latency = z_latency
            timeout = z_timeout
            ce_min = z_ce_min
            ce_max = z_ce_max
    var status = STATUS_SUCCESS
    if phys == 0 or (phys & 0xF8) != 0 or (phys & 5) == 0
        status = STATUS_INVALID_PARAMETERS
    else if (phys & 4) != 0 and not phy_supported(var c, ll_phy.PHY_CODED)
        status = STATUS_UNSUPPORTED_FEATURE
    else
        status = ll_init.init_params_status(interval, window, policy, peer_type, own, c_min, c_max, latency, timeout, ce_min, ce_max)
        if status == STATUS_SUCCESS and (phys & 2) != 0
            status = ll_init.conn_params_status(x_min, x_max, x_latency, x_timeout, x_ce_min, x_ce_max)
        if status == STATUS_SUCCESS and (phys & 5) == 5
            status = ll_init.init_params_status(k_interval,
                k_window,
                policy,
                peer_type,
                own,
                z_min,
                z_max,
                z_latency,
                z_timeout,
                z_ce_min,
                z_ce_max)
    if initiate(var c,
        op,
        status,
        interval,
        window,
        policy,
        peer_type,
        var peer,
        own,
        c_min,
        c_max,
        latency,
        timeout)
        ll_init.init_ext_enable(var c.init, phys, x_min, x_max, x_latency, x_timeout)
        if (phys & 4) != 0
            ll_init.init_coded_enable(var c.init, z_min, z_max, z_latency, z_timeout, k_interval, k_window)

// The part of LE Create Connection and LE Extended Create Connection that follows the check of the
// parameters (`status`, the result of it): answer a refusal, or enter the Initiating state and answer
// Success.  True when the state was entered.  The peer the Host named is an identity address when its
// type is 0 or 1, and the identity of a device whose Resolvable Private Address is to be resolved when it
// is 2 or 3; the entry for it gives the InitA of an Own_Address_Type that asks for an RPA
// ([Vol 6] Part B, Section 6.4).
@satisfies("REQ-BLE-CTL-023")
@tier(embedded)
fn initiate(var c: Controller, op: Int, status: Int, interval: Int, window: Int, policy: Int,
            peer_type: Int, var peer: Vec[u8; 6], own: Int, c_min: Int, c_max: Int, latency: Int,
            timeout: Int) -> Bool
    if status != STATUS_SUCCESS
        answer_command_status(var c, op, status)
        return false
    var ent = -1
    if policy == 0
        ent = ll_privacy.rl_find(var c.rl, peer_type & 1, var peer)
    let loc = own >= 2 and ent >= 0 and ll_privacy.rl_local_has_irk(var c.rl, ent)
    if not loc and not own_address_ready(var c, own & 1)
        answer_command_status(var c, op, STATUS_INVALID_PARAMETERS)
        return false
    if policy == 0 and connected_to(var c, peer_type, var peer)
        answer_command_status(var c, op, STATUS_CONNECTION_EXISTS)
        return false
    if role_count(var c, true) >= noble_controller_config.CTL_CENTRAL or free_slots(var c) < 1
        answer_command_status(var c, op, STATUS_CONNECTION_LIMIT)
        return false
    let avoid_a = slot_aa(var c, 0)
    let avoid_b = slot_aa(var c, 1)
    c.init_ent = ent
    c.init_loc = loc
    c.init_own = own
    c.init_wait = false
    if loc
        var a = rl_local_vec(var c, ent)
        ll_init.init_enable(var c.init,
            c.now,
            interval,
            window,
            policy,
            peer_type,
            var peer,
            var a,
            1,
            c_min,
            c_max,
            latency,
            timeout,
            connect_chmap(var c),
            avoid_a,
            avoid_b)
        c.init_wait = not c.rl.local_ok[ent]
    else if (own & 1) == 0
        ll_init.init_enable(var c.init,
            c.now,
            interval,
            window,
            policy,
            peer_type,
            var peer,
            var c.public,
            0,
            c_min,
            c_max,
            latency,
            timeout,
            connect_chmap(var c),
            avoid_a,
            avoid_b)
    else
        ll_init.init_enable(var c.init,
            c.now,
            interval,
            window,
            policy,
            peer_type,
            var peer,
            var c.random,
            1,
            c_min,
            c_max,
            latency,
            timeout,
            connect_chmap(var c),
            avoid_a,
            avoid_b)
    answer_command_status(var c, op, STATUS_SUCCESS)
    true

// LE Create Connection Cancel ([Vol 4] Part E, Section 7.8.13): the answer is a
// Command Complete event, and the LE Connection Complete event with Unknown
// Connection Identifier follows it.  Without a pending LE Create Connection the
// command is disallowed.
@satisfies("REQ-BLE-CTL-023")
@tier(embedded)
fn cmd_le_create_connection_cancel(var c: Controller)
    if not c.init.enabled
        answer_status(var c, OP_LE_CREATE_CONNECTION_CANCEL, STATUS_COMMAND_DISALLOWED)
        return
    ll_init.init_disable(var c.init)
    ll_arb.arb_cancel(var c.arb, ll_arb.class_scan())
    c.init.cancels = c.init.cancels + 1
    c.init_event = STATUS_UNKNOWN_CONNECTION
    answer_status(var c, OP_LE_CREATE_CONNECTION_CANCEL, STATUS_SUCCESS)

// LE Set Host Channel Classification ([Vol 4] Part E, Section 7.8.19): bit n of
// the 37-bit map is 0 for a channel the Host found bad and 1 for one it does
// not know to be.  The map is the one the next connection as Central asks for,
// and a connection that is on as Central moves to it with LL_CHANNEL_MAP_IND
// (`ll_link.central_map_try`).  A map that sets a bit past channel 36 or leaves
// no channel is refused.
@satisfies("REQ-BLE-CTL-023")
@tier(embedded)
fn cmd_le_set_host_channel_classification(var c: Controller)
    var map = 0
    for k in 0..5
        map = map | (h4_rx.h4_param(var c.rx, k) << (8 * k))
    if (map >>> 37) != 0 or map == 0
        answer_status(var c, OP_LE_SET_HOST_CHANNEL_CLASSIFICATION, STATUS_INVALID_PARAMETERS)
        return
    c.chmap = map
    for slot in 0..noble_controller_config.CTL_LINKS
        if slot_central(var c, slot)
            ll_link.link_set_host_map(var c.links[slot], map)
    answer_status(var c, OP_LE_SET_HOST_CHANNEL_CLASSIFICATION, STATUS_SUCCESS)

// ── Commands the hardware finishes ──────────────────────────────────

// LE Encrypt and LE Rand are answered once the hardware has run.  The
// command takes its operands and a slot for its answer, and waits; the
// program does the work and calls `ctl_async_complete` or `ctl_async_fail`.
@satisfies("REQ-BLE-HCI-031")
@tier(embedded)
fn cmd_le_encrypt(var c: Controller)
    for i in 0..16
        c.key[i] = h4_rx.h4_param(var c.rx, i) as u8
        c.block[i] = h4_rx.h4_param(var c.rx, 16 + i) as u8
    c.pend_slot = complete_begin(var c, OP_LE_ENCRYPT, STATUS_SUCCESS)
    c.pending = PEND_ENCRYPT as u8

@satisfies("REQ-BLE-HCI-032")
@tier(embedded)
fn cmd_le_rand(var c: Controller)
    c.pend_slot = complete_begin(var c, OP_LE_RAND, STATUS_SUCCESS)
    c.pending = PEND_RAND as u8

// ── Dispatch ────────────────────────────────────────────────────────

// Run the command in the reader. The caller has checked that a slot is free
// for the answer.
@satisfies("REQ-BLE-HCI-003")
@satisfies("REQ-BLE-CTL-004")
@no_alloc
@tier(embedded)
fn dispatch(var c: Controller)
    let opcode = h4_rx.h4_opcode(var c.rx)
    if not command_answered(var c, opcode)
        c.unknown = c.unknown + 1
        answer_status(var c, opcode, STATUS_UNKNOWN_COMMAND)
        return
    let want = command_params(opcode)
    if want != -2 and not params_length_ok(var c, opcode)
        answer_status(var c, opcode, STATUS_INVALID_PARAMETERS)
        return
    if dtm_refuses(var c, opcode)
        return
    // The commands of the isochronous channels are not linked into a build without them: the condition is a constant.
    if ctl_limits.iso_on() and iso_command(opcode)
        iso_dispatch(var c, opcode)
        return
    // The same for Periodic Advertising Sync Transfer.
    if ctl_limits.past_on() and past_command(opcode)
        past_dispatch(var c, opcode)
        return
    // And for LE Power Control.
    if ctl_limits.pcl_on() and pcl_command(opcode)
        pcl_dispatch(var c, opcode)
        return
    // And for path loss monitoring.
    if ctl_limits.ploss_on() and ploss_command(opcode)
        ploss_dispatch(var c, opcode)
        return
    // And for Channel Sounding, whose Host Support bit LE Set Host Feature [v1] sets when the build has no isochronous channels to dispatch it.
    if noble_controller_config.CTL_CS > 0
        if cs_command_on(opcode)
            cs_dispatch(var c, opcode)
            return
    if ctl_limits.cs_on() and opcode == OP_LE_SET_HOST_FEATURE
        cmd_le_set_host_feature(var c)
        return
    // And for Connection Subrating.
    if ctl_limits.sub_on() and sub_command(opcode)
        sub_dispatch(var c, opcode)
        return
    // And for Connection Rate.
    if ctl_limits.rate_on() and rate_command(opcode)
        rate_dispatch(var c, opcode)
        return
    // And for Frame Space Update.
    if ctl_limits.fs_on() and fs_command(opcode)
        cmd_le_frame_space_update(var c)
        return
    // And for the Feature Page Exchange.
    if ctl_limits.feat_on() and feat_command(opcode)
        if opcode == OP_LE_READ_ALL_LOCAL_SUPPORTED_FEATURES
            cmd_le_read_all_local(var c)
        else
            cmd_le_read_all_remote(var c)
        return
    // And for periodic advertising with responses.
    if (ctl_limits.pawr_adv_on() or ctl_limits.pawr_sync_on()) and pawr_command(opcode)
        pawr_dispatch(var c, opcode)
        return
    match opcode
        0x406  => cmd_disconnect(var c)
        0x41d  => cmd_read_remote_version(var c)
        0xc01  => cmd_set_event_mask(var c)
        0xc03  => cmd_reset(var c)
        0xc31  => cmd_set_controller_to_host_flow_control(var c)
        0xc33  => cmd_host_buffer_size(var c)
        0xc35  => cmd_host_number_of_completed_packets(var c)
        0xc63  => cmd_set_event_mask_page_2(var c)
        0xc7b  => cmd_read_authenticated_payload_timeout(var c)
        0xc7c  => cmd_write_authenticated_payload_timeout(var c)
        0x1001 => cmd_read_local_version(var c)
        0x1002 => cmd_read_local_supported_commands(var c)
        0x1003 => cmd_read_local_supported_features(var c)
        0x1009 => cmd_read_bd_addr(var c)
        0x2001 => cmd_le_set_event_mask(var c)
        0x2002 => cmd_le_read_buffer_size(var c)
        0x2003 => cmd_le_features(var c, opcode)
        0x2005 => cmd_le_set_random_address(var c)
        0x2006 => cmd_le_set_advertising_parameters(var c)
        0x2007 => cmd_le_read_advertising_channel_tx_power(var c)
        0x2008 => cmd_le_set_advertising_data(var c, opcode)
        0x2009 => cmd_le_set_advertising_data(var c, opcode)
        0x200a => cmd_le_set_advertising_enable(var c)
        0x200b => cmd_le_set_scan_parameters(var c)
        0x200c => cmd_le_set_scan_enable(var c)
        0x200d => cmd_le_create_connection(var c)
        0x200e => cmd_le_create_connection_cancel(var c)
        0x2035 => cmd_le_set_advertising_set_random_address(var c)
        0x2036 => cmd_le_set_extended_advertising_parameters(var c, false)
        0x207f => cmd_le_set_extended_advertising_parameters(var c, true)
        0x2037 => cmd_le_set_extended_advertising_data(var c, false)
        0x2038 => cmd_le_set_extended_advertising_data(var c, true)
        0x2039 => cmd_le_set_extended_advertising_enable(var c)
        0x203a => cmd_le_read_maximum_advertising_data_length(var c)
        0x203b => cmd_le_read_number_of_supported_advertising_sets(var c)
        0x203c => cmd_le_remove_advertising_set(var c)
        0x203d => cmd_le_clear_advertising_sets(var c)
        0x203e => cmd_le_set_periodic_advertising_parameters(var c, false)
        0x2086 => cmd_le_set_periodic_advertising_parameters(var c, true)
        0x203f => cmd_le_set_periodic_advertising_data(var c)
        0x2040 => cmd_le_set_periodic_advertising_enable(var c)
        0x2044 => cmd_le_periodic_advertising_create_sync(var c)
        0x2045 => cmd_le_periodic_advertising_create_sync_cancel(var c)
        0x2046 => cmd_le_periodic_advertising_terminate_sync(var c)
        0x2047 => cmd_le_add_to_periodic_advertiser_list(var c)
        0x2048 => cmd_le_remove_from_periodic_advertiser_list(var c)
        0x2049 => cmd_le_clear_periodic_advertiser_list(var c)
        0x204a => cmd_le_read_periodic_advertiser_list_size(var c)
        0x2059 => cmd_le_set_periodic_advertising_receive_enable(var c)
        0x2041 => cmd_le_set_extended_scan_parameters(var c)
        0x2042 => cmd_le_set_extended_scan_enable(var c)
        0x2043 => cmd_le_extended_create_connection(var c, false)
        0x2085 => cmd_le_extended_create_connection(var c, true)
        0x200f => cmd_le_read_fal_size(var c)
        0x2010 => cmd_le_clear_fal(var c)
        0x2011 => cmd_le_add_to_fal(var c)
        0x2012 => cmd_le_remove_from_fal(var c)
        0x2013 => cmd_le_connection_update(var c)
        0xc2d  => cmd_read_transmit_power_level(var c)
        0x1405 => cmd_read_rssi(var c)
        0x2014 => cmd_le_set_host_channel_classification(var c)
        0x2015 => cmd_le_read_channel_map(var c)
        0x2016 => cmd_le_read_remote_features(var c)
        0x2017 => cmd_le_encrypt(var c)
        0x2018 => cmd_le_rand(var c)
        0x2019 => cmd_le_start_encryption(var c)
        0x2022 => cmd_le_set_data_length(var c)
        0x2023 => cmd_le_read_suggested_default_data_length(var c)
        0x2024 => cmd_le_write_suggested_default_data_length(var c)
        0x202f => cmd_le_read_maximum_data_length(var c)
        0x2030 => cmd_le_read_phy(var c)
        0x2031 => cmd_le_set_default_phy(var c)
        0x2032 => cmd_le_set_phy(var c)
        0x2025 => cmd_le_read_local_p256(var c)
        0x2026 => cmd_le_generate_dhkey(var c)
        0x205e => cmd_le_generate_dhkey_v2(var c)
        0x2027 => cmd_le_add_to_resolving_list(var c)
        0x2028 => cmd_le_remove_from_resolving_list(var c)
        0x2029 => cmd_le_clear_resolving_list(var c)
        0x202a => cmd_le_read_resolving_list_size(var c)
        0x202b => cmd_le_read_resolvable_address(var c, OP_LE_READ_PEER_RESOLVABLE_ADDRESS, false)
        0x202c => cmd_le_read_resolvable_address(var c, OP_LE_READ_LOCAL_RESOLVABLE_ADDRESS, true)
        0x202d => cmd_le_set_address_resolution_enable(var c)
        0x202e => cmd_le_set_rpa_timeout(var c)
        0x204e => cmd_le_set_privacy_mode(var c)
        0x201a => cmd_le_long_term_key_request_reply(var c)
        0x201b => cmd_le_long_term_key_request_negative_reply(var c)
        0x201c => cmd_le_read_supported_states(var c)
        0x2020 => cmd_le_remote_connection_parameter_request_reply(var c)
        0x2021 => cmd_le_remote_connection_parameter_request_negative_reply(var c)
        0x204b => cmd_le_read_transmit_power(var c)
        0x201d => cmd_le_receiver_test(var c, opcode)
        0x2033 => cmd_le_receiver_test(var c, opcode)
        0x204f => cmd_le_receiver_test(var c, opcode)
        0x201e => cmd_le_transmitter_test(var c, opcode)
        0x2034 => cmd_le_transmitter_test(var c, opcode)
        0x2050 => cmd_le_transmitter_test(var c, opcode)
        0x207b => cmd_le_transmitter_test(var c, opcode)
        0x201f => cmd_le_test_end(var c)
        _      => answer_status(var c, opcode, STATUS_UNKNOWN_COMMAND)

// Whether the parameters of the command in `c.rx` have the length the command takes.  The
// test commands of the third version carry a switching pattern of Switching_Pattern_Length
// (parameter 6) octets after the fixed parameters, and the fourth transmitter test one more
// octet, the transmit power.
@tier(embedded)
fn params_length_ok(var c: Controller, opcode: Int) -> Bool
    let len = h4_rx.h4_param_len(var c.rx)
    let want = command_params(opcode)
    if opcode == OP_LE_RECEIVER_TEST_V3 or opcode == OP_LE_TRANSMITTER_TEST_V3
        return len == want + h4_rx.h4_param(var c.rx, 6)
    if opcode == OP_LE_TRANSMITTER_TEST_V4
        return len == want + h4_rx.h4_param(var c.rx, 6)
    if opcode == OP_LE_EXTENDED_CREATE_CONNECTION
        return len == want + EXT_CONN_SET_OCTETS * popcount8(h4_rx.h4_param(var c.rx, 9))
    if opcode == OP_LE_EXTENDED_CREATE_CONNECTION_V2
        return len == want + EXT_CONN_SET_OCTETS * popcount8(h4_rx.h4_param(var c.rx, 11))
    if opcode == OP_LE_SET_EXTENDED_SCAN_PARAMETERS
        return len == want + XSCAN_SET_OCTETS * popcount8(h4_rx.h4_param(var c.rx, 2))
    if opcode == OP_LE_SET_EXTENDED_ADVERTISING_DATA or opcode == OP_LE_SET_EXTENDED_SCAN_RESPONSE_DATA
        return len >= want and len == want + h4_rx.h4_param(var c.rx, 3)
    if opcode == OP_LE_SET_PERIODIC_ADVERTISING_DATA
        return len >= want and len == want + h4_rx.h4_param(var c.rx, 2)
    if (ctl_limits.pawr_adv_on() or ctl_limits.pawr_sync_on()) and opcode == OP_LE_SET_PERIODIC_ADVERTISING_RESPONSE_DATA
        return len >= want and len == want + h4_rx.h4_param(var c.rx, 7)
    if (ctl_limits.pawr_adv_on() or ctl_limits.pawr_sync_on()) and opcode == OP_LE_SET_PERIODIC_SYNC_SUBEVENT
        return len >= want and len == want + h4_rx.h4_param(var c.rx, 4)
    if opcode == OP_LE_SET_EXTENDED_ADVERTISING_ENABLE
        return len >= want and len == want + 4 * h4_rx.h4_param(var c.rx, 1)
    len == want

// Direct Test Mode owns the radio while a test runs: a command that would start advertising,
// scanning or initiating is answered with Command Disallowed.  True when it was.
@satisfies("REQ-BLE-CTL-071")
@tier(embedded)
fn dtm_refuses(var c: Controller, opcode: Int) -> Bool
    if not ll_dtm.dtm_active(var c.dtm)
        return false
    if opcode == OP_LE_CREATE_CONNECTION or opcode == OP_LE_EXTENDED_CREATE_CONNECTION or opcode == OP_LE_EXTENDED_CREATE_CONNECTION_V2
        answer_command_status(var c, opcode, STATUS_COMMAND_DISALLOWED)
        return true
    if (opcode == OP_LE_SET_ADVERTISING_ENABLE or opcode == OP_LE_SET_SCAN_ENABLE) and h4_rx.h4_param(var c.rx, 0) == 1
        answer_status(var c, opcode, STATUS_COMMAND_DISALLOWED)
        return true
    false

// Whether a test cannot start: another does, or the radio has a state of its own on.
@tier(embedded)
fn dtm_cannot_start(var c: Controller) -> Bool
    ll_dtm.dtm_active(var c.dtm) or adv_active(var c) or c.scan.enabled or c.init.enabled or links_live(var c) or per_active(var c) or big_active(var c)

// LE Receiver Test [v1], [v2] and [v3] ([Vol 4] Part E, Section 7.8.28).  A Constant Tone
// Extension is not built: a valid non-zero Expected_CTE_Length answers Unsupported Feature or
// Parameter Value, a reserved one Invalid HCI Command Parameters, and one on LE Coded Command
// Disallowed (`ll_dtm.cte_status`).
@satisfies("REQ-BLE-CTL-071")
@tier(embedded)
fn cmd_le_receiver_test(var c: Controller, opcode: Int)
    let channel = h4_rx.h4_param(var c.rx, 0)
    var phy = 1
    var modulation = 0
    var cte = 0
    var cte_type = 0
    if opcode != OP_LE_RECEIVER_TEST_V1
        phy = h4_rx.h4_param(var c.rx, 1)
        modulation = h4_rx.h4_param(var c.rx, 2)
    if opcode == OP_LE_RECEIVER_TEST_V3
        cte = h4_rx.h4_param(var c.rx, 3)
        cte_type = h4_rx.h4_param(var c.rx, 4)
    var status = ll_dtm.rx_status(channel, phy, modulation)
    if status == STATUS_SUCCESS and phy >= 3 and not c.coded
        status = STATUS_UNSUPPORTED_FEATURE
    if status == STATUS_SUCCESS
        status = ll_dtm.cte_status(cte, cte_type, phy >= 3)
    if status == STATUS_SUCCESS and dtm_cannot_start(var c)
        status = STATUS_COMMAND_DISALLOWED
    if status == STATUS_SUCCESS
        ll_dtm.dtm_start_rx(var c.dtm, channel, phy, modulation)
    answer_status(var c, opcode, status)

// LE Transmitter Test [v1] to [v4] ([Vol 4] Part E, Section 7.8.29).  A version that lacks
// the PHY transmits on LE 1M, and one that lacks TX_Power_Level at the highest level.
@satisfies("REQ-BLE-CTL-071")
@tier(embedded)
fn cmd_le_transmitter_test(var c: Controller, opcode: Int)
    let channel = h4_rx.h4_param(var c.rx, 0)
    let length = h4_rx.h4_param(var c.rx, 1)
    let payload = h4_rx.h4_param(var c.rx, 2)
    var phy = 1
    var cte = 0
    var cte_type = 0
    var power = TX_POWER_MAX_DBM
    if opcode != OP_LE_TRANSMITTER_TEST_V1
        phy = h4_rx.h4_param(var c.rx, 3)
    if opcode == OP_LE_TRANSMITTER_TEST_V3 or opcode == OP_LE_TRANSMITTER_TEST_V4
        cte = h4_rx.h4_param(var c.rx, 4)
        cte_type = h4_rx.h4_param(var c.rx, 5)
    if opcode == OP_LE_TRANSMITTER_TEST_V4
        power = ll_dtm.power_of(h4_rx.h4_param(var c.rx, h4_rx.h4_param_len(var c.rx) - 1),
            TX_POWER_MIN_DBM,
            TX_POWER_MAX_DBM)
    var status = ll_dtm.tx_status(channel, payload, phy)
    if status == STATUS_SUCCESS and phy >= 3 and not c.coded
        status = STATUS_UNSUPPORTED_FEATURE
    if status == STATUS_SUCCESS
        status = ll_dtm.cte_status(cte, cte_type, phy >= 3)
    if status == STATUS_SUCCESS and dtm_cannot_start(var c)
        status = STATUS_COMMAND_DISALLOWED
    if status == STATUS_SUCCESS
        ll_dtm.dtm_start_tx(var c.dtm, channel, length, payload, phy, power)
    answer_status(var c, opcode, status)

// LE Test End ([Vol 4] Part E, Section 7.8.30): the status and the packets the receiver took
// (0 after a transmitter test).  Command Disallowed when no test runs.
@satisfies("REQ-BLE-CTL-071")
@tier(embedded)
fn cmd_le_test_end(var c: Controller)
    var status = STATUS_SUCCESS
    var n = 0
    if ll_dtm.dtm_active(var c.dtm)
        n = ll_dtm.dtm_end(var c.dtm)
    else
        status = STATUS_COMMAND_DISALLOWED
    let slot = complete_begin(var c, OP_LE_TEST_END, status)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put_u16(var c.pool, slot, n)
    complete_send(var c, slot)

// ── The program's calls ─────────────────────────────────────────────

// Whether the Controller takes the next octet of the Host's stream.  It does
// not while a command waits to be answered or waits for the hardware.
pub @no_alloc
@tier(embedded)
fn ctl_accepts(var c: Controller) -> Bool
    not h4_rx.h4_has_command(var c.rx) and (c.pending as Int) == PEND_NONE

// Whether the Host's stream is inside a packet, the rest of which follows.
pub @no_alloc
@tier(embedded)
fn ctl_in_packet(var c: Controller) -> Bool
    h4_rx.h4_in_packet(var c.rx)

// Give the Controller the next octet of the Host's stream.  The caller has
// checked `ctl_accepts`.  A loss of synchronization queues the Hardware
// Error event now, or at the next `ctl_step` when no slot is free.
pub @satisfies("REQ-BLE-CTL-001")
@satisfies("REQ-BLE-CTL-002")
@no_alloc
@tier(embedded)
fn ctl_rx(var c: Controller, b: Int)
    let fed = h4_rx.h4_feed(var c.rx, b)
    if fed == h4_rx.FEED_LOST
        if not hardware_error(var c, HW_ERROR_STREAM_LOST)
            c.hw_owed = true
    else if fed == h4_rx.FEED_ACL
        acl_to_link(var c)
    else if ctl_limits.iso_on() and fed == h4_rx.FEED_ISO
        iso_to_cis(var c)

// An HCI ACL Data packet from the Host is complete: its payload goes to the
// queue of the connection its handle names, as the first fragment of an L2CAP message unless its
// Packet_Boundary_Flag says it continues one.  A packet for a handle that is
// not on, or one that finds the buffers full, is dropped and counted.
@satisfies("REQ-BLE-CTL-015")
@no_alloc
@tier(embedded)
fn acl_to_link(var c: Controller)
    let at = handle_slot(var c, h4_rx.h4_acl_handle(var c.rx))
    let start = h4_rx.h4_acl_pb(var c.rx) != 1
    var ok = false
    if at >= 0
        ok = ll_link.link_queue_acl(var c.links[at], start, var c.rx.acl, h4_rx.h4_acl_len(var c.rx))
    if not ok
        c.dropped_acl = c.dropped_acl + 1

// Do the work that is due: send a Hardware Error that was owed, and answer
// the command that is complete when a slot is free for its answer.  True
// when a command was run.
pub @satisfies("REQ-BLE-CTL-005")
@no_alloc
@tier(embedded)
fn ctl_step(var c: Controller) -> Bool
    if c.hw_owed and hardware_error(var c, HW_ERROR_STREAM_LOST)
        c.hw_owed = false
    if ctl_limits.iso_on()
        let _i = ctl_iso_poll(var c)
    if ctl_limits.big_on()
        let _b = ctl_big_poll(var c)
    if ctl_limits.past_on()
        let _t = ctl_past_poll(var c)
    if ctl_limits.pcl_on()
        let _p = ctl_pcl_poll(var c)
    if ctl_limits.sub_on()
        let _u = ctl_sub_poll(var c)
    if ctl_limits.rate_on()
        let _w = ctl_rate_poll(var c)
    if ctl_limits.fs_on()
        let _f = ctl_fs_poll(var c)
    if noble_controller_config.CTL_CS > 0
        let _s = ctl_cs_poll(var c)
    if ctl_limits.pawr_adv_on()
        ctl_pawr_poll(var c)
    ctl_flush_events(var c)
    if not h4_rx.h4_has_command(var c.rx) or (c.pending as Int) != PEND_NONE
        return false
    if ctl_pool.pool_free(var c.pool) < 1
        return false
    dispatch(var c)
    h4_rx.h4_done(var c.rx)
    true

// The packet slots free for the Host's events.
pub @no_alloc
@tier(embedded)
fn ctl_pool_free(var c: Controller) -> Int
    ctl_pool.pool_free(var c.pool)

// Whether an octet is waiting to go to the Host.
pub @no_alloc
@tier(embedded)
fn ctl_tx_pending(var c: Controller) -> Bool
    ctl_pool.pool_tx_pending(var c.pool)

// The next octet to send to the Host, -1 when there is none.
pub @no_alloc
@tier(embedded)
fn ctl_tx_next(var c: Controller) -> Int
    ctl_pool.pool_tx_next(var c.pool)

// The Host's port as the Controller sends to it.  The octets of an event leave through a port that the Host's flow control can hold:
// a Host that does not read its end (a PC that is busy, a bridge that is blocked) leaves the UART's transmitter waiting for CTS for
// as long as it likes.  A port therefore answers whether it takes one more octet now, and the Controller offers it an octet only
// when it does; a port never waits for the Host.  The Link Layer is polled by the same loop and its connection events and
// isochronous events run on the clock, so a loop that waited here missed them all and every link of the Controller ended with the
// supervision timeout while the Host was silent.
pub trait HostTx[e]
    // Whether the port can take one more octet now: false when the octet before it has not left (the Host holds it).
    fn ready(var self) -> Bool [e]
    // Hand the port one octet; called only after `ready` answered true.
    fn send(var self, b: Int) [e]

// Offer the octets that wait for the Host to `port`, at most `most` of them, and stop at the first the port will not take.  The
// octets that are not taken stay in the queue, in order; the answer is how many went.
pub @satisfies("REQ-BLE-CTL-078")
@no_alloc
@tier(embedded)
fn ctl_tx_drain<P: HostTx[e]>(var c: Controller, var port: P, most: Int) -> Int [e]
    var sent = 0
    for _ in 0..most
        if not ctl_pool.pool_tx_pending(var c.pool) or not port.ready()
            break
        port.send(ctl_pool.pool_tx_next(var c.pool))
        sent = sent + 1
    sent

// The work the hardware owes: `PEND_NONE`, `PEND_ENCRYPT` or `PEND_RAND`.
pub @tier(embedded)
fn ctl_async_kind(var c: Controller) -> Int
    c.pending as Int

// Octet `i` of the AES key of the LE Encrypt in progress, most significant
// octet first, the order the AES block cipher takes.  The HCI parameter
// holds the key least significant octet first.
@tier(embedded)
fn ctl_async_key(var c: Controller, i: Int) -> Int
    c.key[15 - i] as Int

// Octet `i` of the plaintext of the LE Encrypt in progress, most
// significant octet first.
@tier(embedded)
fn ctl_async_plain(var c: Controller, i: Int) -> Int
    c.block[15 - i] as Int

// Store octet `i` of the result: the ciphertext of LE Encrypt, most
// significant octet first, or the first eight octets of the random number
// of LE Rand.
pub @no_alloc
@tier(embedded)
fn ctl_async_put(var c: Controller, i: Int, v: Int)
    if i >= 0 and i < 16
        c.result[i] = (v & 0xFF) as u8

// Finish the command that waits for the hardware with the result stored by
// `ctl_async_put`, and queue its Command Complete event.  The Encrypted_Data
// is returned least significant octet first.
pub @no_alloc
@tier(embedded)
fn ctl_async_complete(var c: Controller)
    let slot = c.pend_slot
    let kind = c.pending as Int
    c.pending = PEND_NONE as u8
    c.pend_slot = ctl_pool.NO_SLOT
    if slot == ctl_pool.NO_SLOT
        return
    if kind == PEND_ENCRYPT
        for i in 0..16
            let _a = ctl_pool.pool_put(var c.pool, slot, c.result[15 - i] as Int)
    if kind == PEND_RAND
        for i in 0..8
            let _a = ctl_pool.pool_put(var c.pool, slot, c.result[i] as Int)
    complete_send(var c, slot)

// Finish the LE Encrypt command in progress with the cipher: the key and the
// plaintext are the 16 octets most significant first, and so is the answer, which
// `ctl_async_complete` returns least significant first.
pub @satisfies("REQ-BLE-HCI-031")
@tier(embedded)
fn ctl_le_encrypt<C: Cipher[e]>(var c: Controller, var cc: C) [e]
    var key: Vec[u8; 16] = Vec.new()
    var blk: Vec[u8; 16] = Vec.new()
    for i in 0..16
        let _a = key.push(ctl_async_key(var c, i) as u8)
        let _b = blk.push(ctl_async_plain(var c, i) as u8)
    if cc.block(var key, var blk)
        for i in 0..16
            ctl_async_put(var c, i, blk[i] as Int)
        ctl_async_complete(var c)
    else
        ctl_async_fail(var c)

// Finish the command that waits for the hardware with a failure: the
// Command Complete event carries Hardware Failure and no return parameters.
pub @no_alloc
@tier(embedded)
fn ctl_async_fail(var c: Controller)
    let slot = c.pend_slot
    c.pending = PEND_NONE as u8
    c.pend_slot = ctl_pool.NO_SLOT
    if slot == ctl_pool.NO_SLOT
        return
    ctl_pool.pool_patch(var c.pool, slot, 6, STATUS_HARDWARE_FAILURE)
    complete_send(var c, slot)

// ── The Link Layer's calls ──────────────────────────────────────────
//
// The program that owns the radio runs the legacy Link Layer with these
// calls.  It gives the time with `ctl_set_time`, asks `ctl_ll_pick` which
// activity holds the radio, and runs that activity with the calls of
// `ll_adv.nv` and `ll_scan.nv` on `c.adv` and `c.scan`, handing every PDU it
// receives to `ctl_adv_rx`, `ctl_scan_rx` or `ctl_scan_rsp_rx`.  The events
// for the Host are queued in the pool by those calls.

// What the Controller knows of its radio's ramp-up (`ll_radio.profile_of`): the arbiter's lead and guards, the spacing the
// subevents of a stream need and the lateness one is run with follow from it.  The image gives it before the Host's first
// command; `ll_air.ll_poll` gives it on its first call when the image did not.
@tier(embedded)
fn ctl_set_radio(var c: Controller, p: ll_radio.RadioProfile)
    c.radio = p
    ll_arb.arb_radio(var c.arb, p)

// The program's clock, in microseconds.
pub @no_alloc
@tier(embedded)
fn ctl_set_time(var c: Controller, now: Int)
    c.now = now

// Seed the generators of advDelay, of the scan request backoff and of the
// access address of a connection as Central.
pub @tier(embedded)
fn ctl_seed(var c: Controller, seed: Int)
    ll_adv.adv_seed(var c.adv, seed)
    ll_scan.scan_seed(var c.scan, seed)
    ll_init.init_seed(var c.init, seed)
    for k in 0..ctl_limits.padv_n()
        ll_per.padv_seed(var c.pads[k], seed + k)
    c.big_seed = ll_adv.rng_step(seed ^ 0x2545F491)

// Whether the Link Layer has an activity on: advertising, scanning, initiating
// or a connection.
@tier(embedded)
fn ctl_ll_on(var c: Controller) -> Bool
    adv_active(var c) or c.scan.enabled or c.init.enabled or links_live(var c) or per_active(var c) or big_active(var c)

// Whether a connection is on.
@tier(embedded)
fn links_live(var c: Controller) -> Bool
    for slot in 0..noble_controller_config.CTL_LINKS
        if ll_link.link_live(var c.links[slot])
            return true
    false

// Book the arbiter from the state: the advertising event that is due, and
// the next scan window.  Nothing is booked for an activity that is off.
pub @tier(embedded)
fn ctl_ll_book(var c: Controller)
    let xi = ctl_xadv_pick(var c)
    if xi >= 0
        // The event of a set of extended PDUs is the next advertising event: the whole of it is booked.
        let start = c.xsets[xi].due
        var begin = start
        if c.now > begin
            begin = c.now
        ll_arb.arb_book(var c.arb, ll_arb.class_adv(), start, begin + ll_xadv.event_us(var c.xsets[xi]))
    else if c.adv.enabled and not c.adv_wait
        let start = ll_adv.adv_due(var c.adv)
        var begin = start
        if c.now > begin
            begin = c.now
        ll_arb.arb_book(var c.arb, ll_arb.class_adv(), start, begin + ADV_EVENT_BOOK_US)
    else
        ll_arb.arb_cancel(var c.arb, ll_arb.class_adv())
    if c.scan.enabled and c.scan.ext and ll_scan.scan_tick(var c.scan, c.now) == 1
        // The Duration ran out and no Period follows.
        ll_scan.scan_disable(var c.scan)
        c.scan.timeout_owed = true
    if c.scan.enabled
        let start = ll_scan.scan_next_start(var c.scan, c.now)
        ll_arb.arb_book(var c.arb, ll_arb.class_scan(), start, ll_scan.scan_window_end(var c.scan, start))
    else if c.init.enabled and not c.init_wait
        // The Initiating state listens in the windows a scanner does, in the same
        // class.
        let start = ll_init.init_next_start(var c.init, c.now)
        ll_arb.arb_book(var c.arb, ll_arb.class_scan(), start, ll_init.init_window_end(var c.init, start))
    else
        ll_arb.arb_cancel(var c.arb, ll_arb.class_scan())
    for slot in 0..noble_controller_config.CTL_LINKS
        book_link(var c, slot)
    if ctl_limits.per_on()
        let pp = ctl_per_pick(var c)
        if pp >= 0
            let start = ctl_per_start(var c, pp)
            var end = start + ctl_per_book_us(var c, pp)
            if end <= c.now
                end = c.now + ctl_per_book_us(var c, pp)
            ll_arb.arb_book(var c.arb, ll_arb.class_per(), start, end)
        else
            ll_arb.arb_cancel(var c.arb, ll_arb.class_per())
    if ctl_limits.iso_on()
        ctl_cis_book(var c)

// Book the connection event of the link in `slot`, whose state is `c.links[slot]`.  An event
// whose booking has run out before the program came to it is still due: the booking
// is extended to the time now, so that the next pick grants the radio to the link and
// `ctl_conn_catch_up` skips the windows that closed.  Without that a program that was
// away longer than the booking covers would never run the link again.
@satisfies("REQ-BLE-CTL-024")
@tier(embedded)
fn book_link(var c: Controller, slot: Int)
    if ll_link.link_live(var c.links[slot]) and not c.links[slot].closing
        let start = ll_link.link_listen_start(var c.links[slot])
        let book = ll_link.link_book_us(var c.links[slot], CONN_EVENT_BOOK_US)
        var end = ll_link.link_listen_end(var c.links[slot]) + book
        if end <= c.now
            end = c.now + book
        ll_arb.arb_book(var c.arb, slot_class(slot), start, end)
    else
        ll_arb.arb_cancel(var c.arb, slot_class(slot))

// The class that holds the radio now: `ll_arb.class_acl()` (a connection event),
// `CLASS_ADV`, `CLASS_SCAN` or `ll_arb.NONE`.  A scan window with too little time before the next
// advertising event is not started; one that runs (`scan_running`) goes on
// to its limit.
@tier(embedded)
fn ctl_ll_pick(var c: Controller, scan_running: Bool) -> Int
    ctl_ll_book(var c)
    let cls = ll_arb.arb_pick(var c.arb, c.now)
    if cls == ll_arb.class_adv() and not ctl_ll_adv_room(var c)
        return ll_arb.NONE
    if cls == ll_arb.class_per() and not ctl_padv_room(var c)
        // The event is given up now, not when its time has passed: a booking that is due and never run would hold the main loop's
        // budget for the HCI stream at a few microseconds until the group's event is over.
        ctl_padv_skip(var c)
        return ll_arb.NONE
    if cls == ll_arb.class_scan()
        if ll_arb.arb_limit(var c.arb, cls, c.now) <= c.now
            return ll_arb.NONE
        if not scan_running and not ll_arb.arb_worth_running(var c.arb, cls, c.now)
            return ll_arb.NONE
    cls

// How far into the arbiter's lead before an isochronous or connection event an event of a periodic train may run: the program needs the
// lead to point the radio at the booking, and the first PDU of a group is built after that, so an event that ends this much later than
// the lead starts still leaves the group's first subevent in its window.
const PADV_LEAD_SLACK_US = 100

// Give up the event of the train that is due next: the train goes on with the one after it.
@tier(embedded)
fn ctl_padv_skip(var c: Controller)
    let p = ctl_per_pick(var c)
    if p >= 0 and p < ctl_limits.padv_n()
        ctl_padv_late(var c, p)

// Whether the event of the periodic train this device advertises that is due next ends before an isochronous or connection event needs
// the radio.  An event that would run into it is given up at once (`ctl_padv_skip`; the train goes on with the next one): a
// PDU cannot be stopped once it is on air, so the subevents it overlapped would be the ones lost.  A group whose ISO interval is no
// divisor of the train's interval (7.5 ms against 100 ms) meets the train's events at three phases in turn, and the one that falls on
// the group's event is the one given up; `big_first_anchor` puts the first anchor point right behind an event, which the check lets
// through.  A synchronization's window and a train with responses are not asked.
@tier(embedded)
fn ctl_padv_room(var c: Controller) -> Bool
    if not ctl_limits.per_on() or not ctl_limits.big_on()
        return true
    let p = ctl_per_pick(var c)
    if p < 0 or p >= ctl_limits.padv_n()
        return true
    if ctl_limits.pawr_adv_on() and ctl_pawr_train(var c, p)
        return true
    let i = xset_find(var c, c.pads[p].handle)
    if i < 0
        return true
    let phy = c.xsets[i].sphy as Int
    var until = c.pads[p].due + ll_per.event_us(var c.pads[p], phy)
    if c.pads[p].big >= 0
        until = until + big_acad_extra_us(phy)
    // The arbiter keeps a guard before a higher booking; the train may use the part of it beyond the lead.
    until = until - (c.arb.guard - c.arb.lead) - PADV_LEAD_SLACK_US
    ll_arb.arb_clear(var c.arb, ll_arb.class_per(), c.now, until)

// Whether an advertising PDU and its exchange fit before the next connection
// event needs the radio.
@satisfies("REQ-BLE-CTL-012")
@tier(embedded)
fn ctl_ll_adv_room(var c: Controller) -> Bool
    ctl_ll_book(var c)
    let xi = ctl_xadv_pick(var c)
    if xi >= 0
        return ll_arb.arb_limit(var c.arb, ll_arb.class_adv(), c.now) - c.now >= ll_xadv.event_us(var c.xsets[xi])
    ll_arb.arb_limit(var c.arb, ll_arb.class_adv(), c.now) - c.now >= ADV_PDU_BUDGET_US

// The time the scan or initiating window running now must end, which is the end
// of the window or the guard before the next advertising event.
@tier(embedded)
fn ctl_ll_scan_limit(var c: Controller) -> Int
    ll_arb.arb_limit(var c.arb, ll_arb.class_scan(), c.now)

// ── The main loop's work for the isochronous streams, against the bookings ──
//
// An HCI ISO Data packet of 250 octets costs the Controller hundreds of microseconds at two points: when its last octet is read (the
// SDU is cut into payloads and put in the ring) and when an SDU is made into packets for the Host (an octet at a time into the pool).
// Neither is a byte of the UART that `move_octets` limits to the room it is given, so a packet whose last octet was read just before a
// connection event started it late; with the SDUs and the connection events of one period the lateness repeats every time and the
// link is lost to the supervision timeout.  The main loop tells the Controller how long it has before the next booking
// (`ctl_set_room`), and the two pieces of work wait for a turn that has the time.  A piece of work that has waited
// `ISO_SKIPS_MAX` turns goes on anyway, so that bookings that follow one another do not keep an SDU for ever.

// The fixed part of that work, in microseconds, and how many turns of the main loop it may wait.
const ISO_PACKET_US = 60
const ISO_SKIPS_MAX = 24

// The time to the next booking that the main loop has for this turn, less the guard: `ctl_ll_room` before the turn.
pub @no_alloc
@tier(embedded)
fn ctl_set_room(var c: Controller, room: Int)
    c.room_us = room

// The microseconds the work on `octets` octets of an ISO packet takes.
@tier(embedded)
fn iso_work_us(var c: Controller, octets: Int) -> Int
    ISO_PACKET_US + ll_radio.octets_us(c.radio, octets)

// Whether work of `cost` microseconds fits in the `left` the turn has: it does, or it has waited long enough.
@satisfies("REQ-BLE-CTL-078")
@tier(embedded)
fn work_fits(var c: Controller, cost: Int, left: Int) -> Bool
    if cost <= left
        c.room_skips = 0
        return true
    c.room_skips = c.room_skips + 1
    if c.room_skips > ISO_SKIPS_MAX
        c.room_skips = 0
        return true
    false

// The microseconds the octet the reader takes next costs beyond its own: 0 for all but the last of an HCI ISO Data packet.  The main
// loop asks before it reads the octet (`ctl_rx_fits`).
@no_alloc
@tier(embedded)
fn ctl_rx_cost_us(var c: Controller) -> Int
    if ctl_limits.iso_on() and h4_rx.h4_iso_last(var c.rx)
        return iso_work_us(var c, h4_rx.h4_iso_octets(var c.rx))
    0

// Whether the main loop, which has `left` microseconds before the next booking's guard, may read the next octet.
pub @satisfies("REQ-BLE-CTL-078")
@no_alloc
@tier(embedded)
fn ctl_rx_fits(var c: Controller, left: Int) -> Bool
    let cost = ctl_rx_cost_us(var c)
    if cost == 0
        return true
    work_fits(var c, cost, left)

// The microseconds the main loop has for the HCI stream before the Link Layer needs the program for a booking made at the last
// `ctl_ll_pick` (`ll_arb.arb_room`).  It leaves the stream `ll_radio.stream_guard_us` before the start of a booking: the radio
// program is entered, the radio pointed and the receiver started by the booking's start less its ramp-up, and the octet the
// stream was on takes 10 more.
pub @tier(embedded)
fn ctl_ll_room(var c: Controller, now: Int) -> Int
    ll_arb.arb_room(var c.arb, now, c.arb.stream_guard)

// The soonest the Link Layer wants the radio, `ll_arb.NONE` when it is idle.
@tier(embedded)
fn ctl_ll_next_start(var c: Controller) -> Int
    ctl_ll_book(var c)
    ll_arb.arb_next_start(var c.arb)

// ── Privacy ─────────────────────────────────────────────────────────
//
// [Vol 6] Part B, Section 6.  The Link Layer decides inside T_IFS what a PDU is
// worth, and a hash of a Resolvable Private Address (RPA) against every IRK of the list
// is too long for that; so the decisions compare an RPA with the ones already
// resolved (`ll_privacy.rl_cached_at`, in place in the PDU), and an address not seen before is queued for the
// program, which resolves it with the chip's AES engine between the activities
// (`ctl_privacy_poll`).  A device's first PDU is therefore judged as the PDU of a stranger
// and its next one as the device's.  The reports to the Host are the exception: a
// report that waits for the hash is held, and sent with the identity address.

// What is queued for the program to resolve: nothing, an address a peer used as its own,
// or one a directed advertiser made for this device.
const RQ_NONE = 0
const RQ_PEER = 1
const RQ_TARGET = 2

// The peer address the Host gave LE Set Advertising Parameters.
@tier(embedded)
fn adv_peer_vec(var c: Controller) -> Vec[u8; 6]
    var a: Vec[u8; 6] = Vec.new()
    for k in 0..6
        let _p = a.push(c.adv.peer[k])
    a

// The local RPA of entry `i`.
@tier(embedded)
fn rl_local_vec(var c: Controller, i: Int) -> Vec[u8; 6]
    var a: Vec[u8; 6] = Vec.new()
    for k in 0..6
        let _p = a.push(c.rl.local_rpa[i * 6 + k])
    a

// The peer RPA of entry `i`.
@tier(embedded)
fn rl_peer_vec(var c: Controller, i: Int) -> Vec[u8; 6]
    var a: Vec[u8; 6] = Vec.new()
    for k in 0..6
        let _p = a.push(c.rl.peer_rpa[i * 6 + k])
    a

// The identity address of entry `i`.
@tier(embedded)
fn rl_identity_vec(var c: Controller, i: Int) -> Vec[u8; 6]
    var a: Vec[u8; 6] = Vec.new()
    for k in 0..6
        let _p = a.push(c.rl.addr[i * 6 + k])
    a

// Queue the address for the program to resolve when it has no other.
@tier(embedded)
fn queue_resolve(var c: Controller, var a: Vec[u8; 6], kind: Int)
    if c.rq_kind == RQ_NONE
        for k in 0..6
            c.rq_addr[k] = a[k]
        c.rq_kind = kind

// The octets of a PDU the judgement reads: the header and the two addresses.  The radio
// program judges a PDU with only these read, so a copy for the judgement takes no more.
const HEAD_OCTETS = 14

// Copy the header and addresses of `src`, the part the judgement reads, into `dst`.
@tier(embedded)
fn copy_head(var dst: Pdu, var src: Pdu)
    dst.n = src.n
    for i in 0..HEAD_OCTETS
        dst.b[i] = src.b[i]

// Rewrite the sender (payload offset 0, type bit TxAdd) of the PDU `p` as the identity
// address of entry `i`.
@tier(embedded)
fn rewrite_in(var c: Controller, var p: Pdu, i: Int)
    p.b[0] = ((p.b[0] as Int & 0xBF) | (c.rl.kind[i] as Int << 6)) as u8
    for k in 0..6
        p.b[2 + k] = c.rl.addr[i * 6 + k]

// What the resolving list makes of the sender of the PDU `rx` (the address at payload
// offset 0 with the type bit TxAdd).  The answer is 0 when privacy does not apply (resolution
// is off, the list is empty, the sender is no RPA of the list, or an RPA that matched
// no entry), 1 when the sender was an RPA that resolved: `c.view` is a copy of the PDU with
// its identity address, 2 when it is an RPA not seen before, queued for the program, and
// 3 when it is the identity address of a device in network privacy mode with an IRK, which the
// Controller does not accept ([Vol 6] Part B, Section 4.7).
@satisfies("REQ-BLE-CTL-037")
@tier(embedded)
fn privacy_sender(var c: Controller, var rx: Pdu) -> Int
    c.view_ent = -1
    if not c.rl.enable or ll_privacy.rl_count(var c.rl) == 0
        return 0
    let kind = (rx.b[0] as Int >>> 6) & 1
    if kind == 1 and (rx.b[7] as Int & 0xC0) == 0x40
        let idx = ll_privacy.rl_cached_at(var c.rl, var rx.b, 2)
        if idx >= 0
            copy_head(var c.view, var rx)
            rewrite_in(var c, var c.view, idx)
            c.view_ent = idx
            return 1
        if ask_to_resolve(var c, var rx, 2, RQ_PEER)
            return 2
        return 0
    let id = ll_privacy.rl_find_at(var c.rl, kind, var rx.b, 2)
    c.view_ent = id
    if id >= 0 and ll_privacy.rl_peer_has_irk(var c.rl, id) and (c.rl.mode[id] as Int) == ll_privacy.MODE_NETWORK
        return 3
    0

// Whether the sender of the PDU (the address at payload offset 0 with the type
// bit TxAdd) is in the Filter Accept List.
@tier(embedded)
fn fal_has_sender(var c: Controller, var rx: Pdu) -> Bool
    let kind = ll_pdu.pdu_tx_add(var rx)
    for i in 0..FILTER_ACCEPT_LIST_SIZE
        if c.fal_used[i] and (c.fal_type[i] as Int) == kind
            var same = true
            for k in 0..6
                if c.fal_addr[i * 6 + k] != rx.b[2 + k]
                    same = false
                    break
            if same
                return true
    false

// Enter the Advertising state with the address the Own_Address_Type asks for: the
// Resolvable Private Address of entry `ent` when `loc` says it has a local IRK (the
// advertiser waits for it when none has been made), otherwise the public or the random
// address.  Directed advertising to a peer that has an IRK names it with an RPA made from
// the IRK, and waits for that too.
@satisfies("REQ-BLE-CTL-037")
@tier(embedded)
fn start_advertising(var c: Controller, own: Int, ent: Int, loc: Bool)
    c.adv_ent = ent
    c.adv_loc = loc
    c.adv_tgt = ent >= 0 and ll_adv.is_directed(c.adv.ty as Int) and ll_privacy.rl_peer_has_irk(var c.rl, ent)
    c.adv_tgt_ok = false
    c.adv_wait = false
    if loc
        var a = rl_local_vec(var c, ent)
        ll_adv.adv_enable(var c.adv, c.now, var a, 1)
        c.adv_wait = not c.rl.local_ok[ent]
    else if (own & 1) == 0
        ll_adv.adv_enable(var c.adv, c.now, var c.public, 0)
    else
        ll_adv.adv_enable(var c.adv, c.now, var c.random, 1)
    if c.adv_tgt
        c.adv_wait = true

// Judge the PDU received after an advertisement: `ll_adv.RX_SCAN_REQ`,
// `RX_CONNECT_IND` or `RX_NONE`.  The Filter Accept List is read only when the
// advertising filter policy uses it.
pub @tier(embedded)
fn ctl_adv_rx(var c: Controller, var rx: Pdu, got: Int) -> Int
    c.adv_st = 0
    // The sender of a request, ScanA or InitA, is judged as the identity it resolves to.
    let ty = ll_pdu.pdu_type(var rx)
    if ty == ll_pdu.SCAN_REQ or ty == ll_pdu.CONNECT_IND
        let st = privacy_sender(var c, var rx)
        if st == 3
            return ll_adv.RX_NONE
        if ty == ll_pdu.CONNECT_IND and st != 0
            c.adv_st = st
            c.ci_pent = c.view_ent
            for k in 0..6
                c.ci_rpa[k] = rx.b[2 + k]
        if st == 1
            var seen = false
            if (c.adv.policy as Int) != ll_adv.POLICY_ALL
                seen = fal_has_sender(var c, var c.view)
            return ll_adv.adv_rx(var c.adv, var c.view, got, seen)
    var listed = false
    if (c.adv.policy as Int) != ll_adv.POLICY_ALL
        listed = fal_has_sender(var c, var rx)
    ll_adv.adv_rx(var c.adv, var rx, got, listed)

// The PDU and the exchange after it ended at `end`.  High duty cycle directed
// advertising that has run its time stops and tells the Host with an LE
// Connection Complete event carrying Advertising Timeout.
@tier(embedded)
fn ctl_adv_pdu_end(var c: Controller, end: Int)
    ll_adv.adv_pdu_end(var c.adv, end)
    // A set of legacy PDUs ends with a set event, not with a Connection Complete event that says timeout.
    legacy_set_check(var c, end)
    if c.adv.enabled and ll_adv.adv_timed_out(var c.adv)
        ll_adv.adv_disable(var c.adv)
        ll_arb.arb_cancel(var c.arb, ll_arb.class_adv())
        if le_event_enabled(var c, SUB_LE_CONNECTION_COMPLETE)
            if ctl_pool.pool_free(var c.pool) >= 1
                let slot = ctl_pool.evt_begin(var c.pool, hci_frame.EVT_LE_META_EVENT)
                let _a = ctl_pool.pool_put(var c.pool, slot, SUB_LE_CONNECTION_COMPLETE)
                let _b = ctl_pool.pool_put(var c.pool, slot, STATUS_ADVERTISING_TIMEOUT)
                put_zeros(var c, slot, 17)
                let _c = ctl_pool.evt_send(var c.pool, slot)
            else
                c.dropped_events = c.dropped_events + 1

// ── The extended advertiser, for the radio program ──────────────────

// The set of extended PDUs whose event is due first, -1 when no such set is enabled.
@tier(embedded)
fn ctl_xadv_pick(var c: Controller) -> Int
    var best = -1
    if not ctl_limits.xadv_on()
        return -1
    for i in 0..ctl_limits.sets()
        if c.xsets[i].on and not ll_xadv.is_legacy(var c.xsets[i]) and not xset_waits(var c, i)
            if best < 0 or c.xsets[i].due < c.xsets[best].due
                best = i
    best

// The time the event of set `i` is due.
@tier(embedded)
fn ctl_xadv_due(var c: Controller, i: Int) -> Int
    c.xsets[i].due

// Whether the event of the set `i` is the next advertising event: no legacy advertising is due sooner.
@tier(embedded)
fn ctl_xadv_first(var c: Controller, i: Int) -> Bool
    if i < 0
        return false
    not c.adv.enabled or c.xsets[i].due <= ll_adv.adv_due(var c.adv)

// Whether the whole event of set `i` fits before the next booking of a higher-priority class.
@tier(embedded)
fn ctl_xadv_room(var c: Controller, i: Int) -> Bool
    ctl_ll_book(var c)
    ll_arb.arb_limit(var c.arb, ll_arb.class_adv(), c.now) - c.now >= ll_xadv.event_us(var c.xsets[i])

// An event of set `i` begins at `start`: the legacy advertiser is loaded with the set's address, type and filter policy,
// which is what judges the request that follows the AUX_ADV_IND, and the Data ID the event sends is the set's.
@satisfies("REQ-BLE-CTL-091")
@tier(embedded)
fn ctl_xadv_begin(var c: Controller, i: Int, start: Int)
    c.xsets[i].anchor = start
    let ty = ll_xadv.engine_type(var c.xsets[i])
    ll_adv.adv_set_params(var c.adv,
        c.xsets[i].int_min,
        c.xsets[i].int_max,
        ty,
        c.xsets[i].own as Int,
        c.xsets[i].peer_type as Int,
        c.xsets[i].chmap as Int,
        c.xsets[i].policy as Int)
    for k in 0..6
        c.adv.addr[k] = c.xsets[i].addr[k]
        c.adv.tgt[k] = c.xsets[i].peer[k]
        c.adv.peer[k] = c.xsets[i].peer[k]
    c.adv.addr_type = c.xsets[i].atype
    c.adv.tgt_type = c.xsets[i].peer_type
    // A Resolvable Private Address is the one made this timeout: the AdvA, and the TargetA of a directed set.
    if c.xsets[i].loc and c.xsets[i].ent >= 0 and c.rl.local_ok[c.xsets[i].ent]
        var a = rl_local_vec(var c, c.xsets[i].ent)
        ll_xadv.xset_use_addr(var c.xsets[i], var a, 1)
        for k in 0..6
            c.adv.addr[k] = a[k]
        c.adv.addr_type = 1
    if c.xsets[i].tgt and c.xsets[i].tgt_ok
        var t = rl_peer_vec(var c, c.xsets[i].ent)
        ll_xadv.xset_use_target(var c.xsets[i], var t, 1)
        for k in 0..6
            c.adv.tgt[k] = t[k]
        c.adv.tgt_type = 1
    c.adv_st = 0
    c.adv_ent = c.xsets[i].ent
    c.adv_loc = c.xsets[i].loc
    c.adv_tgt = c.xsets[i].tgt
    c.adv_tgt_ok = c.xsets[i].tgt_ok
    c.adv_xset = i

// The event of set `i` ended at `end`: the set goes on to its next event, or ends and the Host is owed LE Advertising Set
// Terminated.
@satisfies("REQ-BLE-CTL-091")
@tier(embedded)
fn ctl_xadv_end(var c: Controller, i: Int, end: Int)
    c.adv_xset = -1
    if c.xsets[i].on and not ll_xadv.xset_event_end(var c.xsets[i], end)
        ll_arb.arb_cancel(var c.arb, ll_arb.class_adv())

// A request arrived after a PDU of set `i`: judge it by the loaded advertiser (`ctl_adv_rx`).  A scan request that is answered
// is told to the Host if the set asked.
@tier(embedded)
fn ctl_xadv_scan_request(var c: Controller, var rx: Pdu)
    if c.adv_xset >= 0
        ev_scan_request(var c, c.adv_xset, var rx)
    else if c.adv_set >= 0
        ev_scan_request(var c, c.adv_set, var rx)

// The AUX_CONNECT_REQ `rx` (whose end was at `end_us`, on `phy`) passed the filter: the connection opens as `ctl_connect_ind`
// opens one, with the transmit window 2.5 ms after the end of the request, and the set that was connected to ends with LE
// Advertising Set Terminated (Status Success, the handle of the connection).
@satisfies("REQ-BLE-CTL-091")
@tier(embedded)
fn ctl_xadv_connect<P: LinkPolicy>(var c: Controller, var policy: P, var rx: Pdu, end_us: Int,
                                   phy: Int) -> Bool
    let i = c.adv_xset
    if i < 0
        return false
    let slot = connect_open(var c, var policy, var rx, end_us)
    if slot < 0
        return false
    ll_link.link_aux_start(var c.links[slot], phy)
    c.xsets[i].on = false
    c.xsets[i].term = STATUS_SUCCESS
    c.xsets[i].term_conn = slot_handle(slot)
    c.xsets[i].term_owed = true
    c.adv_xset = -1
    true

// The scan response of set `i` and what the program needs to send it.
@tier(embedded)
fn ctl_xadv_rsp_len(var c: Controller, i: Int) -> Int
    c.xsets[i].rlen

// The end of the legacy advertiser's PDU ended a set of legacy PDUs: its events were sent or its Duration ran out.  The state of
// the legacy advertiser is left, and the Host is owed LE Advertising Set Terminated.
@tier(embedded)
fn legacy_set_check(var c: Controller, end: Int)
    let i = c.adv_set
    if i < 0 or not c.adv.enabled
        return
    var status = -1
    c.xsets[i].events = c.adv.events - c.adv_base
    if c.xsets[i].max_ev > 0 and c.adv.idx == 0 and c.xsets[i].events >= c.xsets[i].max_ev
        status = ll_xadv.T_LIMIT
    if status < 0 and c.xsets[i].dur > 0 and end - c.xsets[i].entered >= c.xsets[i].dur * 10000
        status = ll_xadv.T_TIMEOUT
    if status < 0 and ll_adv.adv_timed_out(var c.adv)
        status = ll_xadv.T_TIMEOUT
    if status < 0
        return
    ll_adv.adv_disable(var c.adv)
    ll_arb.arb_cancel(var c.arb, ll_arb.class_adv())
    c.xsets[i].on = false
    c.xsets[i].term = status
    c.xsets[i].term_conn = 0
    c.xsets[i].term_owed = true
    c.adv_set = -1

// Queue an LE Directed Advertising Report event ([Vol 4] Part E, Section 7.7.65.11) for the
// ADV_DIRECT_IND `rx` whose TargetA is an RPA the scanner does not own: the advertiser's
// address and type, the address it directs to (a random address) and the RSSI.
@satisfies("REQ-BLE-CTL-066")
@tier(embedded)
fn report_directed(var c: Controller, var rx: Pdu, rssi: Int)
    if not le_event_enabled(var c, SUB_LE_DIRECTED_ADVERTISING_REPORT)
        return
    if ctl_pool.pool_free(var c.pool) < 2
        c.dropped_events = c.dropped_events + 1
        return
    let slot = ctl_pool.evt_begin(var c.pool, hci_frame.EVT_LE_META_EVENT)
    let _a = ctl_pool.pool_put(var c.pool, slot, SUB_LE_DIRECTED_ADVERTISING_REPORT)
    let _b = ctl_pool.pool_put(var c.pool, slot, 1)
    let _c = ctl_pool.pool_put(var c.pool, slot, 1)
    let _d = ctl_pool.pool_put(var c.pool, slot, ll_pdu.pdu_tx_add(var rx))
    for k in 0..6
        let _e = ctl_pool.pool_put(var c.pool, slot, ll_pdu.pdu_get(var rx, 2 + k))
    let _f = ctl_pool.pool_put(var c.pool, slot, 1)
    for k in 0..6
        let _g = ctl_pool.pool_put(var c.pool, slot, ll_pdu.pdu_get(var rx, 8 + k))
    let _h = ctl_pool.pool_put(var c.pool, slot, rssi & 0xFF)
    let _i = ctl_pool.evt_send(var c.pool, slot)

// Queue an LE Extended Advertising Report event ([Vol 4] Part E, Section 7.7.65.13) with one report: the values
// of `c.xs`, the RSSI, and `len` octets of data from octet `at` of `src`, `status` (`ll_ext.DATA_*`) saying how much
// of the data this report holds.  False when no slot could be spared (a slot is kept for the answer to the
// Host's next command, and the report is counted as dropped); true when it was queued or the Host's event
// mask does not ask for it.
@satisfies("REQ-BLE-CTL-090")
@tier(embedded)
fn report_ext(var c: Controller, rssi: Int, var src: Pdu, at: Int, len: Int, status: Int) -> Bool
    if not le_event_enabled(var c, SUB_LE_EXTENDED_ADVERTISING_REPORT)
        return true
    if ctl_pool.pool_free(var c.pool) < 2
        c.dropped_events = c.dropped_events + 1
        return false
    let slot = ctl_pool.evt_begin(var c.pool, hci_frame.EVT_LE_META_EVENT)
    let _a = ctl_pool.pool_put(var c.pool, slot, SUB_LE_EXTENDED_ADVERTISING_REPORT)
    let _b = ctl_pool.pool_put(var c.pool, slot, 1)
    let _c = ctl_pool.pool_put_u16(var c.pool, slot, c.xs.et | (status << 5))
    let _d = ctl_pool.pool_put(var c.pool, slot, c.xs.atype)
    for k in 0..6
        let _e = ctl_pool.pool_put(var c.pool, slot, c.xs.addr[k] as Int)
    let _f = ctl_pool.pool_put(var c.pool, slot, c.xs.pphy)
    let _g = ctl_pool.pool_put(var c.pool, slot, c.xs.sphy)
    let _h = ctl_pool.pool_put(var c.pool, slot, c.xs.sid)
    let _i = ctl_pool.pool_put(var c.pool, slot, c.xs.txp)
    let _j = ctl_pool.pool_put(var c.pool, slot, rssi & 0xFF)
    let _k = ctl_pool.pool_put_u16(var c.pool, slot, c.xs.pi)
    let _l = ctl_pool.pool_put(var c.pool, slot, c.xs.dtype)
    for k in 0..6
        let _m = ctl_pool.pool_put(var c.pool, slot, c.xs.daddr[k] as Int)
    let _n = ctl_pool.pool_put(var c.pool, slot, len)
    for k in 0..len
        let _o = ctl_pool.pool_put(var c.pool, slot, src.b[at + k] as Int)
    let _p = ctl_pool.evt_send(var c.pool, slot)
    true

// The reports the data of `len` octets takes: one per `ll_ext.REPORT_DATA_MAX`, and one for no data at all.
@tier(embedded)
fn report_count(len: Int) -> Int
    if len <= ll_ext.REPORT_DATA_MAX
        return 1
    2

// Report the data of the PDU `src` (`len` octets from `at`) in as many reports as the event takes, the last
// complete unless `more` says another PDU of the advertisement follows.  False when the pool had no room.
@satisfies("REQ-BLE-CTL-090")
@tier(embedded)
fn report_ext_data(var c: Controller, rssi: Int, var src: Pdu, at: Int, len: Int,
                   more: Bool) -> Bool
    var off = 0
    var left = len
    for _ in 0..2
        var chunk = left
        if chunk > ll_ext.REPORT_DATA_MAX
            chunk = ll_ext.REPORT_DATA_MAX
        left = left - chunk
        var status = ll_ext.DATA_COMPLETE
        if left > 0 or more
            status = ll_ext.DATA_MORE
        if not report_ext(var c, rssi, var src, at + off, chunk, status)
            return false
        off = off + chunk
        if left == 0
            break
    true

// Queue an LE Advertising Report event for the PDU received, with the RSSI in
// dBm.  A slot is kept free for the answer to the Host's next command; with
// none to spare the report is dropped and counted.
@satisfies("REQ-BLE-CTL-010")
@tier(embedded)
fn report_pdu(var c: Controller, var rx: Pdu, rssi: Int)
    report_pdu_id(var c, var rx, rssi, 0)

// The same, naming the address of `rx` as an identity address (`ident` 2: the Address_Type of an extended report
// is 2 or 3) when the resolving list made it from a Resolvable Private Address.  A scanner of the extended
// commands gets the extended report, with the bits of a legacy PDU.
@satisfies("REQ-BLE-CTL-010")
@satisfies("REQ-BLE-CTL-090")
@tier(embedded)
fn report_pdu_id(var c: Controller, var rx: Pdu, rssi: Int, ident: Int)
    let ty = ll_pdu.pdu_type(var rx)
    let et = ll_pdu.report_event_type(ty)
    if et < 0
        return
    if c.scan.ext
        let unresolved = ll_scan.directed_elsewhere(var c.scan, var rx)
        if ll_ext.xctx_legacy(var c.xs, var rx, c.scan.w_conn, ident, unresolved)
            var dlen = ll_pdu.pdu_len(var rx) - ll_pdu.ADDR_OCTETS
            if ty == ll_pdu.ADV_DIRECT_IND
                dlen = 0
            let _r = report_ext(var c, rssi, var rx, 8, dlen, ll_ext.DATA_COMPLETE)
        return
    if ll_scan.directed_elsewhere(var c.scan, var rx)
        report_directed(var c, var rx, rssi)
        return
    if not le_event_enabled(var c, SUB_LE_ADVERTISING_REPORT)
        return
    if ctl_pool.pool_free(var c.pool) < 2
        c.dropped_events = c.dropped_events + 1
        return
    let slot = ctl_pool.evt_begin(var c.pool, hci_frame.EVT_LE_META_EVENT)
    let _a = ctl_pool.pool_put(var c.pool, slot, SUB_LE_ADVERTISING_REPORT)
    let _b = ctl_pool.pool_put(var c.pool, slot, 1)
    let _c = ctl_pool.pool_put(var c.pool, slot, et)
    let _d = ctl_pool.pool_put(var c.pool, slot, ll_pdu.pdu_tx_add(var rx))
    for k in 0..6
        let _e = ctl_pool.pool_put(var c.pool, slot, ll_pdu.pdu_get(var rx, 2 + k))
    var dlen = ll_pdu.pdu_len(var rx) - ll_pdu.ADDR_OCTETS
    if ty == ll_pdu.ADV_DIRECT_IND
        dlen = 0
    let _f = ctl_pool.pool_put(var c.pool, slot, dlen)
    for k in 0..dlen
        let _g = ctl_pool.pool_put(var c.pool, slot, ll_pdu.pdu_get(var rx, 8 + k))
    let _h = ctl_pool.pool_put(var c.pool, slot, rssi & 0xFF)
    let _i = ctl_pool.evt_send(var c.pool, slot)

// The request `req` (SCAN_REQ or CONNECT_IND) was built for the identity address the
// resolving list found; on air it goes to the advertiser's address, the RPA the PDU `rx`
// carried (a random address).
@tier(embedded)
fn address_to_rpa(var req: Pdu, var rx: Pdu)
    req.b[0] = (req.b[0] as Int | 0x80) as u8
    for k in 0..6
        req.b[8 + k] = rx.b[2 + k]

// Set the ScanA of the next request for the device `c.view_ent` names (the entry found
// by `privacy_sender`): the entry's local RPA, or the public or random address the
// Own_Address_Type ends in.
@satisfies("REQ-BLE-CTL-037")
@tier(embedded)
fn scan_address_for(var c: Controller, ent: Int)
    if (c.scan.own as Int) >= 2 and ent >= 0 and ll_privacy.rl_local_has_irk(var c.rl, ent) and c.rl.local_ok[ent]
        var same = c.scan.sa_type == 1
        for k in 0..6
            if c.scan.sa[k] != c.rl.local_rpa[ent * 6 + k]
                same = false
        if not same
            var a = rl_local_vec(var c, ent)
            ll_scan.scan_set_scana(var c.scan, var a, 1)
            ll_scan.put_scana(var c.scan)
    else if (c.scan.own as Int & 1) == 0
        set_scan_plain(var c, var c.public, 0)
    else
        set_scan_plain(var c, var c.random, 1)

// The ScanA for the request to the device `c.view_ent` names.
@tier(embedded)
fn pick_scan_address(var c: Controller)
    scan_address_for(var c, c.view_ent)

// The ScanA the request waits with between decisions: the RPA of the first entry that has
// one, so that a request to a device of the list needs no change after the judgement, which
// the radio would read too late; the request to another device changes it and `ctl_scan_note`
// puts it back.
@satisfies("REQ-BLE-CTL-037")
@tier(embedded)
fn scan_default_address(var c: Controller)
    if not c.scan.enabled or (c.scan.own as Int) < 2
        return
    var first = -1
    for i in 0..ll_privacy.RL_SIZE
        if first < 0 and c.rl.used[i] and ll_privacy.rl_local_has_irk(var c.rl, i) and c.rl.local_ok[i]
            first = i
    scan_address_for(var c, first)

// Make the device address `a` of `kind` the ScanA, when it is not already.
@tier(embedded)
fn set_scan_plain(var c: Controller, var a: Vec[u8; 6], kind: Int)
    var same = (c.scan.sa_type as Int) == kind
    for k in 0..6
        if c.scan.sa[k] != a[k]
            same = false
    if not same
        ll_scan.scan_set_scana(var c.scan, var a, kind)

// Keep the report of an advertisement whose sender is an RPA not seen before, until the
// program has tried it against the list; one report is held, and the one that comes
// while it is held is dropped and counted (the advertiser sends again).
@tier(embedded)
fn hold_report(var c: Controller, var rx: Pdu, rssi: Int)
    var queued = c.rq_kind == RQ_PEER
    if queued
        for k in 0..6
            if c.rq_addr[k] != rx.b[2 + k]
                queued = false
    if c.rp_valid or not queued
        c.rp_dropped = c.rp_dropped + 1
        return
    ll_link.pdu_copy(var c.rp_pdu, var rx)
    c.rp_rssi = rssi
    c.rp_rsp = ll_pdu.pdu_type(var rx) == ll_pdu.SCAN_RSP
    c.rp_valid = true

// The first part of the judgement of an advertising PDU received with a good
// CRC, which a SCAN_REQ waits for: `ll_scan.scan_decide`.  The answer is its mask,
// `ACT_REQUEST` saying the SCAN_REQ in `c.scan.req` is to go out and
// `ACT_ACCEPTED` that `ctl_scan_note` is to follow.  The Filter Accept List is
// read only when the scanning filter policy uses it.
pub @tier(embedded)
fn ctl_scan_decide(var c: Controller, var rx: Pdu, got: Int) -> Int
    c.scan_st = 0
    let st = privacy_sender(var c, var rx)
    if st == 3
        return 0
    var listed = false
    var act = 0
    if st == 1
        if ll_scan.uses_list(c.scan.policy as Int)
            listed = fal_has_sender(var c, var c.view)
        c.scan_st = 1
        c.scan_ent = c.view_ent
        act = ll_scan.scan_decide(var c.scan, var c.view, got, listed)
    else
        c.scan_st = st
        if ll_scan.uses_list(c.scan.policy as Int)
            listed = fal_has_sender(var c, var rx)
        act = ll_scan.scan_decide(var c.scan, var rx, got, listed)
    if (act & ll_scan.ACT_REQUEST) != 0
        // The ScanA of the request: an RPA made with the local IRK of the device's entry
        // when the Own_Address_Type asks for one and the entry has it.
        pick_scan_address(var c)
        ll_scan.put_scana(var c.scan)
        if st == 1
            address_to_rpa(var c.scan.req, var rx)
    act

// The second part: tell the Host about a PDU `ctl_scan_decide` accepted, unless
// the duplicate filter has seen the device, with the RSSI in dBm.
pub @tier(embedded)
fn ctl_scan_note(var c: Controller, var rx: Pdu, rssi: Int)
    scan_default_address(var c)
    if c.scan_st == 1
        // The judgement read the head; the report carries the whole PDU.
        ll_link.pdu_copy(var c.view, var rx)
        rewrite_in(var c, var c.view, c.scan_ent)
        if (ll_scan.scan_note(var c.scan, var c.view) & ll_scan.ACT_REPORT) != 0
            report_pdu_id(var c, var c.view, rssi, 2)
        return
    if c.scan_st == 2
        hold_report(var c, var rx, rssi)
        return
    if (ll_scan.scan_note(var c.scan, var rx) & ll_scan.ACT_REPORT) != 0
        report_pdu(var c, var rx, rssi)

// Judge and report an advertising PDU in one call.  The answer is the mask of
// `ll_scan`: `ACT_REQUEST` says the SCAN_REQ in `c.scan.req` is to go out.
pub @tier(embedded)
fn ctl_scan_rx(var c: Controller, var rx: Pdu, got: Int, rssi: Int) -> Int
    let act = ctl_scan_decide(var c, var rx, got)
    if (act & ll_scan.ACT_ACCEPTED) == 0
        return 0
    let before = c.scan.reports
    ctl_scan_note(var c, var rx, rssi)
    var out = act & ll_scan.ACT_REQUEST
    if c.scan.reports != before
        out = out | ll_scan.ACT_REPORT
    out

// A PDU received with a good CRC as the answer to the SCAN_REQ.
pub @tier(embedded)
fn ctl_scan_rsp_rx(var c: Controller, var rx: Pdu, got: Int, rssi: Int) -> Int
    let st = privacy_sender(var c, var rx)
    if st == 1
        ll_link.pdu_copy(var c.view, var rx)
        rewrite_in(var c, var c.view, c.view_ent)
        let a = ll_scan.scan_rsp_rx(var c.scan, var c.view, got)
        if (a & ll_scan.ACT_REPORT) != 0
            report_pdu_id(var c, var c.view, rssi, 2)
        return a
    let act = ll_scan.scan_rsp_rx(var c.scan, var rx, got)
    if (act & ll_scan.ACT_REPORT) != 0
        if st == 2
            hold_report(var c, var rx, rssi)
        else
            report_pdu(var c, var rx, rssi)
    act

// ── The extended scan ───────────────────────────────────────────────
//
// [Vol 6] Part B, Section 4.4.3.  A scanner of LE Set Extended Scan Parameters hears the legacy PDUs on the primary
// channels as before, and reports them in LE Extended Advertising Report events (`report_pdu_id`).  An ADV_EXT_IND
// has no data: its Auxiliary Pointer says where the AUX_ADV_IND comes (the channel, the PHY and the offset from
// the start of the ADV_EXT_IND), and the AUX_ADV_IND holds the AdvA, the AdvMode and the first data, a pointer to
// the next PDU of the chain (AUX_CHAIN_IND) or, for a scannable advertiser, the answer to an AUX_SCAN_REQ, which
// is an AUX_SCAN_RSP with a chain of its own.  The radio program follows the pointers (`ll_air.xscan_follow`) and
// hands each PDU to the calls below; a PDU is judged by its legacy view (`ll_ext.legacy_view`), so the Filter
// Accept List, the resolving list, the scanning filter policy and the SCAN_REQ backoff are the legacy scanner's.
// The reports follow the PDUs, one or two events for the data of each, all with the values of the PDU that opened
// the advertisement (`c.xs`); a chain that cannot be followed to its end is closed with a report of no data and the
// status Incomplete, data truncated.

// The longest wait for an auxiliary PDU the scanner accepts, from the start of the PDU that points to it.
const XSCAN_FOLLOW_MAX_US = 10000

// The DID the duplicate filter keeps for an advertisement with the Advertising Data Info `did` (-1 for none).
@tier(embedded)
fn xscan_did_key(did: Int) -> Int
    if did < 0
        return 0x8000
    did | 0x8000

// The ADV_EXT_IND `rx` (`n` octets) heard on a primary channel: the addresses it names are kept for the AUX_ADV_IND
// it points to, and the pointer is the answer of `ctl_xscan_next`.
@satisfies("REQ-BLE-CTL-090")
@tier(embedded)
fn ctl_xscan_primary(var c: Controller, var rx: Pdu, n: Int) -> Int
    if not ll_scan.follows_extended(var c.scan) or n < 4
        return -1
    rx.n = n
    ll_ext.xpri_set(var c.xp, var rx, ll_ext.ext_parse(var rx))
    ctl_xscan_next(var c, var rx, n)

// The Auxiliary Pointer of the extended PDU `rx` (`n` octets) that the scanner follows: the octet where it
// starts, -1 when the PDU has none, names a channel that is no data channel, a PHY the radio lacks or is
// reserved, or an offset past `XSCAN_FOLLOW_MAX_US` (counted as not followed).
@satisfies("REQ-BLE-CTL-090")
@tier(embedded)
fn ctl_xscan_next(var c: Controller, var rx: Pdu, n: Int) -> Int
    if not ll_scan.follows_extended(var c.scan) or n < 4
        return -1
    rx.n = n
    let x = ll_ext.ext_parse(var rx)
    if not x.ok or x.aux < 0
        return -1
    c.scan.x_seen = c.scan.x_seen + 1
    let phy = ll_init.aux_phy_of(var rx, x.aux)
    if ll_init.aux_channel(var rx, x.aux) > 36 or ll_init.aux_offset_us(var rx, x.aux) > XSCAN_FOLLOW_MAX_US or phy == 0 or not phy_supported(var c, phy)
        c.scan.x_skipped = c.scan.x_skipped + 1
        return -1
    c.scan.x_followed = c.scan.x_followed + 1
    x.aux

// Whether the radio may be taken from now to `until` for the exchange with an auxiliary PDU: no higher-priority
// booking falls inside it.
@satisfies("REQ-BLE-CTL-090")
@tier(embedded)
fn ctl_xscan_room(var c: Controller, until: Int) -> Bool
    ll_arb.arb_clear(var c.arb, ll_arb.class_scan(), c.now, until)

// The chain was not followed for want of room, or an auxiliary PDU did not come.
@tier(embedded)
fn ctl_xscan_skipped(var c: Controller)
    c.scan.x_skipped = c.scan.x_skipped + 1

@tier(embedded)
fn ctl_xscan_missed(var c: Controller)
    c.scan.x_missed = c.scan.x_missed + 1

// Judge the first PDU of an advertisement on a secondary channel (an AUX_ADV_IND; the first `ll_ext.HEAD_READ`
// octets are read and `n` is the octets of the whole PDU): whether the scanner takes it and whether an
// AUX_SCAN_REQ is to go out, as `ctl_scan_decide` answers for a legacy PDU.  An advertisement with no AdvA is
// anonymous and is taken unless the scanning filter policy reads the Filter Accept List.
@satisfies("REQ-BLE-CTL-090")
@tier(embedded)
fn ctl_xscan_decide(var c: Controller, var rx: Pdu, n: Int) -> Int
    c.xs.live = false
    c.scan_st = 0
    c.xview = false
    rx.n = n
    let x = ll_ext.ext_parse(var rx)
    if not x.ok
        return 0
    if not ll_ext.legacy_view(var rx, x, var c.xp, var c.xv)
        if ll_scan.uses_list(c.scan.policy as Int)
            return 0
        c.scan.seen = c.scan.seen + 1
        return ll_scan.ACT_ACCEPTED
    c.xview = true
    ctl_scan_decide(var c, var c.xv, c.xv.n)

// Whether the pool has room for the reports of `len` octets of data, a slot kept for the Host's next command and,
// when the advertisement goes on (`more`), one for the report that closes it if the chain cannot be followed.
@tier(embedded)
fn xscan_pool_ok(var c: Controller, len: Int, more: Bool) -> Bool
    var need = report_count(len) + 1
    if more
        need = need + 1
    ctl_pool.pool_free(var c.pool) >= need

// Tell the Host about the first PDU `rx` (all `rx.n` octets read) of an advertisement that `ctl_xscan_decide` took,
// heard on the primary PHY `pphy` and the secondary PHY `sphy` (0 for a PDU of the primary channel): the duplicate
// filter, then the report.  1 when the Host was told and the advertisement goes on if the PDU points to more, 0 when it
// was not (a duplicate, or no room in the pool).
@satisfies("REQ-BLE-CTL-090")
@tier(embedded)
fn ctl_xscan_note(var c: Controller, var rx: Pdu, rssi: Int, pphy: Int, sphy: Int) -> Int
    scan_default_address(var c)
    let x = ll_ext.ext_parse(var rx)
    if not x.ok
        return 0
    var key = 0x8000
    if x.adi >= 0
        key = xscan_did_key(ll_ext.adi_did(var rx, x.adi))
    let resolved = c.scan_st == 1
    if c.xview
        c.scan.cur_did = key
        var act = 0
        if resolved
            act = ll_scan.scan_note(var c.scan, var c.view)
        else
            act = ll_scan.scan_note(var c.scan, var c.xv)
        c.scan.cur_did = 0
        if (act & ll_scan.ACT_REPORT) == 0
            return 0
    let more = x.aux >= 0
    if not xscan_pool_ok(var c, x.data_len, more)
        c.dropped_events = c.dropped_events + 1
        return 0
    if not c.xview
        ll_ext.xctx_extended(var c.xs, var rx, x, false, pphy, sphy, 0, var c.xv, -1, 0, false)
    else if resolved
        ll_ext.xctx_extended(var c.xs,
            var rx,
            x,
            false,
            pphy,
            sphy,
            ll_pdu.pdu_tx_add(var c.view),
            var c.view,
            2,
            2,
            false)
    else
        ll_ext.xctx_extended(var c.xs, var rx, x, false, pphy, sphy, ll_pdu.pdu_tx_add(var c.xv), var c.xv, 2, 0, false)
    c.scan.reports = c.scan.reports + 1
    if report_ext_data(var c, rssi, var rx, x.data_at, x.data_len, more)
        return 1
    0

// Judge the first PDU `rx` (all read, `rx.n` octets) of the answer to an AUX_SCAN_REQ, an AUX_SCAN_RSP, and tell
// the Host.  1 when it was told and the answer goes on if the PDU points to more, 0 otherwise (not the answer of the
// advertiser asked, a duplicate, or no room in the pool).
@satisfies("REQ-BLE-CTL-090")
@tier(embedded)
fn ctl_xscan_rsp(var c: Controller, var rx: Pdu, rssi: Int, pphy: Int, sphy: Int) -> Int
    let x = ll_ext.ext_parse(var rx)
    if not x.ok or not c.scan.waiting or not ll_ext.legacy_view(var rx, x, var c.xp, var c.xv)
        return 0
    c.xv.b[0] = ((c.xv.b[0] as Int & 0xF0) | ll_pdu.SCAN_RSP) as u8
    let st = privacy_sender(var c, var c.xv)
    var key = 0x8000
    if x.adi >= 0
        key = xscan_did_key(ll_ext.adi_did(var rx, x.adi))
    c.scan.cur_did = key
    var act = 0
    if st == 1
        act = ll_scan.scan_rsp_rx(var c.scan, var c.view, c.view.n)
    else
        act = ll_scan.scan_rsp_rx(var c.scan, var c.xv, c.xv.n)
    c.scan.cur_did = 0
    if (act & ll_scan.ACT_REPORT) == 0
        return 0
    let more = x.aux >= 0
    if not xscan_pool_ok(var c, x.data_len, more)
        c.dropped_events = c.dropped_events + 1
        return 0
    if st == 1
        ll_ext.xctx_extended(var c.xs,
            var rx,
            x,
            true,
            pphy,
            sphy,
            ll_pdu.pdu_tx_add(var c.view),
            var c.view,
            2,
            2,
            c.scan.w_conn)
    else
        ll_ext.xctx_extended(var c.xs,
            var rx,
            x,
            true,
            pphy,
            sphy,
            ll_pdu.pdu_tx_add(var c.xv),
            var c.xv,
            2,
            0,
            c.scan.w_conn)
    if report_ext_data(var c, rssi, var rx, x.data_at, x.data_len, more)
        return 1
    0

// Tell the Host about a PDU that follows the first (an AUX_CHAIN_IND, all read): its data, with the values the
// first PDU gave.  1 when it was told and the chain goes on if the PDU points to more, 0 otherwise.
@satisfies("REQ-BLE-CTL-090")
@tier(embedded)
fn ctl_xscan_chain(var c: Controller, var rx: Pdu, rssi: Int) -> Int
    let x = ll_ext.ext_parse(var rx)
    if not x.ok or not c.xs.live
        return 0
    let more = x.aux >= 0
    if not xscan_pool_ok(var c, x.data_len, more)
        c.dropped_events = c.dropped_events + 1
        return 0
    if report_ext_data(var c, rssi, var rx, x.data_at, x.data_len, more)
        return 1
    0

// A chain that was reported with data to come could not be followed to its end (the next PDU did not come, or
// there was no room for it): close it with a report of no data and the status Incomplete, data truncated.
@satisfies("REQ-BLE-CTL-090")
@tier(embedded)
fn ctl_xscan_cut(var c: Controller, rssi: Int)
    if c.xs.live
        c.scan.x_truncated = c.scan.x_truncated + 1
        let _r = report_ext(var c, rssi, var c.xv, 0, 0, ll_ext.DATA_TRUNCATED)
    c.xs.live = false

// The advertisement ended.
@tier(embedded)
fn ctl_xscan_end(var c: Controller)
    c.xs.live = false

// ── The periodic trains, for the Host and for the radio program ─────

// LE Periodic Advertising Sync Established ([Vol 4] Part E, Section 7.7.65.14): the first AUX_SYNC_IND of the train came (Status
// Success, and the Sync_Handle), or the train was not heard in six events (Connection Failed to be Established / Synchronization
// Timeout, no handle).  True when the event was sent or masked; false when no slot was free.
@satisfies("REQ-BLE-CTL-094")
@tier(embedded)
fn ev_psync_established(var c: Controller, j: Int) -> Bool
    if ctl_limits.past_on() and c.psyncs[j].past
        return ev_psync_transfer(var c, j)
    let code = psync_code(var c,
        SUB_LE_PERIODIC_ADVERTISING_SYNC_ESTABLISHED,
        SUB_LE_PERIODIC_ADVERTISING_SYNC_ESTABLISHED_V2)
    if not le_event_enabled(var c, code)
        c.psyncs[j].owed = ll_per.EV_NONE
        return true
    let slot = meta_begin(var c, code)
    if slot == ctl_pool.NO_SLOT
        return false
    let st = c.psyncs[j].status
    var handle = 0
    if st == STATUS_SUCCESS
        handle = c.psyncs[j].handle
    let _a = ctl_pool.pool_put(var c.pool, slot, st)
    let _b = ctl_pool.pool_put_u16(var c.pool, slot, handle)
    let _c = ctl_pool.pool_put(var c.pool, slot, c.psyncs[j].sid)
    let _d = ctl_pool.pool_put(var c.pool, slot, c.psyncs[j].kind)
    for k in 0..6
        let _e = ctl_pool.pool_put(var c.pool, slot, c.psyncs[j].addr[k] as Int)
    let _f = ctl_pool.pool_put(var c.pool, slot, c.psyncs[j].phy)
    let _g = ctl_pool.pool_put_u16(var c.pool, slot, c.psyncs[j].interval)
    let _h = ctl_pool.pool_put(var c.pool, slot, c.psyncs[j].sca)
    if ctl_limits.pawr_sync_on() and code == SUB_LE_PERIODIC_ADVERTISING_SYNC_ESTABLISHED_V2
        pawr_tail_put(var c, slot, j)
    event_send(var c, slot)
    c.psyncs[j].owed = ll_per.EV_NONE
    true

// The subevent code of the event of a synchronization the Host is told with: the [v2] form (`v2`) when the build synchronizes to trains with
// responses and the Host enabled it, else the [v1] one (`v1`).
@tier(embedded)
fn psync_code(var c: Controller, v1: Int, v2: Int) -> Int
    if ctl_limits.pawr_sync_on() and le_event_enabled(var c, v2)
        return v2
    v1

// The four octets the [v2] events end with: Num_Subevents, Subevent_Interval, Response_Slot_Delay and Response_Slot_Spacing of the train in slot
// `j`, zero for a train without responses.
@tier(embedded)
fn pawr_tail_put(var c: Controller, slot: Int, j: Int)
    if not ctl_limits.pawr_sync_on() or not c.pws[j].on
        put_zeros(var c, slot, 4)
        return
    let _a = ctl_pool.pool_put(var c.pool, slot, c.pws[j].n_sub)
    let _b = ctl_pool.pool_put(var c.pool, slot, c.pws[j].si_us / ll_pawr.SI_UNIT_US)
    let _c = ctl_pool.pool_put(var c.pool, slot, c.pws[j].delay_us / ll_pawr.SI_UNIT_US)
    let _d = ctl_pool.pool_put(var c.pool, slot, c.pws[j].spacing_us / ll_pawr.SPACING_UNIT_US)

// LE Periodic Advertising Sync Transfer Received ([Vol 4] Part E, Section 7.7.65.24) of the synchronization in slot `j`: the first AUX_SYNC_IND of the
// train a connected device described came (Status Success and the Sync_Handle), or it was not heard in six events (Connection Failed to be Established /
// Synchronization Timeout).  The connection and the Service_Data are those of the sender.  True when the event was sent or masked; false when no slot was free.
@satisfies("REQ-BLE-CTL-109")
@tier(embedded)
fn ev_psync_transfer(var c: Controller, j: Int) -> Bool
    let code = psync_code(var c,
        SUB_LE_PERIODIC_ADVERTISING_SYNC_TRANSFER_RECEIVED,
        SUB_LE_PERIODIC_ADVERTISING_SYNC_TRANSFER_RECEIVED_V2)
    if not le_event_enabled(var c, code)
        c.psyncs[j].owed = ll_per.EV_NONE
        return true
    let slot = meta_begin(var c, code)
    if slot == ctl_pool.NO_SLOT
        return false
    let st = c.psyncs[j].status
    var handle = 0
    if st == STATUS_SUCCESS
        handle = c.psyncs[j].handle
    let _a = ctl_pool.pool_put(var c.pool, slot, st)
    let _b = ctl_pool.pool_put_u16(var c.pool, slot, c.psyncs[j].conn)
    let _c = ctl_pool.pool_put_u16(var c.pool, slot, c.psyncs[j].sdata)
    let _d = ctl_pool.pool_put_u16(var c.pool, slot, handle)
    let _e = ctl_pool.pool_put(var c.pool, slot, c.psyncs[j].sid)
    let _f = ctl_pool.pool_put(var c.pool, slot, c.psyncs[j].kind)
    for k in 0..6
        let _g = ctl_pool.pool_put(var c.pool, slot, c.psyncs[j].addr[k] as Int)
    let _h = ctl_pool.pool_put(var c.pool, slot, c.psyncs[j].phy)
    let _i = ctl_pool.pool_put_u16(var c.pool, slot, c.psyncs[j].interval)
    let _l = ctl_pool.pool_put(var c.pool, slot, c.psyncs[j].sca)
    if ctl_limits.pawr_sync_on() and code == SUB_LE_PERIODIC_ADVERTISING_SYNC_TRANSFER_RECEIVED_V2
        pawr_tail_put(var c, slot, j)
    event_send(var c, slot)
    c.psyncs[j].owed = ll_per.EV_NONE
    true

// LE Periodic Advertising Sync Established with the status Operation Cancelled by Host, after LE Periodic Advertising Create Sync Cancel.
@satisfies("REQ-BLE-CTL-094")
@tier(embedded)
fn ev_psync_cancelled(var c: Controller) -> Bool
    let code = psync_code(var c,
        SUB_LE_PERIODIC_ADVERTISING_SYNC_ESTABLISHED,
        SUB_LE_PERIODIC_ADVERTISING_SYNC_ESTABLISHED_V2)
    if not le_event_enabled(var c, code)
        c.preq.cancel_owed = false
        return true
    let slot = meta_begin(var c, code)
    if slot == ctl_pool.NO_SLOT
        return false
    let _a = ctl_pool.pool_put(var c.pool, slot, ll_per.E_CANCELLED)
    put_zeros(var c, slot, 14)
    if ctl_limits.pawr_sync_on() and code == SUB_LE_PERIODIC_ADVERTISING_SYNC_ESTABLISHED_V2
        put_zeros(var c, slot, 4)
    event_send(var c, slot)
    c.preq.cancel_owed = false
    true

// LE Periodic Advertising Sync Lost ([Vol 4] Part E, Section 7.7.65.16): no packet of the train within the Sync_Timeout.
@satisfies("REQ-BLE-CTL-094")
@tier(embedded)
fn ev_psync_lost(var c: Controller, j: Int) -> Bool
    if not le_event_enabled(var c, SUB_LE_PERIODIC_ADVERTISING_SYNC_LOST)
        c.psyncs[j].owed = ll_per.EV_NONE
        return true
    let slot = meta_begin(var c, SUB_LE_PERIODIC_ADVERTISING_SYNC_LOST)
    if slot == ctl_pool.NO_SLOT
        return false
    let _a = ctl_pool.pool_put_u16(var c.pool, slot, c.psyncs[j].handle)
    event_send(var c, slot)
    c.psyncs[j].owed = ll_per.EV_NONE
    true

// The events the synchronizations owe the Host, in slot order: Sync Established or Sync Lost for each, then the one the Cancel owes.
// False when the pool had no room.
@tier(embedded)
fn flush_psync(var c: Controller) -> Bool
    for j in 0..ctl_limits.psync_n()
        if c.psyncs[j].owed == ll_per.EV_ESTABLISHED and not ev_psync_established(var c, j)
            return false
        if c.psyncs[j].owed == ll_per.EV_LOST and not ev_psync_lost(var c, j)
            return false
    if c.preq.cancel_owed and not ev_psync_cancelled(var c)
        return false
    true

// LE Periodic Advertising Report ([Vol 4] Part E, Section 7.7.65.15) of the synchronization in slot `j`: the Tx Power the first PDU
// gave, the RSSI, no Constant Tone Extension, the status of the data and `len` octets of the PDU `src` from `at`.  False when the
// pool had no room.
@satisfies("REQ-BLE-CTL-094")
@tier(embedded)
fn report_periodic(var c: Controller, j: Int, rssi: Int, var src: Pdu, at: Int, len: Int,
                   status: Int) -> Bool
    let code = psync_code(var c, SUB_LE_PERIODIC_ADVERTISING_REPORT, SUB_LE_PERIODIC_ADVERTISING_REPORT_V2)
    if not le_event_enabled(var c, code)
        return true
    if ctl_pool.pool_free(var c.pool) < 2
        c.dropped_events = c.dropped_events + 1
        return false
    let slot = meta_begin(var c, code)
    if slot == ctl_pool.NO_SLOT
        return false
    let _a = ctl_pool.pool_put_u16(var c.pool, slot, c.psyncs[j].handle)
    let _b = ctl_pool.pool_put(var c.pool, slot, c.psyncs[j].cx_txp)
    let _c = ctl_pool.pool_put(var c.pool, slot, rssi & 0xFF)
    let _d = ctl_pool.pool_put(var c.pool, slot, 0xFF)
    if ctl_limits.pawr_sync_on() and code == SUB_LE_PERIODIC_ADVERTISING_REPORT_V2
        // The event counter of the event the packet came in, and its subevent (0xFF for a train without subevents).
        let _x = ctl_pool.pool_put_u16(var c.pool, slot, c.psyncs[j].cx_counter)
        var sub = 0xFF
        if c.pws[j].on
            sub = c.pws[j].hsub
        let _y = ctl_pool.pool_put(var c.pool, slot, sub)
    let _e = ctl_pool.pool_put(var c.pool, slot, status)
    let _f = ctl_pool.pool_put(var c.pool, slot, len)
    for k in 0..len
        let _g = ctl_pool.pool_put(var c.pool, slot, src.b[at + k] as Int)
    event_send(var c, slot)
    true

// The data of a PDU in as many reports as the event takes (at most two, for the 252 octets a PDU holds): the last complete unless `more`
// says another PDU of the event follows, truncated when `trunc` says it cannot.
@satisfies("REQ-BLE-CTL-094")
@tier(embedded)
fn report_periodic_data(var c: Controller, j: Int, rssi: Int, var src: Pdu, at: Int, len: Int,
                        more: Bool, trunc: Bool) -> Bool
    var off = 0
    var left = len
    for _ in 0..2
        var chunk = left
        if chunk > ll_per.REPORT_DATA_MAX
            chunk = ll_per.REPORT_DATA_MAX
        left = left - chunk
        var status = ll_ext.DATA_COMPLETE
        if left > 0 or more
            status = ll_ext.DATA_MORE
        else if trunc
            status = ll_ext.DATA_TRUNCATED
        if not report_periodic(var c, j, rssi, var src, at + off, chunk, status)
            return false
        off = off + chunk
        if left == 0
            break
    true

// Whether a train this device advertises is sending events, whether it listens to one, and whether either is on.
@tier(embedded)
fn padv_running(var c: Controller) -> Bool
    if not ctl_limits.per_on()
        return false
    for k in 0..ctl_limits.padv_n()
        if c.pads[k].used and c.pads[k].on and c.pads[k].run
            return true
    false

@tier(embedded)
fn psync_active(var c: Controller) -> Bool
    if not ctl_limits.per_on()
        return false
    for j in 0..ctl_limits.psync_n()
        if c.psyncs[j].state != ll_per.PS_FREE
            return true
    false

@tier(embedded)
fn per_active(var c: Controller) -> Bool
    padv_running(var c) or psync_active(var c)

// The event of a periodic train that is due first: the train this device advertises in slot `k` is `k`, the synchronization in slot `j` is
// `ctl_limits.padv_n() + j`; -1 for none.
@tier(embedded)
fn ctl_per_pick(var c: Controller) -> Int
    var best = -1
    var at = 0
    if not ctl_limits.per_on()
        return -1
    for k in 0..ctl_limits.padv_n()
        if c.pads[k].used and c.pads[k].on and c.pads[k].run
            if best < 0 or c.pads[k].due < at
                best = k
                at = c.pads[k].due
    for j in 0..ctl_limits.psync_n()
        if c.psyncs[j].state != ll_per.PS_FREE
            let start = c.psyncs[j].due - ll_per.psync_widen(var c.psyncs[j])
            if best < 0 or start < at
                best = ctl_limits.padv_n() + j
                at = start
    best

// The time the radio program is wanted for the event `p` (`ctl_per_pick`): the event of a train this device advertises starts at its time,
// the receiver of a synchronization opens the widening before it.
@tier(embedded)
fn ctl_per_start(var c: Controller, p: Int) -> Int
    if p < ctl_limits.padv_n()
        return c.pads[p].due
    let j = p - ctl_limits.padv_n()
    c.psyncs[j].due - ll_per.psync_widen(var c.psyncs[j])

// The radio time the booking of the event `p` covers beyond its start: an event of the train, or the window of a synchronization and
// the first PDUs.
@tier(embedded)
fn ctl_per_book_us(var c: Controller, p: Int) -> Int
    if p < ctl_limits.padv_n()
        let i = xset_find(var c, c.pads[p].handle)
        var phy = ll_phy.PHY_1M
        if i >= 0
            phy = c.xsets[i].sphy as Int
        if ctl_limits.pawr_adv_on() and ctl_pawr_train(var c, p)
            return ctl_pawr_book_us(var c, p)
        return ll_per.event_us(var c.pads[p], phy) + 500
    let j = p - ctl_limits.padv_n()
    var extra = 0
    if ctl_limits.pawr_sync_on() and ctl_pwsync_train(var c, j)
        extra = ctl_pwsync_book_us(var c, j)
    2 * ll_per.psync_widen(var c.psyncs[j]) + c.psyncs[j].win + ll_per.SYNC_BOOK_US + extra

// ── The train this device advertises, for the radio program ─────────

// The set of the train in slot `k`, -1 for none.
@tier(embedded)
fn ctl_padv_set(var c: Controller, k: Int) -> Int
    xset_find(var c, c.pads[k].handle)

// The extended event of set `i` starts at `t0` with its AUX_ADV_IND `aux_rel` after.  When the set announces a train the SyncInfo of that
// AUX_ADV_IND is made (the train starts with the first such event, after the whole of the event), and the start of the event moves a few
// microseconds so that the offset the SyncInfo holds sits in its unit.  The answer is the start of the event.
@satisfies("REQ-BLE-CTL-093")
@tier(embedded)
fn ctl_padv_sync(var c: Controller, i: Int, t0: Int, aux_rel: Int) -> Int
    if not ctl_limits.per_on() or not c.xsets[i].si_on
        return t0
    let k = padv_find(var c, c.xsets[i].handle as Int)
    if k < 0 or not c.pads[k].on
        return t0
    let ev = ll_xadv.event_us(var c.xsets[i])
    if not c.pads[k].run
        var first = t0 + ev + ll_per.FIRST_GAP_US
        if ctl_limits.big_on() and c.pads[k].big >= 0
            first = big_align_train(var c, k, i, first)
        ll_per.padv_start(var c.pads[k], c.chmap, first)
        if ctl_limits.pawr_adv_on() and c.pads[k].pawr
            ctl_pawr_start(var c, k)
    t0 + ll_per.plan_syncinfo(var c.pads[k], var c.xsets[i].si, t0 + aux_rel, ev - aux_rel + 300)

// The first event of a train that carries a BIG is moved to right behind a BIG event's predecessor: the time `first` or later at which
// an event ends with the margin the BIGInfo's offset needs before an anchor point of the group.
@tier(embedded)
fn big_align_train(var c: Controller, k: Int, i: Int, first: Int) -> Int
    let g = c.pads[k].big
    let phy = c.xsets[i].sphy as Int
    let delta = ll_phy_greater(ll_per.event_us(var c.pads[k], phy) + big_acad_extra_us(phy) + 600, ll_big.INFO_LEAD_US + 100)
    ll_big.anchor_after(var c.bigs[g], first + delta) - delta

// The event of the train in slot `k` was sent: the next is an interval on.
@satisfies("REQ-BLE-CTL-093")
@tier(embedded)
fn ctl_padv_done(var c: Controller, k: Int)
    c.pads[k].events = c.pads[k].events + 1
    if ctl_limits.past_on()
        ll_per.padv_note_sent(var c.pads[k])
    ll_per.padv_advance(var c.pads[k])

// The program came to the event of the train in slot `k` too late to send it: it is given up, and the counter goes on.
@satisfies("REQ-BLE-CTL-093")
@tier(embedded)
fn ctl_padv_late(var c: Controller, k: Int)
    c.pads[k].late = c.pads[k].late + 1
    c.per_late = c.per_late + 1
    ll_per.padv_advance(var c.pads[k])

// ── The trains this device listens to, for the radio program ────────

// The AUX_ADV_IND `rx` (`n` octets, all read), which started at `t_first` on `phy`, carries a SyncInfo: when a Create Sync is pending
// and the advertiser is the one it names (or one of the Periodic Advertiser List), the slot takes the train and the window of its first
// AUX_SYNC_IND is awaited.  The advertiser is the one `ctl_xscan_decide` judged last.
@satisfies("REQ-BLE-CTL-094")
@tier(embedded)
fn ctl_psync_offer(var c: Controller, var rx: Pdu, n: Int, t_first: Int, phy: Int) -> Bool
    if not ctl_limits.per_on() or not c.preq.pending or c.preq.slot >= 0 or n < 4 or not c.xview
        return false
    rx.n = n
    let x = ll_ext.ext_parse(var rx)
    if not x.ok or x.sync < 0 or x.adi < 0
        return false
    var kind = 0
    var a: Vec[u8; 6] = Vec.new()
    if c.scan_st == 1
        kind = ll_pdu.pdu_tx_add(var c.view) + 2
        for k in 0..6
            let _p = a.push(c.view.b[2 + k])
    else
        kind = ll_pdu.pdu_tx_add(var c.xv)
        for k in 0..6
            let _q = a.push(c.xv.b[2 + k])
    let sid = ll_ext.adi_sid(var rx, x.adi)
    if not ll_per.preq_accepts(var c.preq, var c.pal, kind, var a, sid) or not ll_per.si_usable(var rx, x.sync)
        return false
    if psync_is_synced(var c, sid, kind, var a) or not phy_supported(var c, phy)
        return false
    // A train with responses names its response timing in the ACAD of the AUX_ADV_IND; one that cannot be listened to is not taken.
    var ti = -1
    if ctl_limits.pawr_sync_on() and x.acad_len > 0
        ti = ll_pawr.timing_find(var rx, x.acad_at, x.acad_len)
        if ti >= 0 and not ll_pawr.timing_usable(var rx, ti)
            return false
    let j = psync_free_slot(var c)
    if j < 0
        return false
    ll_per.psync_begin(var c.psyncs[j],
        j,
        var rx,
        x.sync,
        kind,
        var a,
        sid,
        phy,
        t_first,
        c.preq.timeout,
        c.preq.reports)
    if ctl_limits.pawr_sync_on()
        ll_pawr.ps_clear(var c.pws[j])
        if ti >= 0
            ctl_pwsync_begin(var c, j, var rx, ti)
    c.preq.slot = j
    true

// The synchronization in slot `j` heard a PDU of its train, the first PDU of an event or (`chain`) one that follows: `n` octets, all
// read into `rx`, the first bit at `t_first`, the signal `rssi`.  The first PDU of an event is the clock the next event is counted
// from; the PDU is reported with its data.  The answer is the octet of the Auxiliary Pointer to follow (the reports are on, and the
// pointer names a channel and an offset), -1 for none, -2 for a PDU that is none of the train's.
@satisfies("REQ-BLE-CTL-094")
@tier(embedded)
fn ctl_psync_pdu(var c: Controller, j: Int, var rx: Pdu, n: Int, rssi: Int, t_first: Int,
                 chain: Bool) -> Int
    if n < 3
        return -2
    rx.n = n
    let x = ll_ext.ext_parse(var rx)
    if not x.ok or x.mode != 0
        return -2
    if not chain and ctl_limits.big_on() and x.acad_len > 2
        let f = ll_big.acad_find(var rx, x.acad_at, x.acad_len)
        if f >= 0
            ctl_big_info_seen(var c, j, var rx, f / 64, f % 64, t_first)
    let more = x.aux >= 0
    var follow = -1
    if more and c.psyncs[j].reports and ll_init.aux_offset_us(var rx, x.aux) > 0 and ll_init.aux_channel(var rx, x.aux) <= 36 and ll_init.aux_phy_of(var rx, x.aux) != 0
        follow = x.aux
    if not chain
        ll_per.psync_heard(var c.psyncs[j], t_first)
        c.psyncs[j].cx_txp = ll_ext.tx_power(var rx, x)
        c.psyncs[j].cx_live = false
        if c.preq.slot == j
            c.preq.pending = false
            c.preq.slot = -1
    if c.psyncs[j].owed != ll_per.EV_NONE and not flush_psync(var c)
        return -1
    if not c.psyncs[j].reports
        return -1
    let trunc = more and follow < 0
    if not report_periodic_data(var c, j, rssi, var rx, x.data_at, x.data_len, follow >= 0, trunc)
        c.psyncs[j].cx_live = false
        return -1
    c.psyncs[j].cx_live = follow >= 0
    follow

// A chain that was reported with data to come could not be followed to its end (a PDU did not come, or it was too late or no room):
// the report that closes it has no data and the status truncated.
@satisfies("REQ-BLE-CTL-094")
@tier(embedded)
fn ctl_psync_cut(var c: Controller, j: Int, rssi: Int)
    if c.psyncs[j].cx_live
        c.psyncs[j].cx_live = false
        let _r = report_periodic(var c, j, rssi, var c.xv, 0, 0, ll_ext.DATA_TRUNCATED)

// The event of the synchronization in slot `j` brought no packet.
@satisfies("REQ-BLE-CTL-094")
@tier(embedded)
fn ctl_psync_missed(var c: Controller, j: Int)
    if not ll_per.psync_missed(var c.psyncs[j]) and c.preq.slot == j
        c.preq.pending = false
        c.preq.slot = -1

// Whether the radio may be taken from now to `until` for a PDU of a chain: no connection or isochronous event is booked inside it.
@tier(embedded)
fn ctl_psync_room(var c: Controller, until: Int) -> Bool
    ll_arb.arb_clear(var c.arb, ll_arb.class_per(), c.now, until)

// ── Periodic advertising with responses ─────────────────────────────
//
// [Vol 4] Part E, Sections 7.8.61, 7.8.125 to 7.8.127, 7.7.65.36 and 7.7.65.37; [Vol 6] Part B, Section 4.4.2.2.4.  A train with responses
// (LE Set Periodic Advertising Parameters [v2] with Num_Subevents above 0, in a build with `ctl_limits.pawr_adv_on()`) sends an
// AUX_SYNC_SUBEVENT_IND in each subevent and listens in the response slots the Host asked for.  The Controller asks the Host for the data of the
// subevents to come (LE Periodic Advertising Subevent Data Request) as it has buffers for them, the Host gives it with LE Set Periodic Advertising
// Subevent Data, and the responses that came are told with LE Periodic Advertising Response Report.  The synchronizer's side (a build with
// `ctl_limits.pawr_sync_on()`) listens to the subevents the Host chose (LE Set Periodic Sync Subevent), reports their data in the [v2] report and sends
// the response the Host gave (LE Set Periodic Advertising Response Data) in its slot.  The state is in `ll_pawr.nv`; the radio program is in
// `ll_air.nv`.  A build without a side answers the commands of it with Unknown HCI Command, and without the advertiser's answers Unsupported
// Feature or Parameter Value to a train with subevents.

// The command `opcode` of periodic advertising with responses.
@tier(embedded)
fn pawr_dispatch(var c: Controller, opcode: Int)
    match opcode
        0x2082 => cmd_le_set_periodic_advertising_subevent_data(var c)
        0x2083 => cmd_le_set_periodic_advertising_response_data(var c)
        0x2084 => cmd_le_set_periodic_sync_subevent(var c)
        _      => answer_status(var c, opcode, STATUS_UNKNOWN_COMMAND)

// The Command Complete of a command that answers the Status and a 12-bit Sync_Handle.
@tier(embedded)
fn answer_status_sync(var c: Controller, opcode: Int, status: Int, handle: Int)
    let slot = complete_begin(var c, opcode, status)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put_u16(var c.pool, slot, handle)
    complete_send(var c, slot)

// The Status of the data of LE Set Periodic Advertising Subevent Data for the train in slot `k` on the set `i`, with `n` elements (the Subevent, the
// first response slot, the number of slots, the length and the data of each, one after the other): Invalid HCI Command Parameters for a count or a
// length out of range, for the same subevent twice and for slots the train does not have; Command Disallowed for a subevent the Controller did not ask
// about (or whose time has passed); Packet Too Long for data that does not fit a buffer or ends too late for the first response slot.
@satisfies("REQ-BLE-CTL-110")
@tier(embedded)
fn pawr_data_status(var c: Controller, k: Int, i: Int, n: Int) -> Int
    if n < 1 or n > 15
        return STATUS_INVALID_PARAMETERS
    let total = h4_rx.h4_param_len(var c.rx)
    let txp = (c.pads[k].props & ll_xadv.P_TXP) != 0
    let phy = c.xsets[i].sphy as Int
    var at = 2
    for e in 0..n
        if at + 4 > total
            return STATUS_INVALID_PARAMETERS
        let sub = h4_rx.h4_param(var c.rx, at)
        let rs = h4_rx.h4_param(var c.rx, at + 1)
        let rc = h4_rx.h4_param(var c.rx, at + 2)
        let dl = h4_rx.h4_param(var c.rx, at + 3)
        if dl > 254 or at + 4 + dl > total
            return STATUS_INVALID_PARAMETERS
        var q = 2
        for _ in 0..e
            if h4_rx.h4_param(var c.rx, q) == sub
                return STATUS_INVALID_PARAMETERS
            q = q + 4 + h4_rx.h4_param(var c.rx, q + 3)
        if rc > 0 and rs + rc > c.pwa[k].slots
            return STATUS_INVALID_PARAMETERS
        if sub >= c.pwa[k].n_sub or ll_pawr.pa_asked(var c.pwa[k], sub) < 0
            return STATUS_COMMAND_DISALLOWED
        if dl > ctl_limits.pw_data() or not ll_pawr.ind_fits(var c.pwa[k], dl, txp, phy)
            return ll_pawr.E_TOO_LONG
        at = at + 4 + dl
    if at != total
        return STATUS_INVALID_PARAMETERS
    STATUS_SUCCESS

// LE Set Periodic Advertising Subevent Data ([Vol 4] Part E, Section 7.8.125): the data, and the response slots to listen to, of the subevents the
// Controller asked about.  Unknown Advertising Identifier for a set that is not defined; Command Disallowed for a set with no train with responses
// that is enabled.  The data of a subevent is sent once.
@satisfies("REQ-BLE-CTL-110")
@tier(embedded)
fn cmd_le_set_periodic_advertising_subevent_data(var c: Controller)
    let op = OP_LE_SET_PERIODIC_ADVERTISING_SUBEVENT_DATA
    let handle = h4_rx.h4_param(var c.rx, 0)
    let i = xset_find(var c, handle)
    if i < 0
        answer_status_handle(var c, op, ll_xadv.E_UNKNOWN_SET, handle)
        return
    let k = padv_find(var c, handle)
    if k < 0 or not c.pads[k].pawr or not c.pads[k].on or not c.pwa[k].on
        answer_status_handle(var c, op, STATUS_COMMAND_DISALLOWED, handle)
        return
    let n = h4_rx.h4_param(var c.rx, 1)
    let status = pawr_data_status(var c, k, i, n)
    if status == STATUS_SUCCESS
        var at = 2
        for _ in 0..n
            let b = ll_pawr.pa_asked(var c.pwa[k], h4_rx.h4_param(var c.rx, at))
            let dl = h4_rx.h4_param(var c.rx, at + 3)
            ll_pawr.pb_set(var c.pwa[k].bufs[b], ll_pawr.B_FILLED, c.pwa[k].bufs[b].abs, h4_rx.h4_param(var c.rx, at), h4_rx.h4_param(var c.rx, at + 1),
                           h4_rx.h4_param(var c.rx, at + 2), dl)
            for j in 0..dl
                ll_pawr.pb_put(var c.pwa[k].bufs[b], j, h4_rx.h4_param(var c.rx, at + 4 + j))
            at = at + 4 + dl
    answer_status_handle(var c, op, status, handle)

// The buffer of the synchronization in slot `j` that takes a response for the event `target`, subevent `sub`: the one that holds a response for them
// (it is replaced), else a free one; -1 for none.
@tier(embedded)
fn pawr_rbuf(var c: Controller, j: Int, target: Int, sub: Int) -> Int
    var free = -1
    for b in 0..ctl_limits.pw_bufs()
        if c.pws[j].bufs[b].state == ll_pawr.B_FILLED and c.pws[j].bufs[b].abs == target and c.pws[j].bufs[b].sub == sub
            return b
        if c.pws[j].bufs[b].state == ll_pawr.B_FREE and free < 0
            free = b
    free

// LE Set Periodic Advertising Response Data ([Vol 4] Part E, Section 7.8.126): the response in the slot `Response_Slot` of the subevent
// `Response_Subevent`, in the `Request_Event` if that subevent is the `Request_Subevent` or comes after it, else in the event after it.  The Controller
// handles commands between its radio events, so the slot of the request's own subevent is always past when it reads the command (Too Late).  Unknown
// Advertising Identifier for a Sync_Handle the Host does not know; Command Disallowed for a train without responses and for a subevent the
// synchronization does not listen to; Packet Too Long for data a slot cannot hold; Too Late for an event that has passed; Memory Capacity Exceeded when
// all the buffers hold responses.
@satisfies("REQ-BLE-CTL-110")
@tier(embedded)
fn cmd_le_set_periodic_advertising_response_data(var c: Controller)
    let op = OP_LE_SET_PERIODIC_ADVERTISING_RESPONSE_DATA
    let handle = param_u16(var c, 0) & 0x0FFF
    let req_event = param_u16(var c, 2)
    let req_sub = h4_rx.h4_param(var c.rx, 4)
    let rsp_sub = h4_rx.h4_param(var c.rx, 5)
    let slot = h4_rx.h4_param(var c.rx, 6)
    let len = h4_rx.h4_param(var c.rx, 7)
    let j = psync_find_handle(var c, handle)
    var status = STATUS_SUCCESS
    if j < 0
        status = ll_pawr.E_UNKNOWN_ADVERTISING
    else if not c.pws[j].on or rsp_sub >= c.pws[j].n_sub or not ll_pawr.ps_listens(var c.pws[j], rsp_sub)
        status = STATUS_COMMAND_DISALLOWED
    else if len > 254
        status = STATUS_INVALID_PARAMETERS
    else if len > ctl_limits.pw_data() or not ll_pawr.rsp_fits(var c.pws[j], len, c.psyncs[j].phy)
        status = ll_pawr.E_TOO_LONG
    else
        let target = ll_pawr.response_event(req_event, req_sub, rsp_sub)
        if ll_pawr.response_late(target, rsp_sub, c.psyncs[j].counter, ll_pawr.ps_sub(var c.pws[j]))
            status = ll_pawr.E_TOO_LATE
        else
            let b = pawr_rbuf(var c, j, target, rsp_sub)
            if b < 0
                status = ll_pawr.E_MEMORY
            else
                ll_pawr.pb_set(var c.pws[j].bufs[b], ll_pawr.B_FILLED, target, rsp_sub, slot, 0, len)
                for x in 0..len
                    ll_pawr.pb_put(var c.pws[j].bufs[b], x, h4_rx.h4_param(var c.rx, 8 + x))
    answer_status_sync(var c, op, status, handle)

// LE Set Periodic Sync Subevent ([Vol 4] Part E, Section 7.8.127): the subevents the synchronization in slot `Sync_Handle` listens to from now on,
// and whether its responses carry the Tx Power.  Unknown Advertising Identifier for a Sync_Handle the Host does not know; Command Disallowed for a train
// without responses; Invalid HCI Command Parameters for a count of 0 or above 128 and for a subevent the train does not have; Memory Capacity Exceeded
// for more subevents than a synchronization keeps.
@satisfies("REQ-BLE-CTL-110")
@tier(embedded)
fn cmd_le_set_periodic_sync_subevent(var c: Controller)
    let op = OP_LE_SET_PERIODIC_SYNC_SUBEVENT
    let handle = param_u16(var c, 0) & 0x0FFF
    let props = param_u16(var c, 2)
    let n = h4_rx.h4_param(var c.rx, 4)
    let j = psync_find_handle(var c, handle)
    var status = STATUS_SUCCESS
    if j < 0
        status = ll_pawr.E_UNKNOWN_ADVERTISING
    else if not c.pws[j].on
        status = STATUS_COMMAND_DISALLOWED
    else if n < 1 or n > ll_pawr.SUBEVENTS_MAX or (props & 0xFFBF) != 0
        status = STATUS_INVALID_PARAMETERS
    else if n > ll_pawr.SUBS_MAX
        status = ll_pawr.E_MEMORY
    else
        for x in 0..n
            if h4_rx.h4_param(var c.rx, 5 + x) >= c.pws[j].n_sub
                status = STATUS_INVALID_PARAMETERS
        if status == STATUS_SUCCESS
            for x in 0..n
                ll_pawr.ps_put(var c.pws[j], x, h4_rx.h4_param(var c.rx, 5 + x))
            ll_pawr.ps_choose(var c.pws[j], var c.psyncs[j], n, h4_rx.h4_param(var c.rx, 5), (props & 0x40) != 0)
    answer_status_sync(var c, op, status, handle)

// The work of the advertiser's side between the Host and the radio: ask the Host for the data of the subevents to come when buffers are free.
@satisfies("REQ-BLE-CTL-110")
@tier(embedded)
fn ctl_pawr_poll(var c: Controller)
    for k in 0..ctl_limits.padv_n()
        if c.pads[k].used and c.pads[k].on and c.pads[k].run and c.pads[k].pawr and c.pwa[k].on
            let _a = ll_pawr.pa_ask(var c.pwa[k])

// LE Periodic Advertising Subevent Data Request ([Vol 4] Part E, Section 7.7.65.36) of the train in slot `k`.  True when the event was sent or masked;
// false when no slot was free.
@satisfies("REQ-BLE-CTL-110")
@tier(embedded)
fn ev_pawr_request(var c: Controller, k: Int) -> Bool
    if not le_event_enabled(var c, SUB_LE_PERIODIC_ADVERTISING_SUBEVENT_DATA_REQUEST)
        c.pwa[k].ask_owed = false
        return true
    let slot = meta_begin(var c, SUB_LE_PERIODIC_ADVERTISING_SUBEVENT_DATA_REQUEST)
    if slot == ctl_pool.NO_SLOT
        return false
    let _a = ctl_pool.pool_put(var c.pool, slot, c.pads[k].handle)
    let _b = ctl_pool.pool_put(var c.pool, slot, c.pwa[k].ask_sub)
    let _c = ctl_pool.pool_put(var c.pool, slot, c.pwa[k].ask_n)
    event_send(var c, slot)
    c.pwa[k].ask_owed = false
    true

// LE Periodic Advertising Response Report ([Vol 4] Part E, Section 7.7.65.37) of the train in slot `k`: the subevent, whether its AUX_SYNC_SUBEVENT_IND
// was sent, and the responses that came, each with its Tx Power, RSSI, no Constant Tone Extension, slot, a complete status and its data.  True when
// the event was sent or masked; false when no slot was free.
@satisfies("REQ-BLE-CTL-110")
@tier(embedded)
fn ev_pawr_report(var c: Controller, k: Int) -> Bool
    if not le_event_enabled(var c, SUB_LE_PERIODIC_ADVERTISING_RESPONSE_REPORT)
        ll_pawr.pa_reported(var c.pwa[k])
        return true
    let slot = meta_begin(var c, SUB_LE_PERIODIC_ADVERTISING_RESPONSE_REPORT)
    if slot == ctl_pool.NO_SLOT
        return false
    let _a = ctl_pool.pool_put(var c.pool, slot, c.pads[k].handle)
    let _b = ctl_pool.pool_put(var c.pool, slot, c.pwa[k].rep_sub)
    let _c = ctl_pool.pool_put(var c.pool, slot, c.pwa[k].rep_tx)
    let _d = ctl_pool.pool_put(var c.pool, slot, c.pwa[k].rn)
    var o = 0
    for _ in 0..c.pwa[k].rn
        let len = c.pwa[k].rdata[o + 3] as Int
        let _e = ctl_pool.pool_put(var c.pool, slot, c.pwa[k].rdata[o + 2] as Int)
        let _f = ctl_pool.pool_put(var c.pool, slot, c.pwa[k].rdata[o + 1] as Int)
        let _g = ctl_pool.pool_put(var c.pool, slot, 0xFF)
        let _h = ctl_pool.pool_put(var c.pool, slot, c.pwa[k].rdata[o] as Int)
        let _i = ctl_pool.pool_put(var c.pool, slot, 0)
        let _l = ctl_pool.pool_put(var c.pool, slot, len)
        for x in 0..len
            let _m = ctl_pool.pool_put(var c.pool, slot, c.pwa[k].rdata[o + 4 + x] as Int)
        o = o + 4 + len
    event_send(var c, slot)
    ll_pawr.pa_reported(var c.pwa[k])
    true

// The events the advertiser's side owes the Host: the request for data, then the report of the subevent.  False when the pool had no room.
@tier(embedded)
fn flush_pawr(var c: Controller) -> Bool
    for k in 0..ctl_limits.padv_n()
        if c.pwa[k].ask_owed and not ev_pawr_request(var c, k)
            return false
        if c.pwa[k].rep_owed and not ev_pawr_report(var c, k)
            return false
    true

// ── The train with responses this device advertises, for the radio program ──

// The train in slot `k` is one with responses.
@tier(embedded)
fn ctl_pawr_train(var c: Controller, k: Int) -> Bool
    ctl_limits.pawr_adv_on() and c.pads[k].pawr and c.pwa[k].on

// The slot of the train whose Response Timing Information the AUX_ADV_IND of set `i` carries, -1 for none.
@tier(embedded)
fn ctl_padv_acad(var c: Controller, i: Int) -> Int
    if not ctl_limits.pawr_adv_on()
        return -1
    let k = padv_find(var c, c.xsets[i].handle as Int)
    if k >= 0 and c.pads[k].on and c.pads[k].pawr
        return k
    -1

// The train in slot `k` starts: the access address of the responses and the Response Timing Information of the AUX_ADV_IND.
@satisfies("REQ-BLE-CTL-110")
@tier(embedded)
fn ctl_pawr_start(var c: Controller, k: Int)
    ll_pawr.pa_start(var c.pwa[k], ll_pawr.rsp_aa_make(var c.pads[k]))
    ll_pawr.timing_put(var c.pads[k], c.pwa[k].rsp_aa, c.pwa[k].n_sub, c.pwa[k].si_us / ll_pawr.SI_UNIT_US, c.pwa[k].delay_us / ll_pawr.SI_UNIT_US,
                       c.pwa[k].spacing_us / ll_pawr.SPACING_UNIT_US)

// The subevent due: the AUX_SYNC_SUBEVENT_IND in `c.xv`, with the data the Host gave (none when it gave none), and the response slots to listen to
// in `c.pwa[k].cur_rs` and `cur_rc`.  The answer is the subevent number.
@satisfies("REQ-BLE-CTL-110")
@tier(embedded)
fn ctl_pawr_build(var c: Controller, k: Int, i: Int) -> Int
    let b = ll_pawr.pa_due(var c.pwa[k])
    ll_pawr.pa_cur(var c.pwa[k], b)
    ll_pawr.ind_build(var c.pwa[k], b, var c.xv, (c.pads[k].props & ll_xadv.P_TXP) != 0, c.xsets[i].txp)
    ll_pawr.pa_sub(var c.pwa[k])

// The radio time the subevent due takes beyond its start: its AUX_SYNC_SUBEVENT_IND and the response slots it listens in, with a margin.
@tier(embedded)
fn ctl_pawr_book_us(var c: Controller, k: Int) -> Int
    let b = ll_pawr.pa_due(var c.pwa[k])
    var us = 1000
    if b >= 0
        us = us + ll_phy.air_us(ll_phy.PHY_1M, true, ll_pawr.ind_octets(c.pwa[k].bufs[b].len, true))
        if c.pwa[k].bufs[b].rc > 0
            us = us + c.pwa[k].delay_us + (c.pwa[k].bufs[b].rs + c.pwa[k].bufs[b].rc) * c.pwa[k].spacing_us
    us

// The subevent due was over, its AUX_SYNC_SUBEVENT_IND sent (`ok`) or not: the report of it is owed when responses came or it was not sent.
@satisfies("REQ-BLE-CTL-110")
@tier(embedded)
fn ctl_pawr_done(var c: Controller, k: Int, ok: Bool)
    if ok
        c.pads[k].events = c.pads[k].events + 1
        if ctl_limits.past_on()
            // A subevent of this event went out: LL_PERIODIC_SYNC_WR_IND can name the event as the last one this device transmitted.
            ll_per.padv_note_sent(var c.pads[k])
    ll_pawr.pa_over(var c.pwa[k], ll_pawr.pa_sub(var c.pwa[k]), ok)
    ll_pawr.pa_pass(var c.pwa[k])
    ll_per.padv_advance(var c.pads[k])

// The program came to the subevent of the train in slot `k` too late to send it: it is given up, and reported with TX_Status 1.
@satisfies("REQ-BLE-CTL-110")
@tier(embedded)
fn ctl_pawr_late(var c: Controller, k: Int)
    c.pads[k].late = c.pads[k].late + 1
    c.per_late = c.per_late + 1
    ctl_pawr_done(var c, k, false)

// A response was heard in slot `slot` of the subevent due, `rssi` its signal, the AUX_SYNC_SUBEVENT_RSP `n` octets in `rx`: it waits for the report.
@satisfies("REQ-BLE-CTL-110")
@tier(embedded)
fn ctl_pawr_rsp(var c: Controller, k: Int, var rx: Pdu, n: Int, rssi: Int, slot: Int) -> Bool
    if n < 3
        return false
    rx.n = n
    let x = ll_ext.ext_parse(var rx)
    if not x.ok or x.mode != 0
        return false
    let _a = ll_pawr.pa_response(var c.pwa[k], slot, rssi, ll_ext.tx_power(var rx, x), var rx, x.data_at, x.data_len)
    true

// ── The train with responses this device listens to, for the radio program ──

// The synchronization in slot `j` is to a train with responses.
@tier(embedded)
fn ctl_pwsync_train(var c: Controller, j: Int) -> Bool
    ctl_limits.pawr_sync_on() and c.pws[j].on

// The AUX_ADV_IND `rx` (the Periodic Advertising Response Timing Information at the octet `ti` of it) was taken for the synchronization in slot `j`.
@tier(embedded)
fn ctl_pwsync_begin(var c: Controller, j: Int, var rx: Pdu, ti: Int)
    ll_pawr.ps_begin(var c.pws[j], var c.psyncs[j], var rx, ti)

// The AUX_SYNC_SUBEVENT_IND of the synchronization in slot `j`, `n` octets in `rx`, the first bit at `t_first`, was heard.  It is the clock of the
// next window and is reported with its data.  The answer is -2 for a PDU that is not the train's, the buffer of the response the Host gave for this
// subevent (the radio sends it in its slot), or -1 when there is none.
@satisfies("REQ-BLE-CTL-110")
@tier(embedded)
fn ctl_pwsync_pdu(var c: Controller, j: Int, var rx: Pdu, n: Int, rssi: Int, t_first: Int) -> Int
    if n < 3
        return -2
    rx.n = n
    let x = ll_ext.ext_parse(var rx)
    if not x.ok or x.mode != 0
        return -2
    let sub = ll_pawr.ps_sub(var c.pws[j])
    ll_pawr.ps_expire(var c.pws[j], c.psyncs[j].counter)
    let b = ll_pawr.ps_response(var c.pws[j], c.psyncs[j].counter, sub)
    ll_per.psync_heard(var c.psyncs[j], t_first)
    ll_pawr.ps_pass(var c.pws[j], var c.psyncs[j], true, t_first)
    c.pws[j].hsub = sub
    c.psyncs[j].cx_txp = ll_ext.tx_power(var rx, x)
    c.psyncs[j].cx_live = false
    if c.preq.slot == j
        c.preq.pending = false
        c.preq.slot = -1
    if c.psyncs[j].owed != ll_per.EV_NONE and not flush_psync(var c)
        return b
    if c.psyncs[j].reports
        let _r = report_periodic_data(var c, j, rssi, var rx, x.data_at, x.data_len, false, false)
    b

// The window of the synchronization in slot `j` brought no packet.
@satisfies("REQ-BLE-CTL-110")
@tier(embedded)
fn ctl_pwsync_missed(var c: Controller, j: Int)
    if ll_per.psync_missed(var c.psyncs[j])
        ll_pawr.ps_pass(var c.pws[j], var c.psyncs[j], false, 0)
    else if c.preq.slot == j
        c.preq.pending = false
        c.preq.slot = -1

// The AUX_SYNC_SUBEVENT_RSP of the buffer `b` of the synchronization in slot `j` in `c.xv`; the answer is the time of its slot, counted from the start
// `ind_start` of the AUX_SYNC_SUBEVENT_IND, in microseconds.
@satisfies("REQ-BLE-CTL-110")
@tier(embedded)
fn ctl_pwsync_rsp(var c: Controller, j: Int, b: Int, ind_start: Int) -> Int
    ll_pawr.rsp_build(var c.pws[j], b, var c.xv, 0)
    ll_pawr.slot_at(ind_start, c.pws[j].delay_us, c.pws[j].spacing_us, c.pws[j].bufs[b].rs)

// The response of buffer `b` was sent (or could not be): its buffer is free.
@tier(embedded)
fn ctl_pwsync_sent(var c: Controller, j: Int, b: Int)
    ll_pawr.pb_set(var c.pws[j].bufs[b], ll_pawr.B_FREE, 0, 0, 0, 0, 0)

// The radio time the window of the synchronization in slot `j` takes beyond the listening: the response the Host gave for it, from the start of
// the AUX_SYNC_SUBEVENT_IND to the end of the slot.
@tier(embedded)
fn ctl_pwsync_book_us(var c: Controller, j: Int) -> Int
    let b = ll_pawr.ps_response(var c.pws[j], c.psyncs[j].counter, ll_pawr.ps_sub(var c.pws[j]))
    if b < 0
        return 0
    c.pws[j].delay_us + c.pws[j].bufs[b].rs * c.pws[j].spacing_us + 2500

// ── The work of privacy that needs the cipher ──────────────────────

// Whether the Controller needs Resolvable Private Addresses of its own now.
@tier(embedded)
fn privacy_wants_local(var c: Controller) -> Bool
    c.adv.enabled and (c.adv_loc or c.adv_tgt) or c.init.enabled and c.init_loc or c.scan.enabled and (c.scan.own as Int) >= 2 or xsets_want_rpa(var c)

// Whether a set of extended PDUs that is on advertises with a Resolvable Private Address, or names its peer with one.
@tier(embedded)
fn xsets_want_rpa(var c: Controller) -> Bool
    if not ctl_limits.xadv_on()
        return false
    for i in 0..ctl_limits.sets()
        if c.xsets[i].on and (c.xsets[i].loc or c.xsets[i].tgt)
            return true
    false

// Whether the program is to supply random octets to `ctl_entropy_put`.
pub @tier(embedded)
fn ctl_entropy_wanted(var c: Controller) -> Bool
    ll_privacy.rl_count(var c.rl) > 0 and ll_privacy.rl_entropy(var c.rl) < 3

// Give the resolving list 12 random octets.
pub @tier(embedded)
fn ctl_entropy_put(var c: Controller, var v: Vec[u8; 12])
    ll_privacy.rl_entropy_put(var c.rl, var v)

// Whether the work of `ctl_privacy_poll` is pending: an address to resolve, an RPA to
// make, or a report or a connection that waits.
pub @tier(embedded)
fn ctl_privacy_wanted(var c: Controller) -> Bool
    if c.rq_kind != RQ_NONE or c.rp_valid
        return true
    privacy_wants_local(var c) or c.adv_wait or c.init_wait

// An address the queue held has been tried against the list: `idx` is the entry (-1 for
// none).  The report and the links that waited for it are let go.
@satisfies("REQ-BLE-CTL-037")
@tier(embedded)
fn finish_peer(var c: Controller, var a: Vec[u8; 6], idx: Int)
    if c.rp_valid
        var same = true
        for k in 0..6
            if c.rp_pdu.b[2 + k] != a[k]
                same = false
        if same
            c.rp_valid = false
            if idx >= 0
                ll_link.pdu_copy(var c.view, var c.rp_pdu)
                rewrite_in(var c, var c.view, idx)
                // A scan response is reported as it is; an advertisement passes the
                // duplicate filter first.
                if c.rp_rsp or (ll_scan.scan_note(var c.scan, var c.view) & ll_scan.ACT_REPORT) != 0
                    report_pdu_id(var c, var c.view, c.rp_rssi, 2)
            else
                if c.rp_rsp or (ll_scan.scan_note(var c.scan, var c.rp_pdu) & ll_scan.ACT_REPORT) != 0
                    report_pdu(var c, var c.rp_pdu, c.rp_rssi)
    for ls in 0..noble_controller_config.CTL_LINKS
        release_link(var c, ls, var a, idx)

// The link in slot `ls` waited for the identity of the RPA `a`.
@tier(embedded)
fn release_link(var c: Controller, ls: Int, var a: Vec[u8; 6], idx: Int)
    if not c.links[ls].res_wait
        return
    for k in 0..6
        if c.links[ls].peer_rpa[k] != a[k]
            return
    if idx >= 0
        var id = rl_identity_vec(var c, idx)
        ll_link.link_set_identity(var c.links[ls], c.rl.kind[idx] as Int, var id)
    else
        c.links[ls].res_wait = false

// Make `a` of `kind` (0 public, 1 random) the initiator's address, when it is not already.
@tier(embedded)
fn set_init_address(var c: Controller, var a: Vec[u8; 6], kind: Int)
    var same = (c.init.addr_type as Int) == kind
    for k in 0..6
        if c.init.addr[k] != a[k]
            same = false
    if not same
        ll_init.init_set_addr(var c.init, var a, kind)

// Make the local RPA of entry `ent` the initiator's address.
@tier(embedded)
fn use_init_address(var c: Controller, ent: Int)
    var a = rl_local_vec(var c, ent)
    set_init_address(var c, var a, 1)

// Bring the addresses of the running activities up to date with the RPAs made.
@satisfies("REQ-BLE-CTL-037")
@tier(embedded)
fn sync_privacy(var c: Controller)
    if c.adv.enabled and c.adv_loc and c.adv_ent >= 0 and c.rl.local_ok[c.adv_ent]
        var a = rl_local_vec(var c, c.adv_ent)
        var same = true
        for k in 0..6
            if c.adv.addr[k] != a[k]
                same = false
        if not same or c.adv.addr_type != 1
            ll_adv.adv_set_addr(var c.adv, var a, 1)
    c.adv_wait = c.adv.enabled and (c.adv_loc and c.adv_ent >= 0 and not c.rl.local_ok[c.adv_ent] or c.adv_tgt and not c.adv_tgt_ok)
    scan_default_address(var c)
    if c.init.enabled and c.init_loc and c.init_ent >= 0
        c.init_wait = not c.rl.local_ok[c.init_ent]
        // The InitA is in the request before an advertisement arrives: the radio sends the
        // request T_IFS after it and reads the first octets before the judgement is done.
        if c.rl.local_ok[c.init_ent]
            use_init_address(var c, c.init_ent)
    else
        c.init_wait = false

// Run one unit of the work of privacy that needs the cipher: try the address queued
// against the list, or make an RPA, or renew them when the RPA timeout has run.  True
// when it did something.
pub @satisfies("REQ-BLE-CTL-036")
@satisfies("REQ-BLE-CTL-037")
@tier(embedded)
fn ctl_privacy_poll<C: Cipher[e]>(var c: Controller, var cc: C) -> Bool [e]
    if c.rp_valid and not c.scan.enabled
        c.rp_valid = false
    if c.rp_valid and not c.rl.enable
        c.rq_kind = RQ_NONE
        c.rp_valid = false
    if ll_privacy.rl_count(var c.rl) == 0
        c.adv_wait = false
        c.init_wait = false
        return false
    if c.rl.epoch == 0
        c.rl.epoch = c.now + 1
    if ll_privacy.rl_expired(var c.rl, c.now)
        c.rl.epoch = c.now + 1
        for i in 0..ll_privacy.RL_SIZE
            c.rl.local_ok[i] = false
        c.adv_tgt_ok = false
        for i in 0..ctl_limits.sets()
            c.xsets[i].tgt_ok = false
    if c.rq_kind != RQ_NONE
        var a: Vec[u8; 6] = Vec.new()
        for k in 0..6
            let _p = a.push(c.rq_addr[k])
        let kind = c.rq_kind
        c.rq_kind = RQ_NONE
        if kind == RQ_PEER
            finish_peer(var c, var a, ll_privacy.rl_resolve(var c.rl, var cc, var a))
        else
            let _t = ll_privacy.rl_resolve_target(var c.rl, var cc, var a)
        return true
    if privacy_wants_local(var c)
        for i in 0..ll_privacy.RL_SIZE
            if c.rl.used[i] and ll_privacy.rl_local_has_irk(var c.rl, i) and not c.rl.local_ok[i]
                let ok = ll_privacy.rl_make_local(var c.rl, var cc, i)
                sync_privacy(var c)
                return ok
    if ctl_limits.xadv_on()
        for i in 0..ctl_limits.sets()
            if c.xsets[i].on and c.xsets[i].tgt and not c.xsets[i].tgt_ok and c.xsets[i].ent >= 0
                if ll_privacy.rl_make_peer(var c.rl, var cc, c.xsets[i].ent)
                    c.xsets[i].tgt_ok = true
                    return true
    if c.adv.enabled and c.adv_tgt and not c.adv_tgt_ok and c.adv_ent >= 0
        if ll_privacy.rl_make_peer(var c.rl, var cc, c.adv_ent)
            var t = rl_peer_vec(var c, c.adv_ent)
            ll_adv.adv_set_target(var c.adv, var t, 1)
            c.adv_tgt_ok = true
            sync_privacy(var c)
            return true
    sync_privacy(var c)
    false

// ── The connections ─────────────────────────────────────────────────
//
// The program that owns the radio runs a connection event with these calls, in
// this order: `ctl_conn_begin` (the channel), then for each packet that arrives
// `ll_link.link_note_rx` and `link_rx_fast` or `link_rx_bad` on the link, and
// `ctl_conn_rx_slow` once the answer is on air, and `ctl_conn_done` when the
// event is over.  The calls name the link by its slot; `ctl_class_slot` gives the
// slot of the arbiter class `ctl_ll_pick` granted.  A CONNECT_IND the advertiser
// received goes to `ctl_connect_ind`, and the CONNECT_IND the initiator sent to
// `ctl_init_sent`.

// The slot of the arbiter class that books connection events, -1 for another.
@tier(embedded)
fn ctl_class_slot(cls: Int) -> Int
    if cls >= ll_arb.class_acl() and cls < ll_arb.class_acl() + noble_controller_config.CTL_LINKS
        cls - ll_arb.class_acl()
    else
        -1

// Take the CONNECT_IND in `rx`, which ended at `end_us`, if it passes the
// checks of the Link Layer and the policy and a link is free for the Peripheral
// role: the connection is opened, advertising ends, and the Host is owed LE
// Connection Complete.  False leaves the advertiser as it was.
pub @satisfies("REQ-BLE-CTL-013")
@satisfies("REQ-BLE-CTL-014")
@satisfies("REQ-BLE-CTL-024")
@tier(embedded)
fn ctl_connect_ind<P: LinkPolicy>(var c: Controller, var policy: P, var rx: Pdu,
                                  end_us: Int) -> Bool
    let slot = connect_open(var c, var policy, var rx, end_us)
    if slot >= 0 and c.adv_set >= 0
        // The connection was made on a set of legacy PDUs: the set ends, and the Host is told.
        let i = c.adv_set
        c.xsets[i].on = false
        c.xsets[i].events = c.adv.events - c.adv_base
        c.xsets[i].term = STATUS_SUCCESS
        c.xsets[i].term_conn = slot_handle(slot)
        c.xsets[i].term_owed = true
        c.adv_set = -1
    slot >= 0

// The connection a CONNECT_IND or an AUX_CONNECT_REQ `rx` that ended at `end_us` makes, when the checks and the policy
// allow it: the slot it took, -1 for none.
@satisfies("REQ-BLE-CTL-022")
@tier(embedded)
fn connect_open<P: LinkPolicy>(var c: Controller, var policy: P, var rx: Pdu, end_us: Int) -> Int
    if not peripheral_room(var c)
        return -1
    if c.adv_st == 1
        rewrite_in(var c, var rx, c.ci_pent)
    if not ll_link.connect_valid(var rx)
        return -1
    var req = ll_policy.conn_request_new()
    ll_link.connect_request(var rx, var req)
    if not policy.accept_connection(req)
        return -1
    let slot = free_slot(var c)
    ll_link.link_open(var c.links[slot], slot_handle(slot), var rx, end_us)
    ll_link.link_set_room(var c.links[slot], ctl_pool.pool_free(var c.pool))
    apply_defaults(var c, slot)
    if c.adv_st == 1
        c.ci_kind = 1 | 4
    else if c.adv_st == 2
        c.ci_kind = 1 | 8
    c.ci_ent = -1
    if c.adv_loc and c.adv_ent >= 0 and c.rl.local_ok[c.adv_ent]
        c.ci_kind = c.ci_kind | 2
        c.ci_ent = c.adv_ent
    apply_privacy(var c, slot)
    ll_adv.adv_disable(var c.adv)
    ll_arb.arb_cancel(var c.arb, ll_arb.class_adv())
    c.adv_st = 0
    slot

// The Host's defaults for a connection just opened in slot `ls`: the data length it suggested, if it
// did, and the PHYs it prefers, if it does.
@satisfies("REQ-BLE-CTL-041")
@satisfies("REQ-BLE-CTL-043")
@tier(embedded)
fn apply_defaults(var c: Controller, ls: Int)
    ll_link.link_set_defaults(var c.links[ls],
        c.dl_sugg_set,
        c.dl_sugg_octets,
        c.dl_sugg_time,
        c.phy_def_set,
        c.phy_def_tx & phy_mask(var c),
        c.phy_def_rx & phy_mask(var c))
    ll_link.link_set_no_coded(var c.links[ls], not c.coded)
    if ctl_limits.past_on()
        past_defaults(var c, ls)
    if ctl_limits.sub_on()
        c.sub[ls] = ll_sub.sub_new()
        c.sub[ls].amin = c.sub_def[0].amin
        c.sub[ls].amax = c.sub_def[0].amax
        c.sub[ls].alat = c.sub_def[0].alat
        c.sub[ls].acont = c.sub_def[0].acont
        c.sub[ls].ato = c.sub_def[0].ato
        c.sub[ls].aiv = c.sub_def[0].aiv
        ll_link.link_set_host_sub(var c.links[ls], c.host_sub)
    if ctl_limits.pcl_on()
        ll_pcl.pcl_reset(var c.pcl[ls], TX_POWER_DBM)
        for k in 0..ll_pcl.PHYS
            c.links[ls].txp[k] = TX_POWER_DBM as i8
    if noble_controller_config.CTL_CS > 0
        cs_release(var c, ls)

// Record the Resolvable Private Addresses of the connection just opened in slot `ls`, which
// the Host is told of in LE Enhanced Connection Complete: `c.ci_kind` has bit 0 when the
// peer used an RPA (`c.ci_rpa`), bit 1 when this end did (the local RPA of entry
// `c.ci_ent`), bit 2 when the peer's RPA resolved to the identity address now in the
// link, and bit 3 when the program is yet to try it against the list.
@satisfies("REQ-BLE-CTL-037")
@tier(embedded)
fn apply_privacy(var c: Controller, ls: Int)
    if c.ci_kind == 0
        return
    var peer = c.ci_rpa
    var local: Vec[u8; 6] = Vec.new()
    for k in 0..6
        let _z = local.push(0)
    if (c.ci_kind & 2) != 0
        local = rl_local_vec(var c, c.ci_ent)
    var ident: Vec[u8; 6] = Vec.new()
    for k in 0..6
        let _i = ident.push(c.links[ls].peer[k])
    var idk = -1
    if (c.ci_kind & 4) != 0
        idk = c.links[ls].peer_type
    ll_link.link_set_privacy(var c.links[ls],
        var peer,
        (c.ci_kind & 1) != 0,
        var local,
        (c.ci_kind & 2) != 0,
        idk,
        var ident,
        (c.ci_kind & 8) != 0)
    c.ci_kind = 0
@tier(embedded)
fn slot_handle(slot: Int) -> Int
    slot + 1

// Whether a connection event of the link in `slot` is to be run: the link is on
// and not ending.
@tier(embedded)
fn ctl_conn_active(var c: Controller, slot: Int) -> Bool
    ll_link.link_live(var c.links[slot]) and not c.links[slot].closing

// A connection that ended is taken off: the Host is owed Disconnection Complete
// (or the LE Connection Complete of a Central that never made it) and the
// booking goes.
@tier(embedded)
fn release_ended(var c: Controller, slot: Int)
    if ll_link.link_ended(var c.links[slot])
        if ctl_limits.iso_on() and iso_on(var c)
            cis_acl_lost(var c, slot, c.links[slot].reason)
        ll_link.link_released(var c.links[slot])
        if noble_controller_config.CTL_CS > 0
            cs_release(var c, slot)
        if ctl_limits.past_on()
            c.past_tx[slot].used = false
        ll_arb.arb_cancel(var c.arb, slot_class(slot))

// The program woke too late for the events of the link in `slot` whose windows
// have closed at `now`: each is skipped with its channel taken, and the answer is
// how many.  A connection those events lost is taken off.
@satisfies("REQ-BLE-CTL-017")
@tier(embedded)
fn ctl_conn_catch_up(var c: Controller, slot: Int, now: Int) -> Int
    let n = ll_link.link_catch_up(var c.links[slot], now)
    release_ended(var c, slot)
    n

// A connection event of the link in `slot` begins: the room for the packets it
// brings is read from the pool, whether the Host has the event for a request of
// the peer enabled is noted, and the answer is the channel.
@tier(embedded)
fn ctl_conn_begin(var c: Controller, slot: Int) -> Int
    let ind = le_event_enabled(var c, SUB_LE_REMOTE_CONNECTION_PARAMETER_REQUEST)
    ll_link.link_set_room(var c.links[slot], ctl_pool.pool_free(var c.pool))
    ll_link.link_set_indicate(var c.links[slot], ind)
    ll_link.link_event_begin(var c.links[slot])

// Send data the peer sent to the Host as an HCI ACL Data packet: the first
// fragment of an L2CAP message (LLID 2) starts it, a continuation continues it.
// The room check before the packet kept a slot for it; with none the packet is
// dropped and counted.
@satisfies("REQ-BLE-CTL-015")
@tier(embedded)
fn forward_acl(var c: Controller, handle: Int, var rx: Pdu)
    var pb = 1
    if ll_data.dpdu_llid(var rx) == ll_data.LLID_START
        pb = 2
    let slot = ctl_pool.acl_begin(var c.pool, handle, pb)
    if slot == ctl_pool.NO_SLOT
        c.dropped_acl = c.dropped_acl + 1
        return
    for i in 0..ll_data.dpdu_len(var rx)
        let _a = ctl_pool.pool_put(var c.pool, slot, ll_data.dpdu_byte(var rx, i))
    let _b = ctl_pool.acl_send(var c.pool, slot)

// Open the packet of the link in `slot` that `link_rx_fast` took, when the link
// receives encrypted (`ll_link.link_rx_open`): a PDU whose MIC does not match ends
// the connection with MIC Failure.
@satisfies("REQ-BLE-CTL-033")
@satisfies("REQ-BLE-CTL-034")
@tier(embedded)
fn ctl_conn_rx_open<C: Cipher[e]>(var c: Controller, slot: Int, var cc: C, var rx: Pdu) [e]
    ll_link.link_rx_open(var c.links[slot], var cc, var rx)

// The PDU the radio sends for the link in `slot`: the one in flight when `next` is
// false, the one behind it when true, sealed when the link sends encrypted.
@satisfies("REQ-BLE-CTL-030")
@satisfies("REQ-BLE-CTL-034")
@tier(embedded)
fn ctl_conn_air<C: Cipher[e]>(var c: Controller, slot: Int, var cc: C, next: Bool, var p: Pdu) [e]
    if next
        ll_link.link_air_nxt(var c.links[slot], var cc, var p)
    else
        ll_link.link_air_cur(var c.links[slot], var cc, var p)

// The program wrote the PDUs of the link in `slot` into radio memory.
@tier(embedded)
fn ctl_conn_mirrored(var c: Controller, slot: Int)
    c.links[slot].dirty = false

// The cipher failed on the link in `slot`: the connection ends with Hardware
// Failure.
@satisfies("REQ-BLE-CTL-034")
@tier(embedded)
fn ctl_conn_fail(var c: Controller, slot: Int)
    ll_link.link_close(var c.links[slot], ll_link.REASON_HARDWARE_FAILURE)

// Whether a link waits for random octets (`rnd` to `ctl_secure_poll`) or for the
// cipher.
pub @tier(embedded)
fn ctl_secure_wanted(var c: Controller) -> Bool
    for slot in 0..noble_controller_config.CTL_LINKS
        if ll_link.link_wants_random(var c.links[slot]) or ll_link.link_wants_cipher(var c.links[slot])
            return true
    if noble_controller_config.CTL_CS > 0
        return cs_wants_random(var c)
    false

// Whether a link waits for random octets.
pub @tier(embedded)
fn ctl_wants_random(var c: Controller) -> Bool
    for slot in 0..noble_controller_config.CTL_LINKS
        if ll_link.link_wants_random(var c.links[slot])
            return true
    if noble_controller_config.CTL_CS > 0
        return cs_wants_random(var c)
    false

// Run the work of the Encryption Start procedure that needs the cipher or random
// octets, on both links; the random octets serve one link.
pub @satisfies("REQ-BLE-CTL-031")
@tier(embedded)
fn ctl_secure_poll<C: Cipher[e]>(var c: Controller, var cc: C, var rnd: Vec[u8; 12],
                                 have: Bool) -> Bool [e]
    var used = false
    for slot in 0..noble_controller_config.CTL_LINKS
        if ll_link.link_secure_poll(var c.links[slot], var cc, var rnd, have and not used)
            used = true
    if noble_controller_config.CTL_CS > 0
        if have and not used
            used = cs_feed(var c, rnd)
    used

// The rest of the work for a packet with a good CRC of the link in `slot`
// (`ll_link.link_rx_slow`), and the data it carried for the Host.
@satisfies("REQ-BLE-CTL-015")
@tier(embedded)
fn ctl_conn_rx_slow(var c: Controller, slot: Int, var rx: Pdu)
    // The events the link owes come before the data that follows them: Encryption Change
    // before the first encrypted PDU, which the Host cannot read until it has heard it.
    if ll_link.link_rx_slow(var c.links[slot], var rx) == ll_link.RX_TO_HOST
        let _e = flush_link(var c, slot)
        forward_acl(var c, c.links[slot].handle, var rx)
    if (ctl_limits.iso_on() or ctl_limits.past_on() or ctl_limits.pcl_on() or ctl_limits.sub_on() or ctl_limits.fs_on() or ctl_limits.cs_on()) and c.links[slot].ctl_in
        ctl_iso_ctrl(var c, slot, var rx)
    ll_link.link_set_room(var c.links[slot], ctl_pool.pool_free(var c.pool))

// The connection event of the link in `slot` ended at `end`.  A connection that
// ended in it is taken off, and the Host is owed the Disconnection Complete
// event.
@satisfies("REQ-BLE-CTL-018")
@tier(embedded)
fn ctl_conn_done(var c: Controller, slot: Int, end: Int)
    ll_link.link_event_done(var c.links[slot], end)
    release_ended(var c, slot)

// ── The Initiating state ────────────────────────────────────────────
//
// The program runs the Initiating state as it runs scanning: it listens in the
// windows `ll_init` gives, hands each advertising PDU to `ctl_init_decide`, and,
// when that says a CONNECT_IND is to go out, sends the one in `c.init.req`
// T_IFS after the PDU and reports the time it ended with `ctl_init_sent`.

// Whether the Controller is in the Initiating state.
@tier(embedded)
fn ctl_init_active(var c: Controller) -> Bool
    c.init.enabled

// Whether the Filter Accept List holds the identity address of entry `ent`.
@tier(embedded)
fn fal_has_entry(var c: Controller, ent: Int) -> Bool
    let kind = c.rl.kind[ent] as Int
    for i in 0..FILTER_ACCEPT_LIST_SIZE
        if c.fal_used[i] and (c.fal_type[i] as Int) == kind
            var same = true
            for k in 0..6
                if c.fal_addr[i * 6 + k] != c.rl.addr[ent * 6 + k]
                    same = false
                    break
            if same
                return true
    false

// Judge an advertising PDU received with a good CRC.  True when the CONNECT_IND in
// `c.init.req` is to go out.  Without privacy this is `ll_init.init_decide`, with the
// Filter Accept List read only when the filter policy uses it.
//
// With address resolution on, the judgement runs inside T_IFS and reads the PDU in place:
// the advertiser is the entry whose RPA is the sender (an RPA seen before; a new one is
// queued for the program, `ask_to_resolve`), or whose identity address it is.  The
// device is the one the Host named (Filter Accept Policy 0) or a listed one, and a
// directed advertisement must name this initiator, by its address or by an RPA made with
// the local IRK.  The InitA is the RPA of the entry's local IRK when the Own_Address_Type
// asks for it.
pub @satisfies("REQ-BLE-CTL-021")
@satisfies("REQ-BLE-CTL-036")
@tier(embedded)
fn ctl_init_decide(var c: Controller, var rx: Pdu, got: Int) -> Bool
    c.ci_kind = 0
    c.ci_ent = -1
    if not c.rl.enable or ll_privacy.rl_count(var c.rl) == 0
        return init_plain(var c, var rx, got)
    let hdr = rx.b[0] as Int
    let ty = hdr & 0x0F
    if ty != ll_pdu.ADV_IND and ty != ll_pdu.ADV_DIRECT_IND or not ll_pdu.pdu_well_formed(var rx, got)
        return false
    let kind = (hdr >>> 6) & 1
    var ent = -1
    var rpa = false
    if kind == 1 and (rx.b[7] as Int & 0xC0) == 0x40
        rpa = true
        ent = ll_privacy.rl_cached_at(var c.rl, var rx.b, 2)
        if ent < 0
            let _q = ask_to_resolve(var c, var rx, 2, RQ_PEER)
            return false
    else
        ent = ll_privacy.rl_find_at(var c.rl, kind, var rx.b, 2)
        if ent < 0
            return init_plain(var c, var rx, got)
        if ll_privacy.rl_peer_has_irk(var c.rl, ent) and (c.rl.mode[ent] as Int) == ll_privacy.MODE_NETWORK
            return false
    // The device the initiator is to connect to.
    if (c.init.policy as Int) == ll_init.POLICY_LIST
        if not fal_has_entry(var c, ent)
            return false
    else if ent != c.init_ent
        return false
    if ty == ll_pdu.ADV_DIRECT_IND and not directed_to_us(var c, var rx, ent)
        return false
    // The InitA.
    var local = false
    if c.init_own >= 2 and ll_privacy.rl_local_has_irk(var c.rl, ent)
        if not c.rl.local_ok[ent]
            return false
        use_init_address(var c, ent)
        local = true
    else if (c.init_own & 1) == 0
        set_init_address(var c, var c.public, 0)
    else
        set_init_address(var c, var c.random, 1)
    if ll_init.init_accept(var c.init, var rx) != ll_init.ACT_CONNECT
        return false
    c.ci_ent = ent
    if rpa
        for k in 0..6
            c.ci_rpa[k] = rx.b[2 + k]
        c.ci_kind = 1 | 4
    if local
        c.ci_kind = c.ci_kind | 2
    true

// Without privacy for the advertiser: the plain judgement of the initiator.
@tier(embedded)
fn init_plain(var c: Controller, var rx: Pdu, got: Int) -> Bool
    var listed = false
    if (c.init.policy as Int) == ll_init.POLICY_LIST
        listed = fal_has_sender(var c, var rx)
    if c.init_own >= 2
        if (c.init_own & 1) == 0
            set_init_address(var c, var c.public, 0)
        else
            set_init_address(var c, var c.random, 1)
    ll_init.init_decide(var c.init, var rx, got, listed) == ll_init.ACT_CONNECT

// Whether the directed advertisement `rx` names this initiator: its own address, or an
// RPA that the local IRK of entry `ent` made (an RPA not seen before is queued).
@tier(embedded)
fn directed_to_us(var c: Controller, var rx: Pdu, ent: Int) -> Bool
    if ll_pdu.pdu_rx_add(var rx) == 1 and (rx.b[13] as Int & 0xC0) == 0x40
        let idx = ll_privacy.rl_seen_at(var c.rl, var rx.b, 8)
        if idx < 0
            let _q = ask_to_resolve(var c, var rx, 8, RQ_TARGET)
        return idx == ent
    ll_pdu.pdu_addr_is(var rx, 6, var c.init.addr) and ll_pdu.pdu_rx_add(var rx) == (c.init.addr_type as Int)

// Queue the six octets of `rx` from `off` for the program to resolve, unless they were
// tried and matched nothing (false then).
@tier(embedded)
fn ask_to_resolve(var c: Controller, var rx: Pdu, off: Int, kind: Int) -> Bool
    var a: Vec[u8; 6] = Vec.new()
    for k in 0..6
        let _p = a.push(rx.b[off + k])
    if ll_privacy.rl_is_negative(var c.rl, var a)
        return false
    queue_resolve(var c, var a, kind)
    true

// The CONNECT_IND that `ctl_init_decide` accepted did not go on air: the state
// goes on listening.
pub @tier(embedded)
fn ctl_init_unsent(var c: Controller)
    ll_init.init_unsent(var c.init)

// The state is one of LE Extended Create Connection: the advertising PDU `rx` (`n` octets in all,
// the first `ll_init.EXT_READ_OCTETS` of them read) is followed when it is a connectable ADV_EXT_IND whose
// Auxiliary Pointer names a channel and a PHY the command allows, and the AUX_ADV_IND is awaited
// there.  The answer is the octet of the pointer in `rx`, -1 to go on listening on the primary
// channel.
@satisfies("REQ-BLE-CTL-080")
@tier(embedded)
fn ctl_init_aux_plan(var c: Controller, var rx: Pdu, n: Int) -> Int
    ll_init.aux_plan(var c.init, var rx, n)

// Whether the radio may be taken from now to `until` for the exchange with an AUX_ADV_IND: no
// higher-priority booking falls inside it (a connection event, an isochronous event or an
// advertising event).
@satisfies("REQ-BLE-CTL-080")
@tier(embedded)
fn ctl_init_aux_room(var c: Controller, until: Int) -> Bool
    ll_arb.arb_clear(var c.arb, ll_arb.class_scan(), c.now, until)

// Judge the AUX_ADV_IND `rx` (`n` octets in all) that came on a secondary channel on `phy`: the
// advertiser is judged as a legacy one is (`ctl_init_decide`) from its legacy shape, and the
// connection parameters of `phy` are put into the AUX_CONNECT_REQ in `c.init.req`.  True when that
// request is to go out.
pub @satisfies("REQ-BLE-CTL-080")
@tier(embedded)
fn ctl_init_aux_decide(var c: Controller, var rx: Pdu, n: Int, phy: Int) -> Bool
    if not c.init.enabled or not c.init.ext or not ll_init.ext_view(var rx, n, var c.view)
        return false
    if not ctl_init_decide(var c, var c.view, c.view.n)
        return false
    ll_init.init_use_phy(var c.init, phy)
    c.init.aux_phy = phy
    true

// Whether `rx` (`n` octets in all) is the AUX_CONNECT_RSP of the advertiser that the
// AUX_CONNECT_REQ went to.
@satisfies("REQ-BLE-CTL-080")
@tier(embedded)
fn ctl_init_aux_rsp(var c: Controller, var rx: Pdu, n: Int) -> Bool
    ll_init.is_connect_rsp(var c.init, var rx, n)

// The AUX_CONNECT_RSP did not come: the request did not make a connection, and the state goes on
// listening.
pub @satisfies("REQ-BLE-CTL-080")
@tier(embedded)
fn ctl_init_aux_lost(var c: Controller)
    c.init.aux_rsp_missed = c.init.aux_rsp_missed + 1
    ll_init.init_unsent(var c.init)

// The time the program last waited for an AUX_ADV_IND that did not come, and the answer that did not
// come, are counted.
@satisfies("REQ-BLE-CTL-080")
@tier(embedded)
fn ctl_init_aux_missed(var c: Controller)
    c.init.aux_missed = c.init.aux_missed + 1

// The ADV_EXT_IND was not followed for want of room.
@satisfies("REQ-BLE-CTL-080")
@tier(embedded)
fn ctl_init_aux_skipped(var c: Controller)
    c.init.aux_skipped = c.init.aux_skipped + 1

// The CONNECT_IND went on air and ended at `end_us`: the Initiating state ends
// and the connection as Central opens in a free link, whose first event is due
// at the start of the transmit window.  With no link free (which the reservation
// of `peripheral_room` prevents) the state ends and the Host is told the
// connection could not be made.  True when the link opened.
pub @satisfies("REQ-BLE-CTL-022")
@tier(embedded)
fn ctl_init_sent(var c: Controller, end_us: Int) -> Bool
    let slot = free_slot(var c)
    ll_init.init_disable(var c.init)
    ll_arb.arb_cancel(var c.arb, ll_arb.class_scan())
    if slot < 0
        c.init_event = STATUS_CONNECTION_LIMIT
        return false
    ll_link.link_open_central(var c.links[slot], slot_handle(slot), var c.init.req, end_us)
    if c.init.aux_phy != 0
        ll_link.link_aux_start(var c.links[slot], c.init.aux_phy)
        c.init.aux_connects = c.init.aux_connects + 1
    ll_link.link_host_range(var c.links[slot], c.init.c_min, c.init.c_max, c.init.latency, c.init.timeout)
    ll_link.link_set_room(var c.links[slot], ctl_pool.pool_free(var c.pool))
    apply_defaults(var c, slot)
    // The CONNECT_IND went to the advertiser's RPA; the Host knows the device by its
    // identity address.
    if (c.ci_kind & 4) != 0 and c.ci_ent >= 0
        var id = rl_identity_vec(var c, c.ci_ent)
        ll_link.link_set_identity(var c.links[slot], c.rl.kind[c.ci_ent] as Int, var id)
    apply_privacy(var c, slot)
    true

// ── The events the connections owe the Host ─────────────────────────

// Start an LE Meta event with the subevent `sub`.  `NO_SLOT` when the pool is
// exhausted.
@tier(embedded)
fn meta_begin(var c: Controller, sub: Int) -> Int
    let slot = ctl_pool.evt_begin(var c.pool, hci_frame.EVT_LE_META_EVENT)
    if slot != ctl_pool.NO_SLOT
        let _a = ctl_pool.pool_put(var c.pool, slot, sub)
    slot

// Finish the event in `slot`.
@tier(embedded)
fn event_send(var c: Controller, slot: Int)
    let _a = ctl_pool.evt_send(var c.pool, slot)

// The accessors the event functions below use.  Each names the link once, so that the
// compiled code checks the slot once there and not at every field the event reads.

// Whether the link in slot `ls` owes the Host the event `ev`.
@tier(embedded)
fn lk_owes(var c: Controller, ls: Int, ev: Int) -> Bool
    ll_link.link_owes(var c.links[ls], ev)

// Whether the link in slot `ls` owes no event, or waits for an identity.
@tier(embedded)
fn lk_idle(var c: Controller, ls: Int) -> Bool
    if ctl_limits.sca_on() and ll_link.fx_get(c.links[ls], ll_link.FX_SCA, 1) == 1 and not c.links[ls].res_wait
        return false
    c.links[ls].owed == 0 or c.links[ls].res_wait

// The Host has been told of the event `ev` of the link in slot `ls`.
@tier(embedded)
fn lk_sent(var c: Controller, ls: Int, ev: Int)
    ll_link.link_sent(var c.links[ls], ev)

// What the radio program reads of the link in `slot` between two packets.
@tier(embedded)
fn lk_phy(var c: Controller, slot: Int) -> Int
    c.links[slot].phy

@tier(embedded)
fn lk_use_nxt(var c: Controller, slot: Int) -> Bool
    c.links[slot].use_nxt

@tier(embedded)
fn lk_cont(var c: Controller, slot: Int) -> Bool
    c.links[slot].cont

@tier(embedded)
fn lk_dirty(var c: Controller, slot: Int) -> Bool
    c.links[slot].dirty

@tier(embedded)
fn lk_closing(var c: Controller, slot: Int) -> Bool
    c.links[slot].closing

@tier(embedded)
fn lk_due(var c: Controller, slot: Int) -> Int
    c.links[slot].due

@tier(embedded)
fn lk_central(var c: Controller, slot: Int) -> Bool
    c.links[slot].central

@tier(embedded)
fn lk_enc_rx(var c: Controller, slot: Int) -> Bool
    c.links[slot].enc_rx

@tier(embedded)
fn lk_rx_fast(var c: Controller, slot: Int, b: Int) -> Int
    ll_link.link_rx_fast(var c.links[slot], b)

@tier(embedded)
fn lk_note_rx(var c: Controller, slot: Int, start: Int, good: Bool)
    ll_link.link_note_rx(var c.links[slot], start, good)

@tier(embedded)
fn lk_answers_bad(var c: Controller, slot: Int) -> Bool
    ll_link.link_answers_bad(var c.links[slot])

@tier(embedded)
fn lk_rx_bad(var c: Controller, slot: Int) -> Int
    ll_link.link_rx_bad(var c.links[slot])

@tier(embedded)
fn lk_listen_start(var c: Controller, slot: Int) -> Int
    ll_link.link_listen_start(var c.links[slot])

@tier(embedded)
fn lk_listen_end(var c: Controller, slot: Int) -> Int
    ll_link.link_listen_end(var c.links[slot])

@tier(embedded)
fn lk_first_header(var c: Controller, slot: Int) -> Int
    ll_link.link_first_header(var c.links[slot])

// The status of the last connection update and of the last PHY update of the link in
// slot `ls` is Success again.
@tier(embedded)
fn lk_clear_upd(var c: Controller, ls: Int)
    c.links[ls].upd_status = STATUS_SUCCESS

@tier(embedded)
fn lk_clear_phy(var c: Controller, ls: Int)
    c.links[ls].phy_status = STATUS_SUCCESS

// The octets of the event `ev_connected` sends, from the link `l`.
@tier(embedded)
fn put_connected(var pool: PacketPool, slot: Int, var l: Link, enhanced: Bool)
    var role = 1
    if l.central
        role = 0
    let _a = ctl_pool.pool_put(var pool, slot, l.conn_status)
    let _b = ctl_pool.pool_put_u16(var pool, slot, l.handle)
    let _c = ctl_pool.pool_put(var pool, slot, role)
    // An identity address found by resolving the peer's RPA has the type 2 + its kind in
    // the enhanced event ([Vol 4] Part E, Section 7.7.65.10).
    var ptype = l.peer_type
    if enhanced and l.id_kind >= 0
        ptype = 2 + l.id_kind
    let _d = ctl_pool.pool_put(var pool, slot, ptype)
    for i in 0..6
        let _e = ctl_pool.pool_put(var pool, slot, l.peer[i] as Int)
    if enhanced
        for i in 0..6
            var v = 0
            if l.rpa_local
                v = l.local_rpa[i] as Int
            let _l = ctl_pool.pool_put(var pool, slot, v)
        for i in 0..6
            var v = 0
            if l.rpa_peer and l.id_kind >= 0
                v = l.peer_rpa[i] as Int
            let _p = ctl_pool.pool_put(var pool, slot, v)
    let _f = ctl_pool.pool_put_u16(var pool, slot, l.interval)
    let _g = ctl_pool.pool_put_u16(var pool, slot, l.latency)
    let _h = ctl_pool.pool_put_u16(var pool, slot, l.timeout)
    let _i = ctl_pool.pool_put(var pool, slot, l.sca)

// The octets of the event `ev_disconnected` sends, from the link `l`.
@tier(embedded)
fn put_disconnected(var pool: PacketPool, slot: Int, var l: Link)
    let _a = ctl_pool.pool_put(var pool, slot, STATUS_SUCCESS)
    let _b = ctl_pool.pool_put_u16(var pool, slot, l.handle)
    let _c = ctl_pool.pool_put(var pool, slot, l.reason)

// The octets of the event `ev_completed` sends, from the link `l`.
@tier(embedded)
fn put_completed(var pool: PacketPool, slot: Int, var l: Link)
    let _a = ctl_pool.pool_put(var pool, slot, 1)
    let _b = ctl_pool.pool_put_u16(var pool, slot, l.handle)
    let _c = ctl_pool.pool_put_u16(var pool, slot, ll_link.link_take_completed(var l))

// The octets of the event `ev_updated` sends, from the link `l`.
@tier(embedded)
fn put_updated(var pool: PacketPool, slot: Int, var l: Link)
    let _a = ctl_pool.pool_put(var pool, slot, l.upd_status)
    let _b = ctl_pool.pool_put_u16(var pool, slot, l.handle)
    let _c = ctl_pool.pool_put_u16(var pool, slot, l.interval)
    let _d = ctl_pool.pool_put_u16(var pool, slot, l.latency)
    let _e = ctl_pool.pool_put_u16(var pool, slot, l.timeout)

// The octets of the event `ev_data_length` sends, from the link `l`.
@tier(embedded)
fn put_data_length(var pool: PacketPool, slot: Int, var l: Link)
    let _a = ctl_pool.pool_put_u16(var pool, slot, l.handle)
    let _b = ctl_pool.pool_put_u16(var pool, slot, l.dl_ev_tx_octets)
    let _c = ctl_pool.pool_put_u16(var pool, slot, l.dl_ev_tx_time)
    let _d = ctl_pool.pool_put_u16(var pool, slot, l.dl_ev_rx_octets)
    let _e = ctl_pool.pool_put_u16(var pool, slot, l.dl_ev_rx_time)

// The octets of the event `ev_phy` sends, from the link `l`.
@tier(embedded)
fn put_phy(var pool: PacketPool, slot: Int, var l: Link)
    let _a = ctl_pool.pool_put(var pool, slot, l.phy_status)
    let _b = ctl_pool.pool_put_u16(var pool, slot, l.handle)
    let _c = ctl_pool.pool_put(var pool, slot, l.phy)
    let _d = ctl_pool.pool_put(var pool, slot, l.phy)

// The octets of the event `ev_param_request` sends, from the link `l`.
@tier(embedded)
fn put_param_request(var pool: PacketPool, slot: Int, var l: Link)
    let _a = ctl_pool.pool_put_u16(var pool, slot, l.handle)
    let _b = ctl_pool.pool_put_u16(var pool, slot, l.rq_min)
    let _c = ctl_pool.pool_put_u16(var pool, slot, l.rq_max)
    let _d = ctl_pool.pool_put_u16(var pool, slot, l.rq_latency)
    let _e = ctl_pool.pool_put_u16(var pool, slot, l.rq_timeout)

// The octets of the event `ev_apto` sends, from the link `l`.
@tier(embedded)
fn put_apto(var pool: PacketPool, slot: Int, var l: Link)
    let _a = ctl_pool.pool_put_u16(var pool, slot, l.handle)

// The octets of the event `ev_version` sends, from the link `l`.
@tier(embedded)
fn put_version(var pool: PacketPool, slot: Int, var l: Link)
    let _a = ctl_pool.pool_put(var pool, slot, l.ver_status)
    let _b = ctl_pool.pool_put_u16(var pool, slot, l.handle)
    let _c = ctl_pool.pool_put(var pool, slot, l.peer_ver)
    let _d = ctl_pool.pool_put_u16(var pool, slot, l.peer_company)
    let _e = ctl_pool.pool_put_u16(var pool, slot, l.peer_sub)

// The octets of the event `ev_features` sends, from the link `l`.
@tier(embedded)
fn put_features(var pool: PacketPool, slot: Int, var l: Link)
    let _a = ctl_pool.pool_put(var pool, slot, l.feat_status)
    let _b = ctl_pool.pool_put_u16(var pool, slot, l.handle)
    for i in 0..8
        var v = 0
        if l.feat_status == STATUS_SUCCESS
            v = l.peer_feat[i] as Int
        let _c = ctl_pool.pool_put(var pool, slot, v)

// LE Read All Remote Features Complete ([Vol 4] Part E, Section 7.7.65.38): the highest page the peer has with a bit set, the highest page
// this Controller obtained (page 1 or 0) and the 248 octets of the feature set, the pages not obtained zero.  A failed read has zeros.
@satisfies("REQ-BLE-CTL-117")
@tier(embedded)
fn ev_featext(var c: Controller, ls: Int) -> Bool
    if not le_event_enabled(var c, SUB_LE_READ_ALL_REMOTE_FEATURES_COMPLETE)
        lk_sent(var c, ls, ll_link.EV_FEATEXT)
        return true
    let slot = meta_begin(var c, SUB_LE_READ_ALL_REMOTE_FEATURES_COMPLETE)
    if slot == ctl_pool.NO_SLOT
        return false
    let st = ll_link.fx_get(c.links[ls], ll_link.FX_STATUS, 0x7F)
    let ok = st == STATUS_SUCCESS
    var remote = 0
    var valid = 0
    if ok and ll_link.fx_get(c.links[ls], ll_link.FX_HAVE, 1) == 1
        valid = 1
        if (c.links[ls].peer_feat[7] as Int & ll_feat.OCTET7_EXT) != 0
            remote = ll_link.fx_get(c.links[ls], ll_link.FX_MAX, 0xF)
            if remote > ll_feat.PAGE_MAX
                remote = ll_feat.PAGE_MAX
    let _a = ctl_pool.pool_put(var c.pool, slot, st)
    let _b = ctl_pool.pool_put_u16(var c.pool, slot, c.links[ls].handle)
    let _c = ctl_pool.pool_put(var c.pool, slot, remote)
    let _d = ctl_pool.pool_put(var c.pool, slot, valid)
    for i in 0..8
        var v = 0
        if ok
            v = c.links[ls].peer_feat[i] as Int
        let _e = ctl_pool.pool_put(var c.pool, slot, v)
    for i in 0..8
        var v = 0
        if ok and ll_link.fx_get(c.links[ls], ll_link.FX_HAVE, 1) == 1
            v = (ll_link.fx_get(c.links[ls], ll_link.FX_PEER, 0xFFFFFF) >>> (8 * i)) & 0xFF
        let _f = ctl_pool.pool_put(var c.pool, slot, v)
    for _ in 0..ll_feat.PAGE_MAX * ll_feat.PAGE_OCTETS - 8
        let _g = ctl_pool.pool_put(var c.pool, slot, 0)
    event_send(var c, slot)
    lk_sent(var c, ls, ll_link.EV_FEATEXT)
    true

// The octets of the event `ev_ltk_request` sends, from the link `l`.
@tier(embedded)
fn put_ltk_request(var pool: PacketPool, slot: Int, var l: Link)
    let _a = ctl_pool.pool_put_u16(var pool, slot, l.handle)
    for i in 0..8
        let _b = ctl_pool.pool_put(var pool, slot, l.enc_rand[i] as Int)
    let _c = ctl_pool.pool_put_u16(var pool, slot, l.enc_ediv)

// The octets of the event `ev_enc_change` sends, from the link `l`.
@tier(embedded)
fn put_enc_change(var pool: PacketPool, slot: Int, var l: Link)
    let _a = ctl_pool.pool_put(var pool, slot, l.enc_status)
    let _b = ctl_pool.pool_put_u16(var pool, slot, l.handle)
    var on = 0
    if l.enc_status == STATUS_SUCCESS
        on = 1
    let _c = ctl_pool.pool_put(var pool, slot, on)

// The octets of the event `ev_key_refresh` sends, from the link `l`.
@tier(embedded)
fn put_key_refresh(var pool: PacketPool, slot: Int, var l: Link)
    let _a = ctl_pool.pool_put(var pool, slot, l.enc_status)
    let _b = ctl_pool.pool_put_u16(var pool, slot, l.handle)

// LE Connection Complete, or LE Enhanced Connection Complete when the Host
// enabled that one instead ([Vol 4] Part E, Section 7.7.65.1 and 7.7.65.10), for
// the link in slot `ls`: the role is 0 for the Central and 1 for the Peripheral, and the
// status is Success unless the Central's connection failed to establish.  True
// when the event was sent or masked; false when no slot was free.
@satisfies("REQ-BLE-CTL-014")
@satisfies("REQ-BLE-CTL-022")
@tier(embedded)
fn ev_connected(var c: Controller, ls: Int) -> Bool
    let enhanced = le_event_enabled(var c, SUB_LE_ENHANCED_CONNECTION_COMPLETE)
    if not enhanced and not le_event_enabled(var c, SUB_LE_CONNECTION_COMPLETE)
        lk_sent(var c, ls, ll_link.EV_CONNECTED)
        return true
    var sub = SUB_LE_CONNECTION_COMPLETE
    if enhanced
        sub = SUB_LE_ENHANCED_CONNECTION_COMPLETE
    let slot = meta_begin(var c, sub)
    if slot == ctl_pool.NO_SLOT
        return false
    put_connected(var c.pool, slot, var c.links[ls], enhanced)
    event_send(var c, slot)
    lk_sent(var c, ls, ll_link.EV_CONNECTED)
    if c.links[ls].conn_status == STATUS_SUCCESS
        c.links[ls].owed = c.links[ls].owed | ll_link.EV_CHSEL
    true

// LE Channel Selection Algorithm ([Vol 4] Part E, Section 7.7.65.20): which algorithm the
// connection uses, 0 for #1 and 1 for #2, sent after the connection complete event when
// the Host unmasked it.
@satisfies("REQ-BLE-CTL-065")
@tier(embedded)
fn ev_chsel(var c: Controller, ls: Int) -> Bool
    if not le_event_enabled(var c, SUB_LE_CHANNEL_SELECTION_ALGORITHM)
        lk_sent(var c, ls, ll_link.EV_CHSEL)
        return true
    let slot = meta_begin(var c, SUB_LE_CHANNEL_SELECTION_ALGORITHM)
    if slot == ctl_pool.NO_SLOT
        return false
    let _a = ctl_pool.pool_put_u16(var c.pool, slot, c.links[ls].handle)
    var algorithm = 0
    if c.links[ls].csa2
        algorithm = 1
    let _b = ctl_pool.pool_put(var c.pool, slot, algorithm)
    event_send(var c, slot)
    lk_sent(var c, ls, ll_link.EV_CHSEL)
    true

// The LE Connection Complete event of an Initiating state that ended without a
// connection: `c.init_event` is the status, Unknown Connection Identifier after
// LE Create Connection Cancel, and every field after it is zero.  True when the
// event was sent or masked; false when no slot was free.
@satisfies("REQ-BLE-CTL-023")
@tier(embedded)
fn ev_init_ended(var c: Controller) -> Bool
    let enhanced = le_event_enabled(var c, SUB_LE_ENHANCED_CONNECTION_COMPLETE)
    if not enhanced and not le_event_enabled(var c, SUB_LE_CONNECTION_COMPLETE)
        c.init_event = 0
        return true
    var sub = SUB_LE_CONNECTION_COMPLETE
    var zeros = 17
    if enhanced
        sub = SUB_LE_ENHANCED_CONNECTION_COMPLETE
        zeros = 29
    let slot = meta_begin(var c, sub)
    if slot == ctl_pool.NO_SLOT
        return false
    let _a = ctl_pool.pool_put(var c.pool, slot, c.init_event)
    put_zeros(var c, slot, zeros)
    event_send(var c, slot)
    c.init_event = 0
    true

// Disconnection Complete ([Vol 4] Part E, Section 7.7.5): the reason the
// connection ended.
@satisfies("REQ-BLE-CTL-018")
@tier(embedded)
fn ev_disconnected(var c: Controller, ls: Int) -> Bool
    if not event_enabled(var c, hci_frame.EVT_DISCONNECTION_COMPLETE)
        lk_sent(var c, ls, ll_link.EV_DISCONNECTED)
        return true
    let slot = ctl_pool.evt_begin(var c.pool, hci_frame.EVT_DISCONNECTION_COMPLETE)
    if slot == ctl_pool.NO_SLOT
        return false
    put_disconnected(var c.pool, slot, var c.links[ls])
    event_send(var c, slot)
    lk_sent(var c, ls, ll_link.EV_DISCONNECTED)
    true

// Number Of Completed Packets ([Vol 4] Part E, Section 7.7.19): the Host's
// buffers the peer has acknowledged.  The event cannot be masked.
@satisfies("REQ-BLE-CTL-015")
@tier(embedded)
fn ev_completed(var c: Controller, ls: Int) -> Bool
    let slot = ctl_pool.evt_begin(var c.pool, hci_frame.EVT_NUMBER_OF_COMPLETED_PACKETS)
    if slot == ctl_pool.NO_SLOT
        return false
    put_completed(var c.pool, slot, var c.links[ls])
    event_send(var c, slot)
    true

// LE Connection Update Complete ([Vol 4] Part E, Section 7.7.65.3): the status of
// the procedure and the parameters in use.
@satisfies("REQ-BLE-CTL-019")
@tier(embedded)
fn ev_updated(var c: Controller, ls: Int) -> Bool
    if not le_event_enabled(var c, SUB_LE_CONNECTION_UPDATE_COMPLETE)
        lk_sent(var c, ls, ll_link.EV_UPDATED)
        lk_clear_upd(var c, ls)
        return true
    let slot = meta_begin(var c, SUB_LE_CONNECTION_UPDATE_COMPLETE)
    if slot == ctl_pool.NO_SLOT
        return false
    put_updated(var c.pool, slot, var c.links[ls])
    event_send(var c, slot)
    lk_sent(var c, ls, ll_link.EV_UPDATED)
    lk_clear_upd(var c, ls)
    true

// LE Data Length Change ([Vol 4] Part E, Section 7.7.65.7): the effective octets and time of
// the two directions.
@satisfies("REQ-BLE-CTL-041")
@tier(embedded)
fn ev_data_length(var c: Controller, ls: Int) -> Bool
    if not le_event_enabled(var c, SUB_LE_DATA_LENGTH_CHANGE)
        lk_sent(var c, ls, ll_link.EV_DATA_LENGTH)
        return true
    let slot = meta_begin(var c, SUB_LE_DATA_LENGTH_CHANGE)
    if slot == ctl_pool.NO_SLOT
        return false
    put_data_length(var c.pool, slot, var c.links[ls])
    event_send(var c, slot)
    lk_sent(var c, ls, ll_link.EV_DATA_LENGTH)
    true

// LE PHY Update Complete (Section 7.7.65.12): the status of the procedure and the PHY in
// force in each direction.
@satisfies("REQ-BLE-CTL-043")
@tier(embedded)
fn ev_phy(var c: Controller, ls: Int) -> Bool
    if not le_event_enabled(var c, SUB_LE_PHY_UPDATE_COMPLETE)
        lk_sent(var c, ls, ll_link.EV_PHY)
        lk_clear_phy(var c, ls)
        return true
    let slot = meta_begin(var c, SUB_LE_PHY_UPDATE_COMPLETE)
    if slot == ctl_pool.NO_SLOT
        return false
    put_phy(var c.pool, slot, var c.links[ls])
    event_send(var c, slot)
    lk_sent(var c, ls, ll_link.EV_PHY)
    lk_clear_phy(var c, ls)
    true

// LE Remote Connection Parameter Request ([Vol 4] Part E, Section 7.7.65.6): the
// peer's request, for the Host to answer.  An event the Host masked since the
// request came is refused for the peer.
@satisfies("REQ-BLE-CTL-027")
@tier(embedded)
fn ev_param_request(var c: Controller, ls: Int) -> Bool
    if not le_event_enabled(var c, SUB_LE_REMOTE_CONNECTION_PARAMETER_REQUEST)
        let _s = ll_link.link_param_negative(var c.links[ls], STATUS_UNSUPPORTED_REMOTE)
        lk_sent(var c, ls, ll_link.EV_PARAM_REQUEST)
        return true
    let slot = meta_begin(var c, SUB_LE_REMOTE_CONNECTION_PARAMETER_REQUEST)
    if slot == ctl_pool.NO_SLOT
        return false
    put_param_request(var c.pool, slot, var c.links[ls])
    event_send(var c, slot)
    lk_sent(var c, ls, ll_link.EV_PARAM_REQUEST)
    true

// Authenticated Payload Timeout Expired ([Vol 4] Part E, Section 7.7.75).
@satisfies("REQ-BLE-CTL-028")
@tier(embedded)
fn ev_apto(var c: Controller, ls: Int) -> Bool
    if ((c.mask2 >>> MASK2_APTO_EXPIRED) & 1) == 0
        lk_sent(var c, ls, ll_link.EV_APTO)
        return true
    let slot = ctl_pool.evt_begin(var c.pool, EVT_AUTHENTICATED_PAYLOAD_TIMEOUT_EXPIRED)
    if slot == ctl_pool.NO_SLOT
        return false
    put_apto(var c.pool, slot, var c.links[ls])
    event_send(var c, slot)
    lk_sent(var c, ls, ll_link.EV_APTO)
    true

// Read Remote Version Information Complete ([Vol 4] Part E, Section 7.7.12).
@satisfies("REQ-BLE-CTL-020")
@tier(embedded)
fn ev_version(var c: Controller, ls: Int) -> Bool
    if not event_enabled(var c, EVT_READ_REMOTE_VERSION_COMPLETE)
        lk_sent(var c, ls, ll_link.EV_VERSION)
        return true
    let slot = ctl_pool.evt_begin(var c.pool, EVT_READ_REMOTE_VERSION_COMPLETE)
    if slot == ctl_pool.NO_SLOT
        return false
    put_version(var c.pool, slot, var c.links[ls])
    event_send(var c, slot)
    lk_sent(var c, ls, ll_link.EV_VERSION)
    true

// LE Read Remote Features Page 0 Complete ([Vol 4] Part E, Section 7.7.65.4):
// the peer's feature set, or zeros with the status that says why there is none.
@satisfies("REQ-BLE-CTL-020")
@tier(embedded)
fn ev_features(var c: Controller, ls: Int) -> Bool
    if not le_event_enabled(var c, SUB_LE_READ_REMOTE_FEATURES_COMPLETE)
        lk_sent(var c, ls, ll_link.EV_FEATURES)
        return true
    let slot = meta_begin(var c, SUB_LE_READ_REMOTE_FEATURES_COMPLETE)
    if slot == ctl_pool.NO_SLOT
        return false
    put_features(var c.pool, slot, var c.links[ls])
    event_send(var c, slot)
    lk_sent(var c, ls, ll_link.EV_FEATURES)
    true

// LE Long Term Key Request ([Vol 4] Part E, Section 7.7.65.5): the Rand and the
// Encrypted_Diversifier of LL_ENC_REQ.  A Host that masked the event has no key to
// give, so the Central is told the key is missing.
@satisfies("REQ-BLE-CTL-035")
@tier(embedded)
fn ev_ltk_request(var c: Controller, ls: Int) -> Bool
    if not le_event_enabled(var c, SUB_LE_LONG_TERM_KEY_REQUEST)
        let _s = ll_link.link_ltk_negative(var c.links[ls])
        lk_sent(var c, ls, ll_link.EV_LTK_REQUEST)
        return true
    let slot = meta_begin(var c, SUB_LE_LONG_TERM_KEY_REQUEST)
    if slot == ctl_pool.NO_SLOT
        return false
    put_ltk_request(var c.pool, slot, var c.links[ls])
    event_send(var c, slot)
    lk_sent(var c, ls, ll_link.EV_LTK_REQUEST)
    true

// Encryption Change ([Vol 4] Part E, Section 7.7.8): the status, the handle and 1
// when the link is encrypted with AES-CCM.
@satisfies("REQ-BLE-CTL-035")
@tier(embedded)
fn ev_enc_change(var c: Controller, ls: Int) -> Bool
    if not event_enabled(var c, EVT_ENCRYPTION_CHANGE)
        lk_sent(var c, ls, ll_link.EV_ENC_CHANGE)
        return true
    let slot = ctl_pool.evt_begin(var c.pool, EVT_ENCRYPTION_CHANGE)
    if slot == ctl_pool.NO_SLOT
        return false
    put_enc_change(var c.pool, slot, var c.links[ls])
    event_send(var c, slot)
    lk_sent(var c, ls, ll_link.EV_ENC_CHANGE)
    true

// Encryption Key Refresh Complete ([Vol 4] Part E, Section 7.7.39).
@satisfies("REQ-BLE-CTL-035")
@tier(embedded)
fn ev_key_refresh(var c: Controller, ls: Int) -> Bool
    if not event_enabled(var c, EVT_ENCRYPTION_KEY_REFRESH_COMPLETE)
        lk_sent(var c, ls, ll_link.EV_KEY_REFRESH)
        return true
    let slot = ctl_pool.evt_begin(var c.pool, EVT_ENCRYPTION_KEY_REFRESH_COMPLETE)
    if slot == ctl_pool.NO_SLOT
        return false
    put_key_refresh(var c.pool, slot, var c.links[ls])
    event_send(var c, slot)
    lk_sent(var c, ls, ll_link.EV_KEY_REFRESH)
    true

// Queue the events the link in slot `ls` owes the Host, in the order they came, while the
// pool has a slot for each.  An event the Host masked is dropped.  The
// Disconnection Complete of a connection that was released is the last, and the
// Number Of Completed Packets of it is not sent after it (`link_released`
// forgets them).  False when the pool ran out of slots.
@satisfies("REQ-BLE-CTL-014")
@satisfies("REQ-BLE-CTL-018")
@tier(embedded)
fn flush_link(var c: Controller, ls: Int) -> Bool
    if lk_idle(var c, ls)
        return true
    if lk_owes(var c, ls, ll_link.EV_CONNECTED) and not ev_connected(var c, ls)
        return false
    if lk_owes(var c, ls, ll_link.EV_CHSEL) and not ev_chsel(var c, ls)
        return false
    if lk_owes(var c, ls, ll_link.EV_UPDATED) and not ev_updated(var c, ls)
        return false
    if lk_owes(var c, ls, ll_link.EV_PARAM_REQUEST) and not ev_param_request(var c, ls)
        return false
    if lk_owes(var c, ls, ll_link.EV_SUBRATE) and not ev_subrate(var c, ls)
        return false
    if ctl_limits.sca_on() and ll_link.fx_get(c.links[ls], ll_link.FX_SCA, 1) == 1 and not ev_sca(var c, ls)
        return false
    if ctl_limits.feat_on() and lk_owes(var c, ls, ll_link.EV_FEATEXT) and not ev_featext(var c, ls)
        return false
    if lk_owes(var c, ls, ll_link.EV_PHY) and not ev_phy(var c, ls)
        return false
    if lk_owes(var c, ls, ll_link.EV_DATA_LENGTH) and not ev_data_length(var c, ls)
        return false
    if lk_owes(var c, ls, ll_link.EV_LTK_REQUEST) and not ev_ltk_request(var c, ls)
        return false
    if lk_owes(var c, ls, ll_link.EV_ENC_CHANGE) and not ev_enc_change(var c, ls)
        return false
    if lk_owes(var c, ls, ll_link.EV_KEY_REFRESH) and not ev_key_refresh(var c, ls)
        return false
    if lk_owes(var c, ls, ll_link.EV_APTO) and not ev_apto(var c, ls)
        return false
    if lk_owes(var c, ls, ll_link.EV_VERSION) and not ev_version(var c, ls)
        return false
    if lk_owes(var c, ls, ll_link.EV_FEATURES) and not ev_features(var c, ls)
        return false
    if lk_owes(var c, ls, ll_link.EV_COMPLETED) and not ev_completed(var c, ls)
        return false
    if lk_owes(var c, ls, ll_link.EV_DISCONNECTED)
        return ev_disconnected(var c, ls)
    true

// Queue the events the connections and the Initiating state owe the Host.
pub @satisfies("REQ-BLE-CTL-078")
@satisfies("REQ-BLE-CTL-014")
@satisfies("REQ-BLE-CTL-018")
@tier(embedded)
fn ctl_flush_events(var c: Controller)
    for slot in 0..noble_controller_config.CTL_LINKS
        if not flush_link(var c, slot)
            return
    if ctl_limits.iso_on()
        // The streams take turns: a pool the first streams' packets fill is not left to the first streams every time.  A stream whose
        // events did not all find a slot goes first at the next step, and after a step in which every stream was served the one
        // that went first goes last.
        let first = c.iso_rr
        for k in 0..ctl_limits.cis_slots()
            let i = (first + k) % ctl_limits.cis_slots()
            if not flush_cis(var c, i)
                c.iso_rr = i
                return
        c.iso_rr = (first + 1) % ctl_limits.cis_slots()
        if ctl_limits.big_on()
            for g in 0..ctl_limits.big_slots()
                if not flush_big(var c, g)
                    return
    if c.init_event != 0
        let _x = ev_init_ended(var c)
    if c.scan.timeout_owed
        ev_scan_timeout(var c)
    for i in 0..ctl_limits.sets()
        if c.xsets[i].term_owed and not ev_set_terminated(var c, i)
            return
    if ctl_limits.per_on() and not flush_psync(var c)
        return
    if ctl_limits.pawr_adv_on() and not flush_pawr(var c)
        return
    if ctl_limits.big_on() and c.bi_owed and not ev_biginfo(var c)
        return
    if noble_controller_config.CTL_CS > 0
        let _cs = flush_cs(var c)

// ── Isochronous channels ─────────────────────────────────────────────
//
// [Vol 6] Part B, Section 4.5.13, 4.5.14 and 5.1.15; [Vol 4] Part E, Section 7.8.96 to 7.8.116.  The
// Controller holds `ctl_limits.cis_slots()` streams and `ctl_limits.cig_slots()` groups (`cis` and `cigs`, sized from the
// profile's `ctl_cis` and `ctl_cigs`).  A stream's handle is `ll_iso.HANDLE_BASE` plus its slot, and the
// handle stays with the slot: the Central's Host is given it by LE Set CIG Parameters Test and the
// Peripheral's Host by the LE CIS Request event.  The state machine of a stream is in `ll_iso.nv`; this section
// is the Host's side of it (the commands, the events and the ISO Data packets), the LL Control PDUs that make
// and end a stream over the ACL, and the radio program's view (`ctl_cis_*`).
//
// A build without isochronous channels (`ctl_limits.iso_on()` 0) answers none of the commands, takes no ISO Data packet,
// and answers the CIS procedures of a peer with LL_UNKNOWN_RSP.

// The time a Peripheral's Host has to answer LE CIS Request: Connection_Accept_Timeout, 5 seconds by default.
const CIS_ACCEPT_TIMEOUT_US = 5000000

// The time the Host is given beyond the instant of LL_CIS_IND: a stream whose first anchor is nearer than this to
// the time the indication was read is too late to listen for.
const CIS_LEAD_US = 600

// Whether this build has isochronous channels and a Link Layer.
@tier(embedded)
fn iso_on(var c: Controller) -> Bool
    ctl_limits.iso_on() and (c.caps as Int & CAP_LL) != 0

// Run the isochronous channels' command `opcode`.
@tier(embedded)
fn iso_dispatch(var c: Controller, opcode: Int)
    // The five commands of the broadcast groups are dispatched apart, so that a build without groups (answered Unknown HCI Command before it gets here) links none of their code.
    if big_command(opcode) or isotest_command(opcode)
        if ctl_limits.big_on()
            big_dispatch(var c, opcode)
        else
            answer_status(var c, opcode, STATUS_UNKNOWN_COMMAND)
        return
    match opcode
        0x2060 => cmd_le_read_buffer_size_v2(var c)
        0x2061 => cmd_le_read_iso_tx_sync(var c)
        0x2062 => cmd_le_set_cig_parameters(var c)
        0x2063 => cmd_le_set_cig_parameters_test(var c)
        0x2064 => cmd_le_create_cis(var c)
        0x2065 => cmd_le_remove_cig(var c)
        0x2066 => cmd_le_accept_cis_request(var c)
        0x2067 => cmd_le_reject_cis_request(var c)
        0x206d => cmd_le_request_peer_sca(var c)
        0x206e => cmd_le_setup_iso_data_path(var c)
        0x206f => cmd_le_remove_iso_data_path(var c)
        0x2074 => cmd_le_set_host_feature(var c)
        0x2075 => cmd_le_read_iso_link_quality(var c)
        _      => answer_status(var c, opcode, STATUS_UNKNOWN_COMMAND)

// Run the broadcast isochronous group command `opcode`, or the ISO test mode's (a build with groups carries both).
@tier(embedded)
fn big_dispatch(var c: Controller, opcode: Int)
    match opcode
        0x2068 => cmd_le_create_big(var c, false)
        0x2069 => cmd_le_create_big(var c, true)
        0x206a => cmd_le_terminate_big(var c)
        0x206b => cmd_le_big_create_sync(var c)
        0x206c => cmd_le_big_terminate_sync(var c)
        0x2070 => cmd_le_iso_transmit_test(var c)
        0x2071 => cmd_le_iso_receive_test(var c)
        0x2072 => cmd_le_iso_read_test_counters(var c, false)
        0x2073 => cmd_le_iso_read_test_counters(var c, true)
        _      => answer_status(var c, opcode, STATUS_UNKNOWN_COMMAND)

// Whether `opcode` is a command of the isochronous channels.
@tier(embedded)
fn iso_command(opcode: Int) -> Bool
    opcode >= 0x2060 and opcode <= 0x2075

// Whether `opcode` is a command of the broadcast isochronous groups, which a build with none does not answer.
@tier(embedded)
fn big_command(opcode: Int) -> Bool
    opcode >= 0x2068 and opcode <= 0x206C

// Whether `opcode` is a command of the ISO test mode, which a build with no broadcast groups does not answer.
@tier(embedded)
fn isotest_command(opcode: Int) -> Bool
    opcode >= 0x2070 and opcode <= 0x2073

// The slot of the stream with the connection handle `handle`, -1 for none.
@tier(embedded)
fn cis_slot(var c: Controller, handle: Int) -> Int
    for i in 0..ctl_limits.cis_slots()
        if c.cis[i].state != ll_iso.S_FREE and c.cis[i].handle == handle
            return i
    -1

// The slot of the group `cig_id`, -1 for none.
@tier(embedded)
fn cig_slot(var c: Controller, cig_id: Int) -> Int
    for g in 0..ctl_limits.cig_slots()
        if c.cigs[g].used and c.cigs[g].cig_id == cig_id
            return g
    -1

// The slot of the stream `cis_id` of the group `cig_id`, in any state but free; -1 for none.
@tier(embedded)
fn cis_find(var c: Controller, cig_id: Int, cis_id: Int) -> Int
    for i in 0..ctl_limits.cis_slots()
        if c.cis[i].state != ll_iso.S_FREE and c.cis[i].cig_id == cig_id and c.cis[i].cis_id == cis_id
            return i
    -1

// The slot of the stream on the ACL in slot `ls` that is in `state`, -1 for none.  Only one creation procedure
// runs on a connection at a time, so there is at most one in a state that waits for the peer.
@tier(embedded)
fn cis_on_acl(var c: Controller, ls: Int, state: Int) -> Int
    for i in 0..ctl_limits.cis_slots()
        if c.cis[i].state == state and c.cis[i].acl == ls
            return i
    -1

// The lowest free stream slot, -1 for none.
@tier(embedded)
fn cis_free_slot(var c: Controller) -> Int
    for i in 0..ctl_limits.cis_slots()
        if c.cis[i].state == ll_iso.S_FREE
            return i
    -1

// The streams that run: scheduled, established or not.
@tier(embedded)
fn cis_running(var c: Controller, i: Int) -> Bool
    c.cis[i].state == ll_iso.S_WAIT or c.cis[i].state == ll_iso.S_UP

// Take the slot `i` back as a free one (the Peripheral's stream goes with its handle) or as the configuration a
// Central keeps (Section 4.5.14), with the data paths removed.
@tier(embedded)
fn cis_release(var c: Controller, i: Int)
    c.cis[i].dp_in = false
    c.cis[i].dp_out = false
    if c.cis[i].central
        ll_iso.cis_reset_run(var c.cis[i], ll_iso.S_CONFIG)
        cig_idle(var c, c.cis[i].cig_id)
    else
        ll_iso.cis_reset_run(var c.cis[i], ll_iso.S_FREE)

// The group `cig_id` is inactive when none of its streams is being made, runs or ends (Section 4.5.14.3).
@tier(embedded)
fn cig_idle(var c: Controller, cig_id: Int)
    let g = cig_slot(var c, cig_id)
    if g < 0 or c.cigs[g].state != ll_iso.G_ACTIVE
        return
    for i in 0..ctl_limits.cis_slots()
        if c.cis[i].central and c.cis[i].cig_id == cig_id
            let st = c.cis[i].state
            if st != ll_iso.S_CONFIG and st != ll_iso.S_FREE
                return
    c.cigs[g].state = ll_iso.G_INACTIVE

// The slots in their power-on state, and every stream and group gone: the handles are fixed by the slot.
@tier(embedded)
fn iso_reset(var c: Controller)
    for i in 0..ctl_limits.cis_slots()
        c.cis[i].dp_in = false
        c.cis[i].dp_out = false
        c.cis[i].central = false
        c.cis[i].cig_id = 0
        c.cis[i].cis_id = 0
        ll_iso.cis_reset_run(var c.cis[i], ll_iso.S_FREE)
        c.cis[i].handle = ll_iso.HANDLE_BASE + i
    for g in 0..ctl_limits.cig_slots()
        c.cigs[g].used = false
        c.cigs[g].ref_ok = false
        c.cigs[g].ref_t = 0
    c.host_iso = false
    c.iso_dropped = 0
    c.iso_rr = 0
    c.room_skips = 0

// Queue the LL Control PDU in the `tmp` of the ACL link in slot `ls`.
@tier(embedded)
fn iso_send(var c: Controller, ls: Int) -> Bool
    let ok = ll_link.link_send_tmp(var c.links[ls])
    if ok
        ll_link.link_prepare(var c.links[ls])
    ok

// Reject the creation procedure of the peer on the link `ls` with `code` (LL_REJECT_EXT_IND, Section 5.1.15).
@tier(embedded)
fn iso_reject(var c: Controller, ls: Int, op: Int, code: Int)
    ll_link.send_reject(var c.links[ls], op, code)
    ll_link.link_prepare(var c.links[ls])

// ── LE Power Control ────────────────────────────────────────────────

// LE Transmit Power Reporting ([Vol 4] Part E, Section 7.7.65.33) for the link in slot `ls`: the PHY index `idx` (0 to 3) is reported as
// the HCI PHY value 1 to 4.  `reason` is `ll_pcl.REASON_*`; the event is dropped when the Host did not unmask it or no event slot is free.
@satisfies("REQ-BLE-CTL-115")
@tier(embedded)
fn pcl_event(var c: Controller, ls: Int, status: Int, reason: Int, idx: Int, level: Int, flags: Int,
             delta: Int)
    if not le_event_enabled(var c, SUB_LE_TRANSMIT_POWER_REPORTING)
        return
    let slot = meta_begin(var c, SUB_LE_TRANSMIT_POWER_REPORTING)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put(var c.pool, slot, status)
    let _b = ctl_pool.pool_put_u16(var c.pool, slot, c.links[ls].handle)
    let _c = ctl_pool.pool_put(var c.pool, slot, reason)
    let _d = ctl_pool.pool_put(var c.pool, slot, idx + 1)
    let _e = ctl_pool.pool_put(var c.pool, slot, level & 0xFF)
    let _f = ctl_pool.pool_put(var c.pool, slot, flags)
    let _g = ctl_pool.pool_put(var c.pool, slot, delta & 0xFF)
    event_send(var c, slot)

// Whether the PHY index `idx` is one this Controller transmits on: the two uncoded PHYs always, the coded ones in a build with the LE Coded PHY.
@tier(embedded)
fn pcl_phy_ok(var c: Controller, idx: Int) -> Bool
    idx >= 0 and (idx < 2 or idx < ll_pcl.PHYS and c.coded)

// The PHY index the link in slot `ls` transmits on now.
@tier(embedded)
fn pcl_cur(var c: Controller, ls: Int) -> Int
    ll_pcl.link_index(c.links[ls].phy, c.links[ls].phy_opt == ll_phy.OPT_S2)

// Whether the peer of the link in slot `ls` said it lacks LE Power Control Request (feature 33).
@tier(embedded)
fn pcl_peer_lacks(var c: Controller, ls: Int) -> Bool
    c.links[ls].have_feat and (c.links[ls].peer_feat[4] as Int & 0x02) == 0

// LL_POWER_CONTROL_REQ received on the link in slot `ls` ([Vol 6] Part B, Section 5.1.17): the PHY is one supported PHY and the level is a
// value; a request that crosses this end's own outstanding request is answered with no change.  The new level is the present level moved
// by Delta within the range of the radio; the answer carries the Flags of the new level and 0xFF as the Acceptable Power Reduction, since
// this Controller measures no signal margin.  The Host is told when it asked for local reports and the level moved.
@satisfies("REQ-BLE-CTL-115")
@tier(embedded)
fn pcl_req(var c: Controller, ls: Int, var rx: Pdu)
    let mask = ll_data.dpdu_byte(var rx, 1)
    let delta = ll_data.dpdu_byte(var rx, 2)
    let idx = ll_pcl.mask_index(mask)
    if not pcl_phy_ok(var c, idx)
        iso_reject(var c, ls, ll_data.OP_POWER_CONTROL_REQ, ll_pcl.E_UNSUPPORTED_PARAM)
        return
    if ll_data.dpdu_byte(var rx, 3) == ll_pcl.TX_UNMANAGED
        iso_reject(var c, ls, ll_data.OP_POWER_CONTROL_REQ, ll_pcl.E_INVALID_LL)
        return
    let old = ll_pcl.own_level(var c.pcl[ls], idx)
    var new = old
    if not c.pcl[ls].wait
        new = ll_pcl.apply_delta(old, delta, TX_POWER_MIN_DBM, TX_POWER_MAX_DBM)
    if new != old
        ll_pcl.set_own_level(var c.pcl[ls], idx, new)
        c.links[ls].txp[idx] = new as i8
    c.pcl[ls].asked = true
    let flags = ll_pcl.level_flags(new, TX_POWER_MIN_DBM, TX_POWER_MAX_DBM)
    ll_pcl.put_rsp(var c.links[ls].tmp, flags, new - old, new, ll_pcl.APR_UNKNOWN)
    let _s = iso_send(c, ls)
    if new != old and c.pcl[ls].local_rep
        pcl_event(var c, ls, STATUS_SUCCESS, ll_pcl.REASON_LOCAL, idx, new, flags, new - old)

// LL_POWER_CONTROL_RSP received: it answers the request this end sent, whose reason the Host knows (a read, or the first report after
// the Host enabled remote reports).  The level and Flags are the peer's, and are kept as the last known.
@satisfies("REQ-BLE-CTL-115")
@tier(embedded)
fn pcl_rsp(var c: Controller, ls: Int, var rx: Pdu)
    if not c.pcl[ls].wait
        return
    let idx = c.pcl[ls].wait_phy
    let flags = ll_data.dpdu_byte(var rx, 1)
    let level = ll_pcl.i8(ll_data.dpdu_byte(var rx, 3))
    c.pcl[ls].wait = false
    ll_pcl.set_peer(var c.pcl[ls], idx, level, flags)
    let reason = c.pcl[ls].wait_reason
    if reason == ll_pcl.REASON_READ or reason == ll_pcl.REASON_REMOTE and c.pcl[ls].remote_rep
        pcl_event(var c, ls, STATUS_SUCCESS, reason, idx, level, flags, 0)

// LL_POWER_CHANGE_IND received: the peer moved its level on every PHY the mask names.
@satisfies("REQ-BLE-CTL-115")
@tier(embedded)
fn pcl_ind(var c: Controller, ls: Int, var rx: Pdu)
    let mask = ll_data.dpdu_byte(var rx, 1)
    let flags = ll_data.dpdu_byte(var rx, 2)
    let delta = ll_pcl.i8(ll_data.dpdu_byte(var rx, 3))
    let level = ll_pcl.i8(ll_data.dpdu_byte(var rx, 4))
    for i in 0..ll_pcl.PHYS
        if (mask & ll_pcl.index_mask(i)) != 0 and pcl_phy_ok(var c, i)
            ll_pcl.set_peer(var c.pcl[ls], i, level, flags)
            if c.pcl[ls].remote_rep
                pcl_event(var c, ls, STATUS_SUCCESS, ll_pcl.REASON_REMOTE, i, level, flags, delta)

// The peer refused (LL_REJECT_EXT_IND with `code`, or LL_UNKNOWN_RSP) the request that is outstanding: the Host that waits for it is told
// with that Status.
@satisfies("REQ-BLE-CTL-115")
@tier(embedded)
fn pcl_refused(var c: Controller, ls: Int, code: Int)
    if not c.pcl[ls].wait
        return
    c.pcl[ls].wait = false
    if ctl_limits.ploss_on() and c.pcl[ls].wait_reason == ll_pcl.REASON_PATHLOSS
        ploss_unavailable(var c, ls)
        return
    pcl_event(var c, ls, code, c.pcl[ls].wait_reason, c.pcl[ls].wait_phy, ll_pcl.TX_UNAVAILABLE, 0, 0)

// One control PDU of LE Power Control from the link in slot `ls`: a request or indication, the answer to this end's request, or a refusal
// of it.  `op` is the opcode `ctl_iso_ctrl` read.
@satisfies("REQ-BLE-CTL-115")
@tier(embedded)
fn pcl_rx(var c: Controller, ls: Int, op: Int, var rx: Pdu)
    if op == ll_data.OP_POWER_CONTROL_REQ
        pcl_req(var c, ls, var rx)
    else if op == ll_data.OP_POWER_CONTROL_RSP
        pcl_rsp(var c, ls, var rx)
    else if op == ll_data.OP_POWER_CHANGE_IND
        pcl_ind(var c, ls, var rx)
    else if op == ll_data.OP_REJECT_EXT_IND and ll_data.dpdu_byte(var rx, 1) == ll_data.OP_POWER_CONTROL_REQ
        pcl_refused(var c, ls, ll_data.dpdu_byte(var rx, 2))
    else if op == ll_data.OP_UNKNOWN_RSP and ll_data.dpdu_byte(var rx, 1) == ll_data.OP_POWER_CONTROL_REQ
        pcl_refused(var c, ls, STATUS_UNSUPPORTED_REMOTE)

// The work of LE Power Control that is not in a radio event: the request a Host command asked for goes out (the queue may be full), and one the
// peer leaves unanswered is given up after `ll_pcl.WAIT_US`, as is one on a connection that ended.  True when something was done.
@satisfies("REQ-BLE-CTL-115")
@tier(embedded)
fn ctl_pcl_poll(var c: Controller) -> Bool
    var did = false
    for ls in 0..noble_controller_config.CTL_LINKS
        if c.pcl[ls].wait
            if not ctl_conn_active(var c, ls)
                c.pcl[ls].wait = false
                did = true
            else if c.now - c.pcl[ls].t0 > ll_pcl.WAIT_US
                c.pcl[ls].wait = false
                if ctl_limits.ploss_on() and c.pcl[ls].wait_reason == ll_pcl.REASON_PATHLOSS
                    ploss_unavailable(var c, ls)
                else
                    pcl_event(var c,
                        ls,
                        STATUS_RESPONSE_TIMEOUT,
                        c.pcl[ls].wait_reason,
                        c.pcl[ls].wait_phy,
                        ll_pcl.TX_UNAVAILABLE,
                        0,
                        0)
                did = true
            else if not c.pcl[ls].sent
                let idx = c.pcl[ls].wait_phy
                ll_pcl.put_req(var c.links[ls].tmp,
                    ll_pcl.index_mask(idx),
                    0,
                    ll_pcl.own_level(var c.pcl[ls], idx))
                if iso_send(c, ls)
                    c.pcl[ls].sent = true
                    did = true
    did

// Ask the peer of the link in slot `ls` for its level on the PHY index `idx`, for `reason`: the request goes out from `ctl_pcl_poll`.
@tier(embedded)
fn pcl_ask(var c: Controller, ls: Int, idx: Int, reason: Int)
    c.pcl[ls].wait = true
    c.pcl[ls].sent = false
    c.pcl[ls].wait_phy = idx
    c.pcl[ls].wait_reason = reason
    c.pcl[ls].t0 = c.now

// LE Enhanced Read Transmit Power Level ([Vol 4] Part E, Section 7.8.117): the level the link transmits at on the PHY, and the most the radio can.
@satisfies("REQ-BLE-CTL-115")
@tier(embedded)
fn cmd_le_enhanced_read_transmit_power_level(var c: Controller)
    let handle = param_handle(var c)
    let phy = h4_rx.h4_param(var c.rx, 2)
    let ls = handle_slot(var c, handle)
    let idx = ll_pcl.hci_index(phy)
    var status = STATUS_SUCCESS
    if ls < 0
        status = STATUS_UNKNOWN_CONNECTION
    else if idx < 0
        status = STATUS_INVALID_PARAMETERS
    else if not pcl_phy_ok(var c, idx)
        status = STATUS_UNSUPPORTED_FEATURE
    let slot = complete_begin(var c, OP_LE_ENHANCED_READ_TRANSMIT_POWER_LEVEL, status)
    if slot == ctl_pool.NO_SLOT
        return
    var cur = 0
    var top = 0
    if status == STATUS_SUCCESS
        cur = ll_pcl.own_level(var c.pcl[ls], idx)
        top = TX_POWER_MAX_DBM
    let _a = ctl_pool.pool_put_u16(var c.pool, slot, handle)
    let _b = ctl_pool.pool_put(var c.pool, slot, phy)
    let _c = ctl_pool.pool_put(var c.pool, slot, cur & 0xFF)
    let _d = ctl_pool.pool_put(var c.pool, slot, top & 0xFF)
    complete_send(var c, slot)

// LE Read Remote Transmit Power Level (Section 7.8.118): Command Status now, and LE Transmit Power Reporting (reason 2) when the peer answers
// the request this sends.  Unsupported Remote Feature for a peer that lacks the feature, Command Disallowed while an earlier request waits.
@satisfies("REQ-BLE-CTL-115")
@tier(embedded)
fn cmd_le_read_remote_transmit_power_level(var c: Controller)
    let handle = param_handle(var c)
    let phy = h4_rx.h4_param(var c.rx, 2)
    let ls = handle_slot(var c, handle)
    let idx = ll_pcl.hci_index(phy)
    var status = STATUS_SUCCESS
    if ls < 0
        status = STATUS_UNKNOWN_CONNECTION
    else if idx < 0
        status = STATUS_INVALID_PARAMETERS
    else if not pcl_phy_ok(var c, idx)
        status = STATUS_UNSUPPORTED_FEATURE
    else if pcl_peer_lacks(var c, ls)
        status = STATUS_UNSUPPORTED_REMOTE
    else if c.pcl[ls].wait
        status = STATUS_COMMAND_DISALLOWED
    else
        pcl_ask(var c, ls, idx, ll_pcl.REASON_READ)
    answer_command_status(var c, OP_LE_READ_REMOTE_TRANSMIT_POWER_LEVEL, status)

// LE Set Transmit Power Reporting Enable (Section 7.8.120): which reports the Host takes for the connection.  Enabling remote reports asks the peer
// for its level once, so that the Host has the first one.
@satisfies("REQ-BLE-CTL-115")
@tier(embedded)
fn cmd_le_set_transmit_power_reporting_enable(var c: Controller)
    let op = OP_LE_SET_TRANSMIT_POWER_REPORTING_ENABLE
    let handle = param_handle(var c)
    let local = h4_rx.h4_param(var c.rx, 2)
    let remote = h4_rx.h4_param(var c.rx, 3)
    let ls = handle_slot(var c, handle)
    var status = STATUS_SUCCESS
    if ls < 0
        status = STATUS_UNKNOWN_CONNECTION
    else if local > 1 or remote > 1
        status = STATUS_INVALID_PARAMETERS
    else
        c.pcl[ls].local_rep = local == 1
        c.pcl[ls].remote_rep = remote == 1
        if remote == 1 and not c.pcl[ls].wait and not pcl_peer_lacks(var c, ls)
            pcl_ask(var c, ls, pcl_cur(var c, ls), ll_pcl.REASON_REMOTE)
    answer_handle(var c, op, status, handle)

// Run the command of LE Power Control with `opcode`.
@tier(embedded)
fn pcl_dispatch(var c: Controller, opcode: Int)
    match opcode
        0x2076 => cmd_le_enhanced_read_transmit_power_level(var c)
        0x2077 => cmd_le_read_remote_transmit_power_level(var c)
        _      => cmd_le_set_transmit_power_reporting_enable(var c)

// ── Channel Sounding ────────────────────────────────────────────────

// ── Channel Sounding: the words and octets of the Controller ────────
// After the records of the connections the tables `cs_w` and `cs_b` hold what the Controller as a whole keeps: the words `ll_cs_proc.GW_` and the octets `GO_` (the local
// capability record, the parameters of an LE CS Test, the FAE table of the test, and the octets of the result of a subevent that waits to be sent).

// Word `k` of the Controller's own words.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_gw(var c: Controller, k: Int) -> Int
    c.cs_w[noble_controller_config.CTL_CS * ll_cs_proc.CS_WORDS + k]

@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_gw_put(var c: Controller, k: Int, v: Int)
    c.cs_w[noble_controller_config.CTL_CS * ll_cs_proc.CS_WORDS + k] = v

// Octet `k` of the Controller's own octets.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_go(var c: Controller, k: Int) -> Int
    c.cs_b[noble_controller_config.CTL_CS * ll_cs_proc.bulk_octets() + k] as Int

@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_go_put(var c: Controller, k: Int, v: Int)
    c.cs_b[noble_controller_config.CTL_CS * ll_cs_proc.bulk_octets() + k] = (v & 0xFF) as u8

// Whether the Host set Channel Sounding (Host Support).
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_host_get(var c: Controller) -> Bool
    cs_gw(var c, ll_cs_proc.GW_HOST) != 0

// Whether the Host set the Channel Sounding (Host Support) feature bit, which goes into the feature set the Host reads and the one sent to the peer.  False for a build without
// the feature.
@tier(embedded)
fn host_cs_bit(var c: Controller) -> Bool
    if noble_controller_config.CTL_CS > 0
        return cs_host_get(var c)
    false

// Whether the radio reports the tone quality (LE feature 48), which the Controller tells the Host and not the peer.  False for a build without the feature.
@tier(embedded)
fn cs_tq_bit(var c: Controller) -> Bool
    if noble_controller_config.CTL_CS > 0
        return cs_gw(var c, ll_cs_proc.GW_TQ) != 0
    false

// The capabilities of this end: those of the build, cut down to what the radio runs once `ctl_cs_radio_init` has read it.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_local(var c: Controller, var out: ll_cs_pdu.CapPdu)
    ll_cs_proc.local_caps(var out)
    if cs_gw(var c, ll_cs_proc.GW_RADIO) != 0
        var b = ll_cs_hci.buf_new()
        for k in 0..ll_cs_hci.CAPS_V2
            b[k] = cs_go(var c, ll_cs_proc.GO_CAPS + k) as u8
        ll_cs_hci.caps_get(var b, out.v2, var out)

// Read the capabilities of the radio `air` once, when the Controller starts, and keep what this end reports: the capabilities of the build cut down to the radio's, whether
// it reports the tone quality (LE feature 48), and its table of frequency actuation errors, which the peer asks for (a value beyond the octet of the PDU is cut to it).  A
// Controller that never calls this reports the capabilities of its build and a table of zeros.
@when(noble_controller_config.CTL_CS > 0)
pub @tier(embedded)
fn ctl_cs_radio_init<S: CsRadio[s]>(var c: Controller, var air: S) [s]
    var rc = air.cs_caps()
    var local = ll_cs_pdu.cap_new()
    ll_cs_proc.local_caps(var local)
    ll_cs_hci.caps_radio(var local, var rc)
    var b = ll_cs_hci.buf_new()
    let n = ll_cs_hci.caps_put(var local, true, var b)
    for k in 0..n
        cs_go_put(var c, ll_cs_proc.GO_CAPS + k, b[k] as Int)
    cs_gw_put(var c, ll_cs_proc.GW_RADIO, 1)
    cs_gw_put(var c, ll_cs_proc.GW_TQ, ll_cs_proc.b2i(rc.supported and rc.tq))
    // The time the radio needs between `cs_arm` and the start of a run: the lead of a booking of the arbiter has it (`cs_lead_us`).
    var timing = ll_cs_radio.cs_timing_none()
    if rc.supported
        timing = air.cs_timing()
    cs_gw_put(var c, ll_cs_proc.GW_ARM_LEAD, timing.arm_lead_us)
    // The table of frequency actuation errors the peer asks for with LL_CS_FAE_REQ: the radio's, for each allowed channel in index order.  A radio that needs none has no table
    // to report, and the Controller says so with No_FAE.
    for k in 0..ll_cs.CHANNEL_COUNT
        var v = 0
        if rc.supported and not rc.no_fae
            v = air.cs_fae(ll_cs.fae_channel(k))
        if v < -128
            v = -128
        if v > 127
            v = 127
        cs_go_put(var c, ll_cs_proc.GO_LFAE + k, v)

// Whether the peer of the link in slot `ls` may be asked: its feature set is known, has Channel Sounding (46) and has its Host Support (47).  The status the command gets
// otherwise: Command Disallowed when the features are not known or Host Support is clear, Unsupported Remote Feature when the peer has no Channel Sounding.  The commands
// that make the Feature Exchange for the Host (Read Remote Supported Capabilities, Create Config with the peer) ask this only once the features are known.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_peer_gate(var c: Controller, ls: Int) -> Int
    if not c.links[ls].have_feat
        return STATUS_COMMAND_DISALLOWED
    let f5 = c.links[ls].peer_feat[5] as Int
    if (f5 & ll_cs.FEAT5_CS) == 0
        return STATUS_UNSUPPORTED_REMOTE
    if (f5 & ll_cs.FEAT5_CS_HOST) == 0
        return STATUS_COMMAND_DISALLOWED
    STATUS_SUCCESS

// The status of the checks every command with a connection handle meets: Unknown Connection Identifier for a handle that is no ACL, Command Disallowed when the Host has
// not set Channel Sounding (Host Support), and, for a command that asks the peer, `cs_peer_gate`.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_gate(var c: Controller, ls: Int, peer: Bool) -> Int
    if ls < 0
        return STATUS_UNKNOWN_CONNECTION
    if not cs_host_get(var c)
        return STATUS_COMMAND_DISALLOWED
    if peer
        return cs_peer_gate(var c, ls)
    STATUS_SUCCESS

// The Host is owed `bit` (an `OWED_` of ll_cs_proc) with the status `st` for the connection of the record `i`.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_owe(var c: Controller, i: Int, bit: Int, st: Int)
    var cs = ll_cs_proc.cs_new()
    cs_get(var c, i, var cs)
    ll_cs_proc.owe(var cs, bit, st)
    cs_put(var c, i, var cs)

// ── Channel Sounding: the commands ──────────────────────────────────

// The Channel Sounding commands of a build that has the feature.  Each checks what the specification lists for it ([Vol 4] Part E, Section 7.8.130 to 7.8.143, 7.8.157 and
// 7.8.158) and answers with a Command Complete event, or with a Command Status event when the result follows as an event of its own (`ll_cs.status_reply`).
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_dispatch(var c: Controller, opcode: Int)
    match opcode
        0x2089 => cmd_cs_read_local(var c, false)
        0x20a5 => cmd_cs_read_local(var c, true)
        0x208a => cmd_cs_read_remote(var c)
        0x208b => cmd_cs_write_cached(var c, false)
        0x20a6 => cmd_cs_write_cached(var c, true)
        0x208c => cmd_cs_security_enable(var c)
        0x208d => cmd_cs_default_settings(var c)
        0x208e => cmd_cs_read_fae(var c)
        0x208f => cmd_cs_write_fae(var c)
        0x2090 => cmd_cs_create_config(var c)
        0x2091 => cmd_cs_remove_config(var c)
        0x2092 => cmd_cs_classification(var c)
        0x2093 => cmd_cs_procedure_parameters(var c)
        0x2094 => cmd_cs_procedure_enable(var c)
        0x2095 => cmd_cs_test(var c)
        0x2096 => cmd_cs_test_end(var c)
        0x20a7 => cmd_cs_security_requirements(var c)
        _      => cmd_cs_default_security_requirements(var c)

// LE CS Read Local Supported Capabilities, [v1] (`v2` false) and [v2]: the record of this end, or Command Disallowed with zeros while the Host Support bit is clear.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cmd_cs_read_local(var c: Controller, v2: Bool)
    var op = ll_cs.OP_CS_READ_LOCAL_SUPPORTED_CAPABILITIES
    if v2
        op = ll_cs.OP_CS_READ_LOCAL_SUPPORTED_CAPABILITIES_V2
    var status = STATUS_SUCCESS
    if not cs_host_get(var c)
        status = STATUS_COMMAND_DISALLOWED
    let slot = complete_begin(var c, op, status)
    // cov: skip — ctl_step runs a command only with a free slot for its answer
    if slot == ctl_pool.NO_SLOT
        return
    var local = ll_cs_pdu.cap_new()
    cs_local(var c, var local)
    var b = ll_cs_hci.buf_new()
    let n = ll_cs_hci.caps_put(var local, v2, var b)
    for k in 0..n
        if status == STATUS_SUCCESS
            let _a = ctl_pool.pool_put(var c.pool, slot, b[k] as Int)
        else
            let _z = ctl_pool.pool_put(var c.pool, slot, 0)
    complete_send(var c, slot)

// LE CS Read Remote Supported Capabilities: Command Status, and the Read Remote Supported Capabilities Complete event when the exchange with the peer is done.  The
// capabilities the Host wrote (LE CS Write Cached Remote Supported Capabilities) or an earlier exchange left are the answer without one.  A peer whose features are not
// known is asked for them first, as [Vol 4] Part E, Section 7.8.131 asks: the Feature Exchange runs, `ctl_cs_poll` goes on with the Capabilities Exchange when it has
// ended, and a failure of either is the status of the event (the Host also hears LE Read Remote Features Complete, as it does for the exchange a stream needs).
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cmd_cs_read_remote(var c: Controller)
    let ls = handle_slot(var c, param_handle(var c))
    var status = cs_gate(var c, ls, false)
    if status == STATUS_SUCCESS
        if c.links[ls].have_feat
            status = cs_caps_step(var c, ls)
        else
            status = ctl_cs_features(var c, ls)
    answer_command_status(var c, ll_cs.OP_CS_READ_REMOTE_SUPPORTED_CAPABILITIES, status)

// The step of LE CS Read Remote Supported Capabilities once the features of the peer on the link in slot `ls` are known: the peer is asked (it has Channel Sounding and
// its Host Support bit set), and the capabilities the Host wrote or an earlier exchange left are the answer without an exchange.  The status of the command.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_caps_step(var c: Controller, ls: Int) -> Int
    var status = cs_peer_gate(var c, ls)
    if status == STATUS_SUCCESS
        var cached = false
        let i = cs_find(var c, ls)
        if i >= 0
            var cs = ll_cs_proc.cs_new()
            cs_get(var c, i, var cs)
            cached = ll_cs_proc.caps_known(var cs) and cs.wait == ll_cs_proc.W_NONE
        if cached
            cs_owe(var c, cs_find(var c, ls), ll_cs_proc.OWED_CAPS, 0)
        else
            status = ctl_cs_capabilities(var c, ls)
    status

// LE CS Write Cached Remote Supported Capabilities, [v1] and [v2]: the record of a peer the Host knows from an earlier connection.  The 2M counts of a [v1] record are those of
// the 1M ones, which the event of the [v2] form says when it is read back.  Command Disallowed once the peer has sent its capabilities or a configuration exists.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cmd_cs_write_cached(var c: Controller, v2: Bool)
    var op = ll_cs.OP_CS_WRITE_CACHED_REMOTE_SUPPORTED_CAPABILITIES
    var n = ll_cs_hci.CAPS_V1
    if v2
        op = ll_cs.OP_CS_WRITE_CACHED_REMOTE_SUPPORTED_CAPABILITIES_V2
        n = ll_cs_hci.CAPS_V2
    let handle = param_handle(var c)
    let ls = handle_slot(var c, handle)
    var status = cs_gate(var c, ls, false)
    if status == STATUS_SUCCESS
        var b = ll_cs_hci.buf_new()
        ll_cs_hci.buf_take(var c.rx, 2, n, var b)
        var cp = ll_cs_pdu.cap_new()
        ll_cs_hci.caps_get(var b, v2, var cp)
        status = ll_cs_hci.caps_host_check(var cp)
        if status == STATUS_SUCCESS
            let i = cs_claim(var c, ls)
            if i < 0
                status = ll_cs_proc.E_LIMITED
            else
                var cs = ll_cs_proc.cs_new()
                cs_get(var c, i, var cs)
                status = ll_cs_proc.cache_caps(var cs, var cp, var c.links[ls].tmp)
                cs_put(var c, i, var cs)
    answer_handle(var c, op, status, handle)

// LE CS Security Enable: Command Status, and the Security Enable Complete event when the Central has the Peripheral's part of the values.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cmd_cs_security_enable(var c: Controller)
    let ls = handle_slot(var c, param_handle(var c))
    var status = cs_gate(var c, ls, true)
    if status == STATUS_SUCCESS
        status = ctl_cs_security(var c, ls)
    answer_command_status(var c, ll_cs.OP_CS_SECURITY_ENABLE, status)

// The antenna selection of LE CS Set Default Settings: an element of the build (1 to its count), or one of the three codes 0xFD, 0xFE and 0xFF.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_antenna_ok(sel: Int, count: Int) -> Bool
    sel >= 1 and sel <= count or sel >= 0xFD

// LE CS Set Default Settings: the roles the Host enables, the antenna for CS_SYNC and the highest transmit power, for the connection.  Unsupported Feature or Parameter Value
// for a role or an antenna this end lacks, Invalid HCI Command Parameters for a role switched off while a configuration of that role exists and for a power beyond the range.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cmd_cs_default_settings(var c: Controller)
    let handle = param_handle(var c)
    let ls = handle_slot(var c, handle)
    let roles = h4_rx.h4_param(var c.rx, 2)
    let ant = h4_rx.h4_param(var c.rx, 3)
    let txp = h4_rx.h4_param(var c.rx, 4)
    var status = STATUS_SUCCESS
    var local = ll_cs_pdu.cap_new()
    cs_local(var c, var local)
    if ls < 0
        status = STATUS_UNKNOWN_CONNECTION
    else if (roles & ~local.role) != 0 or not cs_antenna_ok(ant, local.num_ant)
        status = STATUS_UNSUPPORTED_FEATURE
    else if not ll_cs_hci.dbm_ok(txp)
        status = STATUS_INVALID_PARAMETERS
    else
        let i = cs_claim(var c, ls)
        if i < 0
            status = ll_cs_proc.E_LIMITED
        else
            var cs = ll_cs_proc.cs_new()
            cs_get(var c, i, var cs)
            for id in 0..ll_cs_proc.cfg_slots()
                if ll_cs_proc.cfg_used(var cs, id) and ((roles >>> ll_cs_proc.cfg_role(var cs, id)) & 1) == 0
                    status = STATUS_INVALID_PARAMETERS
            if status == STATUS_SUCCESS
                ll_cs_proc.set_defaults(var cs, roles, ant, txp)
                cs_put(var c, i, var cs)
    answer_handle(var c, ll_cs.OP_CS_SET_DEFAULT_SETTINGS, status, handle)

// LE CS Read Remote FAE Table: Command Status, and the Read Remote FAE Table Complete event with the 72 values.  A table the Host wrote or an earlier request left is the answer
// without a request.  Unsupported Feature or Parameter Value when the peer needs no table (No_FAE).
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cmd_cs_read_fae(var c: Controller)
    let ls = handle_slot(var c, param_handle(var c))
    var status = STATUS_SUCCESS
    if ls < 0
        status = STATUS_UNKNOWN_CONNECTION
    else
        status = cs_peer_gate(var c, ls)
        if status == STATUS_SUCCESS and not cs_host_get(var c)
            status = STATUS_COMMAND_DISALLOWED
    if status == STATUS_SUCCESS
        var cached = false
        let i = cs_find(var c, ls)
        if i >= 0
            var cs = ll_cs_proc.cs_new()
            cs_get(var c, i, var cs)
            var peer = ll_cs_pdu.cap_new()
            let have = ll_cs_proc.load_caps(var cs, var peer, var c.links[ls].tmp)
            if have and peer.no_fae == 1
                status = STATUS_UNSUPPORTED_FEATURE
            cached = status == STATUS_SUCCESS and cs.fae_known and cs.wait == ll_cs_proc.W_NONE
        if status == STATUS_SUCCESS
            if cached
                cs_owe(var c, cs_find(var c, ls), ll_cs_proc.OWED_FAE, 0)
            else
                status = ctl_cs_fae(var c, ls)
    answer_command_status(var c, ll_cs.OP_CS_READ_REMOTE_FAE_TABLE, status)

// LE CS Write Cached Remote FAE Table: the table of a peer the Host knows from an earlier connection, or, with the handle 0xFFF, the table LE CS Test uses.  Unsupported Feature
// or Parameter Value when the peer needs no table, Command Disallowed once the peer has sent its table or a configuration exists.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cmd_cs_write_fae(var c: Controller)
    let handle = param_handle(var c)
    var status = STATUS_SUCCESS
    if handle == ll_cs_proc.HANDLE_TEST
        for k in 0..ll_cs.CHANNEL_COUNT
            cs_go_put(var c, ll_cs_proc.GO_FAE + k, h4_rx.h4_param(var c.rx, 2 + k))
        answer_handle(var c, ll_cs.OP_CS_WRITE_CACHED_REMOTE_FAE_TABLE, status, handle)
        return
    let ls = handle_slot(var c, handle)
    if ls < 0
        status = STATUS_UNKNOWN_CONNECTION
    else
        let i = cs_claim(var c, ls)
        if i < 0
            status = ll_cs_proc.E_LIMITED
        else
            var cs = ll_cs_proc.cs_new()
            cs_get(var c, i, var cs)
            var peer = ll_cs_pdu.cap_new()
            if ll_cs_proc.load_caps(var cs, var peer, var c.links[ls].tmp) and peer.no_fae == 1
                status = STATUS_UNSUPPORTED_FEATURE
            else
                for k in 0..ll_cs.CHANNEL_COUNT
                    if status == STATUS_SUCCESS
                        status = ll_cs_proc.cache_fae(var cs, k, h4_rx.h4_param(var c.rx, 2 + k), k == ll_cs.CHANNEL_COUNT - 1)
            cs_put(var c, i, var cs)
    answer_handle(var c, ll_cs.OP_CS_WRITE_CACHED_REMOTE_FAE_TABLE, status, handle)

// Whether a procedure is enabled on any connection: LE CS Test and the commands that change a configuration or the requirements wait for it.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_any_running(var c: Controller) -> Bool
    for i in 0..ctl_limits.cs_slots()
        if cs_owner(var c, i) >= 0
            var cs = ll_cs_proc.cs_new()
            cs_get(var c, i, var cs)
            if cs.run_open
                return true
    false

// Whether a procedure is enabled on the connection of the link in slot `ls`.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_link_running(var c: Controller, ls: Int) -> Bool
    let i = cs_find(var c, ls)
    if i < 0
        return false
    var cs = ll_cs_proc.cs_new()
    cs_get(var c, i, var cs)
    cs.run_open

// LE CS Create Config: Command Status, and the Config Complete event when the peer has answered, or at once when `Create_Context` is 0 (the configuration is kept here
// alone).  A peer whose capabilities, or whose features, are not known is asked for them first (`ctl_cs_config`).  Invalid HCI Command Parameters for a role the Host did
// not enable with LE CS Set Default Settings or a configuration outside the specification, Unsupported Feature or Parameter Value for one this end or the peer lacks,
// Command Disallowed for a configuration that is enabled.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cmd_cs_create_config(var c: Controller)
    let ls = handle_slot(var c, param_handle(var c))
    let context = h4_rx.h4_param(var c.rx, 3)
    var cfg = ll_cs_pdu.cfg_new()
    ll_cs_hci.config_from_rx(var c.rx, var cfg)
    // A peer whose features are not known is not refused: the Controller asks for them (`ctl_cs_config`).
    var status = cs_gate(var c, ls, false)
    if status == STATUS_SUCCESS and context == 1 and c.links[ls].have_feat
        status = cs_peer_gate(var c, ls)
    if status == STATUS_SUCCESS and context > 1
        status = STATUS_INVALID_PARAMETERS
    if status == STATUS_SUCCESS
        let i = cs_claim(var c, ls)
        if i < 0
            status = ll_cs_proc.E_LIMITED
        else
            var cs = ll_cs_proc.cs_new()
            cs_get(var c, i, var cs)
            if cfg.role <= 1 and ((cs.def_roles >>> cfg.role) & 1) == 0
                status = STATUS_INVALID_PARAMETERS
            else
                status = ctl_cs_config(var c, ls, var cfg, context == 0)
    answer_command_status(var c, ll_cs.OP_CS_CREATE_CONFIG, status)

// LE CS Remove Config: Command Status, and the Config Complete event with Action 0 when the peer has removed the configuration (here alone when the peer's capabilities are
// not known, since the configuration cannot have been made with it).  Command Disallowed while any procedure is enabled, Invalid HCI Command Parameters for a Config_ID with no
// configuration.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cmd_cs_remove_config(var c: Controller)
    let ls = handle_slot(var c, param_handle(var c))
    var cfg = ll_cs_pdu.cfg_new()
    ll_cs_pdu.cfg_remove(var cfg, h4_rx.h4_param(var c.rx, 2))
    var status = cs_gate(var c, ls, false)
    if status == STATUS_SUCCESS and cs_link_running(var c, ls)
        status = STATUS_COMMAND_DISALLOWED
    if status == STATUS_SUCCESS
        let i = cs_claim(var c, ls)
        if i < 0
            status = ll_cs_proc.E_LIMITED
        else
            var cs = ll_cs_proc.cs_new()
            cs_get(var c, i, var cs)
            let known = ll_cs_proc.caps_known(var cs)
            if not ll_cs_proc.cfg_used(var cs, cfg.config_id)
                status = STATUS_INVALID_PARAMETERS
            else if known
                status = cs_peer_gate(var c, ls)
            if status == STATUS_SUCCESS
                status = ctl_cs_config(var c, ls, var cfg, not known)
    answer_command_status(var c, ll_cs.OP_CS_REMOVE_CONFIG, status)

// LE CS Set Channel Classification: the channels the Host found usable.  The map is kept for the connections that follow and sent to the peer on every connection that has
// security started (LL_CS_CHANNEL_MAP_IND, six events ahead).  Command Disallowed within a second of the last, Invalid HCI Command Parameters for a reserved channel or fewer
// than 15.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cmd_cs_classification(var c: Controller)
    var lo = 0
    var hi = 0
    for k in 0..5
        lo = lo | (h4_rx.h4_param(var c.rx, k) << (8 * k))
        hi = hi | (h4_rx.h4_param(var c.rx, 5 + k) << (8 * k))
    var status = STATUS_SUCCESS
    let last = cs_gw(var c, ll_cs_proc.GW_CLASS_T)
    if last != 0 and c.now - (last - 1) < CS_CLASS_GAP_US
        status = STATUS_COMMAND_DISALLOWED
    else if (lo & ~ll_cs_pdu.CHM_LO_ALLOWED) != 0 or (hi & ~ll_cs_pdu.CHM_HI_ALLOWED) != 0 or ll_cs_pdu.chm_count(lo, hi) < ll_cs_proc.CHANNELS_MIN
        status = STATUS_INVALID_PARAMETERS
    else
        cs_gw_put(var c, ll_cs_proc.GW_CLASS_LO, lo)
        cs_gw_put(var c, ll_cs_proc.GW_CLASS_HI, hi)
        cs_gw_put(var c, ll_cs_proc.GW_CLASS_T, c.now + 1)
        for i in 0..ctl_limits.cs_slots()
            let ls = cs_owner(var c, i)
            if ls >= 0 and ctl_conn_active(var c, ls)
                var cs = ll_cs_proc.cs_new()
                cs_get(var c, i, var cs)
                if cs.secured
                    let _s = ctl_cs_channel_map(var c, ls, lo, hi, (c.links[ls].ev_count + ll_cs_proc.EVENT_AHEAD) & 0xFFFF)
    answer_status(var c, ll_cs.OP_CS_SET_CHANNEL_CLASSIFICATION, status)

// The least time between two LE CS Set Channel Classification commands, in microseconds.
const CS_CLASS_GAP_US = 1000000

// The Start the Controller makes of the procedure parameters of the configuration `id` of the record `cs` on the link in slot `ls`: the status 0, 0x12 or 0x0D of
// `ll_cs_hci.start_from_pp`, and the fields in `s`.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_start_of(var c: Controller, ls: Int, var cs: ll_cs_proc.Cs, id: Int,
               var s: ll_cs_pdu.StartPdu) -> Int
    var pp = ll_cs_hci.buf_new()
    ll_cs_proc.pp_load(var cs, id, var pp)
    var en = ll_cs_proc.env_new()
    cs_env(var c, ls, var en)
    ll_cs_hci.start_from_pp(var pp, id, var en, var s)

// LE CS Set Procedure Parameters: what the Host recommends for the procedures of a configuration, kept until the configuration goes.  The Controller picks the scheduling
// the parameters leave open when the procedures are enabled (`ll_cs_hci.start_from_pp`).  Invalid HCI Command Parameters for a configuration that is not there or a value outside
// the range, Rejected Due To Limited Resources for a value the capabilities lack, Command Disallowed while the configuration is enabled, Insufficient Channels for fewer than 15 channels.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cmd_cs_procedure_parameters(var c: Controller)
    let handle = param_handle(var c)
    let ls = handle_slot(var c, handle)
    let id = h4_rx.h4_param(var c.rx, 2)
    var status = cs_gate(var c, ls, false)
    if status == STATUS_SUCCESS
        let i = cs_claim(var c, ls)
        if i < 0
            status = ll_cs_proc.E_LIMITED
        else
            var cs = ll_cs_proc.cs_new()
            cs_get(var c, i, var cs)
            var pp = ll_cs_hci.buf_new()
            ll_cs_hci.buf_take(var c.rx, 3, ll_cs_proc.PP_OCTETS, var pp)
            var s = ll_cs_pdu.start_new()
            var en = ll_cs_proc.env_new()
            cs_env(var c, ls, var en)
            if not ll_cs_proc.cfg_used(var cs, id)
                status = STATUS_INVALID_PARAMETERS
            else if cs.run_open and cs.series_cfg == id
                status = STATUS_COMMAND_DISALLOWED
            else
                status = ll_cs_hci.start_from_pp(var pp, id, var en, var s)
            if status == STATUS_SUCCESS
                var local = ll_cs_pdu.cap_new()
                cs_local(var c, var local)
                var peer = ll_cs_pdu.cap_new()
                if ll_cs_proc.load_caps(var cs, var peer, var c.links[ls].tmp)
                    let k = ll_cs_proc.start_check(var s, ll_cs_proc.cfg_role(var cs, id) == 0, true, var local, var peer, var en)
                    if k == 1
                        status = STATUS_INVALID_PARAMETERS
                    else if k == 2
                        status = ll_cs_proc.E_LIMITED
            if status == STATUS_SUCCESS and ll_cs_proc.filtered_count(var cs, id, en.ev_count) < ll_cs_proc.CHANNELS_MIN
                status = ll_cs_proc.E_INSUFFICIENT_CHANNELS
            if status == STATUS_SUCCESS
                ll_cs_proc.pp_store(var cs, id, var pp)
                cs_put(var c, i, var cs)
    answer_handle(var c, ll_cs.OP_CS_SET_PROCEDURE_PARAMETERS, status, handle)

// LE CS Procedure Enable: Command Status, and the Procedure Enable Complete event when the Start with the peer has completed (enable) or the series has been stopped
// (disable).  A series of one procedure is stopped here, since the peer has no later instance to be told of.  Command Disallowed without procedure parameters, for a configuration
// already enabled, and for a disable of one that is not; Invalid HCI Command Parameters for a configuration that is not there; Insufficient Channels for fewer than 15 channels.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cmd_cs_procedure_enable(var c: Controller)
    let ls = handle_slot(var c, param_handle(var c))
    let id = h4_rx.h4_param(var c.rx, 2)
    let enable = h4_rx.h4_param(var c.rx, 3)
    var status = cs_gate(var c, ls, true)
    if status == STATUS_SUCCESS and enable > 1
        status = STATUS_INVALID_PARAMETERS
    if status == STATUS_SUCCESS
        let i = cs_claim(var c, ls)
        if i < 0
            status = ll_cs_proc.E_LIMITED
        else
            var cs = ll_cs_proc.cs_new()
            cs_get(var c, i, var cs)
            if not ll_cs_proc.cfg_used(var cs, id)
                status = STATUS_INVALID_PARAMETERS
            else if enable == 1
                if not ll_cs_proc.pp_set(var cs, id) or cs.run_open or cs_gw(var c, ll_cs_proc.GW_TEST_ON) != 0
                    status = STATUS_COMMAND_DISALLOWED
                else
                    var s = ll_cs_pdu.start_new()
                    status = cs_start_of(var c, ls, var cs, id, var s)
                    if status == STATUS_SUCCESS and ll_cs_proc.filtered_count(var cs, id, c.links[ls].ev_count) < ll_cs_proc.CHANNELS_MIN
                        status = ll_cs_proc.E_INSUFFICIENT_CHANNELS
                    if status == STATUS_SUCCESS
                        status = ctl_cs_start(var c, ls, var s)
            else if not cs.run_open or cs.series_cfg != id
                status = STATUS_COMMAND_DISALLOWED
            else if cs.series_n == 1 and cs.wait == ll_cs_proc.W_NONE
                ll_cs_proc.stop_series(var cs, id)
                cs_put(var c, i, var cs)
            else
                status = ctl_cs_terminate(var c, ls, id, ll_cs_proc.E_TERMINATED_BY_HOST)
    answer_command_status(var c, ll_cs.OP_CS_PROCEDURE_ENABLE, status)

// LE CS Test: the Controller takes the parameters, keeps them and answers; the test runs when `ctl_cs_test_subevent` is called for it, and its results are the events of a
// connection with the handle 0xFFF.  Invalid HCI Command Parameters for a value outside the range or an override whose data has the wrong length, Unsupported Feature or Parameter
// Value for what this Controller does not take (see `ll_cs_hci.test_check`), Command Disallowed while a test or a procedure is on.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cmd_cs_test(var c: Controller)
    let len = h4_rx.h4_param_len(var c.rx)
    var status = STATUS_SUCCESS
    if len < ll_cs_hci.TEST_OCTETS or len != ll_cs_hci.TEST_OCTETS + h4_rx.h4_param(var c.rx, ll_cs_hci.TEST_OVERRIDE_LEN)
        status = STATUS_INVALID_PARAMETERS
    else if cs_gw(var c, ll_cs_proc.GW_TEST_ON) != 0 or cs_any_running(var c)
        status = STATUS_COMMAND_DISALLOWED
    else
        var t = ll_cs_hci.buf_new()
        var n = len
        if n > ll_cs_hci.BUF_OCTETS
            n = ll_cs_hci.BUF_OCTETS
        ll_cs_hci.buf_take(var c.rx, 0, n, var t)
        var local = ll_cs_pdu.cap_new()
        cs_local(var c, var local)
        status = ll_cs_hci.test_check(var t, var local)
        if status == STATUS_SUCCESS
            for k in 0..ll_cs_hci.BUF_OCTETS
                cs_go_put(var c, ll_cs_proc.GO_TEST + k, t[k] as Int)
            cs_gw_put(var c, ll_cs_proc.GW_TEST_ON, 1)
            cs_gw_put(var c, ll_cs_proc.GW_TEST_N, 0)
            cs_gw_put(var c, ll_cs_proc.GW_TEST_BEGUN, 0)
    answer_status(var c, ll_cs.OP_CS_TEST, status)

// LE CS Test End: Command Status, and the Test End Complete event once the results of the test have gone to the Host.  Command Disallowed when no test is on.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cmd_cs_test_end(var c: Controller)
    var status = STATUS_SUCCESS
    if cs_gw(var c, ll_cs_proc.GW_TEST_ON) == 0
        status = STATUS_COMMAND_DISALLOWED
    else
        cs_gw_put(var c, ll_cs_proc.GW_TEST_ON, 0)
        cs_gw_put(var c, ll_cs_proc.GW_TEST_END, 1)
    answer_command_status(var c, ll_cs.OP_CS_TEST_END, status)

// The security requirements in the eight octets of the command at `at`: the mask, or -1 for a value this Controller cannot enforce (a reserved bit, the 10 ns accuracy, the
// attack detector metric or, in a build without the sequences, the sequence requirement).
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_requirements(var c: Controller, at: Int) -> Int
    var m = 0
    for k in 0..8
        m = m | (h4_rx.h4_param(var c.rx, at + k) << (8 * k))
    if (m & ~ll_cs_hci.sec_supported()) != 0
        return -1
    m

// LE CS Set Security Requirements: the requirements the Controller enforces on the connection.  Command Disallowed while a procedure is enabled, Unsupported Feature or Parameter
// Value for a requirement it cannot enforce.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cmd_cs_security_requirements(var c: Controller)
    let handle = param_handle(var c)
    let ls = handle_slot(var c, handle)
    var status = cs_gate(var c, ls, false)
    if status == STATUS_SUCCESS
        let m = cs_requirements(var c, 2)
        if m < 0
            status = STATUS_UNSUPPORTED_FEATURE
        else if cs_link_running(var c, ls)
            status = STATUS_COMMAND_DISALLOWED
        else
            let i = cs_claim(var c, ls)
            if i < 0
                status = ll_cs_proc.E_LIMITED
            else
                var cs = ll_cs_proc.cs_new()
                cs_get(var c, i, var cs)
                ll_cs_proc.set_sec_req(var cs, m)
                cs_put(var c, i, var cs)
    answer_handle(var c, ll_cs.OP_CS_SET_SECURITY_REQUIREMENTS, status, handle)

// LE CS Set Default Security Requirements: the requirements of the connections that follow.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cmd_cs_default_security_requirements(var c: Controller)
    var status = STATUS_SUCCESS
    if not cs_host_get(var c)
        status = STATUS_COMMAND_DISALLOWED
    else
        let m = cs_requirements(var c, 0)
        if m < 0
            status = STATUS_UNSUPPORTED_FEATURE
        else
            cs_gw_put(var c, ll_cs_proc.GW_DEF_SEC, m)
    answer_status(var c, ll_cs.OP_CS_SET_DEFAULT_SECURITY_REQUIREMENTS, status)

// ── Channel Sounding: the events ────────────────────────────────────
// The Host is owed an event for each bit of `Cs.owed` ([Vol 4] Part E, Sections 7.7.65.39 to 7.7.65.43), and the results of a subevent and the end of a test.  An event that
// the Host's event mask leaves out is not sent and is not owed any longer; one that finds no free slot stays owed.  A slot is always left for the answer to a command, as the
// other events do.

// What `cs_meta` answers for an event the mask leaves out.
const CS_MASKED = -2

// Start the LE Meta event `sub` unless the Host masked it (`CS_MASKED`) or the pool has no slot to spare (`ctl_pool.NO_SLOT`).
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_meta(var c: Controller, sub: Int) -> Int
    if not le_event_enabled(var c, sub)
        return CS_MASKED
    if ctl_pool.pool_free(var c.pool) < 2
        return ctl_pool.NO_SLOT
    meta_begin(var c, sub)

// Append the octet `v` to the event in `slot`.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_octet(var c: Controller, slot: Int, v: Int)
    let _a = ctl_pool.pool_put(var c.pool, slot, v & 0xFF)

// The Read Remote Supported Capabilities Complete event, [v2] when the build has it and the Host unmasked it, otherwise [v1].  The record is the peer's, or zeros when the exchange
// failed.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn ev_cs_caps(var c: Controller, ls: Int, var cs: ll_cs_proc.Cs) -> Bool
    var sub = ll_cs.SUB_CS_READ_REMOTE_SUPPORTED_CAPABILITIES_COMPLETE
    var v2 = false
    if ctl_limits.cs_ipt_on() and le_event_enabled(var c, ll_cs.SUB_CS_READ_REMOTE_SUPPORTED_CAPABILITIES_COMPLETE_V2)
        sub = ll_cs.SUB_CS_READ_REMOTE_SUPPORTED_CAPABILITIES_COMPLETE_V2
        v2 = true
    let slot = cs_meta(var c, sub)
    if slot == ctl_pool.NO_SLOT
        return false
    if slot != CS_MASKED
        cs_octet(var c, slot, cs.st_caps)
        let _b = ctl_pool.pool_put_u16(var c.pool, slot, c.links[ls].handle)
        var rec = ll_cs_hci.buf_new()
        var n = ll_cs_hci.CAPS_V1
        if v2
            n = ll_cs_hci.CAPS_V2
        var cp = ll_cs_pdu.cap_new()
        if cs.st_caps == 0 and ll_cs_proc.load_caps(var cs, var cp, var c.links[ls].tmp)
            let _n = ll_cs_hci.caps_put(var cp, v2, var rec)
        for k in 0..n
            cs_octet(var c, slot, rec[k] as Int)
        event_send(var c, slot)
    cs.owed = cs.owed & ~ll_cs_proc.OWED_CAPS
    true

// The Read Remote FAE Table Complete event: the 72 values of the peer's table, zeros when the request failed.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn ev_cs_fae(var c: Controller, ls: Int, var cs: ll_cs_proc.Cs) -> Bool
    let slot = cs_meta(var c, ll_cs.SUB_CS_READ_REMOTE_FAE_TABLE_COMPLETE)
    if slot == ctl_pool.NO_SLOT
        return false
    if slot != CS_MASKED
        cs_octet(var c, slot, cs.st_fae)
        let _b = ctl_pool.pool_put_u16(var c.pool, slot, c.links[ls].handle)
        for k in 0..ll_cs.CHANNEL_COUNT
            var v = 0
            if cs.st_fae == 0
                v = ll_cs_proc.peer_fae(var cs, k)
            cs_octet(var c, slot, v)
        event_send(var c, slot)
    cs.owed = cs.owed & ~ll_cs_proc.OWED_FAE
    true

// The Security Enable Complete event.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn ev_cs_security(var c: Controller, ls: Int, var cs: ll_cs_proc.Cs) -> Bool
    let slot = cs_meta(var c, ll_cs.SUB_CS_SECURITY_ENABLE_COMPLETE)
    if slot == ctl_pool.NO_SLOT
        return false
    if slot != CS_MASKED
        cs_octet(var c, slot, cs.st_sec)
        let _b = ctl_pool.pool_put_u16(var c.pool, slot, c.links[ls].handle)
        event_send(var c, slot)
    cs.owed = cs.owed & ~ll_cs_proc.OWED_SEC
    true

// The Config Complete event: the 34 octets of the configuration; after the Config_ID and the action, zeros when the configuration was removed or the procedure failed.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn ev_cs_config(var c: Controller, ls: Int, var cs: ll_cs_proc.Cs) -> Bool
    let slot = cs_meta(var c, ll_cs.SUB_CS_CONFIG_COMPLETE)
    if slot == ctl_pool.NO_SLOT
        return false
    if slot != CS_MASKED
        cs_octet(var c, slot, cs.st_cfg)
        let _b = ctl_pool.pool_put_u16(var c.pool, slot, c.links[ls].handle)
        cs_octet(var c, slot, cs.ev_cfg)
        cs_octet(var c, slot, cs.ev_act)
        var cfg = ll_cs_pdu.cfg_new()
        var full = false
        if cs.st_cfg == 0 and cs.ev_act == 1
            full = ll_cs_proc.load_config(var cs, cs.ev_cfg, var cfg, var c.links[ls].tmp)
        var role = 0
        var phy = 0
        var ip1 = 0
        var ip2 = 0
        var fcs = 0
        var pm = 0
        if full
            role = ll_cs_proc.cfg_role(var cs, cs.ev_cfg)
            phy = ll_cs_pdu.sync_phy_to_hci(cfg.sync_phy)
            ip1 = ll_cs.t_ip_us(cfg.t_ip1)
            ip2 = ll_cs.t_ip_us(cfg.t_ip2)
            fcs = ll_cs.t_fcs_us(cfg.t_fcs)
            pm = ll_cs.t_pm_us(cfg.t_pm)
        cs_octet(var c, slot, cfg.main_mode)
        cs_octet(var c, slot, cfg.sub_mode)
        cs_octet(var c, slot, cfg.main_min)
        cs_octet(var c, slot, cfg.main_max)
        cs_octet(var c, slot, cfg.main_rep)
        cs_octet(var c, slot, cfg.mode0_steps)
        cs_octet(var c, slot, role)
        cs_octet(var c, slot, cfg.rtt_type)
        cs_octet(var c, slot, phy)
        for k in 0..5
            cs_octet(var c, slot, cfg.chm_lo >>> (8 * k))
        for k in 0..5
            cs_octet(var c, slot, cfg.chm_hi >>> (8 * k))
        cs_octet(var c, slot, cfg.chm_rep)
        cs_octet(var c, slot, cfg.chsel)
        cs_octet(var c, slot, cfg.c3_shape)
        cs_octet(var c, slot, cfg.c3_jump)
        cs_octet(var c, slot, cfg.ipt)
        cs_octet(var c, slot, ip1)
        cs_octet(var c, slot, ip2)
        cs_octet(var c, slot, fcs)
        cs_octet(var c, slot, pm)
        event_send(var c, slot)
    cs.owed = cs.owed & ~ll_cs_proc.OWED_CFG
    true

// The Procedure Enable Complete event, for the start of a series (`term` false) or for its end at the Host's request (`term` true, State 0).  After the State the
// parameters of the procedures the Start fixed: the antenna configuration, the transmit power, the lengths and intervals.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn ev_cs_procedure(var c: Controller, ls: Int, var cs: ll_cs_proc.Cs, term: Bool) -> Bool
    let slot = cs_meta(var c, ll_cs.SUB_CS_PROCEDURE_ENABLE_COMPLETE)
    if slot == ctl_pool.NO_SLOT
        return false
    if slot != CS_MASKED
        var status = cs.st_proc
        var id = cs.wait_cfg
        if term
            status = cs.st_term
        else if status == 0
            id = cs.series_cfg
        var s = ll_cs_pdu.start_new()
        var on = false
        if not term and status == 0
            on = ll_cs_proc.load_run(var cs, var s, var c.links[ls].tmp)
        cs_octet(var c, slot, status)
        let _b = ctl_pool.pool_put_u16(var c.pool, slot, c.links[ls].handle)
        cs_octet(var c, slot, id)
        cs_octet(var c, slot, ll_cs_proc.b2i(on))
        cs_octet(var c, slot, s.aci)
        var txp = 0
        if on
            txp = cs.def_txp
        cs_octet(var c, slot, txp)
        cs_octet(var c, slot, s.subevent_len)
        cs_octet(var c, slot, s.subevent_len >>> 8)
        cs_octet(var c, slot, s.subevent_len >>> 16)
        cs_octet(var c, slot, s.subevents)
        let _c = ctl_pool.pool_put_u16(var c.pool, slot, s.subevent_interval)
        let _d = ctl_pool.pool_put_u16(var c.pool, slot, s.event_interval)
        let _e = ctl_pool.pool_put_u16(var c.pool, slot, s.proc_interval)
        let _f = ctl_pool.pool_put_u16(var c.pool, slot, s.proc_count)
        let _g = ctl_pool.pool_put_u16(var c.pool, slot, s.max_proc_len)
        event_send(var c, slot)
    if term
        cs.owed = cs.owed & ~ll_cs_proc.OWED_TERM
    else
        cs.owed = cs.owed & ~ll_cs_proc.OWED_PROC
    true

// The events the record `cs` of the link in slot `ls` owes the Host; false when one found no free slot.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_events(var c: Controller, ls: Int, var cs: ll_cs_proc.Cs) -> Bool
    if (cs.owed & ll_cs_proc.OWED_CAPS) != 0 and not ev_cs_caps(var c, ls, var cs)
        return false
    if (cs.owed & ll_cs_proc.OWED_FAE) != 0 and not ev_cs_fae(var c, ls, var cs)
        return false
    if (cs.owed & ll_cs_proc.OWED_SEC) != 0 and not ev_cs_security(var c, ls, var cs)
        return false
    if (cs.owed & ll_cs_proc.OWED_CFG) != 0 and not ev_cs_config(var c, ls, var cs)
        return false
    if (cs.owed & ll_cs_proc.OWED_PROC) != 0 and not ev_cs_procedure(var c, ls, var cs, false)
        return false
    if (cs.owed & ll_cs_proc.OWED_TERM) != 0 and not ev_cs_procedure(var c, ls, var cs, true)
        return false
    true

// The word of the record `i` that says what the Host is owed.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_owed(var c: Controller, i: Int) -> Int
    c.cs_w[i * ll_cs_proc.CS_WORDS + ll_cs_proc.WD_OWED]

// ── Channel Sounding: the results ───────────────────────────────────
// The result of a subevent waits in the octets of the Controller (`GO_RESULT`, the records of the steps in the order of the event: mode, channel, length of the data, data)
// with its header in words, and goes out as an LE CS Subevent Result event and as many LE CS Subevent Result Continue events as its steps need, each at most 255 octets of
// parameters and as soon as the pool has a slot.  One result waits at a time; a second that finds the first still there is reported by its header alone, aborted for
// lack of resources, after it (`GW_NXT_`), and a third is dropped.

// The octets of the parameters of the Result event before the steps and of a Continue event.
const CS_RESULT_HEAD = 16
const CS_CONTINUE_HEAD = 9
const CS_EVENT_PARAMS = 255

// Write the result's header (the words `GW_RES_` or `GW_NXT_`, as `at` says) for a subevent.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_res_head(var c: Controller, nxt: Bool, handle: Int, cfg_id: Int, start_ev: Int, proc: Int,
               pdone: Int, sdone: Int, abort: Int)
    var b = ll_cs_proc.GW_RES_STATE
    if nxt
        b = ll_cs_proc.GW_NXT_STATE
    // The header words of the two are laid out alike: the state, the handle, the configuration, the start event, the procedure counter, then (the pending result only) the
    // frequency compensation and the reference power, and the done statuses and the abort reason.
    cs_gw_put(var c, b, 1)
    cs_gw_put(var c, b + 1, handle)
    cs_gw_put(var c, b + 2, cfg_id)
    cs_gw_put(var c, b + 3, start_ev)
    cs_gw_put(var c, b + 4, proc)
    if nxt
        cs_gw_put(var c, ll_cs_proc.GW_NXT_PDONE, pdone)
        cs_gw_put(var c, ll_cs_proc.GW_NXT_SDONE, sdone)
        cs_gw_put(var c, ll_cs_proc.GW_NXT_ABORT, abort)
    else
        cs_gw_put(var c, ll_cs_proc.GW_RES_PDONE, pdone)
        cs_gw_put(var c, ll_cs_proc.GW_RES_SDONE, sdone)
        cs_gw_put(var c, ll_cs_proc.GW_RES_ABORT, abort)
        cs_gw_put(var c, ll_cs_proc.GW_RES_SENT_STEPS, 0)
        cs_gw_put(var c, ll_cs_proc.GW_RES_SENT_OCT, 0)
        cs_gw_put(var c, ll_cs_proc.GW_RES_CONT, 0)

// The result that follows the pending one, which has a header alone, becomes the pending one.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_res_promote(var c: Controller)
    if cs_gw(var c, ll_cs_proc.GW_NXT_STATE) == 0
        return
    cs_res_head(var c, false, cs_gw(var c, ll_cs_proc.GW_NXT_HANDLE), cs_gw(var c, ll_cs_proc.GW_NXT_CFG), cs_gw(var c, ll_cs_proc.GW_NXT_START),
        cs_gw(var c, ll_cs_proc.GW_NXT_PROC), cs_gw(var c, ll_cs_proc.GW_NXT_PDONE), cs_gw(var c, ll_cs_proc.GW_NXT_SDONE), cs_gw(var c, ll_cs_proc.GW_NXT_ABORT))
    cs_gw_put(var c, ll_cs_proc.GW_RES_FREQ, ll_cs_radio.CS_FREQ_UNAVAILABLE)
    cs_gw_put(var c, ll_cs_proc.GW_RES_RPL, ll_cs_res.RSSI_NA)
    cs_gw_put(var c, ll_cs_proc.GW_RES_NAP, 0)
    cs_gw_put(var c, ll_cs_proc.GW_RES_STEPS, 0)
    cs_gw_put(var c, ll_cs_proc.GW_RES_OCT, 0)
    cs_gw_put(var c, ll_cs_proc.GW_NXT_STATE, 0)

// Send the next event of the pending result: the Result event first, then the Continue events.  False when no slot was free.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_res_event(var c: Controller) -> Bool
    let steps = cs_gw(var c, ll_cs_proc.GW_RES_STEPS)
    let sent = cs_gw(var c, ll_cs_proc.GW_RES_SENT_STEPS)
    let oct = cs_gw(var c, ll_cs_proc.GW_RES_SENT_OCT)
    let first = cs_gw(var c, ll_cs_proc.GW_RES_CONT) == 0
    var head = CS_CONTINUE_HEAD
    var sub = ll_cs.SUB_CS_SUBEVENT_RESULT_CONTINUE
    if first
        head = CS_RESULT_HEAD
        sub = ll_cs.SUB_CS_SUBEVENT_RESULT
    // The steps this event takes: as many as fit in its 255 octets.
    var n = 0
    var used = 0
    var more = true
    while more and sent + n < steps
        let len = 3 + cs_go(var c, ll_cs_proc.GO_RESULT + oct + used + 2)
        if head + used + len > CS_EVENT_PARAMS
            more = false
        else
            used = used + len
            n = n + 1
    let last = sent + n >= steps
    var pdone = 1
    var sdone = 1
    var abort = 0
    if last
        pdone = cs_gw(var c, ll_cs_proc.GW_RES_PDONE)
        sdone = cs_gw(var c, ll_cs_proc.GW_RES_SDONE)
        let a = cs_gw(var c, ll_cs_proc.GW_RES_ABORT)
        if pdone == 0xF
            abort = abort | (a & 0xF)
        if sdone == 0xF
            abort = abort | (a & 0xF0)
    var slot = CS_MASKED
    if le_event_enabled(var c, sub)
        if ctl_pool.pool_free(var c.pool) < 2
            return false
        slot = meta_begin(var c, sub)
        let _a = ctl_pool.pool_put_u16(var c.pool, slot, cs_gw(var c, ll_cs_proc.GW_RES_HANDLE))
        cs_octet(var c, slot, cs_gw(var c, ll_cs_proc.GW_RES_CFG))
        if first
            let _b = ctl_pool.pool_put_u16(var c.pool, slot, cs_gw(var c, ll_cs_proc.GW_RES_START))
            let _c = ctl_pool.pool_put_u16(var c.pool, slot, cs_gw(var c, ll_cs_proc.GW_RES_PROC))
            let _d = ctl_pool.pool_put_u16(var c.pool, slot, cs_gw(var c, ll_cs_proc.GW_RES_FREQ))
            cs_octet(var c, slot, cs_gw(var c, ll_cs_proc.GW_RES_RPL))
        cs_octet(var c, slot, pdone)
        cs_octet(var c, slot, sdone)
        cs_octet(var c, slot, abort)
        cs_octet(var c, slot, cs_gw(var c, ll_cs_proc.GW_RES_NAP))
        cs_octet(var c, slot, n)
        // Step_Mode[i], Step_Channel[i], Step_Data_Length[i] and Step_Data[i] one step after the other.
        for k in 0..used
            cs_octet(var c, slot, cs_go(var c, ll_cs_proc.GO_RESULT + oct + k))
        event_send(var c, slot)
    cs_gw_put(var c, ll_cs_proc.GW_RES_SENT_STEPS, sent + n)
    cs_gw_put(var c, ll_cs_proc.GW_RES_SENT_OCT, oct + used)
    cs_gw_put(var c, ll_cs_proc.GW_RES_CONT, 1)
    if last
        cs_gw_put(var c, ll_cs_proc.GW_RES_STATE, 0)
        cs_res_promote(var c)
    true

// The events of the result that waits, and the end of a test once nothing waits any longer; false when one found no free slot.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_flush_results(var c: Controller) -> Bool
    while cs_gw(var c, ll_cs_proc.GW_RES_STATE) != 0
        if not cs_res_event(var c)
            return false
    if cs_gw(var c, ll_cs_proc.GW_TEST_END) != 0
        let slot = cs_meta(var c, ll_cs.SUB_CS_TEST_END_COMPLETE)
        if slot == ctl_pool.NO_SLOT
            return false
        if slot != CS_MASKED
            cs_octet(var c, slot, 0)
            event_send(var c, slot)
        cs_gw_put(var c, ll_cs_proc.GW_TEST_END, 0)
    true

// Queue the events the procedures and the results owe the Host.  False when one found no free slot, so that the events after it wait.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn flush_cs(var c: Controller) -> Bool
    for i in 0..ctl_limits.cs_slots()
        if cs_owed(var c, i) != 0
            let ls = cs_owner(var c, i)
            var cs = ll_cs_proc.cs_new()
            cs_get(var c, i, var cs)
            let ok = cs_events(var c, ls, var cs)
            cs_put(var c, i, var cs)
            if not ok
                return false
    cs_flush_results(var c)

// ── Channel Sounding: running a subevent ────────────────────────────
// The Controller does not call a `CsRadio` from the radio program: the functions below run one subevent when the caller says it is due, with the radio and the cipher the caller
// holds and the storage of the planning (`ll_cs_plan.CsState`, a generator for each connection and the plan of a subevent) the caller owns, so that an image without Channel
// Sounding holds none of it.  The caller (the arbiter's class of CS7, a test) says when: `ctl_cs_instance` at the start of each procedure instance, `ctl_cs_subevent` for each
// subevent of it, `ctl_cs_test_subevent` for each subevent of an LE CS Test.  Each plans the subevent, hands the plan to the radio, runs it and keeps the result, which goes to
// the Host as events (`flush_cs`).

// What the functions answer: a subevent ran and the procedure goes on, the procedure is complete, there was nothing to run (no connection, no series, no test, or a procedure
// instance that ended for lack of channels), the cipher failed.
const RUN_OK = 0
const RUN_DONE = 1
const RUN_NONE = 2
const RUN_FAULT = 3

// How long a reflector's receiver stays open past the start of a subevent of a procedure for the first packet of the initiator, in microseconds: the clocks of the two ends
// agree to the accuracy of the connection's anchor points, which is tens of microseconds, and the two radios' turn-on times differ by about as much.
const CS_LISTEN_US = 2000

// The transmit power the plan names for an octet that `ll_cs_hci.dbm_ok` allowed, in dBm: a signed value from -127 to +20.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_tx_dbm(octet: Int) -> Int
    if octet >= 0x80
        return octet - 0x100
    octet

// Keep a result with no steps for a procedure instance that ended without running a subevent: the procedures after it are aborted for `abort` (the reason of the low nibble).
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_abort_result(var c: Controller, handle: Int, cfg_id: Int, ev: Int, proc: Int, abort: Int)
    if not le_event_enabled(var c, ll_cs.SUB_CS_SUBEVENT_RESULT)
        return
    if cs_gw(var c, ll_cs_proc.GW_RES_STATE) != 0
        if cs_gw(var c, ll_cs_proc.GW_NXT_STATE) == 0
            cs_res_head(var c, true, handle, cfg_id, ev, proc, 0xF, 0, abort)
        else
            c.dropped_events = c.dropped_events + 1
        return
    cs_res_head(var c, false, handle, cfg_id, ev, proc, 0xF, 0, abort)
    cs_gw_put(var c, ll_cs_proc.GW_RES_FREQ, ll_cs_radio.CS_FREQ_UNAVAILABLE)
    cs_gw_put(var c, ll_cs_proc.GW_RES_RPL, ll_cs_res.RSSI_NA)
    cs_gw_put(var c, ll_cs_proc.GW_RES_NAP, 0)
    cs_gw_put(var c, ll_cs_proc.GW_RES_STEPS, 0)
    cs_gw_put(var c, ll_cs_proc.GW_RES_OCT, 0)

// Keep the result of the subevent in `plan` for the Host: the record of each step, from the radio's measurements (`ran`, when the radio ran the plan) and the plan, and the header.
// `pdone` and `sdone` are the done statuses of the last event, `abort` the reason in the nibbles of the Abort_Reason octet.  A result that finds one waiting is kept by its header
// alone, aborted for lack of resources (the subevent abort reason 3), and one that finds that one waiting too is dropped and counted.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_store<S: CsRadio[s]>(var c: Controller, var air: S, var plan: ll_cs_plan.CsSubevent,
                           ran: Bool, var raw: ll_cs_radio.CsRaw, pct: Bool, handle: Int,
                           cfg_id: Int, start_ev: Int, proc: Int, pdone: Int, sdone: Int,
                           abort: Int) [s]
    if not le_event_enabled(var c, ll_cs.SUB_CS_SUBEVENT_RESULT)
        return
    if cs_gw(var c, ll_cs_proc.GW_RES_STATE) != 0
        if cs_gw(var c, ll_cs_proc.GW_NXT_STATE) == 0
            cs_res_head(var c, true, handle, cfg_id, start_ev, proc, pdone, 0xF, 0x30 | (abort & 0xF))
        else
            c.dropped_events = c.dropped_events + 1
        return
    cs_res_head(var c, false, handle, cfg_id, start_ev, proc, pdone, sdone, abort)
    var cal = ll_cs_radio.cs_cal_none()
    if ran
        cal = air.cs_cal()
    var d = ll_cs_res.data_new()
    var pos = 0
    var nap = 0
    for j in 0..plan.n
        let mode = plan.steps[j].mode as Int
        cs_go_put(var c, ll_cs_proc.GO_RESULT + pos, mode)
        cs_go_put(var c, ll_cs_proc.GO_RESULT + pos + 1, plan.steps[j].ch as Int)
        var sr = ll_cs_radio.cs_step_raw_none()
        var done = false
        if ran
            done = air.cs_step_raw(j, var sr) and sr.done
        var len = 0
        if done
            len = ll_cs_res.step_data(var d, var plan.head, var plan.steps[j], var sr, var cal, pct)
            for k in 0..len
                cs_go_put(var c, ll_cs_proc.GO_RESULT + pos + 3 + k, d[k] as Int)
        cs_go_put(var c, ll_cs_proc.GO_RESULT + pos + 2, len)
        pos = pos + 3 + len
        if mode >= 2
            nap = plan.head.n_ap as Int
    var freq = ll_cs_radio.CS_FREQ_UNAVAILABLE
    if ran and (plan.head.role as Int) == ll_cs_radio.CS_ROLE_INITIATOR
        freq = raw.ffo as Int
    var rpl = ll_cs_res.RSSI_NA
    if ran and nap > 0
        rpl = raw.rpl_dbm as Int & 0xFF
    cs_gw_put(var c, ll_cs_proc.GW_RES_FREQ, freq)
    cs_gw_put(var c, ll_cs_proc.GW_RES_RPL, rpl)
    cs_gw_put(var c, ll_cs_proc.GW_RES_NAP, nap)
    cs_gw_put(var c, ll_cs_proc.GW_RES_STEPS, plan.n)
    cs_gw_put(var c, ll_cs_proc.GW_RES_OCT, pos)

// The first half of a subevent: plan it for the configuration `cfg` and the role `role` into `st.plan` and complete the head with what is not the configuration's: the initiator
// phase tone flag `ipt`, the transmit power `tx` in dBm, the antenna selection `ant` of CS_SYNC and the peer's frequency actuation error table `fae` (empty when the Controller
// has none).  `gen` is the index of the generator.  The answer is the code of `ll_cs_plan.plan_subevent`, which `cs_run_part` takes.  The planning draws the channels and the
// access addresses of every step from the cipher, which takes milliseconds on a radio's chip: the radio program plans a subevent while the radio is idle and runs it at its time.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_plan_part<C: Cipher[e]>(var c: Controller, var cc: C, var st: ll_cs_plan.CsState, gen: Int,
                              var cfg: ll_cs_plan.CsCfg, role: Int, ipt: Bool, tx: Int, ant: Int,
                              var fae: Vec[i8; ll_cs_radio.CS_FAE_COUNT], anchor_ns: Int) -> Int [e]
    let code = ll_cs_plan.plan_subevent(var cc, var st.gens[gen], var cfg, var st.plan, role, anchor_ns)
    st.plan.code = code
    if code == ll_cs_plan.PLAN_FAULT
        return code
    st.plan.head.ipt = ipt
    st.plan.head.tx_dbm = tx as i8
    st.plan.head.ant_sync = ant as u8
    st.plan.head.fae_peer = fae
    code

// The second half: hand the plan in `st.plan` (planned with the code `code`) to the radio to run from `t0_us`, run it and keep the result for the Host.  `ls` is the link
// (-1 for a test) and `proc_last` says the procedure ends with this subevent whatever the plan says.  `window_us` is how long a reflector's receiver stays open past `t0_us` for the
// first packet of the initiator (0 for a test, whose peer starts when its Host says so).  The answer is `RUN_DONE` or `RUN_OK`.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_run_part<S: CsRadio[s]>(var c: Controller, var air: S, var st: ll_cs_plan.CsState, gen: Int, code: Int,
                              test: Bool, proc_last: Bool, pct: Bool, handle: Int, cfg_id: Int,
                              start_ev: Int, proc: Int, t0_us: Int, window_us: Int, skip: Bool) -> Int [s]
    if test
        st.plan.head.test = 1
    st.plan.head.window_us = window_us as u32
    var raw = ll_cs_radio.cs_raw_new()
    // A subevent that is skipped is not handed to the radio: it is reported as the one that arrives too late for it (a scheduling conflict).
    var armed = ll_cs_radio.CS_LATE
    if not skip
        armed = ll_cs_plan.plan_arm(var air, var st.plan, t0_us)
    var status = armed
    if armed == ll_cs_radio.CS_OK
        status = air.cs_run(var raw)
    let ran = armed == ll_cs_radio.CS_OK and (status == ll_cs_radio.CS_OK or status == ll_cs_radio.CS_ABORTED)
    let complete = st.gens[gen].done or proc_last or code == ll_cs_plan.PLAN_NO_FIT
    var pdone = 1
    if complete
        pdone = 0
    var sdone = 0
    var abort = 0
    if armed != ll_cs_radio.CS_OK
        sdone = 0xF
        if armed == ll_cs_radio.CS_LATE or armed == ll_cs_radio.CS_RESOURCES
            abort = 0x30
        else
            abort = 0xF0
    else if status != ll_cs_radio.CS_OK
        sdone = 0xF
        abort = (raw.abort as Int & 0xF) << 4
        if abort == 0
            abort = 0xF0
    // cov: skip — the first step is a mode 0 step of at most 483 microseconds and a subevent is at least 1250 microseconds long, so no command makes a plan that does not fit
    if code == ll_cs_plan.PLAN_NO_FIT
        // Not even the first step fits in the subevent: the procedures that follow are aborted for no reason the specification names.
        pdone = 0xF
        abort = 0xF
    cs_store(var c,
        var air,
        var st.plan,
        ran,
        var raw,
        pct,
        handle,
        cfg_id,
        start_ev,
        proc,
        pdone,
        sdone,
        abort)
    if complete
        return RUN_DONE
    RUN_OK

// Plan the subevent for the configuration `cfg` and the role `role` into `st.plan`, hand it to the radio, run it and keep the result for the Host: the part `ctl_cs_subevent`
// and `ctl_cs_test_subevent` share.  `gen` is the index of the generator, `ls` the link (-1 for a test) and `proc_last` says the procedure ends with this subevent whatever the
// plan says.  The answer is `RUN_FAULT`, `RUN_DONE` or `RUN_OK`.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_run<S: CsRadio[s], C: Cipher[e]>(var c: Controller, var air: S, var cc: C,
                                       var st: ll_cs_plan.CsState, gen: Int,
                                       var cfg: ll_cs_plan.CsCfg, role: Int, ipt: Bool, tx: Int,
                                       test: Bool, proc_last: Bool, pct: Bool, handle: Int,
                                       cfg_id: Int, start_ev: Int, proc: Int, t0_us: Int,
                                       anchor_ns: Int, ant: Int,
                                       var fae: Vec[i8; ll_cs_radio.CS_FAE_COUNT]) -> Int [s, e]
    let code = cs_plan_part(var c, var cc, var st, gen, var cfg, role, ipt, tx, ant, var fae, anchor_ns)
    if code == ll_cs_plan.PLAN_FAULT
        return RUN_FAULT
    // Only a test runs the planning and the subevent in one call, and its peer starts when its Host says so: the receiver waits for it.
    cs_run_part(var c, var air, var st, gen, code, test, proc_last, pct, handle, cfg_id, start_ev, proc, t0_us, 0, false)

// A procedure instance of the series of the connection in slot `ls` begins in the connection event `ev`: the channel map of a Channel Map Update whose instant has come takes
// effect, CSProcCount is incremented (except for the first instance after Security Start), and the generator of the connection is keyed from the values of the Security Start
// procedure (the first instance) and ratcheted (the later ones).  An instance that finds fewer than 15 channels after the filtering ends the series and is reported to the Host.
// The answer is `RUN_OK`, `RUN_NONE` or `RUN_FAULT`.
@when(noble_controller_config.CTL_CS > 0)
pub @tier(embedded)
fn ctl_cs_instance<C: Cipher[e]>(var c: Controller, var cc: C, var st: ll_cs_plan.CsState, ls: Int,
                                 ev: Int) -> Int [e]
    let i = cs_find(var c, ls)
    if i < 0
        return RUN_NONE
    var cs = ll_cs_proc.cs_new()
    cs_get(var c, i, var cs)
    let first = cs.fresh
    let r = ll_cs_proc.instance_begin(var cs, ev)
    if r != 0
        if r == ll_cs_proc.E_INSUFFICIENT_CHANNELS
            cs_abort_result(var c, c.links[ls].handle, cs.series_cfg, ev, cs.proc_count, 0x2)
        cs_put(var c, i, var cs)
        return RUN_NONE
    var ok = true
    if first
        var iv: Vec[u8; 16] = Vec.new()
        var pv: Vec[u8; 16] = Vec.new()
        var nc: Vec[u8; 8] = Vec.new()
        for k in 0..16
            let _a = iv.push(ll_cs_proc.cs_iv(var cs, 15 - k) as u8)
            let _b = pv.push(ll_cs_proc.cs_pv(var cs, 15 - k) as u8)
        for k in 0..8
            let _c = nc.push(ll_cs_proc.cs_in(var cs, 7 - k) as u8)
        ok = ll_cs_plan.gen_instantiate(var cc, var st.gens[i], var iv, var nc, var pv)
    if ok
        ok = ll_cs_plan.gen_begin_procedure(var cc, var st.gens[i])
    cs_put(var c, i, var cs)
    if ok
        return RUN_OK
    RUN_FAULT

// The configuration of the planning for the series that runs in the record `i` of the link in slot `ls`, read into `cs`, `local` (the capabilities of this end) and `cfg`:
// the answer is the configuration's IPT flag (0 or 1), -1 when no subevent can be planned (the record has no series open, or its generator has finished the procedure).
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_series_cfg(var c: Controller, var st: ll_cs_plan.CsState, ls: Int, i: Int, var cs: ll_cs_proc.Cs,
                 var local: ll_cs_pdu.CapPdu, var cfg: ll_cs_plan.CsCfg) -> Int
    cs_get(var c, i, var cs)
    if not cs.run_open or st.gens[i].done
        return -1
    cs_local(var c, var local)
    ll_cs_hci.plan_cfg(var cs, var local, var c.links[ls].tmp, var cfg)

// The peer's frequency actuation error table of the record `cs`, when the Controller has it (LL_CS_FAE_RSP or LE CS Write Cached Remote FAE Table), as the plan carries it;
// empty when it has none.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_peer_table(var cs: ll_cs_proc.Cs) -> Vec[i8; ll_cs_radio.CS_FAE_COUNT]
    var fae: Vec[i8; ll_cs_radio.CS_FAE_COUNT] = Vec.new()
    if cs.fae_known
        for k in 0..ll_cs_radio.CS_FAE_COUNT
            let _f = fae.push(ll_cs_proc.peer_fae(var cs, k) as i8)
    fae

// Whether the series of procedures of the connection in slot `ls` is open: a Start completed and its procedures are not all done.
@when(noble_controller_config.CTL_CS > 0)
pub @tier(embedded)
fn ctl_cs_series_open(var c: Controller, ls: Int) -> Bool
    let i = cs_find(var c, ls)
    if i < 0
        return false
    c.cs_w[i * ll_cs_proc.CS_WORDS + ll_cs_proc.WD_RUN_OPEN] != 0

// The schedule of the procedures of one connection, from the Start that completed:
//
//   conn_event            the connection event the first CS event is offset from (connEventCount of the Start)
//   offset_us             the time from that event's anchor point to the first subevent
//   event_interval        connection events between the starts of two CS events
//   subevents             subevents in a CS event
//   subevent_interval_us  the time between the starts of two subevents of an event
//   subevent_len_us       the longest a subevent lasts
//   proc_interval         connection events between the starts of two procedures, 0 when the series is one procedure
//   proc_count            procedures in the series, 0 for no end
//   proc_us               the extent of a procedure at the longest
//   interval_us           the connection interval
@when(noble_controller_config.CTL_CS > 0)
@value
struct CsSched
    conn_event: Int
    offset_us: Int
    event_interval: Int
    subevents: Int
    subevent_interval_us: Int
    subevent_len_us: Int
    proc_interval: Int
    proc_count: Int
    proc_us: Int
    interval_us: Int

// A schedule of nothing: zero everywhere.
@when(noble_controller_config.CTL_CS > 0)
pub @tier(embedded)
@no_alloc
fn cs_sched_new() -> CsSched
    CsSched { conn_event: 0, offset_us: 0, event_interval: 0, subevents: 0, subevent_interval_us: 0, subevent_len_us: 0, proc_interval: 0, proc_count: 0, proc_us: 0, interval_us: 0 }

// Read the schedule of the series of the connection in slot `ls` into `out`; false when no series is open.
@when(noble_controller_config.CTL_CS > 0)
pub @tier(embedded)
fn ctl_cs_sched(var c: Controller, ls: Int, var out: CsSched) -> Bool
    let i = cs_find(var c, ls)
    if i < 0
        return false
    var cs = ll_cs_proc.cs_new()
    cs_get(var c, i, var cs)
    var s = ll_cs_pdu.start_new()
    if not ll_cs_proc.load_run(var cs, var s, var c.links[ls].tmp)
        return false
    out.conn_event = s.conn_event
    out.offset_us = s.offset_min
    out.event_interval = s.event_interval
    out.subevents = s.subevents
    out.subevent_interval_us = s.subevent_interval * ll_cs_proc.UNIT_US
    out.subevent_len_us = s.subevent_len
    out.proc_interval = s.proc_interval
    out.proc_count = s.proc_count
    out.proc_us = s.max_proc_len * ll_cs_proc.UNIT_US
    out.interval_us = ll_link.interval_us(var c.links[ls])
    true

// The time of the anchor point of the connection event with the counter `ev` of the connection in slot `ls`, on the radio's timebase, as the schedule of the link stands between
// two events: the event the link is to run next is due at `Link.due`, and the others are whole intervals before or after it.  -2 when a Connection Update has its instant between
// the event and the next one, which moves the anchors in a way the caller cannot know.  (`ll_link.link_event_time` answers for the event under way, which the radio program
// that polls between events is never in.)
@when(noble_controller_config.CTL_CS > 0)
pub @tier(embedded)
fn ctl_cs_event_time(var c: Controller, ls: Int, ev: Int) -> Int
    var d = (ev - c.links[ls].ev_count) & 0xFFFF
    if d >= 0x8000
        d = d - 0x10000
    if d > 0 and c.links[ls].upd_pending and ((c.links[ls].upd_instant - c.links[ls].ev_count) & 0xFFFF) <= d
        return -2
    c.links[ls].due + d * ll_link.interval_us(var c.links[ls])

// Plan the next subevent of the procedure instance of the connection in slot `ls` into `st.plan`, for a subevent that begins `anchor_ns` after the start of the procedure; the
// radio runs it later (`ctl_cs_subevent_run`).  `next_ns` is where the subevent after it would begin, or -1 when the caller does not know: a subevent after which the next would
// begin at or past the longest the procedure may last (Max_Procedure_Len) is the last of the procedure, which its result says.  The answer is `RUN_OK` (planned), `RUN_NONE` (no
// series is open, or the procedure is complete) or `RUN_FAULT` (the cipher failed).
@when(noble_controller_config.CTL_CS > 0)
pub @tier(embedded)
fn ctl_cs_subevent_plan<C: Cipher[e]>(var c: Controller, var cc: C, var st: ll_cs_plan.CsState, ls: Int, anchor_ns: Int, next_ns: Int) -> Int [e]
    let i = cs_find(var c, ls)
    if i < 0
        return RUN_NONE
    var local = ll_cs_pdu.cap_new()
    var cfg = ll_cs_plan.cfg_new()
    var cs = ll_cs_proc.cs_new()
    let ipt = cs_series_cfg(var c, var st, ls, i, var cs, var local, var cfg)
    if ipt < 0
        return RUN_NONE
    var fae = cs_peer_table(var cs)
    let code = cs_plan_part(var c, var cc, var st, i, var cfg, ll_cs_proc.cfg_role(var cs, cs.series_cfg), ipt == 1, cs_tx_dbm(cs.def_txp), cs.def_ant, var fae, anchor_ns)
    if code == ll_cs_plan.PLAN_FAULT
        return RUN_FAULT
    if next_ns >= 0 and next_ns >= cfg.proc_len_us * 1000
        ll_cs_plan.gen_finish(var st.gens[i])
    RUN_OK

// Run the subevent that `ctl_cs_subevent_plan` planned, from `t0_us` on the radio's timebase, anchored to the connection event `ev` (Start_ACL_Conn_Event_Counter of the
// result), and keep its result for the Host.  A start that is too near for the radio to arm is reported as a subevent aborted for a scheduling conflict.  The series ends with the
// last procedure the Start named.  The answer is `RUN_OK` (more subevents follow), `RUN_DONE` (the procedure is complete) or `RUN_NONE`.
@when(noble_controller_config.CTL_CS > 0)
pub @tier(embedded)
fn ctl_cs_subevent_run<S: CsRadio[s]>(var c: Controller, var air: S, var st: ll_cs_plan.CsState, ls: Int, ev: Int, t0_us: Int) -> Int [s]
    cs_subevent_finish(var c, var air, var st, ls, ev, t0_us, false)

// Give up the subevent that `ctl_cs_subevent_plan` planned without handing it to the radio, because the arbiter has no room for it (`ctl_cs_fits`) or its connection event is not
// a subrated event: the Host reads it as a subevent aborted for a scheduling conflict (Subevent_Abort_Reason 0x3), and the generator, which the plan advanced, stays in step with
// the peer's.  The answer is that of `ctl_cs_subevent_run`.
@when(noble_controller_config.CTL_CS > 0)
pub @tier(embedded)
fn ctl_cs_subevent_skip<S: CsRadio[s]>(var c: Controller, var air: S, var st: ll_cs_plan.CsState, ls: Int, ev: Int) -> Int [s]
    cs_subevent_finish(var c, var air, var st, ls, ev, 0, true)

@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_subevent_finish<S: CsRadio[s]>(var c: Controller, var air: S, var st: ll_cs_plan.CsState, ls: Int, ev: Int, t0_us: Int, skip: Bool) -> Int [s]
    let i = cs_find(var c, ls)
    if i < 0
        return RUN_NONE
    var cs = ll_cs_proc.cs_new()
    cs_get(var c, i, var cs)
    if not cs.run_open
        return RUN_NONE
    var local = ll_cs_pdu.cap_new()
    cs_local(var c, var local)
    let last = cs.series_n != 0 and ((cs.proc_count - cs.series_start + 1) & 0xFFFF) >= cs.series_n
    let r = cs_run_part(var c, var air, var st, i, st.plan.code, false, false, local.sounding_pct == 1, c.links[ls].handle, cs.series_cfg, ev, cs.proc_count, t0_us, CS_LISTEN_US, skip)
    if r == RUN_DONE and last
        ll_cs_proc.series_done(var cs)
        cs_put(var c, i, var cs)
    r

// The next subevent of the procedure instance of the connection in slot `ls` runs: it starts at `t0_us` on the radio's timebase, lies `anchor_ns` after the start of the
// procedure, and is anchored to the connection event `ev` (Start_ACL_Conn_Event_Counter of the result).  The series ends with the last procedure the Start named.  The answer is
// `RUN_OK` (more subevents follow), `RUN_DONE` (the procedure is complete), `RUN_NONE` or `RUN_FAULT`.
@when(noble_controller_config.CTL_CS > 0)
pub @tier(embedded)
fn ctl_cs_subevent<S: CsRadio[s], C: Cipher[e]>(var c: Controller, var air: S, var cc: C,
                                                var st: ll_cs_plan.CsState, ls: Int, ev: Int,
                                                t0_us: Int, anchor_ns: Int) -> Int [s, e]
    let planned = ctl_cs_subevent_plan(var c, var cc, var st, ls, anchor_ns, -1)
    if planned != RUN_OK
        return planned
    ctl_cs_subevent_run(var c, var air, var st, ls, ev, t0_us)

// The next subevent of the LE CS Test the Host started runs, starting at `t0_us`.  The first call keys the generator with the key of zeros and the test's nonce.  The test ends
// when its procedure is complete or Max_Num_Subevents subevents have run (one when Subevent_Interval is zero), and its result events carry the handle 0xFFF.  The answer is as
// that of `ctl_cs_subevent`; `RUN_NONE` when no test is on.
@when(noble_controller_config.CTL_CS > 0)
pub @tier(embedded)
fn ctl_cs_test_subevent<S: CsRadio[s], C: Cipher[e]>(var c: Controller, var air: S, var cc: C,
                                                     var st: ll_cs_plan.CsState,
                                                     t0_us: Int) -> Int [s, e]
    if cs_gw(var c, ll_cs_proc.GW_TEST_ON) == 0
        return RUN_NONE
    var t = ll_cs_hci.buf_new()
    for k in 0..ll_cs_hci.BUF_OCTETS
        t[k] = cs_go(var c, ll_cs_proc.GO_TEST + k) as u8
    if cs_gw(var c, ll_cs_proc.GW_TEST_BEGUN) == 0
        ll_cs_plan.gen_instantiate_test(var st.gens[0], ll_cs_hci.g16(var t, ll_cs_hci.TEST_NONCE))
        // cov: skip — the first procedure of a generator uses its key as it is, so the cipher is not asked and cannot fail
        if not ll_cs_plan.gen_begin_procedure(var cc, var st.gens[0])
            return RUN_FAULT
        cs_gw_put(var c, ll_cs_proc.GW_TEST_BEGUN, 1)
    var local = ll_cs_pdu.cap_new()
    cs_local(var c, var local)
    var cfg = ll_cs_plan.cfg_new()
    ll_cs_hci.test_cfg(var t, var cfg)
    let n = cs_gw(var c, ll_cs_proc.GW_TEST_N) + 1
    cs_gw_put(var c, ll_cs_proc.GW_TEST_N, n)
    var limit = ll_cs_hci.g8(var t, ll_cs_hci.TEST_MAX_SUB)
    if limit != 0 and ll_cs_hci.g16(var t, ll_cs_hci.TEST_SUB_INT) == 0
        limit = 1
    let stop = limit != 0 and n >= limit
    // Transmit_Power_Level: a level in dBm, or 0x7E for the least power and 0x7F for the most the radio has (the plan names -127 and +20 dBm, and the radio takes the nearest).
    var tx = cs_tx_dbm(ll_cs_hci.g8(var t, ll_cs_hci.TEST_POWER))
    if ll_cs_hci.g8(var t, ll_cs_hci.TEST_POWER) == 0x7E
        tx = -127
    else if ll_cs_hci.g8(var t, ll_cs_hci.TEST_POWER) == 0x7F
        tx = 20
    // A test has no peer to ask for a table: the radio assumes zero.
    var fae: Vec[i8; ll_cs_radio.CS_FAE_COUNT] = Vec.new()
    let r = cs_run(var c, var air, var cc, var st, 0, var cfg, ll_cs_hci.g8(var t, ll_cs_hci.TEST_ROLE), ll_cs_hci.g8(var t, ll_cs_hci.TEST_ENH) == 1, tx, true, stop,
        local.sounding_pct == 1, ll_cs_proc.HANDLE_TEST, 0, 0, 0, t0_us, 0, ll_cs_hci.g8(var t, ll_cs_hci.TEST_ANT), var fae)
    if r == RUN_DONE
        cs_gw_put(var c, ll_cs_proc.GW_TEST_ON, 0)
    r

// The subevents of the LE CS Test the Host started that have run: 0 for a test that has not begun, -1 when no test is on.  The radio program schedules the subevents from it
// (`ll_cs_air.nv`).
@when(noble_controller_config.CTL_CS > 0)
pub @tier(embedded)
fn ctl_cs_test_count(var c: Controller) -> Int
    if cs_gw(var c, ll_cs_proc.GW_TEST_ON) == 0
        return -1
    cs_gw(var c, ll_cs_proc.GW_TEST_N)

// The time between the starts of two subevents of the LE CS Test in progress, in microseconds (Subevent_Interval, units of 625 microseconds); 0 for a test of one subevent.
@when(noble_controller_config.CTL_CS > 0)
pub @tier(embedded)
fn ctl_cs_test_interval_us(var c: Controller) -> Int
    (cs_go(var c, ll_cs_proc.GO_TEST + ll_cs_hci.TEST_SUB_INT) | (cs_go(var c, ll_cs_proc.GO_TEST + ll_cs_hci.TEST_SUB_INT + 1) << 8)) * 625

// The length of a subevent of the LE CS Test in progress, in microseconds (Subevent_Len).
@when(noble_controller_config.CTL_CS > 0)
pub @tier(embedded)
fn ctl_cs_test_len_us(var c: Controller) -> Int
    cs_go(var c, ll_cs_proc.GO_TEST + ll_cs_hci.TEST_SUB_LEN) | (cs_go(var c, ll_cs_proc.GO_TEST + ll_cs_hci.TEST_SUB_LEN + 1) << 8) | (cs_go(var c, ll_cs_proc.GO_TEST + ll_cs_hci.TEST_SUB_LEN + 2) << 16)

// Whether the result of a subevent still waits to go to the Host: a subevent that ran before it has gone keeps its result apart from the next.
@when(noble_controller_config.CTL_CS > 0)
pub @tier(embedded)
fn ctl_cs_result_waiting(var c: Controller) -> Bool
    cs_gw(var c, ll_cs_proc.GW_RES_STATE) != 0

// ── Channel Sounding: the arbiter and the placing ───────────────────
// A subevent is booked in the arbiter as `[t0 - lead, t0 + length + finish]` in one of two classes (`ll_arb.cs_class`), tested whole against the classes above it before the radio is
// armed, and given up as a subevent aborted for a scheduling conflict when it does not fit.  The Start is placed beforehand among the connection events and the streams the
// Controller serves (`ll_cs_fit`, filled by `cs_busy` into the environment of the procedures), and the radio program holds the HCI stream back for `ll_cs.QUIET_US` after a run.

// The time before the start of a subevent that the radio is booked: the program's work (`ll_cs.WORK_US`) and the radio's arming lead (`CsTiming.arm_lead_us`, read by `ctl_cs_radio_init`).
@when(noble_controller_config.CTL_CS > 0)
pub @tier(embedded)
fn ctl_cs_lead_us(var c: Controller) -> Int
    ll_cs.WORK_US + cs_gw(var c, ll_cs_proc.GW_ARM_LEAD)

// Add the booking of the periodic events of the link in slot `slot` to `b`: its subrated events, from the first at or after the one it runs next; `hard` is set for the link
// that carries the procedure.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_busy_link(var c: Controller, slot: Int, hard: Bool, var en: ll_cs_proc.Env)
    if not (ll_link.link_live(var c.links[slot]) and not c.links[slot].closing)
        return
    let iv = ll_link.interval_us(var c.links[slot])
    let factor = c.links[slot].sub_factor as Int
    let res = c.links[slot].sub_res as Int
    var d = 0
    for k in 0..factor
        if ll_sub.on_grid((c.links[slot].ev_count + k) & 0xFFFF, res, factor)
            d = k
            break
    ll_cs_proc.fit_add(var en, c.links[slot].due + d * iv, iv * factor, ll_cs.CONN_FIT_US, c.arb.lead + ll_radio.ACL_EXTRA_US, hard)

// Fill `b` with what the Controller serves beside Channel Sounding, seen from the link in slot `ls`: the subrated events of every link, the events of the connected isochronous
// streams and of the broadcast groups.  The record is `ll_cs_fit.busy_link`'s for the carrying link.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_busy(var c: Controller, ls: Int, var en: ll_cs_proc.Env)
    ll_cs_proc.fit_link(var en, c.links[ls].due, c.links[ls].ev_count, ll_link.interval_us(var c.links[ls]), c.links[ls].sub_factor as Int, c.links[ls].sub_res as Int,
        ctl_cs_lead_us(var c), ll_cs.FINISH_US, ll_cs.PLAN_FIT_US)
    for slot in 0..noble_controller_config.CTL_LINKS
        cs_busy_link(var c, slot, slot == ls, var en)
    if ctl_limits.iso_on()
        for i in 0..ctl_limits.cis_slots()
            if cis_running(var c, i)
                var first = c.cis[i].anchor
                let len = ll_iso.event_len_us(var c.cis[i]) + CIS_BOOK_MARGIN_US
                if first + len <= c.now
                    first = first + ll_iso.iso_us(var c.cis[i])
                ll_cs_proc.fit_add(var en, first, ll_iso.iso_us(var c.cis[i]), len, c.arb.lead, true)
    if ctl_limits.big_on()
        for g in 0..ctl_limits.big_slots()
            if big_runs(var c, g)
                ll_cs_proc.fit_add(var en, ctl_big_start(var c, g), ll_big.iso_us(var c.bigs[g]), ctl_big_book_us(var c, g), c.arb.lead, true)

// Whether the connection event `ev` of the link in slot `ls` is a subrated event of the grid in force, the only kind a Channel Sounding event may be offset from.
@when(noble_controller_config.CTL_CS > 0)
pub @tier(embedded)
fn ctl_cs_event_on_grid(var c: Controller, ls: Int, ev: Int) -> Bool
    ll_link.sub_grid(var c.links[ls], ev)

// Whether a subevent that starts at `t0` and lasts `len` microseconds may run: the arbiter has no booking of the classes above its own inside the stretch it holds the radio,
// and the connection events of the link in slot `ls` that carries the procedure (-1 for a test) are not inside it either.  `first` says it is the first subevent of an event, and
// `under_way` that an earlier subevent of the event ran.  The bookings are made again first, as the radio program's turn that ran a connection event has not asked the arbiter
// what is due next.  A build whose arbiter has no class for the feature never fits.
@when(noble_controller_config.CTL_CS > 0)
pub @tier(embedded)
fn ctl_cs_fits(var c: Controller, ls: Int, first: Bool, under_way: Bool, now: Int, t0: Int, len: Int) -> Bool
    let _next = ctl_ll_next_start(var c)
    var link_cls = -1
    if ls >= 0
        link_cls = slot_class(ls)
    ll_arb.arb_cs_fits(var c.arb, ll_arb.cs_class(first, under_way), link_cls, now, t0, ctl_cs_lead_us(var c), len, ll_cs.FINISH_US)

// Book the radio for the subevent that starts at `t0` and lasts `len`, in the class `ll_arb.cs_class` gives, and hold the HCI stream back until `ll_cs.QUIET_US` after `now`.
@when(noble_controller_config.CTL_CS > 0)
pub @tier(embedded)
fn ctl_cs_book(var c: Controller, first: Bool, under_way: Bool, now: Int, t0: Int, len: Int)
    ll_arb.arb_book_cs(var c.arb, ll_arb.cs_class(first, under_way), t0, ctl_cs_lead_us(var c), len, ll_cs.FINISH_US)
    cs_gw_put(var c, ll_cs_proc.GW_QUIET, t0 + len + ll_cs.QUIET_US)

// The booking of the subevent is over: both classes are cancelled.
@when(noble_controller_config.CTL_CS > 0)
pub @tier(embedded)
fn ctl_cs_unbook(var c: Controller)
    ll_arb.arb_cancel(var c.arb, ll_arb.class_cs())
    ll_arb.arb_cancel(var c.arb, ll_arb.class_cs_next())

// The microseconds the main loop may spend on the HCI stream: `room` (`ctl_ll_room`), or none while the stream is held back for a subevent (the UARTE sends garbled octets within
// about 2 ms of a radio operation of Channel Sounding).  Connection events are served meanwhile.
@when(noble_controller_config.CTL_CS > 0)
pub @tier(embedded)
fn ctl_cs_room(var c: Controller, now: Int, room: Int) -> Int
    if now < cs_gw(var c, ll_cs_proc.GW_QUIET)
        return 0
    room

// ── Channel Sounding: the procedures of the Link Layer ──────────────
// The procedures are in ll_cs_proc.nv, over one record `Cs` for each connection that runs them.  The Controller keeps the records as numbers and octets
// in its two tables `cs_w` and `cs_b` (`ctl_cs` records, claimed by the first request of the Host or the peer and given back when the connection ends) and
// copies the record of a link into a `Cs` for the length of a call, so that a build without the feature has no type of the feature.  Everything here is
// removed from such a build.  The functions read the link into the environment of the procedures, queue the PDUs they answer with and carry the Host's
// requests over (`ctl_cs_security` and its kin, which the commands of the Host call).

// The tables of a new Controller: every record free.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_tables_init(var c: Controller)
    ll_cs_proc.tables_fill(var c.cs_w, var c.cs_b)

// The record in slot `i` of the tables, copied into `cs`.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_get(var c: Controller, i: Int, var cs: ll_cs_proc.Cs)
    ll_cs_proc.load(var c.cs_w, var c.cs_b, i, var cs)

// `cs` copied into slot `i` of the tables.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_put(var c: Controller, i: Int, var cs: ll_cs_proc.Cs)
    ll_cs_proc.store(var c.cs_w, var c.cs_b, i, var cs)

// The slot of the link a record belongs to.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_owner(var c: Controller, i: Int) -> Int
    c.cs_w[i * ll_cs_proc.CS_WORDS + ll_cs_proc.WD_OWNER]

// What the procedure of record `i` waits for (`ll_cs_proc.W_NONE` and the others).
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_wait(var c: Controller, i: Int) -> Int
    c.cs_w[i * ll_cs_proc.CS_WORDS + ll_cs_proc.WD_WAIT]

// The record of the link in slot `ls`, -1 when it has none.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_find(var c: Controller, ls: Int) -> Int
    for i in 0..ctl_limits.cs_slots()
        if cs_owner(var c, i) == ls
            return i
    -1

// The record of the link in slot `ls`, a free one when it has none (new, with the Host Support bit as the Host set it); -1 when every record belongs to another
// connection.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_claim(var c: Controller, ls: Int) -> Int
    let have = cs_find(var c, ls)
    if have >= 0
        return have
    for i in 0..ctl_limits.cs_slots()
        if cs_owner(var c, i) < 0
            var cs = ll_cs_proc.cs_new()
            ll_cs_proc.claim(var cs, ls, cs_host_get(var c))
            ll_cs_proc.set_sec_req(var cs, cs_gw(var c, ll_cs_proc.GW_DEF_SEC))
            if cs_gw(var c, ll_cs_proc.GW_CLASS_T) != 0
                ll_cs_proc.set_chm(var cs, cs_gw(var c, ll_cs_proc.GW_CLASS_LO), cs_gw(var c, ll_cs_proc.GW_CLASS_HI))
            cs_put(var c, i, var cs)
            return i
    -1

// The record of the link in slot `ls` is given back.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_release(var c: Controller, ls: Int)
    let i = cs_find(var c, ls)
    if i >= 0
        var cs = ll_cs_proc.cs_new()
        ll_cs_proc.free(var cs)
        cs_put(var c, i, var cs)

// Every record is given back and the Host Support bit is cleared, as a reset of the Controller does.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_reset_all(var c: Controller)
    var cs = ll_cs_proc.cs_new()
    ll_cs_proc.free(var cs)
    for i in 0..ctl_limits.cs_slots()
        cs_put(var c, i, var cs)
    // What the Controller keeps for all connections goes, but for what describes the radio (the capabilities it was read for, whether it reports the tone quality).
    for k in 0..ll_cs_proc.GLOBAL_WORDS
        if k != ll_cs_proc.GW_RADIO and k != ll_cs_proc.GW_TQ and k != ll_cs_proc.GW_ARM_LEAD
            cs_gw_put(var c, k, 0)
    for slot in 0..noble_controller_config.CTL_LINKS
        ll_link.link_set_host_cs(var c.links[slot], false)

// The Host sets or clears Channel Sounding (Host Support), which it does before the first connection: the records take it.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn ctl_cs_set_host(var c: Controller, on: Bool)
    cs_gw_put(var c, ll_cs_proc.GW_HOST, ll_cs_proc.b2i(on))
    for i in 0..ctl_limits.cs_slots()
        c.cs_w[i * ll_cs_proc.CS_WORDS + ll_cs_proc.WD_HOST] = ll_cs_proc.b2i(on)
    for slot in 0..noble_controller_config.CTL_LINKS
        ll_link.link_set_host_cs(var c.links[slot], on)

// The PHY of the link as LL_CS_REQ names it: 1 LE 1M, 2 LE 2M, 4 LE Coded S=8, 8 LE Coded S=2.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_phy_bit(var c: Controller, ls: Int) -> Int
    if c.links[ls].phy == ll_phy.PHY_2M
        return 2
    if c.links[ls].phy == ll_phy.PHY_CODED
        if c.links[ls].phy_opt == ll_phy.OPT_S2
            return 8
        return 4
    1

// What the procedures need to know of the link in slot `ls`.  The PHYs whose power the Link Layer manages are all four: LE Power Control keeps a level
// for each.  The Host's security requirements are met until a command sets them.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_env(var c: Controller, ls: Int, var en: ll_cs_proc.Env)
    en.central = c.links[ls].central
    en.encrypted = ll_link.link_encrypted(var c.links[ls])
    en.peer_cs = c.links[ls].have_feat and (c.links[ls].peer_feat[5] as Int & ll_cs.FEAT5_CS) != 0
    en.peer_v2 = ll_link.fx_get(c.links[ls], ll_link.FX_HAVE, 1) == 1 and (ll_link.fx_get(c.links[ls], ll_link.FX_PEER, 0xFFFFFF) & ll_cs.PAGE1_CS_ENHANCEMENT_1) != 0
    en.ev_count = c.links[ls].ev_count
    en.interval_us = ll_link.interval_us(var c.links[ls])
    en.now = c.now
    var busy = ll_link.instant_busy(var c.links[ls]) or c.links[ls].proc == ll_link.PROC_PARAM
    if ctl_limits.pcl_on() and c.pcl[ls].wait
        busy = true
    if ctl_limits.sub_on() and c.sub[ls].wait
        busy = true
    en.busy = busy
    en.phy = cs_phy_bit(var c, ls)
    en.managed = 0xF
    en.sec_ok = true
    en.max_tx = ll_link.tx_limit(var c.links[ls])
    cs_busy(var c, ls, var en)

// A control PDU of Channel Sounding, or a refusal of one of its requests, arrived on the link in slot `ls` (`Link.ctl_in`): the procedure answers.  A request
// of the peer for which every record is taken is refused with Rejected Due To Limited Resources.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_rx(var c: Controller, ls: Int, op: Int, var rx: Pdu)
    var i = cs_find(var c, ls)
    if i < 0 and ll_cs.is_pdu(op)
        i = cs_claim(var c, ls)
        if i < 0
            if op == ll_cs.OP_CS_SEC_REQ or op == ll_cs.OP_CS_CAPABILITIES_REQ or op == ll_cs.OP_CS_CONFIG_REQ or op == ll_cs.OP_CS_REQ or op == ll_cs.OP_CS_FAE_REQ
                iso_reject(var c, ls, op, ll_cs_proc.E_LIMITED)
            return
    if i < 0
        return
    var en = ll_cs_proc.env_new()
    cs_env(var c, ls, var en)
    var local = ll_cs_pdu.cap_new()
    cs_local(var c, var local)
    var cs = ll_cs_proc.cs_new()
    cs_get(var c, i, var cs)
    if op == ll_cs.OP_CS_REQ
        // The Host's requirements are checked against the configuration the Start names (its Config_ID is the low six bits of the first octet of CtrData).
        var cfg = ll_cs_pdu.cfg_new()
        if ll_cs_proc.load_config(var cs, ll_cs_pdu.ct(var rx, 0) & 0x3F, var cfg, var c.links[ls].tmp)
            ll_cs_proc.set_sec_ok(var en, ll_cs_hci.sec_met(cs.sec_req, var cfg))
    let r = ll_cs_proc.receive(var cs, var en, var local, var rx, var c.links[ls].tmp)
    cs_put(var c, i, var cs)
    if r == ll_cs_proc.R_SEND
        let _s = iso_send(c, ls)
    else if r == ll_cs_proc.R_FAE
        var table: Vec[u8; 72] = Vec.new()
        for k in 0..ll_cs.CHANNEL_COUNT
            let _t = table.push(cs_go(var c, ll_cs_proc.GO_LFAE + k) as u8)
        let _a = ll_cs_proc.fae_rsp(var en, var table, var c.links[ls].tmp)
        let _s = iso_send(c, ls)
    else if r == ll_cs_proc.R_UNKNOWN
        ll_link.answer_unknown(var c.links[ls], op)
        ll_link.link_prepare(var c.links[ls])

// Whether a configuration waits in the record `i` for the Capabilities Exchange (`ll_cs_proc.stage_config`): the octet of the store, read without copying the record.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_staged(var c: Controller, i: Int) -> Bool
    c.cs_b[i * ll_cs_proc.bulk_octets() + ll_cs_proc.OFF_PCFG] == 4

// The Feature Exchange the Controller started for the record `i` of the link in slot `ls` has ended: when the features are known, the Capabilities Exchange the Host asked
// for (or the configuration needs) goes on; when the exchange failed, the Host is told by the event of the command that waited, with the status of the exchange.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_features_ended(var c: Controller, i: Int, ls: Int)
    var st = STATUS_SUCCESS
    if c.links[ls].have_feat
        // The record stops waiting for the features before the exchange of the capabilities asks to wait for those.
        var cs = ll_cs_proc.cs_new()
        cs_get(var c, i, var cs)
        ll_cs_proc.end_features(var cs)
        cs_put(var c, i, var cs)
        st = cs_caps_step(var c, ls)
    else if c.links[ls].proc == ll_link.PROC_FEATURES
        return
    else
        st = c.links[ls].feat_status
    if st != STATUS_SUCCESS
        var cs = ll_cs_proc.cs_new()
        cs_get(var c, i, var cs)
        ll_cs_proc.fail_auto(var cs, st)
        cs_put(var c, i, var cs)

// The Capabilities Exchange the Controller made for a configuration has ended: the request to create the configuration goes to the peer, or the Host is told why it will not.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_config_resume(var c: Controller, i: Int, ls: Int)
    if c.links[ls].cq_count >= ll_link.CTRL_SLOTS - 1
        return
    var en = ll_cs_proc.env_new()
    cs_env(var c, ls, var en)
    var local = ll_cs_pdu.cap_new()
    cs_local(var c, var local)
    var cs = ll_cs_proc.cs_new()
    cs_get(var c, i, var cs)
    let r = ll_cs_proc.config_resume(var cs, var en, var local, var c.links[ls].tmp)
    cs_put(var c, i, var cs)
    if r == ll_cs_proc.R_SEND
        let _s = iso_send(c, ls)

// The work of the procedures that is not in a radio event: a procedure that the peer leaves unanswered for 40 seconds ends the connection (Section 5.2), and the
// exchanges the Controller makes for a command of the Host go on from one to the next.  True when a connection was ended.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn ctl_cs_poll(var c: Controller) -> Bool
    var did = false
    for i in 0..ctl_limits.cs_slots()
        let ls = cs_owner(var c, i)
        let w = cs_wait(var c, i)
        if ls >= 0 and (w == ll_cs_proc.W_FEAT or w == ll_cs_proc.W_NONE and cs_staged(var c, i)) and ctl_conn_active(var c, ls)
            if w == ll_cs_proc.W_FEAT
                cs_features_ended(var c, i, ls)
            else
                cs_config_resume(var c, i, ls)
        if ls >= 0 and cs_wait(var c, i) != ll_cs_proc.W_NONE and ctl_conn_active(var c, ls)
            var cs = ll_cs_proc.cs_new()
            cs_get(var c, i, var cs)
            var en = ll_cs_proc.env_at(c.now)
            let late = ll_cs_proc.poll(var cs, var en)
            cs_put(var c, i, var cs)
            if late != 0
                ll_link.link_close(var c.links[ls], ll_link.REASON_RESPONSE_TIMEOUT)
                did = true
    did

// Whether a procedure of a connection waits for random octets (the Central's parts of Security Start, or the Peripheral's).
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_wants_random(var c: Controller) -> Bool
    for i in 0..ctl_limits.cs_slots()
        let w = cs_wait(var c, i)
        if cs_owner(var c, i) >= 0 and (w == ll_cs_proc.W_RND_C or w == ll_cs_proc.W_RND_P)
            return true
    false

// Give the random octets `rnd` to the procedure that waits for them; true when it took them.  The PDU the last octets complete goes out.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_feed(var c: Controller, rnd: Vec[u8; 12]) -> Bool
    for i in 0..ctl_limits.cs_slots()
        let ls = cs_owner(var c, i)
        let w = cs_wait(var c, i)
        if ls >= 0 and (w == ll_cs_proc.W_RND_C or w == ll_cs_proc.W_RND_P) and ctl_conn_active(var c, ls)
            var cs = ll_cs_proc.cs_new()
            cs_get(var c, i, var cs)
            var en = ll_cs_proc.env_at(c.now)
            let r = ll_cs_proc.feed_random(var cs, var en, rnd, var c.links[ls].tmp)
            cs_put(var c, i, var cs)
            if r == ll_cs_proc.R_SEND
                let _s = iso_send(c, ls)
            return true
    false

// The record for a request of the Host on the link in slot `ls`: its index, or -1 for a link that is not on, -2 for one with no room in its control
// queue and -3 when every record belongs to another connection.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_request(var c: Controller, ls: Int) -> Int
    if ls < 0 or not ctl_conn_active(var c, ls)
        return -1
    if c.links[ls].cq_count >= ll_link.CTRL_SLOTS - 1
        return -2
    let i = cs_claim(var c, ls)
    if i < 0
        return -3
    i

// The HCI status of a request that found no record: Unknown Connection Identifier, Command Disallowed, Rejected Due To Limited Resources.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_request_status(i: Int) -> Int
    if i == -1
        return STATUS_UNKNOWN_CONNECTION
    if i == -2
        return STATUS_COMMAND_DISALLOWED
    ll_cs_proc.E_LIMITED

// The Host's request ended with `st`: the PDU in the `tmp` of the link goes out when it succeeded.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn cs_sent(var c: Controller, ls: Int, st: Int) -> Int
    if st == 0
        let _s = iso_send(c, ls)
    st

// LE CS Security Enable for the link in slot `ls`: the Central collects its parts of the security values and sends LL_CS_SEC_REQ.  The status the command gets.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn ctl_cs_security(var c: Controller, ls: Int) -> Int
    let i = cs_request(var c, ls)
    if i < 0
        return cs_request_status(i)
    var en = ll_cs_proc.env_new()
    cs_env(var c, ls, var en)
    var cs = ll_cs_proc.cs_new()
    cs_get(var c, i, var cs)
    let st = ll_cs_proc.begin_security(var cs, var en)
    cs_put(var c, i, var cs)
    st

// The Controller asks for the features of the peer on the link in slot `ls` because the Host asked for its capabilities (LE CS Read Remote Supported Capabilities) before
// they were known: the Feature Exchange runs, and `ctl_cs_poll` goes on with the Capabilities Exchange when it has ended.  The status of the command.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn ctl_cs_features(var c: Controller, ls: Int) -> Int
    let i = cs_request(var c, ls)
    if i < 0
        return cs_request_status(i)
    var en = ll_cs_proc.env_new()
    cs_env(var c, ls, var en)
    var cs = ll_cs_proc.cs_new()
    cs_get(var c, i, var cs)
    var st = ll_cs_proc.begin_features(var cs, var en)
    if st == 0
        st = ll_link.link_read_features(var c.links[ls])
        if st != 0
            ll_cs_proc.end_features(var cs)
    cs_put(var c, i, var cs)
    st

// LE CS Read Remote Supported Capabilities for the link in slot `ls`.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn ctl_cs_capabilities(var c: Controller, ls: Int) -> Int
    let i = cs_request(var c, ls)
    if i < 0
        return cs_request_status(i)
    var en = ll_cs_proc.env_new()
    cs_env(var c, ls, var en)
    var local = ll_cs_pdu.cap_new()
    cs_local(var c, var local)
    var cs = ll_cs_proc.cs_new()
    cs_get(var c, i, var cs)
    let st = ll_cs_proc.begin_capabilities(var cs, var en, var local, var c.links[ls].tmp)
    cs_put(var c, i, var cs)
    cs_sent(var c, ls, st)

// LE CS Create Config and LE CS Remove Config for the link in slot `ls`: the configuration `cfg` is created (`cfg.action` 1) or removed (0), with the
// peer, or `local_only` (no PDU goes out).
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn ctl_cs_config(var c: Controller, ls: Int, var cfg: CfgPdu, local_only: Bool) -> Int
    let i = cs_request(var c, ls)
    if i < 0
        return cs_request_status(i)
    var en = ll_cs_proc.env_new()
    cs_env(var c, ls, var en)
    var local = ll_cs_pdu.cap_new()
    cs_local(var c, var local)
    var cs = ll_cs_proc.cs_new()
    cs_get(var c, i, var cs)
    if not local_only and not ll_cs_proc.caps_known(var cs)
        // The capabilities of the peer are not known: the configuration waits, and the Controller asks for the features (when it lacks them) and then the capabilities.
        var st = ll_cs_proc.stage_config(var cs, var en, var local, var cfg, var c.links[ls].tmp)
        var sent = false
        if st == 0
            if c.links[ls].have_feat
                st = ll_cs_proc.begin_capabilities(var cs, var en, var local, var c.links[ls].tmp)
                sent = st == 0
            else
                st = ll_cs_proc.begin_features(var cs, var en)
                if st == 0
                    st = ll_link.link_read_features(var c.links[ls])
                    if st != 0
                        ll_cs_proc.end_features(var cs)
            // The exchange did not start after all: the configuration is not kept.
            if st != 0
                ll_cs_proc.unstage(var cs)
        cs_put(var c, i, var cs)
        if sent
            return cs_sent(var c, ls, st)
        return st
    let st = ll_cs_proc.begin_config(var cs, var en, var local, var cfg, local_only, var c.links[ls].tmp)
    cs_put(var c, i, var cs)
    if local_only
        return st
    cs_sent(var c, ls, st)

// LE CS Read Remote FAE Table for the link in slot `ls`.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn ctl_cs_fae(var c: Controller, ls: Int) -> Int
    let i = cs_request(var c, ls)
    if i < 0
        return cs_request_status(i)
    var en = ll_cs_proc.env_new()
    cs_env(var c, ls, var en)
    var cs = ll_cs_proc.cs_new()
    cs_get(var c, i, var cs)
    let st = ll_cs_proc.begin_fae(var cs, var en, var c.links[ls].tmp)
    cs_put(var c, i, var cs)
    cs_sent(var c, ls, st)

// LE CS Procedure Enable for the link in slot `ls`: the procedures `s` describes start.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn ctl_cs_start(var c: Controller, ls: Int, var s: StartPdu) -> Int
    let i = cs_request(var c, ls)
    if i < 0
        return cs_request_status(i)
    var en = ll_cs_proc.env_new()
    cs_env(var c, ls, var en)
    var local = ll_cs_pdu.cap_new()
    cs_local(var c, var local)
    var cs = ll_cs_proc.cs_new()
    cs_get(var c, i, var cs)
    let st = ll_cs_proc.begin_start(var cs, var en, var local, var s, var c.links[ls].tmp)
    cs_put(var c, i, var cs)
    cs_sent(var c, ls, st)

// The repeats of the series on the link in slot `ls` are to stop, for `error`.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn ctl_cs_terminate(var c: Controller, ls: Int, config_id: Int, error: Int) -> Int
    let i = cs_request(var c, ls)
    if i < 0
        return cs_request_status(i)
    var en = ll_cs_proc.env_new()
    cs_env(var c, ls, var en)
    var cs = ll_cs_proc.cs_new()
    cs_get(var c, i, var cs)
    let st = ll_cs_proc.begin_terminate(var cs, var en, config_id, error, var c.links[ls].tmp)
    cs_put(var c, i, var cs)
    cs_sent(var c, ls, st)

// LE CS Set Channel Classification for the link in slot `ls`: the map `lo` and `hi` (`ll_cs_pdu.chm_has`) applies from the event `instant`.
@when(noble_controller_config.CTL_CS > 0)
@tier(embedded)
fn ctl_cs_channel_map(var c: Controller, ls: Int, lo: Int, hi: Int, instant: Int) -> Int
    let i = cs_request(var c, ls)
    if i < 0
        return cs_request_status(i)
    var en = ll_cs_proc.env_new()
    cs_env(var c, ls, var en)
    var cs = ll_cs_proc.cs_new()
    cs_get(var c, i, var cs)
    let st = ll_cs_proc.begin_channel_map(var cs, var en, lo, hi, instant, var c.links[ls].tmp)
    cs_put(var c, i, var cs)
    cs_sent(var c, ls, st)

// ── The Sleep Clock Accuracy request ────────────────────────────────

// LE Request Peer SCA Complete ([Vol 4] Part E, Section 7.7.65.31) for the link in slot `ls`: the status of the procedure, the handle and the accuracy
// class the peer sent (0 when it sent none).  False when no event slot was free.
@satisfies("REQ-BLE-CTL-121")
@tier(embedded)
fn ev_sca(var c: Controller, ls: Int) -> Bool
    if not le_event_enabled(var c, SUB_LE_REQUEST_PEER_SCA_COMPLETE)
        ll_link.fx_put(var c.links[ls], ll_link.FX_SCA, 1, 0)
        return true
    let slot = meta_begin(var c, SUB_LE_REQUEST_PEER_SCA_COMPLETE)
    if slot == ctl_pool.NO_SLOT
        return false
    let st = ll_link.fx_get(c.links[ls], ll_link.FX_STATUS, 0x7F)
    var class = 0
    if st == STATUS_SUCCESS
        class = c.links[ls].sca
    let _a = ctl_pool.pool_put(var c.pool, slot, st)
    let _b = ctl_pool.pool_put_u16(var c.pool, slot, c.links[ls].handle)
    let _c = ctl_pool.pool_put(var c.pool, slot, class)
    event_send(var c, slot)
    ll_link.fx_put(var c.links[ls], ll_link.FX_SCA, 1, 0)
    true

// LE Request Peer SCA (Section 7.8.108): Command Status now, and LE Request Peer SCA Complete when the peer has answered or refused.
@satisfies("REQ-BLE-CTL-121")
@tier(embedded)
fn cmd_le_request_peer_sca(var c: Controller)
    let ls = handle_slot(var c, param_handle(var c))
    var status = STATUS_UNKNOWN_CONNECTION
    if ls >= 0
        status = ll_link.link_request_sca(var c.links[ls])
    answer_command_status(var c, OP_LE_REQUEST_PEER_SCA, status)

// ── Path loss monitoring ────────────────────────────────────────────

// LE Path Loss Threshold ([Vol 4] Part E, Section 7.7.65.32) for the link in slot `ls`: the path loss in dB (`ll_ploss.UNAVAILABLE` when it is not known) and
// the zone entered.  The zone is kept whether or not the Host unmasked the event.
@satisfies("REQ-BLE-CTL-120")
@tier(embedded)
fn ploss_report(var c: Controller, ls: Int, loss: Int, zone: Int)
    ll_ploss.put_zone(var c.pcl[ls].ploss, zone)
    ll_ploss.clear_cand(var c.pcl[ls].ploss)
    if not le_event_enabled(var c, SUB_LE_PATH_LOSS_THRESHOLD)
        return
    let slot = meta_begin(var c, SUB_LE_PATH_LOSS_THRESHOLD)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put_u16(var c.pool, slot, c.links[ls].handle)
    let _b = ctl_pool.pool_put(var c.pool, slot, loss)
    let _c = ctl_pool.pool_put(var c.pool, slot, zone)
    event_send(var c, slot)

// The path loss of the link in slot `ls` is not known and will not be: the peer has no LE Power Control or refused the question.  The Host is told
// with 0xFF, and the next measurement is reported as a first one.
@satisfies("REQ-BLE-CTL-120")
@tier(embedded)
fn ploss_unavailable(var c: Controller, ls: Int)
    if not c.pcl[ls].ploss.reporting_on
        return
    ploss_report(var c, ls, ll_ploss.UNAVAILABLE, 0)
    ll_ploss.put_zone(var c.pcl[ls].ploss, -1)

// The zone of the link in slot `ls` after the measurement so far: the first one is reported at once; a zone left by crossing a boundary is reported once the
// path loss has led there for Min_Time_Spent samples (`force` skips the wait: the Host changed the parameters).  The level of the peer is the one LE Power
// Control last learned for the PHY in use; when it is not known the peer is asked once and the Host is told if it cannot say.
@satisfies("REQ-BLE-CTL-120")
@tier(embedded)
fn ploss_eval(var c: Controller, ls: Int, force: Bool)
    if not c.pcl[ls].ploss.reporting_on or not c.pcl[ls].ploss.avg_has_sample
        return
    let idx = pcl_cur(var c, ls)
    let level = ll_pcl.peer_level(var c.pcl[ls], idx)
    let loss = ll_ploss.loss_of(level, ll_ploss.avg_dbm(c.pcl[ls].ploss))
    if loss == ll_ploss.UNAVAILABLE
        if c.pcl[ls].ploss.peer_tried or c.pcl[ls].wait
            return
        ll_ploss.put_tried(var c.pcl[ls].ploss, true)
        if pcl_peer_lacks(var c, ls)
            ploss_unavailable(var c, ls)
        else
            pcl_ask(var c, ls, idx, ll_pcl.REASON_PATHLOSS)
        return
    if c.pcl[ls].ploss.peer_tried
        ll_ploss.put_tried(var c.pcl[ls].ploss, false)
    let z = ll_ploss.zone_of(c.pcl[ls].ploss)
    if z < 0
        ploss_report(var c, ls, loss, ll_ploss.zone_start(c.pcl[ls].ploss, loss))
        return
    let t = ll_ploss.zone_step(c.pcl[ls].ploss, z, loss)
    if t == z
        ll_ploss.clear_cand(var c.pcl[ls].ploss)
        return
    ll_ploss.cand_step(var c.pcl[ls].ploss, t)
    if force or ll_ploss.cand_reached(c.pcl[ls].ploss)
        ploss_report(var c, ls, loss, t)

// A signal strength sample from a packet received on the link in slot `ls`; `rssi` is 127 when the radio gave none.  Each sample is one connection event
// in which a packet arrived.
@satisfies("REQ-BLE-CTL-120")
@tier(embedded)
fn ploss_sample(var c: Controller, ls: Int, rssi: Int)
    if rssi >= 127 or not c.pcl[ls].ploss.reporting_on
        return
    ll_ploss.avg_add(var c.pcl[ls].ploss, rssi)
    ploss_eval(var c, ls, false)

// LE Set Path Loss Reporting Parameters (Section 7.8.119): the thresholds, hysteresis and minimum time of the connection.  Reporting that is on and now in
// another zone is reported at once.
@satisfies("REQ-BLE-CTL-120")
@tier(embedded)
fn cmd_le_set_path_loss_reporting_parameters(var c: Controller)
    let handle = param_handle(var c)
    let ht = h4_rx.h4_param(var c.rx, 2)
    let hh = h4_rx.h4_param(var c.rx, 3)
    let lt = h4_rx.h4_param(var c.rx, 4)
    let lh = h4_rx.h4_param(var c.rx, 5)
    let ls = handle_slot(var c, handle)
    var status = STATUS_SUCCESS
    if ls < 0
        status = STATUS_UNKNOWN_CONNECTION
    else if not ll_ploss.params_ok(ht, hh, lt, lh)
        status = STATUS_INVALID_PARAMETERS
    else
        ll_ploss.put_params(var c.pcl[ls].ploss, ht, hh, lt, lh, param_u16(var c, 6))
        ll_ploss.clear_cand(var c.pcl[ls].ploss)
    answer_handle(var c, OP_LE_SET_PATH_LOSS_REPORTING_PARAMETERS, status, handle)
    if status == STATUS_SUCCESS and ll_ploss.zone_of(c.pcl[ls].ploss) >= 0
        ploss_eval(var c, ls, true)

// LE Set Path Loss Reporting Enable (Section 7.8.120): reporting starts with the next measurement of the path loss and the first report follows it; Command
// Disallowed until the parameters were set.  Switching on what is on, or off what is off, changes nothing.
@satisfies("REQ-BLE-CTL-120")
@tier(embedded)
fn cmd_le_set_path_loss_reporting_enable(var c: Controller)
    let handle = param_handle(var c)
    let en = h4_rx.h4_param(var c.rx, 2)
    let ls = handle_slot(var c, handle)
    var status = STATUS_SUCCESS
    if ls < 0
        status = STATUS_UNKNOWN_CONNECTION
    else if not c.pcl[ls].ploss.params_set
        status = STATUS_COMMAND_DISALLOWED
    else if en > 1
        status = STATUS_INVALID_PARAMETERS
    else if (en == 1) != c.pcl[ls].ploss.reporting_on
        ll_ploss.put_on(var c.pcl[ls].ploss, en == 1)
        ll_ploss.clear_measure(var c.pcl[ls].ploss)
    answer_handle(var c, OP_LE_SET_PATH_LOSS_REPORTING_ENABLE, status, handle)

// Run the command of path loss monitoring with `opcode`.
@tier(embedded)
fn ploss_dispatch(var c: Controller, opcode: Int)
    if opcode == OP_LE_SET_PATH_LOSS_REPORTING_PARAMETERS
        cmd_le_set_path_loss_reporting_parameters(var c)
    else
        cmd_le_set_path_loss_reporting_enable(var c)

// ── Connection Subrating ────────────────────────────────────────────

// LE Subrate Change ([Vol 4] Part E, Section 7.7.65.35) for the link in slot `ls`: the values in force and the status of the update.  The Host
// that waited for its request is answered, and the wait ends.
@satisfies("REQ-BLE-CTL-116")
@tier(embedded)
fn sub_event(var c: Controller, ls: Int, status: Int)
    c.sub[ls].wait = false
    if not le_event_enabled(var c, SUB_LE_SUBRATE_CHANGE)
        return
    let slot = meta_begin(var c, SUB_LE_SUBRATE_CHANGE)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put(var c.pool, slot, status)
    let _b = ctl_pool.pool_put_u16(var c.pool, slot, c.links[ls].handle)
    let _c = ctl_pool.pool_put_u16(var c.pool, slot, c.links[ls].sub_factor as Int)
    let _d = ctl_pool.pool_put_u16(var c.pool, slot, c.links[ls].latency)
    let _e = ctl_pool.pool_put_u16(var c.pool, slot, c.links[ls].sub_cont as Int)
    let _f = ctl_pool.pool_put_u16(var c.pool, slot, c.links[ls].timeout)
    event_send(var c, slot)

// The Link Layer owes the Host the event of an update that was applied.
@tier(embedded)
fn ev_subrate(var c: Controller, ls: Int) -> Bool
    if not ctl_limits.sub_on()
        lk_sent(var c, ls, ll_link.EV_SUBRATE)
        return true
    if ctl_limits.rate_on() and ll_link.fx_get(c.links[ls], ll_link.FX_RATEEV, 1) == 1
        ll_link.fx_put(var c.links[ls], ll_link.FX_RATEEV, 1, 0)
        rate_event(var c, ls, c.links[ls].sub_status as Int)
    else
        sub_event(var c, ls, c.links[ls].sub_status as Int)
    lk_sent(var c, ls, ll_link.EV_SUBRATE)
    true

// Whether the peer of the link in slot `ls` said it has the Connection Subrating (Host Support) feature.
@tier(embedded)
fn sub_peer_ok(var c: Controller, ls: Int) -> Bool
    c.links[ls].have_feat and (c.links[ls].peer_feat[4] as Int & ll_link.FEAT4_SUB_HOST) != 0

// LL_SUBRATE_REQ received by the Central of the link in slot `ls` (Section 5.1.20), or the refusal of the request this end sent.  The Central
// refuses without the Host's support bit, with a request the Host's limits do not allow, and while another procedure or its own update is open;
// otherwise it starts the update with the values the rules pick.
@satisfies("REQ-BLE-CTL-116")
@tier(embedded)
fn sub_rx(var c: Controller, ls: Int, op: Int, var rx: Pdu)
    if op == ll_data.OP_REJECT_EXT_IND
        if c.sub[ls].wait
            c.links[ls].sub_status = ll_data.dpdu_byte(var rx, 2) as u8
            sub_event(var c, ls, ll_data.dpdu_byte(var rx, 2))
        return
    if op == ll_data.OP_UNKNOWN_RSP
        if c.sub[ls].wait
            sub_event(var c, ls, STATUS_UNSUPPORTED_REMOTE)
        return
    if not c.links[ls].central
        iso_reject(var c, ls, ll_data.OP_SUBRATE_REQ, STATUS_COMMAND_DISALLOWED)
        return
    let fmin = ll_sub.get16(var rx, 1)
    let fmax = ll_sub.get16(var rx, 3)
    let lat = ll_sub.get16(var rx, 5)
    let cont = ll_sub.get16(var rx, 7)
    let to = ll_sub.get16(var rx, 9)
    if not c.host_sub
        iso_reject(var c, ls, ll_data.OP_SUBRATE_REQ, STATUS_UNSUPPORTED_FEATURE)
    else if not ll_link.sub_can_start(var c.links[ls])
        iso_reject(var c, ls, ll_data.OP_SUBRATE_REQ, ll_sub.E_DIFFERENT_TRANSACTION)
    else if not ll_sub.req_ok(var c.sub[ls], c.links[ls].interval, fmin, fmax, lat, to)
        iso_reject(var c, ls, ll_data.OP_SUBRATE_REQ, ll_sub.E_UNSUPPORTED_PARAM)
    else
        sub_start(var c, ls, ll_sub.pick_factor(var c.sub[ls], fmin), lat, cont, to, ll_data.OP_SUBRATE_REQ)

// The Central of the link in slot `ls` starts the update to `factor` with at most `lat`, the continuation `cont` and the timeout `to` (all
// subject to the Host's limits): the values are picked as Section 5.1.20 says, and a request that leaves no valid latency is refused with
// `op`'s reject.  False when nothing was started.
@satisfies("REQ-BLE-CTL-116")
@tier(embedded)
fn sub_start(var c: Controller, ls: Int, factor: Int, lat: Int, cont: Int, to: Int, op: Int) -> Bool
    let nto = ll_sub.pick_timeout(var c.sub[ls], to)
    let nlat = ll_sub.pick_latency(var c.sub[ls], c.links[ls].interval, factor, lat, nto)
    if nlat < 0
        iso_reject(var c, ls, op, ll_sub.E_UNSUPPORTED_PARAM)
        return false
    let ncont = ll_sub.pick_cont(var c.sub[ls], factor, cont)
    if not ll_link.sub_central_start(var c.links[ls], factor, nlat, ncont, nto)
        iso_reject(var c, ls, op, ll_sub.E_DIFFERENT_TRANSACTION)
        return false
    ll_link.link_prepare(var c.links[ls])
    true

// The work of Connection Subrating that is not in a radio event: the request a Host command asked for goes out (the queue may be full), and one
// the peer leaves unanswered is given up after `ll_sub.WAIT_US`.  True when something was done.
@satisfies("REQ-BLE-CTL-116")
@tier(embedded)
fn ctl_sub_poll(var c: Controller) -> Bool
    var did = false
    for ls in 0..noble_controller_config.CTL_LINKS
        if c.sub[ls].wait and (not ctl_limits.rate_on() or c.sub[ls].iv == 0)
            if not ctl_conn_active(var c, ls)
                c.sub[ls].wait = false
                did = true
            else if c.now - c.sub[ls].t0 > ll_sub.WAIT_US
                sub_event(var c, ls, STATUS_RESPONSE_TIMEOUT)
                did = true
            else if not c.sub[ls].sent
                ll_sub.put_req(var c.links[ls].tmp,
                    c.sub[ls].fmin,
                    c.sub[ls].fmax,
                    c.sub[ls].lat,
                    c.sub[ls].cont,
                    c.sub[ls].to)
                if iso_send(c, ls)
                    c.sub[ls].sent = true
                    did = true
    did

// Whether the values of LE Set Default Subrate and LE Subrate Request are ones the specification allows (the ranges, and the factor times
// (latency + 1) within 500).
@tier(embedded)
fn sub_params_ok(fmin: Int, fmax: Int, lat: Int, cont: Int, to: Int) -> Bool
    fmin >= 1 and fmax <= ll_sub.FACTOR_MAX and fmin <= fmax and lat <= 0x1F3 and cont <= 0x1F3 and to >= 10 and to <= 0x0C80
        and fmax * (lat + 1) <= ll_sub.FACTOR_MAX

// LE Set Default Subrate (Section 7.8.123): what the Host lets the peer ask for on the connections this Controller makes as Central.
@satisfies("REQ-BLE-CTL-116")
@tier(embedded)
fn cmd_le_set_default_subrate(var c: Controller)
    let fmin = param_u16(var c, 0)
    let fmax = param_u16(var c, 2)
    let lat = param_u16(var c, 4)
    let cont = param_u16(var c, 6)
    let to = param_u16(var c, 8)
    var status = STATUS_SUCCESS
    if not sub_params_ok(fmin, fmax, lat, cont, to)
        status = STATUS_INVALID_PARAMETERS
    else
        c.sub_def[0].amin = fmin
        c.sub_def[0].amax = fmax
        c.sub_def[0].alat = lat
        c.sub_def[0].acont = cont
        c.sub_def[0].ato = to
    answer_status(var c, OP_LE_SET_DEFAULT_SUBRATE, status)

// LE Subrate Request (Section 7.8.124): Command Status now and LE Subrate Change when the update ends.  The values become what the Host allows for
// this connection.  A Central starts the update at once; a Peripheral sends LL_SUBRATE_REQ.
@satisfies("REQ-BLE-CTL-116")
@tier(embedded)
fn cmd_le_subrate_request(var c: Controller)
    let handle = param_handle(var c)
    let fmin = param_u16(var c, 2)
    let fmax = param_u16(var c, 4)
    let lat = param_u16(var c, 6)
    let cont = param_u16(var c, 8)
    let to = param_u16(var c, 10)
    let ls = handle_slot(var c, handle)
    var status = STATUS_SUCCESS
    if ls < 0
        status = STATUS_UNKNOWN_CONNECTION
    else if not sub_params_ok(fmin, fmax, lat, cont, to) or cont >= fmax or c.links[ls].interval * fmax * (lat + 1) >= to * 4
        status = STATUS_INVALID_PARAMETERS
    else if not c.host_sub or c.sub[ls].wait
        status = STATUS_COMMAND_DISALLOWED
    else if not sub_peer_ok(var c, ls)
        status = STATUS_UNSUPPORTED_REMOTE
    else if not ll_link.sub_can_start(var c.links[ls]) and c.links[ls].central
        status = STATUS_COMMAND_DISALLOWED
    else
        c.sub[ls].amin = fmin
        c.sub[ls].amax = fmax
        c.sub[ls].alat = lat
        c.sub[ls].acont = cont
        c.sub[ls].ato = to
        c.links[ls].sub_host = true
        if c.links[ls].central
            let f = fmin
            let nto = to
            let nlat = ll_sub.pick_latency(var c.sub[ls], c.links[ls].interval, f, lat, nto)
            if nlat < 0 or not ll_link.sub_central_start(var c.links[ls], f, nlat, ll_sub.pick_cont(var c.sub[ls], f, cont), nto)
                c.links[ls].sub_host = false
                status = STATUS_COMMAND_DISALLOWED
            else
                ll_link.link_prepare(var c.links[ls])
                c.sub[ls].wait = true
                c.sub[ls].t0 = c.now
        else
            c.sub[ls].wait = true
            c.sub[ls].sent = false
            c.sub[ls].t0 = c.now
            c.sub[ls].fmin = fmin
            c.sub[ls].fmax = fmax
            c.sub[ls].lat = lat
            c.sub[ls].cont = cont
            c.sub[ls].to = to
    answer_command_status(var c, OP_LE_SUBRATE_REQUEST, status)

// Run the command of Connection Subrating with `opcode`.
@tier(embedded)
fn sub_dispatch(var c: Controller, opcode: Int)
    if opcode == OP_LE_SET_DEFAULT_SUBRATE
        cmd_le_set_default_subrate(var c)
    else
        cmd_le_subrate_request(var c)

// ── Connection Rate ─────────────────────────────────────────────────

// LE Connection Rate Change ([Vol 4] Part E, Section 7.7.65.50) for the link in slot `ls`: the values in force (the interval in units of 125 us)
// and the status of the update.  The Host that waited for its request is answered, and the wait ends.
@satisfies("REQ-BLE-CTL-118")
@tier(embedded)
fn rate_event(var c: Controller, ls: Int, status: Int)
    c.sub[ls].wait = false
    c.sub[ls].iv = 0
    if not le_event_enabled(var c, SUB_LE_CONNECTION_RATE_CHANGE)
        return
    let slot = meta_begin(var c, SUB_LE_CONNECTION_RATE_CHANGE)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put(var c.pool, slot, status)
    let _b = ctl_pool.pool_put_u16(var c.pool, slot, c.links[ls].handle)
    let _c = ctl_pool.pool_put_u16(var c.pool, slot, c.links[ls].interval * ll_rate.RATE_STEP)
    let _d = ctl_pool.pool_put_u16(var c.pool, slot, c.links[ls].sub_factor as Int)
    let _e = ctl_pool.pool_put_u16(var c.pool, slot, c.links[ls].latency)
    let _f = ctl_pool.pool_put_u16(var c.pool, slot, c.links[ls].sub_cont as Int)
    let _g = ctl_pool.pool_put_u16(var c.pool, slot, c.links[ls].timeout)
    event_send(var c, slot)

// The Central of the link in slot `ls` starts the update (Section 5.1.32) to the interval `iv` (125 us) with the Host's limits on the other
// values: `ll_sub`'s rules pick the factor, latency, continuation number and timeout.  `host` says the Host asked; `ref` and `off` are the
// anchor point the peer prefers (`off` -1 for none).  Zero when the update started, otherwise the error code a refusal carries.
@satisfies("REQ-BLE-CTL-118")
@tier(embedded)
fn rate_launch(var c: Controller, ls: Int, iv: Int, fmin: Int, lat: Int, cont: Int, to: Int,
               host: Bool, ref: Int, off: Int) -> Int
    let u = iv / ll_rate.RATE_STEP
    let f = ll_sub.pick_factor(var c.sub[ls], fmin)
    let nto = ll_sub.pick_timeout(var c.sub[ls], to)
    let nlat = ll_sub.pick_latency(var c.sub[ls], u, f, lat, nto)
    if nlat < 0
        return ll_rate.E_UNSUPPORTED_PARAM
    let ncont = ll_sub.pick_cont(var c.sub[ls], f, cont)
    if ll_link.rate_central_start(var c.links[ls], u, f, nlat, ncont, nto, host, ref, off) != STATUS_SUCCESS
        return ll_sub.E_DIFFERENT_TRANSACTION
    0

// LL_CONNECTION_RATE_REQ received by the Central of the link in slot `ls` (Section 5.1.33), or the refusal of the request this end sent, or the
// Peripheral's answer that it does not know LL_CONNECTION_RATE_IND.  The Central refuses a request with a field out of range (Invalid LL
// Parameters), an Interval_Max below connIntervalRequired or without the Host's support bit (Unsupported Feature or Parameter Value), while
// another procedure or its own update is open (Different Transaction Collision), and one the Host's limits do not allow or that has no supported
// interval (Unsupported LL Parameter Value); otherwise it starts the update.  The peer that sent the request has the feature.
@satisfies("REQ-BLE-CTL-118")
@tier(embedded)
fn rate_rx(var c: Controller, ls: Int, op: Int, var rx: Pdu)
    if op == ll_data.OP_REJECT_EXT_IND
        if c.sub[ls].wait and c.sub[ls].iv != 0
            rate_event(var c, ls, ll_data.dpdu_byte(var rx, 2))
        return
    if op == ll_data.OP_UNKNOWN_RSP
        if ll_data.dpdu_byte(var rx, 1) == ll_data.OP_CONNECTION_RATE_IND
            ll_link.rate_cancel(var c.links[ls])
        if c.sub[ls].wait and c.sub[ls].iv != 0
            rate_event(var c, ls, STATUS_UNSUPPORTED_REMOTE)
        return
    let imin = ll_sub.get16(var rx, 1)
    let imax = ll_sub.get16(var rx, 3)
    let fmin = ll_sub.get16(var rx, 5)
    let fmax = ll_sub.get16(var rx, 7)
    let lat = ll_sub.get16(var rx, 9)
    let cont = ll_sub.get16(var rx, 11)
    let to = ll_sub.get16(var rx, 13)
    let period = ll_sub.get16(var rx, 15)
    let ref = ll_sub.get16(var rx, 17)
    if not ll_rate.req_valid(imin, imax, fmin, fmax, lat, cont, to, period) or not ll_rate.offsets_ok(var rx, imax)
        iso_reject(var c, ls, op, ll_rate.E_INVALID_PARAMS)
        return
    if imax * 125 < ll_link.rate_required(var c.links[ls]) or not ll_link.rate_host(c.links[ls])
        iso_reject(var c, ls, op, ll_rate.E_UNSUPPORTED_FEATURE)
        return
    if not ll_link.sub_can_start(var c.links[ls]) or c.sub[ls].wait
        iso_reject(var c, ls, op, ll_sub.E_DIFFERENT_TRANSACTION)
        return
    let iv = ll_rate.accept_interval(var c.sub[ls], imin, imax, period, ll_link.rate_floor(var c.links[ls]))
    if iv < 0 or not ll_sub.req_ok(var c.sub[ls], iv / ll_rate.RATE_STEP, fmin, fmax, lat, to)
        iso_reject(var c, ls, op, ll_rate.E_UNSUPPORTED_PARAM)
        return
    let code = rate_launch(var c, ls, iv, fmin, lat, cont, to, false, ref, ll_rate.first_offset(var rx))
    if code != 0
        iso_reject(var c, ls, op, code)

// The work of Connection Rate that is not in a radio event, for a request the Host made: the peer's page 1 is read first when the Controller
// has not got it (a peer without features 72 and 73 ends the request with Unsupported Remote Feature); then a Central starts the update and a
// Peripheral sends LL_CONNECTION_RATE_REQ (the queue may be full, so it is tried again).  A request the peer leaves unanswered is given up after
// `ll_sub.WAIT_US`.  True when something was done.
@satisfies("REQ-BLE-CTL-118")
@tier(embedded)
fn ctl_rate_poll(var c: Controller) -> Bool
    var did = false
    for ls in 0..noble_controller_config.CTL_LINKS
        if c.sub[ls].wait and c.sub[ls].iv != 0 and rate_wait(var c, ls)
            did = true
    did

// One step of the request in slot `ls`; true when something was done.
@tier(embedded)
fn rate_wait(var c: Controller, ls: Int) -> Bool
    if not ctl_conn_active(var c, ls)
        c.sub[ls].wait = false
        c.sub[ls].iv = 0
        return true
    if c.now - c.sub[ls].t0 > ll_sub.WAIT_US
        rate_event(var c, ls, STATUS_RESPONSE_TIMEOUT)
        return true
    if not ll_link.rate_peer_ok(c.links[ls])
        if not c.sub[ls].host
            if ll_link.rate_fetch(var c.links[ls]) == STATUS_SUCCESS
                c.sub[ls].host = true
                return true
        else if ll_link.rate_fetch_over(c.links[ls])
            rate_event(var c, ls, STATUS_UNSUPPORTED_REMOTE)
            return true
        return false
    let imin = ll_rate.pack_lo(c.sub[ls].iv)
    let imax = ll_rate.pack_hi(c.sub[ls].iv)
    if c.links[ls].central
        if c.sub[ls].sent or not ll_link.sub_can_start(var c.links[ls])
            return false
        let iv = ll_rate.pick_interval(imin, imax, 0, ll_link.rate_floor(var c.links[ls]))
        var code = ll_rate.E_UNSUPPORTED_PARAM
        if iv >= 0
            code = rate_launch(var c,
                ls,
                iv,
                c.sub[ls].fmin,
                c.sub[ls].lat,
                c.sub[ls].cont,
                c.sub[ls].to,
                true,
                0,
                -1)
        if code != 0
            rate_event(var c, ls, code)
        else
            c.sub[ls].sent = true
        return true
    if c.sub[ls].sent
        return false
    ll_rate.put_req(var c.links[ls].tmp,
        imin,
        imax,
        c.sub[ls].fmin,
        c.sub[ls].fmax,
        c.sub[ls].lat,
        c.sub[ls].cont,
        c.sub[ls].to,
        0,
        c.links[ls].ev_count,
        0xFFFF)
    if iso_send(c, ls)
        c.sub[ls].sent = true
        return true
    false

// Whether the values of LE Connection Rate Request and LE Set Default Rate Parameters are ones the specification allows (Sections 7.8.154 and
// 7.8.155): the ranges, the factor times (latency + 1) within 500, the continuation number below the greatest factor, the supervision timeout
// above twice the greatest interval times the greatest factor times (latency + 1), and the least connection event length not above the greatest.
@tier(embedded)
fn rate_params_ok(imin: Int, imax: Int, fmin: Int, fmax: Int, lat: Int, cont: Int, to: Int,
                  cmin: Int, cmax: Int) -> Bool
    ll_rate.req_valid(imin, imax, fmin, fmax, lat, cont, to, 0) and cont < fmax and imax * fmax * (lat + 1) < to * 40
        and cmin >= 1 and cmax <= 0x7CFF and cmin <= cmax

// LE Set Default Rate Parameters (Section 7.8.155): what the Host lets the peer ask for on the connections this Controller makes as Central.
@satisfies("REQ-BLE-CTL-118")
@tier(embedded)
fn cmd_le_set_default_rate_parameters(var c: Controller)
    let imin = param_u16(var c, 0)
    let imax = param_u16(var c, 2)
    let fmin = param_u16(var c, 4)
    let fmax = param_u16(var c, 6)
    let lat = param_u16(var c, 8)
    let cont = param_u16(var c, 10)
    let to = param_u16(var c, 12)
    var status = STATUS_SUCCESS
    if not rate_params_ok(imin, imax, fmin, fmax, lat, cont, to, param_u16(var c, 14), param_u16(var c, 16))
        status = STATUS_INVALID_PARAMETERS
    else
        c.sub_def[0].amin = fmin
        c.sub_def[0].amax = fmax
        c.sub_def[0].alat = lat
        c.sub_def[0].acont = cont
        c.sub_def[0].ato = to
        c.sub_def[0].aiv = ll_rate.pack(imin, imax)
    answer_status(var c, OP_LE_SET_DEFAULT_RATE_PARAMETERS, status)

// LE Connection Rate Request (Section 7.8.154): Command Status now and LE Connection Rate Change when the update ends.  The values become what
// the Host allows for this connection.  A Central starts the update, a Peripheral sends LL_CONNECTION_RATE_REQ, each after the Controller has read
// the peer's page 1 if it has not.  The Host's support bit must be set (Unsupported Remote Feature otherwise), a Central in an update of its own
// and a request in progress are Command Disallowed.
@satisfies("REQ-BLE-CTL-118")
@tier(embedded)
fn cmd_le_connection_rate_request(var c: Controller)
    let handle = param_handle(var c)
    let imin = param_u16(var c, 2)
    let imax = param_u16(var c, 4)
    let fmin = param_u16(var c, 6)
    let fmax = param_u16(var c, 8)
    let lat = param_u16(var c, 10)
    let cont = param_u16(var c, 12)
    let to = param_u16(var c, 14)
    let ls = handle_slot(var c, handle)
    var status = STATUS_SUCCESS
    if ls < 0
        status = STATUS_UNKNOWN_CONNECTION
    else if not rate_params_ok(imin, imax, fmin, fmax, lat, cont, to, param_u16(var c, 16), param_u16(var c, 18))
        status = STATUS_INVALID_PARAMETERS
    else if not ll_link.rate_host(c.links[ls])
        status = STATUS_UNSUPPORTED_REMOTE
    else if ll_rate.pick_interval(imin, imax, 0, 0) < 0
        status = ll_rate.E_UNSUPPORTED_PARAM
    else if imax * 125 < ll_link.rate_required(var c.links[ls])
        status = STATUS_UNSUPPORTED_FEATURE
    else if c.sub[ls].wait or c.links[ls].proc == ll_link.PROC_PARAM or c.links[ls].central and ll_link.instant_busy(var c.links[ls])
        status = STATUS_COMMAND_DISALLOWED
    else
        c.sub[ls].amin = fmin
        c.sub[ls].amax = fmax
        c.sub[ls].alat = lat
        c.sub[ls].acont = cont
        c.sub[ls].ato = to
        c.sub[ls].aiv = ll_rate.pack(imin, imax)
        c.sub[ls].iv = ll_rate.pack(imin, imax)
        c.sub[ls].wait = true
        c.sub[ls].sent = false
        c.sub[ls].host = false
        c.sub[ls].t0 = c.now
        c.sub[ls].fmin = fmin
        c.sub[ls].fmax = fmax
        c.sub[ls].lat = lat
        c.sub[ls].cont = cont
        c.sub[ls].to = to
    answer_command_status(var c, OP_LE_CONNECTION_RATE_REQUEST, status)

// LE Read Minimum Supported Connection Interval (Section 7.8.156): 1.25 ms, and no group, because this Controller supports the rounded
// intervals alone.
@satisfies("REQ-BLE-CTL-118")
@tier(embedded)
fn cmd_le_read_minimum_supported_connection_interval(var c: Controller)
    let slot = complete_begin(var c, OP_LE_READ_MINIMUM_SUPPORTED_CONNECTION_INTERVAL, STATUS_SUCCESS)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put(var c.pool, slot, ll_rate.MIN_SUPPORTED)
    let _b = ctl_pool.pool_put(var c.pool, slot, 0)
    complete_send(var c, slot)

// LE Set Host Feature [v2] (Section 7.8.115): the same command with a two-octet bit number.
@satisfies("REQ-BLE-CTL-118")
@tier(embedded)
fn cmd_le_set_host_feature_v2(var c: Controller)
    let status = host_feature(var c, param_u16(var c, 0), h4_rx.h4_param(var c.rx, 2))
    answer_status(var c, OP_LE_SET_HOST_FEATURE_V2, status)

// Run the command of Connection Rate with `opcode`.
@tier(embedded)
fn rate_dispatch(var c: Controller, opcode: Int)
    match opcode
        0x2097 => cmd_le_set_host_feature_v2(var c)
        0x20a1 => cmd_le_connection_rate_request(var c)
        0x20a2 => cmd_le_set_default_rate_parameters(var c)
        _      => cmd_le_read_minimum_supported_connection_interval(var c)

// ── Frame Space Update ──────────────────────────────────────────────

// The request of the Host that is out is kept in the record `c.sub_def[0]`, the default of the Subrate limits, whose request fields a connection
// never reads (a new link takes only its `a*` and `aiv` fields): `wait` says a request is out, `sent` that LL_FRAME_SPACE_REQ has gone, `t0` is
// the time of the command, `to` the slot of the link and `lat` and `cont` the PHYs and the spacing types of the command.  One request is out
// at a time, on any link.

// LE Frame Space Update Complete ([Vol 4] Part E, Section 7.7.65.48) for the link in slot `ls`: the status, the Host as the initiator, the
// frame space in use and the PHYs and spacing types the answer names.  The Host that waited for its request is answered, and the wait ends.
@satisfies("REQ-BLE-CTL-119")
@tier(embedded)
fn fs_event(var c: Controller, ls: Int, status: Int, phys: Int, types: Int)
    c.sub_def[0].wait = false
    if not le_event_enabled(var c, SUB_LE_FRAME_SPACE_UPDATE_COMPLETE)
        return
    let slot = meta_begin(var c, SUB_LE_FRAME_SPACE_UPDATE_COMPLETE)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put(var c.pool, slot, status)
    let _b = ctl_pool.pool_put_u16(var c.pool, slot, c.links[ls].handle)
    let _c = ctl_pool.pool_put(var c.pool, slot, 0)
    let _d = ctl_pool.pool_put_u16(var c.pool, slot, ll_fs.FS_US)
    let _e = ctl_pool.pool_put(var c.pool, slot, phys)
    let _f = ctl_pool.pool_put_u16(var c.pool, slot, types)
    event_send(var c, slot)

// A Frame Space Update PDU arrived on the link in slot `ls`.  LL_FRAME_SPACE_REQ is answered at once (Section 5.1.30): with LL_REJECT_EXT_IND
// for a request that names no PHY or no spacing type or has a range the wrong way round (Invalid LL Parameters), for a range that excludes the
// 150 microseconds this Controller keeps (Unsupported Feature or Parameter Value), and, in the Central, for a request that comes while its own is
// out (LL Procedure Collision, Section 5.3; the Peripheral in that case answers the Central's request and takes the rejection of its own);
// otherwise with LL_FRAME_SPACE_RSP, FS 150 and no PHY and no spacing type, since nothing changes.  The answer to the request the Host made,
// or its refusal, completes the Host's command.
@satisfies("REQ-BLE-CTL-119")
@tier(embedded)
fn fs_rx(var c: Controller, ls: Int, op: Int, var rx: Pdu)
    let mine = c.sub_def[0].wait and c.sub_def[0].to == ls
    if op == ll_data.OP_REJECT_EXT_IND
        if mine
            fs_event(var c, ls, ll_data.dpdu_byte(var rx, 2), 0, 0)
        return
    if op == ll_data.OP_UNKNOWN_RSP
        if mine
            fs_event(var c, ls, STATUS_UNSUPPORTED_REMOTE, 0, 0)
        return
    if op == ll_data.OP_FRAME_SPACE_RSP
        if mine and c.sub_def[0].sent
            let phys = ll_data.dpdu_byte(var rx, 3)
            let types = ll_sub.get16(var rx, 4)
            if ll_fs.rsp_valid(ll_sub.get16(var rx, 1), phys, types, c.sub_def[0].lat, c.sub_def[0].cont)
                fs_event(var c, ls, STATUS_SUCCESS, phys, types)
            else
                fs_event(var c, ls, ll_fs.E_INVALID_PARAMS, 0, 0)
        return
    let code = ll_fs.refusal(ll_sub.get16(var rx, 1),
        ll_sub.get16(var rx, 3),
        ll_data.dpdu_byte(var rx, 5),
        ll_sub.get16(var rx, 6))
    if code == 0 and mine and c.links[ls].central
        iso_reject(var c, ls, op, ll_fs.E_COLLISION)
    else if code != 0
        iso_reject(var c, ls, op, code)
    else
        ll_fs.put_rsp(var c.links[ls].tmp, ll_fs.FS_US, 0, 0)
        let _s = iso_send(c, ls)

// The work of Frame Space Update that is not in a radio event: the request the Host asked for goes out (the queue may be full, so it is tried
// again), and one the peer leaves unanswered is given up after `ll_sub.WAIT_US`, as is one on a connection that ended.  True when something
// was done.
@satisfies("REQ-BLE-CTL-119")
@tier(embedded)
fn ctl_fs_poll(var c: Controller) -> Bool
    if not c.sub_def[0].wait
        return false
    let ls = c.sub_def[0].to
    if not ctl_conn_active(var c, ls)
        c.sub_def[0].wait = false
        return true
    if c.now - c.sub_def[0].t0 > ll_sub.WAIT_US
        fs_event(var c, ls, STATUS_RESPONSE_TIMEOUT, 0, 0)
        return true
    if c.sub_def[0].sent
        return false
    ll_fs.put_req(var c.links[ls].tmp, ll_fs.FS_US, ll_fs.FS_US, c.sub_def[0].lat, c.sub_def[0].cont)
    if iso_send(c, ls)
        c.sub_def[0].sent = true
        return true
    false

// LE Frame Space Update (Section 7.8.151): Command Status now and LE Frame Space Update Complete when the procedure ends.  The command names a
// range, PHYs and spacing types; this Controller asks the peer for the 150 microseconds it keeps, so the range is cut to that value (a
// Frame_Space_Max below the value in use gives the same), and a range above it ends in Unsupported Feature or Parameter Value.  A bit beyond
// the PHYs and spacing types, and LE Coded on a radio without it, is Unsupported Feature or Parameter Value; a peer known to lack the feature
// is Unsupported Remote Feature; a request in progress is Command Disallowed.
@satisfies("REQ-BLE-CTL-119")
@tier(embedded)
fn cmd_le_frame_space_update(var c: Controller)
    let ls = handle_slot(var c, param_handle(var c))
    let fmin = param_u16(var c, 2)
    let fmax = param_u16(var c, 4)
    let phys = h4_rx.h4_param(var c.rx, 6)
    let types = param_u16(var c, 7)
    var status = STATUS_SUCCESS
    if ls < 0
        status = STATUS_UNKNOWN_CONNECTION
    else if fmin > fmax or fmax > ll_fs.FS_MAX_US or phys == 0 or types == 0
        status = STATUS_INVALID_PARAMETERS
    else if (phys & ~ll_fs.PHYS_MASK) != 0 or (types & ~ll_fs.TYPES_MASK) != 0 or (phys & 4) != 0 and not c.coded
        status = STATUS_UNSUPPORTED_FEATURE
    else if ll_link.fs_peer_lacks(c.links[ls])
        status = STATUS_UNSUPPORTED_REMOTE
    else if c.sub_def[0].wait
        status = STATUS_COMMAND_DISALLOWED
    else
        c.sub_def[0].wait = true
        c.sub_def[0].sent = false
        c.sub_def[0].t0 = c.now
        c.sub_def[0].to = ls
        c.sub_def[0].lat = phys
        c.sub_def[0].cont = types
    answer_command_status(var c, OP_LE_FRAME_SPACE_UPDATE, status)
    if status == STATUS_SUCCESS and fmin > ll_fs.FS_US
        fs_event(var c, ls, STATUS_UNSUPPORTED_FEATURE, 0, 0)

// ── The commands ─────────────────────────────────────────────────────

// LE Read Buffer Size [v2] (Section 7.8.2): the ACL buffers as LE Read Buffer Size reports them, and the ISO buffers: the
// longest ISO_Data_Load of one HCI ISO Data packet and the packets the Controller holds for the Host.
@satisfies("REQ-BLE-CTL-057")
@tier(embedded)
fn cmd_le_read_buffer_size_v2(var c: Controller)
    let slot = complete_begin(var c, OP_LE_READ_BUFFER_SIZE_V2, STATUS_SUCCESS)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put_u16(var c.pool, slot, h4_rx.LL_ACL_OCTETS)
    let _b = ctl_pool.pool_put(var c.pool, slot, ACL_BUFFERS)
    let _c = ctl_pool.pool_put_u16(var c.pool, slot, ll_iso.ISO_LOAD)
    let _d = ctl_pool.pool_put(var c.pool, slot, ll_iso.ISO_BUFFERS)
    complete_send(var c, slot)

// LE Set Host Feature [v1] (Section 7.8.115): the bits the Host controls here are 32, Connected Isochronous Stream
// (Host Support), which a Peripheral must have before it accepts a request and a Central before it creates a stream;
// 38, Connection Subrating (Host Support); and 73, Shorter Connection Intervals (Host Support).
// The command is refused while the Controller has a connection.
@satisfies("REQ-BLE-CTL-057")
@tier(embedded)
fn cmd_le_set_host_feature(var c: Controller)
    let status = host_feature(var c, h4_rx.h4_param(var c.rx, 0), h4_rx.h4_param(var c.rx, 1))
    answer_status(var c, OP_LE_SET_HOST_FEATURE, status)

// Set the Host-controlled feature bit `bit` to `value`; the status of the command.
@satisfies("REQ-BLE-CTL-057")
@tier(embedded)
fn host_feature(var c: Controller, bit: Int, value: Int) -> Int
    if bit != 32 and not (bit == 38 and ctl_limits.sub_on()) and not (bit == 73 and ctl_limits.rate_on()) and not (bit == ll_cs.FEATURE_CS_HOST_SUPPORT and ctl_limits.cs_on()) or value > 1
        return STATUS_UNSUPPORTED_FEATURE
    if links_live(var c)
        return STATUS_COMMAND_DISALLOWED
    if bit == 38
        c.host_sub = value == 1
        for slot in 0..noble_controller_config.CTL_LINKS
            ll_link.link_set_host_sub(var c.links[slot], c.host_sub)
    else if ctl_limits.rate_on() and bit == 73
        for slot in 0..noble_controller_config.CTL_LINKS
            ll_link.link_set_host_rate(var c.links[slot], value == 1)
    else if ctl_limits.cs_on() and bit == ll_cs.FEATURE_CS_HOST_SUPPORT
        if noble_controller_config.CTL_CS > 0
            ctl_cs_set_host(var c, value == 1)
    else
        c.host_iso = value == 1
        for slot in 0..noble_controller_config.CTL_LINKS
            ll_link.link_set_host_iso(var c.links[slot], c.host_iso)
    STATUS_SUCCESS

// The status of LE Set CIG Parameters Test for the parameters in the command, before anything is changed: the
// group, the streams (each against the ranges of `ll_iso.cfg_check`) and the room for the new ones.  The command's
// octets: CIG_ID, SDU_Interval_C_To_P (3), SDU_Interval_P_To_C (3), FT_C_To_P, FT_P_To_C, ISO_Interval (2),
// Worst_Case_SCA, Packing, Framing, CIS_Count, and for each stream 14 octets.
@satisfies("REQ-BLE-CTL-056")
@tier(embedded)
fn cig_test_check(var c: Controller, n: Int) -> Int
    let cig_id = h4_rx.h4_param(var c.rx, 0)
    let ft_c = h4_rx.h4_param(var c.rx, 7)
    let ft_p = h4_rx.h4_param(var c.rx, 8)
    let iso_int = param_u16(var c, 9)
    if cig_id > 0xEF or ft_c < 1 or ft_p < 1 or iso_int < 4 or iso_int > 3200
        return STATUS_INVALID_PARAMETERS
    if h4_rx.h4_param(var c.rx, 11) > 7 or h4_rx.h4_param(var c.rx, 12) > 1
        return STATUS_INVALID_PARAMETERS
    let sdu_c = h4_rx.h4_param(var c.rx, 1) | (h4_rx.h4_param(var c.rx, 2) << 8) | (h4_rx.h4_param(var c.rx, 3) << 16)
    let sdu_p = h4_rx.h4_param(var c.rx, 4) | (h4_rx.h4_param(var c.rx, 5) << 8) | (h4_rx.h4_param(var c.rx, 6) << 16)
    if sdu_c < 255 or sdu_c > 0xFFFFF or sdu_p < 255 or sdu_p > 0xFFFFF
        return STATUS_INVALID_PARAMETERS
    // Framing: 0 unframed, 1 framed in Segmentable mode, 2 framed in Unsegmented mode.
    if h4_rx.h4_param(var c.rx, 13) > 2
        return STATUS_INVALID_PARAMETERS
    let g = cig_slot(var c, cig_id)
    var free_cigs = 0
    for k in 0..ctl_limits.cig_slots()
        if not c.cigs[k].used
            free_cigs = free_cigs + 1
    if g >= 0 and c.cigs[g].state != ll_iso.G_CONFIGURABLE
        return STATUS_COMMAND_DISALLOWED
    if g < 0 and free_cigs == 0
        return ll_iso.STATUS_MEMORY_CAPACITY
    var fresh = 0
    for k in 0..n
        let at = 15 + 14 * k
        let cis_id = h4_rx.h4_param(var c.rx, at)
        if cis_id > 0xEF
            return STATUS_INVALID_PARAMETERS
        for j in 0..k
            if h4_rx.h4_param(var c.rx, 15 + 14 * j) == cis_id
                return STATUS_INVALID_PARAMETERS
        let have = cis_find(var c, cig_id, cis_id)
        if have < 0
            fresh = fresh + 1
        else if c.cis[have].state != ll_iso.S_CONFIG
            return STATUS_COMMAND_DISALLOWED
        let st = ll_iso.cfg_check(h4_rx.h4_param(var c.rx, at + 1), h4_rx.h4_param(var c.rx, at + 12), h4_rx.h4_param(var c.rx, at + 13),
            param_u16(var c, at + 6), param_u16(var c, at + 8), param_u16(var c, at + 2), param_u16(var c, at + 4), ft_c, ft_p,
            h4_rx.h4_param(var c.rx, at + 10), h4_rx.h4_param(var c.rx, at + 11), iso_int, c.radio)
        if st != 0
            return st
        // A framed direction has a PDU that starts an SDU: a Segmentation Header, a Time_Offset and an octet; in Unsegmented mode the SDU of
        // Max_SDU, whole, with them.
        if h4_rx.h4_param(var c.rx, 13) >= 1
            if h4_rx.h4_param(var c.rx, at + 12) > 0 and param_u16(var c, at + 6) < ll_iso.FR_START_MIN or h4_rx.h4_param(var c.rx, at + 13) > 0 and param_u16(var c, at + 8) < ll_iso.FR_START_MIN
                return STATUS_INVALID_PARAMETERS
        if h4_rx.h4_param(var c.rx, 13) == 2
            if h4_rx.h4_param(var c.rx, at + 12) > 0 and param_u16(var c, at + 6) < ll_iso.FR_HEADER + ll_iso.FR_TOFF + param_u16(var c, at + 2) or h4_rx.h4_param(var c.rx, at + 13) > 0 and param_u16(var c, at + 8) < ll_iso.FR_HEADER + ll_iso.FR_TOFF + param_u16(var c, at + 4)
                return STATUS_INVALID_PARAMETERS
    var free_cis = 0
    for k in 0..ctl_limits.cis_slots()
        if c.cis[k].state == ll_iso.S_FREE
            free_cis = free_cis + 1
    if fresh > free_cis
        return ll_iso.STATUS_MEMORY_CAPACITY
    0

// Store the configuration of the streams of LE Set CIG Parameters Test, after `cig_test_check` agreed.
@satisfies("REQ-BLE-CTL-056")
@tier(embedded)
fn cig_test_commit(var c: Controller, n: Int)
    let cig_id = h4_rx.h4_param(var c.rx, 0)
    var g = cig_slot(var c, cig_id)
    if g < 0
        for k in 0..ctl_limits.cig_slots()
            if g < 0 and not c.cigs[k].used
                g = k
        c.cigs[g].used = true
        c.cigs[g].cig_id = cig_id
        c.cigs[g].state = ll_iso.G_CONFIGURABLE
        // A group is not arranged until its first stream is created: the grid of an earlier group in this slot is not its own.
        c.cigs[g].ref_ok = false
        c.cigs[g].ref_t = 0
    c.cigs[g].sdu_int_c = h4_rx.h4_param(var c.rx, 1) | (h4_rx.h4_param(var c.rx, 2) << 8) | (h4_rx.h4_param(var c.rx, 3) << 16)
    c.cigs[g].sdu_int_p = h4_rx.h4_param(var c.rx, 4) | (h4_rx.h4_param(var c.rx, 5) << 8) | (h4_rx.h4_param(var c.rx, 6) << 16)
    c.cigs[g].ft_c = h4_rx.h4_param(var c.rx, 7)
    c.cigs[g].ft_p = h4_rx.h4_param(var c.rx, 8)
    c.cigs[g].iso_int = param_u16(var c, 9)
    c.cigs[g].sca = h4_rx.h4_param(var c.rx, 11)
    c.cigs[g].packing = h4_rx.h4_param(var c.rx, 12)
    c.cigs[g].framing = h4_rx.h4_param(var c.rx, 13)
    c.cigs[g].test = true
    for k in 0..n
        let at = 15 + 14 * k
        let cis_id = h4_rx.h4_param(var c.rx, at)
        var i = cis_find(var c, cig_id, cis_id)
        if i < 0
            i = cis_free_slot(var c)
        let pdu_c = param_u16(var c, at + 6)
        let pdu_p = param_u16(var c, at + 8)
        let phy = ll_iso.pick_phy(h4_rx.h4_param(var c.rx, at + 10), h4_rx.h4_param(var c.rx, at + 11))
        c.cis[i].state = ll_iso.S_CONFIG
        c.cis[i].central = true
        c.cis[i].cig_id = cig_id
        c.cis[i].cis_id = cis_id
        c.cis[i].framed = h4_rx.h4_param(var c.rx, 13) >= 1
        c.cis[i].unseg = h4_rx.h4_param(var c.rx, 13) == 2
        c.cis[i].phy = phy
        c.cis[i].sdu_int_c = c.cigs[g].sdu_int_c
        c.cis[i].sdu_int_p = c.cigs[g].sdu_int_p
        c.cis[i].nse = h4_rx.h4_param(var c.rx, at + 1)
        c.cis[i].max_sdu_c = param_u16(var c, at + 2)
        c.cis[i].max_sdu_p = param_u16(var c, at + 4)
        c.cis[i].max_pdu_c = pdu_c
        c.cis[i].max_pdu_p = pdu_p
        c.cis[i].bn_c = h4_rx.h4_param(var c.rx, at + 12)
        c.cis[i].bn_p = h4_rx.h4_param(var c.rx, at + 13)
        c.cis[i].ft_c = c.cigs[g].ft_c
        c.cis[i].ft_p = c.cigs[g].ft_p
        c.cis[i].iso_int = c.cigs[g].iso_int
        c.cis[i].sub_int = ll_iso.plan_sub_interval(c.cis[i].nse, ll_iso.plan_slot_us(c.radio, phy, pdu_c, pdu_p))

// LE Set CIG Parameters Test (Section 7.8.98): create the group or change the configuration of its streams, with
// every parameter given.  The answer carries the handle of each stream.
@satisfies("REQ-BLE-CTL-056")
@tier(embedded)
fn cmd_le_set_cig_parameters_test(var c: Controller)
    let len = h4_rx.h4_param_len(var c.rx)
    let n = h4_rx.h4_param(var c.rx, 14)
    var status = STATUS_INVALID_PARAMETERS
    if len >= 15 and len == 15 + 14 * n
        status = cig_test_check(var c, n)
    if status == STATUS_SUCCESS
        cig_test_commit(var c, n)
    let slot = complete_begin(var c, OP_LE_SET_CIG_PARAMETERS_TEST, status)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put(var c.pool, slot, h4_rx.h4_param(var c.rx, 0))
    if status != STATUS_SUCCESS
        let _b = ctl_pool.pool_put(var c.pool, slot, 0)
        complete_send(var c, slot)
        return
    let _c = ctl_pool.pool_put(var c.pool, slot, n)
    for k in 0..n
        let i = cis_find(var c, h4_rx.h4_param(var c.rx, 0), h4_rx.h4_param(var c.rx, 15 + 14 * k))
        let _d = ctl_pool.pool_put_u16(var c.pool, slot, c.cis[i].handle)
    complete_send(var c, slot)

// LE Remove CIG (Section 7.8.100): the group and the configuration of its streams go; a group with a stream
// that is created or being created is active and stays.
@satisfies("REQ-BLE-CTL-056")
@tier(embedded)
fn cmd_le_remove_cig(var c: Controller)
    let cig_id = h4_rx.h4_param(var c.rx, 0)
    var status = STATUS_SUCCESS
    let g = cig_slot(var c, cig_id)
    if g < 0
        status = STATUS_UNKNOWN_CONNECTION
    else if c.cigs[g].state == ll_iso.G_ACTIVE
        status = STATUS_COMMAND_DISALLOWED
    else
        for i in 0..ctl_limits.cis_slots()
            if c.cis[i].state != ll_iso.S_FREE and c.cis[i].state != ll_iso.S_CONFIG and c.cis[i].central and c.cis[i].cig_id == cig_id
                status = STATUS_COMMAND_DISALLOWED
        if status == STATUS_SUCCESS
            for i in 0..ctl_limits.cis_slots()
                if c.cis[i].state == ll_iso.S_CONFIG and c.cis[i].cig_id == cig_id
                    c.cis[i].dp_in = false
                    c.cis[i].dp_out = false
                    ll_iso.cis_reset_run(var c.cis[i], ll_iso.S_FREE)
            c.cigs[g].used = false
            c.cigs[g].ref_ok = false
            c.cigs[g].ref_t = 0
    let slot = complete_begin(var c, OP_LE_REMOVE_CIG, status)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put(var c.pool, slot, cig_id)
    complete_send(var c, slot)

// LE Accept CIS Request (Section 7.8.101): the Peripheral's Host takes the stream of an LE CIS Request event.  The
// answer is Command Status; LL_CIS_RSP follows (`ctl_iso_poll`) and LE CIS Established when the stream is up.
@satisfies("REQ-BLE-CTL-058")
@tier(embedded)
fn cmd_le_accept_cis_request(var c: Controller)
    let i = cis_slot(var c, param_handle(var c))
    if i < 0
        answer_command_status(var c, OP_LE_ACCEPT_CIS_REQUEST, STATUS_UNKNOWN_CONNECTION)
    else if c.cis[i].state != ll_iso.S_REQUESTED or c.cis[i].central
        answer_command_status(var c, OP_LE_ACCEPT_CIS_REQUEST, STATUS_COMMAND_DISALLOWED)
    else
        c.cis[i].state = ll_iso.S_ACCEPTED
        c.cis[i].owed = c.cis[i].owed | ll_iso.EV_SEND_RSP
        answer_command_status(var c, OP_LE_ACCEPT_CIS_REQUEST, STATUS_SUCCESS)

// LE Reject CIS Request (Section 7.8.102): the Central is told with LL_REJECT_EXT_IND and the handle is deleted.
@satisfies("REQ-BLE-CTL-058")
@tier(embedded)
fn cmd_le_reject_cis_request(var c: Controller)
    let handle = param_handle(var c)
    let reason = h4_rx.h4_param(var c.rx, 2)
    let i = cis_slot(var c, handle)
    var status = STATUS_SUCCESS
    if i < 0
        status = STATUS_UNKNOWN_CONNECTION
    else if c.cis[i].state != ll_iso.S_REQUESTED or c.cis[i].central
        status = STATUS_COMMAND_DISALLOWED
    else
        c.cis_log.rejected = c.cis_log.rejected + 1
        c.cis_log.code = reason
        c.cis_log.why = ll_iso.WHY_HOST_REJECT
        iso_reject(var c, c.cis[i].acl, ll_data.OP_CIS_REQ, reason)
        cis_release(var c, i)
    answer_handle(var c, OP_LE_REJECT_CIS_REQUEST, status, handle)

// The direction of a data path in the terms of the stream's roles: `input` is the Host to the Controller, which a Central
// sends to the Peripheral and a Peripheral to the Central.  The burst number of that direction, 0 when none flows.
@tier(embedded)
fn dp_bn(var c: Controller, i: Int, input: Bool) -> Int
    if input == c.cis[i].central
        c.cis[i].bn_c
    else
        c.cis[i].bn_p

// LE Setup ISO Data Path (Section 7.8.109): only the HCI path, and the codec is carried as the Host gave it
// (the Controller does not touch the data).  A Peripheral's stream must have been accepted.
@satisfies("REQ-BLE-CTL-057")
@tier(embedded)
fn cmd_le_setup_iso_data_path(var c: Controller)
    let handle = param_handle(var c)
    let dir = h4_rx.h4_param(var c.rx, 2)
    let path_id = h4_rx.h4_param(var c.rx, 3)
    let cfg = h4_rx.h4_param(var c.rx, 12)
    var status = STATUS_SUCCESS
    let i = cis_slot(var c, handle)
    var j = -1
    if i < 0 and ctl_limits.big_on()
        j = bis_slot(var c, handle)
    if h4_rx.h4_param_len(var c.rx) != 13 + cfg
        status = STATUS_INVALID_PARAMETERS
    else if j >= 0
        // A broadcast stream: the Isochronous Broadcaster's takes data from the Host (input), the Synchronized Receiver's gives it (output).
        if dir > 1 or path_id != 0
            status = STATUS_COMMAND_DISALLOWED
        else if c.bis[j].central and dir != 0 or not c.bis[j].central and dir != 1
            status = STATUS_COMMAND_DISALLOWED
        else if dir == 0 and (c.bis[j].dp_in or ll_iso.test_tx_type(var c.bis[j]) >= 0) or dir == 1 and (c.bis[j].dp_out or ll_iso.test_rx_type(var c.bis[j]) >= 0)
            status = STATUS_COMMAND_DISALLOWED
        else if dir == 0
            c.bis[j].dp_in = true
        else
            c.bis[j].dp_out = true
    else if i < 0 or not c.cis[i].central and c.cis[i].state < ll_iso.S_ACCEPTED
        status = STATUS_UNKNOWN_CONNECTION
    else if dir > 1 or path_id != 0
        status = STATUS_COMMAND_DISALLOWED
    else if dp_bn(var c, i, dir == 0) == 0
        status = STATUS_COMMAND_DISALLOWED
    else if dir == 0 and (c.cis[i].dp_in or ll_iso.test_tx_type(var c.cis[i]) >= 0)
        status = STATUS_COMMAND_DISALLOWED
    else if dir == 1 and (c.cis[i].dp_out or ll_iso.test_rx_type(var c.cis[i]) >= 0)
        status = STATUS_COMMAND_DISALLOWED
    else if dir == 0
        c.cis[i].dp_in = true
    else
        c.cis[i].dp_out = true
    answer_handle(var c, OP_LE_SETUP_ISO_DATA_PATH, status, handle)

// LE Remove ISO Data Path (Section 7.8.110): bit 0 of the direction removes the input path, bit 1 the output path.
@satisfies("REQ-BLE-CTL-057")
@tier(embedded)
fn cmd_le_remove_iso_data_path(var c: Controller)
    let handle = param_handle(var c)
    let dirs = h4_rx.h4_param(var c.rx, 2)
    var status = STATUS_SUCCESS
    let i = cis_slot(var c, handle)
    var j = -1
    if i < 0 and ctl_limits.big_on()
        j = bis_slot(var c, handle)
    if dirs == 0 or dirs > 3
        status = STATUS_INVALID_PARAMETERS
    else if j >= 0
        if (dirs & 1) != 0 and not c.bis[j].dp_in or (dirs & 2) != 0 and not c.bis[j].dp_out
            status = STATUS_COMMAND_DISALLOWED
        else
            if (dirs & 1) != 0
                c.bis[j].dp_in = false
            if (dirs & 2) != 0
                c.bis[j].dp_out = false
    else if i < 0
        status = STATUS_UNKNOWN_CONNECTION
    else if (dirs & 1) != 0 and not c.cis[i].dp_in or (dirs & 2) != 0 and not c.cis[i].dp_out
        status = STATUS_COMMAND_DISALLOWED
    else
        if (dirs & 1) != 0
            c.cis[i].dp_in = false
        if (dirs & 2) != 0
            c.cis[i].dp_out = false
    answer_handle(var c, OP_LE_REMOVE_ISO_DATA_PATH, status, handle)

// LE Read ISO Link Quality (Section 7.8.116): the seven counters of the stream.  TX_Last_Subevent_Packets is not counted.
@satisfies("REQ-BLE-CTL-059")
@tier(embedded)
fn cmd_le_read_iso_link_quality(var c: Controller)
    let handle = param_handle(var c)
    var i = cis_slot(var c, handle)
    if i < 0 and ctl_limits.big_on()
        let j = bis_slot(var c, handle)
        if j >= 0
            cmd_le_read_bis_link_quality(var c, j)
            return
    var status = STATUS_SUCCESS
    if i < 0 or not (cis_running(var c, i) or c.cis[i].state == ll_iso.S_CLOSING)
        status = STATUS_UNKNOWN_CONNECTION
    let slot = complete_begin(var c, OP_LE_READ_ISO_LINK_QUALITY, status)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put_u16(var c.pool, slot, handle)
    var v0 = 0
    var v1 = 0
    var v3 = 0
    var v4 = 0
    var v5 = 0
    var v6 = 0
    if status == STATUS_SUCCESS
        v0 = c.cis[i].n_unack
        v1 = c.cis[i].n_flush_tx
        v3 = c.cis[i].n_retx
        v4 = c.cis[i].n_crc
        v5 = c.cis[i].n_flush_rx
        v6 = c.cis[i].n_dup
    put_u32(var c, slot, v0)
    put_u32(var c, slot, v1)
    put_u32(var c, slot, 0)
    put_u32(var c, slot, v3)
    put_u32(var c, slot, v4)
    put_u32(var c, slot, v5)
    put_u32(var c, slot, v6)
    complete_send(var c, slot)

// Whether the stream in BIS slot `j` is one of a group the Controller is synchronized to: the command of a Synchronized Receiver only.
@tier(embedded)
fn bis_synchronized(var c: Controller, j: Int) -> Bool
    for g in 0..ctl_limits.big_slots()
        if c.bigs[g].state == ll_big.B_UP and not c.bigs[g].broadcaster and j >= c.bigs[g].bis0 and j < c.bigs[g].bis0 + c.bigs[g].nrx
            return true
    false

// LE Read ISO Link Quality of a BIS (Section 7.8.116): the command is the Synchronized Receiver's, so the handle of an Isochronous Broadcaster's stream
// is an Unknown Connection Identifier.  Nothing is acknowledged, so the transmit counters are 0; a receiver's are the packets with a CRC error, the
// payloads that did not arrive by the end of their event (RX_Unreceived_Packets) and 0 duplicates.
@satisfies("REQ-BLE-CTL-059")
@satisfies("REQ-BLE-CTL-112")
@tier(embedded)
fn cmd_le_read_bis_link_quality(var c: Controller, j: Int)
    var status = STATUS_SUCCESS
    if not bis_synchronized(var c, j)
        status = STATUS_UNKNOWN_CONNECTION
    let slot = complete_begin(var c, OP_LE_READ_ISO_LINK_QUALITY, status)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put_u16(var c.pool, slot, c.bis[j].handle)
    var crc = 0
    var lost = 0
    if status == STATUS_SUCCESS
        crc = c.bis[j].n_crc
        lost = c.bis[j].n_flush_rx
    put_u32(var c, slot, 0)
    put_u32(var c, slot, 0)
    put_u32(var c, slot, 0)
    put_u32(var c, slot, 0)
    put_u32(var c, slot, crc)
    put_u32(var c, slot, lost)
    put_u32(var c, slot, 0)
    complete_send(var c, slot)

// Append `v` as four octets, least significant first.
@tier(embedded)
fn put_u32(var c: Controller, slot: Int, v: Int)
    let _a = ctl_pool.pool_put_u16(var c.pool, slot, v & 0xFFFF)
    let _b = ctl_pool.pool_put_u16(var c.pool, slot, (v >>> 16) & 0xFFFF)

// The Packet_Sequence_Number of LE Read ISO TX Sync for the stream `x`: the number of the last SDU the Host sent (the Controller numbers the SDUs
// it takes from 0, in the order they come).
@tier(embedded)
fn tx_sync_seq(var x: Cis) -> Int
    (x.sdu_in - 1) & 0xFFFF

// The CIG reference point or BIG anchor point of the event the last SDU of the stream `x` went in, on the Controller's clock (32 bits).  An SDU in
// unframed payloads is in the event of its last payload; a framed one in the event of the payload that holds its first segment.
@tier(embedded)
fn tx_sync_stamp(var x: Cis) -> Int
    let bn = ll_iso.tx_bn(var x)
    let up = ll_iso.tx_upps(var x)
    var e = x.ev
    if x.framed and bn > 0
        e = x.fo_num / bn
    else if bn > 0 and up > 0
        e = (x.tx_wr - 1) / bn
    ll_iso.cig_ref(var x, e) & 0xFFFFFFFF

// The Time_Offset of LE Read ISO TX Sync: the offset of a framed SDU's first segment, 0 for unframed PDUs.
@tier(embedded)
fn tx_sync_offset(var x: Cis) -> Int
    if x.framed and ll_iso.tx_bn(var x) > 0
        return x.fo_off
    0

// LE Read ISO TX Sync (Section 7.8.96): the sequence number of the last SDU the Host sent on the stream, the CIG reference point or BIG anchor point
// of the event it went in, and its Time_Offset (0 for unframed PDUs).  A CIS or a BIS: Unknown Connection Identifier for a handle that is neither,
// Command Disallowed for a stream that does not transmit SDUs (a Synchronized Receiver's BIS, or one with no input path) or that has taken none.
@satisfies("REQ-BLE-CTL-057")
@satisfies("REQ-BLE-CTL-112")
@tier(embedded)
fn cmd_le_read_iso_tx_sync(var c: Controller)
    let handle = param_handle(var c)
    let i = cis_slot(var c, handle)
    var j = -1
    if i < 0 and ctl_limits.big_on()
        j = bis_slot(var c, handle)
    var status = STATUS_SUCCESS
    if i >= 0
        if not c.cis[i].dp_in or c.cis[i].sdu_in == 0
            status = STATUS_COMMAND_DISALLOWED
    else if j >= 0
        if not c.bis[j].central or not c.bis[j].dp_in or c.bis[j].sdu_in == 0
            status = STATUS_COMMAND_DISALLOWED
    else
        status = STATUS_UNKNOWN_CONNECTION
    let slot = complete_begin(var c, OP_LE_READ_ISO_TX_SYNC, status)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put_u16(var c.pool, slot, handle)
    var seq = 0
    var ts = 0
    var toff = 0
    if status == STATUS_SUCCESS
        if i >= 0
            seq = tx_sync_seq(var c.cis[i])
            ts = tx_sync_stamp(var c.cis[i])
            toff = tx_sync_offset(var c.cis[i])
        else
            seq = tx_sync_seq(var c.bis[j])
            ts = tx_sync_stamp(var c.bis[j])
            toff = tx_sync_offset(var c.bis[j])
    let _b = ctl_pool.pool_put_u16(var c.pool, slot, seq)
    put_u32(var c, slot, ts)
    let _c = ctl_pool.pool_put_u16(var c.pool, slot, toff & 0xFFFF)
    let _d = ctl_pool.pool_put(var c.pool, slot, (toff >>> 16) & 0xFF)
    complete_send(var c, slot)

// ── ISO test mode (Sections 7.8.111 to 7.8.114; [Vol 6] Part B, Section 7) ──

// LE ISO Transmit Test on the stream `x`: the Controller generates its SDUs.  Unsupported Feature or Parameter Value for a stream that transmits nothing (a CIS
// whose transmit BN is zero, a Synchronized Receiver's BIS) and for a Payload_Type that needs the 4 octets of the counter in a stream of smaller SDUs, Command Disallowed
// for one with an input data path, Invalid HCI Command Parameters for a reserved Payload_Type.
@satisfies("REQ-BLE-CTL-113")
@tier(embedded)
fn iso_test_tx(var x: Cis, kind: Int) -> Int
    if ll_iso.tx_bn(var x) == 0
        return STATUS_UNSUPPORTED_FEATURE
    if x.dp_in
        return STATUS_COMMAND_DISALLOWED
    if kind > 2
        return STATUS_INVALID_PARAMETERS
    if kind > 0 and ll_iso.tx_sdu(var x) < 4
        return STATUS_UNSUPPORTED_FEATURE
    ll_iso.test_tx_start(var x, kind)
    STATUS_SUCCESS

// LE ISO Receive Test on the stream `x`: the Controller counts the SDUs it receives, from zero.
@satisfies("REQ-BLE-CTL-113")
@tier(embedded)
fn iso_test_rx(var x: Cis, kind: Int) -> Int
    if ll_iso.rx_bn(var x) == 0
        return STATUS_UNSUPPORTED_FEATURE
    if x.dp_out
        return STATUS_COMMAND_DISALLOWED
    if kind > 2
        return STATUS_INVALID_PARAMETERS
    ll_iso.test_rx_start(var x, kind)
    STATUS_SUCCESS

// The stream with the handle `handle` takes the test command `opcode` (`kind` the Payload_Type): a CIS that runs or a BIS.
@tier(embedded)
fn iso_test_start(var c: Controller, opcode: Int)
    let handle = param_handle(var c)
    let kind = h4_rx.h4_param(var c.rx, 2)
    let i = cis_slot(var c, handle)
    var j = -1
    if i < 0 and ctl_limits.big_on()
        j = bis_slot(var c, handle)
    var status = STATUS_UNKNOWN_CONNECTION
    if i >= 0 and cis_running(var c, i)
        if opcode == OP_LE_ISO_TRANSMIT_TEST
            status = iso_test_tx(var c.cis[i], kind)
        else
            status = iso_test_rx(var c.cis[i], kind)
    else if j >= 0
        if opcode == OP_LE_ISO_TRANSMIT_TEST
            status = iso_test_tx(var c.bis[j], kind)
        else
            status = iso_test_rx(var c.bis[j], kind)
    answer_handle(var c, opcode, status, handle)

@satisfies("REQ-BLE-CTL-113")
@tier(embedded)
fn cmd_le_iso_transmit_test(var c: Controller)
    iso_test_start(var c, OP_LE_ISO_TRANSMIT_TEST)

@satisfies("REQ-BLE-CTL-113")
@tier(embedded)
fn cmd_le_iso_receive_test(var c: Controller)
    iso_test_start(var c, OP_LE_ISO_RECEIVE_TEST)

// The three counters of the receive test on the stream `x` as the answer of LE ISO Read Test Counters or LE ISO Test End: Unsupported Feature or Parameter Value for a stream
// that is not in the test mode the command asks about.  The end of the test (`stop`) turns both modes off and answers zeros for a stream that only transmitted.
@tier(embedded)
fn iso_test_counters(var x: Cis, stop: Bool, var out: Vec[Int; 3]) -> Int
    var status = STATUS_SUCCESS
    if stop
        if x.t_mode == 0
            status = STATUS_UNSUPPORTED_FEATURE
    else if ll_iso.test_rx_type(var x) < 0
        status = STATUS_UNSUPPORTED_FEATURE
    if status == STATUS_SUCCESS
        if ll_iso.test_rx_type(var x) >= 0
            out[0] = ll_iso.test_received(var x)
            out[1] = ll_iso.test_missed(var x)
            out[2] = ll_iso.test_failed(var x)
        if stop
            x.t_mode = 0
    status

// LE ISO Read Test Counters (`stop` false) and LE ISO Test End (`stop` true): the connection handle and the three counters.
@satisfies("REQ-BLE-CTL-113")
@tier(embedded)
fn cmd_le_iso_read_test_counters(var c: Controller, stop: Bool)
    var op = OP_LE_ISO_READ_TEST_COUNTERS
    if stop
        op = OP_LE_ISO_TEST_END
    let handle = param_handle(var c)
    let i = cis_slot(var c, handle)
    var j = -1
    if i < 0 and ctl_limits.big_on()
        j = bis_slot(var c, handle)
    var n: Vec[Int; 3] = Vec.new()
    for _ in 0..3
        let _z = n.push(0)
    var status = STATUS_UNKNOWN_CONNECTION
    if i >= 0 and cis_running(var c, i)
        status = iso_test_counters(var c.cis[i], stop, var n)
    else if j >= 0
        status = iso_test_counters(var c.bis[j], stop, var n)
    let slot = complete_begin(var c, op, status)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put_u16(var c.pool, slot, handle)
    put_u32(var c, slot, n[0])
    put_u32(var c, slot, n[1])
    put_u32(var c, slot, n[2])
    complete_send(var c, slot)

// Disconnect of a stream (Section 7.1.6 for a handle that names one): LL_CIS_TERMINATE_IND goes to the peer, the stream stops
// at once, and the Host is owed Disconnection Complete with the local Host as the reason.  The ACL is not touched.
// A stream that is not scheduled yet is cancelled (Central) or its request refused (Peripheral).
@satisfies("REQ-BLE-CTL-060")
@tier(embedded)
fn cis_disconnect(var c: Controller, i: Int, reason: Int)
    let ls = c.cis[i].acl
    let st = c.cis[i].state
    if st == ll_iso.S_REQUESTED or st == ll_iso.S_ACCEPTED
        c.cis_log.rejected = c.cis_log.rejected + 1
        c.cis_log.code = reason
        c.cis_log.why = ll_iso.WHY_HOST_REJECT
        iso_reject(var c, ls, ll_data.OP_CIS_REQ, reason)
        cis_release(var c, i)
        return
    ll_iso.put_cis_terminate(var c.links[ls].tmp, c.cis[i].cig_id, c.cis[i].cis_id, reason)
    let _q = iso_send(c, ls)
    cis_close(var c, i, ll_iso.REASON_LOCAL_HOST)

// The stream in slot `i` is over with `reason` (a Disconnection Complete reason, or for a stream that never
// came up the status of LE CIS Established): it stops, and the Host is owed the event.
@satisfies("REQ-BLE-CTL-060")
@tier(embedded)
fn cis_close(var c: Controller, i: Int, reason: Int)
    let was_up = c.cis[i].state == ll_iso.S_UP
    c.cis[i].reason = reason
    c.cis[i].status = reason
    c.cis[i].state = ll_iso.S_CLOSING
    if was_up
        c.cis[i].owed = c.cis[i].owed | ll_iso.EV_DISCONNECTED
    else
        c.cis[i].owed = c.cis[i].owed | ll_iso.EV_ESTABLISHED
    ll_arb.arb_cancel(var c.arb, ll_arb.CLASS_ISO)

// The streams that ride the ACL link in slot `ls` are over with `reason`: it ended.
@tier(embedded)
fn cis_acl_lost(var c: Controller, ls: Int, reason: Int)
    for i in 0..ctl_limits.cis_slots()
        let st = c.cis[i].state
        if c.cis[i].acl == ls and st != ll_iso.S_FREE and st != ll_iso.S_CONFIG and st != ll_iso.S_CLOSING
            if st == ll_iso.S_UP
                cis_close(var c, i, reason)
            else
                cis_close(var c, i, ll_iso.STATUS_FAILED_TO_ESTABLISH)

// ── The LL Control PDUs ──────────────────────────────────────────────

// LL_CIS_REQ on the link `ls` (Peripheral), read from `rx`: the stream is taken into a free slot and the Host is
// asked, or the Central is told why not.  Section 5.1.15 lists the reasons: the Host support bit not set, a PHY
// or framing the Controller lacks, BN, FT and NSE out of its range.
@satisfies("REQ-BLE-CTL-046")
@tier(embedded)
fn iso_req(var c: Controller, ls: Int, var rx: Pdu)
    c.cis_log.seen = c.cis_log.seen + 1
    if not c.host_iso
        iso_req_refuse(var c, ls, ll_iso.STATUS_UNSUPPORTED_REMOTE, ll_iso.WHY_HOST_FEATURE)
        return
    if not le_event_enabled(var c, SUB_LE_CIS_REQUEST)
        iso_req_refuse(var c, ls, STATUS_UNSUPPORTED_REMOTE, ll_iso.WHY_EVENT_MASK)
        return
    let i = cis_free_slot(var c)
    if i < 0
        iso_req_refuse(var c, ls, ll_iso.STATUS_CONNECTION_REJECTED_LIMITED, ll_iso.WHY_NO_SLOT)
        return
    ll_iso.cis_reset_run(var c.cis[i], ll_iso.S_REQUESTED)
    ll_iso.get_cis_req(var rx, var c.cis[i])
    c.cis[i].acl = ls
    let found = ll_iso.cis_req_why(var c.cis[i], c.links[ls].interval * ll_link.UNIT_US)
    var code = found & 0xFF
    var why = found >> 8
    if code == 0
        code = ll_iso.cis_req_gap(var c.cis[i], c.radio)
        why = ll_iso.WHY_GAP
    if code != 0
        ll_iso.cis_log_reject(var c.cis_log, var c.cis[i], code, why)
        iso_reject(var c, ls, ll_data.OP_CIS_REQ, code)
        ll_iso.cis_reset_run(var c.cis[i], ll_iso.S_FREE)
        return
    // A Central sends a request for a stream it holds only when it has given the earlier attempt up (it may not have said so: a
    // stream whose answers it never heard goes quiet).  The earlier attempt ends, its Host is told, and the new request is taken.
    let d = cis_find_dup(var c, i)
    if d >= 0
        if c.cis[d].state == ll_iso.S_UP
            cis_close(var c, d, ll_iso.REASON_REMOTE_TERMINATED)
        else
            cis_close(var c, d, ll_iso.STATUS_FAILED_TO_ESTABLISH)
    c.cis[i].central = false
    c.cis[i].owed = ll_iso.EV_REQUEST
    c.cis[i].first_us = c.now
    c.cis[i].sup_us = c.links[ls].timeout * ll_link.TIMEOUT_UNIT_US

// A request refused before its fields were read: it is counted, with the code and the branch.
@tier(embedded)
fn iso_req_refuse(var c: Controller, ls: Int, code: Int, why: Int)
    c.cis_log.rejected = c.cis_log.rejected + 1
    c.cis_log.code = code
    c.cis_log.why = why
    iso_reject(var c, ls, ll_data.OP_CIS_REQ, code)

// The LL_CIS_REQ PDUs the Link Layers dropped before the Controller saw them, over all links: a payload of the wrong length, or
// a build without the isochronous feature (answered LL_UNKNOWN_RSP).
pub @tier(embedded)
fn cis_req_dropped(var c: Controller) -> Int
    var n = 0
    for k in 0..noble_controller_config.CTL_LINKS
        n = n + c.links[k].cis_dropped
    n

// A stream other than `i` with the identifiers of the one in slot `i` that is not free.
@tier(embedded)
fn cis_find_dup(var c: Controller, i: Int) -> Int
    for k in 0..ctl_limits.cis_slots()
        if k != i and c.cis[k].state != ll_iso.S_FREE and c.cis[k].state != ll_iso.S_CLOSING and not c.cis[k].central and c.cis[k].cig_id == c.cis[i].cig_id and c.cis[k].cis_id == c.cis[i].cis_id and c.cis[k].acl == c.cis[i].acl
            return k
    -1

// LL_CIS_IND on the link `ls` (Peripheral): the stream the Host accepted is scheduled.  Its first anchor is the CIS
// offset after the anchor of the connection event the indication names (Section 2.4.2.31); one that is behind us, or
// that no anchor can be found for (an update of the connection comes between), fails the stream.
@satisfies("REQ-BLE-CTL-046")
@tier(embedded)
fn iso_ind(var c: Controller, ls: Int, var rx: Pdu)
    let i = cis_on_acl(var c, ls, ll_iso.S_ACCEPTED)
    if i < 0 or (c.cis[i].owed & ll_iso.EV_SEND_RSP) != 0
        return
    ll_iso.get_cis_ind(var rx, var c.cis[i])
    ll_iso.cis_log_ind(var c.cis_log, var c.cis[i], c.links[ls].interval)
    let t = ll_link.link_event_time(var c.links[ls], c.cis[i].ind_ev)
    if t < 0
        cis_close(var c, i, ll_iso.STATUS_FAILED_TO_ESTABLISH)
        return
    let first = t + c.cis[i].cis_offset
    if first < c.now + CIS_LEAD_US
        cis_close(var c, i, ll_iso.STATUS_FAILED_TO_ESTABLISH)
        return
    c.cis[i].anchor = first
    c.cis[i].first_us = first
    c.cis[i].last_rx = t
    c.cis[i].ev = 0
    c.cis[i].sub = 1
    c.cis[i].synced = false
    c.cis[i].ev_open = false
    c.cis[i].enc = ll_link.link_encrypted(var c.links[ls])
    c.cis[i].sup_us = c.links[ls].timeout * ll_link.TIMEOUT_UNIT_US
    c.cis[i].state = ll_iso.S_WAIT

// LL_CIS_TERMINATE_IND on the link `ls`: the stream it names stops, with the reason the peer gave.
@satisfies("REQ-BLE-CTL-047")
@tier(embedded)
fn iso_terminate(var c: Controller, ls: Int, var rx: Pdu)
    let cig_id = ll_data.dpdu_byte(var rx, 1)
    let cis_id = ll_data.dpdu_byte(var rx, 2)
    let reason = ll_data.dpdu_byte(var rx, 3)
    for i in 0..ctl_limits.cis_slots()
        let st = c.cis[i].state
        if c.cis[i].acl == ls and c.cis[i].cig_id == cig_id and c.cis[i].cis_id == cis_id and st != ll_iso.S_FREE and st != ll_iso.S_CONFIG and st != ll_iso.S_CLOSING
            if st == ll_iso.S_UP
                cis_close(var c, i, reason)
            else
                cis_close(var c, i, reason)

// A CIS procedure PDU arrived on the link in slot `ls` (`Link.ctl_in`): read from `rx`, the buffer the program
// read it into.
@satisfies("REQ-BLE-CTL-046")
@tier(embedded)
fn ctl_iso_ctrl(var c: Controller, ls: Int, var rx: Pdu)
    c.links[ls].ctl_in = false
    let op = ll_data.dpdu_opcode(var rx)
    if noble_controller_config.CTL_CS > 0
        if ll_cs.is_pdu(op) or ll_link.cs_refusal(var rx, op)
            cs_rx(var c, ls, op, var rx)
            return
    if ctl_limits.past_on() and op == ll_data.OP_PERIODIC_SYNC_IND
        past_rx(var c, ls, var rx)
        return
    if ctl_limits.fs_on() and (op == ll_data.OP_FRAME_SPACE_REQ or op == ll_data.OP_FRAME_SPACE_RSP or (op == ll_data.OP_REJECT_EXT_IND or op == ll_data.OP_UNKNOWN_RSP) and ll_data.dpdu_byte(var rx, 1) == ll_data.OP_FRAME_SPACE_REQ)
        fs_rx(var c, ls, op, var rx)
        return
    if ctl_limits.rate_on() and (op == ll_data.OP_CONNECTION_RATE_REQ or (op == ll_data.OP_REJECT_EXT_IND or op == ll_data.OP_UNKNOWN_RSP) and ll_data.dpdu_byte(var rx, 1) == ll_data.OP_CONNECTION_RATE_REQ or op == ll_data.OP_UNKNOWN_RSP and ll_data.dpdu_byte(var rx, 1) == ll_data.OP_CONNECTION_RATE_IND)
        rate_rx(var c, ls, op, var rx)
        return
    if ctl_limits.sub_on() and (op == ll_data.OP_SUBRATE_REQ or (op == ll_data.OP_REJECT_EXT_IND or op == ll_data.OP_UNKNOWN_RSP) and ll_data.dpdu_byte(var rx, 1) == ll_data.OP_SUBRATE_REQ)
        sub_rx(var c, ls, op, var rx)
        return
    if ctl_limits.pcl_on() and (op >= ll_data.OP_POWER_CONTROL_REQ or (op == ll_data.OP_REJECT_EXT_IND or op == ll_data.OP_UNKNOWN_RSP) and ll_data.dpdu_byte(var rx, 1) == ll_data.OP_POWER_CONTROL_REQ)
        pcl_rx(var c, ls, op, var rx)
        return
    if not ctl_limits.iso_on() or not iso_on(var c)
        return
    if op == ll_data.OP_REJECT_EXT_IND
        iso_refused(var c, ls, ll_data.dpdu_byte(var rx, 2))
    else if op == ll_data.OP_UNKNOWN_RSP
        iso_refused(var c, ls, ll_iso.STATUS_UNSUPPORTED_REMOTE)
    else if op == ll_data.OP_CIS_RSP
        iso_rsp(var c, ls, var rx)
    else if op == ll_data.OP_CIS_REQ
        iso_req(var c, ls, var rx)
    else if op == ll_data.OP_CIS_IND
        iso_ind(var c, ls, var rx)
    else if op == ll_data.OP_CIS_TERMINATE_IND
        iso_terminate(var c, ls, var rx)

// The work of the isochronous channels that is not in a radio event: the LL_CIS_RSP of an accepted request is queued
// (the queue may be full), and a request the Host leaves unanswered is refused when the accept timeout runs out.  True
// when something was done.
@satisfies("REQ-BLE-CTL-058")
@tier(embedded)
fn ctl_iso_poll(var c: Controller) -> Bool
    if not iso_on(var c)
        return false
    var did = ctl_iso_central_poll(var c)
    for i in 0..ctl_limits.cis_slots()
        let st = c.cis[i].state
        let ls = c.cis[i].acl
        if st == ll_iso.S_ACCEPTED and (c.cis[i].owed & ll_iso.EV_SEND_RSP) != 0
            if ll_link.link_live(var c.links[ls]) and not c.links[ls].closing
                ll_iso.put_cis_rsp(var c.links[ls].tmp, var c.cis[i])
                if iso_send(c, ls)
                    c.cis[i].owed = c.cis[i].owed & (0xFFFF ^ ll_iso.EV_SEND_RSP)
                    did = true
        else if st == ll_iso.S_REQUESTED and c.now - c.cis[i].first_us > CIS_ACCEPT_TIMEOUT_US
            c.cis_log.rejected = c.cis_log.rejected + 1
            c.cis_log.code = ll_iso.STATUS_ACCEPT_TIMEOUT
            c.cis_log.why = ll_iso.WHY_ACCEPT_TIMEOUT
            iso_reject(var c, ls, ll_data.OP_CIS_REQ, ll_iso.STATUS_ACCEPT_TIMEOUT)
            c.cis[i].status = ll_iso.STATUS_ACCEPT_TIMEOUT
            c.cis[i].state = ll_iso.S_CLOSING
            c.cis[i].owed = ll_iso.EV_ESTABLISHED
            did = true
    did

// ── ISO Data from the Host ───────────────────────────────────────────

// The reference time of an SDU the Host sent on the framed stream in slot `i` (Part G, Section 3.1): its Time_Stamp when it has
// one and the stamp is near the Controller's clock (within two ISO intervals and SDU intervals of it, either way; one beyond
// is not that clock's), otherwise the time it arrived put on the clock of the sequence (`ll_iso.fr_ref`).  `stamp` is the 32-bit
// Time_Stamp, -1 for none, and `seq` the Packet_Sequence_Number.
@tier(embedded)
fn iso_ref(var x: Cis, now: Int, stamp: Int, seq: Int) -> Int
    if stamp < 0
        return ll_iso.fr_ref(var x, now, seq)
    var d = (stamp - now) & 0xFFFFFFFF
    if d >= 0x80000000
        d = d - 0x100000000
    let span = 2 * (ll_iso.iso_us(var x) + ll_iso.tx_sdu_int(var x))
    if d > span or d < 0 - span
        return ll_iso.fr_ref(var x, now, seq)
    now + d

// An HCI ISO Data packet from the Host is complete.  A complete SDU (Packet_Boundary_Flag 2) or the fragments of one (0
// first, 1 continuation, 3 last; the first carries the Time_Stamp when its flag is set, the Packet_Sequence_Number and the
// ISO_SDU_Length, the others the data alone) for a stream whose input data path is set go to the ring of the stream once
// the SDU is whole, cut in fragments (unframed) or in segments whose Time_Offset is measured from the SDU's reference time
// (framed): the Time_Stamp when the first packet has one near the Controller's clock, otherwise the time that packet arrived put on
// the clock of its Packet_Sequence_Number (`iso_ref`).  The Packet_Sequence_Number is used for no other purpose: the Controller takes
// the SDUs in the order they come.  Anything else is dropped and counted.
@satisfies("REQ-BLE-CTL-076")
@satisfies("REQ-BLE-CTL-050")
@satisfies("REQ-BLE-CTL-097")
@tier(embedded)
fn iso_to_cis(var c: Controller)
    if ctl_limits.big_on()
        let j = bis_slot(var c, h4_rx.h4_acl_handle(var c.rx))
        if j >= 0
            iso_to_bis(var c, j)
            return
    let i = cis_slot(var c, h4_rx.h4_acl_handle(var c.rx))
    var ok = false
    var used = false
    if i >= 0 and c.cis[i].dp_in and cis_running(var c, i)
        let pb = h4_rx.h4_acl_pb(var c.rx)
        var off = h4_rx.ACL_LEAD
        var left = h4_rx.h4_acl_len(var c.rx)
        var stamp = -1
        if pb == 1 or pb == 3
            if not h4_rx.h4_iso_ts(var c.rx)
                used = true
                ok = ll_iso.sdu_frag(var c.cis[i], var c.rx.acl, off, left, pb, 0)
        else
            if h4_rx.h4_iso_ts(var c.rx) and left >= 4
                stamp = c.rx.acl[off] as Int | (c.rx.acl[off + 1] as Int << 8) | (c.rx.acl[off + 2] as Int << 16) | (c.rx.acl[off + 3] as Int << 24)
                off = off + 4
                left = left - 4
            if left >= 4
                let len = c.rx.acl[off + 2] as Int | (c.rx.acl[off + 3] as Int << 8)
                let sdu_len = len & 0x0FFF
                if pb == 2 and sdu_len == left - 4 or pb == 0
                    used = true
                    // The reference time of a framed SDU is the first packet's: a continuation keeps what it set.
                    if c.cis[i].framed
                        c.cis[i].h_ref = iso_ref(var c.cis[i],
                            c.now,
                            stamp,
                            c.rx.acl[off] as Int | (c.rx.acl[off + 1] as Int << 8))
                    ok = ll_iso.sdu_frag(var c.cis[i], var c.rx.acl, off + 4, left - 4, pb, sdu_len)
    if not ok
        c.iso_dropped = c.iso_dropped + 1
        if i >= 0
            c.cis[i].n_host_drop = c.cis[i].n_host_drop + 1
            // The packet of a stream that runs and takes data is credited back to the Host with the SDU it was part of, which
            // `sdu_frag` has done for a packet it took; one it was never given (a header that does not hold) is credited here.
            if c.cis[i].dp_in and cis_running(var c, i)
                if not used
                    ll_iso.sdu_abandon(var c.cis[i])
                    ll_iso.sdu_credit(var c.cis[i], 1)
            else
                c.cis[i].h_open = false

// ── The events a stream owes the Host ────────────────────────────────

// LE CIS Request (Section 7.7.65.26).
@satisfies("REQ-BLE-CTL-058")
@tier(embedded)
fn ev_cis_request(var c: Controller, i: Int) -> Bool
    let slot = meta_begin(var c, SUB_LE_CIS_REQUEST)
    if slot == ctl_pool.NO_SLOT
        return false
    let _a = ctl_pool.pool_put_u16(var c.pool, slot, c.cis[i].acl + 1)
    let _b = ctl_pool.pool_put_u16(var c.pool, slot, c.cis[i].handle)
    let _c = ctl_pool.pool_put(var c.pool, slot, c.cis[i].cig_id)
    let _d = ctl_pool.pool_put(var c.pool, slot, c.cis[i].cis_id)
    event_send(var c, slot)
    c.cis[i].owed = c.cis[i].owed & (0xFFFF ^ ll_iso.EV_REQUEST)
    true

// Append three octets, least significant first.
@tier(embedded)
fn put_u24(var c: Controller, slot: Int, v: Int)
    let _a = ctl_pool.pool_put_u16(var c.pool, slot, v & 0xFFFF)
    let _b = ctl_pool.pool_put(var c.pool, slot, (v >>> 16) & 0xFF)

// The transport latency of a direction (Part G, Section 3.2.2): CIG_Sync_Delay plus FT ISO intervals less the SDU interval, in the
// range LE CIS Established allows; with framed PDUs (Section 3.2.1) the SDU interval is added, the framing delay, not taken off, and in
// Unsegmented mode there is no framing delay.
@tier(embedded)
fn cis_latency(var c: Controller, i: Int, ft: Int, sdu_int: Int) -> Int
    var t = c.cis[i].cig_sync + ft * ll_iso.iso_us(var c.cis[i]) - sdu_int
    if c.cis[i].framed
        t = c.cis[i].cig_sync + ft * ll_iso.iso_us(var c.cis[i]) + sdu_int
        if c.cis[i].unseg
            t = c.cis[i].cig_sync + ft * ll_iso.iso_us(var c.cis[i])
    if t < 0xF2
        t = 0xF2
    if t > 0x7FFFFF
        t = 0x7FFFFF
    t

// LE CIS Established (Section 7.7.65.25), [v2] when the Host enabled it and [v1] otherwise.  A stream that did not come up
// carries its status and zeros.  The stream goes back to its configuration (Central) or is deleted (Peripheral) when
// it failed.
@satisfies("REQ-BLE-CTL-061")
@tier(embedded)
fn ev_cis_established(var c: Controller, i: Int) -> Bool
    let v2 = le_event_enabled(var c, SUB_LE_CIS_ESTABLISHED_V2)
    if not v2 and not le_event_enabled(var c, SUB_LE_CIS_ESTABLISHED)
        c.cis[i].owed = c.cis[i].owed & (0xFFFF ^ ll_iso.EV_ESTABLISHED)
        return true
    var sub = SUB_LE_CIS_ESTABLISHED
    if v2
        sub = SUB_LE_CIS_ESTABLISHED_V2
    let slot = meta_begin(var c, sub)
    if slot == ctl_pool.NO_SLOT
        return false
    let ok = c.cis[i].status == STATUS_SUCCESS
    let _a = ctl_pool.pool_put(var c.pool, slot, c.cis[i].status)
    let _b = ctl_pool.pool_put_u16(var c.pool, slot, c.cis[i].handle)
    if ok
        put_u24(var c, slot, c.cis[i].cig_sync)
        put_u24(var c, slot, c.cis[i].cis_sync)
        put_u24(var c, slot, cis_latency(var c, i, c.cis[i].ft_c, c.cis[i].sdu_int_c))
        put_u24(var c, slot, cis_latency(var c, i, c.cis[i].ft_p, c.cis[i].sdu_int_p))
        let _c = ctl_pool.pool_put(var c.pool, slot, c.cis[i].phy)
        let _d = ctl_pool.pool_put(var c.pool, slot, ll_iso.phy_back(var c.cis[i]))
        let _e = ctl_pool.pool_put(var c.pool, slot, c.cis[i].nse)
        let _f = ctl_pool.pool_put(var c.pool, slot, c.cis[i].bn_c)
        let _g = ctl_pool.pool_put(var c.pool, slot, c.cis[i].bn_p)
        let _h = ctl_pool.pool_put(var c.pool, slot, c.cis[i].ft_c)
        let _k = ctl_pool.pool_put(var c.pool, slot, c.cis[i].ft_p)
        let _l = ctl_pool.pool_put_u16(var c.pool, slot, c.cis[i].max_pdu_c)
        let _m = ctl_pool.pool_put_u16(var c.pool, slot, c.cis[i].max_pdu_p)
        let _n = ctl_pool.pool_put_u16(var c.pool, slot, c.cis[i].iso_int)
        if v2
            put_u24(var c, slot, c.cis[i].sub_int)
            let _o = ctl_pool.pool_put_u16(var c.pool, slot, c.cis[i].max_sdu_c)
            let _p = ctl_pool.pool_put_u16(var c.pool, slot, c.cis[i].max_sdu_p)
            put_u24(var c, slot, c.cis[i].sdu_int_c)
            put_u24(var c, slot, c.cis[i].sdu_int_p)
            let _q = ctl_pool.pool_put(var c.pool, slot, (if c.cis[i].framed then 1 else 0))
    else
        var n = 28
        if v2
            n = 41
        put_zeros(var c, slot, n - 3)
    event_send(var c, slot)
    c.cis[i].owed = c.cis[i].owed & (0xFFFF ^ ll_iso.EV_ESTABLISHED)
    if not ok
        cis_release(var c, i)
    true

// Disconnection Complete of a stream (Section 7.7.5).  The slot is free again, or the Central's configuration, when the event
// is sent.
@satisfies("REQ-BLE-CTL-060")
@tier(embedded)
fn ev_cis_disconnected(var c: Controller, i: Int) -> Bool
    if not event_enabled(var c, hci_frame.EVT_DISCONNECTION_COMPLETE)
        c.cis[i].owed = c.cis[i].owed & (0xFFFF ^ ll_iso.EV_DISCONNECTED)
        cis_release(var c, i)
        return true
    let slot = ctl_pool.evt_begin(var c.pool, hci_frame.EVT_DISCONNECTION_COMPLETE)
    if slot == ctl_pool.NO_SLOT
        return false
    let _a = ctl_pool.pool_put(var c.pool, slot, STATUS_SUCCESS)
    let _b = ctl_pool.pool_put_u16(var c.pool, slot, c.cis[i].handle)
    let _c = ctl_pool.pool_put(var c.pool, slot, c.cis[i].reason)
    event_send(var c, slot)
    c.cis[i].owed = c.cis[i].owed & (0xFFFF ^ ll_iso.EV_DISCONNECTED)
    cis_release(var c, i)
    true

// Number Of Completed Packets (Section 7.7.19) for the SDUs of a stream that were acknowledged or flushed.
@satisfies("REQ-BLE-CTL-050")
@tier(embedded)
fn ev_cis_completed(var c: Controller, i: Int) -> Bool
    let slot = ctl_pool.evt_begin(var c.pool, hci_frame.EVT_NUMBER_OF_COMPLETED_PACKETS)
    if slot == ctl_pool.NO_SLOT
        return false
    let _a = ctl_pool.pool_put(var c.pool, slot, 1)
    let _b = ctl_pool.pool_put_u16(var c.pool, slot, c.cis[i].handle)
    let _c = ctl_pool.pool_put_u16(var c.pool, slot, ll_iso.comp_take(var c.cis[i]))
    event_send(var c, slot)
    true

// The oldest SDU a stream has for the Host goes out as HCI ISO Data packets: one with the Time_Stamp, the
// Packet_Sequence_Number, the SDU length with the Packet_Status_Flag and the data when the SDU fits (Packet_Boundary_Flag
// 2), otherwise the first fragment with the header and `ISO_LOAD` less 8 octets of data (0), continuations with up to
// `ISO_LOAD` octets (1) and the last (3).  A fragment goes out for each call; `out_off` is how much of the SDU has gone.
// A stream with no output data path drops it.  False when the pool has no slot, the SDU stays and the call is made again.
@satisfies("REQ-BLE-CTL-076")
@satisfies("REQ-BLE-CTL-052")
@tier(embedded)
fn ev_cis_data(var c: Controller, i: Int) -> Bool
    if not c.cis[i].dp_out
        ll_iso.out_take(var c.cis[i])
        c.cis[i].out_off = 0
        return true
    let at = c.cis[i].out_head
    let n = c.cis[i].outl[at]
    let done = c.cis[i].out_off
    var room = ll_iso.ISO_LOAD
    if done == 0
        room = ll_iso.ISO_LOAD - 8
    var take = n - done
    var pb = 2
    if take > room
        take = room
        if done == 0
            pb = 0
        else
            pb = 1
    else if done > 0
        pb = 3
    if not work_fits(var c, iso_work_us(var c, take), c.room_us)
        return false
    let slot = ctl_pool.iso_begin(var c.pool, c.cis[i].handle, pb, done == 0)
    if slot == ctl_pool.NO_SLOT
        return false
    if done == 0
        put_u32(var c, slot, c.cis[i].outt[at])
        let _a = ctl_pool.pool_put_u16(var c.pool, slot, c.cis[i].outq[at])
        let _b = ctl_pool.pool_put_u16(var c.pool, slot, (n & 0x0FFF) | (c.cis[i].outs[at] << 14))
    for k in 0..take
        let _c = ctl_pool.pool_put(var c.pool, slot, c.cis[i].outd[at * ll_iso.OUT_OCTETS + done + k] as Int)
    let _d = ctl_pool.iso_send(var c.pool, slot)
    if pb == 0 or pb == 1
        c.cis[i].out_off = done + take
        return true
    ll_iso.out_take(var c.cis[i])
    c.cis[i].out_off = 0
    true

// Queue what the stream in slot `i` owes the Host, in the order it came: the request, the establishment, the SDUs it received and
// the credits for the ones it sent, the end.  False when the pool ran out of slots.
@satisfies("REQ-BLE-CTL-061")
@tier(embedded)
fn flush_cis(var c: Controller, i: Int) -> Bool
    if c.cis[i].state == ll_iso.S_FREE or c.cis[i].state == ll_iso.S_CONFIG
        return true
    if (c.cis[i].owed & ll_iso.EV_REQUEST) != 0 and not ev_cis_request(var c, i)
        return false
    if (c.cis[i].owed & ll_iso.EV_ESTABLISHED) != 0
        if not ev_cis_established(var c, i)
            return false
        if c.cis[i].state == ll_iso.S_FREE or c.cis[i].state == ll_iso.S_CONFIG
            return true
    for _ in 0..ll_iso.OUT_SLOTS * ll_iso.SDU_FRAGS
        if ll_iso.out_ready(var c.cis[i]) and not ev_cis_data(var c, i)
            return false
    if (c.cis[i].owed & ll_iso.EV_COMPLETED) != 0 and not ev_cis_completed(var c, i)
        return false
    if (c.cis[i].owed & ll_iso.EV_DISCONNECTED) != 0
        return ev_cis_disconnected(var c, i)
    true

// ── The radio program's view of the streams ──────────────────────────

// The stream whose next subevent starts first, among the ones that run; -1 for none.  A tie goes to the lower slot.
@satisfies("REQ-BLE-CTL-062")
@tier(embedded)
fn ctl_cis_next(var c: Controller) -> Int
    var best = -1
    var at = 0
    for i in 0..ctl_limits.cis_slots()
        if cis_running(var c, i)
            let s = ll_iso.sub_start(var c.cis[i], c.cis[i].sub)
            if best < 0 or s < at
                best = i
                at = s
    best

// The window widening of the stream in slot `i` before the subevent it listens for: the Central's clock accuracy and
// this one's over the time since it last heard the Central, and the jitter; never more than half the ISO interval
// less T_IFS.  The Central's own window is a point.
@tier(embedded)
fn ctl_cis_widening(var c: Controller, i: Int) -> Int
    if c.cis[i].central
        return 0
    let start = ll_iso.sub_start(var c.cis[i], c.cis[i].sub)
    var elapsed = start - c.cis[i].last_rx
    if elapsed < 0
        elapsed = 0
    let ppm = ll_link.sca_ppm(c.links[c.cis[i].acl].sca)
    ll_iso.widening_us(ppm, elapsed, ll_iso.iso_us(var c.cis[i]) / 2 - ll_iso.T_IFS_CIS_US)

// The time the receiver of the stream's next subevent must be listening from, and the time it gives up if no packet has
// started.
@tier(embedded)
fn ctl_cis_listen_start(var c: Controller, i: Int) -> Int
    ll_iso.sub_start(var c.cis[i], c.cis[i].sub) - ctl_cis_widening(var c, i)

@tier(embedded)
fn ctl_cis_listen_end(var c: Controller, i: Int) -> Int
    ll_iso.sub_start(var c.cis[i], c.cis[i].sub) + ctl_cis_widening(var c, i)

// Book the arbiter's isochronous class for the subevent of the stream that is next: from the start of its window to the
// end of the subevent with a margin.
@satisfies("REQ-BLE-CTL-062")
@tier(embedded)
fn ctl_cis_book(var c: Controller)
    let i = ctl_cis_next(var c)
    let g = ctl_big_next(var c)
    if g >= 0 and (i < 0 or ctl_big_start(var c, g) <= ctl_cis_listen_start(var c, i))
        // The next event of the isochronous class is a group's: its whole event is booked.
        let begin = ctl_big_start(var c, g)
        var end = begin + ctl_big_book_us(var c, g)
        if end <= c.now
            end = c.now + ctl_big_book_us(var c, g)
        ll_arb.arb_book(var c.arb, ll_arb.CLASS_ISO, begin, end)
        return
    if i < 0
        ll_arb.arb_cancel(var c.arb, ll_arb.CLASS_ISO)
        return
    let start = ctl_cis_listen_start(var c, i)
    var end = ll_iso.sub_start(var c.cis[i], c.cis[i].sub) + ctl_cis_widening(var c, i) + ll_iso.se_len_us(var c.cis[i]) + CIS_BOOK_MARGIN_US
    if end <= c.now
        end = c.now + ll_iso.se_len_us(var c.cis[i]) + CIS_BOOK_MARGIN_US
    ll_arb.arb_book(var c.arb, ll_arb.CLASS_ISO, start, end)

// The microseconds a booking for a subevent covers beyond its longest exchange.
const CIS_BOOK_MARGIN_US = 400

// The subevent of the stream in slot `i` begins: the event it belongs to is begun if this is its first subevent, the
// flush points are run for both directions, and the answer is the channel.  A subevent that is late by more than its
// length is skipped with the events it carries (`ll_iso.skip_late`), and a stream that was lost in them is closed; -1 then.
@satisfies("REQ-BLE-CTL-062")
@tier(embedded)
fn ctl_cis_begin(var c: Controller, i: Int) -> Int
    let ls = c.cis[i].acl
    let tol = ll_radio.late_tol_us(c.radio)
    if c.now > ll_iso.sub_start(var c.cis[i], c.cis[i].sub) + tol
        let r = ll_iso.skip_late(var c.cis[i], c.now, tol)
        if r < 0
            ctl_cis_lost(var c, i, -r)
            return -1
    if c.cis[i].t_try == 0
        // The first subevent run for the stream: when, and where it lies in the ACL interval (the status line shows both).
        c.cis[i].t_try = c.now
        c.cis[i].e_try = c.links[ls].ev_count
        c.cis[i].a_try = c.links[ls].anchor
        let conn = ll_link.interval_us(var c.links[ls])
        if conn > 0
            var ph = (ll_iso.sub_start(var c.cis[i], c.cis[i].sub) - c.links[ls].due) % conn
            if ph < 0
                ph = ph + conn
            c.cis[i].ph_try = ph
    if not c.cis[i].ev_open
        ll_iso.event_begin(var c.cis[i])
    ll_iso.tx_flush(var c.cis[i], c.cis[i].ev, c.cis[i].sub)
    ll_iso.rx_flush(var c.cis[i], c.cis[i].ev, c.cis[i].sub, var c.links[ls].tmp)
    ll_iso.sub_channel(c.cis[i].aa, c.cis[i].ev, c.cis[i].sub, c.links[ls].chmap, c.links[ls].n_used)

// The stream was lost with the ACL still up: before it was established the Host is told with the status of a stream that failed to
// establish, after with the reason the supervision gave.
@satisfies("REQ-BLE-CTL-053")
@tier(embedded)
fn ctl_cis_lost(var c: Controller, i: Int, why: Int)
    if why == ll_iso.STATUS_FAILED_TO_ESTABLISH
        cis_close(var c, i, ll_iso.STATUS_FAILED_TO_ESTABLISH)
    else
        cis_close(var c, i, why)

// The access address, the PHY and the CRC seed of the stream in slot `i`: the CRC seed is the ACL's (Section 4.5.13).
@tier(embedded)
fn ctl_cis_aa(var c: Controller, i: Int) -> Int
    c.cis[i].aa

@tier(embedded)
fn ctl_cis_crc(var c: Controller, i: Int) -> Int
    c.links[c.cis[i].acl].crc_init

@tier(embedded)
fn ctl_cis_phy(var c: Controller, i: Int) -> Int
    c.cis[i].phy

// The PHY of the packet that follows the first of a subevent: the Peripheral's answer, the Central's packet being on `ctl_cis_phy`.
@tier(embedded)
fn ctl_cis_phy_back(var c: Controller, i: Int) -> Int
    ll_iso.phy_back(var c.cis[i])

@tier(embedded)
fn ctl_cis_sub(var c: Controller, i: Int) -> Int
    c.cis[i].sub

@tier(embedded)
fn ctl_cis_start(var c: Controller, i: Int) -> Int
    let t = ll_iso.sub_start(var c.cis[i], c.cis[i].sub)
    if c.cis[i].central and c.cis[i].off_cig > 0
        return t - CIS_LATER_TRIM_US
    t

// The microseconds a Central starts the subevents of every stream after the first of its group before their time on the group's
// grid.  The PTS dongle (the Lower Tester) places the first event of a later stream from the timeline of the earlier one and
// listens for it in a window of about 40 us around a time that lies a few microseconds before the Central's nominal one
// (`bugs/orbit/the-novo-controller-fails-to-establish-the-second-cis-of-a-two-cis-group-with-the-pts-dongle-status-0x3e.md`).
// Measured 2026-11-08 on the nRF54LM20 DK against the dongle with BAP/UCL/STR/BV-527-C, 529-C, 545-C and 548-C, three runs of the four
// rows each: 12 of 16 runs ended with LE CIS Established 0x3E for the second stream at 0 us, 2 of 12 at this value; 2026-10-31, the
// second stream alone moved by -20 us: 2 of 40, by -30 us: 38 of 40.  The value lies inside the 2 x `ll_link.JITTER_US` a Peripheral
// widens its window by; it is not a claim about the specification's Central, and not measured against another Peripheral than the
// dongle.
const CIS_LATER_TRIM_US = 16

// The channel of the next subevent of the stream in slot `i` when the radio program will run it straight after the one just heard
// (the packet was read at `now`; `good` says its CRC was right), -1 when it will not: the event has no other subevent or the Central
// closed it with this packet, the subevent is further off than the arbiter's lead, or another stream's subevent comes first.  These are
// the conditions under which `ll_air.cis_chain` goes on with this stream, taken before the work for the packet is done, so that
// the receiver can be armed for the subevent first.
@tier(embedded)
fn ctl_cis_arm_channel(var c: Controller, i: Int, good: Bool, now: Int) -> Int
    if c.cis[i].sub >= c.cis[i].nse or good and c.cis[i].f_cie
        return -1
    let ls = c.cis[i].acl
    let start = ll_iso.sub_start(var c.cis[i], c.cis[i].sub + 1)
    var elapsed = start - now
    if elapsed < 0
        elapsed = 0
    let ppm = ll_link.sca_ppm(c.links[ls].sca)
    let wide = ll_iso.widening_us(ppm, elapsed, ll_iso.iso_us(var c.cis[i]) / 2 - ll_iso.T_IFS_CIS_US)
    if start - wide - now > ll_arb.lead_of(var c.arb, ll_arb.CLASS_ISO)
        return -1
    for k in 0..ctl_limits.cis_slots()
        if k != i and cis_running(var c, k)
            let other = ll_iso.sub_start(var c.cis[k], c.cis[k].sub)
            if other < start or other == start and k < i
                return -1
    ll_iso.sub_channel(c.cis[i].aa, c.cis[i].ev, c.cis[i].sub + 1, c.links[ls].chmap, c.links[ls].n_used)

@tier(embedded)
fn ctl_cis_central(var c: Controller, i: Int) -> Bool
    c.cis[i].central

@tier(embedded)
fn ctl_cis_enc(var c: Controller, i: Int) -> Bool
    c.cis[i].enc

// The payload numbers the radio program offers in the subevent: the one in flight and the one behind it, -1 for a Null PDU.
@tier(embedded)
fn ctl_cis_cur(var c: Controller, i: Int) -> Int
    ll_iso.tx_pick(var c.cis[i], c.cis[i].ev)

@tier(embedded)
fn ctl_cis_nxt(var c: Controller, i: Int) -> Int
    ll_iso.tx_pick_next(var c.cis[i], c.cis[i].ev, c.cis[i].sub)

// The PDU of payload `num` (-1 for a Null PDU) of the stream in slot `i`, sealed when the stream is encrypted: the counter
// of the nonce is the payload number, and the direction bit is 1 for the Central.
@satisfies("REQ-BLE-CTL-063")
@tier(embedded)
fn ctl_cis_air<C: Cipher[e]>(var c: Controller, i: Int, var cc: C, num: Int, var p: Pdu) [e]
    ll_iso.tx_build(var c.cis[i], num, var p)
    if c.cis[i].enc and num >= 0 and ll_data.dpdu_len(var p) > 0
        var ek = ll_cipher.enc_key_new()
        cis_key(var c, i, var ek)
        cc.seal(var ek, num, cis_dir(var c, i), var p)

// The session key of the ACL link with the IV of the stream (Part E, Section 2.1): the IV of the ACL with its low
// 32 bits exclusive-or the access address.
@satisfies("REQ-BLE-CTL-063")
@tier(embedded)
fn cis_key(var c: Controller, i: Int, var ek: EncKey)
    let ls = c.cis[i].acl
    for k in 0..16
        ek.sk[k] = c.links[ls].ek.sk[k]
    for k in 0..8
        ek.iv[k] = c.links[ls].ek.iv[k]
    for k in 0..4
        ek.iv[k] = ek.iv[k] ^ ((c.cis[i].aa >>> (8 * k)) & 0xFF) as u8

// The direction value for the cipher: the directionBit of the PDUs this end sends, and bit 1 saying the PDU is a CIS PDU, whose
// additional data masks CIE and NPI beside NESN and SN.
@tier(embedded)
fn cis_dir(var c: Controller, i: Int) -> Int
    if c.cis[i].central
        ll_cipher.DIR_CENTRAL | ll_cipher.DIR_CIS
    else
        ll_cipher.DIR_PERIPHERAL | ll_cipher.DIR_CIS

// A packet of the Central arrived in the subevent: its header octet decides the answer (`ll_iso.rx_fast`).  `cur` and
// `nxt` are the payload numbers the program put in the two buffers.  The answer is the header octet to send; `ctl_cis_use_nxt`
// says which buffer.
@satisfies("REQ-BLE-CTL-051")
@no_alloc
@tier(embedded)
fn ctl_cis_rx_fast(var c: Controller, i: Int, hdr0: Int, cur: Int, nxt: Int) -> Int
    ll_iso.rx_fast(var c.cis[i], hdr0, cur, nxt)

@tier(embedded)
fn ctl_cis_use_nxt(var c: Controller, i: Int) -> Bool
    c.cis[i].use_nxt

// A packet with a CRC error: the Peripheral answers with the payload in flight and acknowledges nothing, so that the
// Central sends it again.  The header octet of that answer.
@satisfies("REQ-BLE-CTL-051")
@no_alloc
@tier(embedded)
fn ctl_cis_rx_bad(var c: Controller, i: Int, cur: Int) -> Int
    c.cis[i].f_ack = false
    c.cis[i].f_new = false
    c.cis[i].use_nxt = false
    ll_iso.tx_header(var c.cis[i], cur)

// The payload number of the PDU the program sent in the subevent (`ll_iso.tx_sent`).
@tier(embedded)
fn ctl_cis_sent(var c: Controller, i: Int, num: Int)
    ll_iso.tx_sent(var c.cis[i], num)

// The packet of the subevent is read into `rx` and its CRC verdict is `good`: the payload is opened when the stream is encrypted,
// then the verdicts of `ctl_cis_rx_fast` are applied.  A MIC that does not match ends the stream with MIC Failure.  `start`
// is the time the packet's preamble began and `now` the time of the work.
@satisfies("REQ-BLE-CTL-051")
@satisfies("REQ-BLE-CTL-063")
@tier(embedded)
fn ctl_cis_rx_slow<C: Cipher[e]>(var c: Controller, i: Int, var cc: C, var rx: Pdu, good: Bool,
                                 start: Int, now: Int, defer_asked: Bool) [e]
    if good
        c.cis[i].n_good = c.cis[i].n_good + 1
    else
        c.cis[i].n_bad = c.cis[i].n_bad + 1
    // The segments of a framed payload are read where they stand: the payload is opened and noted now, whatever the program asked.
    let defer = defer_asked and not c.cis[i].framed
    if good and c.cis[i].f_new and c.cis[i].enc and ll_data.dpdu_len(var rx) > 0 and not defer
        var ek = ll_cipher.enc_key_new()
        cis_key(var c, i, var ek)
        let dir = cis_dir(var c, i) ^ ll_cipher.DIR_CENTRAL
        if not cc.open(var ek, c.cis[i].rx_num, dir, var rx)
            c.cis[i].f_new = false
            c.cis[i].f_ack = false
            cis_close(var c, i, ll_iso.REASON_MIC_FAILURE)
            return
    if good
        ll_iso.sync_anchor(var c.cis[i], c.cis[i].sub, start)
    c.cis[i].defer = defer
    ll_iso.rx_apply(var c.cis[i], c.cis[i].ev, c.cis[i].sub, var rx, good, now)
    c.cis[i].defer = false
    if good and c.cis[i].state == ll_iso.S_WAIT
        c.cis[i].state = ll_iso.S_UP
        c.cis[i].status = STATUS_SUCCESS
        c.cis[i].owed = c.cis[i].owed | ll_iso.EV_ESTABLISHED

// Open and put in place the payload a subevent received and left waiting (`ctl_cis_rx_slow` with `defer`), from the PDU `rx` it
// came in, for the stream that has one.  The radio program does this in the time the next subevent's receiver waits, and before it
// reads another packet into `rx`: the payload of an encrypted stream is opened here, 150 microseconds of the cipher that the time
// between two subevents does not hold, and a MIC that does not match ends the stream with MIC Failure, the SDU being marked
// possibly invalid.  True when it did something.
@tier(embedded)
fn ctl_cis_flush_copies<C: Cipher[e]>(var c: Controller, var cc: C, var rx: Pdu) -> Bool [e]
    for i in 0..ctl_limits.cis_slots()
        if c.cis[i].cp_n > 0
            if c.cis[i].enc
                var ek = ll_cipher.enc_key_new()
                cis_key(var c, i, var ek)
                let dir = cis_dir(var c, i) ^ ll_cipher.DIR_CENTRAL
                let f0 = cc.faults()
                if not cc.open(var ek, c.cis[i].cp_num, dir, var rx)
                    ll_iso.rx_spoil(var c.cis[i])
                    if cc.faults() != f0
                        cis_close(var c, i, ll_link.REASON_HARDWARE_FAILURE)
                    else
                        cis_close(var c, i, ll_iso.REASON_MIC_FAILURE)
                    return true
            return ll_iso.rx_copy(var c.cis[i], var rx)
    false

// The subevent is done at `now`: the next is due, and when the event is over (the last subevent, or a CIE) the next event
// follows.  A stream the supervision gave up on is closed.
@satisfies("REQ-BLE-CTL-053")
@tier(embedded)
@tier(embedded)
fn ctl_cis_note_err(var c: Controller, i: Int, err: Int)
    if c.cis[i].err_n == 0
        c.cis[i].err_first = err
    c.cis[i].err_n = c.cis[i].err_n + 1
    if err < c.cis[i].err_min
        c.cis[i].err_min = err
    if err > c.cis[i].err_max
        c.cis[i].err_max = err
    var late = 0
    if err > 30
        late = 1
        c.cis[i].late_n = c.cis[i].late_n + 1
    c.cis[i].late_mask = ((c.cis[i].late_mask << 1) | late) & 0xFFFFFFFFFFFF

fn ctl_cis_done(var c: Controller, i: Int, now: Int)
    ll_iso.sub_done(var c.cis[i], c.cis[i].sub)
    if not ll_iso.event_over(var c.cis[i])
        return
    // The flush points of the payloads whose last subevent was in this event pass at its end, and are acted on now and not at the
    // start of the next event: the Host gets the credit of an SDU, or the report that it was lost, an ISO interval sooner.  A
    // payload the Peripheral sent in the last subevent is acknowledged by no packet of this event, and flushed here it is
    // counted as acknowledged (Section 4.5.9).
    ll_iso.tx_flush(var c.cis[i], c.cis[i].ev, c.cis[i].nse + 1)
    ll_iso.rx_flush(var c.cis[i], c.cis[i].ev, c.cis[i].nse + 1, var c.links[c.cis[i].acl].tmp)
    let r = ll_iso.event_end(var c.cis[i], now)
    if r != 0
        ctl_cis_lost(var c, i, r)

// The cipher failed on the stream in slot `i`: it ends with Hardware Failure.
@satisfies("REQ-BLE-CTL-063")
@tier(embedded)
fn ctl_cis_fault(var c: Controller, i: Int)
    cis_close(var c, i, ll_link.REASON_HARDWARE_FAILURE)

// The ACL link `ls` ended: its streams end with it.
@satisfies("REQ-BLE-CTL-060")
@tier(embedded)
fn ctl_cis_acl_ended(var c: Controller, ls: Int, reason: Int)
    cis_acl_lost(var c, ls, reason)

// ── The Central: LE Set CIG Parameters, LE Create CIS and the creation procedure ──

// The events ahead of the one under way at which the first anchor of a stream is referenced: far enough that LL_CIS_REQ,
// the Host's answer, LL_CIS_RSP and LL_CIS_IND fit before it.  At least `CIS_REF_EVENTS` events and at least 150 ms.
const CIS_REF_EVENTS = 8
const CIS_REF_US = 150000

// The earliest a stream's first anchor may be after the anchor of the connection event it is referenced to: the
// event's own exchanges (two packets of the longest PDU and the spaces between) are over.
const CIS_OFFSET_MIN_US = 2500

// The width of the window of first anchors LL_CIS_REQ offers the Peripheral.
const CIS_WINDOW_US = 500

// How many events beyond the first choice a stream's reference may be moved to find the place on the group's grid that
// fits between two connection events.
const CIS_SEARCH_EVENTS = 64

// A creation procedure the Peripheral does not answer in 40 seconds fails (Section 5.2).
const CIS_PROC_TIMEOUT_US = 40000000

// The raw request of LE Set CIG Parameters for stream `k` of the command into plan `j`.
@tier(embedded)
fn plan_from_command(var c: Controller, k: Int, var p: Vec[CisPlan; 8], j: Int)
    let at = 15 + 9 * k
    p[j].cis_id = h4_rx.h4_param(var c.rx, at)
    p[j].max_sdu_c = param_u16(var c, at + 1)
    p[j].max_sdu_p = param_u16(var c, at + 3)
    p[j].phy_c = h4_rx.h4_param(var c.rx, at + 5)
    p[j].phy_p = h4_rx.h4_param(var c.rx, at + 6)
    p[j].rtn_c = h4_rx.h4_param(var c.rx, at + 7)
    p[j].rtn_p = h4_rx.h4_param(var c.rx, at + 8)

// The status of LE Set CIG Parameters for the command, with the derivation in `plans` and `g` when it is 0: the ranges of the
// fields, the group (it must be configurable, a data path may not lose its direction), the room, and the parameters
// `ll_iso.plan_cig` derives for the streams of the group, those the command names and those the group already held.
@satisfies("REQ-BLE-CTL-074")
@tier(embedded)
fn cig_plan(var c: Controller, n: Int, var plans: Vec[CisPlan; 8], var g: GroupPlan,
            var total_out: Vec[Int; 1]) -> Int
    let cig_id = h4_rx.h4_param(var c.rx, 0)
    let sdu_c = h4_rx.h4_param(var c.rx, 1) | (h4_rx.h4_param(var c.rx, 2) << 8) | (h4_rx.h4_param(var c.rx, 3) << 16)
    let sdu_p = h4_rx.h4_param(var c.rx, 4) | (h4_rx.h4_param(var c.rx, 5) << 8) | (h4_rx.h4_param(var c.rx, 6) << 16)
    let lat_c = param_u16(var c, 10)
    let lat_p = param_u16(var c, 12)
    if cig_id > 0xEF or sdu_c < 255 or sdu_c > 0xFFFFF or sdu_p < 255 or sdu_p > 0xFFFFF
        return STATUS_INVALID_PARAMETERS
    if h4_rx.h4_param(var c.rx, 7) > 7 or h4_rx.h4_param(var c.rx, 8) > 1 or h4_rx.h4_param(var c.rx, 9) > 2
        return STATUS_INVALID_PARAMETERS
    if lat_c < 5 or lat_c > 0xFA0 or lat_p < 5 or lat_p > 0xFA0
        return STATUS_INVALID_PARAMETERS
    let gi = cig_slot(var c, cig_id)
    if gi >= 0 and c.cigs[gi].state != ll_iso.G_CONFIGURABLE
        return STATUS_COMMAND_DISALLOWED
    if gi < 0
        var free_cigs = 0
        for k in 0..ctl_limits.cig_slots()
            if not c.cigs[k].used
                free_cigs = free_cigs + 1
        if free_cigs == 0
            return ll_iso.STATUS_MEMORY_CAPACITY
    // The streams the group holds, and the ones this command adds or changes.
    var total = 0
    var fresh = 0
    for i in 0..ctl_limits.cis_slots()
        if c.cis[i].state == ll_iso.S_CONFIG and c.cis[i].cig_id == cig_id and c.cis[i].central
            var named = false
            for k in 0..n
                if h4_rx.h4_param(var c.rx, 15 + 9 * k) == c.cis[i].cis_id
                    named = true
            if not named
                if total >= 8
                    return ll_iso.STATUS_MEMORY_CAPACITY
                plans[total].slot = i
                plans[total].cis_id = c.cis[i].cis_id
                plans[total].max_sdu_c = c.cis[i].max_sdu_c
                plans[total].max_sdu_p = c.cis[i].max_sdu_p
                plans[total].phy_c = c.cis[i].rq_phy_c
                plans[total].phy_p = c.cis[i].rq_phy_p
                plans[total].rtn_c = c.cis[i].rq_rtn_c
                plans[total].rtn_p = c.cis[i].rq_rtn_p
                total = total + 1
    for k in 0..n
        let cis_id = h4_rx.h4_param(var c.rx, 15 + 9 * k)
        if cis_id > 0xEF
            return STATUS_INVALID_PARAMETERS
        for j in 0..k
            if h4_rx.h4_param(var c.rx, 15 + 9 * j) == cis_id
                return STATUS_INVALID_PARAMETERS
        if total >= 8
            return ll_iso.STATUS_MEMORY_CAPACITY
        let have = cis_find(var c, cig_id, cis_id)
        if have >= 0 and (c.cis[have].state != ll_iso.S_CONFIG or not c.cis[have].central)
            return STATUS_COMMAND_DISALLOWED
        if have < 0
            fresh = fresh + 1
        plans[total].slot = have
        plan_from_command(var c, k, var plans, total)
        // A path whose direction the new configuration takes away.
        if have >= 0
            if c.cis[have].dp_in and plans[total].max_sdu_c == 0
                return STATUS_COMMAND_DISALLOWED
            if c.cis[have].dp_out and plans[total].max_sdu_p == 0
                return STATUS_COMMAND_DISALLOWED
        total = total + 1
    var free_cis = 0
    for k in 0..ctl_limits.cis_slots()
        if c.cis[k].state == ll_iso.S_FREE
            free_cis = free_cis + 1
    if fresh > free_cis
        return ll_iso.STATUS_MEMORY_CAPACITY
    total_out[0] = total
    if total == 0
        return 0
    g.framing = h4_rx.h4_param(var c.rx, 9)
    ll_iso.plan_cig(var plans, total, sdu_c, sdu_p, lat_c, lat_p, h4_rx.h4_param(var c.rx, 8), c.radio, var g)

// Store the group and its streams as `cig_plan` derived them.
@satisfies("REQ-BLE-CTL-074")
@tier(embedded)
fn cig_commit(var c: Controller, n: Int, total: Int, var plans: Vec[CisPlan; 8], var g: GroupPlan)
    let cig_id = h4_rx.h4_param(var c.rx, 0)
    var gi = cig_slot(var c, cig_id)
    if gi < 0
        for k in 0..ctl_limits.cig_slots()
            if gi < 0 and not c.cigs[k].used
                gi = k
        c.cigs[gi].used = true
        c.cigs[gi].cig_id = cig_id
        c.cigs[gi].state = ll_iso.G_CONFIGURABLE
        c.cigs[gi].ref_ok = false
    c.cigs[gi].sdu_int_c = h4_rx.h4_param(var c.rx, 1) | (h4_rx.h4_param(var c.rx, 2) << 8) | (h4_rx.h4_param(var c.rx, 3) << 16)
    c.cigs[gi].sdu_int_p = h4_rx.h4_param(var c.rx, 4) | (h4_rx.h4_param(var c.rx, 5) << 8) | (h4_rx.h4_param(var c.rx, 6) << 16)
    c.cigs[gi].sca = h4_rx.h4_param(var c.rx, 7)
    c.cigs[gi].packing = h4_rx.h4_param(var c.rx, 8)
    c.cigs[gi].framing = h4_rx.h4_param(var c.rx, 9)
    c.cigs[gi].lat_c = param_u16(var c, 10)
    c.cigs[gi].lat_p = param_u16(var c, 12)
    c.cigs[gi].test = false
    c.cigs[gi].ft_c = g.ft_c
    c.cigs[gi].ft_p = g.ft_p
    c.cigs[gi].iso_int = g.iso_us / ll_iso.UNIT_US
    c.cigs[gi].sync = g.sync
    for j in 0..total
        var i = plans[j].slot
        if i < 0
            i = cis_free_slot(var c)
        c.cis[i].state = ll_iso.S_CONFIG
        c.cis[i].central = true
        c.cis[i].cig_id = cig_id
        c.cis[i].cis_id = plans[j].cis_id
        c.cis[i].framed = c.cigs[gi].framing >= 1
        c.cis[i].unseg = c.cigs[gi].framing == 2
        c.cis[i].phy = plans[j].phy
        c.cis[i].sdu_int_c = c.cigs[gi].sdu_int_c
        c.cis[i].sdu_int_p = c.cigs[gi].sdu_int_p
        c.cis[i].max_sdu_c = plans[j].max_sdu_c
        c.cis[i].max_sdu_p = plans[j].max_sdu_p
        c.cis[i].max_pdu_c = plans[j].pdu_c
        c.cis[i].max_pdu_p = plans[j].pdu_p
        c.cis[i].nse = plans[j].nse
        c.cis[i].sub_int = plans[j].sub_int
        c.cis[i].bn_c = plans[j].bn_c
        c.cis[i].bn_p = plans[j].bn_p
        c.cis[i].ft_c = g.ft_c
        c.cis[i].ft_p = g.ft_p
        c.cis[i].iso_int = c.cigs[gi].iso_int
        c.cis[i].cig_sync = g.sync
        c.cis[i].cis_sync = plans[j].cis_sync
        c.cis[i].off_cig = plans[j].off
        c.cis[i].rq_phy_c = plans[j].phy_c
        c.cis[i].rq_phy_p = plans[j].phy_p
        c.cis[i].rq_rtn_c = plans[j].rtn_c
        c.cis[i].rq_rtn_p = plans[j].rtn_p

// LE Set CIG Parameters (Section 7.8.97): create the group or change its streams from the SDU-level request, the
// Controller deriving ISO_Interval, the PHY, the PDU sizes, BN, NSE, FT and the arrangement.  The answer carries the handle of
// each stream the command names.
@satisfies("REQ-BLE-CTL-074")
@tier(embedded)
fn cmd_le_set_cig_parameters(var c: Controller)
    let len = h4_rx.h4_param_len(var c.rx)
    let n = h4_rx.h4_param(var c.rx, 14)
    var status = STATUS_INVALID_PARAMETERS
    var plans: Vec[CisPlan; 8] = Vec.new()
    for _ in 0..8
        let _p = plans.push(ll_iso.plan_new())
    var g = ll_iso.group_plan_new()
    var total: Vec[Int; 1] = Vec.new()
    let _t = total.push(0)
    if len >= 15 and len == 15 + 9 * n and n <= 8
        status = cig_plan(var c, n, var plans, var g, var total)
    if status == STATUS_SUCCESS
        cig_commit(var c, n, total[0], var plans, var g)
    let slot = complete_begin(var c, OP_LE_SET_CIG_PARAMETERS, status)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put(var c.pool, slot, h4_rx.h4_param(var c.rx, 0))
    if status != STATUS_SUCCESS
        let _b = ctl_pool.pool_put(var c.pool, slot, 0)
        complete_send(var c, slot)
        return
    let _c = ctl_pool.pool_put(var c.pool, slot, n)
    for k in 0..n
        let i = cis_find(var c, h4_rx.h4_param(var c.rx, 0), h4_rx.h4_param(var c.rx, 15 + 9 * k))
        let _d = ctl_pool.pool_put_u16(var c.pool, slot, c.cis[i].handle)
    complete_send(var c, slot)

// A random access address for a new stream, valid under Section 2.1.2 and not the connection's or another stream's.
@satisfies("REQ-BLE-CTL-075")
@tier(embedded)
fn cis_new_aa(var c: Controller, ls: Int) -> Int
    var aa = 0
    for _ in 0..16
        aa = ll_init.make_aa(var c.init, c.links[ls].aa, ll_radio_adv_aa())
        var clash = false
        for k in 0..ctl_limits.cis_slots()
            if c.cis[k].state != ll_iso.S_FREE and c.cis[k].state != ll_iso.S_CONFIG and c.cis[k].aa == aa
                clash = true
        if not clash
            break
    aa

@tier(embedded)
fn ll_radio_adv_aa() -> Int
    0x8E89BED6

// Whether a creation procedure runs on the link `ls` other than the stream `except`'s: a request sent and not answered, or an
// indication not yet sent.
@tier(embedded)
fn cis_busy_acl(var c: Controller, ls: Int, except: Int) -> Bool
    for k in 0..ctl_limits.cis_slots()
        if k != except and c.cis[k].acl == ls
            let st = c.cis[k].state
            if st == ll_iso.S_IND or st == ll_iso.S_CREATING and (c.cis[k].owed & ll_iso.EV_SEND_REQ) == 0
                return true
    false

// LE Create CIS (Section 7.8.99): each stream named is created over the connection named with it.  The answer is a Command
// Status; LE CIS Established follows for each, as the stream comes up or fails.  The peer's features are read first when
// they are not known.
@satisfies("REQ-BLE-CTL-075")
@tier(embedded)
fn cmd_le_create_cis(var c: Controller)
    let len = h4_rx.h4_param_len(var c.rx)
    let n = h4_rx.h4_param(var c.rx, 0)
    var status = STATUS_SUCCESS
    if n < 1 or n > ctl_limits.cis_slots() or len != 1 + 4 * n
        status = STATUS_INVALID_PARAMETERS
    else if not c.host_iso
        status = STATUS_COMMAND_DISALLOWED
    else
        for k in 0..ctl_limits.cis_slots()
            let st = c.cis[k].state
            if st == ll_iso.S_CREATING or st == ll_iso.S_IND
                status = STATUS_COMMAND_DISALLOWED
    if status == STATUS_SUCCESS
        for k in 0..n
            let ch = param_u16(var c, 1 + 4 * k) & 0x0FFF
            let ah = param_u16(var c, 3 + 4 * k) & 0x0FFF
            let i = cis_slot(var c, ch)
            let ls = handle_slot(var c, ah)
            if i < 0 or ls < 0 or not c.cis[i].central
                status = STATUS_UNKNOWN_CONNECTION
            else if c.cis[i].state != ll_iso.S_CONFIG
                status = 0x0B
            else if not slot_central(var c, ls) or c.links[ls].closing
                status = STATUS_COMMAND_DISALLOWED
            for j in 0..k
                if (param_u16(var c, 1 + 4 * j) & 0x0FFF) == ch
                    status = STATUS_INVALID_PARAMETERS
    if status == STATUS_SUCCESS
        for k in 0..n
            let i = cis_slot(var c, param_u16(var c, 1 + 4 * k) & 0x0FFF)
            let st = cig_arrange(var c, c.cis[i].cig_id)
            if st != 0
                status = st
    if status == STATUS_SUCCESS
        for k in 0..n
            let i = cis_slot(var c, param_u16(var c, 1 + 4 * k) & 0x0FFF)
            let ls = handle_slot(var c, param_u16(var c, 3 + 4 * k) & 0x0FFF)
            let gi = cig_slot(var c, c.cis[i].cig_id)
            ll_iso.cis_reset_run(var c.cis[i], ll_iso.S_CREATING)
            c.cis[i].acl = ls
            c.cis[i].central = true
            c.cis[i].aa = cis_new_aa(var c, ls)
            c.cis[i].owed = ll_iso.EV_SEND_REQ
            if not c.links[ls].have_feat
                c.cis[i].owed = c.cis[i].owed | ll_iso.EV_WAIT_FEAT
            c.cis[i].first_us = c.now
            c.cis[i].sup_us = c.links[ls].timeout * ll_link.TIMEOUT_UNIT_US
            if gi >= 0
                c.cigs[gi].state = ll_iso.G_ACTIVE
    answer_command_status(var c, OP_LE_CREATE_CIS, status)

// The offset window for the first anchor of the stream in slot `i` on the link `ls`, and the connection event it is measured
// from: the stream's place on its group's grid.  The first stream of a group sets the grid (its anchor `CIS_OFFSET_MIN_US` after
// the anchor of the reference event, less its own offset in the group); the others are placed on it by the search below.  The
// window is left in `off_min`, `off_max` and `off_ev` of the stream; false when no place was found.
@satisfies("REQ-BLE-CTL-075")
@tier(embedded)
fn cis_place(var c: Controller, i: Int) -> Bool
    let ls = c.cis[i].acl
    let gi = cig_slot(var c, c.cis[i].cig_id)
    if gi < 0
        return false
    let conn = ll_link.interval_us(var c.links[ls])
    let iso = ll_iso.iso_us(var c.cis[i])
    let elen = ll_iso.event_len_us(var c.cis[i])
    var first = CIS_REF_EVENTS
    let by_time = CIS_REF_US / conn + 1
    if by_time > first
        first = by_time
    for k in first..first + CIS_SEARCH_EVENTS
        let ev = (c.links[ls].ev_count + k) & 0xFFFF
        let t = ll_link.link_event_time(var c.links[ls], ev)
        if t < 0
            return false
        var off = 0
        if not c.cigs[gi].ref_ok
            off = CIS_OFFSET_MIN_US
        else
            // The grid point at least CIS_OFFSET_MIN_US after the event's anchor.
            let base = c.cigs[gi].ref_t + c.cis[i].off_cig
            var m = 0
            let need = t + CIS_OFFSET_MIN_US - base
            if need > 0
                m = (need + iso - 1) / iso
            off = base + m * iso - t
        if off + elen + ll_iso.T_MSS_CIS_US <= conn
            c.cis[i].off_ev = ev
            c.cis[i].off_min = off
            var wide = CIS_WINDOW_US
            if off + wide + elen + ll_iso.T_MSS_CIS_US > conn
                wide = conn - off - elen - ll_iso.T_MSS_CIS_US
            c.cis[i].off_max = off + wide
            if not c.cigs[gi].ref_ok
                c.cigs[gi].ref_t = t + off - c.cis[i].off_cig
                c.cigs[gi].ref_ok = true
            return true
    false

// The creation procedures of the Central that are not a radio event, run at every step: the peer's features are read before
// the request, a request goes out when its connection is free of another procedure, an indication goes out after the
// response, and a procedure the peer leaves unanswered fails.  True when something was done.
@satisfies("REQ-BLE-CTL-075")
@tier(embedded)
fn ctl_iso_central_poll(var c: Controller) -> Bool
    var did = false
    for i in 0..ctl_limits.cis_slots()
        let st = c.cis[i].state
        let ls = c.cis[i].acl
        if c.cis[i].central and (st == ll_iso.S_CREATING or st == ll_iso.S_IND)
            if not ll_link.link_live(var c.links[ls]) or c.links[ls].closing
                cis_close(var c, i, ll_iso.STATUS_FAILED_TO_ESTABLISH)
                did = true
            else if (c.cis[i].owed & ll_iso.EV_WAIT_FEAT) != 0
                if c.links[ls].have_feat
                    c.cis[i].owed = c.cis[i].owed & (0xFFFF ^ ll_iso.EV_WAIT_FEAT)
                    if (c.links[ls].peer_feat[3] as Int & 0x20) == 0 or c.cis[i].unseg and (c.links[ls].peer_feat[5] as Int & 0x20) == 0
                        cis_close(var c, i, ll_iso.STATUS_UNSUPPORTED_REMOTE)
                    did = true
                else if c.links[ls].proc == ll_link.PROC_NONE and not ll_link.link_owes(var c.links[ls], ll_link.EV_FEATURES)
                    let _s = ll_link.link_read_features(var c.links[ls])
            else if (c.cis[i].owed & ll_iso.EV_SEND_REQ) != 0 and c.cis[i].unseg and (c.links[ls].peer_feat[5] as Int & 0x20) == 0
                // The peer's feature set is known and has no Unsegmented mode: the stream is not made (a Host can ask for Segmentable mode).
                cis_close(var c, i, ll_iso.STATUS_UNSUPPORTED_REMOTE)
                did = true
            else if (c.cis[i].owed & ll_iso.EV_SEND_REQ) != 0
                if not cis_busy_acl(var c, ls, i)
                    if not cis_place(var c, i)
                        cis_close(var c, i, ll_iso.STATUS_FAILED_TO_ESTABLISH)
                        did = true
                    else
                        ll_iso.put_cis_req(var c.links[ls].tmp, var c.cis[i])
                        if iso_send(c, ls)
                            c.cis[i].owed = (c.cis[i].owed & (0xFFFF ^ ll_iso.EV_SEND_REQ)) | ll_iso.EV_WAIT_RSP
                            c.cis[i].first_us = c.now
                            did = true
            else if (c.cis[i].owed & ll_iso.EV_SEND_IND) != 0
                did = cis_send_ind(var c, i) or did
            else if (c.cis[i].owed & ll_iso.EV_WAIT_RSP) != 0 and c.now - c.cis[i].first_us > CIS_PROC_TIMEOUT_US
                cis_close(var c, i, ll_iso.REASON_RESPONSE_TIMEOUT)
                did = true
    did

// LL_CIS_IND for the stream in slot `i`: the offset the response allowed, the event the request named, the access address and
// the delays; the stream is scheduled at the anchor that gives.  A reference event that has passed, or a connection update
// before it, fails the stream.  False when the control queue was full and the indication waits.
@satisfies("REQ-BLE-CTL-075")
@tier(embedded)
fn cis_send_ind(var c: Controller, i: Int) -> Bool
    let ls = c.cis[i].acl
    let t = ll_link.link_event_time(var c.links[ls], c.cis[i].off_ev)
    if t < 0 or t + c.cis[i].off_min < c.now + CIS_LEAD_US
        cis_close(var c, i, ll_iso.STATUS_FAILED_TO_ESTABLISH)
        return true
    c.cis[i].cis_offset = c.cis[i].off_min
    c.cis[i].ind_ev = c.cis[i].off_ev
    ll_iso.put_cis_ind(var c.links[ls].tmp, var c.cis[i])
    if not iso_send(c, ls)
        return false
    c.cis[i].owed = c.cis[i].owed & (0xFFFF ^ ll_iso.EV_SEND_IND)
    c.cis[i].e_ind = c.links[ls].ev_count
    c.cis[i].t_ind = t
    c.cis[i].anchor = t + c.cis[i].cis_offset
    c.cis[i].first_us = c.cis[i].anchor
    c.cis[i].last_rx = c.cis[i].anchor
    c.cis[i].ev = 0
    c.cis[i].sub = 1
    c.cis[i].synced = false
    c.cis[i].ev_open = false
    c.cis[i].enc = ll_link.link_encrypted(var c.links[ls])
    c.cis[i].state = ll_iso.S_WAIT
    true

// LL_CIS_RSP on the link `ls` (Central): the stream waiting for it takes the window the Peripheral accepted, which must lie
// within the one asked for; the indication follows.
@satisfies("REQ-BLE-CTL-075")
@tier(embedded)
fn iso_rsp(var c: Controller, ls: Int, var rx: Pdu)
    var i = -1
    for k in 0..ctl_limits.cis_slots()
        if c.cis[k].acl == ls and c.cis[k].state == ll_iso.S_CREATING and (c.cis[k].owed & ll_iso.EV_WAIT_RSP) != 0
            i = k
    if i < 0
        return
    let want_min = c.cis[i].off_min
    let want_max = c.cis[i].off_max
    let want_ev = c.cis[i].off_ev
    ll_iso.get_cis_rsp(var rx, var c.cis[i])
    // The window the Peripheral gave lies within ours (the same event).
    if c.cis[i].off_ev != want_ev or c.cis[i].off_min < want_min or c.cis[i].off_max > want_max or c.cis[i].off_max < c.cis[i].off_min
        cis_close(var c, i, ll_iso.STATUS_INVALID_LL_PARAMETERS)
        return
    c.cis[i].owed = (c.cis[i].owed & (0xFFFF ^ ll_iso.EV_WAIT_RSP)) | ll_iso.EV_SEND_IND
    c.cis[i].state = ll_iso.S_IND
    let _s = cis_send_ind(var c, i)

// LL_REJECT_EXT_IND (or LL_REJECT_IND) or LL_UNKNOWN_RSP for the request of the stream waiting on the link `ls`: the procedure ends
// with `code` and the Host is told in LE CIS Established.  The configuration stays.
@satisfies("REQ-BLE-CTL-075")
@tier(embedded)
fn iso_refused(var c: Controller, ls: Int, code: Int)
    for k in 0..ctl_limits.cis_slots()
        if c.cis[k].acl == ls and c.cis[k].central and c.cis[k].state == ll_iso.S_CREATING and (c.cis[k].owed & ll_iso.EV_WAIT_RSP) != 0
            cis_close(var c, k, code)
            return

// For a group configured by LE Set CIG Parameters Test the Controller arranges the streams when the first is created
// (Section 4.5.14.3): the Host gave each stream's parameters one by one, so the Sub_Interval, the offsets and the delays
// follow from the group as it stands.  The status 0x12 when it does not fit the ISO interval.  A group the Controller
// planned itself (LE Set CIG Parameters) is arranged already.
@satisfies("REQ-BLE-CTL-074")
@tier(embedded)
fn cig_arrange(var c: Controller, cig_id: Int) -> Int
    let gi = cig_slot(var c, cig_id)
    if gi < 0 or not c.cigs[gi].test or c.cigs[gi].ref_ok
        return 0
    var plans: Vec[CisPlan; 8] = Vec.new()
    for _ in 0..8
        let _p = plans.push(ll_iso.plan_new())
    var n = 0
    var se_all = 0
    for i in 0..ctl_limits.cis_slots()
        if c.cis[i].state == ll_iso.S_CONFIG and c.cis[i].central and c.cis[i].cig_id == cig_id and n < 8
            plans[n].slot = i
            plans[n].phy = c.cis[i].phy
            plans[n].pdu_c = c.cis[i].max_pdu_c
            plans[n].pdu_p = c.cis[i].max_pdu_p
            plans[n].nse = c.cis[i].nse
            let se = ll_iso.plan_slot_us(c.radio, c.cis[i].phy, c.cis[i].max_pdu_c, c.cis[i].max_pdu_p)
            if se > se_all
                se_all = se
            n = n + 1
    let packing = c.cigs[gi].packing
    for j in 0..n
        if plans[j].nse > 1 and packing == 1 and n > 1
            plans[j].sub_int = ll_phy_greater(400, n * se_all)
        else if plans[j].nse > 1
            plans[j].sub_int = ll_phy_greater(400, se_all)
        else
            plans[j].sub_int = 0
    var g = ll_iso.group_plan_new()
    let st = ll_iso.plan_arrange(var plans, n, packing, c.cigs[gi].iso_int * ll_iso.UNIT_US, se_all, c.radio, var g)
    if st != 0
        return st
    for j in 0..n
        let i = plans[j].slot
        c.cis[i].sub_int = plans[j].sub_int
        c.cis[i].off_cig = plans[j].off
        c.cis[i].cis_sync = plans[j].cis_sync
        c.cis[i].cig_sync = g.sync
    c.cigs[gi].sync = g.sync
    0

@tier(embedded)
fn ll_phy_greater(a: Int, b: Int) -> Int
    if a > b
        a
    else
        b

// ── Broadcast isochronous groups ─────────────────────────────────────
//
// [Vol 6] Part B, Section 4.4.6 and 5.6; [Vol 4] Part E, Section 7.7.65.27 to 7.7.65.30 and 7.8.103 to 7.8.109.  The Controller holds
// `ctl_limits.big_slots()` groups (`bigs`) and `ctl_limits.bis_slots()` streams of them (`bis`, `ll_iso.Cis` values with the fields set from the
// group by `ll_big.bis_config`), sized from the keys `ctl_bigs` and `ctl_bis`.  A stream's connection handle is
// `ll_big.BIS_HANDLE_BASE` plus its slot and stays with the slot; the Host is given them by the LE Create BIG Complete event.  The
// Isochronous Broadcaster's group rides the periodic advertising train of an advertising set (`PerAdv.big`): its BIGInfo is the
// ACAD of the train's AUX_SYNC_IND PDUs.  The group's timing and PDUs are in `ll_big.nv`; this section is the Host's side of it
// (the commands, the events, the ISO Data packets) and the radio program's view (`ctl_big_*`).
//
// A build without them (`ctl_limits.big_on()` 0) answers none of the commands.

// The time from LE Create BIG to the first anchor point, for the key to be derived and the train to carry the BIGInfo before it.
const BIG_START_US = 40000

// The microseconds a booking for a BIG event covers beyond its longest exchange.
const BIG_BOOK_MARGIN_US = 300

// The most periodic advertising data a train holds when its AUX_SYNC_IND carries the BIGInfo too: the PDU's 255 octets less the
// header, the Tx Power, the 59 octets of the BIGInfo of an encrypted BIG, and room for a pointer.
const BIG_DATA_MAX = 160

// The BIG with the BIG_Handle `handle` in any state but free, -1 for none, and a free slot.
@tier(embedded)
fn big_slot(var c: Controller, handle: Int) -> Int
    for g in 0..ctl_limits.big_slots()
        if c.bigs[g].state != ll_big.B_FREE and c.bigs[g].handle == handle
            return g
    -1

@tier(embedded)
fn big_free_slot(var c: Controller) -> Int
    for g in 0..ctl_limits.big_slots()
        if c.bigs[g].state == ll_big.B_FREE
            return g
    -1

// The first of `n` consecutive free stream slots, -1 for none.
@tier(embedded)
fn bis_free_run(var c: Controller, n: Int) -> Int
    var run = 0
    for i in 0..ctl_limits.bis_slots()
        if c.bis[i].state == ll_iso.S_FREE
            run = run + 1
            if run == n
                return i - n + 1
        else
            run = 0
    -1

// The stream with the connection handle `handle`, -1 for none.
@tier(embedded)
fn bis_slot(var c: Controller, handle: Int) -> Int
    for i in 0..ctl_limits.bis_slots()
        if c.bis[i].state != ll_iso.S_FREE and c.bis[i].handle == handle
            return i
    -1

// The groups and streams in their power-on state: every one gone, the handles fixed by the slot.
@tier(embedded)
fn big_reset(var c: Controller)
    if not ctl_limits.big_on()
        return
    for i in 0..ctl_limits.bis_slots()
        c.bis[i].dp_in = false
        c.bis[i].dp_out = false
        c.bis[i].central = false
        ll_iso.cis_reset_run(var c.bis[i], ll_iso.S_FREE)
        c.bis[i].handle = ll_big.BIS_HANDLE_BASE + i
    for g in 0..ctl_limits.big_slots()
        ll_big.big_clear(var c.bigs[g])
    for k in 0..ctl_limits.padv_n()
        c.pads[k].big = -1
        c.pads[k].acad_n = 0
    c.big_rnd_n = 0
    c.bi_owed = false
    c.bi_n = 0

// The group in slot `g` and its streams are forgotten: the streams are free, the train carries no BIGInfo.
@tier(embedded)
fn big_release(var c: Controller, g: Int)
    var n = c.bigs[g].num_bis
    if c.bigs[g].nrx > n
        n = c.bigs[g].nrx
    for j in 0..n
        let i = c.bigs[g].bis0 + j
        c.bis[i].dp_in = false
        c.bis[i].dp_out = false
        c.bis[i].central = false
        ll_iso.cis_reset_run(var c.bis[i], ll_iso.S_FREE)
    let k = c.bigs[g].set
    if c.bigs[g].broadcaster and k >= 0 and k < ctl_limits.padv_n()
        c.pads[k].big = -1
        c.pads[k].acad_n = 0
    ll_big.big_clear(var c.bigs[g])

// Whether a group is in any state but free, and whether one sends or listens for events.
@tier(embedded)
fn big_active(var c: Controller) -> Bool
    if not ctl_limits.big_on()
        return false
    for g in 0..ctl_limits.big_slots()
        if c.bigs[g].state != ll_big.B_FREE
            return true
    false

// ── The random octets of an encrypted group ──────────────────────────

// Whether the program is to supply random octets to `ctl_big_random_put`: the GSKD and the GIV of a BIG (24 octets) come from
// a source of entropy (Section 4.4.6.10), which the program tops up when the Controller has a build with groups.
pub @no_alloc
@tier(embedded)
fn ctl_big_wants_random(var c: Controller) -> Bool
    ctl_limits.big_on() and c.big_rnd_n < 24

// Give the pool 12 random octets.
pub @no_alloc
@tier(embedded)
fn ctl_big_random_put(var c: Controller, var v: Vec[u8; 12])
    for k in 0..12
        if c.big_rnd_n < 24
            c.big_rnd[c.big_rnd_n] = v[k]
            c.big_rnd_n = c.big_rnd_n + 1

// ── LE Create BIG, LE Create BIG Test, LE Terminate BIG ──────────────

// The microseconds a periodic AUX_SYNC_IND takes more with the BIGInfo of an encrypted group in its ACAD, at most, on `phy`.
@tier(embedded)
fn big_acad_extra_us(phy: Int) -> Int
    ll_phy.air_us(phy, true, 2 + ll_big.INFO_AD_MAX) - ll_phy.air_us(phy, true, 2)

// The time of the first anchor point of the group in slot `g` on the train in slot `k`: `BIG_START_US` from now, and, when the train
// sends events, right behind the first one at or after that, so that the BIGInfo of that event leads to the anchor and no event of
// the train falls inside a BIG event (their intervals are commonly multiples of one another).
@tier(embedded)
fn big_first_anchor(var c: Controller, k: Int) -> Int
    var t = c.now + BIG_START_US
    if c.pads[k].on and c.pads[k].run
        let i = xset_find(var c, c.pads[k].handle)
        var phy = ll_phy.PHY_1M
        if i >= 0
            phy = c.xsets[i].sphy as Int
        let n = ll_per.intervals_to(var c.pads[k], t)
        let at = c.pads[k].due + n * ll_per.interval_us(var c.pads[k])
        let ev = ll_per.event_us(var c.pads[k], phy) + big_acad_extra_us(phy)
        t = at + ll_phy_greater(ev + 600, ll_big.INFO_LEAD_US + 100)
    t

// LE Create BIG (Section 7.8.103) and LE Create BIG Test (Section 7.8.104): Command Status now, LE Create BIG Complete once the
// first event has been sent.  The group is unframed; the errors are those of the specification.
@satisfies("REQ-BLE-CTL-100")
@satisfies("REQ-BLE-CTL-105")
@tier(embedded)
fn cmd_le_create_big(var c: Controller, test: Bool)
    var op = OP_LE_CREATE_BIG
    if test
        op = OP_LE_CREATE_BIG_TEST
    let handle = h4_rx.h4_param(var c.rx, 0)
    let ah = h4_rx.h4_param(var c.rx, 1)
    let num = h4_rx.h4_param(var c.rx, 2)
    let sdu_int = param_u24(var c, 3)
    var iso = 0
    var nse = 0
    var max_sdu = 0
    var max_pdu = 0
    var max_lat = 0
    var rtn = 0
    var phys = 0
    var packing = 0
    var framing = 0
    var bn = 0
    var irc = 0
    var pto = 0
    var enc = 0
    var code_at = 15
    if test
        iso = param_u16(var c, 6)
        nse = h4_rx.h4_param(var c.rx, 8)
        max_sdu = param_u16(var c, 9)
        max_pdu = param_u16(var c, 11)
        phys = h4_rx.h4_param(var c.rx, 13)
        packing = h4_rx.h4_param(var c.rx, 14)
        framing = h4_rx.h4_param(var c.rx, 15)
        bn = h4_rx.h4_param(var c.rx, 16)
        irc = h4_rx.h4_param(var c.rx, 17)
        pto = h4_rx.h4_param(var c.rx, 18)
        enc = h4_rx.h4_param(var c.rx, 19)
        code_at = 20
    else
        max_sdu = param_u16(var c, 6)
        max_lat = param_u16(var c, 8)
        rtn = h4_rx.h4_param(var c.rx, 10)
        phys = h4_rx.h4_param(var c.rx, 11)
        packing = h4_rx.h4_param(var c.rx, 12)
        framing = h4_rx.h4_param(var c.rx, 13)
        enc = h4_rx.h4_param(var c.rx, 14)
    var bad = STATUS_INVALID_PARAMETERS
    if test
        bad = STATUS_UNSUPPORTED_FEATURE
    var status = STATUS_SUCCESS
    if handle > 0xEF or ah > 0xEF or enc > 1
        status = STATUS_INVALID_PARAMETERS
    else if (phys & 0xF8) != 0
        status = STATUS_UNSUPPORTED_FEATURE
    else if big_slot(var c, handle) >= 0
        status = STATUS_COMMAND_DISALLOWED
    var k = -1
    if status == STATUS_SUCCESS
        k = padv_find(var c, ah)
        if k < 0 or c.pads[k].big >= 0
            status = ll_xadv.E_UNKNOWN_SET
    var plan = ll_big.plan_new()
    if status == STATUS_SUCCESS
        if test
            status = ll_big.check_big_test(var plan,
                num,
                sdu_int,
                iso,
                nse,
                max_sdu,
                max_pdu,
                phys,
                packing,
                framing,
                bn,
                irc,
                pto,
                enc == 1,
                c.coded,
                c.radio)
        else
            status = ll_big.plan_big(var plan,
                num,
                sdu_int,
                max_sdu,
                max_lat,
                rtn,
                phys,
                packing,
                framing,
                enc == 1,
                c.coded,
                c.radio)
    var g = -1
    var i0 = -1
    if status == STATUS_SUCCESS
        g = big_free_slot(var c)
        i0 = bis_free_run(var c, num)
        if g < 0 or i0 < 0
            status = 0x0D
    if status == STATUS_SUCCESS
        // The train: its data and the BIGInfo have to fit one PDU, and its events the interval.
        let ti = xset_find(var c, c.pads[k].handle)
        var phy = ll_phy.PHY_1M
        if ti >= 0
            phy = c.xsets[ti].sphy as Int
        if c.pads[k].dlen > BIG_DATA_MAX
            status = ll_per.E_TOO_LONG
        else if c.pads[k].on and ll_per.event_us(var c.pads[k], phy) + big_acad_extra_us(phy) + ll_per.TRAIN_GAP_US > ll_per.interval_us(var c.pads[k])
            status = ll_per.E_TOO_LONG
    if status != STATUS_SUCCESS
        answer_command_status(var c, op, status)
        return
    ll_big.big_clear(var c.bigs[g])
    c.bigs[g].state = ll_big.B_CREATE
    c.bigs[g].broadcaster = true
    c.bigs[g].handle = handle
    c.bigs[g].set = k
    c.bigs[g].bis0 = i0
    c.bigs[g].num_bis = num
    c.bigs[g].nse = plan.nse
    c.bigs[g].bn = plan.bn
    c.bigs[g].irc = plan.irc
    c.bigs[g].pto = plan.pto
    c.bigs[g].iso_int = plan.iso
    c.bigs[g].sub_int = plan.sub_int
    c.bigs[g].bis_sp = plan.bis_sp
    c.bigs[g].phy = plan.phy
    c.bigs[g].max_pdu = plan.pdu
    c.bigs[g].max_sdu = max_sdu
    c.bigs[g].sdu_int = sdu_int
    c.bigs[g].framed = framing == 1
    c.bigs[g].packed = packing == 1 and num > 1
    c.bigs[g].enc = enc == 1
    c.bigs[g].sync_delay = plan.sync
    c.bigs[g].latency = plan.latency
    c.big_seed = ll_adv.rng_step(c.big_seed ^ c.now)
    var other = -1
    for h in 0..ctl_limits.big_slots()
        if h != g and c.bigs[h].state != ll_big.B_FREE
            other = c.bigs[h].saa
    let saa = ll_big.make_saa(c.big_seed, num, c.coded, other)
    c.big_seed = ll_adv.rng_step(c.big_seed)
    c.bigs[g].saa = saa
    c.bigs[g].crc = c.big_seed & 0xFFFF
    c.bigs[g].chmap = connect_chmap(var c)
    c.bigs[g].n_used = ll_link.popcount(c.bigs[g].chmap)
    c.bigs[g].mse = 0
    c.bigs[g].anchor = big_first_anchor(var c, k)
    c.bigs[g].first_us = c.bigs[g].anchor
    c.bigs[g].win = 0
    c.bigs[g].key_ok = enc == 0
    if enc == 1
        for j in 0..16
            ll_big.code_put(var c.bigs[g], j, h4_rx.h4_param(var c.rx, code_at + j))
    for j in 0..num
        ll_big.bis_config(var c.bis[i0 + j], var c.bigs[g], j + 1, i0 + j)
    c.pads[k].big = g
    if enc == 0
        ll_big.info_static(var c.bigs[g])
    answer_command_status(var c, op, STATUS_SUCCESS)

// The Group Session Key of the groups that wait for it and the random octets they need: a broadcaster takes the GSKD and GIV
// from the pool of random octets (`ctl_big_random_put`) and derives the key from the Broadcast_Code (Part E, Section 1.1.2).  The
// BIGInfo is made once the key is.  True when something was done.
@satisfies("REQ-BLE-CTL-108")
@tier(embedded)
fn ctl_big_poll(var c: Controller) -> Bool
    if not ctl_limits.big_on()
        return false
    var did = false
    for g in 0..ctl_limits.big_slots()
        if c.bigs[g].state != ll_big.B_FREE and c.bigs[g].enc and not c.bigs[g].key_ok
            if c.bigs[g].broadcaster
                if c.big_rnd_n >= 24
                    ll_big.key_random(var c.bigs[g], var c.big_rnd)
                    c.big_rnd_n = 0
                    ll_cmac.big_gsk(var c.bigk, var c.bigs[g].code, var c.bigs[g].gskd, var c.bigs[g].ek.sk)
                    c.bigs[g].key_ok = true
                    ll_big.info_static(var c.bigs[g])
                    did = true
            else
                ll_cmac.big_gsk(var c.bigk, var c.bigs[g].code, var c.bigs[g].gskd, var c.bigs[g].ek.sk)
                c.bigs[g].key_ok = true
                did = true
    did

// LE Terminate BIG (Section 7.8.105): Command Status now, LE Terminate BIG Complete when the BIG has ended.  A BIG whose creation is
// in progress is stopped and its LE Create BIG Complete event carries Operation Cancelled by Host.  Otherwise the BIG Termination
// procedure begins: BIG_TERMINATE_IND goes out in the control subevents of the next six events, and the BIG ends at the event
// after them.
@satisfies("REQ-BLE-CTL-103")
@tier(embedded)
fn cmd_le_terminate_big(var c: Controller)
    let handle = h4_rx.h4_param(var c.rx, 0)
    let reason = h4_rx.h4_param(var c.rx, 1)
    let g = big_slot(var c, handle)
    var status = STATUS_SUCCESS
    if g < 0
        status = ll_xadv.E_UNKNOWN_SET
    else if not c.bigs[g].broadcaster
        status = STATUS_COMMAND_DISALLOWED
    else if c.bigs[g].state == ll_big.B_TERM or c.bigs[g].state == ll_big.B_STOP
        status = STATUS_COMMAND_DISALLOWED
    if status == STATUS_SUCCESS
        if c.bigs[g].state == ll_big.B_CREATE
            c.bigs[g].state = ll_big.B_STOP
            c.bigs[g].status = ll_big.E_CANCELLED
            c.bigs[g].owed = ll_big.EV_COMPLETE
            c.pads[c.bigs[g].set].acad_n = 0
        else
            var first = c.bigs[g].ev
            if c.bigs[g].ev_open
                first = first + 1
            // One control procedure at a time: the termination follows the instant of a channel map update.
            if c.bigs[g].cm_req and first < c.bigs[g].cm_instant
                first = c.bigs[g].cm_instant
            ll_big.terminate_begin(var c.bigs[g], ll_big.REASON_LOCAL_HOST, first)
            c.bigs[g].term_reason = reason
    answer_command_status(var c, OP_LE_TERMINATE_BIG, status)

// ── The events of a group ────────────────────────────────────────────

// LE Create BIG Complete (Section 7.7.65.27).  A group that did not come up is gone afterwards.
@satisfies("REQ-BLE-CTL-105")
@tier(embedded)
fn ev_big_complete(var c: Controller, g: Int) -> Bool
    let ok = c.bigs[g].status == STATUS_SUCCESS
    if not le_event_enabled(var c, SUB_LE_CREATE_BIG_COMPLETE)
        c.bigs[g].owed = c.bigs[g].owed & (0xFF ^ ll_big.EV_COMPLETE)
        if not ok
            big_release(var c, g)
        return true
    let slot = meta_begin(var c, SUB_LE_CREATE_BIG_COMPLETE)
    if slot == ctl_pool.NO_SLOT
        return false
    let _a = ctl_pool.pool_put(var c.pool, slot, c.bigs[g].status)
    let _b = ctl_pool.pool_put(var c.pool, slot, c.bigs[g].handle)
    if ok
        put_u24(var c, slot, c.bigs[g].sync_delay)
        put_u24(var c, slot, c.bigs[g].latency)
        let _c = ctl_pool.pool_put(var c.pool, slot, c.bigs[g].phy)
        let _d = ctl_pool.pool_put(var c.pool, slot, c.bigs[g].nse)
        let _e = ctl_pool.pool_put(var c.pool, slot, c.bigs[g].bn)
        let _f = ctl_pool.pool_put(var c.pool, slot, c.bigs[g].pto)
        let _h = ctl_pool.pool_put(var c.pool, slot, c.bigs[g].irc)
        let _i = ctl_pool.pool_put_u16(var c.pool, slot, c.bigs[g].max_pdu)
        let _j = ctl_pool.pool_put_u16(var c.pool, slot, c.bigs[g].iso_int)
        let _k = ctl_pool.pool_put(var c.pool, slot, c.bigs[g].num_bis)
        for j in 0..c.bigs[g].num_bis
            let _l = ctl_pool.pool_put_u16(var c.pool, slot, c.bis[c.bigs[g].bis0 + j].handle)
    else
        put_zeros(var c, slot, 17)
    event_send(var c, slot)
    c.bigs[g].owed = c.bigs[g].owed & (0xFF ^ ll_big.EV_COMPLETE)
    if not ok
        big_release(var c, g)
    true

// LE Terminate BIG Complete (Section 7.7.65.28): the group, its streams and their data paths are gone afterwards.
@satisfies("REQ-BLE-CTL-103")
@tier(embedded)
fn ev_big_terminated(var c: Controller, g: Int) -> Bool
    if not le_event_enabled(var c, SUB_LE_TERMINATE_BIG_COMPLETE)
        big_release(var c, g)
        return true
    let slot = meta_begin(var c, SUB_LE_TERMINATE_BIG_COMPLETE)
    if slot == ctl_pool.NO_SLOT
        return false
    let _a = ctl_pool.pool_put(var c.pool, slot, c.bigs[g].handle)
    let _b = ctl_pool.pool_put(var c.pool, slot, c.bigs[g].reason)
    event_send(var c, slot)
    big_release(var c, g)
    true

// Number Of Completed Packets for the SDUs of a stream that the group sent.
@tier(embedded)
fn ev_bis_completed(var c: Controller, i: Int) -> Bool
    let slot = ctl_pool.evt_begin(var c.pool, hci_frame.EVT_NUMBER_OF_COMPLETED_PACKETS)
    if slot == ctl_pool.NO_SLOT
        return false
    let _a = ctl_pool.pool_put(var c.pool, slot, 1)
    let _b = ctl_pool.pool_put_u16(var c.pool, slot, c.bis[i].handle)
    let _c = ctl_pool.pool_put_u16(var c.pool, slot, ll_iso.comp_take(var c.bis[i]))
    event_send(var c, slot)
    true

// The oldest SDU a stream received for the Host goes out as HCI ISO Data packets, as `ev_cis_data` does for a connected stream.
@satisfies("REQ-BLE-CTL-106")
@tier(embedded)
fn ev_bis_data(var c: Controller, i: Int) -> Bool
    if not c.bis[i].dp_out
        ll_iso.out_take(var c.bis[i])
        c.bis[i].out_off = 0
        return true
    let at = c.bis[i].out_head
    let n = c.bis[i].outl[at]
    let done = c.bis[i].out_off
    var room = ll_iso.ISO_LOAD
    if done == 0
        room = ll_iso.ISO_LOAD - 8
    var take = n - done
    var pb = 2
    if take > room
        take = room
        if done == 0
            pb = 0
        else
            pb = 1
    else if done > 0
        pb = 3
    if not work_fits(var c, iso_work_us(var c, take), c.room_us)
        return false
    let slot = ctl_pool.iso_begin(var c.pool, c.bis[i].handle, pb, done == 0)
    if slot == ctl_pool.NO_SLOT
        return false
    if done == 0
        put_u32(var c, slot, c.bis[i].outt[at])
        let _a = ctl_pool.pool_put_u16(var c.pool, slot, c.bis[i].outq[at])
        let _b = ctl_pool.pool_put_u16(var c.pool, slot, (n & 0x0FFF) | (c.bis[i].outs[at] << 14))
    for k in 0..take
        let _c = ctl_pool.pool_put(var c.pool, slot, c.bis[i].outd[at * ll_iso.OUT_OCTETS + done + k] as Int)
    let _d = ctl_pool.iso_send(var c.pool, slot)
    if pb == 0 or pb == 1
        c.bis[i].out_off = done + take
        return true
    ll_iso.out_take(var c.bis[i])
    c.bis[i].out_off = 0
    true

// Queue what the group in slot `g` owes the Host, in the order it came: the complete or established event, the SDUs its streams
// received and the credits for the ones they sent, then the terminated or lost event.  False when the pool ran out of slots.
@satisfies("REQ-BLE-CTL-105")
@tier(embedded)
fn flush_big(var c: Controller, g: Int) -> Bool
    if c.bigs[g].state == ll_big.B_FREE
        return true
    if (c.bigs[g].owed & ll_big.EV_COMPLETE) != 0
        if c.bigs[g].broadcaster
            if not ev_big_complete(var c, g)
                return false
        else if not ev_big_sync_established(var c, g)
            return false
    if c.bigs[g].state == ll_big.B_FREE
        return true
    var streams = c.bigs[g].num_bis
    if not c.bigs[g].broadcaster
        streams = c.bigs[g].nrx
    for j in 0..streams
        let i = c.bigs[g].bis0 + j
        for _ in 0..ll_iso.OUT_SLOTS * ll_iso.SDU_FRAGS
            if ll_iso.out_ready(var c.bis[i]) and not ev_bis_data(var c, i)
                return false
        if (c.bis[i].owed & ll_iso.EV_COMPLETED) != 0 and not ev_bis_completed(var c, i)
            return false
    if (c.bigs[g].owed & ll_big.EV_TERMINATED) != 0
        if c.bigs[g].broadcaster
            return ev_big_terminated(var c, g)
        return ev_big_sync_lost(var c, g)
    true

// ── The BIGInfo of a train this device synchronizes to ───────────────

// The AUX_SYNC_IND of the synchronization in slot `j`, which started at `t_first`, carries a BIGInfo (`n` octets of it at `at` of `rx`).
// It is kept, and reported to the Host with LE BIGInfo Advertising Report once the periodic report is out; a later one replaces an
// earlier that was not reported.
@satisfies("REQ-BLE-CTL-101")
@tier(embedded)
fn ctl_big_info_seen(var c: Controller, j: Int, var rx: Pdu, at: Int, n: Int, t_first: Int)
    let v = ll_big.info_get(var rx, at, n)
    if not v.ok
        return
    c.bi = v
    c.bi_n = n
    for k in 0..n
        c.bi_raw[k] = rx.b[at + k]
    c.bi_sync = c.psyncs[j].handle
    c.bi_t = t_first
    c.bi_seen = c.bi_seen + 1
    c.bi_owed = true
    for g in 0..ctl_limits.big_slots()
        if c.bigs[g].state == ll_big.B_WAIT and not c.bigs[g].broadcaster and c.bigs[g].set == j
            big_sync_take(var c, g, j, t_first)

// LE BIGInfo Advertising Report (Section 7.7.65.34): the BIG the last AUX_SYNC_IND with a BIGInfo announced.
@satisfies("REQ-BLE-CTL-101")
@tier(embedded)
fn ev_biginfo(var c: Controller) -> Bool
    if not le_event_enabled(var c, SUB_LE_BIGINFO_ADVERTISING_REPORT)
        c.bi_owed = false
        return true
    let slot = meta_begin(var c, SUB_LE_BIGINFO_ADVERTISING_REPORT)
    if slot == ctl_pool.NO_SLOT
        return false
    let _a = ctl_pool.pool_put_u16(var c.pool, slot, c.bi_sync)
    let _b = ctl_pool.pool_put(var c.pool, slot, c.bi.num_bis)
    let _c = ctl_pool.pool_put(var c.pool, slot, c.bi.nse)
    let _d = ctl_pool.pool_put_u16(var c.pool, slot, c.bi.iso)
    let _e = ctl_pool.pool_put(var c.pool, slot, c.bi.bn)
    let _f = ctl_pool.pool_put(var c.pool, slot, c.bi.pto)
    let _g = ctl_pool.pool_put(var c.pool, slot, c.bi.irc)
    let _h = ctl_pool.pool_put_u16(var c.pool, slot, c.bi.max_pdu)
    put_u24(var c, slot, c.bi.sdu_int)
    let _i = ctl_pool.pool_put_u16(var c.pool, slot, c.bi.max_sdu)
    let _j = ctl_pool.pool_put(var c.pool, slot, c.bi.phy)
    let _k = ctl_pool.pool_put(var c.pool, slot, (if c.bi.framed then 1 else 0))
    let _l = ctl_pool.pool_put(var c.pool, slot, (if c.bi.enc then 1 else 0))
    event_send(var c, slot)
    c.bi_owed = false
    true

// ── The Synchronized Receiver ────────────────────────────────────────
//
// [Vol 6] Part B, Sections 4.4.5.2 and 5.4.5; [Vol 4] Part E, Sections 7.7.65.29, 7.7.65.30, 7.8.106 and 7.8.107.  LE BIG Create Sync names a
// periodic advertising synchronization the Controller has and the BISes of its BIG the Host wants.  The group waits (`B_WAIT`) for a BIGInfo in
// the train; the first that comes (`ctl_big_info_seen`) fixes the numbers of the group and the offset of its first anchor point, and the receiver
// listens for the first BIS PDU (`B_SYNC`), established when it comes and failed (0x3E) when six events pass without one.  An event is run as the
// broadcaster's is: for each wanted BIS the subevents of the groups that carry the payloads of the event itself, in time order, the window of
// the first PDU of the event widened by the clocks' accuracy over the time since the last, the later ones by the jitter alone, since the first PDU
// fixes the anchor point.  A payload that was heard is kept in the ring of its stream until the event is over; the receiver stops listening to a
// BIS when all BN payloads are held.  At the end of the event the payloads are opened (an encrypted group) and put together in order (REQ-BLE-CTL-104).

// The synchronization of the train with the handle `handle` in any state but free that has a train to listen to, -1 for none.
@tier(embedded)
fn psync_of_handle(var c: Controller, handle: Int) -> Int
    for j in 0..ctl_limits.psync_n()
        if c.psyncs[j].state == ll_per.PS_SYNCED and c.psyncs[j].handle == handle
            return j
    -1

// Whether the Controller is establishing a synchronization to a BIG, or has one for the train in slot `j`.
@tier(embedded)
fn big_waiting(var c: Controller) -> Bool
    for g in 0..ctl_limits.big_slots()
        if (c.bigs[g].state == ll_big.B_WAIT or c.bigs[g].state == ll_big.B_SYNC) and not c.bigs[g].broadcaster
            return true
    false

@tier(embedded)
fn big_on_train(var c: Controller, j: Int) -> Bool
    for g in 0..ctl_limits.big_slots()
        if c.bigs[g].state != ll_big.B_FREE and not c.bigs[g].broadcaster and c.bigs[g].set == j
            return true
    false

// LE BIG Create Sync (Section 7.8.106): Command Status now, LE BIG Sync Established when the first BIS PDU has come.
@satisfies("REQ-BLE-CTL-104")
@tier(embedded)
fn cmd_le_big_create_sync(var c: Controller)
    let len = h4_rx.h4_param_len(var c.rx)
    let handle = h4_rx.h4_param(var c.rx, 0)
    let sync_handle = param_u16(var c, 1)
    let enc = h4_rx.h4_param(var c.rx, 3)
    let mse = h4_rx.h4_param(var c.rx, 20)
    let timeout = param_u16(var c, 21)
    let num = h4_rx.h4_param(var c.rx, 23)
    var status = STATUS_SUCCESS
    var mask = 0
    var top = 0
    if len != 24 + num or num < 1 or num > ll_big.NUM_BIS_MAX
        status = STATUS_INVALID_PARAMETERS
    else if handle > 0xEF or sync_handle > 0xEFF or enc > 1 or mse > ll_big.NSE_MAX or timeout < 0x0A or timeout > 0x4000
        status = STATUS_INVALID_PARAMETERS
    else
        for k in 0..num
            let n = h4_rx.h4_param(var c.rx, 24 + k)
            if n < 1 or n > ll_big.NUM_BIS_MAX or n <= top
                status = STATUS_INVALID_PARAMETERS
            else
                mask = mask | (1 << (n - 1))
                top = n
    var j = -1
    if status == STATUS_SUCCESS
        j = psync_of_handle(var c, sync_handle)
        if big_slot(var c, handle) >= 0 or big_waiting(var c) or j >= 0 and big_on_train(var c, j)
            status = STATUS_COMMAND_DISALLOWED
        else if j < 0
            status = ll_xadv.E_UNKNOWN_SET
    var g = -1
    var i0 = -1
    if status == STATUS_SUCCESS
        g = big_free_slot(var c)
        i0 = bis_free_run(var c, num)
        if g < 0 or i0 < 0
            status = 0x0D
    if status == STATUS_SUCCESS
        ll_big.big_clear(var c.bigs[g])
        c.bigs[g].state = ll_big.B_WAIT
        c.bigs[g].broadcaster = false
        c.bigs[g].handle = handle
        c.bigs[g].set = j
        c.bigs[g].bis0 = i0
        c.bigs[g].nrx = num
        c.bigs[g].bis_mask = mask
        c.bigs[g].mse = mse
        c.bigs[g].host_enc = enc == 1
        c.bigs[g].sup_us = timeout * 10000
        c.bigs[g].first_us = c.now
        if enc == 1
            for k in 0..16
                ll_big.code_put(var c.bigs[g], k, h4_rx.h4_param(var c.rx, 4 + k))
        for k in 0..num
            // The slots are the group's from now on, so that their handles are known (the streams are made when the BIGInfo comes).
            c.bis[i0 + k].state = ll_iso.S_CONFIG
    answer_command_status(var c, OP_LE_BIG_CREATE_SYNC, status)

// LE BIG Terminate Sync (Section 7.8.107): Command Complete with the BIG_Handle.  A synchronization that is being made ends with LE BIG Sync
// Established of status 0x44; one that is up is gone with its streams and data paths, and no event follows.
@satisfies("REQ-BLE-CTL-104")
@tier(embedded)
fn cmd_le_big_terminate_sync(var c: Controller)
    let handle = h4_rx.h4_param(var c.rx, 0)
    let g = big_slot(var c, handle)
    var status = STATUS_SUCCESS
    if g < 0
        status = ll_xadv.E_UNKNOWN_SET
    else if c.bigs[g].broadcaster or c.bigs[g].state == ll_big.B_STOP
        status = STATUS_COMMAND_DISALLOWED
    if status == STATUS_SUCCESS
        if c.bigs[g].state == ll_big.B_UP
            big_release(var c, g)
        else
            c.bigs[g].state = ll_big.B_STOP
            c.bigs[g].status = ll_big.E_CANCELLED
            c.bigs[g].owed = ll_big.EV_COMPLETE
    let slot = complete_begin(var c, OP_LE_BIG_TERMINATE_SYNC, status)
    if slot == ctl_pool.NO_SLOT
        return
    let _a = ctl_pool.pool_put(var c.pool, slot, handle)
    complete_send(var c, slot)

// The group in slot `g` (waiting) takes the BIG the BIGInfo `c.bi` of the train in slot `j` describes: the numbers of the group, the key
// material, the streams of the BISes the Host wanted, and the first anchor point from the PDU that began at `t_first`.  A BIG this Controller
// cannot follow ends the attempt with LE BIG Sync Established of the status (Encryption Mode Not Acceptable 0x25, Unsupported Feature or
// Parameter Value 0x11, Invalid HCI Command Parameters 0x12).
@satisfies("REQ-BLE-CTL-104")
@tier(embedded)
fn big_sync_take(var c: Controller, g: Int, j: Int, t_first: Int)
    if not ll_big.info_valid(c.bi)
        return
    var status = STATUS_SUCCESS
    if c.bi.enc != c.bigs[g].host_enc
        status = ll_big.E_ENCRYPTION_MODE
    else if c.bi.phy == ll_phy.PHY_CODED and not c.coded
        status = STATUS_UNSUPPORTED_FEATURE
    else if (c.bigs[g].bis_mask >>> c.bi.num_bis) != 0
        status = STATUS_UNSUPPORTED_FEATURE
    else if c.bigs[g].mse > 0 and c.bigs[g].mse < c.bi.bn
        status = STATUS_INVALID_PARAMETERS
    if status != STATUS_SUCCESS
        c.bigs[g].status = status
        c.bigs[g].state = ll_big.B_STOP
        c.bigs[g].owed = ll_big.EV_COMPLETE
        return
    ll_big.sync_fill(var c.bigs[g], c.bi, c.psyncs[j].sca_ppm)
    if c.bi.enc
        ll_big.key_from_info(var c.bigs[g], var c.bi_raw)
    ll_big.sync_anchor(var c.bigs[g], t_first, c.bi.off_us, c.bi.unit, c.bi.count, c.now, ll_radio.lead_us(c.radio))
    c.bigs[g].key_ok = not c.bi.enc
    c.bigs[g].sup_us = ll_phy_greater(c.bigs[g].sup_us, ll_big.SYNC_EVENTS * ll_big.iso_us(var c.bigs[g]))
    c.bigs[g].silent = 0
    for q in 0..c.bigs[g].nrx
        let i = c.bigs[g].bis0 + q
        ll_big.bis_config(var c.bis[i], var c.bigs[g], ll_big.bis_number(var c.bigs[g], q), i)
        ll_big.rx_start(var c.bis[i], var c.bigs[g])
    c.bigs[g].state = ll_big.B_SYNC

// LE BIG Sync Established (Section 7.7.65.29).  A synchronization that failed is gone afterwards.
@satisfies("REQ-BLE-CTL-104")
@tier(embedded)
fn ev_big_sync_established(var c: Controller, g: Int) -> Bool
    let ok = c.bigs[g].status == STATUS_SUCCESS
    if not le_event_enabled(var c, SUB_LE_BIG_SYNC_ESTABLISHED)
        c.bigs[g].owed = c.bigs[g].owed & (0xFF ^ ll_big.EV_COMPLETE)
        if not ok
            big_release(var c, g)
        return true
    let slot = meta_begin(var c, SUB_LE_BIG_SYNC_ESTABLISHED)
    if slot == ctl_pool.NO_SLOT
        return false
    let _a = ctl_pool.pool_put(var c.pool, slot, c.bigs[g].status)
    let _b = ctl_pool.pool_put(var c.pool, slot, c.bigs[g].handle)
    if ok
        var lat = c.bigs[g].latency
        if lat < 0
            lat = 0
        put_u24(var c, slot, lat)
        let _c = ctl_pool.pool_put(var c.pool, slot, c.bigs[g].nse)
        let _d = ctl_pool.pool_put(var c.pool, slot, c.bigs[g].bn)
        let _e = ctl_pool.pool_put(var c.pool, slot, c.bigs[g].pto)
        let _f = ctl_pool.pool_put(var c.pool, slot, c.bigs[g].irc)
        let _h = ctl_pool.pool_put_u16(var c.pool, slot, c.bigs[g].max_pdu)
        let _i = ctl_pool.pool_put_u16(var c.pool, slot, c.bigs[g].iso_int)
        let _j = ctl_pool.pool_put(var c.pool, slot, c.bigs[g].nrx)
        for q in 0..c.bigs[g].nrx
            let _k = ctl_pool.pool_put_u16(var c.pool, slot, c.bis[c.bigs[g].bis0 + q].handle)
    else
        put_zeros(var c, slot, 12)
    event_send(var c, slot)
    c.bigs[g].owed = c.bigs[g].owed & (0xFF ^ ll_big.EV_COMPLETE)
    if not ok
        big_release(var c, g)
    true

// LE BIG Sync Lost (Section 7.7.65.30): the group, its streams and their data paths are gone afterwards.
@satisfies("REQ-BLE-CTL-104")
@tier(embedded)
fn ev_big_sync_lost(var c: Controller, g: Int) -> Bool
    if not le_event_enabled(var c, SUB_LE_BIG_SYNC_LOST)
        big_release(var c, g)
        return true
    let slot = meta_begin(var c, SUB_LE_BIG_SYNC_LOST)
    if slot == ctl_pool.NO_SLOT
        return false
    let _a = ctl_pool.pool_put(var c.pool, slot, c.bigs[g].handle)
    let _b = ctl_pool.pool_put(var c.pool, slot, c.bigs[g].reason)
    event_send(var c, slot)
    big_release(var c, g)
    true

// ── The receiver's events, for the radio program ─────────────────────

// The time the program is wanted for the next event of the receiver in slot `g`: the anchor point less the widening of its window (and,
// until the first PDU has come, the unit of the offset beyond it).
@tier(embedded)
fn ctl_big_rx_start(var c: Controller, g: Int) -> Int
    c.bigs[g].anchor - ll_big.rx_widen(var c.bigs[g], c.bigs[g].anchor)

// The radio time the booking of the receiver's next event covers from its start.
@tier(embedded)
fn ctl_big_rx_book_us(var c: Controller, g: Int) -> Int
    ll_big.event_len_us(var c.bigs[g]) + 2 * ll_big.rx_widen(var c.bigs[g], c.bigs[g].anchor) + c.bigs[g].win + BIG_BOOK_MARGIN_US

// The receiver's event of the group in slot `g` begins at `now`: a BIG that has reached the instant of its termination is gone (-1); a new
// channel map takes effect at its instant; the streams' rings are cleared of the last event's payloads; the answer is 0 for an event the
// program is too late for or has no key for, otherwise the subevents of the program (the radio listens to the ones it wants).
@satisfies("REQ-BLE-CTL-104")
@tier(embedded)
fn ctl_big_begin_rx(var c: Controller, g: Int, now: Int) -> Int
    if c.bigs[g].term_req and ll_big.instant_reached(c.bigs[g].ev, c.bigs[g].term_instant)
        c.bigs[g].state = ll_big.B_STOP
        c.bigs[g].reason = ll_big.REASON_REMOTE_TERMINATED
        c.bigs[g].owed = ll_big.EV_TERMINATED
        return -1
    if c.bigs[g].cm_req and ll_big.instant_reached(c.bigs[g].ev, c.bigs[g].cm_instant)
        ll_big.chmap_apply(var c.bigs[g])
    for q in 0..c.bigs[g].nrx
        let i = c.bigs[g].bis0 + q
        c.bis[i].anchor = c.bigs[g].anchor
        c.bis[i].ev = c.bigs[g].ev
        ll_big.rx_begin(var c.bis[i], c.bigs[g].ev)
    c.bigs[g].ev_open = true
    c.bigs[g].ev_synced = false
    c.bigs[g].cstf = false
    if not c.bigs[g].key_ok
        return 0
    if now > c.bigs[g].anchor + ll_big.rx_widen(var c.bigs[g], c.bigs[g].anchor) + c.bigs[g].win + ll_big.event_len_us(var c.bigs[g])
        return 0
    ll_big.program_len(var c.bigs[g])

// Whether the receiver listens to subevent `sub` of BIS `bis` now: it wants the BIS, the subevent is among those that carry the event's own
// payloads, and the BIS has not all its BN payloads yet.
@tier(embedded)
fn ctl_big_rx_listens(var c: Controller, g: Int, bis: Int, sub: Int) -> Bool
    if not ll_big.rx_listens(var c.bigs[g], bis, sub)
        return false
    var q = 0
    for k in 1..bis
        if ll_big.wants(var c.bigs[g], k)
            q = q + 1
    let i = c.bigs[g].bis0 + q
    let bn = c.bigs[g].bn
    for m in 0..bn
        if not ll_big.rx_have(var c.bis[i], c.bigs[g].ev * bn + m)
            return true
    false

// The time subevent `sub` of BIS `bis` is due, and the widening of its window: the first PDU of the event has the widening of the time since
// the last event's (and the offset's unit while the first event is awaited), the others the jitter of the radio alone.
@tier(embedded)
fn ctl_big_rx_time(var c: Controller, g: Int, bis: Int, sub: Int) -> Int
    c.bigs[g].anchor + ll_big.sub_offset(var c.bigs[g], bis, sub)

@tier(embedded)
fn ctl_big_rx_widen(var c: Controller, g: Int, bis: Int, sub: Int) -> Int
    if c.bigs[g].ev_synced
        return ll_link.JITTER_US
    ll_big.rx_widen(var c.bigs[g], c.bigs[g].anchor + ll_big.sub_offset(var c.bigs[g], bis, sub))

@tier(embedded)
fn ctl_big_rx_win(var c: Controller, g: Int) -> Int
    if c.bigs[g].ev_synced
        return 0
    c.bigs[g].win

// The payload number subevent `sub` of the event under way carries.
@tier(embedded)
fn ctl_big_rx_num(var c: Controller, g: Int, sub: Int) -> Int
    ll_big.payload_of(var c.bigs[g], c.bigs[g].ev, sub)

// A PDU of BIS `bis`, subevent `sub`, began at `first_bit` and its header octet is `hdr`: the first of the event fixes the anchor point, the
// Control Subevent Transmission Flag says the event has a control subevent, and the first of the group completes the synchronization.
@satisfies("REQ-BLE-CTL-104")
@tier(embedded)
fn ctl_big_rx_heard(var c: Controller, g: Int, bis: Int, sub: Int, first_bit: Int, hdr: Int)
    if not c.bigs[g].ev_synced
        c.bigs[g].anchor = first_bit - ll_big.sub_offset(var c.bigs[g], bis, sub)
        c.bigs[g].ev_synced = true
        c.bigs[g].last_rx = first_bit
        c.bigs[g].win = 0
    if (hdr & 0x20) != 0
        c.bigs[g].cstf = true
    c.bigs[g].silent = 0
    if c.bigs[g].state == ll_big.B_SYNC
        c.bigs[g].state = ll_big.B_UP
        c.bigs[g].status = STATUS_SUCCESS
        c.bigs[g].owed = c.bigs[g].owed | ll_big.EV_COMPLETE

// The payload number `num` of BIS `bis` was read into `rx`: it is kept in the ring of its stream when it is a new one.
@tier(embedded)
fn ctl_big_rx_keep(var c: Controller, g: Int, bis: Int, num: Int, var rx: Pdu)
    var q = 0
    for k in 1..bis
        if ll_big.wants(var c.bigs[g], k)
            q = q + 1
    let _k = ll_big.rx_keep(var c.bis[c.bigs[g].bis0 + q], num, var rx)

// Whether a PDU of BIS `bis` with the length octet `len` and the header `hdr` can be a BIS Data PDU of the group: a payload not longer than
// Max_PDU (and its MIC), not a BIG Control PDU.
@tier(embedded)
fn ctl_big_rx_fits(var c: Controller, g: Int, hdr: Int, len: Int) -> Bool
    var mic = 0
    if c.bigs[g].enc and len > 0
        mic = ll_phy.MIC_OCTETS
    (hdr & 3) != ll_big.LLID_CONTROL and len <= c.bigs[g].max_pdu + mic and (len == 0 or len > mic or not c.bigs[g].enc)

// A packet of BIS `bis` had a CRC error or does not fit the group: it is counted for LE Read ISO Link Quality.
@tier(embedded)
fn ctl_big_rx_bad(var c: Controller, g: Int, bis: Int)
    var q = 0
    for k in 1..bis
        if ll_big.wants(var c.bigs[g], k)
            q = q + 1
    let i = c.bigs[g].bis0 + q
    c.bis[i].n_crc = c.bis[i].n_crc + 1

// The control subevent: whether the event has one to listen to, the time it is due and its channel.
@tier(embedded)
fn ctl_big_rx_ctrl(var c: Controller, g: Int) -> Bool
    c.bigs[g].cstf and c.bigs[g].ev_synced

// The BIG Control PDU read into `p` is opened (an encrypted group: with the control link's key and the counter of the event's first
// subevent) and taken.  False when the MIC did not match.
@satisfies("REQ-BLE-CTL-103")
@tier(embedded)
fn ctl_big_rx_ctrl_pdu<C: Cipher[e]>(var c: Controller, g: Int, var cc: C, var p: Pdu) -> Bool [e]
    if (p.b[0] as Int & 3) != ll_big.LLID_CONTROL
        return true
    if c.bigs[g].enc and (p.b[1] as Int) > 0
        var ek = ll_cipher.enc_key_new()
        big_key(var c, g, 0, var ek)
        if not cc.open(var ek, c.bigs[g].ev * c.bigs[g].bn, ll_cipher.DIR_CENTRAL | ll_cipher.DIR_BIS, var p)
            return false
    ll_big.ctrl_rx(var c.bigs[g], var p)
    true

// The event of the receiver in slot `g` is over: the payloads of its streams that arrived are opened (an encrypted group; a MIC that does
// not match ends the synchronization with MIC Failure) and put together in order, the ones that did not are lost SDUs.  `p` and `scratch` are
// buffers for the program.  False when the synchronization ended.
@satisfies("REQ-BLE-CTL-104")
@satisfies("REQ-BLE-CTL-108")
@tier(embedded)
fn ctl_big_rx_finish<C: Cipher[e]>(var c: Controller, g: Int, var cc: C, var p: Pdu,
                                   var scratch: Pdu) -> Bool [e]
    let bn = c.bigs[g].bn
    let ev = c.bigs[g].ev
    for q in 0..c.bigs[g].nrx
        let i = c.bigs[g].bis0 + q
        let bis = ll_big.bis_number(var c.bigs[g], q)
        for m in 0..bn
            let num = ev * bn + m
            if ll_big.rx_have(var c.bis[i], num)
                ll_big.rx_load(var c.bis[i], num, var p)
                if c.bigs[g].enc and (p.b[1] as Int) > 0
                    var ek = ll_cipher.enc_key_new()
                    big_key(var c, g, bis, var ek)
                    if not cc.open(var ek, num, ll_cipher.DIR_CENTRAL | ll_cipher.DIR_BIS, var p)
                        c.bigs[g].state = ll_big.B_STOP
                        c.bigs[g].reason = ll_big.REASON_MIC_FAILURE
                        c.bigs[g].owed = ll_big.EV_TERMINATED
                        return false
                ll_iso.rx_note(var c.bis[i], num, true, var p)
                c.bis[i].n_rx = c.bis[i].n_rx + 1
                ll_big.rx_clear(var c.bis[i], num)
            else
                ll_iso.rx_note(var c.bis[i], num, false, var scratch)
                c.bis[i].n_flush_rx = c.bis[i].n_flush_rx + 1
    true

// The synchronization of the group in slot `g` ended with `reason`: the Host is told with LE BIG Sync Lost.
@tier(embedded)
fn ctl_big_lost(var c: Controller, g: Int, reason: Int)
    c.bigs[g].state = ll_big.B_STOP
    c.bigs[g].reason = reason
    c.bigs[g].owed = ll_big.EV_TERMINATED

// The receiver's event is over (or skipped, `ran` false): the supervision runs, a synchronization that was awaited and did not come in six
// events fails (0x3E), and the next event follows ISO_Interval after this one's anchor point.
@satisfies("REQ-BLE-CTL-104")
@tier(embedded)
fn ctl_big_end_rx(var c: Controller, g: Int, now: Int, ran: Bool)
    if ran
        c.bigs[g].n_events = c.bigs[g].n_events + 1
    if not c.bigs[g].ev_synced
        c.bigs[g].n_missed = c.bigs[g].n_missed + 1
        c.bigs[g].silent = c.bigs[g].silent + 1
    c.bigs[g].ev = c.bigs[g].ev + 1
    c.bigs[g].anchor = c.bigs[g].anchor + ll_big.iso_us(var c.bigs[g])
    c.bigs[g].ev_open = false
    if c.bigs[g].state == ll_big.B_SYNC and c.bigs[g].silent >= ll_big.SYNC_EVENTS
        c.bigs[g].state = ll_big.B_STOP
        c.bigs[g].status = ll_big.E_SYNC_TIMEOUT
        c.bigs[g].owed = ll_big.EV_COMPLETE
    else if c.bigs[g].state == ll_big.B_UP and now - c.bigs[g].last_rx > c.bigs[g].sup_us
        c.bigs[g].state = ll_big.B_STOP
        c.bigs[g].reason = ll_big.REASON_TIMEOUT
        c.bigs[g].owed = ll_big.EV_TERMINATED

// ── ISO Data from the Host for a broadcast stream ────────────────────

// An HCI ISO Data packet from the Host is complete and its handle is a broadcast stream's: the SDU goes to the ring as `iso_to_cis`
// does for a connected stream, unframed.  Anything else is dropped and counted.
@satisfies("REQ-BLE-CTL-050")
@satisfies("REQ-BLE-CTL-107")
@tier(embedded)
fn iso_to_bis(var c: Controller, i: Int)
    var ok = false
    var used = false
    if c.bis[i].dp_in and c.bis[i].central and c.bis[i].state == ll_iso.S_UP
        let pb = h4_rx.h4_acl_pb(var c.rx)
        var off = h4_rx.ACL_LEAD
        var left = h4_rx.h4_acl_len(var c.rx)
        var stamp = -1
        if pb == 1 or pb == 3
            if not h4_rx.h4_iso_ts(var c.rx)
                used = true
                ok = ll_iso.sdu_frag(var c.bis[i], var c.rx.acl, off, left, pb, 0)
        else
            if h4_rx.h4_iso_ts(var c.rx) and left >= 4
                stamp = c.rx.acl[off] as Int | (c.rx.acl[off + 1] as Int << 8) | (c.rx.acl[off + 2] as Int << 16) | (c.rx.acl[off + 3] as Int << 24)
                off = off + 4
                left = left - 4
            if left >= 4
                let len = c.rx.acl[off + 2] as Int | (c.rx.acl[off + 3] as Int << 8)
                let sdu_len = len & 0x0FFF
                if pb == 2 and sdu_len == left - 4 or pb == 0
                    used = true
                    // The reference time of a framed SDU is the first packet's, as for a CIS: its Time_Stamp or the time it arrived.
                    if c.bis[i].framed
                        c.bis[i].h_ref = iso_ref(var c.bis[i],
                            c.now,
                            stamp,
                            c.rx.acl[off] as Int | (c.rx.acl[off + 1] as Int << 8))
                    ok = ll_iso.sdu_frag(var c.bis[i], var c.rx.acl, off + 4, left - 4, pb, sdu_len)
    if not ok
        c.iso_dropped = c.iso_dropped + 1
        c.bis[i].n_host_drop = c.bis[i].n_host_drop + 1
        if c.bis[i].dp_in and c.bis[i].state == ll_iso.S_UP
            if not used
                ll_iso.sdu_abandon(var c.bis[i])
                ll_iso.sdu_credit(var c.bis[i], 1)
        else
            c.bis[i].h_open = false

// ── The radio program's view of the groups ───────────────────────────

// Whether the group in slot `g` sends or listens for events.
@tier(embedded)
fn big_runs(var c: Controller, g: Int) -> Bool
    let st = c.bigs[g].state
    st == ll_big.B_CREATE or st == ll_big.B_UP or st == ll_big.B_TERM or st == ll_big.B_SYNC

// The group whose next event starts first, -1 for none.
@tier(embedded)
fn ctl_big_next(var c: Controller) -> Int
    if not ctl_limits.big_on()
        return -1
    var best = -1
    var at = 0
    for g in 0..ctl_limits.big_slots()
        if big_runs(var c, g)
            let s = ctl_big_start(var c, g)
            if best < 0 or s < at
                best = g
                at = s
    best

// The time the program is wanted for the next event of the group in slot `g`: the anchor point of a broadcaster.
@tier(embedded)
fn ctl_big_start(var c: Controller, g: Int) -> Int
    if not c.bigs[g].broadcaster
        return ctl_big_rx_start(var c, g)
    c.bigs[g].anchor

// The radio time the booking of the group's next event covers from its start.
@tier(embedded)
fn ctl_big_book_us(var c: Controller, g: Int) -> Int
    if not c.bigs[g].broadcaster
        return ctl_big_rx_book_us(var c, g)
    ll_big.event_len_us(var c.bigs[g]) + BIG_BOOK_MARGIN_US

// Whether the group in slot `g` is the Isochronous Broadcaster's (its event is sent) or the Synchronized Receiver's (its event is listened to).
@tier(embedded)
fn ctl_big_tx(var c: Controller, g: Int) -> Bool
    c.bigs[g].broadcaster

// The group whose event the radio is to run now: the one that starts first, when it starts before the next subevent of a connected
// stream does and is due (within the lead of the isochronous class); -1 otherwise.
@tier(embedded)
fn ctl_big_pick(var c: Controller) -> Int
    let g = ctl_big_next(var c)
    if g < 0
        return -1
    let i = ctl_cis_next(var c)
    if i >= 0 and ctl_cis_listen_start(var c, i) < ctl_big_start(var c, g)
        return -1
    if ctl_big_start(var c, g) - ll_arb.lead_of(var c.arb, ll_arb.CLASS_ISO) > c.now
        return -1
    g

// The BIG event of the group in slot `g` begins at `now`: its streams make the payloads of the event (padding for what the Host did
// not supply) and the answer is the subevents of its program.  A group that has run to the instant of its termination ends instead (-1),
// and an event that is over before the program came to it, or waits for a key, is skipped whole (0).
@satisfies("REQ-BLE-CTL-100")
@tier(embedded)
fn ctl_big_begin(var c: Controller, g: Int, now: Int) -> Int
    if c.bigs[g].state == ll_big.B_TERM and c.bigs[g].ev >= c.bigs[g].term_instant
        c.bigs[g].state = ll_big.B_STOP
        c.bigs[g].reason = ll_big.REASON_LOCAL_HOST
        c.bigs[g].owed = ll_big.EV_TERMINATED
        return -1
    if c.bigs[g].cm_req and c.bigs[g].ev >= c.bigs[g].cm_instant
        ll_big.chmap_apply(var c.bigs[g])
    // The Host's channel classification (LE Set Host Channel Classification) is a new channel map for the group.
    let want = connect_chmap(var c)
    if ll_big.chmap_due(var c.bigs[g], want)
        ll_big.chmap_begin(var c.bigs[g], want, c.bigs[g].ev)
    let pre = ll_big.pre_events(var c.bigs[g])
    for j in 0..c.bigs[g].num_bis
        let i = c.bigs[g].bis0 + j
        c.bis[i].anchor = c.bigs[g].anchor
        c.bis[i].ev = c.bigs[g].ev
        ll_iso.tx_fill(var c.bis[i], c.bigs[g].ev + pre)
    c.bigs[g].ev_open = true
    c.bigs[g].pos = 0
    if not c.bigs[g].key_ok
        return 0
    if now > c.bigs[g].anchor + ll_big.event_len_us(var c.bigs[g])
        return 0
    ll_big.program_len(var c.bigs[g])

// The BIS and the subevent (`bis * 64 + sub`, both from 1) of position `p` of the program, the time its first bit is due, and the
// radio's settings for it.
@tier(embedded)
fn ctl_big_at(var c: Controller, g: Int, p: Int) -> Int
    ll_big.program_at(var c.bigs[g], p)

@tier(embedded)
fn ctl_big_time(var c: Controller, g: Int, bis: Int, sub: Int) -> Int
    c.bigs[g].anchor + ll_big.sub_offset(var c.bigs[g], bis, sub)

@tier(embedded)
fn ctl_big_ctl_time(var c: Controller, g: Int) -> Int
    c.bigs[g].anchor + ll_big.control_offset(var c.bigs[g])

@tier(embedded)
fn ctl_big_aa(var c: Controller, g: Int, bis: Int) -> Int
    ll_big.bis_aa(c.bigs[g].saa, bis)

@tier(embedded)
fn ctl_big_crc(var c: Controller, g: Int, bis: Int) -> Int
    ll_big.bis_crc(c.bigs[g].crc, bis)

@tier(embedded)
fn ctl_big_phy(var c: Controller, g: Int) -> Int
    c.bigs[g].phy

// The channel of subevent `sub` of BIS `bis` in the event under way (Section 4.4.6.8); BIS 0 is the BIG Control logical link.
@satisfies("REQ-BLE-CTL-100")
@tier(embedded)
fn ctl_big_chan(var c: Controller, g: Int, bis: Int, sub: Int) -> Int
    ll_iso.sub_channel(ll_big.bis_aa(c.bigs[g].saa, bis),
        c.bigs[g].ev & 0xFFFF,
        sub,
        c.bigs[g].chmap,
        c.bigs[g].n_used)

// Whether the event under way carries a BIG Control PDU.
@tier(embedded)
fn ctl_big_ctrl(var c: Controller, g: Int) -> Bool
    ll_big.ctrl_active(var c.bigs[g], c.bigs[g].ev)

// The key of BIS `bis` (0 for the control logical link): the Group Session Key with the GIV, its 32 low bits exclusive-or the access
// address (Part E, Section 2.1).
@satisfies("REQ-BLE-CTL-108")
@tier(embedded)
fn big_key(var c: Controller, g: Int, bis: Int, var ek: EncKey)
    let aa = ll_big.bis_aa(c.bigs[g].saa, bis)
    for k in 0..16
        ek.sk[k] = c.bigs[g].ek.sk[k]
    for k in 0..8
        ek.iv[k] = c.bigs[g].ek.iv[k]
    for k in 0..4
        ek.iv[k] = ek.iv[k] ^ ((aa >>> (8 * k)) & 0xFF) as u8

// The PDU of subevent `sub` of BIS `bis` in the event under way, into `p`, sealed when the group is encrypted: the payload the program
// gives the subevent (`ll_big.payload_of`) or an empty PDU, with the Control Subevent fields of the event.  The counter of the nonce
// is the payload number, and the directionBit is 1 for the Isochronous Broadcaster.
@satisfies("REQ-BLE-CTL-102")
@satisfies("REQ-BLE-CTL-108")
@tier(embedded)
fn ctl_big_pdu<C: Cipher[e]>(var c: Controller, g: Int, bis: Int, sub: Int, var cc: C,
                             var p: Pdu) [e]
    let n = ll_big.payload_of(var c.bigs[g], c.bigs[g].ev, sub)
    let i = c.bigs[g].bis0 + bis - 1
    ll_big.tx_build(var c.bis[i], n, var p, c.bigs[g].cssn, ll_big.ctrl_active(var c.bigs[g], c.bigs[g].ev))
    c.bis[i].n_tx = c.bis[i].n_tx + 1
    if c.bigs[g].enc and (p.b[1] as Int) > 0
        var ek = ll_cipher.enc_key_new()
        big_key(var c, g, bis, var ek)
        cc.seal(var ek, n, ll_cipher.DIR_CENTRAL | ll_cipher.DIR_BIS, var p)

// The BIG Control PDU of the event under way, into `p`, sealed when the group is encrypted with the counter of the first subevent of
// the event (Part E, Section 2.1).
@satisfies("REQ-BLE-CTL-103")
@tier(embedded)
fn ctl_big_ctrl_pdu<C: Cipher[e]>(var c: Controller, g: Int, var cc: C, var p: Pdu) [e]
    if c.bigs[g].term_req and c.bigs[g].ev >= c.bigs[g].ctl_first
        ll_big.ctrl_terminate(var c.bigs[g], var p)
    else
        ll_big.ctrl_chmap(var c.bigs[g], var p)
    if c.bigs[g].enc
        var ek = ll_cipher.enc_key_new()
        big_key(var c, g, 0, var ek)
        cc.seal(var ek, c.bigs[g].ev * c.bigs[g].bn, ll_cipher.DIR_CENTRAL | ll_cipher.DIR_BIS, var p)

// The event of the group in slot `g` is over (or skipped, `sent` false): the payloads it was the last event of are done and the
// Host's credits for them come back, the first event completes the creation, and the next event follows ISO_Interval after this
// one's anchor point.  A group in its BIG Termination procedure ends when the instant is reached.
@satisfies("REQ-BLE-CTL-100")
@tier(embedded)
fn ctl_big_end(var c: Controller, g: Int, sent: Bool)
    let bn = c.bigs[g].bn
    for j in 0..c.bigs[g].num_bis
        ll_big.tx_done(var c.bis[c.bigs[g].bis0 + j], (c.bigs[g].ev + 1) * bn)
    if sent
        c.bigs[g].n_events = c.bigs[g].n_events + 1
        if c.bigs[g].state == ll_big.B_CREATE
            c.bigs[g].state = ll_big.B_UP
            c.bigs[g].status = STATUS_SUCCESS
            c.bigs[g].owed = c.bigs[g].owed | ll_big.EV_COMPLETE
    else
        c.bigs[g].n_late = c.bigs[g].n_late + 1
    c.bigs[g].ev = c.bigs[g].ev + 1
    c.bigs[g].anchor = c.bigs[g].anchor + ll_big.iso_us(var c.bigs[g])
    c.bigs[g].ev_open = false

// The BIGInfo for the AUX_SYNC_IND of the train in slot `k` that starts at `due`: the offset to the next anchor point of its group and the
// payload count there.  The BIGInfo is in the ACAD of the PDU the radio program builds next; a group that is not announced (none, not yet
// keyed, ended) leaves the ACAD empty.
@satisfies("REQ-BLE-CTL-100")
@tier(embedded)
fn ctl_padv_big(var c: Controller, k: Int, due: Int)
    c.pads[k].acad_n = 0
    if not ctl_limits.big_on() or c.pads[k].big < 0
        return
    let g = c.pads[k].big
    let st = c.bigs[g].state
    if st != ll_big.B_CREATE and st != ll_big.B_UP and st != ll_big.B_TERM or not c.bigs[g].key_ok
        return
    let _a = ll_big.info_for(var c.bigs[g], due, ll_big.INFO_PHASE_US)
    ll_per.acad_put(var c.pads[k], var c.bigs[g].info, c.bigs[g].info_n)
