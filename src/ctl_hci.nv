// The links the Controller holds, and the most of each role at once.  The handle
// of the link in slot `n` is `n + 1`.  The size of `links` below is `noble_controller_config.CTL_LINKS`, and
// `test_link_slots_match_the_profile` compares the capacities with the keys.

// Whether the build has the limits of the default profile: two slots, one Peripheral and one
// Central.  The tests of those limits run only then.
@tier(embedded)
fn default_caps() -> Bool
    noble_controller_config.CTL_LINKS == 2 and noble_controller_config.CTL_PERIPHERAL == 1 and noble_controller_config.CTL_CENTRAL == 1

// ── What the build holds ────────────────────────────────────────────

// The version of the Core Specification the HCI layer follows, as the
// Assigned Numbers give it (0x11 is Core 6.3).  The Link Layer version
// field carries the same number: this Controller has no Link Layer, and
// the supported commands and features say what it can do.
const SPEC_VERSION = 0x11

// The company identifier 0xFFFF is the one the Assigned Numbers reserve for
// tests and interoperability work.
const MANUFACTURER = 0xFFFF

// The HCI and Link Layer sub-version numbers.
const SUBVERSION = 0x0001

// The number of HCI ACL Data packets the Controller reports it can hold,
// of `h4_rx.LL_ACL_OCTETS` octets each.
const ACL_BUFFERS = 3

// The Filter Accept List holds this many devices.
const FILTER_ACCEPT_LIST_SIZE = 8

// The Hardware_Code of the Hardware Error event sent when the stream from
// the Host is lost ([Vol 4] Part A, Section 4).
const HW_ERROR_STREAM_LOST = 0x01

// What the hardware under the Controller can do, `caps` of `controller_new`.
// A command that needs one that is absent is not answered.
pub const CAP_ECB = 1
// The hardware has a random number generator.
pub const CAP_RNG = 2
// The Controller has a Link Layer, which the commands that start or read an activity need.
pub const CAP_LL = 4
// The hardware has a P-256 ECDH engine.
pub const CAP_ECDH = 8

// The transmit power the radio is set to for advertising channel PDUs, in
// dBm, and the range the part supports (LE Read Transmit Power).
const TX_POWER_DBM = 0
const TX_POWER_MIN_DBM = -46
const TX_POWER_MAX_DBM = 8

// The LE_States the Link Layer supports ([Vol 4] Part E, Section 7.8.27):
// the advertising states in bits 0 (non-connectable), 1 (scannable), 2
// (connectable), 3 (high duty cycle directed) and 29 (low duty cycle directed),
// passive and active scanning in bits 4 and 5, the Initiating state in bit 6, the
// Peripheral connection state in bit 7, each advertising state together with each
// scanning state (bits 8 to 15, 30 and 31), the non-connectable and scannable
// advertising states and each scanning state together with the Peripheral
// connection (bits 20, 21, 26 and 27), every advertising state together with the
// Initiating state (bits 16, 17, 32, 33 and 34) and with the Central connection
// (bits 18, 19, 35, 36 and 37), each scanning state together with the Central
// connection (bits 24 and 25), and the Initiating state together with the
// Peripheral connection (bit 41).  Scanning together with the Initiating state
// (bits 22 and 23), a second Central link (bit 28) and a second Peripheral link
// (bits 38 to 40) are not claimed.
const LE_STATES = 0x23FEF3FFFFF

// Bit 23 of the second page of the event mask enables the Authenticated Payload
// Timeout Expired event ([Vol 4] Part E, Section 7.3.69).
const MASK2_APTO_EXPIRED = 23

// The time a Link Layer booking for a connection event covers beyond its
// window, in microseconds: the packets of a few exchanges.
const CONN_EVENT_BOOK_US = 3000

// The time an advertising PDU and the exchange after it can take, in
// microseconds; an advertising event does not start a PDU when a connection
// event needs the radio sooner.
const ADV_PDU_BUDGET_US = 1500

// The time a Link Layer booking for an advertising event covers, in
// microseconds: three PDUs of the longest exchange.
const ADV_EVENT_BOOK_US = 6000

// The Controller's own work in flight for a command that needs the
// hardware, `pending`.
const PEND_NONE = 0
// The work in flight is LE Encrypt, which waits for the cipher.
pub const PEND_ENCRYPT = 1
// The work in flight is LE Rand, which waits for the random number generator.
pub const PEND_RAND = 2

// The event mask a Reset restores: bits 0 to 44 set ([Vol 4] Part E,
// Section 6.1).
const MASK_DEFAULT_LOW = 0xFFFFFFFF
const MASK_DEFAULT_HIGH = 0x00001FFF

// The LE event mask a Reset restores: bits 0 to 4, the LE Connection
// Complete, LE Advertising Report, LE Connection Update Complete, LE Read
// Remote Features Complete and LE Long Term Key Request subevents.
const LE_MASK_DEFAULT = 0x1F

// `rx` reads the Host's octets and `pool` holds the packets to send.
// `mask_low` and `mask_high` are the 64-bit Set Event Mask value in two
// halves, `mask2` the Set Event Mask Page 2 value, `le_low` and `le_high` the LE
// Set Event Mask value.  `public` is
// the device's public address and `random` the address LE Set Random
// Address gave, `random_set` saying it was given; both are in HCI order,
// least significant octet first.  The Filter Accept List is `fal_used`,
// `fal_type` and `fal_addr` (six octets an entry).  `pending` is the
// command waiting for the hardware and `pend_slot` the pool slot its answer
// will be written to.  `block` and `key` are the operands of LE Encrypt in
// HCI order, and `result` is what the hardware produced.  `hw_owed` is true
// while a Hardware Error event could not be queued for want of a free slot.
// The last five fields count what happened, for a caller that reports it.
//
// `adv`, `scan`, `init` and `arb` are the legacy Link Layer: the Advertising
// state, the Scanning state, the Initiating state and the radio arbiter.  `link`
// `links` are the connections, one per slot.  `chmap` is the channel map the
// Host classified (LE Set Host Channel Classification), the one a new connection
// as Central asks for, and `init_event` the status of the LE Connection Complete
// event the Initiating state owes the Host when it ended without a connection (0
// for none).  `now` is the time in
// microseconds the program last gave with `ctl_set_time`; a command that
// starts a state reads it.  `dl_sugg_octets` and `dl_sugg_time` are the Host's suggested
// data length for new connections (LE Write Suggested Default Data Length, 27 and 328
// until written, `dl_sugg_set` saying it was), and `phy_def_tx` and `phy_def_rx` the
// PHYs it prefers for new connections as masks (LE Set Default PHY, `phy_def_set` false
// while it has no preference).
//
// The advertising sets the Host defined (`xsets`, `ll_xadv.XSet`), the set the legacy advertiser runs as a set of legacy
// PDUs (`adv_set`, -1 for none) with the number of its events when it started (`adv_base`), and the set whose event the
// radio program is running (`adv_xset`, -1 between events).
//
// The extended scan keeps the report values of the advertisement it is following (`xs`, `ll_ext.XCtx`), the
// legacy view of its PDU the judgement reads (`xv`, `xview` saying it holds an advertiser's address) and the addresses
// the ADV_EXT_IND named (`xp`).
//
// The isochronous channels (`ll_iso.nv`): `cis` are the streams, `cigs` the groups of the Central, both sized
// from the keys `ctl_cis` and `ctl_cigs`.  `host_iso` is the Connected Isochronous Stream (Host Support) feature
// bit the Host set and `iso_dropped` the ISO Data packets the Host sent that found no room or path.  The CIS
// procedures build their PDUs in the `tmp` of the link they go out on.
pub @value
struct Controller
    rx: H4Rx
    pool: PacketPool
    caps: u8
    mask_low: Int
    mask_high: Int
    mask2: Int
    le_low: Int
    le_high: Int
    public: Vec[u8; 6]
    random: Vec[u8; 6]
    random_set: Bool
    fal_used: Vec[Bool; 8]
    fal_type: Vec[u8; 8]
    fal_addr: Vec[u8; 48]
    pending: u8
    pend_slot: Int
    block: Vec[u8; 16]
    key: Vec[u8; 16]
    result: Vec[u8; 16]
    hw_owed: Bool
    answered: Int
    unknown: Int
    resets: Int
    hw_errors: Int
    dropped_events: Int
    adv: Adv
    scan: Scan
    arb: Arb
    now: Int
    links: Vec[Link; noble_controller_config.CTL_LINKS]
    dropped_acl: Int
    init: Init
    chmap: Int
    init_event: Int
    rl: ResolvingList
    adv_ent: Int
    adv_loc: Bool
    adv_tgt: Bool
    adv_tgt_ok: Bool
    init_ent: Int
    init_loc: Bool
    init_own: Int
    adv_wait: Bool
    init_wait: Bool
    view: Pdu
    view_ent: Int
    adv_st: Int
    scan_st: Int
    ci_ent: Int
    ci_pent: Int
    ecdh_op: Int
    ecdh_have: Bool
    ecdh_secret: Vec[u8; 32]
    ecdh_peer: Vec[u8; 64]
    scan_ent: Int
    rp_pdu: Pdu
    rp_rssi: Int
    rp_valid: Bool
    rp_rsp: Bool
    rp_dropped: Int
    rq_addr: Vec[u8; 6]
    rq_kind: Int
    ci_rpa: Vec[u8; 6]
    ci_kind: Int
    dl_sugg_octets: Int
    dl_sugg_time: Int
    dl_sugg_set: Bool
    phy_def_set: Bool
    phy_def_tx: Int
    phy_def_rx: Int
    cis: Vec[Cis; max1(noble_controller_config.CTL_CIS)]
    cigs: Vec[Cig; max1(noble_controller_config.CTL_CIGS)]
    bis: Vec[Cis; max1(noble_controller_config.CTL_BIS)]
    bigs: Vec[Big; max1(noble_controller_config.CTL_BIGS)]
    bigk: Cmac
    big_rnd: Vec[u8; 24]
    big_rnd_n: Int
    big_seed: Int
    bi: InfoView
    bi_raw: Vec[u8; 64]
    bi_n: Int
    bi_sync: Int
    bi_t: Int
    bi_owed: Bool
    bi_seen: Int
    host_iso: Bool
    cis_log: ll_iso.CisLog
    iso_dropped: Int
    iso_rr: Int
    room_us: Int
    room_skips: Int
    dtm: Dtm
    radio: ll_radio.RadioProfile
    xs: ll_ext.XCtx
    xv: Pdu
    xp: ll_ext.XPri
    xview: Bool
    xsets: Vec[XSet; max1(noble_controller_config.CTL_ADV_SETS)]
    coded: Bool
    adv_set: Int
    adv_base: Int
    adv_xset: Int
    pads: Vec[PerAdv; max1(noble_controller_config.CTL_PER_ADV)]
    psyncs: Vec[PerSync; max1(noble_controller_config.CTL_PER_SYNC)]
    preq: PerReq
    pal: PerList
    per_late: Int
    past_def: PastCfg
    past_cfg: Vec[PastCfg; noble_controller_config.CTL_LINKS]
    past_tx: Vec[PastTx; noble_controller_config.CTL_LINKS]
    pcl: Vec[Pcl; if noble_controller_config.CTL_PCL then noble_controller_config.CTL_LINKS else 1]
    sub: Vec[Sub; if noble_controller_config.CTL_SUBRATE then noble_controller_config.CTL_LINKS else 1]
    sub_def: Vec[Sub; 1]
    host_sub: Bool
    pwa: Vec[PwAdv; if noble_controller_config.CTL_PAWR_ADV then max1(noble_controller_config.CTL_PER_ADV) else 1]
    pws: Vec[PwSync; if noble_controller_config.CTL_PAWR_SYNC then max1(noble_controller_config.CTL_PER_SYNC) else 1]
    cs_w: Vec[Int; if noble_controller_config.CTL_CS > 0 then noble_controller_config.CTL_CS * 38 + 40 else 1]
    cs_b: Vec[u8; if noble_controller_config.CTL_CS > 0 then noble_controller_config.CTL_CS * (224 + 56 * noble_controller_config.CTL_CS_CONFIGS) + 232 + noble_controller_config.CTL_CS_STEPS * 40 else 1]

// A Controller in its power-on state, for hardware with the capabilities
// `caps`.  The public address is zero until `ctl_set_public` gives it.
pub @tier(embedded)
fn controller_new(caps: Int) -> Controller
    var c = Controller {
        rx: h4_rx.h4_new(), pool: ctl_pool.pool_new(), caps: caps as u8,
        mask_low: 0, mask_high: 0, mask2: 0, le_low: 0, le_high: 0,
        public: Vec.new(), random: Vec.new(), random_set: false,
        fal_used: Vec.new(), fal_type: Vec.new(), fal_addr: Vec.new(),
        pending: 0, pend_slot: ctl_pool.NO_SLOT, block: Vec.new(), key: Vec.new(), result: Vec.new(),
        hw_owed: false, answered: 0, unknown: 0, resets: 0, hw_errors: 0, dropped_events: 0,
        adv: ll_adv.adv_new(), scan: ll_scan.scan_new(), arb: ll_arb.arb_new(), now: 0,
        links: Vec.new(), dropped_acl: 0,
        init: ll_init.init_new(), chmap: ll_init.CHMAP_ALL, init_event: 0,
        rl: ll_privacy.rl_new(), adv_ent: -1, adv_loc: false, adv_tgt: false, adv_tgt_ok: false, init_ent: -1, init_loc: false, init_own: 0,
        adv_wait: false, init_wait: false, view: ll_pdu.pdu_new(), view_ent: -1, adv_st: 0, scan_st: 0, ci_ent: -1, ci_pent: -1, ecdh_op: 0, ecdh_have: false, ecdh_secret: Vec.new(), ecdh_peer: Vec.new(), scan_ent: -1,
        rp_pdu: ll_pdu.pdu_new(), rp_rssi: 0, rp_valid: false, rp_rsp: false, rp_dropped: 0, rq_addr: Vec.new(),
        rq_kind: 0, ci_rpa: Vec.new(), ci_kind: 0, dl_sugg_octets: 27, dl_sugg_time: 328,
        dl_sugg_set: false, phy_def_set: false, phy_def_tx: 7, phy_def_rx: 7,
        cis: Vec.new(), cigs: Vec.new(), bis: Vec.new(), bigs: Vec.new(), bigk: ll_cmac.cmac_empty(), big_rnd: Vec.new(), big_rnd_n: 0, big_seed: 1, bi: ll_big.info_view_none(), bi_raw: Vec.new(), bi_n: 0, bi_sync: 0, bi_t: 0, bi_owed: false, bi_seen: 0, host_iso: false, cis_log: ll_iso.cis_log_new(), iso_dropped: 0, iso_rr: 0, room_us: 1000000, room_skips: 0, dtm: ll_dtm.dtm_new(), radio: ll_radio.profile_assumed(),
        xs: ll_ext.xctx_new(), xv: ll_pdu.pdu_new(), xp: ll_ext.xpri_new(), xview: false,
        xsets: Vec.new(), coded: true, adv_set: -1, adv_base: 0, adv_xset: -1,
        pads: Vec.new(), psyncs: Vec.new(), preq: ll_per.preq_new(), pal: ll_per.pal_new(), per_late: 0,
        past_def: ll_past.cfg_new(), past_cfg: Vec.new(), past_tx: Vec.new(), pcl: Vec.new(), sub: Vec.new(), sub_def: Vec.new(), host_sub: false, pwa: Vec.new(), pws: Vec.new(), cs_w: Vec.new(), cs_b: Vec.new() }
    for _ in 0..ctl_limits.padv_n()
        let _p = c.pads.push(ll_per.padv_new())
    for _ in 0..ctl_limits.psync_n()
        let _y = c.psyncs.push(ll_per.psync_new())
        if ctl_limits.pawr_sync_on()
            let _w = c.pws.push(ll_pawr.ps_new())
    if ctl_limits.pawr_adv_on()
        for _ in 0..ctl_limits.padv_n()
            let _a = c.pwa.push(ll_pawr.pa_new())
    for _ in 0..noble_controller_config.CTL_LINKS
        let _l = c.links.push(ll_link.link_new())
        if ctl_limits.past_on()
            let _pc = c.past_cfg.push(ll_past.cfg_new())
            let _pt = c.past_tx.push(ll_past.tx_new())
        if ctl_limits.pcl_on()
            let _pl = c.pcl.push(ll_pcl.pcl_new())
        if ctl_limits.sub_on()
            let _sb = c.sub.push(ll_sub.sub_new())
    if ctl_limits.sub_on() or ctl_limits.fs_on()
        let _sd = c.sub_def.push(ll_sub.sub_new())
    if noble_controller_config.CTL_CS > 0
        cs_tables_init(var c)
    for _ in 0..ctl_limits.sets()
        let _x = c.xsets.push(ll_xadv.xset_new())
    for _ in 0..ctl_limits.cis_slots()
        let _s = c.cis.push(ll_iso.cis_new())
    for _ in 0..ctl_limits.cig_slots()
        let _g = c.cigs.push(ll_iso.cig_new())
    // A build without broadcast groups never touches these tables, so it fills none of them (their capacity is one slot, a Vec has no
    // zero capacity).
    if ctl_limits.big_on()
        ll_cmac.cmac_fill(var c.bigk)
        for _ in 0..ctl_limits.bis_slots()
            let _bs = c.bis.push(ll_iso.cis_new())
        for _ in 0..ctl_limits.big_slots()
            let _bg = c.bigs.push(ll_big.big_new())
        for _ in 0..24
            let _br = c.big_rnd.push(0)
        for _ in 0..64
            let _bw = c.bi_raw.push(0)
    for _ in 0..6
        let _a = c.public.push(0)
        let _b = c.random.push(0)
        let _q = c.rq_addr.push(0)
        let _r = c.ci_rpa.push(0)
    for _ in 0..32
        let _e1 = c.ecdh_secret.push(0)
    for _ in 0..64
        let _e2 = c.ecdh_peer.push(0)
    for _ in 0..FILTER_ACCEPT_LIST_SIZE
        let _c = c.fal_used.push(false)
        let _d = c.fal_type.push(0)
    for _ in 0..FILTER_ACCEPT_LIST_SIZE * 6
        let _e = c.fal_addr.push(0)
    for _ in 0..16
        let _f = c.block.push(0)
        let _g = c.key.push(0)
        let _h = c.result.push(0)
    reset_parameters(var c)
    c

// Octet `i` of the public device address, least significant first.
pub @tier(embedded)
fn ctl_set_public(var c: Controller, i: Int, v: Int)
    if i >= 0 and i < 6
        c.public[i] = (v & 0xFF) as u8

// The parameters a Reset restores, and the state it ends: default event
// masks, no random address, an empty Filter Accept List, no work for the
// hardware, and the packets not yet begun dropped.
@tier(embedded)
fn reset_parameters(var c: Controller)
    c.mask_low = MASK_DEFAULT_LOW
    c.mask_high = MASK_DEFAULT_HIGH
    c.mask2 = 0
    c.le_low = LE_MASK_DEFAULT
    c.le_high = 0
    c.random_set = false
    for i in 0..6
        c.random[i] = 0
    fal_clear(var c)
    ctl_pool.pool_host_reset(var c.pool)
    ll_adv.adv_reset(var c.adv)
    for i in 0..ctl_limits.sets()
        ll_xadv.xset_clear(var c.xsets[i])
    for k in 0..ctl_limits.padv_n()
        ll_per.padv_clear(var c.pads[k])
    for k in 0..ctl_limits.psync_n()
        ll_per.psync_clear(var c.psyncs[k])
        if ctl_limits.pawr_sync_on()
            ll_pawr.ps_clear(var c.pws[k])
    if ctl_limits.pawr_adv_on()
        for k in 0..ctl_limits.padv_n()
            ll_pawr.pa_clear(var c.pwa[k])
    ll_per.preq_clear(var c.preq)
    ll_per.pal_clear(var c.pal)
    if ctl_limits.past_on()
        ll_past.cfg_set(var c.past_def, ll_past.MODE_OFF, 0, ll_past.TIMEOUT_MIN, 0)
        for k in 0..noble_controller_config.CTL_LINKS
            ll_past.cfg_set(var c.past_cfg[k], ll_past.MODE_OFF, 0, ll_past.TIMEOUT_MIN, 0)
            c.past_tx[k].used = false
    if ctl_limits.pcl_on()
        for k in 0..noble_controller_config.CTL_LINKS
            ll_pcl.pcl_reset(var c.pcl[k], TX_POWER_DBM)
    c.host_sub = false
    if noble_controller_config.CTL_CS > 0
        cs_reset_all(var c)
    if ctl_limits.fs_on() and not ctl_limits.sub_on()
        c.sub_def[0] = ll_sub.sub_new()
    if ctl_limits.sub_on()
        c.sub_def[0] = ll_sub.sub_new()
        for k in 0..noble_controller_config.CTL_LINKS
            c.sub[k] = ll_sub.sub_new()
    c.adv_set = -1
    c.adv_xset = -1
    ll_scan.scan_reset(var c.scan)
    for cls in 0..ll_arb.classes()
        ll_arb.arb_cancel(var c.arb, cls)
    ll_init.init_reset(var c.init)
    c.chmap = ll_init.CHMAP_ALL
    c.init_event = 0
    ll_privacy.rl_reset(var c.rl)
    c.ecdh_op = 0
    c.ecdh_have = false
    for k in 0..32
        c.ecdh_secret[k] = 0
    c.adv_ent = -1
    c.adv_loc = false
    c.adv_tgt = false
    c.adv_tgt_ok = false
    c.init_ent = -1
    c.init_loc = false
    c.adv_wait = false
    c.init_wait = false
    c.rp_valid = false
    c.rp_rsp = false
    c.rq_kind = 0
    c.ci_kind = 0
    c.ci_ent = -1
    c.adv_st = 0
    c.scan_st = 0
    c.dl_sugg_octets = 27
    c.dl_sugg_time = 328
    c.dl_sugg_set = false
    c.phy_def_set = false
    c.phy_def_tx = 7
    c.phy_def_rx = 7
    let _n = ll_dtm.dtm_end(var c.dtm)
    for slot in 0..noble_controller_config.CTL_LINKS
        ll_link.link_reset(var c.links[slot])
    iso_reset(var c)
    big_reset(var c)
    c.pending = PEND_NONE as u8
    c.hw_owed = false
    if c.pend_slot != ctl_pool.NO_SLOT
        ctl_pool.pool_give(var c.pool, c.pend_slot)
        c.pend_slot = ctl_pool.NO_SLOT
    ctl_pool.pool_flush(var c.pool)

// ── Event masks ─────────────────────────────────────────────────────

// Whether the Host's event mask lets the event with `code` through.  Bit n
// of the mask is the event with code n + 1 ([Vol 4] Part E, Section 7.3.1).
// Command Complete, Command Status and Number Of Completed Packets are not
// maskable and are not asked here.
@satisfies("REQ-BLE-HCI-009")
@tier(embedded)
fn event_enabled(var c: Controller, code: Int) -> Bool
    let bit = code - 1
    if bit < 0 or bit >= 64
        return false
    if bit < 32
        ((c.mask_low >>> bit) & 1) == 1
    else
        ((c.mask_high >>> (bit - 32)) & 1) == 1

// Whether the LE event mask lets the LE Meta subevent `sub` through.  Bit n
// is the subevent with code n + 1 ([Vol 4] Part E, Section 7.8.1).
@satisfies("REQ-BLE-HCI-010")
@tier(embedded)
fn le_event_enabled(var c: Controller, sub: Int) -> Bool
    let bit = sub - 1
    if bit < 0 or bit >= 64 or not event_enabled(var c, hci_frame.EVT_LE_META_EVENT)
        return false
    if bit < 32
        ((c.le_low >>> bit) & 1) == 1
    else
        ((c.le_high >>> (bit - 32)) & 1) == 1

// Four octets of the command's parameters from `at`, least significant
// first.
@tier(embedded)
fn param_u32(var c: Controller, at: Int) -> Int
    h4_rx.h4_param(var c.rx, at)
        | (h4_rx.h4_param(var c.rx, at + 1) << 8)
        | (h4_rx.h4_param(var c.rx, at + 2) << 16)
        | (h4_rx.h4_param(var c.rx, at + 3) << 24)

// Two octets of the command's parameters from `at`, least significant first.
@tier(embedded)
fn param_u16(var c: Controller, at: Int) -> Int
    h4_rx.h4_param(var c.rx, at) | (h4_rx.h4_param(var c.rx, at + 1) << 8)

// ── Commands that are answered ──────────────────────────────────────

// The position in the Supported_Commands bit field ([Vol 4] Part E,
// Section 6.27) of the command with `opcode`: octet times 8 plus bit.  -1
// for a command the Controller does not answer, and for Read Local
// Supported Commands, which the field does not list.
@satisfies("REQ-BLE-CTL-070")
@tier(embedded)
fn command_bit_base(opcode: Int) -> Int
    match opcode
        0x406  => 0 * 8 + 5
        0x41d  => 2 * 8 + 7
        0xc01  => 5 * 8 + 6
        0xc03  => 5 * 8 + 7
        0xc2d  => 10 * 8 + 2
        0xc31  => 10 * 8 + 5
        0xc33  => 10 * 8 + 6
        0xc35  => 10 * 8 + 7
        0xc63  => 22 * 8 + 2
        0xc7b  => 32 * 8 + 4
        0xc7c  => 32 * 8 + 5
        0x1001 => 14 * 8 + 3
        0x1003 => 14 * 8 + 5
        0x1009 => 15 * 8 + 1
        0x1405 => 15 * 8 + 5
        0x2001 => 25 * 8 + 0
        0x2002 => 25 * 8 + 1
        0x2003 => 25 * 8 + 2
        0x2005 => 25 * 8 + 4
        0x2006 => 25 * 8 + 5
        0x2007 => 25 * 8 + 6
        0x2008 => 25 * 8 + 7
        0x2009 => 26 * 8 + 0
        0x200a => 26 * 8 + 1
        0x200b => 26 * 8 + 2
        0x200c => 26 * 8 + 3
        0x200d => 26 * 8 + 4
        0x200e => 26 * 8 + 5
        0x200f => 26 * 8 + 6
        0x2010 => 26 * 8 + 7
        0x2011 => 27 * 8 + 0
        0x2012 => 27 * 8 + 1
        0x2013 => 27 * 8 + 2
        0x2014 => 27 * 8 + 3
        0x2015 => 27 * 8 + 4
        0x2016 => 27 * 8 + 5
        0x2017 => 27 * 8 + 6
        0x2018 => 27 * 8 + 7
        0x2019 => 28 * 8 + 0
        0x2022 => 33 * 8 + 6
        0x2023 => 33 * 8 + 7
        0x2024 => 34 * 8 + 0
        0x202f => 35 * 8 + 3
        0x2030 => 35 * 8 + 4
        0x2031 => 35 * 8 + 5
        0x2032 => 35 * 8 + 6
        0x201a => 28 * 8 + 1
        0x201b => 28 * 8 + 2
        0x201c => 28 * 8 + 3
        0x2025 => 34 * 8 + 1
        0x2026 => 34 * 8 + 2
        0x205e => 41 * 8 + 2
        0x2027 => 34 * 8 + 3
        0x2028 => 34 * 8 + 4
        0x2029 => 34 * 8 + 5
        0x202a => 34 * 8 + 6
        0x202b => 34 * 8 + 7
        0x202c => 35 * 8 + 0
        0x202d => 35 * 8 + 1
        0x202e => 35 * 8 + 2
        0x204e => 39 * 8 + 2
        0x2020 => 33 * 8 + 4
        0x2021 => 33 * 8 + 5
        0x204b => 38 * 8 + 7
        0x207f => 46 * 8 + 2
        0x2035 => 36 * 8 + 1
        0x2036 => 36 * 8 + 2
        0x2037 => 36 * 8 + 3
        0x2038 => 36 * 8 + 4
        0x2039 => 36 * 8 + 5
        0x203a => 36 * 8 + 6
        0x203b => 36 * 8 + 7
        0x203c => 37 * 8 + 0
        0x203d => 37 * 8 + 1
        0x203e => 37 * 8 + 2
        0x203f => 37 * 8 + 3
        0x2040 => 37 * 8 + 4
        0x2044 => 38 * 8 + 0
        0x2045 => 38 * 8 + 1
        0x2046 => 38 * 8 + 2
        0x2047 => 38 * 8 + 3
        0x2048 => 38 * 8 + 4
        0x2049 => 38 * 8 + 5
        0x204a => 38 * 8 + 6
        0x2059 => 40 * 8 + 5
        0x205a => 40 * 8 + 6
        0x205b => 40 * 8 + 7
        0x205c => 41 * 8 + 0
        0x205d => 41 * 8 + 1
        0x2086 => 47 * 8 + 1
